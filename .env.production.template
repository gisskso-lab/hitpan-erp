# ═══════════════════════════════════════════════════════════════════
# 히트판 ERP — Production 환경변수 템플릿
# ═══════════════════════════════════════════════════════════════════
# 이 파일을 `.env.production`으로 복사 후 값을 채워 배포 서버에 배치.
# .env.production 자체는 절대 Git에 커밋하지 말 것 (.gitignore 포함됨).
# ═══════════════════════════════════════════════════════════════════

# ── 환경 ──
ASPNETCORE_ENVIRONMENT=Production

# ── DB ──
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hitpan_erp
DB_USER=hitpan
DB_PASS=__CHANGE_ME__STRONG_PASSWORD__

# ── JWT (길이 최소 64자 이상 랜덤 바이트 권장) ──
# 생성: openssl rand -base64 64
JWT_SECRET=__CHANGE_ME__MINIMUM_64_CHARS_RANDOM__
JWT_ISSUER=hitpan-erp
JWT_AUDIENCE=hitpan-client
JWT_ACCESS_EXPIRES_MIN=15
JWT_REFRESH_EXPIRES_DAYS=14

# ── CORS (외부 허용 Origin, 콤마 구분) ──
# 미설정 시 CORS는 모든 요청을 차단하므로 반드시 설정.
ALLOWED_ORIGINS=https://app.hitpan.kr,https://admin.hitpan.kr

# ── 암호화 키 (AES-256, 32바이트 base64) ──
ENCRYPTION_KEY=__CHANGE_ME__32_BYTES_BASE64__

# ── 백업 ──
BACKUP_DIR=/var/backups/hitpan
RETAIN_DAYS=14

# ── 로그 디렉터리 (Serilog) ──
HITPAN_LOG_DIR=/var/log/hitpan

# ── AI (선택) ──
# hitpan_pool / byok / hybrid
AI_MODE=hitpan_pool
ANTHROPIC_API_KEY=__OPTIONAL_IF_BYOK__

# ══════════ 배포 전 체크리스트 ══════════
# [ ] JWT_SECRET 길이 64자 이상
# [ ] DB_PASS 대소문자·숫자·특수문자 혼합 16자 이상
# [ ] ENCRYPTION_KEY 정확히 44자 (base64 32 bytes)
# [ ] ALLOWED_ORIGINS 실제 프로덕션 도메인만 포함
# [ ] BACKUP_DIR 디스크 공간 확보 (일 100MB × 14일)
# [ ] 파일 권한: chmod 600 .env.production
# [ ] systemd unit 또는 Task Scheduler로 자동 기동 설정
