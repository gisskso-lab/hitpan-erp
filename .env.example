# 히트판 SaaS ERP 환경변수 샘플
# 이 파일을 .env로 복사 후 실제 값 입력
# .env는 절대 Git에 커밋하지 않음

# ── Docker/DB 실행 필수
DB_NAME=hitpan_erp
DB_USER=hitpan
DB_PASSWORD=히트판비밀번호입력
JWT_SECRET=32자리이상랜덤문자열입력
ERP_ENCRYPTION_KEY=32자리이상랜덤문자열입력

# ── DB 연결 (고객사 로컬 MariaDB)
DB_HOST=localhost
DB_PORT=3306

# ── JWT
JWT_ISSUER=hitpan-erp
JWT_AUDIENCE=hitpan-client
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# ── 결제 (토스페이먼츠)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ── 결제 (카카오페이)
KAKAO_APP_KEY=

# ── 카카오 알림톡
KAKAO_ALIMTALK_KEY=

# ── 홈택스 e세로 (Phase 3)
NTS_API_KEY=
NTS_CERT_PATH=
