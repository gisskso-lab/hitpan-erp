# 히트판 SaaS ERP 환경변수 샘플
# 이 파일을 .env로 복사 후 실제 값 입력
# .env는 절대 Git에 커밋하지 않음

# ── 암호화 키 (AES-256, 32바이트 이상 랜덤 문자열)
ERP_ENCRYPTION_KEY=여기에_32자_이상_랜덤_문자열_입력

# ── DB 연결 (고객사 로컬 MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hitpan_erp
DB_USER=hitpan
DB_PASSWORD=

# ── JWT
JWT_SECRET=여기에_32자_이상_랜덤_문자열_입력
JWT_ISSUER=hitpan-erp
JWT_AUDIENCE=hitpan-client
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# ── 결제 (토스페이먼츠)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ── 결제 (카카오페이)
KAKAO_APP_KEY=

# ── 카카오 알림톡
KAKAO_ALIMTALK_KEY=

# ── 홈택스 e세로 (Phase 3)
NTS_API_KEY=
NTS_CERT_PATH=
