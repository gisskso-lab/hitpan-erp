<Project Sdk="Microsoft.NET.Sdk">

  <!--
    고리4 P1 멱등 검증 도구 (작5, 사장님 결재 2026-06-30) — Windows Sandbox M4 전용.
    방금 배선한 MigrationRunner(IMigrationRunner, Program.cs:75)를 빈 DB에서 직접 호출해
    "2회 실행 = 동일(멱등)" 을 실측한다. 운영(demo 3306) 무접촉 — 샌드박스 안 빈 DB만 본다.

    ★ 솔루션 빌드 제외(IsPackable=false, tools/ 일회용 검증). 헌법 #39 검증=테스트환경.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HitPan.Application\HitPan.Application.csproj" />
    <ProjectReference Include="..\..\src\HitPan.Infrastructure\HitPan.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 🔴 20261030작 MySqlConnector 판올림 (PM 브라운킴 결재 · 2026-10-30) — NU1902 GHSA-473q-m89c-ghf8 봉합.
         종전 줄은 지우지 않는다(#1):
         <PackageReference Include="MySqlConnector" Version="2.5.0" />
         🔴 이 판은 8곳(src 5 · tools 3)이 같아야 한다 — 한 곳만 올리면 판이 갈린다(판 내림 NU1605).
            src: API · Application · Backoffice.API · Infrastructure · IntegrationTests
            tools: MdbMigrationBaselineRun · MigrationIdempotencyCheck · MigrationSmokeTest
         정확한 판 하나로 적는다(범위식 금지). 근거 docs/운영기록/20261030작_MySqlConnector판올림_작업지시서.md -->
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
  </ItemGroup>

  <!--
    DB-*.sql 을 출력 폴더의 Migrations/SQL 로 복사한다.
    MigrationRunner.ResolveMigrationsDirectory() 의 1순위 후보(baseDir/Migrations/SQL)와 정합 —
    MigrationRunner 무수정(헌법 #1)으로 도구 bin 옆에서 마이그 폴더를 찾게 한다.
  -->
  <ItemGroup>
    <None Include="..\..\src\HitPan.API\Migrations\SQL\DB-*.sql"
          Link="Migrations\SQL\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
