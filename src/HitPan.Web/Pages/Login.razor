@page "/login"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@layout EmptyLayout
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDialogService DialogService
@inject HttpClient Http
@inject ISnackbar Snackbar
@using HitPan.Web.Components.Common

<PageTitle>로그인 — 히트판 ERP</PageTitle>

<div class="hitpan-login-page">
    <MudPaper Class="hitpan-login-card pa-8" Elevation="4">
        <div class="hitpan-login-brand mb-6">
            <div class="hitpan-login-logo">HP</div>
            <MudText Typo="Typo.h5" Style="font-family: 'Noto Sans KR', sans-serif;">히트판 ERP</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">사업을 한곳에서</MudText>
        </div>

        @* 🔴 20260825작19 — 상단 업데이트 배너 제거 (사장님 오더)
             *"로그인 화면에 최신업데이트 버튼 상단버튼 삭제"*

             ⚠️ 작12 에서 배너와 하단 버튼을 "다른 물건" 이라며 **둘 다 남긴 것**이
             사장님이 보신 「업데이트 버튼 2개」다. 배너는 새 버전이 있을 때만 뜨고
             버튼은 항상 뜨므로, 정작 새 버전이 있을 때 둘이 겹쳤다.

             🟢 기능 손실 없음 — 배너도 하단 버튼도 **같은 StartUpdateAsync 로 수렴**했다.
             로그인 전 탈출구(2026-08-11 지시)는 하단 「최신버젼업데이트」가 그대로 지킨다. *@

        <MudForm @ref="_form" ValidationDelay="0">
            <MudTextField @bind-Value="_email"
                          Label="아이디"
                          Variant="Variant.Outlined"
                          InputType="InputType.Text"
                          Required="true"
                          RequiredError="아이디를 입력하세요"
                          Disabled="_busy"
                          Class="mb-4"
                          Style="font-family: 'Noto Sans KR', sans-serif;" />

            <MudTextField @bind-Value="_password"
                          Label="비밀번호"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          Required="true"
                          RequiredError="비밀번호를 입력하세요"
                          Disabled="_busy"
                          Class="mb-4"
                          Style="font-family: 'Noto Sans KR', sans-serif;" />

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4" Style="font-family: 'Noto Sans KR', sans-serif;">
                    @_errorMessage
                </MudAlert>
            }

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Disabled="_busy || string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password)"
                       OnClick="SubmitAsync"
                       Style="font-family: 'Noto Sans KR', sans-serif;">
                @if (_busy)
                {
                    <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                로그인
            </MudButton>

            @* 🔴 20260825작12 — 「최신버젼업데이트」 수동 버튼 (사장님 오더)
                 *"수동업데이트로 받을 수 있도록 로그인 아래에 「최신버젼업데이트」 라는 버튼을 만들어."*

                 위 배너(@_updateAvailable)와 다른 물건이다. 배너는 **새 버전이 있을 때만** 뜨는데,
                 조회가 실패하면(사장님 = 터널 접속 → 서버가 404) 배너가 아예 안 떠서
                 화면에 **탈출구가 하나도 안 보였다.** 이 버튼은 항상 있고 문구만 바뀐다.

                 ⚠️ 워치독이 60초 주기로 승인을 집어가므로 즉시 안 꺼진다 — 안내 문구를 그렇게 쓴다. *@
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       FullWidth="true"
                       Class="mt-3"
                       Disabled="_updateChecking || _updateStarting"
                       OnClick="ManualUpdateAsync"
                       StartIcon="@Icons.Material.Filled.SystemUpdateAlt"
                       Style="font-family: 'Noto Sans KR', sans-serif;">
                @if (_updateChecking)
                {
                    <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <text>확인 중…</text>
                }
                else if (_updateStarting)
                {
                    <text>업데이트 준비 중…</text>
                }
                else if (_updateCheckFailed)
                {
                    <text>최신버젼업데이트 (확인 실패 — 다시 시도)</text>
                }
                else if (_updateAvailable)
                {
                    <text>최신버젼업데이트 (@_latestVersion)</text>
                }
                else
                {
                    <text>최신버젼업데이트</text>
                }
            </MudButton>
            @if (!_updateChecking && !_updateAvailable && !_updateCheckFailed && !string.IsNullOrWhiteSpace(_currentVersion))
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1" Align="Align.Center">
                    현재 버전 @_currentVersion — 최신입니다
                </MudText>
            }
        </MudForm>
    </MudPaper>
</div>

@code {
    private MudForm? _form;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string? _errorMessage;
    private bool _busy;

    // 🔴 로그인 전 업데이트 안내 (사장님 지시 2026-08-11) — 상세 근거는 위 마크업 주석
    private bool _updateAvailable;
    private string? _latestVersion;
    private bool _updateStarting;

    // 🔴 20260825작12 — 「최신버젼업데이트」 수동 버튼 (사장님 오더)
    //   *"수동업데이트로 받을 수 있도록 로그인 아래에 「최신버젼업데이트」 라는 버튼을 만들어."*
    //   조건부 배너(_updateAvailable)와 **다른 물건**이다 — 배너는 새 버전이 있을 때만 뜨는데,
    //   조회가 실패하면(터널 404 등) 배너가 아예 안 떠서 사장님께는 **아무 탈출구도 안 보였다.**
    //   이 버튼은 **항상 보인다.** 상태에 따라 문구만 바뀐다.
    private string? _currentVersion;
    private bool _updateCheckFailed;   // 조회 자체가 실패 — 침묵하지 않는다(헌법 #15)
    private bool _updateChecking;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("/", forceLoad: true);
            return;
        }

        await LoadUpdateNoticeAsync();
    }

    /// <summary>
    /// 로그인 전 업데이트 상태를 읽는다. 실패해도 로그인 화면은 그대로 떠야 하므로
    /// 어떤 예외도 삼킨다 — 이 안내 때문에 로그인 자체가 막히면 본말전도다(헌법 #20).
    /// </summary>
    private async Task LoadUpdateNoticeAsync()
    {
        _updateChecking = true;
        _updateCheckFailed = false;
        try
        {
            var status = await Http.GetFromJsonAsync<LoginUpdateStatus>("api/auth/update-status-local");
            _currentVersion = status?.CurrentVersion;
            if (status?.UpdateAvailable == true && !string.IsNullOrWhiteSpace(status.LatestVersion))
            {
                _updateAvailable = true;
                _latestVersion = status.LatestVersion;
            }
        }
        catch (Exception ex)
        {
            // 헌법 #15 — 침묵하지 않는다.
            // 🔴 20260825작12 — 종전엔 콘솔에만 남기고 화면은 침묵했다.
            //   그래서 사장님께는 "새 버전이 없는 것"과 "조회가 고장난 것"이 **똑같아 보였다.**
            //   실제로 터널 접속은 서버가 404 를 주는데(설계상 loopback 전용) 화면엔 아무 흔적도 없었다.
            //   ⇒ 이제 버튼이 "업데이트 확인 실패" 로 **보이게** 한다. 고장은 보여야 고칠 수 있다.
            _updateCheckFailed = true;
            Console.Error.WriteLine("[Login] 업데이트 안내 조회 실패: " + ex.Message);
        }
        finally
        {
            _updateChecking = false;
        }
    }

    /// <summary>
    /// 「최신버젼업데이트」 버튼 (20260825작12 — 사장님 오더).
    /// </summary>
    /// <remarks>
    /// 다시 조회해서 새 버전이 있으면 곧바로 실행까지 간다.
    /// 조회가 실패해 있던 경우(터널 404 등) **다시 눌러볼 수 있어야** 하므로 재조회부터 한다.
    /// </remarks>
    private async Task ManualUpdateAsync()
    {
        if (_updateChecking || _updateStarting) return;

        await LoadUpdateNoticeAsync();
        StateHasChanged();

        if (_updateCheckFailed)
        {
            Snackbar.Add("업데이트 상태를 확인하지 못했습니다. 잠시 후 다시 시도해 주세요.", Severity.Warning);
            return;
        }

        if (!_updateAvailable)
        {
            Snackbar.Add($"이미 최신 버전입니다{(string.IsNullOrWhiteSpace(_currentVersion) ? "" : $" ({_currentVersion})")}.", Severity.Info);
            return;
        }

        await StartUpdateAsync();
    }

    private async Task StartUpdateAsync()
    {
        if (_updateStarting || string.IsNullOrWhiteSpace(_latestVersion)) return;
        _updateStarting = true;

        try
        {
            using var res = await Http.PostAsJsonAsync(
                "api/auth/update-consent-local",
                new { UpdateVersion = _latestVersion, Action = "approve" });

            if (res.IsSuccessStatusCode)
            {
                // 20260825작12: "잠시 후" 는 모호했다 — 워치독이 60초 주기로 승인을 집어간다.
                //   아무 일도 안 일어나는 1분 동안 고객은 고장으로 여긴다.
                Snackbar.Add("업데이트를 예약했습니다. 1분 이내에 시작되며, 히트판이 꺼졌다가 다시 켜집니다.", Severity.Success);
                _updateAvailable = false;
                _updateStarting = false;   // 작12: 성공 분기에 복원이 없어 버튼이 "준비 중…" 으로 굳었다.
            }
            else
            {
                Snackbar.Add("업데이트를 시작하지 못했습니다. 잠시 후 다시 시도해 주세요.", Severity.Warning);
                _updateStarting = false;
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine("[Login] 업데이트 시작 실패: " + ex.Message);
            Snackbar.Add("업데이트를 시작하지 못했습니다. 잠시 후 다시 시도해 주세요.", Severity.Warning);
            _updateStarting = false;
        }
    }

    private sealed class LoginUpdateStatus
    {
        public bool UpdateAvailable { get; set; }
        public string? LatestVersion { get; set; }
        // 20260825작12: 「최신버젼업데이트」 버튼이 "현재 최신입니다 (1.3.14)" 를 보여주려면
        //   지금 버전을 알아야 한다. 서버는 이미 주고 있었는데 화면이 안 받고 있었다.
        public string? CurrentVersion { get; set; }
    }

    private async Task SubmitAsync()
    {
        if (_form is not null)
        {
            await _form.ValidateAsync();
        }

        if (_form is not null && !_form.IsValid)
        {
            return;
        }

        _errorMessage = null;
        _busy = true;
        try
        {
            var result = await AuthService.LoginAsync(_email.Trim(), _password);
            if (!result.Success)
            {
                _errorMessage = result.ErrorMessage ?? "로그인에 실패했습니다.";
                return;
            }

            // 헌법 #24: 약관 v2.0.0 미동의 시 /terms 강제 이동 (welcome·메인보다 우선)
            if (result.Data?.RequiresTermsConsent == true)
            {
                Navigation.NavigateTo("/terms", forceLoad: true);
                return;
            }

            // 고리2(A안) 업데이트 동의 팝업은 여기서 띄우지 않는다 (2026-07-22 작1 진범 봉합):
            //   로그인 성공 시 인증 상태 방송 → 라우터가 /login 컴포넌트를 즉시 폐기 → 그 위 팝업이 딸려
            //   0.5초 만에 사라졌다("누를 경황도 없이"). 팝업 책임을 ERP 메인(MainLayout <UpdateConsentGate/>)
            //   으로 이관했다. 이 페이지는 로그인·약관·기기통지·이동만 담당한다(모듈화, 사장님 원칙 2026-07-21).

            // 작3 I3 (사장님 결재 2026-07-02, (a) 자동 등록 후 통지): 이번 로그인에서 이 기기가
            //   처음 등록된 신규 기기면 사용자에게 알린다(자동 등록은 이미 서버에서 됨). 기기 슬롯 관리는
            //   관리자(부모계정) 영역이라 여기선 통지만 — 통지 실패해도 로그인 흐름은 막지 않는다.
            // 🔴 2026-08-16 20260816작2 — **승인 대기 관문** (사장님 전결).
            //
            //   사장님 설계: *"로그인 후 로딩화면에 기기슬롯 과정을 넣으면 되잖아"*
            //     새 화면(@page)을 세우지 않는다 — 세우면 **정상 고객이 매번 화면을 하나 더 본다.**
            //     이미 인증된 기기는 이 분기에 걸리지 않으므로 **아무것도 안 바뀐다.**
            //
            //   이 기기는 로그인은 통과했고 `pending` 으로 들어와 있다(= 신청은 이미 끝났다).
            //   MainLayout 의 <DeviceAuthGate/> 가 이 표시를 보고 관문을 띄우며,
            //   대표가 [예] 를 누르는 순간 스스로 통과한다.
            //
            //   ⚠️ 여기서 막아도 **로그인 실패가 아니다.** 사장님 결재(20260815 §3):
            //     *"401 을 내지 않는다. 로그인은 통과, 중간 화면에서 제어"*
            if (result.Data?.DeviceAwaitingApproval == true)
            {
                DeviceAuthState.MarkAwaitingApproval();
                Navigation.NavigateTo("/", forceLoad: true);
                return;
            }

            if (result.Data?.DeviceNewlyRegistered == true)
            {
                try
                {
                    var notice = string.IsNullOrWhiteSpace(result.Data?.DeviceNotice)
                        ? "이 기기가 새 기기로 등록되었습니다."
                        : result.Data!.DeviceNotice!;
                    // 통지 성격(자동 등록 후 알림)이라 확인/닫기 둘 다 "인지" 의미. 공용 ConfirmDialog는
                    //   취소 버튼을 항상 렌더링하므로 빈 문자열 대신 "닫기"로 둔다(빈 버튼 UX 방지).
                    await ConfirmDialog.ShowAsync(
                        DialogService,
                        title: "기기 등록 안내",
                        message: notice,
                        confirmText: "확인",
                        cancelText: "닫기",
                        severity: Severity.Info);
                }
                catch { /* 통지 실패해도 로그인 진행 */ }
            }

            if (result.Data?.RedirectToWelcome == true)
            {
                Navigation.NavigateTo("/welcome", forceLoad: true);
            }
            else
            {
                Navigation.NavigateTo("/", forceLoad: true);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    // PromptUpdateConsentAsync 제거 (2026-07-22 작1): 업데이트 팝업 책임을 MainLayout <UpdateConsentGate/>
    //   으로 이관. 이 페이지에서 팝업을 띄우면 로그인 성공 직후 /login 폐기로 팝업이 사라지기 때문(진범).
}
