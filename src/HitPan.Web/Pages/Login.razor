@page "/login"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@layout EmptyLayout
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDialogService DialogService
@using HitPan.Web.Components.Common

<PageTitle>로그인 — 히트판 ERP</PageTitle>

<div class="hitpan-login-page">
    <MudPaper Class="hitpan-login-card pa-8" Elevation="4">
        <div class="hitpan-login-brand mb-6">
            <div class="hitpan-login-logo">HP</div>
            <MudText Typo="Typo.h5" Style="font-family: 'Noto Sans KR', sans-serif;">히트판 ERP</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">사업을 한곳에서</MudText>
        </div>

        <MudForm @ref="_form" ValidationDelay="0">
            <MudTextField @bind-Value="_email"
                          Label="이메일"
                          Variant="Variant.Outlined"
                          InputType="InputType.Email"
                          Required="true"
                          RequiredError="이메일을 입력하세요"
                          Disabled="_busy"
                          Class="mb-4"
                          Style="font-family: 'Noto Sans KR', sans-serif;" />

            <MudTextField @bind-Value="_password"
                          Label="비밀번호"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          Required="true"
                          RequiredError="비밀번호를 입력하세요"
                          Disabled="_busy"
                          Class="mb-4"
                          Style="font-family: 'Noto Sans KR', sans-serif;" />

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4" Style="font-family: 'Noto Sans KR', sans-serif;">
                    @_errorMessage
                </MudAlert>
            }

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Disabled="_busy || string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password)"
                       OnClick="SubmitAsync"
                       Style="font-family: 'Noto Sans KR', sans-serif;">
                @if (_busy)
                {
                    <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                로그인
            </MudButton>
        </MudForm>
    </MudPaper>
</div>

@code {
    private MudForm? _form;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string? _errorMessage;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("/", forceLoad: true);
        }
    }

    private async Task SubmitAsync()
    {
        if (_form is not null)
        {
            await _form.ValidateAsync();
        }

        if (_form is not null && !_form.IsValid)
        {
            return;
        }

        _errorMessage = null;
        _busy = true;
        try
        {
            var result = await AuthService.LoginAsync(_email.Trim(), _password);
            if (!result.Success)
            {
                _errorMessage = result.ErrorMessage ?? "로그인에 실패했습니다.";
                return;
            }

            // 헌법 #24: 약관 v2.0.0 미동의 시 /terms 강제 이동 (welcome·메인보다 우선)
            if (result.Data?.RequiresTermsConsent == true)
            {
                Navigation.NavigateTo("/terms", forceLoad: true);
                return;
            }

            // 고리2(A안): 새 버전이 있으면 업데이트 동의 Y/N 팝업 (헌법 #30 로컬 자가완결)
            //   - 약관 동의가 끝난 뒤에만 노출(약관이 우선). 팝업이 실패해도 로그인 흐름은 막지 않는다.
            if (result.Data?.UpdateAvailable == true && !string.IsNullOrWhiteSpace(result.Data?.LatestVersion))
            {
                await PromptUpdateConsentAsync(result.Data);
            }

            if (result.Data?.RedirectToWelcome == true)
            {
                Navigation.NavigateTo("/welcome", forceLoad: true);
            }
            else
            {
                Navigation.NavigateTo("/", forceLoad: true);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// 고리2(A안) — 새 버전 동의 Y/N 팝업. [예]=approve, [나중에]=reject 를 로컬 ERP DB에 기록한다.
    ///   본사를 거치지 않는다(헌법 #30). 팝업/기록이 실패해도 로그인 진행은 막지 않는다(다음 로그인 재안내).
    ///   ⚠️ 헌법 #14: Razor 에 raw string("""...""") 금지 — $"...\n..." 로 메시지를 만든다.
    /// </summary>
    private async Task PromptUpdateConsentAsync(LoginApiResponse data)
    {
        try
        {
            var version = data.LatestVersion ?? "";
            var notice = string.IsNullOrWhiteSpace(data.ConsentMessage)
                ? "지금 동의하시면 다음 재시작 때 자동으로 적용됩니다."
                : data.ConsentMessage!;
            var message = $"새 버전 {version} 이(가) 나왔습니다. 업데이트하시겠습니까?\n\n{notice}";

            var agree = await ConfirmDialog.ShowAsync(
                DialogService,
                title: "업데이트 안내",
                message: message,
                confirmText: "예",
                cancelText: "나중에",
                severity: Severity.Info);

            // 예=approve / 나중에=reject — 양쪽 모두 기록(거부 이력도 남겨 재안내 정책에 활용).
            var action = agree ? "approve" : "reject";
            await AuthService.SubmitUpdateConsentAsync(version, action);
        }
        catch
        {
            // 동의 팝업/기록 실패는 로그인 흐름을 막지 않는다(다음 로그인에 재안내).
        }
    }
}
