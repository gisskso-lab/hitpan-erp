@page "/support/cs"
@attribute [Authorize]
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient Http
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject ILogger<CsRequestPage> _logger

@* 작14 B-1 — CS 요청 보내기 + 내 문의 목록 (사장님 결재 2026-10-08 · 결-10 메뉴 = 사이드바 하단 단독)
   · 유형(7모양)·세부태그 콤보 목록의 주인은 서버(CsRequestController) 하나 — 화면은 받아 그린다
   · 한 줄 고지(R-8): 「이 내용은 담당 대리점과 본사 상담원이 봅니다」 · 「본사만 보기」 칸은 결-2(법무 묶음) 후
   · 「접수됐습니다」는 서버 INSERT 성공 응답 뒤에만 띄운다(게이트③ — 유실 0 의 화면 짝)
   · 「아직 본사에 안 갔음」 상태가 보여야 한다 — 안 보이면 고객은 기다리고 우리는 못 받은 걸 모른다 *@

<PageTitle>고객지원 요청</PageTitle>
@* 🔴 20261012 봉합 때는 이 화면이 본사 안내까지 함께 보여서 부제가 「…본사가 보낸 안내를
   여기서 함께 봅니다」였다. 20261014작1 에서 **본사 안내를 「본사공지사항」으로 갈라냈다**
   ⇒ 그 부제는 **거짓이 됐다**([4] 조건 C-1 · 사이드바 안내 글자와 같은 종류의 사고).
   🔴 메뉴 이름과 화면 머리글을 **같은 말**로 맞춘다 — 처음 보는 사람이 메뉴를 눌렀는데
   다른 낱말이 뜨면 「잘못 눌렀나」가 된다. 「CS」는 외부 노출 약어이기도 하다(#23). *@
<PageHeader Title="고객지원 요청"
            Subtitle="보낸 문의와 그 답을 봅니다. 히트판 본사가 보낸 안내는 「본사공지사항」에 있습니다" />

<MudPaper Elevation="0" Class="pa-6 mb-4" Style="border:1px solid var(--hp-border-default);border-radius:var(--hp-radius-lg);max-width:860px">
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="6">
            <MudSelect T="string" @bind-Value="_category" Label="어떤 일인가요?" Variant="Variant.Outlined" Dense="true">
                @foreach (var c in _categories)
                {
                    <MudSelectItem T="string" Value="@c.Key">@c.Value</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudSelect T="string" @bind-Value="_subTag" Label="어느 업무에서요?" Variant="Variant.Outlined" Dense="true">
                @foreach (var t in _subTags)
                {
                    <MudSelectItem T="string" Value="@t.Key">@t.Value</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12">
            <MudTextField T="string" @bind-Value="_body" Label="내용 (선택)" Variant="Variant.Outlined"
                          Lines="5" MaxLength="2000" Counter="2000"
                          HelperText="주민번호·카드번호·계좌번호·사업자번호는 넣지 마세요 — 담겨 있으면 보낼 수 없습니다" />
        </MudItem>
        <MudItem xs="12" Class="d-flex align-center justify-space-between flex-wrap gap-2">
            <MudText Typo="Typo.caption" Style="color:var(--hp-text-tertiary)">이 내용은 담당 대리점과 본사 상담원이 봅니다</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_sending" OnClick="SendAsync">
                @(_sending ? "보내는 중…" : "보내기")
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudText Typo="Typo.h6" Class="mb-2">내 문의</MudText>
@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_items.Count == 0)
{
    <MudText Typo="Typo.body2" Style="color:var(--hp-text-tertiary)">보낸 문의가 없습니다.</MudText>
}
else
{
    @* 🔴 [4] 디자인검증 F-2·F-8 — ①의 목록도 ②와 **같은 축**이다(설계 §9-2 머리).
       종전엔 색·둥근정도만 토큰으로 바꿔서 구분선·hover·제목 굵기·말줄임이 ②와 전부 달랐다
       ⇒ 두 화면이 한 집으로 안 보인다(작지서 D-13·D-18). 게시판 규격은 `.hp-cs-*` 한 자리에만 둔다.
       🔴 주소·칩 낱말·상태 축은 **안 건드린다**(#1) — 바뀌는 건 겉모양 클래스뿐이다. *@
    <MudPaper Elevation="0" Class="hp-cs-board">
        <MudList T="string" Dense="true">
            @foreach (var it in _items)
            {
                <MudListItem T="string" Class="hp-cs-row"
                             OnClick="@(() => Nav.NavigateTo($"/support/cs/{it.CsRequestId}"))">
                    <div class="hp-cs-row-head">
                        <span class="hp-cs-row-title">
                            @* 🔴 20261012작3 B-4 — 본사가 먼저 보낸 안내는 **내가 쓴 문의가 아니다.**
                               구별 표시가 없으면 「내가 언제 이런 걸 물었지?」가 된다.
                               (①은 이제 `origin=local` 만 받지만, 칸이 없는 DB 에서는 전부 내려오므로
                                이 구별 표시를 **지우지 않는다** — 설계 §8 빈 화면 보장의 짝이다.) *@
                            @if (it.Origin == "hq")
                            {
                                <b style="color:var(--hp-status-info-fg)">본사 안내</b><span> · </span>
                            }
                            else
                            {
                                <b>@CategoryLabel(it.Category)</b><span> · </span>
                            }
                            @(string.IsNullOrEmpty(it.Body) ? "(내용 없음)" : Preview(it.Body))
                        </span>
                        @* 🔴 ①은 칩이 최대 4개다 — `--many` 가 칩을 아래 줄로 떨어뜨려 제목을 지킨다.
                           칩 수를 줄이는 것은 정보를 빼는 일이라 사장님 결재 영역이다(안 건드렸다). *@
                        <span class="hp-cs-row-chips hp-cs-row-chips--many">
                            @if (it.Origin == "hq")
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled"
                                         Icon="@Icons.Material.Filled.Campaign">본사에서 보냄</MudChip>
                            }
                            else if (it.ReplyCount > 0)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">답 @it.ReplyCount</MudChip>
                            }
                            <MudChip T="string" Size="Size.Small" Color="@StatusColor(it)" Variant="Variant.Outlined">@StatusLabel(it)</MudChip>
                            @* 🔴 20261012작4 B-4 — 본사 진행 상태는 **별도 칸**이다(사장님 결재).
                               위 칩(쪽지 자신의 진행)을 덮지 않고 그 옆에 선다 — 두 축이 섞이면
                               「답변 도착」이 「완료」에 덮여 어느 쪽 사실인지 사라진다.
                               NULL(본사 미착수)이면 아무것도 안 보인다 = 종전 화면 그대로. *@
                            @if (!string.IsNullOrWhiteSpace(it.HqStatus))
                            {
                                <MudChip T="string" Size="Size.Small" Color="@HqStatusColor(it.HqStatus)"
                                         Variant="Variant.Filled" Icon="@Icons.Material.Filled.SupportAgent">
                                    본사 @it.HqStatus
                                </MudChip>
                            }
                        </span>
                    </div>
                    <div class="hp-cs-row-meta">@it.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                </MudListItem>
            }
        </MudList>
    </MudPaper>
}

@code {
    private Dictionary<string, string> _categories = new();
    private Dictionary<string, string> _subTags = new();
    private string _category = "";
    private string _subTag = "";
    private string? _body;
    private bool _sending;
    private bool _loading = true;
    private List<CsItem> _items = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            // 🔴 20261014작1 — **내 쪽만** 묻는다(`origin=local`). 사장님 오더 10/14 = 공지/CS 분리.
            //   왜 서버에서 가르나: 200건 받아 화면에서 걸러내면 본사 공지가 쌓일 때 내 문의가
            //   LIMIT 밖으로 밀려 사라진다(1V A-1). 칸이 없는 DB 에서는 서버가 조건을 안 달아
            //   **종전처럼 전부** 온다 — 그때도 목록이 비지 않는다(설계 §8 보장).
            var res = await Http.GetFromJsonAsync<ListResponse>("api/cs/requests?origin=local");
            _items = res?.Data ?? new();
            _categories = res?.Categories ?? new();
            _subTags = res?.SubTags ?? new();
            if (string.IsNullOrEmpty(_category) && _categories.Count > 0) _category = _categories.Keys.First();
            if (string.IsNullOrEmpty(_subTag) && _subTags.Count > 0) _subTag = _subTags.Keys.Last(); // 기본 = 기타
        }
        catch (Exception ex)
        {
            @* 🔴 20261012작6 — 사유를 삼키지 않는다(#15). 사장님 실측 때 화면은 「불러오지 못했습니다」만
               말했고 원인(JSON 역직렬화 실패)은 어디에도 안 남았다 ⇒ 다음 사람이 또 헤맨다.
               고객에게는 개발용어를 안 보인다(사장님 헌법) — 사유는 로그에만 남긴다. *@
            _logger.LogWarning(ex, "[CS쪽지] 목록 조회 실패 — 화면에는 재시도 안내만 보인다");
            Snackbar.Add("문의 목록을 불러오지 못했습니다. 잠시 후 다시 시도해 주세요.", Severity.Warning);
        }
        _loading = false;
    }

    private async Task SendAsync()
    {
        if (string.IsNullOrEmpty(_category) || string.IsNullOrEmpty(_subTag))
        {
            Snackbar.Add("유형과 업무를 선택해 주세요.", Severity.Warning);
            return;
        }
        _sending = true;
        try
        {
            var res = await Http.PostAsJsonAsync("api/cs/requests", new
            {
                category = _category,
                subTag = _subTag,
                body = _body,
                screenCode = "cs-request",
            });
            if (res.IsSuccessStatusCode)
            {
                // 게이트③ — 「접수됐습니다」는 서버 INSERT 성공 뒤에만.
                Snackbar.Add("접수됐습니다. 답이 오면 화면 위에 알려 드립니다.", Severity.Success);
                _body = null;
                await LoadAsync();
            }
            else
            {
                var err = await res.Content.ReadFromJsonAsync<ApiMessage>();
                // 금지필드 안내(문①) — 거부가 아니라 고칠 기회: 그 부분을 지우면 보낼 수 있다.
                Snackbar.Add(err?.Message ?? "보내지 못했습니다. 내용을 확인해 주세요.", Severity.Warning);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("보내지 못했습니다. 연결 상태를 확인해 주세요.", Severity.Warning);
        }
        _sending = false;
    }

    private string CategoryLabel(string code) => _categories.TryGetValue(code, out var v) ? v : code;
    private static string Preview(string body) => body.Length <= 40 ? body : body[..40] + "…";

    // 상태 — 「아직 본사에 안 갔음」이 핵심이다(설계 §2-5 · 고쳤다 ≠ 갔다).
    private static string StatusLabel(CsItem it) => it switch
    {
        { TerminalReason: "rejected" } => "보낼 수 없음 — 내용 확인",
        // 🔴 20261012작3 — 종전 문구는 「전송 지연 — **본사 확인 중**」이었다. **거짓이다.**
        //   `failed` 는 50회 재시도가 다 실패해 멈춘 상태다(백오프 상한 10분 ⇒ 약 8시간 뒤).
        //   그 쪽지는 **본사에 도착한 적이 없어 본사는 존재 자체를 모른다** — 확인할 사람이 없다.
        //   게다가 `terminal_reason` 을 비우는 코드가 레포 전체에 **0건**이라 그 행은 영구히 멈춘다.
        //   ⇒ 「기다리면 된다」고 말하면 고객은 영원히 기다린다. 할 수 있는 일을 말한다.
        //   ([4] V-4 「쪽지함이 본사 안내를 「답」이라고 말했다」와 같은 종류다)
        { TerminalReason: "failed" } => "본사에 전달되지 않음 — 다시 보내 주세요",
        { Status: "답변도착" } => "답변 도착",
        { Status: "종결" } => "종결",
        { SentAt: null } => "아직 본사에 안 갔음",
        _ => "접수됨",
    };

    // 🔴 작4 B-4 — 본사 진행 색. 「완료」만 초록이다 — 처리중을 초록으로 하면 다 끝난 것처럼 읽힌다.
    private static Color HqStatusColor(string? s) => s switch
    {
        "완료" => Color.Success,
        "처리중" => Color.Info,
        "보류" => Color.Warning,
        _ => Color.Default,
    };

    private static Color StatusColor(CsItem it) => it switch
    {
        { TerminalReason: "rejected" } or { TerminalReason: "failed" } => Color.Error,
        { Status: "답변도착" } => Color.Success,
        { SentAt: null } => Color.Warning,
        _ => Color.Default,
    };

    private sealed class ListResponse
    {
        public bool Success { get; set; }
        public List<CsItem> Data { get; set; } = new();
        public Dictionary<string, string> Categories { get; set; } = new();
        public Dictionary<string, string> SubTags { get; set; } = new();
    }

    private sealed class CsItem
    {
        public string CsRequestId { get; set; } = "";
        public string Category { get; set; } = "";
        public string? SubTag { get; set; }
        public string? Body { get; set; }
        public string Status { get; set; } = "";
        /// <summary>local = 내가 쓴 문의 · hq = 본사가 먼저 보낸 안내(작3 B-4)</summary>
        public string? Origin { get; set; }
        public DateTime CreatedAt { get; set; }
        public DateTime? SentAt { get; set; }
        public string? TerminalReason { get; set; }
        public int AttemptCount { get; set; }
        public int ReplyCount { get; set; }

        /// <summary>🔴 작4 B-4 — 본사 진행 상태(접수·처리중·보류·완료). null = 본사 미착수.</summary>
        public string? HqStatus { get; set; }
        public DateTime? HqStatusAt { get; set; }
    }

    private sealed class ApiMessage { public string? Message { get; set; } }
}
