@page "/stock"
@namespace HitPan.Web.Pages.StockUi
@attribute [Authorize]

<PageTitle>재고 현황</PageTitle>
<MudText Typo="Typo.h6" Class="mb-3">재고 현황</MudText>

<MudPaper Class="pa-3 mb-3" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default);border-radius:12px">
    <MudGrid Spacing="2" Class="align-center">
        <MudItem xs="12" sm="3">
            <MudSelect T="string" @bind-Value="_viewType" Label="조회유형" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="@("period")">기간별 상품재고현황</MudSelectItem>
                <MudSelectItem Value="@("warehouse")">창고별 재고현황</MudSelectItem>
                <MudSelectItem Value="@("optimal")">적정재고대비 현황</MudSelectItem>
                <MudSelectItem Value="@("safety")">안전재고 현황</MudSelectItem>
                <MudSelectItem Value="@("dead-stock")">재고월수(사장재고) 현황</MudSelectItem>
                <MudSelectItem Value="@("loss-rate")">재고 로스율</MudSelectItem>
                <MudSelectItem Value="@("monthly-io")">년간월별 입출재고현황(세부)</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudDatePicker @bind-Date="_from" Label="시작일" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="yyyy-MM-dd" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudDatePicker @bind-Date="_to" Label="종료일" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="yyyy-MM-dd" />
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudTextField @bind-Value="_partner" Label="업체명" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Disabled="true">조회</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudAlert Severity="Severity.Info">@GetViewLabel() 데이터는 준비중입니다.</MudAlert>

@code {
    private string _viewType = "period";
    private DateTime? _from = DateTime.Today.AddDays(-30);
    private DateTime? _to = DateTime.Today;
    private string _partner = "";

    private string GetViewLabel() => _viewType switch
    {
        "period" => "기간별 상품재고현황",
        "warehouse" => "창고별 재고현황",
        "optimal" => "적정재고대비 현황",
        "safety" => "안전재고 현황",
        "dead-stock" => "재고월수(사장재고) 현황",
        "loss-rate" => "재고 로스율",
        "monthly-io" => "년간월별 입출재고현황(세부)",
        _ => "재고 현황"
    };
}
