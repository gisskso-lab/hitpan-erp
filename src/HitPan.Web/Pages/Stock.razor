@page "/stock"
@namespace HitPan.Web.Pages.StockUi
@attribute [Authorize]
@using HitPan.Web.Models
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime Js
@inject ISnackbar Snackbar

<PageTitle>재고 현황</PageTitle>

<PageHeader Title="재고 현황" Subtitle="전체 창고의 현재 재고 및 가용 수량">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SearchAsync">조회</MudButton>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Print" OnClick="PrintAsync">인쇄</MudButton>
    </Actions>
</PageHeader>

@* KPI 요약 *@
<MudGrid Spacing="2" Class="mb-3">
    <MudItem xs="12" sm="4">
        <KpiCard Color="KpiCard.KpiColor.Info"
                 Icon="@Icons.Material.Filled.Inventory2"
                 Label="조회 행 수"
                 Value="@_filteredData.Count().ToString("N0")" />
    </MudItem>
    <MudItem xs="12" sm="4">
        <KpiCard Color="KpiCard.KpiColor.Primary"
                 Icon="@Icons.Material.Filled.Functions"
                 Label="재고금액 합계"
                 Value="@_filteredData.Sum(x => x.SupplyAmount).ToString("N0")" />
    </MudItem>
    <MudItem xs="12" sm="4">
        <KpiCard Color="KpiCard.KpiColor.Error"
                 Icon="@Icons.Material.Filled.ReportProblem"
                 Label="안전재고 미달"
                 Value="@_filteredData.Count(x => x.IsBelowSafety).ToString("N0")" />
    </MudItem>
</MudGrid>

@* 필터 영역 *@
<SectionCard Title="조회 조건">
    <MudGrid Spacing="2" Class="align-center">
        <MudItem xs="12" sm="3">
            <MudSelect T="string" @bind-Value="_viewType" Label="조회유형" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="@("current")">기간별 상품재고현황</MudSelectItem>
                <MudSelectItem Value="@("warehouse")">창고별 재고현황</MudSelectItem>
                <MudSelectItem Value="@("optimal")">적정재고대비 현황</MudSelectItem>
                <MudSelectItem Value="@("safety")">안전재고 현황</MudSelectItem>
                <MudSelectItem Value="@("dead-stock")">재고월수(사장재고) 현황</MudSelectItem>
                <MudSelectItem Value="@("loss-rate")">재고 로스율</MudSelectItem>
                <MudSelectItem Value="@("monthly-io")">년간월별 입출재고현황(세부)</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudTextField @bind-Value="_search" Label="품목명 검색" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" />
        </MudItem>
    </MudGrid>
</SectionCard>

@* 사장님 결재 2026-04-29: 7종 풀스택 → 가드 제거. optimal/dead/loss/io 컬럼 의미 다름. *@
<SectionCard Variant="SectionCard.SectionVariant.Flat">
    <MudTable T="ReportRow" Items="_filteredData" Dense="true" Hover="true" Striped="true" FixedHeader="true" Height="calc(100vh - 280px)"
              RowStyleFunc="@((row, _) => row.IsBelowSafety ? "background-color:#FEF2F2;color:#DC2626;font-weight:500" : "")">
        <HeaderContent>
            <MudTh>@GetLabelHeader()</MudTh>
            @if (_viewType == "warehouse") { <MudTh Style="text-align:right">품목수</MudTh> }
            <MudTh Style="text-align:right">@GetQtyHeader()</MudTh>
            <MudTh Style="text-align:right">@GetSupplyHeader()</MudTh>
            @if (ShowExtraCol()) { <MudTh Style="text-align:right">@GetVatHeader()</MudTh> }
            <MudTh Style="text-align:right">@GetTotalHeader()</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Label</MudTd>
            @if (_viewType == "warehouse") { <MudTd Style="text-align:right">@context.Count.ToString("N0")</MudTd> }
            <MudTd Style="text-align:right">@context.Qty.ToString("N1")</MudTd>
            <MudTd Style="text-align:right">@context.SupplyAmount.ToString("N0")</MudTd>
            @if (ShowExtraCol()) { <MudTd Style="text-align:right">@context.VatAmount.ToString("N1")</MudTd> }
            <MudTd Style="text-align:right;font-weight:500">@context.TotalAmount.ToString("N0")</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <EmptyState Icon="@Icons.Material.Filled.Inventory2"
                        Title="조회된 재고가 없습니다"
                        Subtitle="검색어나 조회 유형을 변경해 보세요." />
        </NoRecordsContent>
    </MudTable>
</SectionCard>

@code {
    private string _viewType = "current";
    private string _search = "";
    private List<ReportRow> _reportData = new();

    /// <summary>검색어로 필터링된 데이터를 반환한다.</summary>
    private IEnumerable<ReportRow> _filteredData =>
        string.IsNullOrWhiteSpace(_search)
            ? _reportData
            : _reportData.Where(r => r.Label.Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync() => await SearchAsync();

    /// <summary>재고현황을 조회한다.</summary>
    private async Task SearchAsync()
    {
        var path = $"api/reports/stock-status?view={_viewType}";
        try
        {
            _reportData = await Http.GetFromJsonAsync<List<ReportRow>>(path) ?? new();
        }
        catch
        {
            _reportData = new();
        }
        StateHasChanged();
    }

    /// <summary>화면을 인쇄한다.</summary>
    private async Task PrintAsync() { await Js.InvokeVoidAsync("print"); }

    /// <summary>테이블 첫 번째 컬럼 헤더를 반환한다.</summary>
    private string GetLabelHeader() => _viewType switch
    {
        "warehouse" => "창고명",
        "safety" => "품목명 (안전재고 미달)",
        "monthly-io" => "품목 (월)",
        _ => "품목명"
    };

    // 동적 컬럼 — 조회유형마다 의미 다름
    private bool ShowExtraCol() => _viewType is "current" or "safety" or "optimal" or "dead-stock" or "loss-rate" or "monthly-io";
    private string GetQtyHeader() => _viewType switch
    {
        "loss-rate" => "조정수량",
        "monthly-io" => "입고량",
        _ => "수량"
    };
    private string GetSupplyHeader() => _viewType switch
    {
        "current" or "optimal" => "안전재고",
        "safety" => "안전재고",
        "dead-stock" => "원가재고액",
        "loss-rate" => "현재고",
        "monthly-io" => "출고량",
        _ => "재고금액"
    };
    private string GetVatHeader() => _viewType switch
    {
        "current" or "safety" => "안전재고",
        "optimal" => "적정비율(%)",
        "dead-stock" => "미출고일수",
        "loss-rate" => "로스율(%)",
        "monthly-io" => "잔량",
        _ => "—"
    };
    private string GetTotalHeader() => _viewType switch
    {
        "monthly-io" => "입출차액",
        "loss-rate" => "로스금액",
        _ => "재고금액"
    };

    /// <summary>준비중 메시지용 뷰 라벨을 반환한다.</summary>
    private string GetViewLabel() => _viewType switch
    {
        "optimal" => "적정재고대비 현황",
        "dead-stock" => "재고월수(사장재고) 현황",
        "loss-rate" => "재고 로스율",
        "monthly-io" => "년간월별 입출재고현황(세부)",
        _ => "재고 현황"
    };
}
