@page "/landing"
@layout LandingLayout
@using Microsoft.AspNetCore.Components

@*
  HomePage — 랜딩 홈 (WS-20260601-12, 2026-06-01 박제)
  - 2버튼 UI: 신규등록(그린 64%) + 계정분실/문의(오렌지 36%)
  - 슬로건 1줄 + 신뢰뱃지 3개(메이크빌·바른·KISA)
  - 스크롤 0 / 8pt grid / 버튼 56px h / 라운드 12px
*@

<PageTitle>히트판 ERP — 처음 쓰는 사람도 그냥 되는 ERP</PageTitle>

<section class="landing-hero">
    <div class="landing-container hero-inner">
        <span class="badge">베타 신청 진행 중</span>
        <h1 class="slogan">처음 쓰는 사람도 3분 안에 쓰는 ERP</h1>

        <div class="two-button-row">
            <a href="/signup" class="btn-green" aria-label="신규 등록 (그린)">
                <span class="btn-title">신규 등록</span>
                <span class="btn-sub">사업자등록증 1장이면 3분 가입</span>
            </a>
            <a href="/recover" class="btn-orange" aria-label="계정 분실 · 문의 (오렌지)">
                <span class="btn-title">계정 분실 · 문의</span>
                <span class="btn-sub">이메일·휴대폰 분실 복구</span>
            </a>
        </div>

        <div class="trust-badges">
            <span class="trust-badge">
                <span class="trust-dot trust-makebill"></span>
                메이크빌 기술협력
            </span>
            <span class="trust-badge">
                <span class="trust-dot trust-barun"></span>
                바른 법무자문
            </span>
            <span class="trust-badge">
                <span class="trust-dot trust-kisa"></span>
                KISA ISMS 준비
            </span>
        </div>
    </div>
</section>

<style>
.landing-hero {
    padding: 64px 0 48px;
    background: linear-gradient(135deg, #F0F9F5 0%, #FFFFFF 100%);
    min-height: calc(100vh - 200px);
    display: flex;
    align-items: center;
}
.hero-inner {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    max-width: 880px;
    width: 100%;
    margin: 0 auto;
    padding: 0 24px;
}
.badge {
    align-self: flex-start;
    background: #FFF0EB;
    color: #B7390B;
    padding: 8px 16px;
    border-radius: 16px;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 16px;
}
.slogan {
    font-size: 40px;
    line-height: 1.25;
    color: #0F1419;
    font-weight: 800;
    margin: 0 0 32px;
}

.two-button-row {
    display: grid;
    grid-template-columns: 64fr 36fr;
    gap: 16px;
    margin-bottom: 32px;
}
.btn-green, .btn-orange {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    min-height: 96px;
    padding: 16px 24px;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 700;
    transition: transform 0.12s ease, box-shadow 0.12s ease, background 0.12s ease;
    text-align: center;
}
.btn-green {
    background: #0F6E56;
    color: #FFFFFF;
    box-shadow: 0 8px 24px rgba(15, 110, 86, 0.20);
}
.btn-green:hover { background: #0A5240; transform: translateY(-2px); box-shadow: 0 12px 28px rgba(15, 110, 86, 0.28); }
.btn-orange {
    background: #FF6B35;
    color: #FFFFFF;
    box-shadow: 0 8px 24px rgba(255, 107, 53, 0.20);
}
.btn-orange:hover { background: #E55A2A; transform: translateY(-2px); box-shadow: 0 12px 28px rgba(255, 107, 53, 0.28); }
.btn-title { font-size: 20px; line-height: 1.2; }
.btn-sub { font-size: 13px; opacity: 0.92; margin-top: 8px; font-weight: 500; }

.trust-badges {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
}
.trust-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 999px;
    padding: 8px 16px;
    color: #4B5563;
    font-size: 13px;
    font-weight: 600;
}
.trust-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
.trust-makebill { background: #0F6E56; }
.trust-barun { background: #1F4E79; }
.trust-kisa { background: #B7390B; }

@@media (max-width: 640px) {
    .slogan { font-size: 28px; margin-bottom: 24px; }
    .two-button-row { grid-template-columns: 1fr; }
    .btn-green, .btn-orange { min-height: 72px; }
    .btn-title { font-size: 18px; }
}
</style>
