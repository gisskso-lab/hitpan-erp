@page "/stock/adjust"
@namespace HitPan.Web.Pages.StockUi
@attribute [Authorize]
@using HitPan.Web.Models
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime Js
@inject ISnackbar Snackbar
@inject ItemMasterService ItemsApi

<PageTitle>재고 실사·조정</PageTitle>
<PageHeader Title="재고 실사·조정" Subtitle="장부재고와 실재고 차이 조정 · 조정 원장 기록" />

@* 조정 입력 영역 *@
<MudPaper Class="pa-3 mb-3" Elevation="0" Style="border:0.5px solid var(--mud-palette-lines-default);border-radius:12px">
    <MudGrid Spacing="2" Class="align-center">
        <MudItem xs="12" sm="3">
            <MudAutocomplete T="string" Value="_selectedItem" ValueChanged="OnItemChanged"
                SearchFunc="SearchItemAsync" Label="품목 검색" Variant="Variant.Outlined" Margin="Margin.Dense"
                Placeholder="품명 입력" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudSelect T="string" @bind-Value="_selectedWarehouse" Label="창고" Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (var wh in _warehouses)
                {
                    <MudSelectItem Value="@wh.Code">@wh.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudNumericField T="decimal" @bind-Value="_actualQty" Label="실사수량" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N1" />
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudTextField @bind-Value="_reason" Label="조정 사유" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AdjustAsync" Disabled="_isProcessing">조정</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@* 이력 필터 *@
<MudPaper Class="pa-3 mb-3" Elevation="0" Style="border:0.5px solid var(--mud-palette-lines-default);border-radius:12px">
    <MudGrid Spacing="2" Class="align-center">
        <MudItem xs="12" sm="2">
            <MudDatePicker @bind-Date="_from" Label="시작일" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:160px" DateFormat="yyyy-MM-dd" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudDatePicker @bind-Date="_to" Label="종료일" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:160px" DateFormat="yyyy-MM-dd" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadHistoryAsync">조회</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@* 로딩 바 *@
@if (_isLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
}

@* 조정 이력 테이블 *@
<MudPaper Elevation="0" Style="border:0.5px solid var(--mud-palette-lines-default);border-radius:12px;overflow:hidden">
    <MudTable T="AdjustHistoryRow" Items="_history" Dense="true" Hover="true" Striped="true" FixedHeader="true" Height="calc(100vh - 420px)">
        <HeaderContent>
            <MudTh>일자</MudTh>
            <MudTh>품목</MudTh>
            <MudTh>창고</MudTh>
            <MudTh Style="text-align:right">장부수량</MudTh>
            <MudTh Style="text-align:right">실사수량</MudTh>
            <MudTh Style="text-align:right">차이</MudTh>
            <MudTh>조정유형</MudTh>
            <MudTh>사유</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.AdjustDate</MudTd>
            <MudTd>@context.ItemName</MudTd>
            <MudTd>@context.WarehouseName</MudTd>
            <MudTd Style="text-align:right">@context.BookQty.ToString("N1")</MudTd>
            <MudTd Style="text-align:right">@context.ActualQty.ToString("N1")</MudTd>
            <MudTd Style="@($"text-align:right;color:{(context.Diff > 0 ? "var(--hitpan-info)" : context.Diff < 0 ? "var(--hitpan-expense)" : "inherit")}")">@context.Diff.ToString("N1")</MudTd>
            <MudTd>@context.AdjustType</MudTd>
            <MudTd>@context.Reason</MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText Class="pa-4" Style="color:#9CA3AF">조정 이력이 없습니다.</MudText></NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    // --- 입력 필드 ---
    private string _selectedItem = "";
    private string _selectedWarehouse = "";
    private decimal _actualQty;
    private string _reason = "";
    private bool _isProcessing;
    private bool _isLoading;

    // --- 필터 ---
    private DateTime? _from = DateTime.Today.AddDays(-30);
    private DateTime? _to = DateTime.Today;

    // --- 데이터 ---
    private List<WarehouseOption> _warehouses = new();
    private List<AdjustHistoryRow> _history = new();
    private List<ItemListModel>? _itemCache;

    protected override async Task OnInitializedAsync()
    {
        await LoadWarehousesAsync();
        await LoadHistoryAsync();
    }

    /// <summary>창고 목록을 로드한다.</summary>
    private async Task LoadWarehousesAsync()
    {
        try
        {
            _warehouses = await Http.GetFromJsonAsync<List<WarehouseOption>>("api/warehouses") ?? new();
        }
        catch (Exception _hp15Ex)
        {
            Console.Error.WriteLine($"[HP15] " + _hp15Ex.GetType().Name + ": " + _hp15Ex.Message);
            _warehouses = new();
        }
    }

    /// <summary>품목 자동완성 검색을 수행한다.</summary>
    private async Task<IEnumerable<string>> SearchItemAsync(string value, CancellationToken ct)
    {
        _itemCache ??= await ItemsApi.GetListAsync() ?? new();
        if (string.IsNullOrWhiteSpace(value))
            return _itemCache.Select(i => i.ItemName).Distinct();
        return _itemCache
            .Where(i => i.ItemName.Contains(value, StringComparison.OrdinalIgnoreCase))
            .Select(i => i.ItemName).Distinct();
    }

    /// <summary>품목 선택 시 처리한다.</summary>
    private void OnItemChanged(string value)
    {
        _selectedItem = value ?? "";
    }

    /// <summary>재고 조정을 실행한다.</summary>
    private async Task AdjustAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedItem))
        {
            Snackbar.Add("품목을 선택해주세요.", Severity.Warning);
            return;
        }
        if (string.IsNullOrWhiteSpace(_selectedWarehouse))
        {
            Snackbar.Add("창고를 선택해주세요.", Severity.Warning);
            return;
        }

        // 봉합 (2026-06-22, 9차 전수조사 프론트 P1): 종전엔 payload 키가 ItemName·WarehouseCode 였으나
        //   백엔드 StockAdjustRequest 는 ItemId·WarehouseId 를 기대해(별칭 없음) 둘 다 빈 문자열로 바인딩 →
        //   AdjustStock 이 item_id='' AND warehouse_id='' 로 현재고 0 산출 → 빈 item_id 로 stock_ledger 오염
        //   + item_stock 0행 UPDATE("조정했는데 재고 그대로", 헌법 #20). 자매 화면 StockTransferPage(커밋
        //   4c4f8fc) 정정 패턴 그대로: autocomplete 품목명을 ItemId 로 해석하고, 창고는 _selectedWarehouse 가
        //   이미 warehouseId(WarehouseOption.Code = JSON warehouseId) 이므로 WarehouseId 로 직접 전송한다.
        _itemCache ??= await ItemsApi.GetListAsync() ?? new();
        var matchedItem = _itemCache.FirstOrDefault(i =>
            string.Equals(i.ItemName, _selectedItem, StringComparison.OrdinalIgnoreCase));
        if (matchedItem is null || string.IsNullOrEmpty(matchedItem.ItemId))
        {
            Snackbar.Add("품목을 다시 선택해주세요.", Severity.Warning);
            return;
        }

        _isProcessing = true;
        try
        {
            var payload = new
            {
                ItemId = matchedItem.ItemId,
                WarehouseId = _selectedWarehouse,
                ActualQty = _actualQty,
                Reason = _reason
            };
            var resp = await Http.PostAsJsonAsync("api/stock/adjust", payload);
            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add("재고 조정이 완료되었습니다.", Severity.Success);
                _selectedItem = "";
                _actualQty = 0;
                _reason = "";
                await LoadHistoryAsync();
            }
            else
            {
                Snackbar.Add("조정 처리에 실패했습니다.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"오류: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessing = false;
        }
    }

    /// <summary>조정 이력을 조회한다.</summary>
    private async Task LoadHistoryAsync()
    {
        _isLoading = true;
        StateHasChanged();
        try
        {
            var qs = new List<string>();
            if (_from.HasValue) qs.Add($"from={_from:yyyy-MM-dd}");
            if (_to.HasValue) qs.Add($"to={_to:yyyy-MM-dd}");
            var path = "api/stock/adjust/history" + (qs.Any() ? "?" + string.Join("&", qs) : "");
            _history = await Http.GetFromJsonAsync<List<AdjustHistoryRow>>(path) ?? new();
        }
        catch (Exception _hp15Ex)
        {
            Console.Error.WriteLine($"[HP15] " + _hp15Ex.GetType().Name + ": " + _hp15Ex.Message);
            _history = new();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    // --- 내부 모델 ---
    private class WarehouseOption
    {
        [System.Text.Json.Serialization.JsonPropertyName("warehouseId")]
        public string Code { get; set; } = "";

        [System.Text.Json.Serialization.JsonPropertyName("whName")]
        public string Name { get; set; } = "";
    }

    private class AdjustHistoryRow
    {
        public string AdjustDate { get; set; } = "";
        public string ItemName { get; set; } = "";
        public string WarehouseName { get; set; } = "";
        public decimal BookQty { get; set; }
        public decimal ActualQty { get; set; }
        public decimal Diff { get; set; }
        public string AdjustType { get; set; } = "";
        public string Reason { get; set; } = "";
    }
}
