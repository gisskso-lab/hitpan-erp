@page "/stock/warehouse-manage"
@namespace HitPan.Web.Pages.StockUi
@attribute [Authorize]
@using Microsoft.JSInterop
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime Js

<PageTitle>창고 관리</PageTitle>

<PageHeader Title="창고 관리" Subtitle="본점·지점 창고 등록 및 관리">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddDialog">
            창고 추가
        </MudButton>
    </Actions>
</PageHeader>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudTable Items="_warehouses" Hover="true" Striped="true" Dense="true" Elevation="0"
              Style="border:1px solid var(--mud-palette-lines-default);border-radius:12px">
        <HeaderContent>
            <MudTh>코드</MudTh>
            <MudTh>창고명</MudTh>
            <MudTh>유형</MudTh>
            <MudTh>위치</MudTh>
            <MudTh>상태</MudTh>
            <MudTh Style="width:140px;text-align:center">관리</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.WhCode</MudTd>
            <MudTd>@context.WhName</MudTd>
            <MudTd>@context.WhType</MudTd>
            <MudTd>@context.Location</MudTd>
            <MudTd>
                <MudChip T="string" Color="@(context.IsActive ? Color.Success : Color.Default)" Size="Size.Small">
                    @(context.IsActive ? "활성" : "비활성")
                </MudChip>
            </MudTd>
            <MudTd Style="text-align:center">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                               OnClick="@(() => OpenEditDialog(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               OnClick="@(() => DeleteWarehouse(context))" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="pa-4">등록된 창고가 없습니다.</MudText>
        </NoRecordsContent>
    </MudTable>
}

@* 추가/수정 다이얼로그 *@
<MudDialog @bind-Visible="_dialogVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_editMode ? "창고 수정" : "창고 추가")</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_form.WhCode" Label="창고코드" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
        <MudTextField @bind-Value="_form.WhName" Label="창고명" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
        <MudSelect T="string" @bind-Value="_form.WhType" Label="유형" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2">
            <MudSelectItem Value="@("자사창고")">자사창고</MudSelectItem>
            <MudSelectItem Value="@("3PL")">3PL</MudSelectItem>
            <MudSelectItem Value="@("기타")">기타</MudSelectItem>
        </MudSelect>
        @* 🔴 20260825작19 — 위치를 우편번호로 정확히 잡고 네비로 바로 연결한다 (사장님 오더).
             *"창고추가-> 위치에 카카오맵 zip코드로 정확한 주소 넣고, 카카오네비 자동연결(업체마스터 참고)"*
             업체마스터(PartnerDetail)와 **같은 방식**이다 — 새로 만들지 않고 그 패턴을 그대로 쓴다. *@
        <div style="display:flex;gap:8px;align-items:end" class="mb-2">
            <MudTextField @bind-Value="_form.ZipCode" Label="우편번호" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true" Style="flex:1" />
            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="SearchAddressAsync" Style="height:40px;white-space:nowrap">우편번호 찾기</MudButton>
        </div>
        <MudTextField @bind-Value="_form.Address" Label="주소" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true" Class="mb-2" />
        <MudTextField @bind-Value="_form.AddressDetail" Label="상세주소" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="상세주소를 입력하세요" Class="mb-2" />

        @* 네비게이션 — 주소가 있을 때만. 업체마스터와 동일. *@
        @if (!string.IsNullOrWhiteSpace(_form.Address))
        {
            <div class="hp-navi-row mb-2">
                <span class="hp-navi-label">네비게이션</span>
                <button type="button" class="hp-navi-btn hp-navi-btn--kakao" @onclick="OpenKakaoNaviAsync">
                    <img src="https://t1.kakaocdn.net/kakao_for_business/images/icon/favicon/favicon-16x16.png" width="14" height="14" alt="" style="border-radius:3px" />
                    카카오내비
                </button>
            </div>
        }

        @* 위치 — 우편번호 주소와 별개로 남긴다. 손으로 적어둔 메모("A동 2층" 등)가 들어 있다(헌법 #1·#37). *@
        <MudTextField @bind-Value="_form.Location" Label="위치 메모" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Placeholder="예: A동 2층 · 하역장 옆" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseDialog">취소</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveWarehouse" Disabled="_saving">저장</MudButton>
    </DialogActions>
</MudDialog>

@code {
    // 창고 목록
    private List<WarehouseViewModel> _warehouses = new();
    private bool _loading = true;

    // 다이얼로그 상태
    private bool _dialogVisible;
    private bool _editMode;
    private bool _saving;
    private string? _editId;
    private WarehouseFormModel _form = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadWarehousesAsync();
    }

    /// <summary>창고 목록 로드</summary>
    private async Task LoadWarehousesAsync()
    {
        _loading = true;
        try
        {
            _warehouses = await Http.GetFromJsonAsync<List<WarehouseViewModel>>("api/warehouses") ?? new();
        }
        catch (Exception _hp15Ex)
        {
            Console.Error.WriteLine($"[HP15] " + _hp15Ex.GetType().Name + ": " + _hp15Ex.Message);
            Snackbar.Add("창고 목록을 불러오지 못했습니다.", Severity.Error);
        }
        _loading = false;
    }

    /// <summary>추가 다이얼로그 열기</summary>
    private void OpenAddDialog()
    {
        _editMode = false;
        _editId = null;
        _form = new WarehouseFormModel { WhType = "자사창고" };
        _dialogVisible = true;
    }

    /// <summary>수정 다이얼로그 열기</summary>
    private void OpenEditDialog(WarehouseViewModel wh)
    {
        _editMode = true;
        _editId = wh.WarehouseId;
        _form = new WarehouseFormModel
        {
            WhCode = wh.WhCode,
            WhName = wh.WhName,
            WhType = wh.WhType,
            Location = wh.Location,
            // 20260825작19 — 수정 화면에도 주소를 실어준다. 안 실으면 저장할 때
            //   빈 값으로 덮여 **주소가 조용히 지워진다**(작7 에서 겪은 비대칭 사고).
            ZipCode = wh.ZipCode,
            Address = wh.Address,
            AddressDetail = wh.AddressDetail
        };
        _dialogVisible = true;
    }

    private void CloseDialog() => _dialogVisible = false;

    /// <summary>창고 저장 (추가/수정)</summary>
    private async Task SaveWarehouse()
    {
        if (string.IsNullOrWhiteSpace(_form.WhCode) || string.IsNullOrWhiteSpace(_form.WhName))
        {
            Snackbar.Add("창고코드와 창고명은 필수입니다.", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            HttpResponseMessage resp;
            if (_editMode && _editId is not null)
            {
                resp = await Http.PutAsJsonAsync($"api/warehouses/{_editId}", _form);
            }
            else
            {
                resp = await Http.PostAsJsonAsync("api/warehouses", _form);
            }

            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add(_editMode ? "수정되었습니다." : "추가되었습니다.", Severity.Success);
                _dialogVisible = false;
                await LoadWarehousesAsync();
            }
            else
            {
                Snackbar.Add("저장에 실패했습니다.", Severity.Error);
            }
        }
        catch (Exception _hp15Ex)
        {
            Console.Error.WriteLine($"[HP15] " + _hp15Ex.GetType().Name + ": " + _hp15Ex.Message);
            Snackbar.Add("서버 오류가 발생했습니다.", Severity.Error);
        }
        _saving = false;
    }

    /// <summary>창고 삭제 (소프트 삭제)</summary>
    private async Task DeleteWarehouse(WarehouseViewModel wh)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "창고 삭제",
            $"'{wh.WhName}' 창고를 삭제하시겠습니까?",
            yesText: "삭제", cancelText: "취소");
        if (confirm != true) return;

        try
        {
            var resp = await Http.DeleteAsync($"api/warehouses/{wh.WarehouseId}");
            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add("삭제되었습니다.", Severity.Success);
                await LoadWarehousesAsync();
            }
            else
            {
                Snackbar.Add("삭제에 실패했습니다.", Severity.Error);
            }
        }
        catch (Exception _hp15Ex)
        {
            Console.Error.WriteLine($"[HP15] " + _hp15Ex.GetType().Name + ": " + _hp15Ex.Message);
            Snackbar.Add("서버 오류가 발생했습니다.", Severity.Error);
        }
    }

    /// <summary>
    /// 우편번호 찾기 — 업체마스터와 같은 방식이다 (20260825작19 · 사장님 오더 "업체마스터 참고").
    /// </summary>
    private async Task SearchAddressAsync()
    {
        var dotNetRef = DotNetObjectReference.Create(this);
        await Js.InvokeVoidAsync("openDaumPostcode", dotNetRef);
    }

    /// <summary>우편번호 찾기 창이 고른 주소를 받는다. JS 가 이 이름으로 부른다.</summary>
    [JSInvokable]
    public Task OnAddressSelected(string zipCode, string address)
    {
        _form.ZipCode = zipCode;
        _form.Address = address;
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>
    /// 카카오내비로 창고 위치를 연다 (20260825작19).
    /// </summary>
    /// <remarks>
    /// ⚠️ 업체마스터는 좌표가 있으면 좌표로 찍는데, <b>창고에는 좌표가 없다</b>.
    /// 그래서 <b>주소 검색</b> 경로만 쓴다 — 20260821작1 에서 사장님이 지적하신
    /// <i>"맵이 뜨긴 하지만 좌표가 안찍힘"</i> 은 주소를 <b>좌표 자리</b>에 넣어 생긴 일이었다.
    /// 같은 실수를 하지 않도록 처음부터 검색 경로로 연다.
    /// </remarks>
    private async Task OpenKakaoNaviAsync()
    {
        var addr = string.Join(" ", new[] { _form.Address, _form.AddressDetail }
            .Where(s => !string.IsNullOrWhiteSpace(s))).Trim();
        if (string.IsNullOrWhiteSpace(addr)) return;

        await Js.InvokeVoidAsync("navigator.clipboard.writeText", addr);

        var enc = Uri.EscapeDataString(addr);
        await Js.InvokeVoidAsync("hitpan.openNavi",
            $"kakaomap://search?q={enc}",
            $"https://map.kakao.com/link/search/{enc}");
        Snackbar.Add("주소로 검색해 엽니다. 주소가 클립보드에 복사됐어요.",
            Severity.Info, cfg => cfg.VisibleStateDuration = 2500);
    }

    // --- 뷰 모델 ---
    private class WarehouseViewModel
    {
        public string WarehouseId { get; set; } = "";
        public string WhCode { get; set; } = "";
        public string WhName { get; set; } = "";
        public string WhType { get; set; } = "";
        public string? Location { get; set; }

        // 20260825작19 (DB-110) — 우편번호로 찾은 주소. 업체마스터(partners)와 같은 축이다.
        public string? ZipCode { get; set; }
        public string? Address { get; set; }
        public string? AddressDetail { get; set; }

        public bool IsActive { get; set; }
    }

    private class WarehouseFormModel
    {
        public string WhCode { get; set; } = "";
        public string WhName { get; set; } = "";
        public string WhType { get; set; } = "자사창고";
        public string? Location { get; set; }

        // 20260825작19 (DB-110)
        public string? ZipCode { get; set; }
        public string? Address { get; set; }
        public string? AddressDetail { get; set; }
    }
}
