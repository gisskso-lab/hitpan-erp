@*
    WS-20260601-18 본사 백오피스 — 전체 통계 대시보드 (8명제 #7)
    작성일: 2026-06-01
    절대 원칙:
      - PlatformOnlyV2 (owner/manager/staff 전원 열람)
      - 평문 사업자정보 0 — 시리얼 수·구독 등급별 분포·결제 상태만
      - Razor에 C# raw string 금지 (헌법 #14)
      - 빈 catch 금지 (헌법 #15)
*@

@page "/admin/stats"
@layout PlatformLayout
@attribute [Authorize(Policy = "PlatformOnlyV2")]
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>전체 통계 — 히트판 백오피스</PageTitle>

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
    <div>
        <MudText Typo="Typo.h5" Style="font-weight:600;">전체 통계 대시보드</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            시리얼 수·구독 등급별 분포·결제 상태 (평문 사업자정보 0)
        </MudText>
    </div>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh"
               OnClick="LoadAsync">새로고침</MudButton>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else
{
    <MudGrid Spacing="3" Class="mb-5">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="1" Style="border-radius:12px;">
                <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px;">
                    <MudIcon Icon="@Icons.Material.Filled.Key" Color="Color.Primary" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary">총 시리얼</MudText>
                </div>
                <MudText Typo="Typo.h4" Style="font-weight:700;">@_stats.TotalSerials.ToString("N0")</MudText>
                <MudText Typo="Typo.caption" Color="Color.Success">활성 @_stats.ActiveSerials</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="1" Style="border-radius:12px;">
                <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px;">
                    <MudIcon Icon="@Icons.Material.Filled.Payments" Color="Color.Success" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary">결제 정상</MudText>
                </div>
                <MudText Typo="Typo.h4" Style="font-weight:700;">@_stats.PaidActive.ToString("N0")</MudText>
                <MudText Typo="Typo.caption" Color="Color.Warning">연체 @_stats.Overdue</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="1" Style="border-radius:12px;">
                <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px;">
                    <MudIcon Icon="@Icons.Material.Filled.SupportAgent" Color="Color.Warning" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary">CS 처리중</MudText>
                </div>
                <MudText Typo="Typo.h4" Style="font-weight:700;">@_stats.OpenTickets.ToString("N0")</MudText>
                <MudText Typo="Typo.caption" Color="Color.Error">P0 @_stats.P0Tickets</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="1" Style="border-radius:12px;">
                <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px;">
                    <MudIcon Icon="@Icons.Material.Filled.MonitorHeart" Color="Color.Info" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary">워치독 정상</MudText>
                </div>
                <MudText Typo="Typo.h4" Style="font-weight:700;">@_stats.HealthyTunnels.ToString("N0")</MudText>
                <MudText Typo="Typo.caption" Color="Color.Error">이상 @_stats.UnhealthyTunnels</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid Spacing="3">
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Elevation="1" Style="border-radius:12px;">
                <MudText Typo="Typo.h6" Class="mb-3">플랜별 시리얼 분포</MudText>
                @foreach (var p in _stats.PlanDistribution)
                {
                    <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px;">
                        <MudText Typo="Typo.body2" Style="min-width:80px;">@p.Plan</MudText>
                        <MudProgressLinear Value="@p.Percent" Color="Color.Primary" Style="flex:1;" />
                        <MudText Typo="Typo.body2" Style="min-width:60px;text-align:right;">@p.Count 건</MudText>
                    </div>
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Elevation="1" Style="border-radius:12px;">
                <MudText Typo="Typo.h6" Class="mb-3">결제 상태 분포</MudText>
                @foreach (var s in _stats.PaymentStatusDistribution)
                {
                    <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px;">
                        <MudText Typo="Typo.body2" Style="min-width:80px;">@s.Status</MudText>
                        <MudProgressLinear Value="@s.Percent" Color="@StatusBarColor(s.Status)" Style="flex:1;" />
                        <MudText Typo="Typo.body2" Style="min-width:60px;text-align:right;">@s.Count 건</MudText>
                    </div>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private bool _loading = true;
    private PlatformStats _stats = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            // 통계 집계 API 결합 가도. 현 시점 박제만.
            await Task.Yield();
            _stats = new PlatformStats
            {
                TotalSerials = 0,
                ActiveSerials = 0,
                PaidActive = 0,
                Overdue = 0,
                OpenTickets = 0,
                P0Tickets = 0,
                HealthyTunnels = 0,
                UnhealthyTunnels = 0,
                PlanDistribution = new List<PlanCount>(),
                PaymentStatusDistribution = new List<StatusCount>()
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"통계 조회 실패: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private Color StatusBarColor(string s) => s switch
    {
        "active" => Color.Success,
        "overdue" => Color.Warning,
        "suspended" => Color.Error,
        _ => Color.Default
    };

    public class PlatformStats
    {
        public int TotalSerials { get; set; }
        public int ActiveSerials { get; set; }
        public int PaidActive { get; set; }
        public int Overdue { get; set; }
        public int OpenTickets { get; set; }
        public int P0Tickets { get; set; }
        public int HealthyTunnels { get; set; }
        public int UnhealthyTunnels { get; set; }
        public List<PlanCount> PlanDistribution { get; set; } = new();
        public List<StatusCount> PaymentStatusDistribution { get; set; } = new();
    }

    public class PlanCount
    {
        public string Plan { get; set; } = "";
        public int Count { get; set; }
        public double Percent { get; set; }
    }

    public class StatusCount
    {
        public string Status { get; set; } = "";
        public int Count { get; set; }
        public double Percent { get; set; }
    }
}
