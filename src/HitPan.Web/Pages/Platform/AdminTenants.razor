@page "/admin/tenants"
@layout PlatformLayout
@attribute [Authorize]
@inject BackofficeService Bo
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@using HitPan.Web.Models.Backoffice
@using HitPan.Web.Services

<PageTitle>고객사 관리 — 히트판 백오피스</PageTitle>

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
    <div>
        <MudText Typo="Typo.h5" Style="font-weight:600;">고객사 관리</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">전체 고객사 목록 및 구독 현황</MudText>
    </div>
</div>

<MudPaper Class="pa-3 mb-4" Elevation="1" Style="border-radius:12px;">
    <MudGrid Spacing="2" AlignItems="AlignItems.Center">
        <MudItem xs="12" sm="4">
            <MudTextField @bind-Value="_search" Label="검색" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Placeholder="회사명, 사업자번호" Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          OnKeyUp="@OnSearchKey" />
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudSelect @bind-Value="_statusFilter" Label="상태" Variant="Variant.Outlined" Margin="Margin.Dense"
                       Clearable="true" T="string">
                <MudSelectItem Value="@("active")">활성</MudSelectItem>
                <MudSelectItem Value="@("trial")">체험</MudSelectItem>
                <MudSelectItem Value="@("suspended")">중지</MudSelectItem>
                <MudSelectItem Value="@("expired")">만료</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudSelect @bind-Value="_planFilter" Label="플랜" Variant="Variant.Outlined" Margin="Margin.Dense"
                       Clearable="true" T="string">
                <MudSelectItem Value="@("basic")">Basic</MudSelectItem>
                <MudSelectItem Value="@("pro")">Pro</MudSelectItem>
                <MudSelectItem Value="@("enterprise")">Enterprise</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       OnClick="LoadAsync" StartIcon="@Icons.Material.Filled.Refresh">
                조회
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" />
}

<MudPaper Elevation="1" Style="border-radius:12px;overflow:hidden;">
    <MudDataGrid T="AdminTenantListItem" Items="_items" Loading="_loading"
                 Hover="true" Dense="true" Striped="false"
                 SortMode="SortMode.Single"
                 RowClick="OnRowClick">
        <Columns>
            <PropertyColumn Property="x => x.CompanyName" Title="회사명" />
            <PropertyColumn Property="x => x.BizNo" Title="사업자번호" />
            <TemplateColumn Title="상태">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Color="@context.Item.StatusColor" Variant="Variant.Filled">
                        @context.Item.StatusKo
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.PlanType" Title="플랜" />
            <PropertyColumn Property="x => x.ResellerName" Title="대리점" />
            <PropertyColumn Property="x => x.UserCount" Title="사용자" />
            <TemplateColumn Title="다음 청구일">
                <CellTemplate>
                    @(context.Item.NextBillingAt.HasValue ? context.Item.NextBillingAt.Value.ToString("yyyy-MM-dd") : "-")
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="가입일">
                <CellTemplate>
                    @context.Item.CreatedAt.ToString("yyyy-MM-dd")
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4">조회된 고객사가 없습니다.</MudText>
        </NoRecordsContent>
    </MudDataGrid>
</MudPaper>

@if (_total > _pageSize)
{
    <div style="display:flex;justify-content:center;margin-top:16px;">
        <MudPagination Count="@((_total + _pageSize - 1) / _pageSize)"
                       Selected="@_page" SelectedChanged="OnPageChanged"
                       Color="Color.Primary" Rectangular="false" />
    </div>
}

@if (_detail is not null)
{
    <MudDrawer @bind-Open="_drawerOpen" Anchor="Anchor.End" Width="420px" Elevation="4">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6" Style="font-weight:600;">@_detail.CompanyName</MudText>
        </MudDrawerHeader>
        <div class="pa-4">
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-3">기본 정보</MudText>
            <MudGrid Spacing="1" Class="mb-4">
                <MudItem xs="5"><MudText Typo="Typo.caption" Color="Color.Secondary">사업자번호</MudText></MudItem>
                <MudItem xs="7"><MudText Typo="Typo.body2">@_detail.BizNo</MudText></MudItem>
                <MudItem xs="5"><MudText Typo="Typo.caption" Color="Color.Secondary">대표자</MudText></MudItem>
                <MudItem xs="7"><MudText Typo="Typo.body2">@_detail.CeoName</MudText></MudItem>
                <MudItem xs="5"><MudText Typo="Typo.caption" Color="Color.Secondary">연락처</MudText></MudItem>
                <MudItem xs="7"><MudText Typo="Typo.body2">@(_detail.Tel ?? "-")</MudText></MudItem>
                <MudItem xs="5"><MudText Typo="Typo.caption" Color="Color.Secondary">주소</MudText></MudItem>
                <MudItem xs="7"><MudText Typo="Typo.body2">@(_detail.Address ?? "-")</MudText></MudItem>
                <MudItem xs="5"><MudText Typo="Typo.caption" Color="Color.Secondary">상태</MudText></MudItem>
                <MudItem xs="7">
                    <MudChip T="string" Size="Size.Small" Color="@_detail.StatusColor" Variant="Variant.Filled">@_detail.StatusKo</MudChip>
                </MudItem>
            </MudGrid>

            @if (_detail.Subscription is not null)
            {
                <MudDivider Class="mb-3" />
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-3">구독 정보</MudText>
                <MudGrid Spacing="1" Class="mb-4">
                    <MudItem xs="5"><MudText Typo="Typo.caption" Color="Color.Secondary">플랜</MudText></MudItem>
                    <MudItem xs="7"><MudText Typo="Typo.body2">@_detail.Subscription.PlanType</MudText></MudItem>
                    <MudItem xs="5"><MudText Typo="Typo.caption" Color="Color.Secondary">기본 사용자</MudText></MudItem>
                    <MudItem xs="7"><MudText Typo="Typo.body2">@(_detail.Subscription.BaseUsers)명</MudText></MudItem>
                    <MudItem xs="5"><MudText Typo="Typo.caption" Color="Color.Secondary">추가 사용자</MudText></MudItem>
                    <MudItem xs="7"><MudText Typo="Typo.body2">@(_detail.Subscription.ExtraUsers)명</MudText></MudItem>
                    <MudItem xs="5"><MudText Typo="Typo.caption" Color="Color.Secondary">월 청구액</MudText></MudItem>
                    <MudItem xs="7"><MudText Typo="Typo.body2" Style="font-weight:600;">@_detail.Subscription.TotalFee.ToString("N0")원</MudText></MudItem>
                </MudGrid>
            }

            <MudDivider Class="mb-3" />
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-3">상태 변경</MudText>
            <div style="display:flex;gap:8px;flex-wrap:wrap;">
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success"
                           OnClick="@(() => ChangeStatusAsync("active"))">활성화</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                           OnClick="@(() => ChangeStatusAsync("suspended"))">중지</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                           OnClick="@(() => ChangeStatusAsync("expired"))">만료</MudButton>
            </div>

            @if (_detail.Invoices.Count > 0)
            {
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-2">최근 청구 내역</MudText>
                @foreach (var inv in _detail.Invoices.Take(5))
                {
                    <div style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-bottom:1px solid #f1f5f9;">
                        <div>
                            <MudText Typo="Typo.body2">@inv.BillingMonth</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@inv.TotalAmount.ToString("N0")원</MudText>
                        </div>
                        <MudChip T="string" Size="Size.Small" Color="@inv.StatusColor" Variant="Variant.Outlined">@inv.StatusKo</MudChip>
                    </div>
                }
            }
        </div>
    </MudDrawer>
}

@code {
    private List<AdminTenantListItem> _items = new();
    private AdminTenantDetail? _detail;
    private bool _loading;
    private bool _drawerOpen;
    private string? _search;
    private string? _statusFilter;
    private string? _planFilter;
    private int _page = 1;
    private int _pageSize = 20;
    private int _total;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var result = await Bo.GetAdminTenantsAsync(_statusFilter, null, _search, _page, _pageSize);
            _items = result?.Items ?? new();
            _total = result?.TotalCount ?? 0;
        }
        catch
        {
            Snackbar.Add("고객사 목록 로드 실패", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnRowClick(DataGridRowClickEventArgs<AdminTenantListItem> args)
    {
        try
        {
            _detail = await Bo.GetAdminTenantDetailAsync(args.Item.TenantId);
            _drawerOpen = true;
        }
        catch
        {
            Snackbar.Add("상세 정보 로드 실패", Severity.Error);
        }
    }

    private async Task ChangeStatusAsync(string status)
    {
        if (_detail is null) return;
        try
        {
            await Bo.UpdateTenantStatusAsync(_detail.TenantId, status, null);
            Snackbar.Add("상태가 변경되었습니다", Severity.Success);
            _detail.Status = status;
            await LoadAsync();
        }
        catch
        {
            Snackbar.Add("상태 변경 실패", Severity.Error);
        }
    }

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadAsync();
    }

    private async Task OnPageChanged(int page)
    {
        _page = page;
        await LoadAsync();
    }
}
