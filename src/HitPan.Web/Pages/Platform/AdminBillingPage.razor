@*
    WS-20260601-18 본사 백오피스 — 결제·환불 처리 (8명제 #7)
    작성일: 2026-06-01
    절대 원칙:
      - PlatformManagerOrAbove (owner/manager만 환불 처리)
      - 평문 사업자정보 0 — 결제ID·시리얼만
      - 환불은 4-eyes 결재 트리거
      - Razor에 C# raw string 금지 (헌법 #14)
      - 빈 catch 금지 (헌법 #15)
*@

@page "/admin/billing"
@layout PlatformLayout
@attribute [Authorize(Policy = "PlatformManagerOrAbove")]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService Dialog

<PageTitle>결제·환불 — 히트판 백오피스</PageTitle>

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
    <div>
        <MudText Typo="Typo.h5" Style="font-weight:600;">결제·환불 처리</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            PG 거래 추적 + 환불은 4-eyes 결재 (8명제 #2)
        </MudText>
    </div>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh"
               OnClick="LoadAsync">새로고침</MudButton>
</div>

<MudAlert Severity="Severity.Info" Class="mb-3" Dense="true">
    🔒 사업자번호·상호·대표자는 백오피스에서 절대 노출되지 않습니다. 결제ID·시리얼만 추적됩니다.
</MudAlert>

<MudPaper Class="pa-3 mb-3" Elevation="0" Style="border-radius:12px;background:#f7f8fa;">
    <MudGrid Spacing="2">
        <MudItem xs="12" md="4">
            <MudTextField @bind-Value="_keyword" Label="검색 (결제ID·시리얼)" Variant="Variant.Outlined"
                          Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="6" md="3">
            <MudSelect T="string" @bind-Value="_status" Label="상태" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="@("all")">전체</MudSelectItem>
                <MudSelectItem Value="@("paid")">결제완료</MudSelectItem>
                <MudSelectItem Value="@("refund_pending")">환불대기</MudSelectItem>
                <MudSelectItem Value="@("refunded")">환불완료</MudSelectItem>
                <MudSelectItem Value="@("failed")">실패</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudSelect T="string" @bind-Value="_pg" Label="PG" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="@("all")">전체</MudSelectItem>
                <MudSelectItem Value="@("toss")">토스페이먼츠</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="2">
            <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Search" OnClick="LoadAsync">조회</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Elevation="1" Style="border-radius:12px;overflow:hidden;">
    <MudDataGrid T="BillingRow" Items="_rows" Loading="_loading"
                 Hover="true" Dense="true" SortMode="SortMode.Single">
        <Columns>
            <PropertyColumn Property="x => x.PaymentId" Title="결제ID" />
            <PropertyColumn Property="x => x.SerialMasked" Title="시리얼 (마스킹)" />
            <PropertyColumn Property="x => x.Pg" Title="PG" />
            <PropertyColumn Property="x => x.PlanType" Title="플랜" />
            <PropertyColumn Property="x => x.Amount" Title="금액" Format="N0" />
            <TemplateColumn Title="상태">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Item.Status)">
                        @context.Item.Status
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.PaidAt" Title="결제일시" Format="yyyy-MM-dd HH:mm" />
            <TemplateColumn Title="환불">
                <CellTemplate>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                               Disabled="@(context.Item.Status != "paid")"
                               OnClick="@(() => OpenRefundAsync(context.Item))">
                        환불 신청
                    </MudButton>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="BillingRow" />
        </PagerContent>
        <NoRecordsContent>
            <MudText Align="Align.Center" Class="pa-6" Color="Color.Secondary">
                결제 내역이 없습니다.
            </MudText>
        </NoRecordsContent>
    </MudDataGrid>
</MudPaper>

@code {
    private List<BillingRow> _rows = new();
    private bool _loading = true;
    private string _keyword = "";
    private string _status = "all";
    private string _pg = "all";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            // PG 거래 API 결합 가도. 현 시점 박제만.
            await Task.Yield();
            _rows = new List<BillingRow>();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"결제 내역 조회 실패: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenRefundAsync(BillingRow row)
    {
        var msg = $"결제ID {row.PaymentId} ({row.Amount:N0}원) 환불을 신청합니다. 4-eyes 결재로 진행됩니다.";
        var ok = await ConfirmDialog.ShowAsync(Dialog, "환불 신청", msg,
            confirmText: "환불 신청", cancelText: "취소", severity: Severity.Error);
        if (ok)
        {
            Snackbar.Add("환불 신청 — 4-eyes 결재 대기열로 이동", Severity.Success);
            await LoadAsync();
        }
    }

    private Color StatusColor(string s) => s switch
    {
        "paid" => Color.Success,
        "refund_pending" => Color.Warning,
        "refunded" => Color.Info,
        "failed" => Color.Error,
        _ => Color.Default
    };

    public class BillingRow
    {
        public string PaymentId { get; set; } = "";
        public string SerialMasked { get; set; } = "";
        public string Pg { get; set; } = "toss";
        public string PlanType { get; set; } = "basic";
        public decimal Amount { get; set; }
        public string Status { get; set; } = "paid";
        public DateTime PaidAt { get; set; }
    }
}
