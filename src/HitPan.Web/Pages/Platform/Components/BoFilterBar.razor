@*
    BoFilterBar — 백오피스 v2 공통 필터 바 (수석 웹디자이너 박제 2026-06-01)

    원칙:
      - 16px padding + 12px gap + 라운드 12px + 그림자 1단
      - margin-bottom 16px
      - flex-wrap 으로 모바일 자동 줄바꿈
      - design-tokens.css 변수만 사용
*@

<div class="bo-filter-bar">
    @ChildContent
</div>

@code {
    /// <summary>필터 컨트롤 슬롯 (MudTextField·MudSelect·MudButton 등).</summary>
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;
}
