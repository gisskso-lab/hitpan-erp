@page "/sales-returns"
@attribute [Authorize]
@using HitPan.Web.Components.Purchase
@using HitPan.Web.Components.Sales
@using HitPan.Web.Models
@using HitPan.Web.Services
@namespace HitPan.Web.Pages.SalesReturnUi
@inject WorkTabService TabService
@inject DocumentService DocService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime Js
@inject HttpClient Http
@inject PartnerMasterService PartnersApi
@inject ItemMasterService ItemsApi
@inject DeliveryService DeliveryService
@inject NavigationManager Nav

<PageTitle>반품 처리</PageTitle>

<NavigationLock ConfirmExternalNavigation="@_hasUnsavedChanges" OnBeforeInternalNavigation="OnBeforeInternalNavigationAsync" />

<section class="return-page">
    @if (_draft is null)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
        <WorkflowBreadcrumb Steps="_workflowSteps" />

        <MudPaper Class="pa-3 mb-2">
            <MudGrid>
                <MudItem xs="12" md="3">
                    <MudDatePicker Label="반품일자" Date="_draft.SalesDate" DateChanged="OnReturnDateChangedAsync" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudAutocomplete T="string" Label="거래처" Value="_draft.SalesCompany"
                        ValueChanged="OnPartnerChangedAsync" SearchFunc="SearchPartnerAsync"
                        Margin="Margin.Dense" Placeholder="거래처 검색" />
                </MudItem>
                <MudItem xs="12" md="3">
                    @* 20260825작6: 이 화면은 매출반품(반품확인서) 전용이다 — 콤보가 없다.
                       사장님 정의: "매출에 있는 반품 = 사용자의 고객사가 반품처리한 품목관리".
                       매입반품과 방향이 반대(재고+·미수-)라 고를 수 있으면 잘못 고른다. *@
                    <MudTextField T="string" Label="문서유형" Variant="Variant.Text" Margin="Margin.Dense"
                                  Value="@_documentTypeLabel" ReadOnly="true" Disabled="true" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField T="string" Label="메모" Value="_draft.Memo"
                                  ValueChanged="OnMemoChangedAsync" Margin="Margin.Dense" />
                </MudItem>
            </MudGrid>

            @* 20260825작7 — 어느 거래에서 온 반품인지 눈에 보이게 한다.
               연결이 저장됐는지를 사용자가 화면에서 바로 확인할 수 있어야
               "자동반영이 됐나" 를 묻지 않는다. *@
            @if (!string.IsNullOrWhiteSpace(_linkedDeliveryNo))
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                    거래명세서 <b>@_linkedDeliveryNo</b> 에서 불러온 반품입니다.
                    반품 수량과 파손 여부를 확인한 뒤 저장해주세요.
                </MudAlert>
            }
            else if (!string.IsNullOrWhiteSpace(_linkedDeliveryId))
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                    원 거래명세서에 연결된 반품입니다.
                </MudAlert>
            }
        </MudPaper>

        <MudToolBar Dense="true" Style="overflow-x:auto;flex-wrap:nowrap" Class="pa-1 gap-1">
            @* 20260825작7 — 사장님 오더: "판매목록 불러오는 버튼이 있어야 됨".
               고객이 반품해 오면 원 거래를 찾아 품목을 그대로 가져온다.
               확정된 거래만 대상이다(헌법 #6) — 판 적 없는 걸 반품할 수는 없다. *@
            <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.Download"
                       OnClick="LoadFromDeliveryAsync"
                       Disabled="@(_status != "Draft" || _isLoadingDelivery)">판매불러오기</MudButton>
            <MudDivider Vertical="true" FlexItem="true" />
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="AddNewAsync">추가</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync">저장</MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Undo" OnClick="CancelAsync">취소</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteConfirmAsync">삭제</MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="CopyAsync" Disabled="@_isNew">복사</MudButton>
            @* 20260825작9 — 사장님 실측 반려 4번: "반품확정 버튼 없음".
               🔴 이 화면은 작6 에서 매출반품(반품확인서) 전용으로 갈라져 나왔는데
                  버튼의 권한 목록만 매입 쪽(purchase_manager)에 남아 있었다.
               서버는 POST sales/returns/{id}/confirm 에 Policy="SalesManager"
                 = system_admin · sales_manager · tenant_admin 을 요구한다.
               ⇒ sales_manager 는 서버가 허용하는데 버튼이 안 보였고(이번 증상),
                  purchase_manager 는 버튼이 보이는데 눌러도 서버가 403 이었다.
               화면 권한을 서버 정책에 맞춘다 — 화면이 서버보다 관대해도, 인색해도 안 된다. *@
            @if (_status == "Draft" && !_isNew && !string.IsNullOrWhiteSpace(_draft.Id))
            {
                <AuthorizeView Roles="system_admin,tenant_admin,sales_manager">
                    <Authorized>
                        <MudButton Variant="Variant.Filled" Color="Color.Success"
                                   StartIcon="@Icons.Material.Filled.CheckCircle"
                                   OnClick="ConfirmReturnAsync">반품확정</MudButton>
                    </Authorized>
                </AuthorizeView>
            }
            @* 확정된 반품 되돌리기 — 15차 적대검증 15-P1 봉합. 잘못 확정 시 원장 무결성 유지하며 복원. *@
            @* 20260825작9: 취소도 같은 서버 정책(SalesManager)이다 — 확정만 고치고 취소를 두면
               확정한 사람이 되돌리지 못하는 반쪽이 된다(작7 의 "생성은 넣고 수정은 안 넣던 비대칭"). *@
            @if (_status == "Confirmed" && !string.IsNullOrWhiteSpace(_draft.Id))
            {
                <AuthorizeView Roles="system_admin,tenant_admin,sales_manager">
                    <Authorized>
                        <MudButton Variant="Variant.Outlined" Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.Undo"
                                   OnClick="CancelReturnAsync">반품취소</MudButton>
                    </Authorized>
                </AuthorizeView>
            }
            <MudDivider Vertical="true" FlexItem="true" />
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Print" OnClick="PrintAsync">인쇄</MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.TableChart" OnClick="DownloadExcelAsync">엑셀</MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="DownloadPdfAsync">PDF</MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Email" OnClick="EmailAsync">이메일</MudButton>
            <MudSpacer />
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FormatListBulleted" OnClick="OpenListAsync">목록</MudButton>
        </MudToolBar>

        <div class="return-grid-wrap">
            @* 작지 #3 반품 전용 그리드 (사장님 작업지시 2026-05-31) — PurchaseOrderGrid 재사용 한계 봉합 *@
            @* 20260825작6: 매출 전용 그리드 — 로스 체크 + 사유 자율입력. 매입 그리드는 안 건드린다. *@
            <SalesReturnGrid Lines="_draft.Lines" PartnerId="@_draft.PartnerId"
                                Density="_draft.Density"
                                Summary="_summary"
                                Status="_status"
                                ItemCache="_itemCache"
                                OnChanged="OnGridChangedAsync"
                                SelectedLineChanged="OnSelectedLineChangedAsync"
                                @bind-ReturnReason="_returnReason"
                                @bind-ReturnReasonMemo="_returnReasonMemo" />
        </div>

        <MudPaper Class="pa-3 mt-2">
            <MudStack Row="true" Spacing="3">
                <MudText Typo="Typo.body2">공급가액: @_summary.SupplyAmount.ToString("N0")</MudText>
                <MudText Typo="Typo.body2">부가세: @_summary.VatAmount.ToString("N0")</MudText>
                <MudText Typo="Typo.body2">합계: @_summary.TotalAmount.ToString("N0")</MudText>
            </MudStack>
        </MudPaper>
    }
</section>

