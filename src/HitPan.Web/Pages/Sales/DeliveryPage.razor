        {
            // 서버 응답 본문을 그대로 보여준다 — 잔량·권한 안내가 여기 담겨 온다.
            Snackbar.Add($"반품 확정 실패: {error ?? "알 수 없는 오류"}", Severity.Error);
            return;
        }

        _draft.Status = "confirmed";
        Snackbar.Add($"반품 확정 완료: {_draft.DocumentNumber} — 재고가 입고되었습니다.", Severity.Success);
