    private async Task CancelConfirmedAsync()
    {
        if (_draft is null || string.IsNullOrWhiteSpace(_draft.Id)) return;
        if (_draft.Status != "confirmed")
        {
            Snackbar.Add("확정된 전표만 매출취소할 수 있습니다.", Severity.Warning);
            return;
        }

        // 구체적 영향 범위 요약 — UX/UI 개발팀 제안
        var itemCount = _draft.Lines.Count(l => !l.IsPlaceholder);
        var totalQty = _draft.Lines.Where(l => !l.IsPlaceholder).Sum(l => l.Quantity);
        var totalAmount = _summary.TotalAmount;

        var confirm = await DialogService.ShowMessageBoxAsync(
            "⚠ 확정 매출 취소 (Reverse 원장 발행)",
            $"거래처: {_draft.SalesCompany}\n" +
            $"문서번호: {_draft.DocumentNumber}\n" +
            $"품목 수: {itemCount}개 · 총 수량: {totalQty:N1}\n" +
            $"취소 금액: {totalAmount:N0}원\n\n" +
            $"→ 재고 {totalQty:N1}개 복귀\n" +
            $"→ 수금 {totalAmount:N0}원 자동 무효화\n" +
            $"→ 거래처 잔액 재계산\n\n" +
            $"이 작업은 되돌릴 수 없습니다. 진행하시겠습니까?",
            yesText: "매출취소 진행", cancelText: "닫기");
        if (confirm != true) return;

        var (ok, err) = await DeliveryService.CancelConfirmedAsync(_draft.Id);
        if (ok)
        {
            Snackbar.Add("매출 취소 완료 — Reverse 원장이 발행되었습니다.", Severity.Success);
            // 서버 재조회 — stale 제거 (프론트 매니저 지적)
            await LoadOrderToGrid(_draft.Id!);
        }
        else
        {
            Snackbar.Add($"매출취소 실패: {err}", Severity.Error);
        }
    }

