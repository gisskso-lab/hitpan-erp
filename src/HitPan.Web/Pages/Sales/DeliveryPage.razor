@page "/deliveries"
@using System.Security.Claims
@using HitPan.Web.Components.Sales
@using HitPan.Web.Models
@using HitPan.Web.Services
@namespace HitPan.Web.Pages.Delivery
@inject DeliveryService DeliveryService
@inject DocumentService DocService
@inject WorkTabService TabService
@inject AuthenticationStateProvider AuthStateProvider
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject PartnerMasterService PartnersApi
@inject ItemMasterService ItemsApi

<NavigationLock ConfirmExternalNavigation="@_hasUnsavedChanges" OnBeforeInternalNavigation="OnBeforeInternalNavigation" />

<section class="delivery-page">
    @if (_draft is null)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
        <WorkflowBreadcrumb Steps="_workflowSteps" />

        <DeliveryForm Draft="_draft" OnChanged="OnHeaderChanged" OnOpenPartnerList="OpenPartnerList" />

        @if (_selectedCount > 0)
        {
            <div class="delivery-selection-bar">
                <span><strong>@_selectedCount</strong>개 선택됨</span>
                <MudIconButton Icon="@Icons.Material.Filled.Close"
                               aria-label="선택 해제"
                               Size="Size.Small"
                               OnClick="ClearSelection" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="BulkConfirmAsync">일괄확정</MudButton>
                @if (_canBulkDelete)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="BulkDeleteAsync">일괄삭제</MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small" Disabled="true" aria-label="Manager 이상만 가능">
                        일괄삭제
                    </MudButton>
                }
                <MudMenu Label="일괄변경" Variant="Variant.Outlined" Dense="true" AnchorOrigin="Origin.BottomLeft">
                    <MudMenuItem OnClick="BulkChangeUnitPriceAsync">단가 일괄변경</MudMenuItem>
                    <MudMenuItem OnClick="BulkChangeAssigneeAsync">담당자 일괄변경</MudMenuItem>
                    <MudMenuItem OnClick="BulkChangeWarehouseAsync">창고 일괄변경</MudMenuItem>
                </MudMenu>
            </div>
        }
        else
        {
            <MudToolBar Dense="true" Class="pa-1 gap-1 delivery-toolbar">
                <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" OnClick="GoPrev" aria-label="이전" />
                <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" OnClick="GoNext" aria-label="다음" />
                <MudDivider Vertical="true" FlexItem="true" />

                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="AddNew">추가</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="Save">저장</MudButton>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Undo" OnClick="Cancel">취소</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteConfirm">삭제</MudButton>
                <MudDivider Vertical="true" FlexItem="true" />

                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Print" OnClick="Print">인쇄</MudButton>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.TableChart" OnClick="DownloadExcel">엑셀</MudButton>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="DownloadPdf">PDF</MudButton>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Receipt" OnClick="OpenTaxInvoice">세금</MudButton>
                <MudSpacer />
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FormatListBulleted" OnClick="OpenListPopup">목록</MudButton>
            </MudToolBar>
        }

        <div class="delivery-grid-wrap">
            <DeliveryGrid Lines="_draft.Lines"
                          Density="_draft.Density"
                          SelectedLine="_selectedLine"
                          SelectedLineChanged="OnSelectedLineChanged"
                          OnChanged="OnLinesChanged"
                          OnSelectionChanged="OnSelectionChanged"
                          OnContextSecondary="OnContextSecondaryAsync"
                          ItemCache="_itemCache"
                          Summary="_summary" />
        </div>

        <DeliveryFooter Summary="_summary" />
    }
</section>

@code {
    private DeliveryDraftModel? _draft;
    private DeliverySummaryModel _summary = new();
    private DeliveryLineModel? _selectedLine;
    private bool _hasUnsavedChanges;
    private IReadOnlyList<DeliveryWorkflowStepModel> _workflowSteps = Array.Empty<DeliveryWorkflowStepModel>();
    private int _selectedCount;
    private bool _canBulkDelete;
    private ClaimsPrincipal? _user;
    private List<PartnerListRow>? _partnerCache;
    private List<ItemListModel>? _itemCache;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        _user = state.User;
        _canBulkDelete = HitPanRoleHelper.IsInHitPanRole(_user, "TenantAdmin")
                         || HitPanRoleHelper.IsInHitPanRole(_user, "Manager");

        var manager = _user.FindFirst("name")?.Value
                      ?? _user.FindFirst(ClaimTypes.Name)?.Value
                      ?? "담당자";
        _draft = await DeliveryService.CreateDraftAsync(manager);
        _draft.LinkedQuoteDocumentNo = $"QT-{_draft.SalesDate:yyyyMMdd}-001";
        _draft.LinkedSalesOrderDocumentNo = $"SO-{_draft.SalesDate:yyyyMMdd}-001";
        _itemCache = await ItemsApi.GetListAsync() ?? new();
        RefreshWorkflow();
        RecalculateSummary();
    }

    private async Task<IEnumerable<string>> SearchPartnerAsync(string value, CancellationToken ct)
    {
        _partnerCache ??= await PartnersApi.GetListAsync() ?? new();
        if (string.IsNullOrWhiteSpace(value)) return _partnerCache.Select(p => p.PartnerName).Distinct();
        return _partnerCache.Where(p => p.PartnerName.Contains(value, StringComparison.OrdinalIgnoreCase)).Select(p => p.PartnerName).Distinct();
    }

    private void RefreshWorkflow()
    {
        if (_draft is null) return;
        _workflowSteps = DeliveryWorkflowFactory.Build(_draft.DocumentType, _draft);
    }

    private async Task OnHeaderChanged()
    {
        RefreshWorkflow();
        MarkDirty();
        if (TabService.ActiveTabId is { } tabId)
        {
            TabService.UpdateSubTitle(tabId, _draft?.SalesCompany);
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnBeforeInternalNavigation(LocationChangingContext context)
    {
        if (!_hasUnsavedChanges) return;
        var leave = await DialogService.ShowMessageBoxAsync(
            "확인",
            "저장하지 않은 내용이 있습니다. 이동하시겠습니까?",
            yesText: "이동",
            noText: "취소");
        if (leave != true)
        {
            context.PreventNavigation();
        }
    }

    private async Task OnLinesChanged()
    {
        MarkDirty();
        RecalculateSummary();
        await InvokeAsync(StateHasChanged);
    }

    private Task OnSelectedLineChanged(DeliveryLineModel? line)
    {
        _selectedLine = line;
        return Task.CompletedTask;
    }

    private Task OnSelectionChanged()
    {
        UpdateSelectionCount();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void UpdateSelectionCount()
    {
        if (_draft is null)
        {
            _selectedCount = 0;
            return;
        }

        _selectedCount = _draft.Lines.Count(x => !x.IsPlaceholder && x.IsSelected);
    }

    private void ClearSelection()
    {
        if (_draft is null) return;
        foreach (var line in _draft.Lines)
        {
            line.IsSelected = false;
        }

        UpdateSelectionCount();
        StateHasChanged();
    }

    private async Task OnContextSecondaryAsync((DeliveryLineModel Line, DeliveryContextAction Action) arg)
    {
        switch (arg.Action)
        {
            case DeliveryContextAction.LinkSalesOrder:
                Snackbar.Add("수주 연결은 추후 API와 연동됩니다.", Severity.Info);
                break;
            case DeliveryContextAction.IssueTaxInvoice:
                Snackbar.Add("세금계산서 발행은 추후 연동됩니다.", Severity.Info);
                break;
            case DeliveryContextAction.PartnerHistory:
                Snackbar.Add("거래처 거래내역 조회는 추후 연동됩니다.", Severity.Info);
                break;
        }

        await Task.CompletedTask;
    }

    private void AddLine()
    {
        if (_draft is null) return;
        _draft.Lines.Add(new DeliveryLineModel { No = _draft.Lines.Count + 1 });
        MarkDirty();
        RecalculateSummary();
    }

    private void DeleteLine()
    {
        if (_draft is null || _selectedLine is null) return;
        _draft.Lines.Remove(_selectedLine);
        for (var i = 0; i < _draft.Lines.Count; i++)
        {
            _draft.Lines[i].No = i + 1;
        }

        if (_draft.Lines.Count == 0)
        {
            _draft.Lines.Add(new DeliveryLineModel { No = 1, IsPlaceholder = true });
        }

        _selectedLine = null;
        MarkDirty();
        RecalculateSummary();
    }

    private async Task SaveAsync()
    {
        if (_draft is null) return;
        try
        {
            var docNo = await DeliveryService.SaveAsync(_draft);
            if (TabService.ActiveTabId is { } tabId)
            {
                TabService.UpdateSubTitle(tabId, _draft.SalesCompany);
            }

            _hasUnsavedChanges = false;
            if (TabService.ActiveTabId is { } currentTabId)
            {
                TabService.SetTabDirty(currentTabId, false);
            }

            RefreshWorkflow();
            Snackbar.Add($"저장 완료: {docNo}", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ConfirmAsync()
    {
        if (_draft is null) return;
        if (string.IsNullOrWhiteSpace(_draft.DocumentNumber))
        {
            await SaveAsync();
        }

        try
        {
            await DeliveryService.ConfirmAsync(_draft);
            Snackbar.Add("전송(확정)을 완료했습니다.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }

    private async Task BulkConfirmAsync()
    {
        if (_draft is null || string.IsNullOrWhiteSpace(_draft.Id))
        {
            Snackbar.Add("저장 후 일괄확정을 사용할 수 있습니다.", Severity.Warning);
            return;
        }

        var result = await DeliveryService.BulkConfirmAsync(new[] { _draft.Id });
        if (result.Failed.Count > 0)
        {
            Snackbar.Add($"일부 실패: {result.Failed.Count}건", Severity.Warning);
        }
        else
        {
            Snackbar.Add("일괄확정이 완료되었습니다.", Severity.Success);
        }

        ClearSelection();
    }

    private async Task BulkDeleteAsync()
    {
        if (!_canBulkDelete || _draft is null || _selectedCount == 0) return;
        var ok = await DialogService.ShowMessageBoxAsync(
            "일괄삭제",
            "선택한 행을 삭제하시겠습니까?",
            yesText: "삭제",
            cancelText: "취소");
        if (ok != true) return;

        _draft.Lines.RemoveAll(l => l.IsSelected && !l.IsPlaceholder);
        for (var i = 0; i < _draft.Lines.Count; i++)
        {
            _draft.Lines[i].No = i + 1;
        }

        if (_draft.Lines.Count == 0)
        {
            _draft.Lines.Add(new DeliveryLineModel { No = 1, IsPlaceholder = true });
        }

        ClearSelection();
        MarkDirty();
        RecalculateSummary();
    }

    private async Task BulkChangeUnitPriceAsync()
    {
        if (_draft is null || _selectedCount == 0) return;
        var parameters = new DialogParameters<DeliveryBulkEditDialog>
        {
            { x => x.Kind, DeliveryBulkEditDialog.BulkEditKind.UnitPrice }
        };
        var dialog = await DialogService.ShowAsync<DeliveryBulkEditDialog>("단가 일괄변경", parameters);
        var res = await dialog.Result;
        if (res is null || res.Canceled || res.Data is not decimal price) return;

        foreach (var line in _draft.Lines.Where(l => !l.IsPlaceholder && l.IsSelected))
        {
            line.UnitPrice = price;
            line.RecalculateAmount();
        }

        MarkDirty();
        RecalculateSummary();
    }

    private async Task BulkChangeAssigneeAsync()
    {
        if (_draft is null || _selectedCount == 0) return;
        var parameters = new DialogParameters<DeliveryBulkEditDialog>
        {
            { x => x.Kind, DeliveryBulkEditDialog.BulkEditKind.Assignee }
        };
        var dialog = await DialogService.ShowAsync<DeliveryBulkEditDialog>("담당자 일괄변경", parameters);
        var res = await dialog.Result;
        if (res is null || res.Canceled || res.Data is not string name) return;

        foreach (var line in _draft.Lines.Where(l => !l.IsPlaceholder && l.IsSelected))
        {
            line.LineAssignee = name;
        }

        MarkDirty();
    }

    private async Task BulkChangeWarehouseAsync()
    {
        if (_draft is null || _selectedCount == 0) return;
        var parameters = new DialogParameters<DeliveryBulkEditDialog>
        {
            { x => x.Kind, DeliveryBulkEditDialog.BulkEditKind.Warehouse }
        };
        var dialog = await DialogService.ShowAsync<DeliveryBulkEditDialog>("창고 일괄변경", parameters);
        var res = await dialog.Result;
        if (res is null || res.Canceled || res.Data is not string wh) return;

        foreach (var line in _draft.Lines.Where(l => !l.IsPlaceholder && l.IsSelected))
        {
            line.Warehouse = wh;
        }

        MarkDirty();
    }

    private void RecalculateSummary()
    {
        if (_draft is null) return;
        var lines = _draft.Lines.Where(x => !x.IsPlaceholder).ToList();
        var supply = lines.Sum(x => x.Amount);
        var vat = lines.Sum(x => x.VatAmount);
        _summary.SupplyAmount = supply;
        _summary.VatAmount = vat;
        _summary.TotalAmount = supply + vat;
        _summary.TodaySales = _summary.TotalAmount;
        _summary.TodayReceipt = _summary.CashAmount + _summary.CardAmount;
        _summary.ClaimAmount = _summary.TotalAmount;
        _summary.PrevReceivable = 0;
        _summary.CashAmount = decimal.Round(_summary.TotalAmount * 0.5m, 2, MidpointRounding.AwayFromZero);
        _summary.CardAmount = decimal.Round(_summary.TotalAmount - _summary.CashAmount, 2, MidpointRounding.AwayFromZero);
    }

    private void MarkDirty()
    {
        _hasUnsavedChanges = true;
        if (TabService.ActiveTabId is { } tabId)
        {
            TabService.SetTabDirty(tabId, true);
        }
    }

    private async Task DeleteConfirm()
    {
        var result = await DialogService.ShowMessageBoxAsync(
            "삭제 확인",
            "선택한 거래명세서를 삭제하시겠습니까?",
            yesText: "삭제",
            cancelText: "취소");
        if (result == true)
        {
            await DeleteOrder();
        }
    }

    private async Task DeleteOrder()
    {
        if (_draft is null) return;

        var persisted = !string.IsNullOrWhiteSpace(_draft.DocumentNumber);
        if (persisted)
        {
            var ok = await DeliveryService.DeleteAsync(_draft.Id!);
            if (ok)
            {
                Snackbar.Add("삭제되었습니다.", Severity.Success);
            }
            else
            {
                Snackbar.Add("삭제 실패.", Severity.Error);
                return;
            }
        }

        await ResetToNewDeliveryAsync();
    }

    private Task GoPrev() => Task.CompletedTask;
    private Task GoNext() => Task.CompletedTask;

    private Task AddNew()
    {
        AddLine();
        return Task.CompletedTask;
    }

    private async Task Save()
    {
        if (_draft is null) return;

        if (string.IsNullOrWhiteSpace(_draft.DocumentNumber))
        {
            await SaveAsync();
            return;
        }

        if (string.IsNullOrWhiteSpace(_draft.Id))
        {
            Snackbar.Add("저장 실패.", Severity.Error);
            return;
        }

        var req = new UpdateDeliveryRequest
        {
            OrderDate = _draft.SalesDate,
            PartnerId = _draft.PartnerId ?? "",
            CashAmount = _summary.CashAmount,
            CardAmount = _summary.CardAmount,
            DiscountAmount = _summary.DiscountAmount,
            Memo = _draft.Memo,
            Items = _draft.Lines
                .Where(x => !x.IsPlaceholder)
                .Select(x => new DeliveryItemDto
                {
                    ItemId = x.ItemId,
                    ItemName = x.ItemName,
                    Spec = x.Spec,
                    Unit = x.Unit,
                    Qty = x.Qty,
                    UnitPrice = x.UnitPrice,
                    Amount = x.Amount,
                    VatAmount = x.VatAmount,
                    Memo = x.Note,
                    RowNo = x.RowNo
                }).ToList()
        };

        var ok = await DeliveryService.UpdateAsync(_draft.Id, req);
        if (ok)
        {
            Snackbar.Add("저장되었습니다.", Severity.Success);
            _hasUnsavedChanges = false;
            if (TabService.ActiveTabId is { } tabId)
            {
                TabService.SetTabDirty(tabId, false);
            }

            RefreshWorkflow();
        }
        else
        {
            Snackbar.Add("저장 실패.", Severity.Error);
        }
    }

    private Task Cancel() => Task.CompletedTask;
    private Task Print() => Task.CompletedTask;

    private async Task DownloadExcel()
    {
        if (_draft is null || string.IsNullOrEmpty(_draft.Id))
        {
            await DialogService.ShowMessageBoxAsync(
                "알림", "먼저 거래명세서를 선택해주세요.");
            return;
        }

        await DocService.DownloadExcelAsync(
            "delivery", _draft.Id);
    }

    private async Task DownloadPdf()
    {
        if (_draft is null || string.IsNullOrEmpty(_draft.Id))
        {
            await DialogService.ShowMessageBoxAsync(
                "알림", "먼저 거래명세서를 선택해주세요.");
            return;
        }

        await DocService.DownloadPdfAsync(
            "delivery", _draft.Id);
    }
    private Task OpenTaxInvoice() => Task.CompletedTask;
    private Task OpenPartnerList() => Task.CompletedTask;

    private async Task OpenListPopup()
    {
        var parameters = new DialogParameters
        {
            ["ListType"] = "sales"
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseButton = true
        };
        var dialog = await DialogService.ShowAsync<SalesListDialog>(
            "판매 목록 조회", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is SalesListItem item)
        {
            await LoadOrderToGrid(item.OrderId);
        }
    }

    private async Task LoadOrderToGrid(string orderId)
    {
        var detail = await DeliveryService.GetAsync(orderId);
        if (detail is null)
        {
            Snackbar.Add("문서를 불러올 수 없습니다.", Severity.Warning);
            return;
        }

        var lines = detail.Items.Count > 0
            ? detail.Items
                .OrderBy(x => x.RowNo)
                .Select((x, i) => new DeliveryLineModel
                {
                    ItemId = x.ItemId,
                    No = x.RowNo > 0 ? x.RowNo : i + 1,
                    IsPlaceholder = false,
                    ItemName = x.ItemName,
                    Spec = x.Spec ?? "",
                    Unit = string.IsNullOrEmpty(x.Unit) ? "EA" : x.Unit!,
                    Quantity = x.Qty,
                    UnitPrice = x.UnitPrice,
                    Note = x.Memo ?? "",
                    Warehouse = "",
                    LineAssignee = ""
                }).ToList()
            : new List<DeliveryLineModel> { new() { No = 1, IsPlaceholder = true } };

        for (var i = 0; i < lines.Count; i++)
        {
            lines[i].No = i + 1;
        }

        _draft = new DeliveryDraftModel
        {
            Id = detail.DeliveryId,
            DocumentNumber = detail.DeliveryNo,
            SalesDate = detail.OrderDate,
            PartnerId = detail.PartnerId,
            SalesCompany = detail.PartnerName,
            Memo = detail.Memo,
            ManagerName = detail.EmployeeName ?? "",
            DocumentType = "거래명세서",
            Lines = lines,
            Density = DeliveryGridDensity.Normal,
            DailySequence = 1,
            LinkedQuoteDocumentNo = $"QT-{detail.OrderDate:yyyyMMdd}-001",
            LinkedSalesOrderDocumentNo = $"SO-{detail.OrderDate:yyyyMMdd}-001"
        };

        var supply = lines.Where(x => !x.IsPlaceholder).Sum(x => x.Amount);
        var vat = lines.Where(x => !x.IsPlaceholder).Sum(x => x.VatAmount);
        _summary.PrevReceivable = detail.PrevReceivable;
        _summary.TodaySales = detail.TodaySales;
        _summary.TodayReceipt = detail.TodayReceipt;
        _summary.CashAmount = detail.CashAmount;
        _summary.CardAmount = detail.CardAmount;
        _summary.DiscountAmount = detail.DiscountAmount;
        _summary.SupplyAmount = supply;
        _summary.VatAmount = vat;
        _summary.TotalAmount = supply + vat;
        _summary.ClaimAmount = _summary.TotalAmount;

        _hasUnsavedChanges = false;
        _selectedLine = null;
        UpdateSelectionCount();
        RefreshWorkflow();

        if (TabService.ActiveTabId is { } currentTabId)
        {
            await TabService.UpdateSubTitleAsync(currentTabId, detail.PartnerName);
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task ResetToNewDeliveryAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var manager = state.User.FindFirst("name")?.Value
                      ?? state.User.FindFirst(ClaimTypes.Name)?.Value
                      ?? "담당자";
        _draft = await DeliveryService.CreateDraftAsync(manager);
        _draft.LinkedQuoteDocumentNo = $"QT-{_draft.SalesDate:yyyyMMdd}-001";
        _draft.LinkedSalesOrderDocumentNo = $"SO-{_draft.SalesDate:yyyyMMdd}-001";
        _selectedLine = null;
        _hasUnsavedChanges = false;
        if (TabService.ActiveTabId is { } tabId)
        {
            TabService.SetTabDirty(tabId, false);
        }

        RefreshWorkflow();
        RecalculateSummary();
        await InvokeAsync(StateHasChanged);
    }
}
