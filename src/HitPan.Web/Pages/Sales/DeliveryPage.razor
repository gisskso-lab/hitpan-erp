    }

    private async Task DeleteConfirm()
    {
        var result = await DialogService.ShowMessageBoxAsync(
            "삭제 확인",
            "선택한 거래명세서를 삭제하시겠습니까?",
            yesText: "삭제",
            cancelText: "취소");
        if (result != true) return;

        // 🔴 20260828작14 W7 — 확정 건은 2단 통제 (사장님 결재 8).
        //   결재 7 되돌리기 3단: 판매완료(원장 무접촉)는 그냥 **삭제**해도 되지만,
        //   판매확정 이후는 이미 재고가 나가고 미수가 잡혔다 ⇒ 패스워드를 한 번 더 받는다.
        //   ⚠️ 확정 전 문서까지 물으면 일상 업무가 번거로워진다 — 원장이 움직인 건만 막는다.
        if (_draft?.Status == "confirmed"
            && !await StepUpDialog.RequestAsync(DialogService,
                   "확정된 거래 입니다. 취소하시려면 패스워드 입력이 필요합니다"))
        {
            return;
        }

        await DeleteOrder();
    }

    private async Task DeleteOrder()
    {
        if (_draft is null) return;

        var persisted = !string.IsNullOrWhiteSpace(_draft.DocumentNumber);
        if (persisted)
        {
            var ok = await DeliveryService.DeleteAsync(_draft.Id!);
            if (ok)
            {
                Snackbar.Add("삭제되었습니다.", Severity.Success);
            }
            else
            {
                Snackbar.Add("삭제 실패.", Severity.Error);
                return;
            }
        }

        await ResetToNewDeliveryAsync();
        _isNew = true;
    }

