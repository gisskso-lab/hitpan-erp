    private async Task SaveAsync()
    {
        if (_draft is null) return;

        // 저장 전 사전 검증 — 서버까지 갔다가 400으로 돌아오는 왕복을 차단.
        if (string.IsNullOrWhiteSpace(_draft.PartnerId))
        {
            Snackbar.Add("거래처를 선택해주세요.", Severity.Warning);
            return;
        }

        var realLines = _draft.Lines.Where(x => !x.IsPlaceholder).ToList();
        if (realLines.Count == 0)
        {
            Snackbar.Add("품목을 한 줄 이상 추가해주세요.", Severity.Warning);
            return;
        }

        var unresolved = realLines
            .Where(l => string.IsNullOrWhiteSpace(l.ItemId))
            .Select(l => string.IsNullOrWhiteSpace(l.ItemName) ? "(빈 행)" : l.ItemName)
            .ToList();
        if (unresolved.Count > 0)
        {
            Snackbar.Add($"등록되지 않은 품목입니다: {string.Join(", ", unresolved)} — 품목 마스터에서 먼저 등록하거나 자동완성 목록에서 선택해주세요.", Severity.Warning);
            return;
        }

        // ─────────────────────────────────────────────────────────────────
        // 🔴 20260831작15 — 반품 모드는 **반품 문으로 보낸다** (사장님 실측 반려 1 봉합).
        //
        //   20260828작14 사고: [반품하기] 가 (−) 로 채운 뒤 아래 SaveAsync 로 그냥 흘렀다.
        //   그 문은 **판매를 만드는 문**(POST api/sales/deliveries)이라
        //   반품 의도가 **추가 판매 한 장**으로 저장됐다.
        //   사장님: *"반품이 아니라, 명-…-001 전표에 추가로 수량 90개가 주문이 된 셈"*.
        //
        //   🔴 그때 _isReturnMode 는 **배너에서만** 쓰였다. 저장은 그것을 몰랐다.
        //      게이트도 Assert.Contains("반품하기") 로 **글자만 세서** 통과시켰다.
        //      ⇒ 여기가 「고쳤나」가 아니라 「갔나」를 가르는 자리다.
        //
        //   근거: docs/설계/erp/20260831_아키텍처명세서_매출반품_저장축_역기록계층.md §7
        //         docs/설계/erp/20260831_PRD_매출반품_화면B_저장A.md FR-1·2·3
        // ─────────────────────────────────────────────────────────────────
        if (_isReturnMode)
        {
            // 🔴 20260903작17 — **이미 저장된 반품을 연 것**이면 다시 만들지 않는다.
            //   그냥 흘려보내면 [저장] 한 번에 반품이 한 장 더 생긴다(중복 생성).
            if (_isOpenedReturn)
            {
                Snackbar.Add(
                    "이미 저장된 반품 전표입니다. 수정은 아직 지원하지 않습니다 — 취소 후 다시 작성해주세요.",
                    Severity.Info);
                return;
            }

            await SaveReturnAsync(realLines);
            return;
        }

        // 20260825작5 — 사장님 오더: 수주 없이 바로 거래를 잡으면 흐름 정합성이 깨지지 않도록
        // 수주서를 자동 생성한다. 사용자가 모르고 지나가지 않도록 저장 전에 알린다.
        // 자동생성 자체는 서버가 이미 하고 있었다(SalesService) — 없던 것은 이 안내다.
        if (_isNew && string.IsNullOrWhiteSpace(_draft.LinkedSalesOrderDocumentNo))
        {
            // 🔴 20260827작10 W3 — 문구를 사장님 지시 그대로 맞춘다.
            //   사장님: *"수주서가 없는 거래입니다. 수주서를 자동 생성합니다" 메시지 띄우고*
            var proceed = await DialogService.ShowMessageBoxAsync(
                "수주서 자동 생성",
                "수주서가 없는 거래입니다. 수주서를 자동 생성합니다.",
                yesText: "저장",
                noText: "취소");
            if (proceed != true)
            {
                return;
            }
        }

        try
        {
            if (_isNew)
            {
                var result = await DeliveryService.SaveAsync(_draft);
                if (!result.Success || string.IsNullOrWhiteSpace(result.DocumentNumber))
                {
                    Snackbar.Add($"거래명세서 저장 실패: {result.Error ?? "알 수 없는 오류"}", Severity.Error);
                    return;
                }

                _isNew = false;
                Snackbar.Add($"저장 완료: {result.DocumentNumber}", Severity.Success);

                // 20260825작5: 실제로 자동 생성된 수주번호를 알린다 — 지어낸 번호가 아니라 서버가 준 실물.
                if (!string.IsNullOrWhiteSpace(result.AutoCreatedOrderNo))
                {
                    Snackbar.Add($"수주서 {result.AutoCreatedOrderNo} 가 자동 생성되었습니다.", Severity.Info);
                    RefreshWorkflow();
                }
            }
            else
            {
                if (string.IsNullOrWhiteSpace(_draft.Id))
                {
                    Snackbar.Add("저장 실패: 문서 ID가 없습니다.", Severity.Error);
                    return;
                }

                var req = new UpdateDeliveryRequest
                {
                    OrderDate = _draft.SalesDate,
                    PartnerId = _draft.PartnerId ?? "",
                    CashAmount = _summary.CashAmount,
                    CardAmount = _summary.CardAmount,
                    DiscountAmount = _summary.DiscountAmount,
                    Memo = _draft.Memo,
                    Items = _draft.Lines
                        .Where(x => !x.IsPlaceholder)
                        .Select(x => new DeliveryItemDto
                        {
                            ItemId = x.ItemId,
                            ItemName = x.ItemName,
                            Spec = x.Spec,
                            Unit = x.Unit,
                            Qty = x.Qty,
                            UnitPrice = x.UnitPrice,
                            Amount = x.Amount,
                            VatAmount = x.VatAmount,
                            Memo = x.Note,
                            RowNo = x.RowNo
                        }).ToList()
                };

                var ok = await DeliveryService.UpdateAsync(_draft.Id, req);
                if (!ok)
                {
                    Snackbar.Add("저장에 실패했습니다.", Severity.Error);
                    return;
                }

                Snackbar.Add("저장되었습니다.", Severity.Success);
            }

            if (TabService.ActiveTabId is { } tabId)
            {
                TabService.UpdateSubTitle(tabId, _draft.SalesCompany);
                TabService.SetTabDirty(tabId, false);
            }

            _hasUnsavedChanges = false;
            RefreshWorkflow();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"저장 중 오류: {ex.Message}", Severity.Error);
        }
    }

    private bool _isConfirming;
    private async Task ConfirmAsync()
    {
        if (_isConfirming) return;
        if (_draft is null) return;
        if (string.IsNullOrWhiteSpace(_draft.DocumentNumber))
        {
            await SaveAsync();
        }

        _isConfirming = true;
        try
        {
            await DeliveryService.ConfirmAsync(_draft);
            Snackbar.Add("전송(확정)을 완료했습니다.", Severity.Success);

            // 정상 확정 후에도 안전재고 이하/0 자동발주 후보 있으면 다이얼로그.
            if (!string.IsNullOrWhiteSpace(_draft.Id))
            {
                await CheckAutoOrderAsync(_draft.Id);
            }
        }
        catch (Exception ex)
        {
            // 사장님 지시 (2026-04-26): 재고 부족으로 확정 실패해도 자동발주 다이얼로그가
            // 떠야 함. 서버는 재고 차감 무결성 위해 확정을 거부하지만, 사용자 흐름은
            // "재고 부족 → 자동발주? → 발주서 생성" 으로 끊기지 않게 한다(§20).
            var msg = ex.Message ?? string.Empty;
            var isStockShortage =
                msg.Contains("재고", StringComparison.OrdinalIgnoreCase)
                && msg.Contains("부족", StringComparison.OrdinalIgnoreCase);

            if (isStockShortage && !string.IsNullOrWhiteSpace(_draft.Id))
            {
                Snackbar.Add("재고가 부족합니다. 자동발주 후보를 확인합니다…", Severity.Warning);
                await CheckAutoOrderAsync(_draft.Id);
            }
            else
            {
                Snackbar.Add(msg, Severity.Error);
            }
        }
        finally
        {
            _isConfirming = false;
        }
    }

    /// <summary>
    /// 거래명세서 확정 직후 안전재고 위반 품목 후보를 받아 다이얼로그로 자동발주 진행.
    /// 후보가 없으면 무동작.
    /// </summary>
    private async Task CheckAutoOrderAsync(string deliveryId)
    {
        var candidates = await DeliveryService.GetAutoOrderCandidatesAsync(deliveryId);
        if (candidates.Count == 0) return;

        var outOfStock = candidates.Count(c => c.Reason == "out_of_stock");
        var belowSafety = candidates.Count - outOfStock;

        var msg = new System.Text.StringBuilder();
        if (outOfStock > 0) msg.AppendLine($"재고가 없는 품목: {outOfStock}건");
        if (belowSafety > 0) msg.AppendLine($"안전재고 이하 품목: {belowSafety}건");
        msg.AppendLine();
        foreach (var c in candidates.Take(5))
        {
            msg.AppendLine($"• {c.ItemName}: 현재고 {c.CurrentQty:N0} / 안전재고 {c.SafetyQty:N0}"
                + (string.IsNullOrWhiteSpace(c.PartnerName) ? " (공급처 미설정)" : $" → {c.PartnerName}"));
        }
        if (candidates.Count > 5) msg.AppendLine($"... 외 {candidates.Count - 5}건");
        msg.AppendLine();
        msg.AppendLine("[자동발주+매입처리] 발주서 생성 후 매입확정까지 진행 (재고 즉시 +반영)");
        msg.AppendLine("[발주서만] 발주서만 생성, 매입은 수동");

        var choice = await DialogService.ShowMessageBoxAsync(
            "⚠ 안전재고 자동발주",
            msg.ToString(),
            yesText: "자동발주+매입처리",
            noText: "발주서만",
            cancelText: "취소");
        if (choice is null) return;

        var autoReceive = choice == true;
        var results = await DeliveryService.CreateAutoOrdersAsync(candidates, autoReceive);
        var success = results.Where(r => r.Success).ToList();
        var failed = results.Where(r => !r.Success).ToList();

        if (success.Count > 0)
        {
            var noList = string.Join(", ", success.Select(r => r.PoNo));
            Snackbar.Add($"자동발주서 {success.Count}건 생성 완료: {noList}", Severity.Success);
        }
        if (failed.Count > 0)
        {
            var firstReason = failed[0].Reason ?? "사유 미상";
            Snackbar.Add($"{failed.Count}건 자동발주 실패: {firstReason[..Math.Min(150, firstReason.Length)]}", Severity.Warning);
        }
    }

