@page "/deliveries"
@attribute [Authorize]
@using System.Security.Claims
@using HitPan.Web.Components.Common
@using HitPan.Web.Components.Sales
@using HitPan.Web.Models
@using HitPan.Web.Services
@namespace HitPan.Web.Pages.Delivery
@inject DeliveryService DeliveryService
@inject TaxInvoiceApiService TaxInvoiceApi
@inject DocumentService DocService
@inject WorkTabService TabService
@inject AuthenticationStateProvider AuthStateProvider
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IJSRuntime Js
@inject PartnerMasterService PartnersApi
@inject ItemMasterService ItemsApi
@inject NavigationManager Nav
@inject ILogger<DeliveryPage> Logger

<NavigationLock ConfirmExternalNavigation="@_hasUnsavedChanges" OnBeforeInternalNavigation="OnBeforeInternalNavigation" />

<section class="delivery-page">
    @if (_draft is null)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
        <WorkflowBreadcrumb Steps="_workflowSteps" />

        @* 🔴 20260828작14 W6 — 반품 전표임을 화면에 못박는다.
           같은 화면을 재사용하는 설계라(결재 5) 여기서 알려주지 않으면
           담당자가 자기가 무엇을 작성 중인지 모른 채 (−) 숫자만 보게 된다. *@
        @if (_isReturnMode)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
                <b>반품 전표</b> — 거래명세서 @_returnSourceNo 에 대한 마이너스 전표입니다.
                반품하지 않을 품목은 줄을 지우고, 수량은 잔량까지만 입력하세요.
            </MudAlert>

            @* 🔴 20260831작15 (PRD FR-5) — 반품 사유는 필수다.
               창고가 **양품과 폐기를 갈라야** 한다. 불량이면 재고에 안 넣는다
               (사장님 정의: "파손이면 로스로 정의, 파손이 아니면 재입고").
               이 칸이 없으면 창고담당이 폐기품을 재고에 넣는다. *@
            <MudPaper Class="pa-3 mb-2">
                <MudGrid>
                    <MudItem xs="12" md="4">
                        <MudSelect T="string" @bind-Value="_returnReason" Label="반품 사유 (필수)"
                                   Dense="true" Margin="Margin.Dense" Required="true">
                            <MudSelectItem T="string" Value="@("customer_return")">고객 단순 반품</MudSelectItem>
                            <MudSelectItem T="string" Value="@("defect")">불량 · 파손 (재고에 넣지 않음)</MudSelectItem>
                            <MudSelectItem T="string" Value="@("exchange")">교환</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="8">
                        <MudTextField T="string" @bind-Value="_returnReasonMemo" Label="사유 상세 (선택)"
                                      Dense="true" Margin="Margin.Dense" MaxLength="500" />
                    </MudItem>
                </MudGrid>
            </MudPaper>
        }

        <MudPaper Class="pa-3 mb-2">
            <MudGrid>
                <MudItem xs="12" md="3">
                    <MudDatePicker Label="판매일자" Date="_draft.SalesDate" DateChanged="OnSalesDateChanged" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudAutocomplete T="string" Label="거래처" Value="_draft.SalesCompany"
                        ValueChanged="OnPartnerNameChanged" SearchFunc="SearchPartnerAsync"
                        Margin="Margin.Dense" Placeholder="거래처 검색" />
                </MudItem>
                <MudItem xs="12" md="5">
                    <MudTextField T="string" Label="메모" Value="_draft.Memo"
                        ValueChanged="OnMemoChanged" Margin="Margin.Dense" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudToolBar Dense="true" Style="overflow-x:auto;flex-wrap:nowrap" Class="pa-1 gap-1">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="AddNew">추가</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="Save">저장</MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Undo" OnClick="Cancel">취소</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteConfirm">삭제</MudButton>
            @if (_draft?.Status == "confirmed")
            {
                <AuthorizeView Roles="tenant_admin,sales_manager">
                    <Authorized>
                        <MudButton Variant="Variant.Outlined" Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.ReplayCircleFilled"
                                   OnClick="CancelConfirmedAsync">매출취소</MudButton>
                    </Authorized>
                </AuthorizeView>
            }
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="CopyAsync" Disabled="@_isNew">복사</MudButton>
            <MudDivider Vertical="true" FlexItem="true" />
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Print" OnClick="Print">인쇄</MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.TableChart" OnClick="DownloadExcel">엑셀</MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="DownloadPdf">PDF</MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Email" OnClick="EmailAsync">이메일</MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Receipt" OnClick="OpenTaxInvoice">세금</MudButton>
            @* 🔴 20260828작14 W6 (사장님 결재 5) — 반품하기.
               화면을 새로 만들지 않는다. 이 화면(거래명세서)으로 되돌아오되 수량·금액이 (−)로 채워진다.
               담당자가 이미 아는 화면이라 교육이 필요 없고, 원전표에서 눌러 들어오므로 사슬 근거가 자동으로 걸린다. *@
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AssignmentReturn"
                       OnClick="OpenReturn" Disabled="@(_isNew || _draft?.Status != "confirmed")">반품하기</MudButton>
            @* 🔴 20260903작17 — 반품 확정.
               이 버튼이 없어서 반품이 draft 로만 쌓이고 **재고가 영원히 안 들어왔다**.
               확정해야 재고 IN · 미수금 ↓ · 역분개가 일어난다. *@
            @if (_isOpenedReturn && _draft?.Status == "draft")
            {
                <MudButton Variant="Variant.Filled" Color="Color.Warning"
                           StartIcon="@Icons.Material.Filled.CheckCircle"
                           OnClick="ConfirmReturnAsync">반품확정</MudButton>
            }
            <MudSpacer />
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FormatListBulleted" OnClick="OpenListPopup">목록</MudButton>
        </MudToolBar>

        <div class="delivery-grid-wrap">
            <DeliveryGrid Lines="_draft.Lines" PartnerId="@_draft.PartnerId"
                          Density="_draft.Density"
                          SelectedLine="_selectedLine"
                          SelectedLineChanged="OnSelectedLineChanged"
                          OnChanged="OnLinesChanged"
                          OnSelectionChanged="OnSelectionChanged"
                          OnContextSecondary="OnContextSecondaryAsync"
                          ItemCache="_itemCache"
                          Summary="_summary" />
        </div>

        <MudPaper Class="pa-3 mt-2">
            <MudStack Row="true" Spacing="3">
                <MudText Typo="Typo.body2">공급가액: @_summary.SupplyAmount.ToString("N0")</MudText>
                <MudText Typo="Typo.body2">부가세: @_summary.VatAmount.ToString("N0")</MudText>
                <MudText Typo="Typo.body2">합계: @_summary.TotalAmount.ToString("N0")</MudText>
            </MudStack>
        </MudPaper>
    }
</section>

@code {
    private DeliveryDraftModel? _draft;
    private DeliverySummaryModel _summary = new();
    private DeliveryLineModel? _selectedLine;
    private bool _hasUnsavedChanges;
    private IReadOnlyList<DeliveryWorkflowStepModel> _workflowSteps = Array.Empty<DeliveryWorkflowStepModel>();
    private int _selectedCount;
    private bool _canBulkDelete;
    private ClaimsPrincipal? _user;
    private bool _isNew = true;
    private List<PartnerListRow>? _partnerCache;
    private List<ItemListModel>? _itemCache;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        _user = state.User;
        _canBulkDelete = HitPanRoleHelper.IsInHitPanRole(_user, "TenantAdmin")
                         || HitPanRoleHelper.IsInHitPanRole(_user, "Manager");

        var manager = _user.FindFirst("name")?.Value
                      ?? _user.FindFirst(ClaimTypes.Name)?.Value
                      ?? "담당자";
        _draft = await DeliveryService.CreateDraftAsync(manager);
        // WO-11 한글 prefix (견적·수주 폴백 placeholder)
        // 20260825작5: 견적번호도 "견-yyyyMMdd-001" 을 지어내 항상 -001 로 보였다(수주와 같은 사고).
        // 거래명세서는 견적을 직접 참조하지 않는다(연결은 견적→수주 한 방향) — 지어내는 대신 비운다.
        _draft.LinkedQuoteDocumentNo = null;
        // 20260825작5: 종전에는 "수-yyyyMMdd-001" 을 지어내 항상 -001 로 보였다.
        // 새 문서는 수주가 아직 없다 — 비워 두고, 저장 후 서버가 준 실제 번호로 채운다.
        _draft.LinkedSalesOrderDocumentNo = null;
        _itemCache = await ItemsApi.GetListAsync() ?? new();

        // 🔴 20260828작14 W6 — 반품하기로 들어온 경우(?returnOf=...) 원전표를 (−)로 채운다.
        //   결재 5: 화면을 새로 만들지 않는다. 같은 화면에 부호만 반대로 채워 돌려준다.
        await TryLoadReturnSourceAsync();

        RefreshWorkflow();
        RecalculateSummary();
    }

    /// <summary>
    /// 🔴 20260828작14 W6 — 반품 원전표 적재 (사장님 결재 2·3·5).
    ///
    /// <para>
    /// <c>?returnOf={deliveryId}</c> 로 들어오면 그 거래명세서를 읽어
    /// <b>수량·금액을 (−)로 전량 채운 상태</b>로 화면을 연다.
    /// </para>
    ///
    /// <para>
    /// 🔴 <b>사슬 근거가 여기서 걸린다.</b> 담당자가 거래처·품목을 다시 고르는 것이 아니라
    /// <b>원전표에서 눌러 들어오므로</b> 무엇에 대한 마이너스인지가 저절로 정해진다.
    /// 사장님: <i>"이 마이너스 전표의 근거가 뭔지는 분명하게 사슬로 연결을 시켜야해."</i>
    /// </para>
    ///
    /// <para>
    /// ⚠️ 잔량 상한은 <b>서버가 최종 판정</b>한다(SalesService 잔량 검사).
    /// 화면이 채워주는 값은 편의이지 방어가 아니다 — 화면만 믿으면 API 직접 호출로 뚫린다(P0-1 이 그 사고).
    /// </para>
    /// </summary>
    private async Task TryLoadReturnSourceAsync()
    {
        var srcId = ReturnOfQuery;
        if (string.IsNullOrWhiteSpace(srcId) || _draft is null) return;

        try
        {
            var src = await DeliveryService.GetAsync(srcId);
            if (src is null)
            {
                Snackbar.Add("원 거래명세서를 찾지 못했습니다.", Severity.Warning);
                return;
            }

            _isReturnMode = true;
            _returnSourceNo = src.DeliveryNo;
            // 🔴 20260903작17 — 원전표 id 를 **상태로 붙잡는다.**
            //   종전에는 저장할 때 ReturnOfQuery(주소창 파라미터)를 직접 읽었다.
            //   주소가 한 번이라도 갈리면(재렌더·뒤로가기·두 번째 저장) 링크가 조용히 null 이 된다.
            //   실측(9/3): 같은 날 만든 반품 2건 중 **반-20260903-002 만 deliveryId=null**.
            //   메모에는 둘 다 "반품 : 명-20260825-001" 이 찍혀 있었다 — 의도는 같았는데 링크만 샜다.
            _returnSourceId = srcId;

            _draft.PartnerId = src.PartnerId;
            _draft.SalesCompany = src.PartnerName;
            _draft.SalesDate = DateTime.Today;
            // 🔴 사슬 표기 — 원전표 번호를 비고에 남긴다(사장님: "반품전표 : 반-(전표번호)").
            _draft.Memo = $"반품 : {src.DeliveryNo}";

            _draft.Lines.Clear();
            foreach (var it in src.Items)
            {
                // 금액(Amount·VatAmount)은 수량×단가로 파생되는 계산 속성이다 —
                // 수량을 (−)로 넣으면 금액도 저절로 (−)가 된다. 따로 대입하지 않는다.
                _draft.Lines.Add(new DeliveryLineModel
                {
                    ItemId = it.ItemId,
                    ItemName = it.ItemName,
                    Spec = it.Spec ?? string.Empty,
                    Unit = it.Unit ?? "EA",
                    Quantity = -it.Qty,                  // (−) 전량. 담당자가 줄을 지우거나 수량을 줄인다.
                    UnitPrice = it.UnitPrice,
                    Warehouse = it.WarehouseId ?? string.Empty,   // 반품은 나간 창고로 되돌아온다
                    // 🔴 줄 단위 사슬 링크 — 어느 판매 줄에서 왔는지. 원단가 추적의 근거다.
                    //   20260825작7 에서 "컬럼·FK·DTO 는 다 있는데 화면에 값이 안 와서 못 채우던" 자리다.
                    DeliveryItemId = it.DeliveryItemId
                });
            }

            Snackbar.Add($"거래명세서 {src.DeliveryNo} 의 반품 전표입니다. 반품하지 않을 품목은 줄을 지우세요.",
                         Severity.Info);
        }
        catch (Exception ex)
        {
            // 헌법 #15 — 빈 catch 금지.
            Logger.LogWarning(ex, "반품 원전표 적재 실패 deliveryId={DeliveryId}", srcId);
            Snackbar.Add($"원 거래명세서를 불러오지 못했습니다: {ex.Message}", Severity.Error);
        }
    }

    /// <summary>
    /// 🔴 <b>반품 저장 — 20260831작15</b>. 화면의 (−) 를 <b>양수</b>로 바꿔 반품 문으로 보낸다.
    /// </summary>
    /// <remarks>
    /// <para>
    /// 🔴 <b>부호를 여기서 뒤집는 이유</b> — 원장이 음수를 안 받는다.
    /// <c>journal_lines</c> 에 <c>chk_jl_debit_or_credit</c> CHECK 가 걸려 있어
    /// 음수 분개는 <b>DB 가 거부</b>하고, <c>stock_ledger</c> 는 부호 대신
    /// <c>qty_in</c>/<c>qty_out</c> 두 칸으로 방향을 표현한다.
    /// ⇒ 담당자는 (−) 를 보지만 저장은 양수, 부호는 원장 계층이 붙인다.
    /// </para>
    /// <para>
    /// ⚠️ 잔량 상한·중복은 <b>서버가 최종 판정</b>한다(<c>CreateSalesReturnAsync</c> 잔량 검사).
    /// 화면 값은 편의이지 방어가 아니다 — 화면만 믿으면 API 직접 호출로 뚫린다.
    /// </para>
    /// </remarks>
    private async Task SaveReturnAsync(List<DeliveryLineModel> realLines)
    {
        if (_draft is null) return;

        // 🔴 PRD FR-5 — 사유는 필수다. 창고가 양품·폐기를 갈라야 한다.
        //   불량(defect)이면 서버가 is_loss 로 재고에 안 넣는다.
        if (string.IsNullOrWhiteSpace(_returnReason))
        {
            Snackbar.Add("반품 사유를 선택해주세요.", Severity.Warning);
            return;
        }

        // 🔴 20260903작17 — 사슬 없는 반품은 저장하지 않는다 (사장님 결재 3).
        //
        //   실측(9/3): 반-20260903-002 가 deliveryId=null 로 저장돼 있었다.
        //   메모에는 "반품 : 명-20260825-001" 이 찍혀 있어 **의도는 분명했는데 링크만 샜다.**
        //   근거 없는 마이너스는 장부를 못 읽게 만든다 — 「왜 −50원인가」에 답이 없으면 세무 대응 불가.
        //
        //   🔴 조용히 통과시키면 안 된다. 막고 담당자에게 알린다.
        if (string.IsNullOrWhiteSpace(_returnSourceId ?? ReturnOfQuery))
        {
            Snackbar.Add(
                "원 거래명세서 연결이 끊겼습니다. 판매 목록에서 원 전표를 열고 [반품하기]로 다시 시작해주세요.",
                Severity.Error);
            Logger.LogWarning("반품 저장 차단 — 원전표 링크 없음 memo={Memo}", _draft.Memo);
            return;
        }

        var payload = new CreateSalesReturnPayload
        {
            // 🔴 사슬 근거 — 원전표 FK. 결재 3: "마이너스 전표의 근거를 분명하게 사슬로 연결"
            //   20260828작14 는 이 값을 담을 칸이 payload 에 없어 **메모 글자만 남았다.**
            // 🔴 상태 우선 — 주소창은 보조. 둘 다 비면 사슬이 끊긴 채 저장되므로 위에서 막는다.
            DeliveryId = _returnSourceId ?? ReturnOfQuery,
            PartnerId = _draft.PartnerId ?? string.Empty,
            ReturnDate = _draft.SalesDate,
            Memo = _draft.Memo,
            ReturnReason = _returnReason,
            ReturnReasonMemo = _returnReasonMemo,
            Items = realLines.Select(x => new CreateSalesReturnItemPayload
            {
                ItemId = x.ItemId,
                // 🔴 줄 단위 사슬 — 어느 판매 줄에서 왔는지. 원단가 추적의 근거.
                DeliveryItemId = x.DeliveryItemId,
                WarehouseId = string.IsNullOrWhiteSpace(x.Warehouse) ? null : x.Warehouse,
                // 🔴 화면은 (−), 저장은 양수. 서버 [Range(0.0001,…)] 이 음수를 거부한다.
                Qty = Math.Abs(x.Qty),
                UnitPrice = Math.Abs(x.UnitPrice),
                OriginalUnitPrice = Math.Abs(x.UnitPrice),
                SupplyAmount = Math.Abs(x.Amount),
                VatAmount = Math.Abs(x.VatAmount),
                // 파손이면 재고에 안 넣는다 (사장님 정의: "파손이면 로스, 아니면 재입고")
                IsLoss = string.Equals(_returnReason, "defect", StringComparison.Ordinal)
            }).ToList()
        };

        var result = await DeliveryService.CreateSalesReturnAsync(payload);
        if (!result.Success || string.IsNullOrWhiteSpace(result.DocumentNumber))
        {
            // 서버 응답 본문을 그대로 보여준다 — 잔량 초과 안내가 여기 담겨 온다.
            Snackbar.Add($"반품 저장 실패: {result.Error ?? "알 수 없는 오류"}", Severity.Error);
            return;
        }

        _isNew = false;
        Snackbar.Add($"반품 저장 완료: {result.DocumentNumber}", Severity.Success);
        Nav.NavigateTo("/deliveries", forceLoad: true);
    }

    /// <summary>
    /// 🔴 <b>반품 확정</b> — 20260903작17. 여기서 재고 IN · 미수금 ↓ · 역분개가 일어난다.
    /// </summary>
    /// <remarks>
    /// 실측(9/3): 반품 4건 중 확정된 것은 1건뿐이었다. 나머지는 <c>draft</c> 로 쌓여
    /// <b>재고가 안 움직인 것이 정상</b>이었는데, <b>확정할 버튼 자체가 없어</b> 담당자가
    /// 확정을 할 수가 없었다 — <i>"재고반영이 하나도 안됫고"</i> 의 진짜 원인이다.
    /// </remarks>
    private async Task ConfirmReturnAsync()
    {
