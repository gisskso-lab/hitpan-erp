    private async Task OpenListPopup()
    {
        var parameters = new DialogParameters
        {
            ["ListType"] = "sales"
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            CloseButton = true
        };
        var dialog = await DialogService.ShowAsync<SalesListDialog>(
            "판매 목록 조회", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is SalesListItem item)
        {
            // 🔴 20260903작17 — 반품 줄을 고르면 **반품 전표**를 연다.
            //
            //   종전에는 무조건 LoadOrderToGrid(=GET api/sales/deliveries/{id}) 를 불렀다.
            //   반품 id 로 **거래명세서 표**를 뒤지니 못 찾아서 "문서를 불러올 수 없습니다" 가 떴다.
            //   ⇒ 사장님: *"전표를 못찾겠음"* — 목록에는 보이는데 열 수가 없던 자리다.
            //   저장은 sales_returns 로 갔는데 여는 문이 sales_deliveries 만 알고 있었다.
            if (item.IsReturn)
            {
                await LoadReturnToGrid(item.OrderId);
            }
            else
            {
                await LoadOrderToGrid(item.OrderId);
            }
        }
    }

    /// <summary>
    /// 🔴 <b>반품 전표를 화면에 연다</b> — 20260903작17.
    /// </summary>
    /// <remarks>
    /// <para>
    /// 새 화면을 만들지 않는다(사장님 결재 5). <b>같은 거래명세서 화면</b>에
    /// 수량을 (−)로 띄운다 — 저장된 값은 양수이므로 여기서 부호를 붙여 보여준다.
    /// (원장이 음수를 안 받아 저장은 양수다 — 20260831 아키텍처 판정 §7)
    /// </para>
    /// <para>
    /// ⚠️ 열기만 한다. 확정·취소는 서버가 <c>sales/returns/{id}/confirm</c> 으로 따로 받는다.
    /// </para>
    /// </remarks>
    private async Task LoadReturnToGrid(string returnId)
    {
        var detail = await DeliveryService.GetSalesReturnDetailAsync(returnId);
        if (detail is null)
        {
            Snackbar.Add("반품 전표를 불러올 수 없습니다.", Severity.Warning);
            return;
        }

        _draft ??= new DeliveryDraftModel();
        _draft.Id = returnId;
        _draft.DocumentNumber = detail.ReturnNo;
        _draft.PartnerId = detail.PartnerId ?? string.Empty;
        _draft.SalesCompany = detail.PartnerName ?? string.Empty;
        _draft.SalesDate = detail.ReturnDate;
        _draft.Memo = detail.Memo;
        _draft.Status = detail.Status ?? "draft";

        _draft.Lines.Clear();
        foreach (var it in detail.Items ?? new())
        {
            _draft.Lines.Add(new DeliveryLineModel
            {
                ItemId = it.ItemId,
                ItemName = it.ItemName,
                Spec = it.Spec ?? string.Empty,
                Unit = it.Unit ?? "EA",
                // 저장은 양수 · 화면은 (−) — 담당자가 보는 것은 마이너스 전표다.
                Quantity = -Math.Abs(it.Qty),
                UnitPrice = it.UnitPrice,
                Warehouse = it.WarehouseId ?? string.Empty
            });
        }

        _isNew = false;
        _isReturnMode = true;
        _isOpenedReturn = true;
        // 원전표 번호는 상세에 없다 — 메모에 "반품 : 명-…" 로 찍혀 있으니 그것을 쓴다.
        _returnSourceNo = detail.Memo;
        _returnSourceId = detail.ReceiptId;
        RecalculateSummary();
        StateHasChanged();

        Snackbar.Add($"반품 전표 {detail.ReturnNo} 을(를) 열었습니다.", Severity.Info);
    }

    private async Task LoadOrderToGrid(string orderId)
    {
        var detail = await DeliveryService.GetAsync(orderId);
        if (detail is null)
        {
            Snackbar.Add("문서를 불러올 수 없습니다.", Severity.Warning);
            return;
        }

        var lines = detail.Items.Count > 0
            ? detail.Items
                .OrderBy(x => x.RowNo)
                .Select((x, i) => new DeliveryLineModel
                {
                    ItemId = x.ItemId,
                    No = x.RowNo > 0 ? x.RowNo : i + 1,
                    IsPlaceholder = false,
                    ItemName = x.ItemName,
                    Spec = x.Spec ?? "",
                    Unit = string.IsNullOrEmpty(x.Unit) ? "EA" : x.Unit!,
                    Quantity = x.Qty,
                    UnitPrice = x.UnitPrice,
                    Note = x.Memo ?? "",
                    Warehouse = "",
                    LineAssignee = ""
                }).ToList()
            : new List<DeliveryLineModel> { new() { No = 1, IsPlaceholder = true } };

        for (var i = 0; i < lines.Count; i++)
        {
            lines[i].No = i + 1;
        }

        _draft = new DeliveryDraftModel
        {
            Id = detail.DeliveryId,
            DocumentNumber = detail.DeliveryNo,
            SalesDate = detail.OrderDate,
            PartnerId = detail.PartnerId,
            SalesCompany = detail.PartnerName,
            Memo = detail.Memo,
            ManagerName = detail.EmployeeName ?? "",
            DocumentType = "거래명세서",
            Lines = lines,
            Density = DeliveryGridDensity.Normal,
            DailySequence = 1,
            // 20260825작5: 지어낸 견적번호 제거. 거래명세서는 견적을 직접 참조하지 않는다.
            LinkedQuoteDocumentNo = null,
            // 20260825작5: 서버가 내려준 실제 수주번호. 종전에는 "수-yyyyMMdd-001" 을 지어내
            // 항상 -001 로 보였다 — 자동 생성분이 -004 여도 화면은 -001 이었다.
            LinkedSalesOrderDocumentNo = detail.LinkedOrderNo,
            Status = detail.Status  // 확정/취소 버튼 분기용
        };

        var supply = lines.Where(x => !x.IsPlaceholder).Sum(x => x.Amount);
        var vat = lines.Where(x => !x.IsPlaceholder).Sum(x => x.VatAmount);
        _summary.PrevReceivable = detail.PrevReceivable;
        _summary.TodaySales = detail.TodaySales;
        _summary.TodayReceipt = detail.TodayReceipt;
        _summary.CashAmount = detail.CashAmount;
        _summary.CardAmount = detail.CardAmount;
        _summary.DiscountAmount = detail.DiscountAmount;
        _summary.SupplyAmount = supply;
        _summary.VatAmount = vat;
        _summary.TotalAmount = supply + vat;
        _summary.ClaimAmount = _summary.TotalAmount;

        _isNew = false;
        _hasUnsavedChanges = false;
        _selectedLine = null;
        UpdateSelectionCount();
        RefreshWorkflow();

        if (TabService.ActiveTabId is { } currentTabId)
        {
            await TabService.UpdateSubTitleAsync(currentTabId, detail.PartnerName);
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task ResetToNewDeliveryAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var manager = state.User.FindFirst("name")?.Value
                      ?? state.User.FindFirst(ClaimTypes.Name)?.Value
                      ?? "담당자";
        _draft = await DeliveryService.CreateDraftAsync(manager);
        // WO-11 한글 prefix
        // 20260825작5: 견적번호도 "견-yyyyMMdd-001" 을 지어내 항상 -001 로 보였다(수주와 같은 사고).
        // 거래명세서는 견적을 직접 참조하지 않는다(연결은 견적→수주 한 방향) — 지어내는 대신 비운다.
        _draft.LinkedQuoteDocumentNo = null;
        // 20260825작5: 종전에는 "수-yyyyMMdd-001" 을 지어내 항상 -001 로 보였다.
        // 새 문서는 수주가 아직 없다 — 비워 두고, 저장 후 서버가 준 실제 번호로 채운다.
        _draft.LinkedSalesOrderDocumentNo = null;
        _selectedLine = null;
        _hasUnsavedChanges = false;
        if (TabService.ActiveTabId is { } tabId)
        {
            TabService.SetTabDirty(tabId, false);
        }

        RefreshWorkflow();
        RecalculateSummary();
        await InvokeAsync(StateHasChanged);
    }
