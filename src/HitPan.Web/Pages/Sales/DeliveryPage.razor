    private async Task OpenTaxInvoice()
    {
        // 확정된 거래명세서에 대해서만 세금계산서 발행 대상으로 이동.
        if (_draft is null || string.IsNullOrWhiteSpace(_draft.DocumentNumber))
        {
            Snackbar.Add("먼저 거래명세서를 저장해주세요.", Severity.Warning);
            return;
        }

        if (_draft.Status != "confirmed")
        {
            var proceed = await DialogService.ShowMessageBoxAsync(
                "확정 필요",
                "세금계산서는 확정된 거래명세서에 대해 발행됩니다. 먼저 확정하시겠습니까?",
                yesText: "확정하고 이동",
                cancelText: "취소");
            if (proceed != true) return;

            try
            {
                await DeliveryService.ConfirmAsync(_draft);
                _draft.Status = "confirmed";
                RefreshWorkflow();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"확정 실패: {ex.Message}", Severity.Error);
                return;
            }
        }

        // 세금계산서 화면으로 이동 + 거래처·기간 필터 프리셋.
        var partner = Uri.EscapeDataString(_draft.SalesCompany ?? string.Empty);
        var from = _draft.SalesDate.ToString("yyyy-MM-dd");
        var to = _draft.SalesDate.ToString("yyyy-MM-dd");
        Nav.NavigateTo($"/tax-invoice?partner={partner}&from={from}&to={to}");
    }

