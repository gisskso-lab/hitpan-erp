@page "/quotation-status"
@namespace HitPan.Web.Pages.SalesUi
@attribute [Authorize]
@using HitPan.Web.Models
@using HitPan.Web.Services
@inject QuotationService QuotationService
@inject ISnackbar Snackbar

<PageTitle>견적현황</PageTitle>
<MudText Typo="Typo.h6" Class="mb-3">견적현황</MudText>

<MudPaper Class="pa-3 mb-3" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default);border-radius:12px">
    <MudGrid Spacing="2" Class="align-center">
        <MudItem xs="12" sm="3">
            <MudSelect T="string" @bind-Value="_viewType" Label="조회유형" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="@("period")">기간별 제출현황</MudSelectItem>
                <MudSelectItem Value="@("item")">품목별 제출현황</MudSelectItem>
                <MudSelectItem Value="@("partner")">업체별 제출현황</MudSelectItem>
                <MudSelectItem Value="@("employee")">사원별 제출현황</MudSelectItem>
                <MudSelectItem Value="@("price")">견적단가 조회</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudDatePicker @bind-Date="_from" Label="시작일" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="yyyy-MM-dd" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudDatePicker @bind-Date="_to" Label="종료일" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="yyyy-MM-dd" />
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudTextField @bind-Value="_partner" Label="업체명" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="SearchAsync">조회</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Elevation="0" Style="border:0.5px solid var(--mud-palette-lines-default);border-radius:12px;overflow:hidden">
    <MudTable T="QuotationListItem" Items="_items" Dense="true" Hover="true" Striped="true" FixedHeader="true" Height="calc(100vh - 280px)">
        <HeaderContent>
            <MudTh>일자</MudTh>
            <MudTh>견적번호</MudTh>
            <MudTh>업체명</MudTh>
            <MudTh>상태</MudTh>
            <MudTh Style="text-align:right">공급가액</MudTh>
            <MudTh Style="text-align:right">부가세</MudTh>
            <MudTh Style="text-align:right">합계</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.QuoteDate.ToString("yyyy-MM-dd")</MudTd>
            <MudTd><MudText Style="font-weight:500">@context.QuoteNo</MudText></MudTd>
            <MudTd>@context.PartnerName</MudTd>
            <MudTd><MudChip T="string" Size="Size.Small" Color="@GetColor(context.Status)" Variant="Variant.Text">@GetLabel(context.Status)</MudChip></MudTd>
            <MudTd Style="text-align:right">@context.TotalAmount.ToString("N0")</MudTd>
            <MudTd Style="text-align:right">@context.VatAmount.ToString("N0")</MudTd>
            <MudTd Style="text-align:right;font-weight:500">@((context.TotalAmount + context.VatAmount).ToString("N0"))</MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText Class="pa-4" Style="color:#9CA3AF">조회된 견적이 없습니다.</MudText></NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private DateTime? _from = DateTime.Today.AddDays(-30);
    private DateTime? _to = DateTime.Today;
    private string _partner = "";
    private string _viewType = "period";
    private List<QuotationListItem> _items = new();

    protected override async Task OnInitializedAsync() => await SearchAsync();

    private async Task SearchAsync()
    {
        _items = await QuotationService.GetListAsync(_from, _to, _partner) ?? new();
    }

    private static Color GetColor(string s) => s switch { "converted" => Color.Success, "draft" => Color.Default, _ => Color.Info };
    private static string GetLabel(string s) => s switch { "converted" => "수주전환", "draft" => "임시", "submitted" => "제출", _ => s };
}
