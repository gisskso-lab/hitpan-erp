@page "/sales/tax-invoice-history"
@namespace HitPan.Web.Pages.SalesUi
@attribute [Authorize]
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@inject ISnackbar Snackbar
@inject HttpClient Http

<PageTitle>전자세금계산서 발행 이력</PageTitle>

<PageHeader Title="전자세금계산서 발행 이력" Subtitle="다이렉트 발행·반송·취소·수정 통합 이력 (방식 A 정합)">
    <Actions>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="RefreshAsync" Disabled="@_busy">새로고침</MudButton>
    </Actions>
</PageHeader>

<MudGrid Spacing="2" Class="mb-3">
    <MudItem xs="6" md="3">
        <MudPaper Class="pa-3" Elevation="1">
            <MudText Typo="Typo.caption">정상 발행</MudText>
            <MudText Typo="Typo.h5" Color="Color.Success">@_stats.Issued</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" md="3">
        <MudPaper Class="pa-3" Elevation="1">
            <MudText Typo="Typo.caption">반송</MudText>
            <MudText Typo="Typo.h5" Color="Color.Warning">@_stats.Bounced</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" md="3">
        <MudPaper Class="pa-3" Elevation="1">
            <MudText Typo="Typo.caption">취소</MudText>
            <MudText Typo="Typo.h5" Color="Color.Error">@_stats.Cancelled</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" md="3">
        <MudPaper Class="pa-3" Elevation="1">
            <MudText Typo="Typo.caption">대기·점검</MudText>
            <MudText Typo="Typo.h5" Color="Color.Info">@_stats.Pending</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<SectionCard Title="발행 이력">
    <MudTable Items="@_items" Hover="true" Dense="true" Loading="@_busy" Striped="true">
        <HeaderContent>
            <MudTh>발행일</MudTh>
            <MudTh>승인번호</MudTh>
            <MudTh>공급자</MudTh>
            <MudTh>공급받는자</MudTh>
            <MudTh Style="text-align:right">금액</MudTh>
            <MudTh>상태</MudTh>
            <MudTh>관리</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.IssuedAt.ToString("yyyy-MM-dd HH:mm")</MudTd>
            <MudTd Style="font-family: monospace; font-size: 12px;">@context.ApprovalNumber</MudTd>
            <MudTd>@context.SupplierName</MudTd>
            <MudTd>@context.ReceiverName</MudTd>
            <MudTd Style="text-align:right">@context.TotalAmount.ToString("N0")원</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)">
                    @GetStatusName(context.Status)
                </MudChip>
            </MudTd>
            <MudTd>
                @if (context.Status == "Issued" || context.Status == "Approved")
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                               OnClick="@(() => OnCancelClick(context))">취소</MudButton>
                }
                @if (context.Status == "Bounced")
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Warning"
                               OnClick="@(() => OnResendClick(context))">재발행</MudButton>
                }
                <MudButton Size="Size.Small" Variant="Variant.Text"
                           OnClick="@(() => OnViewDetail(context))">상세</MudButton>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2" Class="pa-4 text-center">발행 이력이 없습니다.</MudText>
        </NoRecordsContent>
    </MudTable>
</SectionCard>

@code {
    private List<HistoryItemDto> _items = new();
    private HistoryStatsDto _stats = new();
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        _busy = true;
        try
        {
            // 기존 List API (`GET /api/sales/tax-invoices`) 활용 — 별도 history 엔드포인트 불필요.
            var list = await Http.GetFromJsonAsync<List<TaxInvoiceListRow>>("api/sales/tax-invoices") ?? new();

            _items = list.Select(r => new HistoryItemDto(
                r.IssueDate ?? r.CreatedAt ?? DateTime.MinValue,
                r.ApprovalNumber ?? string.Empty,
                r.SupplierName ?? string.Empty,
                r.ReceiverName ?? string.Empty,
                r.TotalAmount,
                r.Status ?? "Pending"
            )).ToList();

            _stats = new HistoryStatsDto
            {
                Issued = _items.Count(i => i.Status == "Issued" || i.Status == "Approved"),
                Bounced = _items.Count(i => i.Status == "Bounced"),
                Cancelled = _items.Count(i => i.Status == "Cancelled"),
                Pending = _items.Count(i => i.Status == "Pending")
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"이력 조회 실패: {ex.Message}", Severity.Warning);
            _items = new();
            _stats = new();
        }
        finally
        {
            _busy = false;
        }
    }

    private class TaxInvoiceListRow
    {
        [JsonPropertyName("invoiceId")] public string InvoiceId { get; set; } = string.Empty;
        [JsonPropertyName("approvalNumber")] public string? ApprovalNumber { get; set; }
        [JsonPropertyName("issueDate")] public DateTime? IssueDate { get; set; }
        [JsonPropertyName("createdAt")] public DateTime? CreatedAt { get; set; }
        [JsonPropertyName("supplierName")] public string? SupplierName { get; set; }
        [JsonPropertyName("receiverName")] public string? ReceiverName { get; set; }
        [JsonPropertyName("totalAmount")] public decimal TotalAmount { get; set; }
        [JsonPropertyName("status")] public string? Status { get; set; }
    }

    private void OnCancelClick(HistoryItemDto item)
    {
        Snackbar.Add($"취소 요청: {item.ApprovalNumber} (W3 가도 시 백엔드 연결)", Severity.Info);
    }

    private void OnResendClick(HistoryItemDto item)
    {
        Snackbar.Add($"재발행 요청: {item.ApprovalNumber} (W3 가도 시 백엔드 연결)", Severity.Info);
    }

    private void OnViewDetail(HistoryItemDto item)
    {
        Snackbar.Add($"상세: {item.ApprovalNumber} (W3 가도 시 다이얼로그 연결)", Severity.Info);
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Issued" => Color.Success,
        "Approved" => Color.Success,
        "Bounced" => Color.Warning,
        "Cancelled" => Color.Error,
        "Pending" => Color.Info,
        _ => Color.Default
    };

    private string GetStatusName(string status) => status switch
    {
        "Issued" => "발행됨",
        "Approved" => "승인됨",
        "Bounced" => "반송",
        "Cancelled" => "취소",
        "Pending" => "대기",
        _ => status
    };

    public record HistoryItemDto(
        DateTime IssuedAt,
        string ApprovalNumber,
        string SupplierName,
        string ReceiverName,
        decimal TotalAmount,
        string Status);

    public record HistoryStatsDto
    {
        public int Issued { get; init; }
        public int Bounced { get; init; }
        public int Cancelled { get; init; }
        public int Pending { get; init; }
    }
}
