@page "/setup/license"
@layout EmptyLayout
@attribute [AllowAnonymous]
@inject HttpClient ErpApi
@inject NavigationManager Nav
@inject MudBlazor.ISnackbar Snackbar
@inject IServiceProvider Sp
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json

@*
    히트판 ERP 첫 설치 — 라이선스 검증 + 회사정보 자동 반영 (사장님 결재 2026-06-04, 헌법 #35)

    옵션 C (사장님 결재):
      - 본사 평문 사업자정보 보관 0건
      - 라이선스 키 + 사업자번호 + 회사정보(평문) ERP 로컬에만 저장
      - 백오피스 API는 해시 매칭 검증만

    흐름:
      Step 1: 라이선스 키 + 사업자번호 입력 → 백오피스 API 검증
      Step 2: 검증 통과 → 회사 추가정보 입력 (대표·연락처·이메일·주소·업태·종목)
      Step 3: ERP API /api/setup/bootstrap 호출 → tenants UPDATE + is_locked_from_landing=1
      Step 4: 부모계정 로그인 안내
*@

<PageTitle>히트판 ERP 첫 설치 — 라이선스 등록</PageTitle>

<div class="setup-page">
    <div class="setup-card">
        <div class="setup-brand">
            <div class="setup-logo">HP</div>
            <h1>히트판 ERP 설치</h1>
            <p>가입 시 받으신 부모 계정ID(라이선스 키)로 회사 정보를 자동 반영합니다.</p>
        </div>

        <div class="setup-steps">
            <div class="step @(_step >= 1 ? "active" : "")">1. 라이선스</div>
            <div class="step-line"></div>
            <div class="step @(_step >= 2 ? "active" : "")">2. 회사 정보</div>
            <div class="step-line"></div>
            <div class="step @(_step >= 3 ? "active" : "")">3. 부모 계정</div>
            <div class="step-line"></div>
            <div class="step @(_step >= 4 ? "active" : "")">4. 완료</div>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="setup-error">@_error</div>
        }

        @if (_step == 1)
        {
            <div class="setup-section">
                <div class="setup-field">
                    <label>부모 계정ID (라이선스 키) *</label>
                    <input type="text" @bind="_licenseKey"
                           placeholder="HITP-XXXX-XXXX-XXXX-XXXX" maxlength="24"
                           style="font-family:Consolas,Monaco,monospace;letter-spacing:1px;" />
                </div>
                <div class="setup-field">
                    <label>사업자등록번호 *</label>
                    <input type="text" @bind="_bizNo"
                           placeholder="000-00-00000" maxlength="12" />
                </div>
                <button type="button" class="setup-submit" @onclick="VerifyAsync" disabled="@_busy">
                    @(_busy ? "검증 중..." : "라이선스 검증")
                </button>
                <p class="setup-note">
                    가입 시 받으신 이메일에 라이선스 키가 포함되어 있습니다.
                    분실 시 support@hitpan.kr 로 문의해주세요.
                </p>
            </div>
        }
        else if (_step == 2)
        {
            <div class="setup-section">
                <div class="setup-readonly">
                    <div class="setup-readonly-label">확인된 회사</div>
                    <div class="setup-readonly-value">@_companyName <span class="setup-tenant-code">(@_tenantCode)</span></div>
                </div>

                <p class="setup-info">
                    아래 회사 정보는 ERP에 저장되어 본 PC에만 보관됩니다. 본사로 전송되지 않습니다.
                </p>

                <div class="setup-field">
                    <label>대표자명 *</label>
                    <input type="text" @bind="_ceoName" required />
                </div>
                <div class="setup-field">
                    <label>대표 연락처</label>
                    <input type="tel" @bind="_tel" placeholder="02-000-0000 또는 010-0000-0000" />
                </div>
                <div class="setup-field">
                    <label>이메일</label>
                    <input type="email" @bind="_email" placeholder="company@example.com" />
                </div>
                <div class="setup-field">
                    <label>회사 주소</label>
                    <input type="text" @bind="_address" />
                </div>
                <div class="setup-row">
                    <div class="setup-field" style="flex:1;">
                        <label>업태</label>
                        <input type="text" @bind="_bizType" placeholder="예: 도소매업" />
                    </div>
                    <div class="setup-field" style="flex:1;">
                        <label>종목</label>
                        <input type="text" @bind="_bizItem" placeholder="예: 전자제품" />
                    </div>
                </div>
                <div class="setup-row">
                    <div class="setup-field" style="flex:1;">
                        <label>우편번호</label>
                        <input type="text" @bind="_zipCode" maxlength="7" />
                    </div>
                    <div class="setup-field" style="flex:1;">
                        <label>법인등록번호</label>
                        <input type="text" @bind="_corpNo" placeholder="개인사업자는 비워두세요" maxlength="14" />
                    </div>
                </div>

                <button type="button" class="setup-submit" @onclick="BootstrapAsync" disabled="@_busy">
                    @(_busy ? "저장 중..." : "다음 단계 — 부모 계정 생성")
                </button>
                <button type="button" class="setup-back" @onclick="@(() => _step = 1)" disabled="@_busy">
                    이전 단계로
                </button>
            </div>
        }
        else if (_step == 3)
        {
            <div class="setup-section">
                <div class="setup-readonly">
                    <div class="setup-readonly-label">확인된 회사</div>
                    <div class="setup-readonly-value">@_companyName <span class="setup-tenant-code">(@_tenantCode)</span></div>
                </div>

                <p class="setup-info">
                    부모 계정은 ERP 마스터 계정입니다.<br/>
                    이 계정으로만 자식 계정(직원)을 만들 수 있습니다.
                </p>

                <div class="setup-field">
                    <label>대표 이름 *</label>
                    <input type="text" @bind="_parentName" required />
                </div>
                <div class="setup-field">
                    <label>로그인 아이디 *</label>
                    @* 사장님 결재 2026-07-06: 이메일 방식 → 아이디 방식. 내부 email 컬럼(uq_tenant_email)을
                       DDL 수술 없이 그대로 재사용하되, 화면·의미는 "아이디". type=text 로 이메일 형식 강제 제거. *@
                    <input type="text" @bind="_parentEmail" required placeholder="아이디 (예: hitpan_admin)" maxlength="100" />
                </div>
                <div class="setup-field">
                    <label>비밀번호 (8자 이상) *</label>
                    <input type="password" @bind="_parentPassword" required placeholder="영문+숫자+특수문자 권장" />
                </div>
                <div class="setup-field">
                    <label>비밀번호 확인 *</label>
                    <input type="password" @bind="_parentPasswordConfirm" required />
                </div>

                <button type="button" class="setup-submit" @onclick="CreateParentAsync" disabled="@_busy">
                    @(_busy ? "계정 생성 중..." : "부모 계정 생성")
                </button>
                <button type="button" class="setup-back" @onclick="@(() => _step = 2)" disabled="@_busy">
                    이전 단계로
                </button>
            </div>
        }
        else if (_step == 4)
        {
            <div class="setup-done">
                <div class="setup-done-icon">✓</div>
                <h2>설치가 완료되었습니다</h2>
                <p><b>@_companyName</b> ERP 설치와 부모 계정 생성이 모두 완료되었습니다.</p>
                <div class="setup-id">
                    <div class="setup-id-label">고객사 코드</div>
                    <div class="setup-id-value">@_tenantCode</div>
                </div>
                <div class="setup-id">
                    <div class="setup-id-label">로그인 아이디</div>
                    <div class="setup-id-value">@_parentEmail</div>
                </div>
                <p>아래 버튼을 눌러 로그인하시면 ERP를 사용할 수 있습니다.</p>
                <a href="/login" class="setup-go-login">로그인 화면으로 이동</a>
            </div>
        }
    </div>
</div>

@code {
    private int _step = 1;
    private bool _busy;
    private string? _error;

    // Step 1
    private string _licenseKey = "";
    private string _bizNo = "";

    // Step 1 통과 후
    private string _companyName = "";
    private string _tenantCode = "";
    // 헌법 #35 W2 (사장님 결재 2026-06-04) — 백오피스 발급 서명 토큰
    private string _bootstrapToken = "";

    // Step 2
    private string _ceoName = "";
    private string _tel = "";
    private string _email = "";
    private string _address = "";
    private string _bizType = "";
    private string _bizItem = "";
    private string _zipCode = "";
    private string _corpNo = "";

    // Step 3 (부모 계정)
    private string _parentName = "";
    private string _parentEmail = "";
    private string _parentPassword = "";
    private string _parentPasswordConfirm = "";

    private async Task VerifyAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_licenseKey))
        {
            _error = "라이선스 키를 입력해주세요.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_bizNo))
        {
            _error = "사업자번호를 입력해주세요.";
            return;
        }

        _busy = true;
        try
        {
            var http = Sp.GetRequiredKeyedService<HttpClient>("backoffice");
            var res = await http.PostAsJsonAsync("api/landing/license/claim",
                new { LicenseKey = _licenseKey, BizNo = _bizNo });
            var payload = await res.Content.ReadFromJsonAsync<ClaimResponse>();
            if (payload?.Valid == true)
            {
                _companyName = payload.CompanyName ?? "";
                _tenantCode = payload.TenantCode ?? "";
                _bootstrapToken = payload.BootstrapToken ?? "";
                _step = 2;
            }
            else
            {
                _error = payload?.Message ?? "라이선스 검증에 실패했습니다.";
            }
        }
        catch (Exception ex)
        {
            _error = $"검증 중 오류가 발생했습니다: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task BootstrapAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_ceoName))
        {
            _error = "대표자명은 필수입니다.";
            return;
        }

        _busy = true;
        try
        {
            var payload = new
            {
                BootstrapToken = _bootstrapToken,
                BizNo = _bizNo,
                CeoName = _ceoName,
                Tel = _tel,
                Email = _email,
                Address = _address,
                BizType = _bizType,
                BizItem = _bizItem,
                ZipCode = _zipCode,
                CorpNo = _corpNo
            };
            var res = await ErpApi.PostAsJsonAsync("api/setup/bootstrap", payload);
            var result = await res.Content.ReadFromJsonAsync<BootstrapResponse>();
            if (res.IsSuccessStatusCode && result?.Success == true)
            {
                // 부모계정 이메일 기본값 저장 (사용자가 수정 가능)
                _parentEmail = _email;
                _parentName = _ceoName;
                _step = 3;
                Snackbar.Add("회사 정보 자동 반영 완료. 부모 계정을 생성해주세요.", MudBlazor.Severity.Success);
            }
            else
            {
                _error = result?.Message ?? $"자동 반영 실패 ({(int)res.StatusCode})";
            }
        }
        catch (Exception ex)
        {
            _error = $"저장 중 오류가 발생했습니다: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CreateParentAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_parentName))
        {
            _error = "대표 이름을 입력해주세요.";
            return;
        }
        // 사장님 결재 2026-07-06: 아이디 방식 — 이메일 형식 강제 제거, 아이디 최소 규칙만.
        //   내부 email 컬럼(uq_tenant_email)을 재사용하므로 값은 _parentEmail 그대로 전송.
        var parentId = _parentEmail?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(parentId))
        {
            _error = "로그인 아이디를 입력해주세요.";
            return;
        }
        if (parentId.Length < 4)
        {
            _error = "로그인 아이디는 4자 이상이어야 합니다.";
            return;
        }
        if (parentId.Any(char.IsWhiteSpace))
        {
            _error = "로그인 아이디에는 공백을 사용할 수 없습니다.";
            return;
        }
        _parentEmail = parentId;
        if (string.IsNullOrWhiteSpace(_parentPassword) || _parentPassword.Length < 8)
        {
            _error = "비밀번호는 8자 이상이어야 합니다.";
            return;
        }
        if (_parentPassword != _parentPasswordConfirm)
        {
            _error = "비밀번호가 일치하지 않습니다.";
            return;
        }

        _busy = true;
        try
        {
            var payload = new
            {
                BootstrapToken = _bootstrapToken,
                Email = _parentEmail,
                Password = _parentPassword,
                Name = _parentName
            };
            var res = await ErpApi.PostAsJsonAsync("api/setup/create-parent", payload);
            var result = await res.Content.ReadFromJsonAsync<CreateParentResponse>();
            if (res.IsSuccessStatusCode && result?.Success == true)
            {
                _step = 4;
                Snackbar.Add("부모 계정이 생성되었습니다. 로그인하시면 ERP를 사용할 수 있습니다.", MudBlazor.Severity.Success);
            }
            else
            {
                _error = result?.Message ?? $"부모 계정 생성 실패 ({(int)res.StatusCode})";
            }
        }
        catch (Exception ex)
        {
            _error = $"생성 중 오류가 발생했습니다: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private class ClaimResponse
    {
        public bool Valid { get; set; }
        public string? CompanyName { get; set; }
        public string? TenantCode { get; set; }
        public string? Message { get; set; }
        // 헌법 #35 W2 — 백오피스 서명 토큰 (HMAC-SHA256, 10분 만료)
        public string? BootstrapToken { get; set; }
    }

    private class BootstrapResponse
    {
        public bool Success { get; set; }
        public string? Message { get; set; }
        public string? TenantCode { get; set; }
        public string? CompanyName { get; set; }
    }

    private class CreateParentResponse
    {
        public bool Success { get; set; }
        public string? Message { get; set; }
        public string? UserId { get; set; }
        public string? Email { get; set; }
        public string? TenantCode { get; set; }
    }
}

<style>
