@page "/partners/special-prices"
@attribute [Authorize]
@using HitPan.Web.Models
@using HitPan.Web.Services
@inject SpecialPriceService SpService
@inject IDialogService DialogService
@inject PartnerMasterService PartnersApi
@* 20260820작4 봉합 — 새 줄에서 품목을 고르려면 품목 목록이 필요하다(종전엔 이 화면에 아예 없었다). *@
@inject ItemMasterService ItemsApi
@inject ISnackbar Snackbar

<div class="sp-page">
    <MudPaper Elevation="0" Class="pa-3 mb-2" Style="border-bottom:1px solid #E5E7EB">
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="4">
                @* 봉합 (2026-06-22, 10차 P0-3): 자동완성을 PartnerListRow 객체에 바인딩한다.
                   기존에는 T="string"으로 거래처명을 받아 SelectedPartnerId에 거래처명을 대입 → 조회·저장 무동작.
                   품목측 ItemSpecialPricePage(객체 바인딩) 패턴과 동일하게 실제 PartnerId를 사용한다. *@
                <MudAutocomplete T="HitPan.Web.Models.PartnerListRow"
                                 Value="_selectedPartner"
                                 Label="거래처 선택"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Style="font-size:13px"
                                 SearchFunc="SearchPartner"
                                 ToStringFunc="@(p => p?.PartnerName ?? "")"
                                 ValueChanged="OnPartnerChanged"
                                 AdornmentIcon="@Icons.Material.Filled.Business" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTextField @bind-Value="FilterItem"
                              Label="품목 검색"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Style="font-size:13px"
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              OnKeyUp="FilterGrid" />
            </MudItem>
            <MudItem xs="6" sm="2">
                <MudCheckBox @bind-Value="ShowActiveOnly"
                             Label="거래품목만"
                             Style="font-size:13px"
                             Color="Color.Primary" />
            </MudItem>
            <MudItem xs="6" sm="3" Class="d-flex justify-end gap-2">
                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small"
                           Style="font-size:12px"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddRow">추가</MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Small"
                           Style="font-size:12px"
                           StartIcon="@Icons.Material.Filled.Save"
                           OnClick="SaveConfirm">저장</MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudDataGrid T="SpecialPriceItem"
                 Items="FilteredItems"
                 Dense="true"
                 Hover="true"
                 Striped="true"
                 FixedHeader="true"
                 Height="calc(100vh - 220px)"
                 Style="font-size:13px"
                 EditMode="DataGridEditMode.Cell"
                 RowStyleFunc="RowStyle">
        <Columns>
            @* 🔴 2026-08-20 20260820작4 봉합 — 사장님 실측: *"업체특별단가 입력 자체가 안됨"*.
                 [무엇이 났나] 품목명이 **읽기 전용 PropertyColumn** 이었다.
                   [추가] 버튼은 빈 줄을 만드는데(AddRow), 그 줄에 **품목을 고를 방법이 없었다.**
                   ItemId 가 빈 채로 남으니 저장해도 서버가 받을 수 없다 ⇒ **등록이 원천 불가.**
                   그래서 `partner_special_prices` 가 **0건**이었다(등록을 안 한 게 아니라 못 한 것).
                 [고침] 새 줄에서만 품목을 고를 수 있게 한다. 이미 등록된 줄은 **종전대로 글자만** —
                   품목을 바꾸면 다른 상품의 단가가 되어 버리므로 **바꾸게 두지 않는다**(지우고 다시 넣는다).
                 ⚠️ 이 칸을 다시 PropertyColumn 으로 되돌리지 마라. 등록 경로가 통째로 사라진다. *@
            <TemplateColumn Title="품목명" CellStyle="font-size:13px">
                <CellTemplate>
                    @if (string.IsNullOrEmpty(context.Item.Id))
                    {
                        <MudAutocomplete T="string"
                                         Value="context.Item.ItemName"
                                         ValueChanged="@(v => OnItemPicked(context.Item, v))"
                                         SearchFunc="SearchItemAsync"
                                         Variant="Variant.Text"
                                         Margin="Margin.Dense"
                                         Dense="true"
                                         Placeholder="품목 검색"
                                         Style="font-size:13px" />
                    }
                    else
                    {
                        @context.Item.ItemName
                    }
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.Spec"
                            Title="규격"
                            CellStyle="font-size:13px" />
            <PropertyColumn Property="x => x.Unit"
                            Title="단위"
                            CellStyle="width:60px;text-align:center" />
            <PropertyColumn Property="x => x.StdPrice"
                            Title="표준단가"
                            Format="N0"
                            CellStyle="width:110px;text-align:right;color:#6B7280" />
            @* 봉합 (2026-06-23, 19차): 상품 특별단가와 대칭 — 단가유형(고정/할인) + 할인율 컬럼.
               종전엔 특별단가(고정) 한 가지만 입력 가능해 할인율 모드가 화면에서 통째 빠져 있었다. *@
            <TemplateColumn Title="단가유형" CellStyle="width:100px">
                <CellTemplate>
                    <MudSelect T="string" @bind-Value="context.Item.PriceType" Variant="Variant.Text"
                               Margin="Margin.Dense" Dense="true" Style="font-size:13px">
                        <MudSelectItem Value="@("fixed")">고정</MudSelectItem>
                        <MudSelectItem Value="@("discount")">할인</MudSelectItem>
                    </MudSelect>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="특별단가" CellStyle="width:120px;text-align:right">
                <CellTemplate>
                    @if (context.Item.PriceType == "discount")
                    {
                        <MudText Typo="Typo.body2" Style="color:#9CA3AF">@CalcDiscountedPrice(context.Item).ToString("N0")</MudText>
                    }
                    else
                    {
                        <MudNumericField T="decimal" @bind-Value="context.Item.SpecialPrice" Variant="Variant.Text"
                                         Margin="Margin.Dense" Style="font-size:13px;text-align:right" />
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="할인율(%)" CellStyle="width:100px;text-align:right">
                <CellTemplate>
                    @if (context.Item.PriceType == "discount")
                    {
                        <MudNumericField T="decimal?" @bind-Value="context.Item.DiscountRate" Variant="Variant.Text"
                                         Margin="Margin.Dense" Min="0" Max="100" Format="N1"
                                         Style="font-size:13px;text-align:right" />
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Style="color:#9CA3AF">—</MudText>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="대비%"
                            CellStyle="width:80px;text-align:center">
                <CellTemplate>
                    <MudChip T="string"
                             Size="Size.Small"
                             Color="@GetRatioColor(context.Item.VsRatio)"
                             Style="font-size:11px">
                        @context.Item.VsRatioLabel
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.LastSupplyDate"
                            Title="최종납품"
                            Format="yyyy-MM-dd"
                            CellStyle="width:100px" />
            <TemplateColumn CellStyle="width:50px;text-align:center">
                <CellTemplate>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Size="Size.Small"
                                   Color="Color.Error"
                                   OnClick="@(() => DeleteConfirm(context.Item))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
</div>

@code {
    private string SelectedPartnerId = string.Empty;
    private string SelectedPartnerName = string.Empty;
    // 봉합 (2026-06-22, 10차 P0-3): 선택된 거래처 객체. 실제 PartnerId를 보관한다.
    private HitPan.Web.Models.PartnerListRow? _selectedPartner;
    private string FilterItem = string.Empty;
    private bool ShowActiveOnly = true;
    private List<SpecialPriceItem> Items = new();

    private List<SpecialPriceItem> FilteredItems =>
        Items.Where(x =>
            (!ShowActiveOnly || x.IsActive) &&
            (string.IsNullOrEmpty(FilterItem) ||
             x.ItemName.Contains(FilterItem, StringComparison.OrdinalIgnoreCase) ||
             (x.Spec ?? string.Empty).Contains(FilterItem, StringComparison.OrdinalIgnoreCase)))
            .ToList();

    // 봉합 (2026-06-22, 10차 P0-3): 거래처명이 아닌 실제 PartnerId를 SelectedPartnerId에 넣는다.
    // 기존에는 SelectedPartnerId = name(거래처명)이라 조회·저장 API가 무동작했다.
    private async Task OnPartnerChanged(HitPan.Web.Models.PartnerListRow? partner)
    {
        _selectedPartner = partner;
        SelectedPartnerName = partner?.PartnerName ?? string.Empty;
        SelectedPartnerId = partner?.PartnerId ?? string.Empty;
        if (!string.IsNullOrEmpty(SelectedPartnerId))
        {
            Items = await SpService.GetAsync(SelectedPartnerId);
        }
        else
        {
            Items = new();
        }
    }

    private async Task SaveConfirm()
    {
        var result = await DialogService.ShowMessageBoxAsync(
            "저장 확인",
            "변경된 특별단가를 저장하시겠습니까?",
            yesText: "저장",
            cancelText: "취소");
        if (result != true)
        {
            return;
        }

        // 🔴 품목을 안 고른 줄은 보내지 않는다 — 서버가 받을 수 없다(ItemId 가 열쇠다).
        //   ⚠️ 조용히 거르면 *"저장했는데 없다"* 가 되므로 **몇 줄을 건너뛰었는지 말해 준다.**
        var ready = Items.Where(x => !string.IsNullOrWhiteSpace(x.ItemId)).ToList();
        var skipped = Items.Count - ready.Count;
        if (ready.Count == 0)
        {
            Snackbar.Add("품목을 선택한 줄이 없습니다.", Severity.Warning);
            return;
        }

        foreach (var item in ready)
        {
            await SpService.SaveAsync(SelectedPartnerId, new SpecialPriceUpsertDto
            {
                ItemId = item.ItemId,
                Spec = item.Spec,
                Unit = item.Unit,
                SpecialPrice = item.SpecialPrice,
                StdPrice = item.StdPrice,
                // 봉합 (2026-06-23, 19차): 단가유형·할인율 함께 전송 — 종전엔 빠져 할인율 모드가 유실됐다.
                PriceType = item.PriceType,
                DiscountRate = item.DiscountRate,
                LastSupplyDate = item.LastSupplyDate
            });
        }

        Items = await SpService.GetAsync(SelectedPartnerId);

        Snackbar.Add(
            skipped > 0
                ? $"{ready.Count}건 저장했습니다. 품목을 안 고른 {skipped}건은 저장하지 않았습니다."
                : $"{ready.Count}건 저장했습니다.",
            skipped > 0 ? Severity.Warning : Severity.Success);
    }

    private async Task DeleteConfirm(SpecialPriceItem item)
    {
        var result = await DialogService.ShowMessageBoxAsync(
            "삭제 확인",
            $"{item.ItemName}의 특별단가를 삭제하시겠습니까?",
            yesText: "삭제",
            cancelText: "취소");
        if (result != true)
        {
            return;
        }

        await SpService.DeleteAsync(SelectedPartnerId, item.ItemId);
        Items = await SpService.GetAsync(SelectedPartnerId);
    }

    private void AddRow()
    {
        // ⚠️ 업체를 먼저 골라야 한다 — 안 고르면 어느 업체 단가인지 정할 수 없다.
        if (string.IsNullOrWhiteSpace(SelectedPartnerId))
        {
            Snackbar.Add("업체를 먼저 선택하세요.", Severity.Warning);
            return;
        }

        Items.Add(new SpecialPriceItem
        {
            PartnerId = SelectedPartnerId,
            IsEditing = true
        });
    }

    /// <summary>품목 목록 — 새 줄에서 고르기 위해 한 번만 읽는다.</summary>
    private List<ItemListModel>? _itemCache;

    private async Task<IEnumerable<string>> SearchItemAsync(string value, CancellationToken ct)
    {
        _itemCache ??= await ItemsApi.GetListAsync() ?? new();
        var names = _itemCache.Select(i => i.ItemName).Distinct();
        return string.IsNullOrWhiteSpace(value)
            ? names
            : names.Where(n => n.Contains(value, StringComparison.OrdinalIgnoreCase));
    }

    /// <summary>
    /// 새 줄에서 품목을 고르면 <b>ItemId·규격·단위·표준단가</b>를 함께 채운다.
    /// </summary>
    /// <remarks>
    /// 🔴 <c>ItemId</c> 가 이 화면의 급소다. 이름만 넣고 <c>ItemId</c> 를 비워 두면
    /// 저장은 눌러지는데 <b>서버가 받을 수 없다</b> — 그것이 이번 사고의 모양이었다.
    /// ⚠️ 표준단가를 함께 채우는 이유: 할인율 모드가 <b>표준단가를 밑값으로</b> 계산하기 때문이다
    /// (<c>CalcDiscountedPrice</c>). 비어 있으면 할인율을 넣어도 계산이 0 이 된다.
    /// </remarks>
    private void OnItemPicked(SpecialPriceItem row, string itemName)
    {
        row.ItemName = itemName;
        var item = _itemCache?.FirstOrDefault(i => i.ItemName == itemName);
        if (item is null) return;

        row.ItemId = item.ItemId;
        row.Spec = item.Spec;
        row.Unit = item.Unit;
        row.StdPrice = item.StandardPrice > 0 ? item.StandardPrice : item.SalePrice;
    }

    /// <summary>할인율 모드 미리보기 — 표준단가 × (1 - 할인율%). (19차 봉합)</summary>
    private decimal CalcDiscountedPrice(SpecialPriceItem row)
    {
        if (row.DiscountRate is null || row.StdPrice <= 0m) return 0m;
        var rate = Math.Clamp(row.DiscountRate.Value, 0m, 100m);
        return Math.Round(row.StdPrice * (100m - rate) / 100m, 0, MidpointRounding.AwayFromZero);
    }

    private Color GetRatioColor(decimal ratio)
    {
        if (ratio < 100m) return Color.Success;
        if (ratio > 100m) return Color.Error;
        return Color.Default;
    }

    private string RowStyle(SpecialPriceItem item, int index)
        => "height:36px;font-size:13px;";

    // P0 #4 — 거래처 자동완성 (PartnerMasterService 캐시 활용)
    // 봉합 (2026-06-22, 10차 P0-3): PartnerListRow 객체를 반환한다(기존 string 반환 → PartnerId 유실 원인).
    private List<HitPan.Web.Models.PartnerListRow>? _partnerCache;
    private async Task<IEnumerable<HitPan.Web.Models.PartnerListRow>> SearchPartner(string value, CancellationToken ct)
    {
        _partnerCache ??= await PartnersApi.GetListAsync(ct: ct) ?? new();
        if (string.IsNullOrWhiteSpace(value))
            return _partnerCache.Take(20);
        return _partnerCache
            .Where(p => p.PartnerName.Contains(value, StringComparison.OrdinalIgnoreCase))
            .Take(20);
    }

    private void FilterGrid(KeyboardEventArgs e)
    {
        StateHasChanged();
    }
}
