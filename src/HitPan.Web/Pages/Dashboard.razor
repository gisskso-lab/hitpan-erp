@page "/"
@page "/dashboard"
@namespace HitPan.Web.Pages
@attribute [Authorize]
@using System.Net.Http.Json
@using HitPan.Web.Helpers
@using HitPan.Web.Services
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject PermissionService PermSvc
@inject PartnerMasterService PartnerSvc
@inject AuthenticationStateProvider AuthState
@inject BomService BomApi
@inject IDialogService DialogService

<PageTitle>대시보드 — 히트판 ERP</PageTitle>

@* 권한 설정 안내 배너 — 어드민 첫 진입 시 권한 미설정 상태 유도 *@
@if (_showPermissionBanner)
{
    @* 권한 설정 안내 — Warning(주황)으로 주의 환기, 보라색 혼동 방지 *@
    <MudAlert Severity="Severity.Warning" Class="mb-3" Elevation="0" Dense="true">
        <div class="d-flex align-center justify-space-between" style="gap:16px;flex-wrap:wrap">
            <div>
                <MudText Typo="Typo.body2" Style="font-weight:600">🔐 권한 설정이 필요합니다</MudText>
                <MudText Typo="Typo.caption" Style="color:var(--hitpan-text-muted)">
                    직원별 메뉴 접근 권한이 아직 설정되지 않았습니다. 먼저 지정해주세요.
                </MudText>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                EndIcon="@Icons.Material.Filled.ArrowForward"
                OnClick="@(() => Nav.NavigateTo("/users/permissions"))">
                권한 설정
            </MudButton>
        </div>
    </MudAlert>
}

@* 페이지 헤더 — 디자인 시스템 v1 *@
<PageHeader Title="대시보드" Subtitle="@(DateTime.Now.ToString("yyyy-MM-dd (ddd)"))" />

@* KPI 카드 영역 — KpiCard 공용 컴포넌트.
   사장님 헌법 (2026-04-27): "대시보드 시각화 클릭 = 해당 데이터/전표로 바로 연동". *@
<MudGrid Spacing="2" Class="mb-3">
    <MudItem xs="12" sm="6" md="2" lg="2">
        <KpiCard Color="KpiCard.KpiColor.Primary"
                 Icon="@Icons.Material.Filled.PointOfSale"
                 Label="오늘 매출"
                 Value="@FormatAmount(_data.TodaySales)"
                 OnClick="@(() => Nav.NavigateTo($"/deliveries?from={DateTime.Today:yyyy-MM-dd}&to={DateTime.Today:yyyy-MM-dd}"))" />
    </MudItem>
    <MudItem xs="12" sm="6" md="2" lg="2">
        <KpiCard Color="KpiCard.KpiColor.Info"
                 Icon="@Icons.Material.Filled.TrendingUp"
                 Label="이번달 매출"
                 Value="@FormatAmount(_data.MonthSales)"
                 OnClick="@(() => Nav.NavigateTo($"/deliveries?from={MonthStart():yyyy-MM-dd}&to={DateTime.Today:yyyy-MM-dd}"))" />
    </MudItem>
    <MudItem xs="12" sm="6" md="2" lg="2">
        <KpiCard Color="KpiCard.KpiColor.Warning"
                 Icon="@Icons.Material.Filled.ShoppingCart"
                 Label="이번달 매입"
                 Value="@FormatAmount(_data.MonthPurchase)"
                 OnClick="@(() => Nav.NavigateTo($"/purchases?from={MonthStart():yyyy-MM-dd}&to={DateTime.Today:yyyy-MM-dd}"))" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3" lg="3">
        <KpiCard Color="KpiCard.KpiColor.Error"
                 Icon="@Icons.Material.Filled.Warning"
                 Label="미수금"
                 Value="@FormatAmount(_data.UnpaidReceivable)"
                 EmphasizeValue="true"
                 OnClick="@(() => Nav.NavigateTo("/partners/ledger"))" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3" lg="3">
        <KpiCard Color="KpiCard.KpiColor.Purple"
                 Icon="@Icons.Material.Filled.PendingActions"
                 Label="결재대기"
                 Value="@($"{_data.PendingApprovalCount}건")"
                 EmphasizeValue="true"
                 OnClick="@(() => Nav.NavigateTo("/approval/pending"))" />
    </MudItem>
</MudGrid>

@* 차트 영역 *@
<MudGrid Spacing="2" Class="mb-3">
    @* 월별 매출·매입 추이 *@
    <MudItem xs="12" md="8">
        <MudPaper Elevation="0" Class="pa-3" Style="border:0.5px solid var(--mud-palette-lines-default);border-radius:12px;height:280px">
            <MudText Typo="Typo.subtitle2" Class="mb-2" Style="font-weight:600">월별 매출·매입 추이</MudText>
            @if (_data.MonthlyTrend.Any())
            {
                <ApexChart TItem="MonthlyTrend"
                           Options="@_chartOptions"
                           Height="220">
                    <ApexPointSeries TItem="MonthlyTrend"
                                     Items="_data.MonthlyTrend"
                                     Name="매출"
                                     SeriesType="SeriesType.Bar"
                                     XValue="@(e => e.Label)"
                                     YValue="@(e => e.SalesAmount)" />
                    <ApexPointSeries TItem="MonthlyTrend"
                                     Items="_data.MonthlyTrend"
                                     Name="매입"
                                     SeriesType="SeriesType.Bar"
                                     XValue="@(e => e.Label)"
                                     YValue="@(e => e.PurchaseAmount)" />
                </ApexChart>
            }
            else
            {
                <div class="d-flex align-center justify-center" style="height:200px">
                    <MudText Color="Color.Secondary" Typo="Typo.body2">데이터가 없습니다</MudText>
                </div>
            }
        </MudPaper>
    </MudItem>

    @* 거래처 TOP 5 *@
    <MudItem xs="12" md="4">
        <MudPaper Elevation="0" Class="pa-3" Style="border:0.5px solid var(--mud-palette-lines-default);border-radius:12px;height:280px">
            <MudText Typo="Typo.subtitle2" Class="mb-2" Style="font-weight:600">거래처 TOP 5</MudText>
            @if (_data.TopPartners.Any())
            {
                <ApexChart TItem="PartnerRank"
                           Options="@_partnerChartOptions"
                           Height="220">
                    <ApexPointSeries TItem="PartnerRank"
                                     Items="_data.TopPartners"
                                     Name="거래금액"
                                     SeriesType="SeriesType.Bar"
                                     XValue="@(e => e.PartnerName)"
                                     YValue="@(e => e.TotalAmount)" />
                </ApexChart>
            }
            else
            {
                <div class="d-flex align-center justify-center" style="height:200px">
                    <MudText Color="Color.Secondary" Typo="Typo.body2">데이터가 없습니다</MudText>
                </div>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@* AR Aging 연체 Top 5 — 대표이사 자금 관리용 *@
<MudPaper Elevation="0" Class="pa-3 mb-3" Style="border:0.5px solid var(--mud-palette-lines-default);border-radius:12px">
    <div class="d-flex justify-space-between align-center mb-2">
        <MudText Typo="Typo.subtitle2" Style="font-weight:600">외상·연체 Top 5</MudText>
        <MudButton Size="Size.Small" Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ArrowForward"
                   OnClick="@(() => Nav.NavigateTo("/partners"))">전체 보기</MudButton>
    </div>
    @if (_aging is not null && _aging.Count > 0)
    {
        <MudSimpleTable Dense="true" Hover="true" Style="border:none">
            <thead>
                <tr>
                    <th>거래처</th>
                    <th style="text-align:right">미수금</th>
                    <th style="text-align:right">0~30일</th>
                    <th style="text-align:right">31~60일</th>
                    <th style="text-align:right">61~90일</th>
                    <th style="text-align:right">90일+</th>
                    <th style="text-align:center">연체</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in _aging.Take(5))
                {
                    <tr style="cursor:pointer" @onclick="@(() => Nav.NavigateTo($"/partners/{a.PartnerId}"))">
                        <td style="font-weight:500">@a.PartnerName</td>
                        <td style="text-align:right;font-weight:600">@a.TotalUnpaid.ToString("N0")</td>
                        <td style="text-align:right">@a.Bucket0_30.ToString("N0")</td>
                        <td style="text-align:right">@a.Bucket31_60.ToString("N0")</td>
                        <td style="text-align:right">@a.Bucket61_90.ToString("N0")</td>
                        <td style="text-align:right;color:var(--hitpan-aging-90);font-weight:600">@a.Bucket90Plus.ToString("N0")</td>
                        <td style="text-align:center">
                            <PartnerAgingBadge DaysOverdue="@MaxOverdueDays(a)" />
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
    else
    {
        <div class="d-flex flex-column align-center justify-center" style="height:80px">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline" Color="Color.Success" Size="Size.Large" />
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">미수금 없음 — 자금 건전</MudText>
        </div>
    }
</MudPaper>

@* 하단 영역: 최근 거래 + 재고 부족 *@
<MudGrid Spacing="2">
    @* 최근 거래 *@
    <MudItem xs="12" md="7">
        <MudPaper Elevation="0" Class="pa-3" Style="border:0.5px solid var(--mud-palette-lines-default);border-radius:12px">
            <MudText Typo="Typo.subtitle2" Class="mb-2" Style="font-weight:600">최근 거래</MudText>
            <MudTable T="RecentTx" Items="_data.RecentTransactions" Dense="true" Hover="true" Elevation="0"
                      Style="border:none" FixedHeader="false"
                      OnRowClick="@((TableRowClickEventArgs<RecentTx> e) => { if (e.Item is not null) GoToTransaction(e.Item); })"
                      RowStyle="cursor:pointer">
                <HeaderContent>
                    <MudTh>일자</MudTh>
                    <MudTh>유형</MudTh>
                    <MudTh>문서번호</MudTh>
                    <MudTh>거래처</MudTh>
                    <MudTh Style="text-align:right">금액</MudTh>
                    <MudTh>상태</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.TxDate.ToString("MM-dd")</MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                 Color="@GetDocTypeColor(context.DocType)">@context.DocType</MudChip>
                    </MudTd>
                    <MudTd>@context.DocNo</MudTd>
                    <MudTd>@context.PartnerName</MudTd>
                    <MudTd Style="text-align:right;font-weight:500">@FormatAmount(context.Amount)</MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                 Color="@GetStatusColor(context.Status)">@HitPan.Web.Helpers.StatusLabel.Document(context.Status)</MudChip>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">거래 내역이 없습니다</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudItem>

    @* 재고 부족 알림 — 사장님 헌법 (2026-04-27): 안전재고 미달 = 평소 안전망. 대시보드에서 바로 발주. *@
    <MudItem xs="12" md="5">
        <MudPaper Elevation="0" Class="pa-3" Style="border:0.5px solid var(--mud-palette-lines-default);border-radius:12px">
            <div class="d-flex justify-space-between align-center mb-2">
                <MudText Typo="Typo.subtitle2" Style="font-weight:600">재고 부족 알림</MudText>
                <div class="d-flex align-center" style="gap:8px">
                    @if (_pendingAlerts.Count > 0)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.ShoppingCart"
                                   OnClick="OpenDashboardAutoOrderAsync"
                                   Disabled="_orderingDashboard">
                            @(_orderingDashboard ? "처리중..." : $"자동발주 ({_pendingAlerts.Count})")
                        </MudButton>
                    }
                    @if (_pendingAlerts.Any())
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">
                            @(_pendingAlerts.Count)건
                        </MudChip>
                    }
                </div>
            </div>
            @* 사장님 지적 (2026-04-27): 재고 부족 표시와 자동발주 카운트는 단일 소스(_pendingAlerts).
               두 소스가 어긋나면 "재고 부족 없음 + 자동발주 3건" 같은 모순 발생. *@
            @if (_pendingAlerts.Any())
            {
                <MudSimpleTable Dense="true" Hover="true" Style="border:none">
                    <thead>
                        <tr>
                            <th>자재명</th>
                            <th style="text-align:right">현재고</th>
                            <th style="text-align:right">안전재고</th>
                            <th style="text-align:right">부족</th>
                            <th>발주처</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in _pendingAlerts)
                        {
                            <tr style="color:var(--hitpan-error);font-weight:500;cursor:pointer"
                                @onclick="@(() => Nav.NavigateTo($"/items/{a.ItemId}"))">
                                <td>@a.ItemName</td>
                                <td style="text-align:right">@a.CurrentQty.ToString("N0")</td>
                                <td style="text-align:right">@a.SafetyQty.ToString("N0")</td>
                                <td style="text-align:right">@a.ShortageQty.ToString("N0")</td>
                                <td>@(string.IsNullOrWhiteSpace(a.PartnerName) ? "(미설정)" : a.PartnerName)</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
            else
            {
                <div class="d-flex flex-column align-center justify-center" style="height:100px">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline" Color="Color.Success" Size="Size.Large" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">재고 부족 품목 없음</MudText>
                </div>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    // ─── 데이터 모델 ───
    private DashboardData _data = new();
    private List<PartnerAgingRow> _aging = new();
    private bool _showPermissionBanner = false;

    private static int MaxOverdueDays(PartnerAgingRow a)
    {
        if (a.Bucket90Plus > 0) return 120;
        if (a.Bucket61_90 > 0)  return 75;
        if (a.Bucket31_60 > 0)  return 45;
        return 15;
    }

    // ─── 차트 옵션: 월별 추이 ───
    private ApexChartOptions<MonthlyTrend> _chartOptions = new()
    {
        Chart = new Chart { Toolbar = new Toolbar { Show = false } },
        PlotOptions = new PlotOptions
        {
            Bar = new PlotOptionsBar { ColumnWidth = "60%" }
        },
        Yaxis = new List<YAxis>
        {
            new()
            {
                Labels = new YAxisLabels
                {
                    Formatter = @"function(val) { return val >= 10000 ? (val/10000).toFixed(0) + '만' : val.toLocaleString() }"
                }
            }
        },
        Colors = new List<string> { "#0F6E56", "#F57C00" },
        Legend = new Legend { Position = LegendPosition.Top }
    };

    // ─── 차트 옵션: 거래처 TOP5 (가로 막대) ───
    private ApexChartOptions<PartnerRank> _partnerChartOptions = new()
    {
        Chart = new Chart { Toolbar = new Toolbar { Show = false } },
        PlotOptions = new PlotOptions
        {
            Bar = new PlotOptionsBar { Horizontal = true, BarHeight = "60%" }
        },
        Yaxis = new List<YAxis>
        {
            new()
            {
                Labels = new YAxisLabels
                {
                    Formatter = @"function(val) { return val >= 10000 ? (val/10000).toFixed(0) + '만' : val.toLocaleString() }"
                }
            }
        },
        Colors = new List<string> { "#0F6E56" },
        Legend = new Legend { Show = false }
    };

    // 사장님 헌법 (2026-04-27): 대시보드 = 평소 안전망. stock_alerts 'pending' 자동 발주 트리거.
    private List<StockAlertModel> _pendingAlerts = new();
    private bool _orderingDashboard = false;

    // ─── 초기 로드 ───
    protected override async Task OnInitializedAsync()
    {
        await CheckPermissionBannerAsync();
        await Task.WhenAll(LoadDashboardAsync(), LoadAgingAsync(), LoadPendingAlertsAsync());
    }

    private async Task LoadPendingAlertsAsync()
    {
        var alerts = await BomApi.GetAlertsAsync();
        _pendingAlerts = (alerts ?? new List<StockAlertModel>())
            .Where(a => string.Equals(a.Status, "pending", StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private async Task OpenDashboardAutoOrderAsync()
    {
        if (_pendingAlerts.Count == 0) return;

        var lines = string.Join("\n", _pendingAlerts.Take(5).Select(a =>
            $"• {a.ItemName} (현재고 {a.CurrentQty:N0} / 안전재고 {a.SafetyQty:N0}, 부족 {a.ShortageQty:N0})"));
        var more = _pendingAlerts.Count > 5 ? $"\n... 외 {_pendingAlerts.Count - 5}건" : "";

        var go = await DialogService.ShowMessageBoxAsync(
            "⚠ 안전재고 미달 자동발주",
            $"아래 자재가 안전재고 미달입니다. 자동발주서를 생성하시겠습니까?\n\n{lines}{more}\n\n" +
            "발주서 생성 후 [발주목록 → 매입처리 → 매입확정] 단계로 진행해주세요.",
            yesText: "자동발주 실행", cancelText: "취소");
        if (go != true) return;

        _orderingDashboard = true;
        StateHasChanged();
        try
        {
            var success = 0;
            var failed = 0;
            foreach (var a in _pendingAlerts)
            {
                if (string.IsNullOrWhiteSpace(a.AlertId)) continue;
                var ok = await BomApi.OrderAlertAsync(a.AlertId);
                if (ok) success++; else failed++;
            }

            if (success > 0)
                Snackbar.Add($"자동발주서 {success}건 생성 완료. 발주목록 → 매입처리 → 매입확정 진행해주세요.", Severity.Success);
            if (failed > 0)
                Snackbar.Add($"{failed}건 실패", Severity.Warning);

            await LoadPendingAlertsAsync();
        }
        finally
        {
            _orderingDashboard = false;
            StateHasChanged();
        }
    }

    // 사장님 헌법 (2026-04-27): 시각화 클릭 → 데이터/전표 연동.
    private static DateTime MonthStart() => new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);

    private void GoToTransaction(RecentTx tx)
    {
        // RecentTx.DocType: "매입" / "판매" / "매입반품" / "판매반품" / 그 외 (한글 라벨).
        // 라우팅 — 해당 목록 페이지에 거래일자 필터로 이동, 사용자가 그 행을 보고 더블클릭하면 상세.
        var dateStr = tx.TxDate.ToString("yyyy-MM-dd");
        if (tx.DocType.Contains("매입"))
        {
            Nav.NavigateTo($"/purchases?from={dateStr}&to={dateStr}");
        }
        else
        {
            Nav.NavigateTo($"/deliveries?from={dateStr}&to={dateStr}");
        }
    }

    private async Task LoadAgingAsync()
    {
        try
        {
            var rows = await PartnerSvc.GetAgingAsync();
            _aging = rows
                .Where(x => x.TotalUnpaid > 0)
                .OrderByDescending(x => x.Bucket90Plus)
                .ThenByDescending(x => x.TotalUnpaid)
                .ToList();
        }
        catch { _aging = new(); }
    }

    /// <summary>어드민이 권한 미설정 상태면 상단 배너 노출</summary>
    private async Task CheckPermissionBannerAsync()
    {
        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            if (AccountTypeHelper.GetAccountType(state.User) != AccountTypeHelper.TenantAdmin)
                return;

            var perms = await PermSvc.GetAllAsync();
            if (perms == null || perms.Count == 0) { _showPermissionBanner = true; return; }

            // 누구도 단 하나라도 권한을 받지 않은 상태면 배너 표시
            var anyConfigured = perms.Any(u => u.Permissions
                .Any(p => p.CanView || p.CanCreate || p.CanUpdate || p.CanDelete || p.CanExport));
            _showPermissionBanner = !anyConfigured;
        }
        catch
        {
            _showPermissionBanner = false; // 조회 실패 시 배너 숨김 (보수적)
        }
    }

    /// <summary>대시보드 데이터 로드</summary>
    private async Task LoadDashboardAsync()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<DashboardData>("/api/finance/dashboard");
            if (result != null)
            {
                _data = result;
            }
        }
        catch (HttpRequestException)
        {
            // API 미구현 시 샘플 데이터로 폴백
            _data = GetSampleData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"대시보드 로드 실패: {ex.Message}", Severity.Error);
            _data = GetSampleData();
        }
    }

    /// <summary>금액 포맷: ₩ + 만원 단위 변환</summary>
    private string FormatAmount(decimal amount)
    {
        if (Math.Abs(amount) >= 100_000_000m) // 1억 이상
            return $"₩{(amount / 100_000_000m):N1}억";
        if (Math.Abs(amount) >= 10_000m) // 1만 이상
            return $"₩{(amount / 10_000m):N0}만";
        return $"₩{amount:N0}";
    }

    /// <summary>문서유형별 색상</summary>
    private Color GetDocTypeColor(string docType) => docType switch
    {
        "매출" or "판매" => Color.Success,
        "매입" => Color.Warning,
        "견적" => Color.Info,
        "발주" => Color.Secondary,
        _ => Color.Default
    };

    /// <summary>상태별 색상</summary>
    private Color GetStatusColor(string status) => status switch
    {
        "완료" or "확정" => Color.Success,
        "대기" or "진행" => Color.Info,
        "취소" => Color.Error,
        _ => Color.Default
    };

