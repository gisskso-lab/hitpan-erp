@page "/hr/leave-status"
@namespace HitPan.Web.Pages.HrUi
@attribute [Authorize]
@using HitPan.Web.Models
@using HitPan.Web.Services
@inject LeaveRequestService LeaveSvc

<PageTitle>연차 현황</PageTitle>
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
    <MudText Typo="Typo.h6">연차 현황</MudText>
</div>

@* 상태별 건수 요약 — 신청·승인·반려·대기 한눈에 *@
<MudGrid Spacing="2" Class="mb-3">
    <MudItem xs="6" md="3">
        <MudPaper Elevation="0" Class="pa-3 hitpan-card text-center">
            <MudText Typo="Typo.caption" Color="Color.Secondary">전체</MudText>
            <MudText Typo="Typo.h6">@_items.Count 건</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" md="3">
        <MudPaper Elevation="0" Class="pa-3 hitpan-card text-center">
            <MudText Typo="Typo.caption" Color="Color.Secondary">대기</MudText>
            <MudText Typo="Typo.h6" Color="Color.Warning">@_pendingCount 건</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" md="3">
        <MudPaper Elevation="0" Class="pa-3 hitpan-card text-center">
            <MudText Typo="Typo.caption" Color="Color.Secondary">승인</MudText>
            <MudText Typo="Typo.h6" Color="Color.Success">@_approvedCount 건</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" md="3">
        <MudPaper Elevation="0" Class="pa-3 hitpan-card text-center">
            <MudText Typo="Typo.caption" Color="Color.Secondary">반려</MudText>
            <MudText Typo="Typo.h6" Color="Color.Error">@_rejectedCount 건</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudPaper Elevation="0" Class="pa-2 hitpan-card">
    <MudTable Items="_items" Dense="true" Hover="true" Striped="true" Loading="_loading">
        <HeaderContent>
            <MudTh>사원</MudTh>
            <MudTh>유형</MudTh>
            <MudTh Style="text-align:right">일수</MudTh>
            <MudTh>시작일</MudTh>
            <MudTh>종료일</MudTh>
            <MudTh Style="text-align:center">상태</MudTh>
            <MudTh>사유</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="사원">@context.EmployeeName</MudTd>
            <MudTd DataLabel="유형">@(context.LeaveType == "annual" ? "연차" : context.LeaveType)</MudTd>
            <MudTd DataLabel="일수" Style="text-align:right">@context.LeaveDays.ToString("0.#")일</MudTd>
            <MudTd DataLabel="시작일">@context.StartDate.ToString("yyyy-MM-dd")</MudTd>
            <MudTd DataLabel="종료일">@context.EndDate.ToString("yyyy-MM-dd")</MudTd>
            <MudTd DataLabel="상태" Style="text-align:center">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                         Color="@(context.Status == "approved" ? Color.Success : context.Status == "rejected" ? Color.Error : Color.Warning)">
                    @(context.Status switch { "approved" => "승인", "rejected" => "반려", _ => "대기" })
                </MudChip>
            </MudTd>
            <MudTd DataLabel="사유">@(context.Status == "rejected" && !string.IsNullOrWhiteSpace(context.RejectReason) ? context.RejectReason : context.Reason)</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-4">신청된 연차가 없습니다.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private List<LeaveRequestModel> _items = new();
    private bool _loading = true;

    private int _pendingCount;
    private int _approvedCount;
    private int _rejectedCount;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _items = await LeaveSvc.GetListAsync();
        }
        catch (Exception ex)
        {
            // 로드 실패 시 빈 목록으로 — 화면 크래시 방지 (헌법 #15)
            Console.Error.WriteLine($"[HrLeaveStatusPage] {ex.GetType().Name}: {ex.Message}");
            _items = new();
        }
        finally
        {
            _pendingCount = _items.Count(x => x.Status == "pending");
            _approvedCount = _items.Count(x => x.Status == "approved");
            _rejectedCount = _items.Count(x => x.Status == "rejected");
            _loading = false;
        }
    }
}
