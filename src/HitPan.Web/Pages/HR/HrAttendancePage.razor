@page "/hr/attendance"
@namespace HitPan.Web.Pages.HrUi
@attribute [Authorize]
@using HitPan.Web.Models
@using HitPan.Web.Services
@inject HrClientService HrSvc
@inject ISnackbar Snackbar

<PageTitle>근태 관리</PageTitle>
<PageHeader Title="근태 관리" Subtitle="출근·퇴근 기록 및 이력">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Login" OnClick="CheckInAsync">출근</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Logout" OnClick="CheckOutAsync">퇴근</MudButton>
    </Actions>
</PageHeader>

@* 필터 *@
<MudPaper Class="pa-3 mb-3" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default);border-radius:12px">
    <MudGrid Spacing="2" Class="align-center">
        <MudItem xs="6" md="2"><MudDatePicker Label="시작일" @bind-Date="_from" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:160px" /></MudItem>
        <MudItem xs="6" md="2"><MudDatePicker Label="종료일" @bind-Date="_to" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:160px" /></MudItem>
        <MudItem xs="12" md="2"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadAsync">조회</MudButton></MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Elevation="0" Class="pa-2 hitpan-card">
    <MudTable Items="_items" Dense="true" Hover="true" Striped="true">
        <HeaderContent>
            <MudTh>날짜</MudTh><MudTh>사원</MudTh><MudTh>출근</MudTh><MudTh>퇴근</MudTh>
            <MudTh Style="text-align:right">근무시간</MudTh><MudTh>상태</MudTh><MudTh>메모</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.WorkDate.ToString("yyyy-MM-dd")</MudTd>
            <MudTd>@context.EmployeeName</MudTd>
            <MudTd>@(context.CheckIn?.ToString("HH:mm") ?? "-")</MudTd>
            <MudTd>@(context.CheckOut?.ToString("HH:mm") ?? "-")</MudTd>
            <MudTd Style="text-align:right">@(context.WorkHours?.ToString("N1") ?? "-")h</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                    Color="@(context.Status == "normal" ? Color.Success : Color.Warning)">
                    @(context.Status == "normal" ? "정상" : context.Status)
                </MudChip>
            </MudTd>
            <MudTd>@context.Memo</MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText Class="pa-4" Style="color:var(--hitpan-text-faint)">근태 기록이 없습니다.</MudText></NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private List<AttendanceModel> _items = new();
    private DateTime? _from = DateTime.Today.AddDays(-7);
    private DateTime? _to = DateTime.Today;

    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync() { _items = await HrSvc.GetAttendanceAsync(_from, _to); }

    private async Task CheckInAsync()
    {
        var ok = await HrSvc.CheckInAsync();
        if (ok) { Snackbar.Add("출근 완료", Severity.Success); await LoadAsync(); StateHasChanged(); }
        else Snackbar.Add("출근 실패 — 이미 출근했거나 권한이 없습니다.", Severity.Error);
    }

    private async Task CheckOutAsync()
    {
        var ok = await HrSvc.CheckOutAsync();
        if (ok) { Snackbar.Add("퇴근 완료", Severity.Success); await LoadAsync(); StateHasChanged(); }
        else Snackbar.Add("퇴근 실패 — 출근 기록이 없습니다.", Severity.Error);
    }
}
