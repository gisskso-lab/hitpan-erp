@page "/hr/attendance"
@* 작(2026-08-13) 메뉴 간소화 — [근태 달력](/hr/attendance-calendar)을 여기로 합쳤다.
   두 화면은 같은 GetAttendanceAsync 를 읽고 컬럼 7개가 글자까지 같았다. 다른 것은
   기본 기간 하나뿐이라(이번 달 1일~오늘 vs 최근 7일) 아래 기간 버튼으로 흡수했다.
   🔴 주소는 살려 둔다 — 즐겨찾기·직접 입력으로 들어오는 사람에게 404 를 주지 않는다(헌법 #1). *@
@page "/hr/attendance-calendar"
@namespace HitPan.Web.Pages.HrUi
@attribute [Authorize]
@using HitPan.Web.Models
@using HitPan.Web.Services
@inject HrClientService HrSvc
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject PermissionService PermSvc
@inject EmployeeService EmpSvc
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>근태 관리</PageTitle>
<PageHeader Title="근태 관리" Subtitle="출근·퇴근 기록 · 기간별 조회">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Login" OnClick="CheckInAsync">출근</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Logout" OnClick="CheckOutAsync">퇴근</MudButton>
    </Actions>
</PageHeader>

@* 🔴 대리 근태 (작10 A) — 계정 없는 직원분을 대신 넣는다.
   사장님(2026-08-21): "사원등록만 되있고 계정이 없는 직원은 인사담당자가 수동으로
     근퇴처리 할 수 있는 장치를 만들어야 됨" / "남의 근퇴 넣는건 권한설정에 넣자."

   🔴 권한이 없으면 이 카드를 아예 안 그린다 — 눌러도 안 되는 버튼을 보여주지 않는다.
      (되는 척 금지. 1.2.74 "권한 다 풀었는데 아무것도 못함" 과 같은 계열)
   🔴 기본값이 [계정 없는 직원만] 이다 — 이 기능이 있는 이유가 그 사람들이라서다.
      실측(그룹웨어 흐름설계서): 사원 12명 중 계정 보유 1명. *@
@if (_canProxy)
{
    <MudPaper Class="pa-3 mb-3" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default);border-radius:12px">
        <MudGrid Spacing="2" Class="align-center">
            <MudItem xs="12" md="3">
                <MudSelect T="string" @bind-Value="_proxyEmployeeId" Label="직원" Variant="Variant.Outlined"
                           Margin="Margin.Dense" Placeholder="직원을 고르세요">
                    @foreach (var e in ProxyCandidates)
                    {
                        <MudSelectItem Value="@e.EmployeeId">
                            @e.EmpName@(string.IsNullOrWhiteSpace(e.DeptName) ? "" : $" · {e.DeptName}")
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="_proxyMemo" Label="메모 (선택)" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="3" Class="d-flex gap-2">
                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.PersonAdd"
                           Disabled="@(_proxyBusy || string.IsNullOrEmpty(_proxyEmployeeId))"
                           OnClick="ProxyCheckInAsync">대신 출근</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                           Disabled="@(_proxyBusy || string.IsNullOrEmpty(_proxyEmployeeId))"
                           OnClick="ProxyCheckOutAsync">대신 퇴근</MudButton>
            </MudItem>
            <MudItem xs="12" md="3" Class="d-flex justify-end">
                <MudSwitch T="bool" @bind-Value="_onlyNoAccount" Color="Color.Primary" Size="Size.Small"
                           Label="계정 없는 직원만" />
            </MudItem>
        </MudGrid>
        <MudText Typo="Typo.caption" Class="mt-1" Style="color:var(--hitpan-text-faint)">
            대신 넣은 기록에는 처리한 사람이 함께 남습니다.
        </MudText>
    </MudPaper>
}

@* 필터 *@
<MudPaper Class="pa-3 mb-3" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default);border-radius:12px">
    <MudGrid Spacing="2" Class="align-center">
        <MudItem xs="6" md="2"><MudDatePicker Label="시작일" @bind-Date="_from" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:160px" /></MudItem>
        <MudItem xs="6" md="2"><MudDatePicker Label="종료일" @bind-Date="_to" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:160px" /></MudItem>
        <MudItem xs="12" md="2"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadAsync">조회</MudButton></MudItem>
        @* 기간 버튼 — 옛 [근태 달력]이 하던 '이번 달' 보기가 여기 들어있다.
           날짜를 두 번 고르지 않고 한 번에 바꾸도록 한다(히트판 정신 — 묻지 않고 되게). *@
        <MudItem xs="12" md="6" Class="d-flex justify-end gap-2">
            <MudButton Variant="@PeriodVariant(Period.Week)" Color="Color.Default" Size="Size.Small"
                       OnClick="@(() => ApplyPeriodAsync(Period.Week))">최근 7일</MudButton>
            <MudButton Variant="@PeriodVariant(Period.ThisMonth)" Color="Color.Default" Size="Size.Small"
                       OnClick="@(() => ApplyPeriodAsync(Period.ThisMonth))">이번 달</MudButton>
            <MudButton Variant="@PeriodVariant(Period.LastMonth)" Color="Color.Default" Size="Size.Small"
                       OnClick="@(() => ApplyPeriodAsync(Period.LastMonth))">지난 달</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Elevation="0" Class="pa-2 hitpan-card">
    <MudTable Items="_items" Dense="true" Hover="true" Striped="true">
        <HeaderContent>
            <MudTh>날짜</MudTh><MudTh>사원</MudTh><MudTh>출근</MudTh><MudTh>퇴근</MudTh>
            <MudTh Style="text-align:right">근무시간</MudTh><MudTh>상태</MudTh><MudTh>메모</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.WorkDate.ToString("yyyy-MM-dd")</MudTd>
            <MudTd>@context.EmployeeName</MudTd>
            <MudTd>@(context.CheckIn?.ToString("HH:mm") ?? "-")</MudTd>
            <MudTd>@(context.CheckOut?.ToString("HH:mm") ?? "-")</MudTd>
            <MudTd Style="text-align:right">@(context.WorkHours?.ToString("N1") ?? "-")h</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                    Color="@(context.Status == "normal" ? Color.Success : Color.Warning)">
                    @(context.Status == "normal" ? "정상" : context.Status)
                </MudChip>
            </MudTd>
            <MudTd>@context.Memo</MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText Class="pa-4" Style="color:var(--hitpan-text-faint)">근태 기록이 없습니다.</MudText></NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private List<AttendanceModel> _items = new();
    private DateTime? _from = DateTime.Today.AddDays(-7);
    private DateTime? _to = DateTime.Today;

    private enum Period { Week, ThisMonth, LastMonth, Custom }
    private Period _period = Period.Week;

    /// <summary>
    /// 옛 <b>[근태 달력]</b> 주소로 들어오면 그 화면이 보여주던 기간(이번 달)으로 맞춘다.
    /// 합치기 전과 <b>같은 것이 보여야</b> 합친 것이지, 주소만 살리고 다른 걸 보여주면
    /// 쓰던 사람에겐 화면이 없어진 것과 같다.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        if (Nav.Uri.Contains("/hr/attendance-calendar", StringComparison.OrdinalIgnoreCase))
        {
            _period = Period.ThisMonth;
            (_from, _to) = RangeOf(Period.ThisMonth);
        }
        await LoadProxyStateAsync();
        await LoadAsync();
    }

    private async Task LoadAsync() { _items = await HrSvc.GetAttendanceAsync(_from, _to); }

    // ── 🔴 대리 근태 (작10 A) ──────────────────────────────────────────────
    //
    // ⚠️ 이 화면 판정은 ★표시용★ 이다. 진짜 문지기는 서버의 [RequirePermission("HR_PROXY", ...)] 다.
    //    화면 값을 고쳐도 서버가 403 을 준다(헌법 #2 — 판정은 서버가 JWT·DB 로).
    //    화면에서 감추는 이유는 보안이 아니라 ★눌러도 안 되는 버튼을 보여주지 않기 위해서★ 다.
    private bool _canProxy;
    private bool _proxyBusy;
    private bool _onlyNoAccount = true;
    private string _proxyEmployeeId = string.Empty;
    private string? _proxyMemo;
    private List<EmployeeListItemModel> _employees = new();

    /// <summary>
    /// 대상 후보. 기본은 <b>계정 없는 직원만</b> — 이 기능이 있는 이유가 그 사람들이다.
    /// </summary>
    /// <remarks>
    /// 실측(그룹웨어 흐름설계서): <b>사원 12명 중 계정 보유 1명.</b>
    /// 스위치를 끄면 전원이 보인다 — 계정이 있어도 깜빡한 사람을 대신 넣어야 할 때가 있다.
    /// </remarks>
    private IEnumerable<EmployeeListItemModel> ProxyCandidates
        => _onlyNoAccount ? _employees.Where(e => !e.HasUserAccount) : _employees;

    /// <summary>
    /// 🔴 <b>권한설정에서 켠 사람만</b> 이 카드를 본다. 역할(관리자)로 판정하지 않는다.
    /// </summary>
    /// <remarks>
    /// 사장님: <i>"남의 근퇴 넣는건 권한설정에 넣자."</i> / <i>"이건 고객사 마음이지."</i>
    /// ⇒ 역할로 고정하면 회사마다 다른 사정을 우리가 정해버리는 것이 된다(헌법 #11).
    /// ⚠️ 판정에 실패하면 <b>열어주지 않는다</b> — 못 읽었는데 열면 막은 적이 없는 것과 같다.
    /// </remarks>
    private async Task LoadProxyStateAsync()
    {
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var userId = auth.User.FindFirst("user_id")?.Value;
            if (string.IsNullOrEmpty(userId)) return;

            var perm = await PermSvc.GetAsync(userId);
            _canProxy = perm?.Permissions?.Any(p =>
                string.Equals(p.MenuCode, "HR_PROXY", StringComparison.Ordinal)
                && (p.CanCreate || p.CanUpdate)) == true;

            if (_canProxy) _employees = await EmpSvc.GetListAsync();
        }
        catch (Exception ex)
        {
            _canProxy = false;
            Console.Error.WriteLine($"[HrAttendancePage] 대리입력 권한 확인 실패: {ex.Message}");
        }
    }

    private async Task ProxyCheckInAsync()
    {
        _proxyBusy = true;
        try
        {
            var (ok, msg) = await HrSvc.CheckInProxyAsync(_proxyEmployeeId, _proxyMemo);
            // 🔴 실패 사유를 그대로 보여준다 — 권한이 없는 것과 이미 출근한 것은
            //    사용자가 해야 할 일이 다르다. "실패" 로 뭉개면 무엇을 할지 모른다.
            if (ok) { Snackbar.Add("출근 처리했습니다.", Severity.Success); _proxyMemo = null; await LoadAsync(); }
            else Snackbar.Add(msg, Severity.Error);
        }
        finally { _proxyBusy = false; }
    }

    private async Task ProxyCheckOutAsync()
    {
        _proxyBusy = true;
        try
        {
            var (ok, msg) = await HrSvc.CheckOutProxyAsync(_proxyEmployeeId);
            if (ok) { Snackbar.Add("퇴근 처리했습니다.", Severity.Success); await LoadAsync(); }
            else Snackbar.Add(msg, Severity.Error);
        }
        finally { _proxyBusy = false; }
    }



    private async Task ApplyPeriodAsync(Period p)
    {
        _period = p;
        (_from, _to) = RangeOf(p);
        await LoadAsync();
    }

    private static (DateTime?, DateTime?) RangeOf(Period p)
    {
        var today = DateTime.Today;
        return p switch
        {
            Period.Week => (today.AddDays(-7), today),
            Period.ThisMonth => (new DateTime(today.Year, today.Month, 1), today),
            Period.LastMonth => (new DateTime(today.Year, today.Month, 1).AddMonths(-1),
                                 new DateTime(today.Year, today.Month, 1).AddDays(-1)),
            _ => (today.AddDays(-7), today)
        };
    }

    private Variant PeriodVariant(Period p) => _period == p ? Variant.Filled : Variant.Outlined;

    private async Task CheckInAsync()
    {
        var ok = await HrSvc.CheckInAsync();
        if (ok) { Snackbar.Add("출근 완료", Severity.Success); await LoadAsync(); StateHasChanged(); }
        else Snackbar.Add("출근 실패 — 이미 출근했거나 권한이 없습니다.", Severity.Error);
    }

    private async Task CheckOutAsync()
    {
        var ok = await HrSvc.CheckOutAsync();
        if (ok) { Snackbar.Add("퇴근 완료", Severity.Success); await LoadAsync(); StateHasChanged(); }
        else Snackbar.Add("퇴근 실패 — 출근 기록이 없습니다.", Severity.Error);
    }
}
