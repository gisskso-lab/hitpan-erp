@page "/hr/expense-request"
@* 작(2026-08-13) 메뉴 간소화 — [경비 현황](/hr/expense-status)을 여기로 합쳤다.
   두 화면은 같은 GetHrExpensesAsync 를 읽고 표 6컬럼이 같았다. 현황에만 있던
   건수·금액 요약카드 4개를 아래로 옮겨 왔으므로 기능은 하나도 안 버렸다.
   🔴 주소는 살려 둔다 — 메신저 문서 링크가 /hr/expense-status 로 들어온다(ChatPopup.razor:354). *@
@page "/hr/expense-status"
@namespace HitPan.Web.Pages.HrUi
@attribute [Authorize]
@using HitPan.Web.Models
@using HitPan.Web.Services
@inject HrClientService HrSvc
@inject ISnackbar Snackbar

<PageTitle>경비</PageTitle>
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
    <MudText Typo="Typo.h6">경비 (지출결의서)</MudText>
</div>

@* 요약 — 옛 [경비 현황]에 있던 카드 4개. 신청하러 들어온 사람도
   내 경비가 지금 어디까지 왔는지 같은 화면에서 본다. *@
<MudGrid Spacing="2" Class="mb-3">
    <MudItem xs="6" md="3">
        <MudPaper Elevation="0" Class="pa-3 hitpan-card text-center">
            <MudText Typo="Typo.caption" Color="Color.Secondary">전체</MudText>
            <MudText Typo="Typo.h6">@_items.Count 건</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" md="3">
        <MudPaper Elevation="0" Class="pa-3 hitpan-card text-center">
            <MudText Typo="Typo.caption" Color="Color.Secondary">대기</MudText>
            <MudText Typo="Typo.h6" Color="Color.Warning">@_pendingCount 건</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" md="3">
        <MudPaper Elevation="0" Class="pa-3 hitpan-card text-center">
            <MudText Typo="Typo.caption" Color="Color.Secondary">승인</MudText>
            <MudText Typo="Typo.h6" Color="Color.Success">@_approvedCount 건</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" md="3">
        <MudPaper Elevation="0" Class="pa-3 hitpan-card text-center">
            <MudText Typo="Typo.caption" Color="Color.Secondary">총 금액</MudText>
            <MudText Typo="Typo.h6">@_totalAmount.ToString("N0")원</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudPaper Elevation="0" Class="pa-4 mb-3 hitpan-card">
    <MudGrid Spacing="2">
        <MudItem xs="12" md="2"><MudDatePicker Label="지출일" @bind-Date="_editDate" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:160px" /></MudItem>
        <MudItem xs="12" md="2">
            <MudSelect T="string" Label="분류" @bind-Value="_edit.Category" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="@("교통비")">교통비</MudSelectItem>
                <MudSelectItem Value="@("식대")">식대</MudSelectItem>
                <MudSelectItem Value="@("소모품비")">소모품비</MudSelectItem>
                <MudSelectItem Value="@("접대비")">접대비</MudSelectItem>
                <MudSelectItem Value="@("출장비")">출장비</MudSelectItem>
                <MudSelectItem Value="@("기타")">기타</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="3"><MudTextField T="string" Label="내용" @bind-Value="_edit.Description" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
        <MudItem xs="12" md="2"><MudNumericField T="decimal" Label="금액" @bind-Value="_edit.Amount" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N0" /></MudItem>
        <MudItem xs="12" md="1"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Class="mt-1" FullWidth="true">신청</MudButton></MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Elevation="0" Class="pa-2 hitpan-card">
    <MudTable Items="_items" Dense="true" Hover="true" Striped="true">
        <HeaderContent>
            <MudTh>지출일</MudTh><MudTh>신청자</MudTh><MudTh>분류</MudTh><MudTh>내용</MudTh>
            <MudTh Style="text-align:right">금액</MudTh><MudTh>상태</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.RequestDate.ToString("yyyy-MM-dd")</MudTd>
            <MudTd>@context.EmployeeName</MudTd>
            <MudTd>@context.Category</MudTd>
            <MudTd>@context.Description</MudTd>
            <MudTd Style="text-align:right">@context.Amount.ToString("N0")원</MudTd>
            <MudTd><MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@(context.Status == "approved" ? Color.Success : context.Status == "rejected" ? Color.Error : Color.Warning)">@(context.Status switch { "approved" => "승인", "rejected" => "반려", _ => "대기" })</MudChip></MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText Class="pa-4" Style="color:var(--hitpan-text-faint)">신청된 경비가 없습니다.</MudText></NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private List<HrExpenseModel> _items = new();
    private CreateHrExpenseModel _edit = new();
    private DateTime? _editDate = DateTime.Today;

    // 옛 [경비 현황] 요약카드 수치
    private int _pendingCount;
    private int _approvedCount;
    private decimal _totalAmount;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    /// <summary>
    /// 목록을 불러오고 요약 수치를 다시 센다.
    /// </summary>
    /// <remarks>
    /// 🔴 합치며 옛 [경비 현황]의 catch 를 가져왔다(헌법 #15). 종전 신청 화면은
    /// 실패하면 그대로 터졌고, 현황 화면만 빈 목록으로 받아냈다. 합친 화면이
    /// 둘 중 <b>약한 쪽</b>을 물려받으면 합치면서 화면이 더 잘 죽는 꼴이 된다.
    /// </remarks>
    private async Task LoadAsync()
    {
        try
        {
            _items = await HrSvc.GetHrExpensesAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[HrExpenseRequestPage] {ex.GetType().Name}: {ex.Message}");
            _items = new();
        }
        finally
        {
            _pendingCount = _items.Count(x => x.Status == "pending");
            _approvedCount = _items.Count(x => x.Status == "approved");
            _totalAmount = _items.Sum(x => x.Amount);
        }
    }

    /// <summary>
    /// 경비 신청. 작(2026-08-13) 단계7 — <b>결재가 올라갔는지 사실대로 알린다.</b>
    /// </summary>
    /// <remarks>
    /// 🔴 단계3 P0-1 교훈: 종전엔 성공이면 "신청 완료" 를 무조건 띄웠다.
    /// 결재 설정이 꺼져 있으면 결재가 조용히 안 올라가는데 직원은 올라간 줄 알고,
    /// 문서는 갇히고 결재함엔 안 뜬다. <b>그 침묵이 곧 되는 척이다.</b>
    /// </remarks>
    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_edit.Description)) { Snackbar.Add("내용을 입력해주세요.", Severity.Warning); return; }
        if (_edit.Amount <= 0) { Snackbar.Add("금액을 입력해주세요.", Severity.Warning); return; }
        _edit.RequestDate = _editDate ?? DateTime.Today;

        var (ok, result) = await HrSvc.CreateHrExpenseDetailedAsync(_edit);

        if (!ok)
        {
            // 서버가 준 이유를 그대로 보여준다. 예: "2026년 07월은 마감된 기간입니다."
            Snackbar.Add(result?.Message ?? "신청하지 못했습니다.", Severity.Error);
            return;
        }

        if (result?.ApprovalCreated == true)
        {
            Snackbar.Add("신청했습니다. 결재에 올라갔습니다.", Severity.Success);
        }
        else
        {
            // 신청 자체는 저장됐다. 다만 결재가 안 갔다는 것을 감추지 않는다.
            Snackbar.Add("신청은 저장했습니다. " + (result?.ApprovalSkipReason
                ?? "다만 결재가 올라가지 않았습니다. 설정 → 결재설정을 확인해주세요."), Severity.Warning);
        }

        _edit = new();
        _editDate = DateTime.Today;
        // 🔴 LoadAsync 로 부른다 — 목록만 새로 받으면 위 요약카드가 옛 숫자로 남는다.
        await LoadAsync();
    }
}
