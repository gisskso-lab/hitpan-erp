@page "/hr/absence"
@namespace HitPan.Web.Pages.HrUi
@attribute [Authorize]
@using HitPan.Web.Helpers
@using HitPan.Web.Models
@using HitPan.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject AbsenceService AbsenceSvc
@inject EmployeeService EmpSvc
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>휴직 관리</PageTitle>
<PageHeader Title="휴직 관리" Subtitle="장기간 쉬는 직원의 상태를 관리합니다" />

@* 🔴 사장님이 정한 범위(2026-08-13):
     "복잡하게 생각할것 없이 그냥 휴직은 상태처리, 상태확인 정도로만 써도 될듯."
     "휴직은 모든걸 다 수동으로."
     "휴직시 급여 : 텍스트 박스로 수동입력 → 그러면 자연스럽게 급여, 회계이슈도 해결될듯"
     "비고에 육아, 연수, 교육, 등 자유롭게 쓰면 됨"
   ⇒ 계산·판정·종류목록이 없다. 기간·급여·비고를 넣고 상태를 본다.

   🔴 휴가(연차)와 다른 화면인 이유를 화면 위에 적어 둔다. 직원이 헷갈리면 잘못 신청한다.
     · 하루~며칠 쉬는 것 = [연차 신청]. 연차에서 깎인다.
     · 달·년 단위로 쉬는 것 = 여기. 연차에서 깎이지 않는다. *@

<MudPaper Elevation="0" Class="pa-3 mb-3 hitpan-card">
    <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap">
        <MudSelect T="string" Label="진행 단계" @bind-Value="_filterStatus" Dense="true"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:180px">
            <MudSelectItem T="string" Value="@("")">전체</MudSelectItem>
            @foreach (var s in AbsenceStatusLabels.All)
            {
                <MudSelectItem T="string" Value="@s.Key">@s.Value</MudSelectItem>
            }
        </MudSelect>

        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Search"
                   Disabled="@_loading" OnClick="LoadAsync">조회</MudButton>

        <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Disabled="@_loading" OnClick="@(() => OpenEditor(null))">휴직 등록</MudButton>

        <MudSpacer />

        @if (_isAdmin)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                오늘 휴직중 <b>@_activeToday</b>명
            </MudText>
            <MudTooltip Text="시작일이 지난 승인 건을 '휴직중' 으로 맞춥니다. 복직은 사람이 처리합니다.">
                <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Sync"
                           Disabled="@_loading" OnClick="SyncAsync">상태 맞추기</MudButton>
            </MudTooltip>
        }
    </div>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_items is null)
{
    @* 🔴 실패와 '0건' 을 구분한다. 실패를 빈 목록으로 보여주면 없는 줄 안다. *@
    <MudAlert Severity="Severity.Error" Class="ma-2">
        휴직 목록을 불러오지 못했습니다.
        <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="LoadAsync">다시 시도</MudButton>
    </MudAlert>
}
else if (_items.Count == 0)
{
    <MudAlert Severity="Severity.Info" Class="ma-2">
        휴직 내역이 없습니다. [휴직 등록] 으로 넣으세요.
    </MudAlert>
}
else
{
    <MudTable Items="_items" Dense="true" Hover="true" Striped="true" Elevation="0" Class="hitpan-card">
        <HeaderContent>
            <MudTh Style="width:130px">직원</MudTh>
            <MudTh>기간</MudTh>
            <MudTh Style="width:80px">일수</MudTh>
            <MudTh Style="width:110px">급여</MudTh>
            <MudTh Style="width:110px">진행</MudTh>
            <MudTh>비고</MudTh>
            <MudTh Style="width:200px">처리</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="직원">
                @context.EmployeeName
                @if (!string.IsNullOrWhiteSpace(context.DeptName))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.DeptName</MudText>
                }
            </MudTd>
            <MudTd DataLabel="기간">@context.PeriodDisplay</MudTd>
            <MudTd DataLabel="일수">@context.TotalDays 일</MudTd>
            <MudTd DataLabel="급여">
                <MudText Typo="Typo.body2">@context.PayDisplay</MudText>
                @if (!string.IsNullOrWhiteSpace(context.PayNote))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.PayNote</MudText>
                }
            </MudTd>
            <MudTd DataLabel="진행">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                         Color="@ToColor(context.StatusColor)">@context.StatusDisplay</MudChip>
            </MudTd>
            <MudTd DataLabel="비고">
                @if (!string.IsNullOrWhiteSpace(context.Reason))
                {
                    <MudText Typo="Typo.body2">@context.Reason</MudText>
                }
                @if (!string.IsNullOrWhiteSpace(context.RejectReason))
                {
                    <MudText Typo="Typo.caption" Color="Color.Error">
                        반려: @context.RejectReason
                    </MudText>
                }
            </MudTd>
            <MudTd DataLabel="처리">
                <div style="display:flex;gap:4px;flex-wrap:wrap">
                    @if (context.CanEdit)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text"
                                   OnClick="@(() => OpenEditor(context))">수정</MudButton>
                    }
                    @if (context.CanSubmit)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                   OnClick="@(() => SubmitAsync(context))">결재상신</MudButton>
                    }
                    @if (_isAdmin && context.CanApprove)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Success"
                                   OnClick="@(() => ApproveAsync(context))">승인</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                                   OnClick="@(() => RejectAsync(context))">반려</MudButton>
                    }
                    @if (_isAdmin && context.CanReturn)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                                   OnClick="@(() => ReturnAsync(context))">복직</MudButton>
                    }
                    @if (context.CanCancel)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                   OnClick="@(() => CancelAsync(context))">취소</MudButton>
                    }
                </div>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@* ───────────── 등록·수정 ───────────── *@
<MudDialog @bind-Visible="_editorOpen" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_isNew ? "휴직 등록" : "휴직 수정")</MudText>
    </TitleContent>
    <DialogContent>
        <div style="display:flex;flex-direction:column;gap:12px;min-width:420px">
            @if (_isAdmin)
            {
                <MudSelect T="string" Label="직원" @bind-Value="_edit.EmployeeId" Dense="true"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Required="true">
                    @foreach (var e in _employees)
                    {
                        <MudSelectItem T="string" Value="@e.EmployeeId">@e.EmpName</MudSelectItem>
                    }
                </MudSelect>
            }

            @* 🔴 기간은 사람이 넣는다. 서버가 정해주지 않는다. *@
            <div style="display:flex;gap:8px">
                <MudDatePicker Label="시작일" @bind-Date="_startDate" Variant="Variant.Outlined"
                               Margin="Margin.Dense" DateFormat="yyyy-MM-dd" />
                <MudDatePicker Label="종료 예정일" @bind-Date="_endDate" Variant="Variant.Outlined"
                               Margin="Margin.Dense" DateFormat="yyyy-MM-dd" />
            </div>

            @if (_startDate is { } s && _endDate is { } e2 && e2.Date >= s.Date)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    총 <b>@((e2.Date - s.Date).Days + 1)</b>일
                </MudText>
            }

            @* 🔴 급여는 금액을 직접 받는다(사장님: "수동으로 int값 직접 받아서 입력하는게 가장 깔끔함").
                 회사마다 사정이 다른데 자동 계산으로는 못 맞춘다. *@
            <MudNumericField T="decimal" Label="휴직 중 지급할 금액 (원)" @bind-Value="_edit.PayAmount"
                             Variant="Variant.Outlined" Margin="Margin.Dense"
                             Min="0" Format="N0" HideSpinButtons="true"
                             HelperText="0 으로 두면 무급입니다. 회사가 정한 금액을 그대로 넣으세요." />

            <MudTextField T="string" Label="급여 메모 (선택)" @bind-Value="_edit.PayNote"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          HelperText="예: 고용보험에서 별도 수령 · 3개월분 선지급" />

            @* 🔴 종류를 고르게 하지 않는다(사장님: "비고에 육아, 연수, 교육, 등 자유롭게 쓰면 됨").
                 회사마다 부르는 이름이 다르고, 목록에 없는 사유가 늘 생긴다. *@
            <MudTextField T="string" Label="비고" @bind-Value="_edit.Reason" Lines="3"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          HelperText="육아, 연수, 교육 등 자유롭게 쓰세요." />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _editorOpen = false)">닫기</MudButton>
        <MudButton Color="Color.Default" Variant="Variant.Text"
                   Disabled="@_saving" OnClick="@(() => SaveAsync(false))">임시저장</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="@_saving" OnClick="@(() => SaveAsync(true))">저장하고 결재상신</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<AbsenceModel>? _items;
    private List<EmployeeListItemModel> _employees = new();
    private bool _loading;
    private bool _saving;
    private bool _isAdmin;
    private string _filterStatus = "";
    private int _activeToday;

    private bool _editorOpen;
    private bool _isNew = true;
    private SaveAbsenceModel _edit = new();

    // MudDatePicker 는 DateTime? 을 쓴다. 모델의 DateTime 과 따로 두고 저장할 때 옮긴다.
    private DateTime? _startDate = DateTime.Today;
    private DateTime? _endDate = DateTime.Today;

    private readonly DialogOptions _dialogOptions = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true,
        CloseOnEscapeKey = true
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            _isAdmin = AccountTypeHelper.IsTenantAdmin(auth.User);
        }
        catch (Exception ex)
        {
            // 판정에 실패하면 관리자로 보지 않는다 — 못 읽었는데 열어주면 막은 적이 없는 것과 같다.
            Console.Error.WriteLine($"[AbsencePage] 계정 유형 판정 실패: {ex.GetType().Name}: {ex.Message}");
            _isAdmin = false;
        }

        if (_isAdmin)
        {
            await LoadEmployeesAsync();
        }

        await LoadAsync();
    }

    private async Task LoadEmployeesAsync()
    {
        try
        {
            // 재직자만 고른다 — 퇴직자에게 휴직을 넣을 일은 없다.
            var all = await EmpSvc.GetListAsync();
            _employees = all.Where(e => e.IsActive).ToList();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[AbsencePage] 사원 목록 조회 실패: {ex.GetType().Name}: {ex.Message}");
            _employees = new List<EmployeeListItemModel>();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            _items = await AbsenceSvc.GetListAsync(
                string.IsNullOrWhiteSpace(_filterStatus) ? null : _filterStatus);

            _activeToday = _items?.Count(x => x.Status == "active") ?? 0;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void OpenEditor(AbsenceModel? existing)
    {
        if (existing is null)
        {
            _isNew = true;
            _edit = new SaveAbsenceModel
            {
                EmployeeId = _isAdmin && _employees.Count > 0 ? _employees[0].EmployeeId : "",
                PayAmount = 0m
            };
            _startDate = DateTime.Today;
            _endDate = DateTime.Today;
        }
        else
        {
            _isNew = false;
            _edit = new SaveAbsenceModel
            {
                AbsenceId = existing.AbsenceId,
                EmployeeId = existing.EmployeeId,
                StartDate = existing.StartDate,
                EndDate = existing.EndDate,
                Reason = existing.Reason,
                PayAmount = existing.PayAmount,
                PayNote = existing.PayNote
            };
            _startDate = existing.StartDate;
            _endDate = existing.EndDate;
        }

        _editorOpen = true;
    }

    private async Task SaveAsync(bool submit)
    {
        if (_startDate is null || _endDate is null)
        {
            Snackbar.Add("시작일과 종료일을 넣어주세요.", Severity.Warning);
            return;
        }

        _edit.StartDate = _startDate.Value;
        _edit.EndDate = _endDate.Value;
        _edit.Submit = submit;

        _saving = true;
        try
        {
            var (ok, result, message) = await AbsenceSvc.SaveAsync(_edit);

            if (!ok)
            {
                Snackbar.Add(message ?? "저장하지 못했습니다.", Severity.Error);
                return;
            }

            _editorOpen = false;

            // 🔴 결재가 실제로 올라갔는지를 **사실대로** 알린다(단계3 P0-1 교훈).
            //    "올렸습니다" 를 무조건 띄우면 직원은 올라간 줄 알고 결재함엔 안 뜬다.
            if (submit && result?.ApprovalCreated != true)
            {
                Snackbar.Add(result?.ApprovalSkipReason
                    ?? "저장은 됐지만 결재가 올라가지 않았습니다.", Severity.Warning);
            }
            else if (submit)
            {
                Snackbar.Add("결재에 올렸습니다.", Severity.Success);
            }
            else
            {
                Snackbar.Add("저장했습니다.", Severity.Success);
            }

            foreach (var w in result?.Warnings ?? new List<string>())
            {
                Snackbar.Add(w, Severity.Info);
            }

            await LoadAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SubmitAsync(AbsenceModel item)
    {
        var (ok, result, message) = await AbsenceSvc.SubmitAsync(item.AbsenceId);

        if (!ok)
        {
            Snackbar.Add(message ?? "결재에 올리지 못했습니다.", Severity.Error);
            return;
        }

        if (result?.ApprovalCreated != true)
        {
            Snackbar.Add(result?.ApprovalSkipReason ?? "결재가 올라가지 않았습니다.", Severity.Warning);
        }
        else
        {
            Snackbar.Add("결재에 올렸습니다.", Severity.Success);
        }

        await LoadAsync();
    }

    private async Task ApproveAsync(AbsenceModel item)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("휴직 승인",
            $"{item.EmployeeName} 님의 휴직({item.PeriodDisplay}) 을 승인합니까? "
            + "승인하면 직원 상태가 '휴직' 으로 바뀝니다.",
            yesText: "승인", cancelText: "취소");

        if (confirmed != true) return;

        var (ok, message) = await AbsenceSvc.ApproveAsync(item.AbsenceId);
        Snackbar.Add(ok ? "승인했습니다." : message ?? "승인하지 못했습니다.",
            ok ? Severity.Success : Severity.Error);

        if (ok) await LoadAsync();
    }

    private async Task RejectAsync(AbsenceModel item)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("휴직 반려",
            $"{item.EmployeeName} 님의 휴직 신청을 반려합니까?",
            yesText: "반려", cancelText: "취소");

        if (confirmed != true) return;

        var (ok, message) = await AbsenceSvc.RejectAsync(item.AbsenceId, "관리자 반려");
        Snackbar.Add(ok ? "반려했습니다." : message ?? "반려하지 못했습니다.",
            ok ? Severity.Success : Severity.Error);

        if (ok) await LoadAsync();
    }

    private async Task CancelAsync(AbsenceModel item)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("휴직 취소",
            "이 휴직 건을 취소합니까?", yesText: "취소하기", cancelText: "돌아가기");

        if (confirmed != true) return;

        var (ok, message) = await AbsenceSvc.CancelAsync(item.AbsenceId);
        Snackbar.Add(ok ? "취소했습니다." : message ?? "취소하지 못했습니다.",
            ok ? Severity.Success : Severity.Error);

        if (ok) await LoadAsync();
    }

    /// <summary>
    /// 복직 처리. 🔴 실제 복직일은 <b>사람이 넣는다</b> — 예정일과 다를 수 있고,
    /// 자동으로 복직시키면 아직 안 나온 사람이 재직자로 잡혀 급여가 나간다.
    /// </summary>
    private async Task ReturnAsync(AbsenceModel item)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("복직 처리",
            $"{item.EmployeeName} 님을 오늘({DateTime.Today:yyyy-MM-dd}) 자로 복직 처리합니까? "
            + "직원 상태가 '재직' 으로 돌아갑니다.",
            yesText: "복직 처리", cancelText: "취소");

        if (confirmed != true) return;

        var (ok, message) = await AbsenceSvc.ReturnAsync(new ReturnFromAbsenceModel
        {
            AbsenceId = item.AbsenceId,
            ActualReturnDate = DateTime.Today
        });

        Snackbar.Add(ok ? "복직 처리했습니다." : message ?? "복직 처리하지 못했습니다.",
            ok ? Severity.Success : Severity.Error);

        if (ok) await LoadAsync();
    }

    private async Task SyncAsync()
    {
        var (ok, message) = await AbsenceSvc.SyncAsync();
        Snackbar.Add(ok ? "상태를 맞췄습니다." : message ?? "맞추지 못했습니다.",
            ok ? Severity.Success : Severity.Error);

        if (ok) await LoadAsync();
    }

    private static Color ToColor(string name) => name switch
    {
        "Warning" => Color.Warning,
        "Info" => Color.Info,
        "Success" => Color.Success,
        "Error" => Color.Error,
        "Primary" => Color.Primary,
        _ => Color.Default,
    };
}
