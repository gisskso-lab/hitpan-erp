@page "/hr/overtime"
@namespace HitPan.Web.Pages.HrUi
@attribute [Authorize]
@using HitPan.Web.Helpers
@using HitPan.Web.Models
@using HitPan.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject HrClientService HrSvc
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>초과근무</PageTitle>
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
    <MudText Typo="Typo.h6">초과근무</MudText>
</div>

<MudPaper Elevation="0" Class="pa-4 mb-3 hitpan-card">
    <MudText Typo="Typo.subtitle2" Class="mb-3">초과근무 신청</MudText>
    <MudGrid Spacing="2">
        <MudItem xs="12" md="2"><MudDatePicker Label="근무일" @bind-Date="_editDate" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:160px" /></MudItem>
        <MudItem xs="12" md="2"><MudTimePicker Label="시작" @bind-Time="_startTime" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
        <MudItem xs="12" md="2"><MudTimePicker Label="종료" @bind-Time="_endTime" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
        <MudItem xs="12" md="2">
            <MudSelect T="string" Label="유형" @bind-Value="_edit.OvertimeType" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="@("weekday")">평일</MudSelectItem>
                <MudSelectItem Value="@("weekend")">주말</MudSelectItem>
                <MudSelectItem Value="@("holiday")">공휴일</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="2"><MudTextField T="string" Label="사유" @bind-Value="_edit.Reason" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
        <MudItem xs="12" md="2"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Class="mt-1" FullWidth="true">신청</MudButton></MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Elevation="0" Class="pa-2 hitpan-card">
    <MudTable Items="_items" Dense="true" Hover="true" Striped="true">
        <HeaderContent>
            <MudTh>날짜</MudTh><MudTh>사원</MudTh><MudTh>시작</MudTh><MudTh>종료</MudTh>
            <MudTh Style="text-align:right">시간</MudTh><MudTh>유형</MudTh><MudTh>사유</MudTh><MudTh>상태</MudTh><MudTh Style="text-align:center">처리</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.WorkDate.ToString("yyyy-MM-dd")</MudTd>
            <MudTd>@context.EmployeeName</MudTd>
            <MudTd>@context.StartTime.ToString(@"hh\:mm")</MudTd>
            <MudTd>@context.EndTime.ToString(@"hh\:mm")</MudTd>
            <MudTd Style="text-align:right">@context.Hours.ToString("N1")h</MudTd>
            <MudTd>@(context.OvertimeType switch { "weekday" => "평일", "weekend" => "주말", "holiday" => "공휴일", _ => context.OvertimeType })</MudTd>
            <MudTd>@context.Reason</MudTd>
            <MudTd><MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@(context.Status == "approved" ? Color.Success : context.Status == "rejected" ? Color.Error : Color.Warning)">@(context.Status switch { "approved" => "승인", "rejected" => "반려", _ => "대기" })</MudChip></MudTd>
            @* 봉합 (2026-06-23, 19차): 대기 상태일 때만 승인/반려 버튼 — 종전엔 신청만 되고 승인 경로가 없었다. *@
            <MudTd Style="text-align:center">
                @* 작(2026-08-21) 김삼성 상무 판정: 승인/반려는 관리자만.
                   🔴 종전엔 status 만 봐서 일반 직원에게도 버튼이 보였고,
                      본인이 신청한 건을 본인이 승인하는 버튼까지 떴다(인사 감사 지적 자리).
                      휴직 화면(AbsencePage)은 처음부터 _isAdmin 으로 걸렀다 — 같은 기준으로 맞춘다. *@
                @if (_isAdmin && context.Status == "pending")
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Success" OnClick="@(() => ProcessAsync(context, "approved"))">승인</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => ProcessAsync(context, "rejected"))">반려</MudButton>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>

@code {
    private List<OvertimeModel> _items = new();
    private CreateOvertimeModel _edit = new();
    private DateTime? _editDate = DateTime.Today;
    private TimeSpan? _startTime = new(18, 0, 0);
    private TimeSpan? _endTime = new(21, 0, 0);

    private bool _isAdmin;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            _isAdmin = AccountTypeHelper.IsTenantAdmin(auth.User);
        }
        catch (Exception ex)
        {
            // 판정에 실패하면 관리자로 보지 않는다 — 못 읽었는데 열어주면 막은 적이 없는 것과 같다.
            // (휴직 화면과 같은 원칙. 게이트: OvertimeApproverGateGuardTests)
            Console.Error.WriteLine($"[HrOvertimePage] 계정 유형 판정 실패: {ex.GetType().Name}: {ex.Message}");
            _isAdmin = false;
        }

        _items = await HrSvc.GetOvertimeAsync();
    }

    private async Task SaveAsync()
    {
        _edit.WorkDate = _editDate ?? DateTime.Today;
        _edit.StartTime = _startTime ?? new(18, 0, 0);
        _edit.EndTime = _endTime ?? new(21, 0, 0);
        var ok = await HrSvc.CreateOvertimeAsync(_edit);
        if (ok) { Snackbar.Add("신청 완료", Severity.Success); _edit = new(); _items = await HrSvc.GetOvertimeAsync(); }
        else Snackbar.Add("신청 실패", Severity.Error);
    }

    // 봉합 (2026-06-23, 19차): 초과근무 승인/반려 처리 — 워크플로우 끊김 해소.
    private async Task ProcessAsync(OvertimeModel item, string action)
    {
        var ok = await HrSvc.ApproveOvertimeAsync(item.OvertimeId, action);
        if (ok)
        {
            Snackbar.Add(action == "approved" ? "승인되었습니다." : "반려되었습니다.", Severity.Success);
            _items = await HrSvc.GetOvertimeAsync();
        }
        else
        {
            Snackbar.Add("처리에 실패했습니다.", Severity.Error);
        }
    }
}
