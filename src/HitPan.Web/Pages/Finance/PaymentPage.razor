@page "/payments"
@namespace HitPan.Web.Pages.FinanceUi
@attribute [Authorize]
@using HitPan.Web.Models
@using HitPan.Web.Services
@inject CollectionPaymentService CollSvc
@inject PartnerMasterService PartnerSvc
@inject ISnackbar Snackbar

<PageTitle>지급</PageTitle>

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
    <MudText Typo="Typo.h6">지급</MudText>
    <MudText Style="font-size:12px;color:var(--mud-palette-text-secondary)">
        거래처에 지급한 돈 관리
    </MudText>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    @* ── 입력 폼 ── *@
    <MudPaper Elevation="0" Class="pa-4 mb-3 hitpan-card">
        <MudText Typo="Typo.subtitle2" Class="mb-3">지급 등록</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" md="3">
                <MudAutocomplete T="PartnerListRow" Label="거래처"
                    Value="_selectedPartner" ValueChanged="OnPartnerSelected"
                    SearchFunc="SearchPartner" ToStringFunc="@(p => p?.PartnerName ?? "")"
                    Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudDatePicker Label="지급일" @bind-Date="_editDate" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:160px" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudNumericField T="decimal" Label="지급액" @bind-Value="_edit.Amount" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N0" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudSelect T="string" Label="지급수단" @bind-Value="_edit.PaymentMethod" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem Value="@("cash")">현금</MudSelectItem>
                    <MudSelectItem Value="@("bank_transfer")">계좌이체</MudSelectItem>
                    <MudSelectItem Value="@("check")">수표</MudSelectItem>
                    <MudSelectItem Value="@("card")">카드</MudSelectItem>
                    <MudSelectItem Value="@("note")">어음</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudTextField T="string" Label="비고" @bind-Value="_edit.Memo" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudToolBar Dense="true" Class="pa-1 gap-1 mb-2">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync">저장</MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Undo" OnClick="ResetForm">초기화</MudButton>
    </MudToolBar>

    @* ── 목록 ── *@
    <MudPaper Elevation="0" Class="pa-2 hitpan-card">
        <MudGrid Spacing="2" Class="mb-2 pa-2">
            <MudItem xs="12" md="3">
                <MudDatePicker Label="시작일" @bind-Date="_filterFrom" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:160px" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudDatePicker Label="종료일" @bind-Date="_filterTo" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:160px" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Search" OnClick="LoadAsync" Class="mt-1">조회</MudButton>
            </MudItem>
            <MudItem xs="12" md="4" Style="text-align:right">
                <MudText Typo="Typo.subtitle2" Class="mt-2">합계: @_items.Sum(x => x.Amount).ToString("N0")원</MudText>
            </MudItem>
        </MudGrid>

        <MudTable Items="_items" Dense="true" Hover="true">
            <HeaderContent>
                <MudTh>지급일</MudTh>
                <MudTh>거래처</MudTh>
                <MudTh Style="text-align:right">지급액</MudTh>
                <MudTh>지급수단</MudTh>
                <MudTh>비고</MudTh>
                <MudTh Style="width:60px"></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.PaymentDate.ToString("yyyy-MM-dd")</MudTd>
                <MudTd>@context.PartnerName</MudTd>
                <MudTd Style="text-align:right">@context.Amount.ToString("N0")원</MudTd>
                <MudTd>@context.PaymentMethodLabel</MudTd>
                <MudTd>@context.Memo</MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => ConfirmDelete(context.PaymentId))" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@code {
    private List<PaymentModel> _items = new();
    private List<PartnerListRow> _partners = new();
    private CreatePaymentModel _edit = new();
    private PartnerListRow? _selectedPartner;
    private DateTime? _editDate = DateTime.Today;
    private DateTime? _filterFrom;
    private DateTime? _filterTo;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _partners = await PartnerSvc.GetListAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _items = await CollSvc.GetPaymentsAsync(_filterFrom, _filterTo);
        _loading = false;
    }

    private void OnPartnerSelected(PartnerListRow? p)
    {
        _selectedPartner = p;
        _edit.PartnerId = p?.PartnerId ?? "";
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrEmpty(_edit.PartnerId)) { Snackbar.Add("거래처를 선택해주세요.", Severity.Warning); return; }
        if (_edit.Amount <= 0) { Snackbar.Add("지급액을 입력해주세요.", Severity.Warning); return; }
        _edit.PaymentDate = _editDate ?? DateTime.Today;

        var ok = await CollSvc.CreatePaymentAsync(_edit);
        if (ok) { Snackbar.Add("지급 저장됨", Severity.Success); ResetForm(); await LoadAsync(); }
        else Snackbar.Add("저장 실패", Severity.Error);
    }

    private string? _pendingDeleteId;

    private void ConfirmDelete(string id)
    {
        if (_pendingDeleteId == id)
        {
            _ = DoDeleteAsync(id);
        }
        else
        {
            _pendingDeleteId = id;
            Snackbar.Add("한번 더 클릭하면 삭제됩니다.", Severity.Warning);
        }
    }

    private async Task DoDeleteAsync(string id)
    {
        var ok = await CollSvc.DeletePaymentAsync(id);
        _pendingDeleteId = null;
        if (ok) { Snackbar.Add("삭제됨", Severity.Success); await LoadAsync(); StateHasChanged(); }
        else Snackbar.Add("삭제 실패", Severity.Error);
    }

    private void ResetForm()
    {
        _edit = new CreatePaymentModel();
        _selectedPartner = null;
        _editDate = DateTime.Today;
    }

    private Task<IEnumerable<PartnerListRow>> SearchPartner(string? value, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(value)) return Task.FromResult(_partners.AsEnumerable());
        return Task.FromResult(_partners.Where(p =>
            p.PartnerName.Contains(value, StringComparison.OrdinalIgnoreCase)));
    }
}
