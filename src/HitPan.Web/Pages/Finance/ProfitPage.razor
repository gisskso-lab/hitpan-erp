@page "/accounting/profit"
@namespace HitPan.Web.Pages.FinanceUi
@attribute [Authorize]
@using HitPan.Web.Models
@using HitPan.Web.Services
@inject FinanceClientService FinSvc
@inject GridExportService GridExport

<PageTitle>손익 현황</PageTitle>

<PageHeader Title="손익 현황" Subtitle="월별 매출·매입·경비·순이익 집계">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadAsync">조회</MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.TableChart" OnClick="ExportExcelAsync">엑셀</MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Print" OnClick="PrintAsync">인쇄</MudButton>
    </Actions>
</PageHeader>

@* KPI 요약 *@
<MudGrid Spacing="2" Class="mb-3">
    <MudItem xs="12" sm="3">
        <KpiCard Color="KpiCard.KpiColor.Primary"
                 Icon="@Icons.Material.Filled.TrendingUp"
                 Label="연간 매출"
                 Value="@_items.Sum(x => x.SalesAmount).ToString("N0")" />
    </MudItem>
    <MudItem xs="12" sm="3">
        <KpiCard Color="KpiCard.KpiColor.Warning"
                 Icon="@Icons.Material.Filled.ShoppingCart"
                 Label="연간 매입"
                 Value="@_items.Sum(x => x.PurchaseAmount).ToString("N0")" />
    </MudItem>
    <MudItem xs="12" sm="3">
        <KpiCard Color="KpiCard.KpiColor.Purple"
                 Icon="@Icons.Material.Filled.Paid"
                 Label="경비 합계"
                 Value="@_items.Sum(x => x.ExpenseAmount).ToString("N0")" />
    </MudItem>
    <MudItem xs="12" sm="3">
        <KpiCard Color="@(_items.Sum(x => x.NetProfit) >= 0 ? KpiCard.KpiColor.Success : KpiCard.KpiColor.Error)"
                 Icon="@Icons.Material.Filled.Savings"
                 Label="순이익"
                 EmphasizeValue="true"
                 Value="@_items.Sum(x => x.NetProfit).ToString("N0")" />
    </MudItem>
</MudGrid>

<SectionCard Title="조회 조건">
    <MudGrid Spacing="2">
        <MudItem xs="6" md="2">
            <MudNumericField T="int" Label="년도" @bind-Value="_year" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>
    </MudGrid>
</SectionCard>

<SectionCard Variant="SectionCard.SectionVariant.Flat">
    <MudTable Items="_items" Dense="true" Hover="true" Striped="true">
        <HeaderContent>
            <MudTh>월</MudTh>
            <MudTh Style="text-align:right">매출</MudTh>
            <MudTh Style="text-align:right">매입</MudTh>
            <MudTh Style="text-align:right">매출총이익</MudTh>
            <MudTh Style="text-align:right">경비</MudTh>
            <MudTh Style="text-align:right;font-weight:600">순이익</MudTh>
            <MudTh Style="text-align:right">이익률</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd Style="font-weight:500">@context.YearMonthLabel</MudTd>
            <MudTd Style="text-align:right">@context.SalesAmount.ToString("N0")</MudTd>
            <MudTd Style="text-align:right">@context.PurchaseAmount.ToString("N0")</MudTd>
            <MudTd Style="text-align:right">@context.GrossProfit.ToString("N0")</MudTd>
            <MudTd Style="text-align:right">@context.ExpenseAmount.ToString("N0")</MudTd>
            <MudTd Style="@($"text-align:right;font-weight:600;color:{(context.NetProfit >= 0 ? "var(--hitpan-income)" : "var(--hitpan-expense)")}")">@context.NetProfit.ToString("N0")</MudTd>
            <MudTd Style="text-align:right">@context.ProfitRate.ToString("N1")%</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <EmptyState Icon="@Icons.Material.Filled.BarChart"
                        Title="손익 데이터가 없습니다"
                        Subtitle="해당 연도의 매입·매출 전표를 확인해 주세요." />
        </NoRecordsContent>
    </MudTable>
</SectionCard>

@code {
    private List<ProfitSummaryModel> _items = new();
    private int _year = DateTime.Today.Year;
    protected override async Task OnInitializedAsync() => await LoadAsync();
    private async Task LoadAsync() { _items = await FinSvc.GetProfitAsync(_year); StateHasChanged(); }
    /// <summary>화면 자료를 엑셀로 내보낸다 (사장님 지시 2026-08-12).</summary>
    /// <remarks>
    /// 종전 이 화면에는 내보내기가 아예 없었다 — 세무사에게 넘길 자료가 화면 안에 갇혀 있었다.
    /// 화면 표와 같은 열·같은 순서로 내보낸다.
    /// </remarks>
    private async Task ExportExcelAsync()
    {
        var headers = new[] { "월", "매출", "매입", "매출총이익", "경비", "순이익", "이익률" };
        var rows = _items.Select(r => (IReadOnlyList<object?>)new object?[]
        {
            r.YearMonthLabel, r.SalesAmount, r.PurchaseAmount, r.GrossProfit, r.ExpenseAmount, r.NetProfit, r.ProfitRate
        }).ToList();

        await GridExport.ExportExcelAsync("손익 현황", headers, rows, $"총 {_items.Count:N0}개월");
    }

    /// <summary>화면을 인쇄한다. 인쇄창에서 "PDF로 저장" 을 고르면 PDF 가 된다.</summary>
    /// <remarks>
    /// 제목·기간을 같이 넘긴다 — 안 넘기면 종이에 표만 나온다 (사장님 지시 2026-08-12).
    /// </remarks>
    private async Task PrintAsync()
        => await GridExport.PrintAsync("손익 현황", $"총 {_items.Count:N0}개월");
}