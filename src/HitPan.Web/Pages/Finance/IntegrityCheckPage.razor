@page "/accounting/integrity"
@using HitPan.Web.Models
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>정합성 검사</PageTitle>

@* 🔴 20260827작8 W4 — 검사 API 는 살아 있었는데 **부르는 화면이 0건**이었다.
     사장님 1.3.28 실측 반려: "회계검산 화면 그대로임".
     서버 `GET api/finance/integrity-check` 는 15개 검사를 이미 돌려주고 있었다. *@

<MudPaper Class="pa-4 mb-3" Elevation="1">
    <div class="d-flex align-center flex-wrap gap-3">
        <MudIcon Icon="@Icons.Material.Filled.FactCheck" Color="Color.Primary" Size="Size.Large" />
        <div class="flex-grow-1">
            <MudText Typo="Typo.h6">정합성 검사</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                재고·매입·매출·회계 장부가 서로 맞는지 한 번에 확인합니다. 이상이 있으면 어느 자료인지 알려 줍니다.
            </MudText>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="RunAsync" Disabled="@_loading">
            @(_loading ? "검사 중…" : "검사 실행")
        </MudButton>
    </div>
</MudPaper>

@if (_loading && _report is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4" />
}
else if (_report is not null)
{
    @* 요약 — 🔴 점수(Score)는 쓰지 않는다 (헌법 #32).
         사장님이 원한 건 "틀린 데이터를 빠르게 발견" 이지 점수가 아니다.
         92점 같은 숫자는 8건이 틀렸다는 사실을 가린다. *@
    <MudGrid Class="mb-3">
        <MudItem xs="12" sm="4">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.overline" Class="mud-text-secondary">이상 발견</MudText>
                <MudText Typo="Typo.h4" Color="@(_failCount > 0 ? Color.Error : Color.Success)">
                    @_failCount<span style="font-size:.5em"> 건</span>
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.overline" Class="mud-text-secondary">확인 필요</MudText>
                <MudText Typo="Typo.h4" Color="@(_warnCount > 0 ? Color.Warning : Color.Default)">
                    @_warnCount<span style="font-size:.5em"> 건</span>
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.overline" Class="mud-text-secondary">검사 항목</MudText>
                <MudText Typo="Typo.h4">@(_report.Items?.Count ?? 0)<span style="font-size:.5em"> 개</span></MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@_report.CheckedAt.ToString("yyyy-MM-dd HH:mm") 기준</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @if (_failCount == 0 && _warnCount == 0)
    {
        <MudAlert Severity="Severity.Success" Class="mb-3" Dense="true">
            이상이 발견되지 않았습니다. 재고·매입·매출·회계 자료가 서로 맞습니다.
        </MudAlert>
    }
    else
    {
        <MudAlert Severity="@(_failCount > 0 ? Severity.Error : Severity.Warning)" Class="mb-3" Dense="true">
            아래 항목을 확인해 주세요. <b>이상 발견</b> 은 자료가 서로 맞지 않는 상태이며,
            <b>확인 필요</b> 는 업무상 정상일 수도 있는 항목입니다.
        </MudAlert>
    }

    @* 🔴 이상 항목을 맨 위로 올린다. 15줄 중간에 묻히면 못 찾는다. *@
    <MudTable T="IntegrityItemModel" Items="@SortedItems" Dense="true" Hover="true" Elevation="1"
              GroupBy="@_groupDef" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh Style="width:110px">상태</MudTh>
            <MudTh>검사 항목</MudTh>
            <MudTh>내용</MudTh>
        </HeaderContent>
        <GroupHeaderTemplate>
            <MudTh Class="mud-table-cell-custom-group" colspan="3">
                <b>@context.Key</b>
            </MudTh>
        </GroupHeaderTemplate>
        <RowTemplate>
            <MudTd DataLabel="상태">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                         Color="@StatusColor(context.Status)">@StatusLabel(context.Status)</MudChip>
            </MudTd>
            <MudTd DataLabel="검사 항목">@context.CheckName</MudTd>
            <MudTd DataLabel="내용">
                @if (string.IsNullOrWhiteSpace(context.Detail))
                {
                    <span class="mud-text-secondary">이상 없음</span>
                }
                else
                {
                    <b>@context.Detail</b>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
}
