@page "/accounting/monthly-closing"
@namespace HitPan.Web.Pages.FinanceUi
@attribute [Authorize]
@using HitPan.Web.Models
@using HitPan.Web.Services
@inject MonthlyClosingService ClosingSvc
@inject ISnackbar Snackbar

<PageTitle>월마감</PageTitle>

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
    <MudText Typo="Typo.h6">월마감</MudText>
    <MudText Style="font-size:12px;color:var(--mud-palette-text-secondary)">
        마감된 월의 전표는 수정·생성이 차단됩니다
    </MudText>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudPaper Elevation="0" Class="pa-2" Style="border:0.5px solid var(--mud-palette-lines-default);border-radius:12px">
        <MudTable Items="_months" Dense="true" Hover="true">
            <HeaderContent>
                <MudTh>월</MudTh>
                <MudTh Style="text-align:center">상태</MudTh>
                <MudTh Style="text-align:right">매출</MudTh>
                <MudTh Style="text-align:right">매입</MudTh>
                <MudTh Style="text-align:right">수금</MudTh>
                <MudTh Style="text-align:right">지급</MudTh>
                <MudTh Style="text-align:center">마감일</MudTh>
                <MudTh Style="width:200px;text-align:center">처리</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd Style="font-weight:600">@context.YearMonthLabel</MudTd>
                <MudTd Style="text-align:center">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                        Color="@(context.Status switch { "closed" => Color.Success, "reopened" => Color.Warning, _ => Color.Default })">
                        @context.StatusLabel
                    </MudChip>
                </MudTd>
                <MudTd Style="text-align:right">@context.SalesAmount.ToString("N0")</MudTd>
                <MudTd Style="text-align:right">@context.PurchaseAmount.ToString("N0")</MudTd>
                <MudTd Style="text-align:right">@context.ReceiptAmount.ToString("N0")</MudTd>
                <MudTd Style="text-align:right">@context.PaymentAmount.ToString("N0")</MudTd>
                <MudTd Style="text-align:center;font-size:12px">
                    @(context.ClosedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")
                </MudTd>
                <MudTd Style="text-align:center">
                    @if (context.Status == "closed")
                    {
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Warning"
                            StartIcon="@Icons.Material.Filled.LockOpen"
                            OnClick="@(() => OpenReopenDialog(context.YearMonth))">재오픈</MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary"
                            StartIcon="@Icons.Material.Filled.Lock"
                            OnClick="@(() => CloseMonthAsync(context.YearMonth))">마감</MudButton>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}

@* 재오픈 사유 다이얼로그 *@
<MudDialog @bind-Visible="_showReopen" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent><MudText Typo="Typo.h6">월마감 재오픈</MudText></TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Class="mb-3">재오픈 시 해당 월의 전표 수정이 다시 허용됩니다.</MudAlert>
        <MudTextField T="string" @bind-Value="_reopenReason" Label="재오픈 사유" Variant="Variant.Outlined"
            Lines="3" Placeholder="재오픈 사유를 입력해주세요." />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showReopen = false)">취소</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="ConfirmReopen">재오픈</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<MonthlyClosingModel> _months = new();
    private bool _loading = true;
    private bool _showReopen;
    private string _reopenYm = "";
    private string _reopenReason = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _months = await ClosingSvc.GetStatusAsync();
        _loading = false;
    }

    // 마감 처리
    private async Task CloseMonthAsync(string ym)
    {
        var ok = await ClosingSvc.CloseAsync(ym);
        if (ok) { Snackbar.Add($"{FormatYm(ym)} 마감 완료", Severity.Success); await LoadAsync(); }
        else Snackbar.Add("마감 실패 — 이전 월 마감을 먼저 확인해주세요.", Severity.Error);
    }

    // 재오픈 다이얼로그
    private void OpenReopenDialog(string ym)
    {
        _reopenYm = ym;
        _reopenReason = "";
        _showReopen = true;
    }

    private async Task ConfirmReopen()
    {
        if (string.IsNullOrWhiteSpace(_reopenReason)) { Snackbar.Add("재오픈 사유를 입력해주세요.", Severity.Warning); return; }
        _showReopen = false;
        var ok = await ClosingSvc.ReopenAsync(_reopenYm, _reopenReason);
        if (ok) { Snackbar.Add($"{FormatYm(_reopenYm)} 재오픈 완료", Severity.Success); await LoadAsync(); }
        else Snackbar.Add("재오픈 실패 — 이후 월이 마감 상태인지 확인해주세요.", Severity.Error);
    }

    private static string FormatYm(string ym) =>
        ym.Length == 6 ? $"{ym[..4]}년 {ym[4..]}월" : ym;
}
