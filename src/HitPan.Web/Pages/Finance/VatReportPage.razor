@page "/accounting/vat"
@namespace HitPan.Web.Pages.FinanceUi
@attribute [Authorize]
@using HitPan.Web.Models
@using HitPan.Web.Services
@inject FinanceClientService FinSvc
@inject IJSRuntime Js
@inject ISnackbar Snackbar

<PageTitle>부가세 신고자료</PageTitle>
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px" class="no-print">
    <MudText Typo="Typo.h6">부가세 신고자료</MudText>
</div>

<!-- 년도/반기 필터 + 추출 버튼 -->
<MudPaper Elevation="0" Class="pa-2 mb-3 no-print hitpan-card">
    <MudGrid Spacing="2" Class="pa-2 align-center">
        <MudItem xs="6" md="2">
            <MudNumericField T="int" Label="년도" @bind-Value="_year" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="6" md="2">
            <MudSelect T="int" Label="반기" @bind-Value="_half" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="1">상반기 (1~6월)</MudSelectItem>
                <MudSelectItem Value="2">하반기 (7~12월)</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="8" Class="d-flex gap-2 flex-wrap">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Search" OnClick="LoadAsync">조회</MudButton>
            <MudDivider Vertical="true" FlexItem="true" Class="mx-2" />
            <MudButton Variant="Variant.Outlined" Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.PictureAsPdf"
                       OnClick="ExportPdfAsync" Disabled="@(_vat is null)">
                PDF (시각화+텍스트)
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Success"
                       StartIcon="@Icons.Material.Filled.TableChart"
                       OnClick="ExportExcelAsync" Disabled="@(_vat is null)">
                엑셀 (텍스트)
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Print"
                       OnClick="PrintAsync" Disabled="@(_vat is null)">
                인쇄
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@* 인쇄/PDF용 상단 타이틀 (화면에서는 숨김, 인쇄할 때만 보임) *@
<div class="print-only" style="display:none;text-align:center;margin-bottom:16px">
    <h2 style="margin:0;font-weight:700">부가세 신고자료</h2>
    @if (_vat is not null)
    {
        <p style="margin:4px 0;color:#555">@_vat.Period · 출력일 @DateTime.Now.ToString("yyyy-MM-dd HH:mm")</p>
    }
</div>

@if (_vat is not null)
{
    <!-- KPI 카드 3개: 매출세액, 매입세액, 납부/환급세액 -->
    <MudGrid Spacing="3" Class="mb-3">
        <MudItem xs="12" md="4">
            <MudPaper Elevation="0" Class="pa-4 hitpan-card" Style="border-left:4px solid var(--hitpan-primary)">
                <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)">매출세액</MudText>
                <MudText Typo="Typo.h5" Style="font-weight:700;color:var(--hitpan-primary)">₩@_vat.SalesVat.ToString("N0")</MudText>
                <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary)">공급가액 ₩@_vat.SalesSupply.ToString("N0") / @_vat.SalesCount 건</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Elevation="0" Class="pa-4 hitpan-card" Style="border-left:4px solid var(--hitpan-warning)">
                <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)">매입세액</MudText>
                <MudText Typo="Typo.h5" Style="font-weight:700;color:var(--hitpan-warning)">₩@_vat.PurchaseVat.ToString("N0")</MudText>
                <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary)">공급가액 ₩@_vat.PurchaseSupply.ToString("N0") / @_vat.PurchaseCount 건</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Elevation="0" Class="pa-4 hitpan-card" Style="@($"border-left:4px solid {(_vat.NetVat >= 0 ? "var(--hitpan-error)" : "var(--hitpan-info)")}")">
                <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)">@(_vat.NetVat >= 0 ? "납부세액" : "환급세액")</MudText>
                <MudText Typo="Typo.h5" Style="@($"font-weight:700;color:{(_vat.NetVat >= 0 ? "var(--hitpan-error)" : "var(--hitpan-info)")}")">₩@Math.Abs(_vat.NetVat).ToString("N0")</MudText>
                <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary)">매출세액 - 매입세액</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <!-- 차트 영역: 파이차트 + 바차트 -->
    <MudGrid Spacing="3" Class="mb-3">
        <MudItem xs="12" md="5">
            <MudPaper Elevation="0" Class="pa-4 hitpan-card">
                <MudText Typo="Typo.subtitle2" Class="mb-2" Style="font-weight:600">매출·매입 비율</MudText>
                <ApexChart TItem="VatChartItem" Options="@_pieOptions" Height="280">
                    <ApexPointSeries TItem="VatChartItem"
                                     Items="_pieItems"
                                     SeriesType="SeriesType.Donut"
                                     XValue="@(e => e.Label)"
                                     YValue="@(e => e.Amount)"
                                     OrderByDescending="@(e => e.Y)" />
                </ApexChart>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="7">
            <MudPaper Elevation="0" Class="pa-4 hitpan-card">
                <MudText Typo="Typo.subtitle2" Class="mb-2" Style="font-weight:600">매출세액 vs 매입세액 비교</MudText>
                <ApexChart TItem="VatChartItem" Options="@_barOptions" Height="280">
                    <ApexPointSeries TItem="VatChartItem"
                                     Items="_barItems"
                                     SeriesType="SeriesType.Bar"
                                     XValue="@(e => e.Label)"
                                     YValue="@(e => e.Amount)" />
                </ApexChart>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <!-- 기존 상세 테이블 (스타일 개선) -->
    <MudPaper Elevation="0" Class="pa-4 hitpan-card">
        <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight:600">@_vat.Period 상세</MudText>
        <MudGrid Spacing="3">
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.subtitle2" Style="color:var(--hitpan-primary);font-weight:600">매출</MudText>
                <MudSimpleTable Dense="true" Class="mt-2" Style="border-radius:8px;overflow:hidden">
                    <tbody>
                        <tr><td>건수</td><td style="text-align:right;font-weight:500">@_vat.SalesCount 건</td></tr>
                        <tr><td>공급가액</td><td style="text-align:right">₩@_vat.SalesSupply.ToString("N0")</td></tr>
                        <tr style="background:var(--hitpan-primary-soft)"><td style="font-weight:600">매출세액</td><td style="text-align:right;font-weight:600;color:var(--hitpan-primary)">₩@_vat.SalesVat.ToString("N0")</td></tr>
                    </tbody>
                </MudSimpleTable>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.subtitle2" Style="color:var(--hitpan-warning);font-weight:600">매입</MudText>
                <MudSimpleTable Dense="true" Class="mt-2" Style="border-radius:8px;overflow:hidden">
                    <tbody>
                        <tr><td>건수</td><td style="text-align:right;font-weight:500">@_vat.PurchaseCount 건</td></tr>
                        <tr><td>공급가액</td><td style="text-align:right">₩@_vat.PurchaseSupply.ToString("N0")</td></tr>
                        <tr style="background:var(--hitpan-warning-soft)"><td style="font-weight:600">매입세액</td><td style="text-align:right;font-weight:600;color:var(--hitpan-warning)">₩@_vat.PurchaseVat.ToString("N0")</td></tr>
                    </tbody>
                </MudSimpleTable>
            </MudItem>
        </MudGrid>
        <MudDivider Class="my-3" />
        <div style="text-align:center;padding:12px;background:@(_vat.NetVat >= 0 ? "var(--hitpan-error-soft)" : "var(--hitpan-info-soft)");border-radius:8px">
            <MudText Typo="Typo.h5" Style="@($"font-weight:700;color:{(_vat.NetVat >= 0 ? "var(--hitpan-error)" : "var(--hitpan-info)")}")">
                @(_vat.NetVat >= 0 ? "납부세액" : "환급세액"): ₩@Math.Abs(_vat.NetVat).ToString("N0")
            </MudText>
        </div>
    </MudPaper>
}

@code {
    // 부가세 요약 데이터
    private VatSummaryModel? _vat;
    private int _year = DateTime.Today.Year;
    private int _half = DateTime.Today.Month <= 6 ? 1 : 2;

    // 차트 데이터 모델
    private class VatChartItem
    {
        public string Label { get; set; } = string.Empty;
        public decimal Amount { get; set; }
    }

    // 차트 아이템
    private List<VatChartItem> _pieItems = new();
    private List<VatChartItem> _barItems = new();

    // 파이(도넛) 차트 옵션
    private ApexChartOptions<VatChartItem> _pieOptions = new()
    {
        Chart = new Chart { Background = "transparent" },
        Colors = new List<string> { "#0F6E56", "#F57C00" },
        Legend = new Legend { Position = LegendPosition.Bottom }
    };

    // 바 차트 옵션
    private ApexChartOptions<VatChartItem> _barOptions = new()
    {
        Chart = new Chart { Background = "transparent" },
        Colors = new List<string> { "#0F6E56", "#F57C00" },
        PlotOptions = new PlotOptions
        {
            Bar = new PlotOptionsBar { Horizontal = false, ColumnWidth = "50%" }
        }
    };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _vat = await FinSvc.GetVatAsync(_year, _half);
        BuildChartData();
        StateHasChanged();
    }

    /// <summary>차트 데이터 구성</summary>
    private void BuildChartData()
    {
        if (_vat is null) return;

        _pieItems = new List<VatChartItem>
        {
            new() { Label = "매출세액", Amount = _vat.SalesVat },
            new() { Label = "매입세액", Amount = _vat.PurchaseVat }
        };

        _barItems = new List<VatChartItem>
        {
            new() { Label = "매출세액", Amount = _vat.SalesVat },
            new() { Label = "매입세액", Amount = _vat.PurchaseVat }
        };
    }

    /// <summary>PDF 내보내기 — 브라우저 인쇄 다이얼로그로 차트+텍스트 모두 PDF 저장</summary>
    private async Task ExportPdfAsync()
    {
        if (_vat is null) return;
        await Js.InvokeVoidAsync("print");
        Snackbar.Add("PDF 내보내기: 인쇄 창에서 '대상 → PDF로 저장'을 선택하세요.", Severity.Info);
    }

    /// <summary>인쇄</summary>
    private async Task PrintAsync()
    {
        if (_vat is null) return;
        await Js.InvokeVoidAsync("print");
    }

    /// <summary>엑셀(CSV) 내보내기 — 텍스트 상세 데이터</summary>
    private async Task ExportExcelAsync()
    {
        if (_vat is null) return;

        var netLabel = _vat.NetVat >= 0 ? "납부세액" : "환급세액";
        var csv = new System.Text.StringBuilder();
        csv.AppendLine("부가세 신고자료");
        csv.AppendLine($"기간,{_vat.Period}");
        csv.AppendLine($"출력일,{DateTime.Now:yyyy-MM-dd HH:mm}");
        csv.AppendLine();
        csv.AppendLine("구분,건수,공급가액,세액");
        csv.AppendLine($"매출,{_vat.SalesCount},{_vat.SalesSupply},{_vat.SalesVat}");
        csv.AppendLine($"매입,{_vat.PurchaseCount},{_vat.PurchaseSupply},{_vat.PurchaseVat}");
        csv.AppendLine();
        csv.AppendLine($"{netLabel},{Math.Abs(_vat.NetVat)}");

        // UTF-8 BOM 포함 (한글 엑셀 호환)
        var bytes = System.Text.Encoding.UTF8.GetPreamble()
            .Concat(System.Text.Encoding.UTF8.GetBytes(csv.ToString())).ToArray();
        var base64 = Convert.ToBase64String(bytes);
        var fileName = $"부가세신고자료_{_year}년_{(_half == 1 ? "상반기" : "하반기")}.csv";
        await Js.InvokeVoidAsync("eval",
            $"{{var a=document.createElement('a');a.href='data:text/csv;base64,{base64}';a.download='{fileName}';a.click();}}");
        Snackbar.Add("엑셀(CSV) 내보내기 완료", Severity.Success);
    }
}

@* 인쇄 전용 스타일 — 버튼/필터 숨기고 타이틀 표시 *@
<style>
    @@media print {
        .no-print { display: none !important; }
        .print-only { display: block !important; }
    }
</style>
