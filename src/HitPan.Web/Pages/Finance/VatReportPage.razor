@page "/accounting/vat"
@namespace HitPan.Web.Pages.FinanceUi
@attribute [Authorize]
@using HitPan.Web.Models
@using HitPan.Web.Services
@inject FinanceClientService FinSvc

<PageTitle>부가세 신고자료</PageTitle>
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
    <MudText Typo="Typo.h6">부가세 신고자료</MudText>
</div>

<!-- 년도/반기 필터 -->
<MudPaper Elevation="0" Class="pa-2 mb-3" Style="border:0.5px solid var(--mud-palette-lines-default);border-radius:12px">
    <MudGrid Spacing="2" Class="pa-2">
        <MudItem xs="6" md="2">
            <MudNumericField T="int" Label="년도" @bind-Value="_year" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="6" md="2">
            <MudSelect T="int" Label="반기" @bind-Value="_half" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="1">상반기 (1~6월)</MudSelectItem>
                <MudSelectItem Value="2">하반기 (7~12월)</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="2"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadAsync">조회</MudButton></MudItem>
    </MudGrid>
</MudPaper>

@if (_vat is not null)
{
    <!-- KPI 카드 3개: 매출세액, 매입세액, 납부/환급세액 -->
    <MudGrid Spacing="3" Class="mb-3">
        <MudItem xs="12" md="4">
            <MudPaper Elevation="0" Class="pa-4" Style="border:0.5px solid var(--mud-palette-lines-default);border-radius:12px;border-left:4px solid #0F6E56">
                <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)">매출세액</MudText>
                <MudText Typo="Typo.h5" Style="font-weight:700;color:#0F6E56">₩@_vat.SalesVat.ToString("N0")</MudText>
                <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary)">공급가액 ₩@_vat.SalesSupply.ToString("N0") / @_vat.SalesCount 건</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Elevation="0" Class="pa-4" Style="border:0.5px solid var(--mud-palette-lines-default);border-radius:12px;border-left:4px solid #F57C00">
                <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)">매입세액</MudText>
                <MudText Typo="Typo.h5" Style="font-weight:700;color:#F57C00">₩@_vat.PurchaseVat.ToString("N0")</MudText>
                <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary)">공급가액 ₩@_vat.PurchaseSupply.ToString("N0") / @_vat.PurchaseCount 건</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Elevation="0" Class="pa-4" Style="@($"border:0.5px solid var(--mud-palette-lines-default);border-radius:12px;border-left:4px solid {(_vat.NetVat >= 0 ? "#D32F2F" : "#1976D2")}")">
                <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)">@(_vat.NetVat >= 0 ? "납부세액" : "환급세액")</MudText>
                <MudText Typo="Typo.h5" Style="@($"font-weight:700;color:{(_vat.NetVat >= 0 ? "#D32F2F" : "#1976D2")}")">₩@Math.Abs(_vat.NetVat).ToString("N0")</MudText>
                <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary)">매출세액 - 매입세액</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <!-- 차트 영역: 파이차트 + 바차트 -->
    <MudGrid Spacing="3" Class="mb-3">
        <MudItem xs="12" md="5">
            <MudPaper Elevation="0" Class="pa-4" Style="border:0.5px solid var(--mud-palette-lines-default);border-radius:12px">
                <MudText Typo="Typo.subtitle2" Class="mb-2" Style="font-weight:600">매출·매입 비율</MudText>
                <ApexChart TItem="VatChartItem" Options="@_pieOptions" Height="280">
                    <ApexPointSeries TItem="VatChartItem"
                                     Items="_pieItems"
                                     SeriesType="SeriesType.Donut"
                                     XValue="@(e => e.Label)"
                                     YValue="@(e => e.Amount)"
                                     OrderByDescending="@(e => e.Y)" />
                </ApexChart>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="7">
            <MudPaper Elevation="0" Class="pa-4" Style="border:0.5px solid var(--mud-palette-lines-default);border-radius:12px">
                <MudText Typo="Typo.subtitle2" Class="mb-2" Style="font-weight:600">매출세액 vs 매입세액 비교</MudText>
                <ApexChart TItem="VatChartItem" Options="@_barOptions" Height="280">
                    <ApexPointSeries TItem="VatChartItem"
                                     Items="_barItems"
                                     SeriesType="SeriesType.Bar"
                                     XValue="@(e => e.Label)"
                                     YValue="@(e => e.Amount)" />
                </ApexChart>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <!-- 기존 상세 테이블 (스타일 개선) -->
    <MudPaper Elevation="0" Class="pa-4" Style="border:0.5px solid var(--mud-palette-lines-default);border-radius:12px">
        <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight:600">@_vat.Period 상세</MudText>
        <MudGrid Spacing="3">
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.subtitle2" Style="color:#0F6E56;font-weight:600">매출</MudText>
                <MudSimpleTable Dense="true" Class="mt-2" Style="border-radius:8px;overflow:hidden">
                    <tbody>
                        <tr><td>건수</td><td style="text-align:right;font-weight:500">@_vat.SalesCount 건</td></tr>
                        <tr><td>공급가액</td><td style="text-align:right">₩@_vat.SalesSupply.ToString("N0")</td></tr>
                        <tr style="background:#E8F5E9"><td style="font-weight:600">매출세액</td><td style="text-align:right;font-weight:600;color:#0F6E56">₩@_vat.SalesVat.ToString("N0")</td></tr>
                    </tbody>
                </MudSimpleTable>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.subtitle2" Style="color:#F57C00;font-weight:600">매입</MudText>
                <MudSimpleTable Dense="true" Class="mt-2" Style="border-radius:8px;overflow:hidden">
                    <tbody>
                        <tr><td>건수</td><td style="text-align:right;font-weight:500">@_vat.PurchaseCount 건</td></tr>
                        <tr><td>공급가액</td><td style="text-align:right">₩@_vat.PurchaseSupply.ToString("N0")</td></tr>
                        <tr style="background:#FFF3E0"><td style="font-weight:600">매입세액</td><td style="text-align:right;font-weight:600;color:#F57C00">₩@_vat.PurchaseVat.ToString("N0")</td></tr>
                    </tbody>
                </MudSimpleTable>
            </MudItem>
        </MudGrid>
        <MudDivider Class="my-3" />
        <div style="text-align:center;padding:12px;background:@(_vat.NetVat >= 0 ? "#FFEBEE" : "#E3F2FD");border-radius:8px">
            <MudText Typo="Typo.h5" Style="@($"font-weight:700;color:{(_vat.NetVat >= 0 ? "#D32F2F" : "#1976D2")}")">
                @(_vat.NetVat >= 0 ? "납부세액" : "환급세액"): ₩@Math.Abs(_vat.NetVat).ToString("N0")
            </MudText>
        </div>
    </MudPaper>
}

@code {
    // 부가세 요약 데이터
    private VatSummaryModel? _vat;
    private int _year = DateTime.Today.Year;
    private int _half = DateTime.Today.Month <= 6 ? 1 : 2;

    // 차트 데이터 모델
    private class VatChartItem
    {
        public string Label { get; set; } = string.Empty;
        public decimal Amount { get; set; }
    }

    // 차트 아이템
    private List<VatChartItem> _pieItems = new();
    private List<VatChartItem> _barItems = new();

    // 파이(도넛) 차트 옵션
    private ApexChartOptions<VatChartItem> _pieOptions = new()
    {
        Chart = new Chart { Background = "transparent" },
        Colors = new List<string> { "#0F6E56", "#F57C00" },
        Legend = new Legend { Position = LegendPosition.Bottom }
    };

    // 바 차트 옵션
    private ApexChartOptions<VatChartItem> _barOptions = new()
    {
        Chart = new Chart { Background = "transparent" },
        Colors = new List<string> { "#0F6E56", "#F57C00" },
        PlotOptions = new PlotOptions
        {
            Bar = new PlotOptionsBar { Horizontal = false, ColumnWidth = "50%" }
        }
    };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _vat = await FinSvc.GetVatAsync(_year, _half);
        BuildChartData();
        StateHasChanged();
    }

    /// <summary>차트 데이터 구성</summary>
    private void BuildChartData()
    {
        if (_vat is null) return;

        _pieItems = new List<VatChartItem>
        {
            new() { Label = "매출세액", Amount = _vat.SalesVat },
            new() { Label = "매입세액", Amount = _vat.PurchaseVat }
        };

        _barItems = new List<VatChartItem>
        {
            new() { Label = "매출세액", Amount = _vat.SalesVat },
            new() { Label = "매입세액", Amount = _vat.PurchaseVat }
        };
    }
}
