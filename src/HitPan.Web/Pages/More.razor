@page "/more"
@attribute [Authorize]
@inject NavigationManager Nav
@inject WorkTabService TabService
@inject IJSRuntime JS
@using HitPan.Web.Models
@using HitPan.Web.Services

<PageTitle>전체 메뉴</PageTitle>

<div class="hp-menu-page">
    <div class="hp-menu-groups">
        @foreach (var group in _groups)
        {
            var isOpen = _openGroup == group.Key;
            <div class="hp-menu-folder @(isOpen ? "hp-menu-folder--open" : "")"
                 @onclick="@(() => ToggleGroup(group.Key))">

                <div class="hp-menu-folder-header">
                    <div class="hp-menu-folder-icon" style="background:@group.BgColor;">
                        <MudIcon Icon="@group.MudIcon" Style="@($"font-size:20px;color:{group.IconColor};")" />
                    </div>
                    <span class="hp-menu-folder-title">@group.Title</span>
                    @if (!isOpen && group.QuickItem is { } qi)
                    {
                        <button type="button" class="hp-menu-quick-btn"
                                @onclick:stopPropagation="true"
                                @onclick="@(() => Navigate(qi))">@qi.Title</button>
                    }
                    <div class="hp-menu-folder-chevron @(isOpen ? "hp-menu-folder-chevron--open" : "")">
                        <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Style="font-size:18px;color:#999;" />
                    </div>
                </div>

                <div class="hp-menu-folder-items @(isOpen ? "hp-menu-folder-items--open" : "")">
                    @foreach (var item in group.Items)
                    {
                        <button type="button" class="hp-menu-item"
                                @onclick:stopPropagation="true"
                                @onclick="@(() => Navigate(item))">
                            <div class="hp-menu-item-icon">
                                <MudIcon Icon="@item.MudIcon" Style="@($"font-size:20px;color:{group.IconColor};")" />
                            </div>
                            <span class="hp-menu-item-label">@item.Title</span>
                        </button>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    private string? _openGroup;
    private bool _isMobile;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isMobile = await JS.InvokeAsync<bool>("eval", "window.innerWidth <= 767");
            StateHasChanged();
        }
    }

    private void ToggleGroup(string key) =>
        _openGroup = _openGroup == key ? null : key;

    private void Navigate(MenuEntry item)
    {
        // 모바일에서는 모바일 카드 목록 경로가 있으면 그쪽으로 이동
        if (_isMobile && !string.IsNullOrEmpty(item.MobileHref))
        {
            Nav.NavigateTo(item.MobileHref);
            return;
        }
        if (item.TabKind is { } kind)
            TabService.TryAddTab(kind);
        if (!string.IsNullOrEmpty(item.Href) && item.Href != "#")
            Nav.NavigateTo(item.Href);
    }

    private sealed record MenuEntry(
        string Title, string MudIcon, string Href,
        WorkDocumentKind? TabKind = null,
        string? MobileHref = null);

