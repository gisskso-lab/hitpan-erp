@page "/more"
@attribute [Authorize]
@inject NavigationManager Nav
@inject WorkTabService TabService
@using HitPan.Web.Models
@using HitPan.Web.Services

<PageTitle>전체 메뉴</PageTitle>

<div class="hp-menu-page">

    @* 대메뉴 폴더 그리드 *@
    <div class="hp-menu-groups">
        @foreach (var group in _groups)
        {
            <div class="hp-menu-folder @(_openGroup == group.Title ? "hp-menu-folder--open" : "")"
                 @onclick="@(() => ToggleGroup(group.Title))">
                <div class="hp-menu-folder-header">
                    <div class="hp-menu-folder-icon">
                        <MudIcon Icon="@group.Icon" Style="font-size:22px;" />
                    </div>
                    <span class="hp-menu-folder-title">@group.Title</span>
                    <MudIcon Icon="@(_openGroup == group.Title ? Icons.Material.Filled.KeyboardArrowUp : Icons.Material.Filled.KeyboardArrowDown)"
                             Style="font-size:18px;color:var(--mud-palette-text-secondary);" />
                </div>

                @if (_openGroup == group.Title)
                {
                    <div class="hp-menu-folder-items">
                        @foreach (var item in group.Items)
                        {
                            <button type="button" class="hp-menu-item" @onclick:stopPropagation="true" @onclick="@(() => Navigate(item))">
                                <div class="hp-menu-item-icon">
                                    <MudIcon Icon="@item.Icon" Style="font-size:20px;" />
                                </div>
                                <span class="hp-menu-item-label">@item.Title</span>
                                @if (item.Badge is not null)
                                {
                                    <span class="hp-menu-item-badge">@item.Badge</span>
                                }
                            </button>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private string? _openGroup;

    private void ToggleGroup(string title) =>
        _openGroup = _openGroup == title ? null : title;

    private void Navigate(MenuEntry item)
    {
        if (item.TabKind is { } kind)
        {
            TabService.TryAddTab(kind);
        }
        Nav.NavigateTo(item.Href);
    }

    private sealed record MenuEntry(string Title, string Icon, string Href, WorkDocumentKind? TabKind = null, string? Badge = null);
    private sealed record MenuGroup(string Title, string Icon, MenuEntry[] Items);

