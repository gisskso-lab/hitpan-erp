@page "/items"
@namespace HitPan.Web.Pages.ItemMasterUi
@attribute [Authorize]
@inject ItemMasterService ItemsApi
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject GridExportService GridExport
@inject IJSRuntime Js
@inject IDialogService DialogService
@inject BomService BomApi
@inject DeliveryService DeliveryService

<PageTitle>상품 마스터</PageTitle>

<PageHeader Title="상품 마스터" Subtitle="단품 · 조립(BOM) · 1+1 기획상품 통합 관리">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreate">
            + 상품 등록
        </MudButton>
    </Actions>
</PageHeader>

@* 사장님 헌법 (2026-04-27): 안전재고 미달 자재가 평소에도 사장님 눈에 띄어야 함.
   상품마스터가 평소 안전망. stock_alerts 'pending' 을 읽어서 배너로 노출.
   배너 클릭 → 자동발주 다이얼로그 → 발주서/매입확정/원클릭 사슬 *@
@if (_safetyAlerts.Count > 0)
{
    <MudPaper Elevation="0" Class="pa-3 mb-4"
              Style="background:#fff4e5;border:1px solid #ff9800;border-radius:12px">
        <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Medium" />
            <div style="flex:1;min-width:200px">
                <MudText Typo="Typo.subtitle1" Style="font-weight:600">
                    안전재고 미달 자재 @_safetyAlerts.Count 건
                </MudText>
                <MudText Typo="Typo.body2" Style="color:#666">
                    @string.Join(" · ", _safetyAlerts.Take(3).Select(a => $"{a.ItemName} (현재고 {a.CurrentQty:N0} / 안전재고 {a.SafetyQty:N0})"))
                    @(_safetyAlerts.Count > 3 ? $" 외 {_safetyAlerts.Count - 3}건" : "")
                </MudText>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.ShoppingCart"
                       OnClick="OpenSafetyAutoOrderAsync"
                       Disabled="_orderingSafety">
                @(_orderingSafety ? "처리중..." : "자동발주 실행")
            </MudButton>
        </div>
    </MudPaper>
}

@* 신규 (2026-08-25, 20260825작1 W3, 사장님 지시):
   "자동발주만 된 품목은 «...자동발주 되었습니다. 매입처리 하셔야 재고에 반영됩니다.
    매입처리 하시겠습니까?» 라고 알림메시지 뜨도록 → 매입처리 될 때까지"
   🔴 스낵바가 아니라 배너다 — 몇 초 뒤 사라지면 "매입처리 될 때까지" 가 안 된다.
   매입확정하면 서버가 알림을 닫으므로 이 배너는 저절로 사라진다(새 코드 불필요). *@
@if (_orderedAlerts.Count > 0)
{
    <MudPaper Elevation="0" Class="pa-3 mb-4"
              Style="background:#e3f2fd;border:1px solid #1976d2;border-radius:12px">
        <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
            <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Color="Color.Info" Size="Size.Medium" />
            <div style="flex:1;min-width:200px">
                <MudText Typo="Typo.subtitle1" Style="font-weight:600">
                    재고부족품목 @AlertNames(_orderedAlerts)이(가) 자동발주 되었습니다.
                </MudText>
                <MudText Typo="Typo.body2" Style="color:#666">
                    매입처리 하셔야 재고에 반영됩니다.
                </MudText>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Info"
                       StartIcon="@Icons.Material.Filled.Inventory"
                       @* 🔴 라우트 실측 확인: PurchaseOrderPage.razor:1 == "/purchase-orders".
                          "/purchase/orders" 로 적으면 빈 화면으로 간다 — 추측 금지. *@
                       OnClick="@(() => Nav.NavigateTo("/purchase-orders"))">
                매입처리 하러 가기
            </MudButton>
        </div>
    </MudPaper>
}

@* 사장님 지시: "자동 사슬 처리 한 항목은 «...매입처리까지 완료되어 재고에 반영되었습니다.»
   라고 30분간 메시지 뜨도록" — 30분 자르기는 서버가 한다(매입확정 시각 기준). *@
@if (_chainedAlerts.Count > 0)
{
    <MudPaper Elevation="0" Class="pa-3 mb-4"
              Style="background:#e8f5e9;border:1px solid #2e7d32;border-radius:12px">
        <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Medium" />
            <MudText Typo="Typo.subtitle1" Style="font-weight:600;flex:1;min-width:200px">
                재고부족품목 @AlertNames(_chainedAlerts) 매입처리까지 완료되어 재고에 반영되었습니다.
            </MudText>
        </div>
    </MudPaper>
}

<MudPaper Elevation="0" Class="pa-3 mb-4 hitpan-card">
    <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:center">
        <MudTextField @bind-Value="_search"
                      Placeholder="상품명·코드 검색"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Style="min-width:200px"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      OnKeyUp="OnSearchKeyUp" />
        <MudSelect T="string"
                   @bind-Value="_typeFilter"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Style="min-width:120px"
                   Label="유형">
            <MudSelectItem Value="@("")">전체</MudSelectItem>
            <MudSelectItem Value="@("product")">상품</MudSelectItem>
            <MudSelectItem Value="@("material")">자재</MudSelectItem>
            <MudSelectItem Value="@("semi_finished")">반제품</MudSelectItem>
            <MudSelectItem Value="@("finished")">완제품</MudSelectItem>
        </MudSelect>
        <MudButton Variant="Variant.Outlined" OnClick="Search">검색</MudButton>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.TableChart" OnClick="ExportExcelAsync">엑셀</MudButton>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Print" OnClick="PrintAsync">인쇄</MudButton>
    </div>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudPaper Elevation="0" Class="hitpan-card" Style="overflow:hidden">
@*  헌법 #19·#25 정합 — 5/27 P1-5 봉합 (audit: rows=338 × buttons 5개 = 1,701개 DOM 폭탄)
    RowsPerPage 50 default + Pager로 페이지당 행 제한. 검색은 _items 전체에서 작동. *@
        <MudTable Items="_items" Dense="true" Hover="true" Striped="true" T="ItemListModel"
                  RowsPerPage="50" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>코드</MudTh>
                <MudTh>상품명</MudTh>
                <MudTh>유형</MudTh>
                <MudTh>규격</MudTh>
                <MudTh>단위</MudTh>
                <MudTh Style="text-align:right">판매단가</MudTh>
                <MudTh Style="text-align:right">현재고</MudTh>
                <MudTh>상태</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="코드">
                    <MudButton Variant="Variant.Text" Class="pa-0 text-none" OnClick="@(() => OpenDetail(context.ItemId))">@context.ItemCode</MudButton>
                </MudTd>
                <MudTd DataLabel="상품명">
                    <MudButton Variant="Variant.Text" Class="pa-0 text-none" OnClick="@(() => OpenDetail(context.ItemId))">
                        <MudText Style="font-weight:500">@context.ItemName</MudText>
                    </MudButton>
                </MudTd>
                <MudTd DataLabel="유형">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@GetTypeColor(context.ItemType)">
                        @GetTypeLabel(context.ItemType)
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="규격">@context.Spec</MudTd>
                <MudTd DataLabel="단위">@context.Unit</MudTd>
                <MudTd DataLabel="판매단가" Style="text-align:right">@context.SalePrice.ToString("N0")</MudTd>
                <MudTd DataLabel="현재고" Style="@($"text-align:right;color:{StockColor(context)}")">
                    @context.CurrentStock.ToString("N1")
                </MudTd>
                <MudTd DataLabel="상태">
                    <MudChip T="string"
                             Size="Size.Small"
                             Color="@(context.IsActive ? Color.Success : Color.Default)"
                             Variant="Variant.Text">
                        @(context.IsActive ? "정상" : "중지")
                    </MudChip>
                </MudTd>
                <MudTd>
                    <MudTooltip Text="이 상품의 BOM 자재명세서 보기">
                        <MudButton Variant="Variant.Outlined"
                                   Size="Size.Small"
                                   Color="Color.Info"
                                   StartIcon="@Icons.Material.Filled.AccountTree"
                                   OnClick="@(() => OpenBomAsync(context))">
                            BOM 보기
                        </MudButton>
                    </MudTooltip>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Size="Size.Small"
                                   OnClick="@(() => Nav.NavigateTo($"/items/{context.ItemId}"))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Size="Size.Small"
                                   Color="Color.Error"
                                   OnClick="@(() => DeleteAsync(context))" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Style="padding:24px;color:var(--mud-palette-text-secondary)">
                    등록된 상품이 없습니다
                </MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 25, 50, 100, 200 }" />
            </PagerContent>
        </MudTable>
    </MudPaper>
    <MudText Style="font-size:12px;color:var(--mud-palette-text-secondary);margin-top:8px">
        총 @_items.Count 개
    </MudText>
}

@code {
    private List<ItemListModel> _items = new();
    private bool _loading = true;
    private string _search = "";
    private string _typeFilter = "";

    // 사장님 헌법 (2026-04-27): 상품마스터 = 평소 안전망. 안전재고 미달 자재 배너 + 자동발주.
    private List<StockAlertModel> _safetyAlerts = new();
    private bool _orderingSafety = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadList();
        await LoadSafetyAlerts();
    }

    // 변경 (2026-08-25, 20260825작1 W3, 사장님 지시): 배너가 세 가지가 됐다.
    //   ① pending  = 미달 경고 (조치 필요)
    //   ② ordered  = "자동발주 되었습니다. 매입처리 하셔야 재고에 반영됩니다"
    //                🔴 매입처리 될 때까지 남는다 — 기한을 안 건다.
    //                매입확정하면 서버가 'received' 로 닫으므로 저절로 사라진다.
    //   ③ received = "매입처리까지 완료되어 재고에 반영되었습니다" — 🔴 30분간(서버가 잘라서 준다)
    //   🔴 스낵바로는 ②를 못 한다 — 몇 초 뒤 사라져서 "매입처리 될 때까지" 가 안 된다.
    private List<StockAlertModel> _orderedAlerts = new();
    private List<StockAlertModel> _chainedAlerts = new();

    private async Task LoadSafetyAlerts()
    {
        var alerts = await BomApi.GetAlertsAsync() ?? new List<StockAlertModel>();

        _safetyAlerts = alerts
            .Where(a => string.Equals(a.Status, "pending", StringComparison.OrdinalIgnoreCase))
            .ToList();
        _orderedAlerts = alerts
            .Where(a => string.Equals(a.Status, "ordered", StringComparison.OrdinalIgnoreCase))
            .ToList();
        _chainedAlerts = alerts
            .Where(a => string.Equals(a.Status, "received", StringComparison.OrdinalIgnoreCase))
            .ToList();

        StateHasChanged();
    }

    // 사장님 지시 문구 그대로 — "재고부족품목 000외 0건".
    private static string AlertNames(List<StockAlertModel> list) =>
        list.Count == 0 ? "" :
        list.Count == 1 ? list[0].ItemName
                        : $"{list[0].ItemName}외 {list.Count - 1}건";

    private async Task OpenSafetyAutoOrderAsync()
    {
        if (_safetyAlerts.Count == 0) return;

        // BOM 다이얼로그와 동일 분기. 모두 auto_receive_on_order=Y면 B-1, 아니면 B-2.
        // (StockAlertModel 에 AutoReceiveOnOrder 가 없으므로 보수적 default = B-2 발주서만.)
        var lines = string.Join("\n", _safetyAlerts.Take(5).Select(a =>
            $"• {a.ItemName} (현재고 {a.CurrentQty:N0} / 안전재고 {a.SafetyQty:N0}, 부족 {a.ShortageQty:N0})"));
        var more = _safetyAlerts.Count > 5 ? $"\n... 외 {_safetyAlerts.Count - 5}건" : "";

        var choice = await DialogService.ShowMessageBoxAsync(
            "⚠ 안전재고 미달 자동발주",
            $"아래 자재가 안전재고 미달입니다. 자동발주를 진행하시겠습니까?\n\n{lines}{more}\n\n" +
            "[발주서 생성] 자동발주서를 만들고 발주목록에 노출. 매입처리·확정은 발주목록에서 진행.\n" +
            "[자동 사슬] 발주+매입확정까지 한 번에 처리 (재고 즉시 +반영).",
            yesText: "자동 사슬", noText: "발주서 생성", cancelText: "취소");
        if (choice is null) return;

        _orderingSafety = true;
        StateHasChanged();
        try
        {
            // 봉합 (2026-08-25, 20260825작1 W2·W3, 사장님 결재):
            //   종전엔 「자동 사슬」을 골라도 OrderAlertAsync 가 발주서만 만들었다 —
            //   autoChain 은 안내문 글자에만 쓰이고 실제 분기가 없었다(사장님 실측: "발주까지 가네").
            //   이제 autoReceive 를 서버로 넘긴다. 다만 사슬을 태울지는 **서버가** 정한다:
            //   품목 스위치가 켜져 있고 '사 오는 물건' 이어야 한다(반제품은 막힌다).
            var autoChain = choice == true;
            var ordered = 0;      // 발주서만 만들어진 건
            var chained = 0;      // 매입확정까지 간 건
            var failed = 0;
            var reasons = new List<string>();

            foreach (var a in _safetyAlerts)
            {
                if (string.IsNullOrWhiteSpace(a.AlertId)) continue;
                var r = await BomApi.OrderAlertAsync(a.AlertId, autoChain);
                if (r is null || !r.OrderCreated) { failed++; continue; }

                if (r.ReceiptConfirmed) chained++; else ordered++;
                if (!string.IsNullOrWhiteSpace(r.ChainSkippedReason)) reasons.Add(r.ChainSkippedReason!);
            }

            // 사장님 지시 (8/25) 두 안내는 **배너**가 맡는다(화면 위쪽 _orderedAlerts·_chainedAlerts).
            //   스낵바로는 "매입처리 될 때까지" 를 못 한다 — 몇 초 뒤 사라진다.
            //   여기서 같은 말을 또 띄우면 배너와 겹쳐 시끄럽다. 결과 요약만 짧게 남긴다.
            if (chained + ordered > 0)
            {
                Snackbar.Add($"자동발주 {chained + ordered}건 처리했습니다.", Severity.Success);
            }

            // 🔴 사슬을 못 탄 이유는 배너가 아니라 여기서 알린다 — 그때 한 번만 알면 되는 정보다.
            //    종전엔 "N건 실패" 만 떠서 원인을 알 수 없었다.
            foreach (var reason in reasons.Distinct().Take(3))
            {
                Snackbar.Add(reason, Severity.Warning);
            }
            if (failed > 0)
            {
                Snackbar.Add($"{failed}건은 발주하지 못했습니다. 자동발주 공급처가 설정됐는지 확인해주세요.", Severity.Warning);
            }
            await LoadSafetyAlerts();
        }
        finally
        {
            _orderingSafety = false;
            StateHasChanged();
        }
    }

    private async Task LoadList()
    {
        _loading = true;
        StateHasChanged();
        // 사장님 지시 (2026-04-26 최종):
        // 상품마스터에는 모든 상품(BOM 등록된 완제품 포함) 표시. 행마다 "BOM 보기"
        // 버튼으로 BOM 매핑 있으면 BOM 화면 이동, 없으면 등록 다이얼로그 안내.
        // 자동생성 BOM- 코드 중복 행 회귀는 RegisterBomAsItemAsync 수정으로 차단됨
        // (cb2a9b5) — 따라서 excludeBom 옵션은 자재 콤비박스(순환 차단)에만 사용.
        var result = await ItemsApi.GetListAsync(
            string.IsNullOrWhiteSpace(_search) ? null : _search,
            null,
            string.IsNullOrWhiteSpace(_typeFilter) ? null : _typeFilter);
        _items = result ?? new List<ItemListModel>();
        _loading = false;
        StateHasChanged();
    }

    private async Task Search()
    {
        await LoadList();
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Search();
        }
    }

    private void OpenCreate()
    {
        Nav.NavigateTo("/items/new");
    }

    private void OpenDetail(string? itemId)
    {
        if (string.IsNullOrWhiteSpace(itemId))
        {
            return;
        }

        Nav.NavigateTo($"/items/{itemId}");
    }

    /// <summary>화면 데이터를 엑셀로 내보낸다.</summary>
    /// <remarks>
    /// 🔴 봉합 2026-08-12 — 종전에는 "준비중입니다" 스낵바만 띄우는 가짜 버튼이었다.
    /// <c>_items</c> 는 이미 서버에서 검색·유형 조건이 걸려 온 결과라 그대로 내보낸다
    /// (화면에 보이는 것과 파일이 같아야 한다).
    /// </remarks>
    private async Task ExportExcelAsync()
    {
        var headers = new[] { "코드", "상품명", "유형", "규격", "단위", "판매단가", "현재고", "상태" };

        var rows = _items.Select(i => (IReadOnlyList<object?>)new object?[]
        {
            i.ItemCode,
            i.ItemName,
            // 화면은 GetTypeLabel 로 한글 라벨을 보여준다 — 파일에 코드값(material 등)을
            //   그대로 내보내면 고객이 무슨 뜻인지 모른다. 화면과 같은 말로 적는다.
            GetTypeLabel(i.ItemType),
            i.Spec,
            i.Unit,
            i.SalePrice,
            i.CurrentStock,
            i.IsActive ? "정상" : "중지"
        }).ToList();

        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(_search)) parts.Add($"검색: {_search}");
        if (!string.IsNullOrWhiteSpace(_typeFilter)) parts.Add($"유형: {_typeFilter}");
        parts.Add($"총 {_items.Count:N0}건");

        await GridExport.ExportExcelAsync("상품 마스터", headers, rows, string.Join(" · ", parts));
    }
    /// <summary>화면을 인쇄한다. 인쇄창에서 "PDF로 저장" 을 고르면 PDF 가 된다.</summary>
    /// <remarks>
    /// 제목·조건을 같이 넘긴다 — 안 넘기면 종이에 표만 나온다 (사장님 지시 2026-08-12).
    /// ⚠️ 이 화면은 페이징이라 <b>지금 보고 있는 쪽만</b> 인쇄된다. 전부 뽑으려면 엑셀을 쓴다.
    /// </remarks>
    private async Task PrintAsync()
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(_search)) parts.Add($"검색: {_search}");
        if (!string.IsNullOrWhiteSpace(_typeFilter)) parts.Add($"유형: {_typeFilter}");
        parts.Add($"총 {_items.Count:N0}건");

        await GridExport.PrintAsync("상품 마스터", string.Join(" · ", parts));
    }

    private static string GetTypeLabel(string type) => type switch
    {
        "finished" => "완제품",
        "semi_finished" or "semi" => "반제품",
        "material" => "자재",
        "product" => "상품",
        "assembly" => "조립(BOM)",
        "promo" => "🎁 1+1 기획",
        _ => type
    };

    private static Color GetTypeColor(string type) => type switch
    {
        "finished" => Color.Primary,
        "semi_finished" or "semi" => Color.Info,
        "material" => Color.Warning,
        "assembly" => Color.Secondary,
        "promo" => Color.Error,
        _ => Color.Default
    };

    private static string StockColor(ItemListModel item) =>
        item.CurrentStock <= item.SafetyStock ? "var(--mud-palette-error)" : "inherit";

    /// <summary>
    /// 상품행 "BOM 보기" 버튼 — 해당 상품에 연결된 BOM 자재명세서로 이동.
    /// 매핑 없으면 BOM 등록 페이지(/bom/new)로 보내 새 BOM 작성을 유도.
    /// </summary>
    private async Task OpenBomAsync(ItemListModel item)
    {
        if (string.IsNullOrWhiteSpace(item.ItemId)) return;

        var bomId = await BomApi.GetBomIdByItemAsync(item.ItemId);
        if (!string.IsNullOrWhiteSpace(bomId))
        {
            Nav.NavigateTo($"/bom/{bomId}");
            return;
        }

        var go = await DialogService.ShowMessageBoxAsync(
            "BOM 자재명세서 없음",
            $"'{item.ItemName}' 에 연결된 BOM 자재명세서가 없습니다.\n새로 등록하시겠습니까?",
            yesText: "BOM 등록", cancelText: "닫기");
        if (go == true)
        {
            Nav.NavigateTo("/bom/new");
        }
    }

    private async Task DeleteAsync(ItemListModel item)
    {
        if (string.IsNullOrWhiteSpace(item.ItemId)) return;

        var confirm = await DialogService.ShowMessageBoxAsync(
            "상품 삭제",
            $"'{item.ItemName}' 상품을 삭제하시겠습니까?",
            yesText: "삭제", cancelText: "취소");
        if (confirm != true) return;

        var ok = await ItemsApi.DeleteAsync(item.ItemId);
        if (ok)
        {
            Snackbar.Add("삭제되었습니다.", Severity.Success);
            await LoadList();
        }
        else
        {
            Snackbar.Add("삭제에 실패했습니다.", Severity.Error);
        }
    }
}
