@page "/"
@attribute [Authorize]
@using System.Globalization
@inject WorkTabService TabService
@inject NavigationManager Nav

<PageTitle>대시보드 · 히트판 ERP</PageTitle>

<div class="hitpan-home">
    <MudText Typo="Typo.caption" Class="hitpan-home-date-corner mud-text-secondary">
        @TodayKorean
    </MudText>

    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="4" Class="hitpan-home-stack">
        <MudIcon Icon="@Icons.Material.Outlined.Description"
                 Color="Color.Default"
                 Class="hitpan-home-doc-icon"
                 aria-hidden="true" />

        <MudText Typo="Typo.h6" Class="hitpan-home-title">
            오늘 거래가 없습니다
        </MudText>

        <MudText Typo="Typo.body2" Class="mud-text-secondary text-center hitpan-home-sub">
            거래명세서를 작성해서 시작하세요
        </MudText>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Large"
                   Class="hitpan-home-cta"
                   OnClick="GoSalesDelivery">
            거래명세서 작성하기
        </MudButton>
    </MudStack>
</div>

@code {
    private string TodayKorean =>
        DateTime.Now.ToString("yyyy년 M월 d일 dddd", new CultureInfo("ko-KR"));

    private void GoSalesDelivery()
    {
        _ = TabService.TryAddTab(WorkDocumentKind.SalesDelivery);
        Nav.NavigateTo("/sales");
    }
}
