@page "/bom/new"
@page "/bom/{Id}"
@attribute [Authorize]
@inject BomService BomApi
@inject ItemMasterService ItemsApi
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject DeliveryService DeliveryService

<PageTitle>@(_isNew ? "BOM 등록" : "BOM 수정")</PageTitle>

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
    <MudText Typo="Typo.h6">@(_isNew ? "BOM 등록" : "BOM 수정")</MudText>
    <div style="display:flex;gap:8px">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_saving">저장</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Build"
                   OnClick="OpenAssembleDialog" Disabled="_isNew || _saving || _materials.Count == 0">조립 실행</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Undo"
                   OnClick="OpenDisassembleDialog" Disabled="_isNew || _saving || _materials.Count == 0">조립 해체</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="DeleteAsync" Disabled="_isNew || _saving">삭제</MudButton>
        <MudButton Variant="Variant.Text" OnClick="@(() => Nav.NavigateTo("/bom"))">목록으로</MudButton>
    </div>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudGrid Spacing="2">
        <!-- 상단: 기본정보 -->
        <MudItem xs="12">
            <MudPaper Class="pa-4" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default);border-radius:12px">
                <MudText Typo="Typo.subtitle1" Class="mb-2">기본정보</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="6">
                        @* 완제품명 — 새 이름 입력 (저장 시 상품마스터에 자동 등록). *@
                        @* 사장님 지시 로직: "BOM 생성 → 상품등록 확인 → 상품마스터 반영" *@
                        <MudTextField @bind-Value="_productName"
                                      Label="완제품명 (새 상품)"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Required="true"
                                      RequiredError="완제품명을 입력하세요."
                                      HelperText="저장 시 상품마스터에 자동 등록됩니다." />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="_bomName" Label="BOM 이름" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudCheckBox T="bool" @bind-Value="_isDefault" Label="기본 BOM" Color="Color.Primary" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_memo" Label="메모" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>

        <!-- 하단: 자재 목록 그리드 -->
        <MudItem xs="12">
            <MudPaper Class="pa-4" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default);border-radius:12px">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
                    <MudText Typo="Typo.subtitle1">자재 목록</MudText>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary" OnClick="AddMaterial">
                        + 자재 추가
                    </MudButton>
                </div>

                <MudPaper Elevation="0" Style="border:0.5px solid var(--mud-palette-lines-default);border-radius:8px;overflow:hidden">
                    <MudTable Items="_materials" Dense="true" Hover="true" T="MaterialRow">
                        <HeaderContent>
                            <MudTh Style="width:40px">No</MudTh>
                            <MudTh>자재명</MudTh>
                            <MudTh Style="width:80px">단위</MudTh>
                            <MudTh Style="width:100px;text-align:right">소요량</MudTh>
                            <MudTh Style="width:100px;text-align:right">Loss(%)</MudTh>
                            <MudTh Style="width:150px">메모</MudTh>
                            <MudTh Style="width:50px"></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.SeqNo</MudTd>
                            <MudTd>
                                <MudAutocomplete T="ItemOption"
                                                 @bind-Value="context.SelectedItem"
                                                 SearchFunc="SearchItems"
                                                 ToStringFunc="@(x => x?.Name ?? "")"
                                                 Variant="Variant.Text"
                                                 Margin="Margin.Dense"
                                                 Dense="true" />
                            </MudTd>
                            <MudTd>
                                <MudTextField @bind-Value="context.Unit" Variant="Variant.Text" Margin="Margin.Dense" />
                            </MudTd>
                            <MudTd>
                                <MudNumericField T="decimal" @bind-Value="context.Qty" Variant="Variant.Text" Margin="Margin.Dense" />
                            </MudTd>
                            <MudTd>
                                <MudNumericField T="decimal" @bind-Value="context.LossRate" Variant="Variant.Text" Margin="Margin.Dense" />
                            </MudTd>
                            <MudTd>
                                <MudTextField @bind-Value="context.Memo" Variant="Variant.Text" Margin="Margin.Dense" />
                            </MudTd>
                            <MudTd>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               OnClick="@(() => RemoveMaterial(context))" />
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText Style="padding:24px;color:var(--mud-palette-text-secondary)">
                                자재를 추가해주세요
                            </MudText>
                        </NoRecordsContent>
                    </MudTable>
                </MudPaper>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@* 상품등록 다이얼로그 *@
<MudDialog @bind-Visible="_showRegisterDialog" Options="new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true }">
    <TitleContent>
        <MudText Typo="Typo.h6">자재명세서 대로 상품등록 하시겠습니까?</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Class="mb-3">BOM '<strong>@_bomName</strong>'을 상품마스터에 등록합니다.</MudText>
        <MudSelect T="string" @bind-Value="_registerItemType" Label="상품 유형" Variant="Variant.Outlined" Margin="Margin.Dense">
            <MudSelectItem Value="@("semi_finished")">반제품</MudSelectItem>
            <MudSelectItem Value="@("finished")">완제품</MudSelectItem>
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="SkipRegister">나중에</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ConfirmRegister">상품 등록</MudButton>
    </DialogActions>
</MudDialog>

@* 조립 실행 다이얼로그 *@
<MudDialog @bind-Visible="_showAssembleDialog" Options="new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true }">
    <TitleContent>
        <MudText Typo="Typo.h6">조립 실행</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Class="mb-3">
            BOM '<strong>@_bomName</strong>'으로 완제품을 생산합니다.<br />
            자재 @_materials.Count 종을 BOM 비율대로 소비하고 완제품 수량만큼 재고를 증가시킵니다.
        </MudText>
        <MudNumericField T="decimal" @bind-Value="_produceQty" Label="생산 수량" Variant="Variant.Outlined"
                         Margin="Margin.Dense" Min="0.01m" HideSpinButtons="false" />
        <MudTextField @bind-Value="_assembleMemo" Label="메모 (선택)" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Class="mt-2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showAssembleDialog = false)" Disabled="_assembling">취소</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="ConfirmAssembleAsync"
                   Disabled="_assembling || _produceQty <= 0">실행</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_showDisassembleDialog" Options="new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true }">
    <TitleContent>
        <MudText Typo="Typo.h6">⚠ 조립 해체</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Class="mb-3">
            BOM '<strong>@_bomName</strong>' 완제품을 해체합니다.<br />
            완제품 수량만큼 재고가 차감되고, 자재 @_materials.Count 종이 BOM 비율대로 재고로 복귀합니다.
        </MudText>
        <MudNumericField T="decimal" @bind-Value="_disassembleQty" Label="해체 수량" Variant="Variant.Outlined"
                         Margin="Margin.Dense" Min="0.01m" HideSpinButtons="false" />
        <MudTextField @bind-Value="_disassembleMemo" Label="메모 (선택)" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Class="mt-2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showDisassembleDialog = false)" Disabled="_disassembling">취소</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="ConfirmDisassembleAsync"
                   Disabled="_disassembling || _disassembleQty <= 0">해체</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public string? Id { get; set; }

    private bool _isNew;
    private bool _loading = true;
    private bool _saving;

    // 기본정보
    private string? _selectedProductId;        // 수정 모드에서만 기존 ID 유지
    private string _productName = "";          // 신규: 완제품명(저장 시 상품마스터 자동 등록)
    private string _bomName = "";
    private bool _isDefault = true;
    private string? _memo;

    // 자재 목록
    private List<MaterialRow> _materials = new();

    // 자재 검색용 캐시
    private List<ItemOption>? _itemCache;

    // 상품등록 다이얼로그
    private bool _showRegisterDialog;
    private string? _pendingBomId;
    private string _registerItemType = "semi_finished";

    // 조립 실행 다이얼로그
    private bool _showAssembleDialog;
    private bool _assembling;
    private decimal _produceQty = 1;
    private string? _assembleMemo;

    // 조립 해체 다이얼로그
    private bool _showDisassembleDialog;
    private bool _disassembling;
    private decimal _disassembleQty = 1;
    private string? _disassembleMemo;

    protected override async Task OnParametersSetAsync()
    {
        _isNew = string.IsNullOrWhiteSpace(Id) || string.Equals(Id, "new", StringComparison.OrdinalIgnoreCase);
        _loading = true;

        if (_isNew)
        {
            _selectedProductId = null;
            _productName = "";
            _bomName = "";
            _isDefault = true;
            _memo = null;
            _materials = new();
        }
        else
        {
            var detail = await BomApi.GetAsync(Id!);
            if (detail is null)
            {
                Snackbar.Add("BOM을 찾을 수 없습니다.", Severity.Error);
                Nav.NavigateTo("/bom");
                return;
            }

            _selectedProductId = detail.ProductItemId;
            _productName = detail.ProductItemName ?? "";
            _bomName = detail.BomName;
            _isDefault = detail.IsDefault;
            _memo = detail.Memo;
            _materials = detail.Items.Select((it, idx) => new MaterialRow
            {
                SeqNo = it.SeqNo > 0 ? it.SeqNo : idx + 1,
                SelectedItem = new ItemOption { ItemId = it.MaterialItemId, Name = it.MaterialItemName },
                Unit = it.Unit,
                Qty = it.Qty,
                LossRate = it.LossRate,
                Memo = it.Memo
            }).ToList();
        }

        // _selectedProductId 셋팅 후에 자재 캐시 로딩 — 자기 자신이 자재 후보에 안 들어가도록.
        _itemCache = await LoadItemOptions();

        _loading = false;
    }

    // 자재 검색 (전체)
    private async Task<IEnumerable<ItemOption>> SearchItems(string? value, CancellationToken ct)
    {
        _itemCache ??= await LoadItemOptions();
        if (string.IsNullOrWhiteSpace(value))
            return _itemCache;
        return _itemCache.Where(x => x.Name.Contains(value, StringComparison.OrdinalIgnoreCase));
    }

    private async Task<List<ItemOption>> LoadItemOptions()
    {
        // 사장님 지시 (2026-04-26): BOM 등록한 반제품을 자재로 쓸 수 있어야 함 (다단 BOM).
        // excludeBom 제외 — 모든 활성 상품을 자재 후보로 노출.
        // 즉시 순환(자기 자신을 자재로) 만 클라이언트에서 제외, 깊은 순환은 서버
        // HasCircularRefAsync 가 저장 시점에 차단.
        var items = await ItemsApi.GetListAsync() ?? new();
        var currentProductId = _selectedProductId;
        return items
            .Where(i => string.IsNullOrEmpty(currentProductId) || i.ItemId != currentProductId)
            .Select(i => new ItemOption { ItemId = i.ItemId, Name = i.ItemName })
            .ToList();
    }

    private void AddMaterial()
    {
        _materials.Add(new MaterialRow
        {
            SeqNo = _materials.Count + 1
        });
    }

    private void RemoveMaterial(MaterialRow row)
    {
        _materials.Remove(row);
        for (int i = 0; i < _materials.Count; i++)
            _materials[i].SeqNo = i + 1;
    }

    private async Task SaveAsync()
    {
        // 신규: 완제품명 필수. 수정: 기존 ProductItemId 사용.
        if (_isNew && string.IsNullOrWhiteSpace(_productName))
        {
            Snackbar.Add("완제품명을 입력해주세요.", Severity.Warning);
            return;
        }
        if (string.IsNullOrWhiteSpace(_bomName))
        {
            Snackbar.Add("BOM 이름을 입력해주세요.", Severity.Warning);
            return;
        }
        if (!_materials.Any(m => m.SelectedItem is not null))
        {
            Snackbar.Add("자재를 1개 이상 추가해주세요.", Severity.Warning);
            return;
        }

        // 신규 저장 전 확인 다이얼로그 — 사장님 지시 흐름 "상품등록하시겠습니까? Y/N".
        if (_isNew)
        {
            var confirmRegister = await DialogService.ShowMessageBoxAsync(
                "상품등록 확인",
                $"완제품 '{_productName}' 을(를) 상품마스터에 등록하고 BOM을 저장합니다. 계속하시겠습니까?",
                yesText: "등록하고 저장",
                cancelText: "취소");
            if (confirmRegister != true) return;
        }

        var model = new CreateBomModel
        {
            ProductItemId = _selectedProductId ?? "",
            ProductItemName = _isNew ? _productName : null,
            BomName = _bomName,
            IsDefault = _isDefault,
            Memo = _memo,
            Items = _materials
                .Where(m => m.SelectedItem is not null)
                .Select(m => new CreateBomItemModel
                {
                    SeqNo = m.SeqNo,
                    MaterialItemId = m.SelectedItem!.ItemId,
                    Qty = m.Qty,
                    Unit = m.Unit,
                    LossRate = m.LossRate,
                    Memo = m.Memo
                }).ToList()
        };

        _saving = true;
        if (_isNew)
        {
            var (ok, bomId) = await BomApi.CreateAsync(model);
            _saving = false;
            if (!ok)
            {
                Snackbar.Add("BOM 등록에 실패했습니다.", Severity.Error);
                return;
            }
            Snackbar.Add("BOM이 등록되었습니다.", Severity.Success);

            // 상품등록 확인 — 반제품 or 완제품
            _pendingBomId = bomId;
            _showRegisterDialog = true;
            StateHasChanged();
            return; // 목록 이동은 다이얼로그 후에
        }
        else
        {
            var ok = await BomApi.UpdateAsync(Id!, model);
            _saving = false;
            if (!ok)
            {
                Snackbar.Add("BOM 수정에 실패했습니다.", Severity.Error);
                return;
            }
            Snackbar.Add("BOM이 수정되었습니다.", Severity.Success);
        }

        Nav.NavigateTo("/bom");
    }

    private async Task DeleteAsync()
    {
        if (_isNew) return;

        var confirm = await DialogService.ShowMessageBoxAsync(
            "BOM 삭제",
            $"'{_bomName}' BOM을 삭제하시겠습니까?",
            yesText: "삭제", cancelText: "취소");
        if (confirm != true) return;

        _saving = true;
        var ok = await BomApi.DeleteAsync(Id!);
        _saving = false;
        if (!ok)
        {
            Snackbar.Add("삭제에 실패했습니다.", Severity.Error);
            return;
        }

        Snackbar.Add("삭제되었습니다.", Severity.Success);
        Nav.NavigateTo("/bom");
    }

    private void SkipRegister()
    {
        _showRegisterDialog = false;
        Nav.NavigateTo("/bom", forceLoad: true);
    }

    private void OpenAssembleDialog()
    {
        if (_isNew || string.IsNullOrEmpty(Id))
        {
            Snackbar.Add("먼저 BOM을 저장한 뒤 조립 실행이 가능합니다.", Severity.Warning);
            return;
        }
        if (_materials.Count == 0)
        {
            Snackbar.Add("자재가 하나 이상 등록돼야 조립 실행할 수 있습니다.", Severity.Warning);
            return;
        }
        _produceQty = 1;
        _assembleMemo = null;
        _showAssembleDialog = true;
    }

    private void OpenDisassembleDialog()
    {
        if (_isNew || string.IsNullOrEmpty(Id))
        {
            Snackbar.Add("저장된 BOM 에서만 해체할 수 있습니다.", Severity.Warning);
            return;
        }
        _disassembleQty = 1;
        _disassembleMemo = null;
        _showDisassembleDialog = true;
    }

    /// <summary>
    /// 조립 해체 — 사장님 지시 (2026-04-26): 완제품 OUT + 자재 IN 으로 재고/가격 회귀.
    /// </summary>
    private async Task ConfirmDisassembleAsync()
    {
        if (string.IsNullOrEmpty(Id) || _disassembleQty <= 0) return;

        _disassembling = true;
        var (ok, err) = await BomApi.DisassembleWithErrorAsync(Id, _disassembleQty, _disassembleMemo);
        _disassembling = false;

        if (ok)
        {
            Snackbar.Add($"조립 해체 완료 — 완제품 {_disassembleQty:N0}개 차감, 자재 복귀됨.", Severity.Success);
            _showDisassembleDialog = false;
        }
        else
        {
            Snackbar.Add($"조립 해체 실패: {err ?? "알 수 없는 오류"}", Severity.Error);
        }
    }

    private async Task ConfirmAssembleAsync()
    {
        if (string.IsNullOrEmpty(Id) || _produceQty <= 0) return;

        _assembling = true;
        var (ok, err) = await BomApi.AssembleWithErrorAsync(Id, _produceQty, _assembleMemo);
        _assembling = false;

        if (ok)
        {
            Snackbar.Add($"조립 실행 완료 — 완제품 {_produceQty:N0}개 생산, 자재 소비 반영됨.", Severity.Success);
            _showAssembleDialog = false;

            // 사장님 지시 (2026-04-26): BOM 생산 직후에도 안전재고 이하/0 자재가 있으면
            // 자동발주 다이얼로그. OK 시 발주서 즉시 생성 + 발주 목록에 노출.
            await CheckAssembleAutoOrderAsync(Id);
        }
        else
        {
            Snackbar.Add($"조립 실행 실패: {err ?? "알 수 없는 오류"}", Severity.Error);
        }
    }

    /// <summary>
    /// BOM 조립 직후 자재 자동발주 후보 조회 → 다이얼로그 → OK 시 발주서 생성.
    /// 판매 자동발주(DeliveryPage.CheckAutoOrderAsync)와 같은 패턴, 같은 발주 생성 API.
    /// </summary>
    private async Task CheckAssembleAutoOrderAsync(string bomId)
    {
        var candidates = await BomApi.GetAssembleAutoOrderCandidatesAsync(bomId);
        if (candidates.Count == 0) return;

        var outOfStock = candidates.Count(c => c.Reason == "out_of_stock");
        var belowSafety = candidates.Count - outOfStock;

        var msg = new System.Text.StringBuilder();
        if (outOfStock > 0) msg.AppendLine($"재고가 없는 자재: {outOfStock}건");
        if (belowSafety > 0) msg.AppendLine($"안전재고 이하 자재: {belowSafety}건");
        msg.AppendLine();
        foreach (var c in candidates.Take(5))
        {
            msg.AppendLine($"• {c.ItemName}: 현재고 {c.CurrentQty:N0} / 안전재고 {c.SafetyQty:N0}"
                + (string.IsNullOrWhiteSpace(c.PartnerName) ? " (공급처 미설정)" : $" → {c.PartnerName}"));
        }
        if (candidates.Count > 5) msg.AppendLine($"... 외 {candidates.Count - 5}건");
        msg.AppendLine();
        msg.AppendLine("자동발주 하시겠습니까?");

        var yes = await DialogService.ShowMessageBoxAsync(
            "⚠ 자재 자동발주",
            msg.ToString(),
            yesText: "자동발주", cancelText: "닫기");
        if (yes != true) return;

        var results = await DeliveryService.CreateAutoOrdersAsync(candidates);
        var success = results.Where(r => r.Success).ToList();
        var failed = results.Where(r => !r.Success).ToList();

        if (success.Count > 0)
        {
            var noList = string.Join(", ", success.Select(r => r.PoNo));
            Snackbar.Add($"자동발주서 {success.Count}건 생성 완료: {noList}", Severity.Success);
        }
        if (failed.Count > 0)
        {
            var firstReason = failed[0].Reason ?? "사유 미상";
            Snackbar.Add($"{failed.Count}건 자동발주 실패: {firstReason[..Math.Min(150, firstReason.Length)]}", Severity.Warning);
        }
    }

    private async Task ConfirmRegister()
    {
        if (string.IsNullOrEmpty(_pendingBomId)) return;

        var ok = await BomApi.RegisterBomAsItemAsync(_pendingBomId, _registerItemType);
        _showRegisterDialog = false;

        if (ok)
        {
            var label = _registerItemType == "finished" ? "완제품" : "반제품";
            Snackbar.Add($"'{_bomName}'이 {label}으로 상품마스터에 등록되었습니다.", Severity.Success);
        }
        else
        {
            Snackbar.Add("상품 등록에 실패했습니다.", Severity.Error);
        }

        Nav.NavigateTo("/bom", forceLoad: true);
    }

    // 상품 옵션 (Autocomplete용)
    public class ItemOption
    {
        public string ItemId { get; set; } = "";
        public string Name { get; set; } = "";
        public override bool Equals(object? obj) => obj is ItemOption o && o.ItemId == ItemId;
        public override int GetHashCode() => ItemId.GetHashCode();
    }

    // 자재 행
    public class MaterialRow
    {
        public int SeqNo { get; set; }
        public ItemOption? SelectedItem { get; set; }
        public string Unit { get; set; } = "EA";
        public decimal Qty { get; set; }
        public decimal LossRate { get; set; }
        public string? Memo { get; set; }
    }
}
