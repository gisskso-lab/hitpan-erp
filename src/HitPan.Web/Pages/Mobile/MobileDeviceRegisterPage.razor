@page "/m/device-register"
@namespace HitPan.Web.Pages.MobileUi
@* 🔴 로그인 없이 들어온다 — 폰으로 QR 을 찍은 사람은 히트판 계정이 없을 수도 있다.
   토큰 자체가 열쇠다: 대표계정만 발급할 수 있고 10분 만료·1회용이다. (20260811작1 (D)) *@
@attribute [AllowAnonymous]
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>히트판 모바일기기등록</PageTitle>

@* 사장님 오더 3단계: "휴대폰으로 QR 촬영시 바로 '히트판 모바일기기등록' 화면단으로 넘어감" *@
<div class="mreg-page">
    <div class="mreg-card">

        <div class="mreg-brand">
            <img src="apple-touch-icon.png" alt="히트판" class="mreg-logo" />
            <div class="mreg-title">히트판 모바일기기등록</div>
        </div>

        @if (_state == State.Asking)
        {
            @* 사장님 오더 3단계: "모바일 기기 등록을 하시겠습니까? Y/N" *@
            <p class="mreg-ask">모바일 기기 등록을 하시겠습니까?</p>
            <p class="mreg-sub">등록하면 이 휴대폰으로 히트판을 쓸 수 있습니다.</p>

            <button class="mreg-btn mreg-btn-primary" @onclick="RegisterAsync" disabled="@_busy">
                @(_busy ? "등록 중..." : "네, 등록합니다")
            </button>
            <button class="mreg-btn mreg-btn-ghost" @onclick="Cancel" disabled="@_busy">아니오</button>
        }
        else if (_state == State.Done)
        {
            <div class="mreg-done">✓</div>
            <p class="mreg-ask">등록이 끝났습니다</p>
            <p class="mreg-sub">이제 이 휴대폰으로 히트판을 쓸 수 있습니다.</p>

            @* 사장님 오더 4·5단계: 홈화면 아이콘.
               🔴 접속 기기를 보고 **맞는 쪽만** 보여준다 — 둘 다 보이면 더 헷갈린다. *@
            @if (_isIos)
            {
                @* 아이폰·아이패드는 웹이 홈화면 추가를 자동으로 못 한다(애플 정책).
                   사용자가 직접 눌러야 하므로 그림과 함께 3단계로 안내한다.
                   ⚠️ 사장님 제안이던 "크롬 설치 후 추가" 는 안 통한다 —
                     아이폰의 크롬은 속이 사파리라 같은 제약을 받는다(사장님 확인 2026-08-11). *@
                <div class="mreg-guide">
                    <div class="mreg-guide-head">홈 화면에 히트판 추가하기</div>
                    <div class="mreg-step">
                        <span class="mreg-num">1</span>
                        <span>화면 <b>아래</b>의 공유 버튼을 누르세요</span>
                        <span class="mreg-icon-share">
                            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                                <path d="M12 3l4 4h-3v9h-2V7H8l4-4z" fill="currentColor"/>
                                <path d="M5 12v7h14v-7h-2v5H7v-5H5z" fill="currentColor"/>
                            </svg>
                        </span>
                    </div>
                    <div class="mreg-step">
                        <span class="mreg-num">2</span>
                        <span><b>홈 화면에 추가</b> 를 고르세요</span>
                    </div>
                    <div class="mreg-step">
                        <span class="mreg-num">3</span>
                        <span>오른쪽 위 <b>추가</b> 를 누르면 끝납니다</span>
                    </div>
                    <p class="mreg-note">
                        이 단계를 건너뛰어도 됩니다 — 등록은 이미 끝났습니다.
                    </p>
                </div>
            }
            else if (_canInstall)
            {
                @* 안드로이드는 브라우저가 설치 배너를 준다 — 버튼 한 번이면 된다. *@
                <button class="mreg-btn mreg-btn-primary" @onclick="AddToHomeAsync">
                    홈 화면에 추가
                </button>
                <p class="mreg-note">이 단계를 건너뛰어도 됩니다 — 등록은 이미 끝났습니다.</p>
            }
            else
            {
                <p class="mreg-note">
                    브라우저 메뉴에서 <b>홈 화면에 추가</b> 를 고르면 앱처럼 쓸 수 있습니다.
                </p>
            }

            <button class="mreg-btn mreg-btn-ghost" @onclick="GoHome">히트판 열기</button>
        }
        else if (_state == State.Failed)
        {
            <div class="mreg-fail">!</div>
            <p class="mreg-ask">등록하지 못했습니다</p>
            <p class="mreg-sub">@_error</p>
            <p class="mreg-note">
                회사 컴퓨터에서 [등록 기기 관리] → [모바일기기 등록] 을 다시 눌러 새 코드를 받아 주세요.
            </p>
        }
        else if (_state == State.Cancelled)
        {
            <p class="mreg-ask">등록하지 않았습니다</p>
            <p class="mreg-sub">필요하시면 QR 코드를 다시 찍어 주세요.</p>
        }

    </div>
</div>

<style>
    /* 폰 화면 전용 — 한 손으로 보고 한 번에 누를 수 있게 크게 잡는다 */
    .mreg-page {
        min-height: 100vh;
        display: flex; align-items: center; justify-content: center;
        background: #F4F6F8; padding: 20px;
        font-family: Pretendard, 'Noto Sans KR', -apple-system, sans-serif;
    }
    .mreg-card {
        width: 100%; max-width: 420px; background: #fff;
        border-radius: 20px; padding: 32px 24px 28px;
        box-shadow: 0 4px 24px rgba(0,0,0,.08); text-align: center;
    }
    .mreg-brand { margin-bottom: 24px; }
    .mreg-logo { width: 64px; height: 64px; border-radius: 16px; }
    .mreg-title { margin-top: 12px; font-size: 18px; font-weight: 700; color: #1A1D1F; }
    .mreg-ask { font-size: 20px; font-weight: 700; color: #1A1D1F; margin: 20px 0 8px; }
    .mreg-sub { font-size: 14px; color: #6B7280; margin-bottom: 24px; line-height: 1.5; }
    .mreg-btn {
        width: 100%; padding: 16px; border-radius: 12px; font-size: 16px;
        font-weight: 600; border: none; cursor: pointer; margin-bottom: 10px;
    }
    .mreg-btn-primary { background: #0F6E56; color: #fff; }
    .mreg-btn-primary:disabled { background: #9CA3AF; }
    .mreg-btn-ghost { background: #F4F6F8; color: #4B5563; }
    .mreg-done {
        width: 64px; height: 64px; margin: 0 auto; border-radius: 50%;
        background: #E6F4F0; color: #0F6E56; font-size: 34px; line-height: 64px; font-weight: 700;
    }
    .mreg-fail {
        width: 64px; height: 64px; margin: 0 auto; border-radius: 50%;
        background: #FEE2E2; color: #DC2626; font-size: 34px; line-height: 64px; font-weight: 700;
    }
    .mreg-guide {
        text-align: left; background: #F9FAFB; border-radius: 12px;
        padding: 16px; margin: 8px 0 16px;
    }
    .mreg-guide-head { font-size: 14px; font-weight: 700; color: #1A1D1F; margin-bottom: 12px; }
    .mreg-step {
        display: flex; align-items: center; gap: 8px;
        font-size: 14px; color: #374151; padding: 7px 0;
    }
    .mreg-num {
        flex-shrink: 0; width: 22px; height: 22px; border-radius: 50%;
        background: #0F6E56; color: #fff; font-size: 12px; font-weight: 700;
        display: inline-flex; align-items: center; justify-content: center;
    }
    .mreg-icon-share { color: #0F6E56; display: inline-flex; }
    .mreg-note { font-size: 12px; color: #9CA3AF; margin-top: 10px; line-height: 1.5; }
</style>

@code {
    private enum State { Asking, Done, Failed, Cancelled }

    private State _state = State.Asking;
    private bool _busy;
    private string _error = "";
    private bool _isIos;
    private bool _canInstall;

    [Parameter, SupplyParameterFromQuery(Name = "t")]
    public string? Token { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(Token))
        {
            _error = "등록 코드가 없습니다. QR 코드를 다시 찍어 주세요.";
            _state = State.Failed;
            return;
        }

        // 어떤 기기인지 확인해 홈화면 안내를 갈라 보여준다.
        try
        {
            _isIos = await JS.InvokeAsync<bool>("hitpanDevice.isIos");
            _canInstall = await JS.InvokeAsync<bool>("hitpanDevice.canInstallPrompt");
        }
        catch (Exception ex)
        {
            // 헌법 #15 — 흔적은 남기되 등록 자체를 막지 않는다.
            Console.Error.WriteLine($"[HP15][MobileRegister] {ex.GetType().Name}: {ex.Message}");
        }
    }

    private async Task RegisterAsync()
    {
        _busy = true;
        try
        {
            // 지문 — 이미 쓰고 있는 기기 지문 스크립트를 그대로 쓴다(진실원 하나).
            string fingerprint;
            try
            {
                fingerprint = await JS.InvokeAsync<string>("hitpanDevice.getFingerprint");
            }
            catch
            {
                // 지문을 못 만들면 등록을 못 한다 — 무엇으로 그 폰을 알아볼지가 없어진다.
                _error = "이 브라우저에서는 기기를 알아볼 수 없습니다. 사파리나 크롬으로 다시 시도해 주세요.";
                _state = State.Failed;
                return;
            }

            var name = await JS.InvokeAsync<string>("hitpanDevice.getDeviceName");

            var resp = await Http.PostAsJsonAsync("api/devices/mobile-register", new
            {
                token = Token,
                deviceName = name,
                fingerprint
            });

            if (resp.IsSuccessStatusCode)
            {
                _state = State.Done;
            }
            else
            {
                var body = await resp.Content.ReadFromJsonAsync<ApiMessage>();
                _error = body?.Message ?? "잠시 후 다시 시도해 주세요.";
                _state = State.Failed;
            }
        }
        catch (Exception ex)
        {
            _error = "연결이 되지 않았습니다. 회사 인터넷에 연결되어 있는지 확인해 주세요.";
            Console.Error.WriteLine($"[HP15][MobileRegister] {ex.GetType().Name}: {ex.Message}");
            _state = State.Failed;
        }
        finally
        {
            _busy = false;
        }
    }

    private void Cancel() => _state = State.Cancelled;

    private void GoHome() => Nav.NavigateTo("/", forceLoad: true);

    private async Task AddToHomeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("hitpanDevice.promptInstall");
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[HP15][MobileRegister/Install] {ex.GetType().Name}: {ex.Message}");
        }
    }

    private sealed class ApiMessage
    {
        public string? Message { get; set; }
    }
}
