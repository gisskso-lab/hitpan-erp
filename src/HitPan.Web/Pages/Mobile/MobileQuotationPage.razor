@page "/m/quotations"
@attribute [Authorize]
@using HitPan.Web.Components.Mobile
@using HitPan.Web.Models
@using HitPan.Web.Services
@inject QuotationService QuoteSvc

<PageTitle>견적서</PageTitle>

<MobileDocList TItem="QuotationListItem"
               Title="견적서"
               Icon="@Icons.Material.Filled.RequestQuote"
               IconColor="#1565C0"
               Items="_rows"
               Loading="_loading"
               DateFrom="_from"
               DateTo="_to"
               DateFromChanged="@(d => { _from = d; _ = LoadAsync(); })"
               DateToChanged="@(d => { _to = d; _ = LoadAsync(); })"
               OnSearch="LoadAsync"
               GetDocNo="@(r => r.QuoteNo)"
               GetPartner="@(r => r.PartnerName)"
               GetDate="@(r => r.QuoteDate)"
               GetAmount="@(r => r.TotalAmount)"
               GetStatus="@(r => r.Status)"
               DocType="quotation"
               GetId="@(r => r.QuoteId)" />

@code {
    private List<QuotationListItem> _rows = new();
    private bool _loading = true;
    private DateTime? _from = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime? _to   = DateTime.Today;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try { _rows = await QuoteSvc.GetListAsync(_from, _to); }
        catch { _rows = new(); }
        _loading = false;
    }
}
