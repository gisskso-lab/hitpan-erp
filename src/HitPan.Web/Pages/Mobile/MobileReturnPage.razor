@page "/m/returns"
@attribute [Authorize]
@using HitPan.Web.Components.Mobile
@using HitPan.Web.Models
@using HitPan.Web.Services
@inject DeliveryService DeliverySvc

<PageTitle>반품처리</PageTitle>

<MobileDocList TItem="PurchaseReturnListItem"
               Title="반품처리"
               Icon="@Icons.Material.Filled.AssignmentReturn"
               IconColor="#E65100"
               Items="_rows"
               Loading="_loading"
               DateFrom="_from"
               DateTo="_to"
               DateFromChanged="@(d => { _from = d; _ = LoadAsync(); })"
               DateToChanged="@(d => { _to = d; _ = LoadAsync(); })"
               OnSearch="LoadAsync"
               GetDocNo="@(r => r.ReturnNo)"
               GetPartner="@(r => r.PartnerName)"
               GetDate="@(r => r.ReturnDate)"
               GetAmount="@(r => r.TotalAmount)"
               GetStatus="@(r => r.Status)" />

@code {
    private List<PurchaseReturnListItem> _rows = new();
    private bool _loading = true;
    private DateTime? _from = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime? _to   = DateTime.Today;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try { _rows = await DeliverySvc.GetPurchaseReturnListAsync(_from, _to); }
        catch { _rows = new(); }
        _loading = false;
    }
}
