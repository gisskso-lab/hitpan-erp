@page "/m/sales-orders"
@attribute [Authorize]
@using HitPan.Web.Components.Mobile
@using HitPan.Web.Models
@using HitPan.Web.Services
@inject DeliveryService DeliverySvc

@inject ISnackbar Snackbar

<PageTitle>수주서</PageTitle>

<MobileDocList TItem="SalesListItem"
               Title="수주서"
               Icon="@Icons.Material.Filled.Assignment"
               IconColor="#1565C0"
               Items="_rows"
               Loading="_loading"
               DateFrom="_from"
               DateTo="_to"
               DateFromChanged="@(d => { _from = d; _ = LoadAsync(); })"
               DateToChanged="@(d => { _to = d; _ = LoadAsync(); })"
               OnSearch="LoadAsync"
               GetDocNo="@(r => r.OrderNo)"
               GetPartner="@(r => r.PartnerName)"
               GetDate="@(r => r.OrderDate)"
               GetAmount="@(r => r.TotalAmount)"
               GetStatus="@(r => r.Status)"
               DocType="sales-order"
               GetId="@(r => r.OrderId)" />

@code {
    private List<SalesListItem> _rows = new();
    private bool _loading = true;
    private DateTime? _from = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private DateTime? _to   = DateTime.Today;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try { _rows = await DeliverySvc.GetOrderListAsync(_from, _to); }
        catch (Exception ex) { _rows = new(); Snackbar.Add($"목록 조회 실패: {ex.Message}", Severity.Warning); }
        _loading = false;
    }
}
