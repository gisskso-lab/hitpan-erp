@page "/m/items"
@attribute [Authorize]
@using HitPan.Web.Models
@using HitPan.Web.Services
@inject ItemMasterService ItemSvc
@inject NavigationManager Nav

<PageTitle>상품마스터</PageTitle>

<div class="hpm-master">

    @* ── 검색바 ── *@
    <div class="hpm-search-bar">
        <div class="hpm-search-input-wrap">
            <MudIcon Icon="@Icons.Material.Filled.Search" Class="hpm-search-icon" />
            <input class="hpm-search-input" placeholder="상품명 · 상품코드 검색"
                   @bind="_search" @bind:event="oninput" @onkeyup="OnSearchKey" />
            @if (!string.IsNullOrEmpty(_search))
            {
                <button class="hpm-search-clear" @onclick="ClearSearch">
                    <MudIcon Icon="@Icons.Material.Filled.Close" Style="font-size:16px" />
                </button>
            }
        </div>
    </div>

    @* ── 유형 필터 칩 ── *@
    <div class="hpm-filter-chips">
        @foreach (var chip in _chips)
        {
            <button class="hpm-chip @(_activeChip == chip.Key ? "hpm-chip--active" : "")"
                    @onclick="@(() => SetChip(chip.Key))">@chip.Label</button>
        }
    </div>

    @* ── 카드 목록 ── *@
    @if (_loading)
    {
        <div class="hpm-loading">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
        </div>
    }
    else if (!_filtered.Any())
    {
        <div class="hpm-empty">
            <MudIcon Icon="@Icons.Material.Outlined.Inventory2" Style="font-size:48px;color:#ccc;" />
            <p>조회된 상품이 없습니다</p>
        </div>
    }
    else
    {
        <div class="hpm-card-list">
            @foreach (var row in _filtered)
            {
                <div class="hpm-master-card" @onclick="@(() => Nav.NavigateTo($"/items/{row.ItemId}"))">
                    <div class="hpm-master-card-top">
                        <div class="hpm-master-avatar" style="background:@ItemColor(row.ItemType)">
                            <MudIcon Icon="@ItemIcon(row.ItemType)" Style="font-size:18px;color:#fff" />
                        </div>
                        <div class="hpm-master-info">
                            <div class="hpm-master-name">@row.ItemName</div>
                            <div class="hpm-master-sub">
                                @row.ItemCode
                                @if (!string.IsNullOrEmpty(row.Spec))
                                {
                                    <span class="hpm-master-bizno">· @row.Spec</span>
                                }
                            </div>
                        </div>
                        <div class="hpm-master-badge-wrap">
                            <span class="hpm-item-price">@row.SalePrice.ToString("N0")원</span>
                        </div>
                    </div>
                    <div class="hpm-master-card-bot">
                        <span class="hpm-item-type-badge">@ItemTypeLabel(row.ItemType)</span>
                        <span class="hpm-item-unit">단위: @row.Unit</span>
                        <span class="hpm-item-stock @(row.CurrentStock <= row.SafetyStock ? "hpm-stock-low" : "")">
                            재고 @row.CurrentStock.ToString("N0")
                        </span>
                    </div>
                </div>
            }
        </div>

        <div class="hpm-list-footer">
            총 @(_filtered.Count)개 상품
        </div>
    }

    @* ── FAB: 새 상품 등록 ── *@
    <button class="hpm-fab" @onclick="@(() => Nav.NavigateTo("/items/new"))" title="상품 등록">
        <MudIcon Icon="@Icons.Material.Filled.Add" Style="font-size:26px;color:#fff" />
    </button>
</div>

@code {
    private List<ItemListModel> _rows = new();
    private List<ItemListModel> _filtered = new();
    private bool _loading = true;
    private string _search = "";
    private string _activeChip = "all";

    private static readonly (string Key, string Label)[] _chips =
    {
        ("all",      "전체"),
        ("product",  "일반상품"),
        ("assembly", "조립품"),
        ("promo",    "판촉품"),
    };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var type = _activeChip == "all" ? null : _activeChip;
            _rows = (await ItemSvc.GetListAsync(type: type)) ?? new();
        }
        catch { _rows = new(); }
        ApplyFilter();
        _loading = false;
    }

    private void ApplyFilter()
    {
        var q = _search.Trim();
        _filtered = string.IsNullOrEmpty(q)
            ? _rows.ToList()
            : _rows.Where(r =>
                r.ItemName.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                r.ItemCode.Contains(q, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private async Task SetChip(string key)
    {
        _activeChip = key;
        await LoadAsync();
    }

    private void OnSearchKey(KeyboardEventArgs e)
    {
        ApplyFilter();
        StateHasChanged();
    }

    private void ClearSearch()
    {
        _search = "";
        ApplyFilter();
        StateHasChanged();
    }

    private static string ItemTypeLabel(string t) => t switch
    {
        "product"  => "일반",
        "assembly" => "조립",
        "promo"    => "판촉",
        _          => t
    };

    private static string ItemColor(string t) => t switch
    {
        "assembly" => "#1B5E20",
        "promo"    => "#E65100",
        _          => "#0F6E56"
    };

    private static string ItemIcon(string t) => t switch
    {
        "assembly" => Icons.Material.Filled.AccountTree,
        "promo"    => Icons.Material.Filled.CardGiftcard,
        _          => Icons.Material.Filled.Inventory2
    };
}
