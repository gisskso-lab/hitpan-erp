@page "/purchase-status"
@namespace HitPan.Web.Pages.PurchaseUi
@attribute [Authorize]
@using HitPan.Web.Models
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime Js
@inject ISnackbar Snackbar
@inject GridExportService GridExport
@inject PartnerMasterService PartnersApi
@inject ItemMasterService ItemsApi

<PageTitle>매입현황</PageTitle>
<MudText Typo="Typo.h6" Class="mb-3">매입현황</MudText>

<MudPaper Class="pa-3 mb-3" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default);border-radius:12px">
    <div class="hitpan-filter-bar">
        <div class="hitpan-filter-field hitpan-filter-field--md">
            <MudSelect T="string" @bind-Value="_viewType" Label="조회유형" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="@("monthly")">매입 일(월)계표</MudSelectItem>
                <MudSelectItem Value="@("period")">기간별 매입현황</MudSelectItem>
                <MudSelectItem Value="@("item")">품목별 매입현황</MudSelectItem>
                <MudSelectItem Value="@("partner")">업체별 매입현황</MudSelectItem>
                <MudSelectItem Value="@("partner-yearly")">업체별 매입집계(년간)</MudSelectItem>
                <MudSelectItem Value="@("price")">매입단가 변동현황</MudSelectItem>
                <MudSelectItem Value="@("employee")">사원별 매입현황</MudSelectItem>
            </MudSelect>
        </div>
        <div class="hitpan-filter-field hitpan-filter-field--sm">
            <MudDatePicker @bind-Date="_from" Label="시작일" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="yyyy-MM-dd" />
        </div>
        <div class="hitpan-filter-field hitpan-filter-field--sm">
            <MudDatePicker @bind-Date="_to" Label="종료일" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="yyyy-MM-dd" />
        </div>
        @if (ShowSearchBox())
        {
            <div class="hitpan-filter-field hitpan-filter-field--md">
                @if (_viewType is "item" or "price")
                {
                    <MudAutocomplete T="string" Value="_searchText" ValueChanged="@(v => _searchText = v)"
                        SearchFunc="SearchItemAsync" Margin="Margin.Dense" Label="품명" Placeholder="검색"
                        Variant="Variant.Outlined" />
                }
                else if (_viewType is "partner" or "partner-yearly")
                {
                    <MudAutocomplete T="string" Value="_searchText" ValueChanged="@(v => _searchText = v)"
                        SearchFunc="SearchPartnerAsync" Margin="Margin.Dense" Label="업체" Placeholder="검색"
                        Variant="Variant.Outlined" />
                }
                else
                {
                    <MudTextField @bind-Value="_searchText" Label="@GetFilterLabel()" Variant="Variant.Outlined"
                        Margin="Margin.Dense" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" />
                }
            </div>
        }
        <div class="hitpan-filter-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SearchAsync">조회</MudButton>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.TableChart" OnClick="ExportExcelAsync">엑셀</MudButton>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Print" OnClick="PrintAsync">인쇄</MudButton>
        </div>
    </div>
</MudPaper>

@* 사장님 결재 2026-04-29: 7종 풀스택 → 가드 제거. price 는 단가변동(최저/최고/평균). *@
<MudPaper Elevation="0" Class="hitpan-card" Style="overflow:hidden">
    <MudTable T="ReportRow" Items="_reportData" Dense="true" Hover="true" Striped="true" FixedHeader="true" Height="calc(100vh - 280px)">
        <HeaderContent>
            <MudTh>@GetLabelHeader()</MudTh>
            <MudTh Style="text-align:right">건수</MudTh>
            @if (ShowQty()) { <MudTh Style="text-align:right">@GetQtyHeader()</MudTh> }
            <MudTh Style="text-align:right">@GetSupplyHeader()</MudTh>
            <MudTh Style="text-align:right">@GetVatHeader()</MudTh>
            <MudTh Style="text-align:right">@GetTotalHeader()</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Label</MudTd>
            <MudTd Style="text-align:right">@context.Count.ToString("N0")</MudTd>
            @if (ShowQty()) { <MudTd Style="text-align:right">@context.Qty.ToString("N1")</MudTd> }
            <MudTd Style="text-align:right">@context.SupplyAmount.ToString("N0")</MudTd>
            <MudTd Style="text-align:right">@context.VatAmount.ToString("N0")</MudTd>
            <MudTd Style="text-align:right;font-weight:500">@context.TotalAmount.ToString("N0")</MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText Class="pa-4" Style="color:var(--hitpan-text-faint)">조회된 매입이 없습니다.</MudText></NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private DateTime? _from = DateTime.Today.AddDays(-30);
    private DateTime? _to = DateTime.Today;
    private string _searchText = "";
    private string _viewType = "period";
    private List<ReportRow> _reportData = new();

    // 작7 (2026-06-26): 대시보드 '이번달매입' 카드 클릭 → 당월 기간 프리필터 수신. 없으면 기본(최근 30일).
    [Parameter, SupplyParameterFromQuery(Name = "from")] public string? FromQuery { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "to")] public string? ToQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (DateTime.TryParse(FromQuery, out var f)) _from = f.Date;
        if (DateTime.TryParse(ToQuery, out var t)) _to = t.Date;
        await SearchAsync();
    }

    private async Task SearchAsync()
    {

        var qs = new List<string>();
        qs.Add($"view={_viewType}");
        if (_from.HasValue) qs.Add($"from={_from:yyyy-MM-dd}");
        if (_to.HasValue) qs.Add($"to={_to:yyyy-MM-dd}");
        if (!string.IsNullOrWhiteSpace(_searchText)) qs.Add($"partner={Uri.EscapeDataString(_searchText)}");
        var path = "api/reports/purchases?" + string.Join("&", qs);
        try
        {
            _reportData = await Http.GetFromJsonAsync<List<ReportRow>>(path) ?? new();
        }
        catch (Exception _hp15Ex)
        {
            // 봉합 (2026-06-22, 10차 P1-3): 로드 실패를 사용자에게 알림. 빈 결과(200 [])는 정상이라 여기 catch에서만 알림한다.
            Console.Error.WriteLine($"[HP15] " + _hp15Ex.GetType().Name + ": " + _hp15Ex.Message);
            Snackbar.Add("매입현황 조회에 실패했습니다. 잠시 후 다시 시도해주세요.", Severity.Error);
            _reportData = new();
        }
        StateHasChanged();
    }

    /// <summary>화면 데이터를 엑셀로 내보낸다.</summary>
    /// <remarks>
    /// 🔴 봉합 2026-08-12 — 종전에는 "준비중입니다" 스낵바만 띄우는 가짜 버튼이었다.
    /// 화면 표와 <b>같은 열·같은 순서</b>로 넘긴다. 수량 열은 화면에서 조건부(ShowQty)라
    /// 여기서도 같은 조건을 쓴다 — 안 그러면 화면과 파일의 열이 어긋난다.
    /// </remarks>
    private async Task ExportExcelAsync()
    {
        var showQty = ShowQty();

        var headers = new List<string> { GetLabelHeader(), "건수" };
        if (showQty) headers.Add(GetQtyHeader());
        headers.Add(GetSupplyHeader());
        headers.Add(GetVatHeader());
        headers.Add(GetTotalHeader());

        var rows = _reportData.Select(r =>
        {
            var cells = new List<object?> { r.Label, r.Count };
            if (showQty) cells.Add(r.Qty);
            cells.Add(r.SupplyAmount);
            cells.Add(r.VatAmount);
            cells.Add(r.TotalAmount);
            return (IReadOnlyList<object?>)cells;
        }).ToList();

        var subtitle = BuildSubtitle();
        await GridExport.ExportExcelAsync("매입 현황", headers, rows, subtitle);
    }
    /// <summary>화면을 인쇄한다.</summary>
    /// <summary>엑셀·인쇄가 함께 쓰는 부제(기간·건수).</summary>
    /// <remarks>한 곳에서 만든다 — 따로 만들면 파일과 종이의 기간이 갈린다.</remarks>
    private string BuildSubtitle() => $"{_from:yyyy-MM-dd} ~ {_to:yyyy-MM-dd} · 총 {_reportData.Count:N0}건";

    /// <summary>화면을 인쇄한다. 인쇄창에서 "PDF로 저장" 을 고르면 PDF 가 된다.</summary>
    /// <remarks>
    /// 제목·기간을 같이 넘긴다 — 안 넘기면 종이에 표만 나와서
    /// 거래처·세무사가 무슨 자료인지 알 수 없다 (사장님 지시 2026-08-12).
    /// </remarks>
    private async Task PrintAsync() => await GridExport.PrintAsync("매입 현황", BuildSubtitle());

    private string GetLabelHeader() => _viewType switch
    {
        "partner" or "partner-yearly" => "업체명",
        "item" or "price" => "품명",
        "employee" => "사원명",
        "monthly" => "월",
        _ => "기간"
    };

    private bool ShowQty() => _viewType is "item" or "monthly" or "partner-yearly" or "price" or "employee";
    private string GetQtyHeader() => _viewType switch { "price" => "누적수량", _ => "수량" };
    private string GetSupplyHeader() => _viewType switch { "price" => "최저단가", _ => "공급가액" };
    private string GetVatHeader() => _viewType switch { "price" => "최고단가", _ => "부가세" };
    private string GetTotalHeader() => _viewType switch { "price" => "평균단가", _ => "합계" };

    private string GetViewLabel() => _viewType switch
    {
        "monthly" => "매입 일(월)계표",
        "partner-yearly" => "업체별 매입집계(년간)",
        "price" => "매입단가 변동현황",
        "employee" => "사원별 매입현황",
        _ => "매입현황"
    };

    private string GetFilterLabel() => _viewType switch
    {
        "partner" or "partner-yearly" => "업체명",
        "item" or "price" => "품명",
        "employee" => "사원명",
        _ => "검색어"
    };

    private bool ShowSearchBox() => _viewType is not ("period" or "monthly");

    private List<PartnerListRow>? _partnerCache;
    private List<ItemListModel>? _itemCache;

    private async Task<IEnumerable<string>> SearchPartnerAsync(string value, CancellationToken ct)
    {
        _partnerCache ??= await PartnersApi.GetListAsync() ?? new();
        if (string.IsNullOrWhiteSpace(value)) return _partnerCache.Select(p => p.PartnerName).Distinct();
        return _partnerCache.Where(p => p.PartnerName.Contains(value, StringComparison.OrdinalIgnoreCase)).Select(p => p.PartnerName).Distinct();
    }

    private async Task<IEnumerable<string>> SearchItemAsync(string value, CancellationToken ct)
    {
        _itemCache ??= await ItemsApi.GetListAsync() ?? new();
        if (string.IsNullOrWhiteSpace(value)) return _itemCache.Select(i => i.ItemName).Distinct();
        return _itemCache.Where(i => i.ItemName.Contains(value, StringComparison.OrdinalIgnoreCase)).Select(i => i.ItemName).Distinct();
    }
}
