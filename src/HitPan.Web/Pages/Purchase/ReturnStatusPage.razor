@page "/return-status"
@namespace HitPan.Web.Pages.PurchaseUi
@attribute [Authorize]
@using HitPan.Web.Models
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime Js
@inject ISnackbar Snackbar
@inject GridExportService GridExport
@inject PartnerMasterService PartnersApi
@inject ItemMasterService ItemsApi
@* 🔴 20260827작3 — 전표별 반품장부가 쓰는 전표 목록 서비스 *@
@inject DeliveryService DeliverySvc

<PageTitle>반품현황</PageTitle>
<MudText Typo="Typo.h6" Class="mb-3">반품현황</MudText>

<MudPaper Class="pa-3 mb-3" Elevation="0" Style="border:1px solid var(--mud-palette-lines-default);border-radius:12px">
    <div class="hitpan-filter-bar">
        <div class="hitpan-filter-field hitpan-filter-field--md">
            <MudSelect T="string" Value="_viewType" ValueChanged="OnViewTypeChangedAsync" Label="조회유형" Variant="Variant.Outlined" Margin="Margin.Dense">
                @* 🔴 20260827작3 — 사장님 실측 반려: "전체 장부가 없네?? 그래서 확인이 안되네?"
                     이 화면은 **집계뿐**이었다(건수·금액 합계). 전표 한 건씩 보는 자리가 PC 에 없어
                     어느 반품이 어느 매입과 엮였는지 대조할 방법이 없었다.
                     ⇒ 「전표별」을 **맨 위**에 둔다 — 장부가 기본이고 집계가 부가다. *@
                <MudSelectItem Value="@("doc")">전표별 반품장부 (전체 목록)</MudSelectItem>
                <MudSelectItem Value="@("period")">기간별 반품현황</MudSelectItem>
                <MudSelectItem Value="@("item")">품목별 반품현황</MudSelectItem>
                <MudSelectItem Value="@("partner")">업체별 반품현황</MudSelectItem>
                <MudSelectItem Value="@("employee")">사원별 반품현황</MudSelectItem>
            </MudSelect>
        </div>
        <div class="hitpan-filter-field hitpan-filter-field--sm">
            <MudDatePicker @bind-Date="_from" Label="시작일" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="yyyy-MM-dd" />
        </div>
        <div class="hitpan-filter-field hitpan-filter-field--sm">
            <MudDatePicker @bind-Date="_to" Label="종료일" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="yyyy-MM-dd" />
        </div>
        @if (ShowSearchBox())
        {
            <div class="hitpan-filter-field hitpan-filter-field--md">
                @if (_viewType is "item")
                {
                    <MudAutocomplete T="string" Value="_searchText" ValueChanged="@(v => _searchText = v)"
                        SearchFunc="SearchItemAsync" Margin="Margin.Dense" Label="품명" Placeholder="검색"
                        Variant="Variant.Outlined" />
                }
                else if (_viewType is "partner")
                {
                    <MudAutocomplete T="string" Value="_searchText" ValueChanged="@(v => _searchText = v)"
                        SearchFunc="SearchPartnerAsync" Margin="Margin.Dense" Label="업체" Placeholder="검색"
                        Variant="Variant.Outlined" />
                }
                else
                {
                    <MudTextField @bind-Value="_searchText" Label="@GetFilterLabel()" Variant="Variant.Outlined"
                        Margin="Margin.Dense" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" />
                }
            </div>
        }
        <div class="hitpan-filter-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SearchAsync">조회</MudButton>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.TableChart" OnClick="ExportExcelAsync">엑셀</MudButton>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Print" OnClick="PrintAsync">인쇄</MudButton>
        </div>
    </div>
</MudPaper>

@* 사장님 결재 2026-04-29: 4종 풀스택 → 가드 제거 *@
@if (_viewType == "doc")
{
    @* 🔴 20260827작3 — 전표별 반품장부. 집계가 아니라 **전표 한 건씩** 보여준다.
         「원 매입전표」 칸이 있어 어느 매입에서 나온 반품인지 여기서 바로 읽힌다. *@
    @if (_docRows.Any(r => string.Equals(r.Status, "draft", StringComparison.OrdinalIgnoreCase)))
    {
        @* 🔴 두 화면 숫자가 다른 이유를 **먼저** 말해준다.
             집계 4종은 확정분만 센다 — 작성중이 섞여 있으면 건수가 다를 수밖에 없다.
             이유를 안 알려주면 담당자는 "어느 화면이 맞나" 를 매번 다시 확인해야 한다. *@
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
            작성중(임시저장) 반품 @_docRows.Count(r => string.Equals(r.Status, "draft", StringComparison.OrdinalIgnoreCase)).ToString("N0")건이 함께 보입니다.
            기간별·품목별·업체별·사원별 현황은 <b>확정분만</b> 집계하므로 건수가 다를 수 있습니다.
        </MudAlert>
    }
    <MudPaper Elevation="0" Class="hitpan-card" Style="overflow:hidden">
        <MudTable T="PurchaseReturnListItem" Items="_docRows" Dense="true" Hover="true" Striped="true"
                  FixedHeader="true" Height="calc(100vh - 280px)">
            <HeaderContent>
                <MudTh>일자</MudTh>
                <MudTh>반품전표</MudTh>
                <MudTh>원 매입전표</MudTh>
                <MudTh>업체</MudTh>
                <MudTh>작성자</MudTh>
                <MudTh>상태</MudTh>
                <MudTh Style="text-align:right">공급가액</MudTh>
                <MudTh Style="text-align:right">부가세</MudTh>
                <MudTh Style="text-align:right">합계</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.ReturnDate.ToString("yyyy-MM-dd")</MudTd>
                <MudTd>@context.ReturnNo</MudTd>
                <MudTd>
                    @if (!string.IsNullOrWhiteSpace(context.ReceiptNo))
                    {
                        <span>@context.ReceiptNo</span>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">직접작성</MudText>
                    }
                </MudTd>
                <MudTd>@context.PartnerName</MudTd>
                <MudTd>@(context.CreatedByName ?? "")</MudTd>
                <MudTd>@HitPan.Web.Helpers.StatusLabel.Document(context.Status)</MudTd>
                <MudTd Style="text-align:right">@context.TotalAmount.ToString("N0")</MudTd>
                <MudTd Style="text-align:right">@context.VatAmount.ToString("N0")</MudTd>
                <MudTd Style="text-align:right;font-weight:500">@((context.TotalAmount + context.VatAmount).ToString("N0"))</MudTd>
            </RowTemplate>
            <FooterContent>
                @* 장부는 합계가 보여야 집계 화면과 대조된다.
                   🔴 단 **확정분 합계를 따로** 보여준다 — 집계 4종은 confirmed 만 세기 때문이다.
                      이게 없으면 두 화면 숫자가 달라 보여 사장님이 또 "정합성 안 맞다" 하신다. *@
                <MudTFootRow>
                    <MudTh colspan="6" Style="text-align:right;font-weight:600">합계 @_docRows.Count.ToString("N0") 건</MudTh>
                    <MudTh Style="text-align:right;font-weight:600">@_docRows.Sum(r => r.TotalAmount).ToString("N0")</MudTh>
                    <MudTh Style="text-align:right;font-weight:600">@_docRows.Sum(r => r.VatAmount).ToString("N0")</MudTh>
                    <MudTh Style="text-align:right;font-weight:600">@_docRows.Sum(r => r.TotalAmount + r.VatAmount).ToString("N0")</MudTh>
                </MudTFootRow>
                @if (_docRows.Any(r => string.Equals(r.Status, "draft", StringComparison.OrdinalIgnoreCase)))
                {
                    @* 확정분만 따로 — 이 줄이 집계 4종과 **정확히 맞아야** 정합성이 증명된다. *@
                    <MudTFootRow>
                        <MudTh colspan="6" Style="text-align:right;color:var(--mud-palette-text-secondary)">
                            이 중 확정분 @_confirmedRows.Count.ToString("N0") 건 (현황 집계와 같은 모수)
                        </MudTh>
                        <MudTh Style="text-align:right">@_confirmedRows.Sum(r => r.TotalAmount).ToString("N0")</MudTh>
                        <MudTh Style="text-align:right">@_confirmedRows.Sum(r => r.VatAmount).ToString("N0")</MudTh>
                        <MudTh Style="text-align:right">@_confirmedRows.Sum(r => r.TotalAmount + r.VatAmount).ToString("N0")</MudTh>
                    </MudTFootRow>
                }
            </FooterContent>
            <NoRecordsContent><MudText Class="pa-4" Style="color:var(--hitpan-text-faint)">조회된 반품이 없습니다.</MudText></NoRecordsContent>
        </MudTable>
    </MudPaper>
}
else
{
<MudPaper Elevation="0" Class="hitpan-card" Style="overflow:hidden">
    <MudTable T="ReportRow" Items="_reportData" Dense="true" Hover="true" Striped="true" FixedHeader="true" Height="calc(100vh - 280px)">
        <HeaderContent>
            <MudTh>@GetLabelHeader()</MudTh>
            <MudTh Style="text-align:right">건수</MudTh>
            @if (_viewType == "item") { <MudTh Style="text-align:right">수량</MudTh> }
            <MudTh Style="text-align:right">공급가액</MudTh>
            <MudTh Style="text-align:right">부가세</MudTh>
            <MudTh Style="text-align:right">합계</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Label</MudTd>
            <MudTd Style="text-align:right">@context.Count.ToString("N0")</MudTd>
            @if (_viewType == "item") { <MudTd Style="text-align:right">@context.Qty.ToString("N1")</MudTd> }
            <MudTd Style="text-align:right">@context.SupplyAmount.ToString("N0")</MudTd>
            <MudTd Style="text-align:right">@context.VatAmount.ToString("N0")</MudTd>
            <MudTd Style="text-align:right;font-weight:500">@context.TotalAmount.ToString("N0")</MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText Class="pa-4" Style="color:var(--hitpan-text-faint)">조회된 반품이 없습니다.</MudText></NoRecordsContent>
    </MudTable>
</MudPaper>
}

@code {
    private DateTime? _from = DateTime.Today.AddDays(-30);
    private DateTime? _to = DateTime.Today;
    private string _searchText = "";
    // 🔴 20260827작3 — 기본을 「전표별」로 둔다. 사장님이 확인하려던 것은 장부다.
    private string _viewType = "doc";
    private List<ReportRow> _reportData = new();

    /// <summary>🔴 20260827작3 — 전표별 반품장부 행. 집계(_reportData)와 별개 축이다.</summary>
    private List<PurchaseReturnListItem> _docRows = new();

    /// <summary>
    /// 확정분만 — 현황 집계 4종과 <b>같은 모수</b>다(집계는 <c>status='confirmed'</c>).
    /// 이 합계가 집계 화면과 맞아야 "정합성이 맞다" 가 눈으로 증명된다.
    /// </summary>
    private IReadOnlyList<PurchaseReturnListItem> _confirmedRows =>
        _docRows.Where(r => string.Equals(r.Status, "confirmed", StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync() => await SearchAsync();

    /// <summary>
    /// 조회유형 변경 시 즉시 재조회한다 (20260825작16).
    /// 사장님 실측 8/25: 매입 현황·순위·통계 5화면이 <b>조회유형과 상관없이 날짜로만</b> 나왔다.
    /// 원인 — 콤보가 <c>@bind-Value</c> 라 값만 담고 <b>재조회를 안 걸었다.</b>
    /// 재조회가 「조회」 버튼과 최초 진입에만 있어, 콤보를 바꿔도 앞 결과(기간별=날짜)가 남았다.
    /// 🔴 판매쪽은 작2 에서 이미 같은 반려를 받아 고쳤는데 <b>매입에 옮기지 않았다.</b>
    /// 검색어도 함께 비운다: 조회유형이 바뀌면 검색어 의미(품명↔업체)가 달라져
    /// 앞 유형의 입력이 남으면 엉뚱한 필터가 되어 0건이 된다.
    /// </summary>
    private async Task OnViewTypeChangedAsync(string value)
    {
        _viewType = value;
        _searchText = "";
        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        // 🔴 20260827작3 — 「전표별」은 집계 API 가 아니라 **전표 목록 API** 를 부른다.
        //   집계(api/reports/returns)는 GROUP BY 라 전표 한 건씩이 안 나온다.
        //
        // 🔴 모수 차이를 **숨기지 않고 화면에 말해준다** (사장님 반려의 핵심이 정합성이다):
        //     집계 4종  = status **confirmed 만**       (8/25 사장님 결재)
        //     이 장부   = confirmed + **draft**(작성중)  · canceled 는 작1 W1 로 제외
        //   ⇒ 작성중이 있으면 두 화면 건수가 다르다. 그게 **틀린 게 아니라 다른 질문**이다.
        //     장부에서 draft 를 빼면 담당자가 자기가 쓰던 전표를 못 찾는다.
        //   ⇒ 대신 상태 칸으로 구분되게 하고, 아래 안내줄로 차이를 명시한다.
        if (_viewType == "doc")
        {
            _docRows = await DeliverySvc.GetPurchaseReturnListAsync(_from, _to);
            StateHasChanged();
            return;
        }

        var qs = new List<string>();
        qs.Add($"view={_viewType}");
        if (_from.HasValue) qs.Add($"from={_from:yyyy-MM-dd}");
        if (_to.HasValue) qs.Add($"to={_to:yyyy-MM-dd}");
        if (!string.IsNullOrWhiteSpace(_searchText)) qs.Add($"partner={Uri.EscapeDataString(_searchText)}");
        var path = "api/reports/returns?" + string.Join("&", qs);
        try
        {
            _reportData = await Http.GetFromJsonAsync<List<ReportRow>>(path) ?? new();
        }
        catch (Exception _hp15Ex)
        {
            Console.Error.WriteLine($"[HP15] " + _hp15Ex.GetType().Name + ": " + _hp15Ex.Message);
            _reportData = new();
        }
        StateHasChanged();
    }

    /// <summary>화면 데이터를 엑셀로 내보낸다.</summary>
    private async Task ExportExcelAsync()
    {
        // 🔴 봉합 2026-08-12 — 종전에는 "준비중입니다" 스낵바만 띄우는 가짜 버튼이었다.
        // 수량 열은 화면에서 품목별 조회일 때만 나온다 — 파일도 같아야 한다.
        var showQty = _viewType == "item";

        var headers = new List<string> { GetLabelHeader(), "건수" };
        if (showQty) headers.Add("수량");
        headers.AddRange(new[] { "공급가액", "부가세", "합계" });

        var rows = _reportData.Select(r =>
        {
            var cells = new List<object?> { r.Label, r.Count };
            if (showQty) cells.Add(r.Qty);
            cells.Add(r.SupplyAmount);
            cells.Add(r.VatAmount);
            cells.Add(r.TotalAmount);
            return (IReadOnlyList<object?>)cells;
        }).ToList();

        var subtitle = BuildSubtitle();
        await GridExport.ExportExcelAsync("반품 현황", headers, rows, subtitle);
    }
    /// <summary>화면을 인쇄한다.</summary>
    /// <summary>엑셀·인쇄가 함께 쓰는 부제(기간·건수).</summary>
    /// <remarks>한 곳에서 만든다 — 따로 만들면 파일과 종이의 기간이 갈린다.</remarks>
    private string BuildSubtitle() => $"{_from:yyyy-MM-dd} ~ {_to:yyyy-MM-dd} · 총 {_reportData.Count:N0}건";

    /// <summary>화면을 인쇄한다. 인쇄창에서 "PDF로 저장" 을 고르면 PDF 가 된다.</summary>
    /// <remarks>
    /// 제목·기간을 같이 넘긴다 — 안 넘기면 종이에 표만 나와서
    /// 거래처·세무사가 무슨 자료인지 알 수 없다 (사장님 지시 2026-08-12).
    /// </remarks>
    private async Task PrintAsync() => await GridExport.PrintAsync("반품 현황", BuildSubtitle());

    private string GetLabelHeader() => _viewType switch
    {
        "partner" => "업체명",
        "item" => "품명",
        "employee" => "사원명",
        _ => "기간"
    };

    private string GetFilterLabel() => _viewType switch
    {
        "partner" => "업체명",
        "item" => "품명",
        "employee" => "사원명",
        _ => "검색어"
    };

    private bool ShowSearchBox() => _viewType is not "period";

    private List<PartnerListRow>? _partnerCache;
    private List<ItemListModel>? _itemCache;

    private async Task<IEnumerable<string>> SearchPartnerAsync(string value, CancellationToken ct)
    {
        _partnerCache ??= await PartnersApi.GetListAsync() ?? new();
        if (string.IsNullOrWhiteSpace(value)) return _partnerCache.Select(p => p.PartnerName).Distinct();
        return _partnerCache.Where(p => p.PartnerName.Contains(value, StringComparison.OrdinalIgnoreCase)).Select(p => p.PartnerName).Distinct();
    }

    private async Task<IEnumerable<string>> SearchItemAsync(string value, CancellationToken ct)
    {
        _itemCache ??= await ItemsApi.GetListAsync() ?? new();
        if (string.IsNullOrWhiteSpace(value)) return _itemCache.Select(i => i.ItemName).Distinct();
        return _itemCache.Where(i => i.ItemName.Contains(value, StringComparison.OrdinalIgnoreCase)).Select(i => i.ItemName).Distinct();
    }
}
