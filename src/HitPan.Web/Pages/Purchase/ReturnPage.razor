@page "/returns"
@using HitPan.Web.Components.Purchase
@using HitPan.Web.Components.Sales
@using HitPan.Web.Models
@using HitPan.Web.Services
@namespace HitPan.Web.Pages.ReturnUi
@inject WorkTabService TabService
@inject DocumentService DocService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject HttpClient Http
@inject PartnerMasterService PartnersApi
@inject ItemMasterService ItemsApi
@inject DeliveryService DeliveryService

<PageTitle>반품 처리</PageTitle>

<NavigationLock ConfirmExternalNavigation="@_hasUnsavedChanges" OnBeforeInternalNavigation="OnBeforeInternalNavigationAsync" />

<section class="return-page">
    @if (_draft is null)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
        <WorkflowBreadcrumb Steps="_workflowSteps" />

        <MudPaper Class="pa-3 mb-2">
            <MudGrid>
                <MudItem xs="12" md="3">
                    <MudDatePicker Label="반품일자" Date="_draft.SalesDate" DateChanged="OnReturnDateChangedAsync" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudAutocomplete T="string" Label="거래처" Value="_draft.SalesCompany"
                        ValueChanged="OnPartnerChangedAsync" SearchFunc="SearchPartnerAsync"
                        Margin="Margin.Dense" Placeholder="거래처 검색" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudSelect T="string" @bind-Value="_returnType" Label="반품유형" Variant="Variant.Text" Margin="Margin.Dense">
                        <MudSelectItem Value="@("purchase_return")">매입반품</MudSelectItem>
                        <MudSelectItem Value="@("sales_return")">판매반품</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField T="string" Label="메모" Value="_draft.Memo"
                                  ValueChanged="OnMemoChangedAsync" Margin="Margin.Dense" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudToolBar Dense="true" Style="overflow-x:auto;flex-wrap:nowrap" Class="pa-1 gap-1">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="AddNewAsync">추가</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync">저장</MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Undo" OnClick="CancelAsync">취소</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteConfirmAsync">삭제</MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="CopyAsync" Disabled="@_isNew">복사</MudButton>
            <MudDivider Vertical="true" FlexItem="true" />
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Print" OnClick="PrintAsync">인쇄</MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.TableChart" OnClick="DownloadExcelAsync">엑셀</MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="DownloadPdfAsync">PDF</MudButton>
            <MudSpacer />
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FormatListBulleted" OnClick="OpenListAsync">목록</MudButton>
        </MudToolBar>

        <div class="return-grid-wrap">
            <PurchaseOrderGrid Lines="_draft.Lines"
                               Density="_draft.Density"
                               Summary="_summary"
                               Status="_status"
                               ItemCache="_itemCache"
                               OnChanged="OnGridChangedAsync"
                               SelectedLineChanged="OnSelectedLineChangedAsync" />
        </div>

        <MudPaper Class="pa-3 mt-2">
            <MudStack Row="true" Spacing="3">
                <MudText Typo="Typo.body2">공급가액: @_summary.SupplyAmount.ToString("N0")</MudText>
                <MudText Typo="Typo.body2">부가세: @_summary.VatAmount.ToString("N0")</MudText>
                <MudText Typo="Typo.body2">합계: @_summary.TotalAmount.ToString("N0")</MudText>
            </MudStack>
        </MudPaper>
    }
</section>

<MudDialog @bind-Visible="_showReturnList" Options="new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true }">
    <TitleContent><MudText Typo="Typo.h6">반품 목록</MudText></TitleContent>
    <DialogContent>
        <MudTable T="PurchaseReturnListItem" Items="_returnList" Dense="true" Hover="true" Striped="true" FixedHeader="true" Height="400px">
            <HeaderContent>
                <MudTh>일자</MudTh>
                <MudTh>전표번호</MudTh>
                <MudTh>업체</MudTh>
                <MudTh>상태</MudTh>
                <MudTh Style="text-align:right">합계</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.ReturnDate.ToString("yyyy-MM-dd")</MudTd>
                <MudTd>@context.ReturnNo</MudTd>
                <MudTd>@context.PartnerName</MudTd>
                <MudTd>@context.Status</MudTd>
                <MudTd Style="text-align:right">@((context.TotalAmount + context.VatAmount).ToString("N0"))</MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Class="pa-4">반품 내역이 없습니다.</MudText></NoRecordsContent>
        </MudTable>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseReturnList">닫기</MudButton>
    </DialogActions>
</MudDialog>
