@page "/users"
@namespace HitPan.Web.Pages.UsersUi
@* 🔴 2026-08-11 (사장님 지시): 설정관리는 **부모계정(대표)만**.
     메뉴에서 감추는 것만으로는 주소를 직접 치면 그대로 들어온다 — 화면에서도 막는다. *@
@* ⬛ @attribute [Authorize(Roles = "system_admin,tenant_admin,TenantAdmin")]
     ← 20261005작5 §5-4: 「직원 계정 관리」 권한(1단계 이상)을 받은 직원도 연다. 화면 안에서 단계 0 이면 막고,
        서버가 주소마다 [RequireUsersLevel(n)] 로 다시 막는다(메뉴·화면·서버 세 겹). *@
@attribute [Authorize]
@using HitPan.Web.Models
@using HitPan.Web.Services
@using HitPan.Web.Components.Common
@inject UserService UserSvc
@* 부서 선택지 (20260810작4) — 사원관리와 같은 부서 마스터를 본다 *@
@inject EmployeeService EmpSvc
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IDialogService DialogService
@* 20261005작3 — 계정 과금 호출(AccountSeatApi · DI 등록 없이 여기서 만든다) *@
@inject HttpClient Http
@inject ILogger<AccountSeatApi> SeatLog
@* 20261005작5 — 사원 ↔ 계정 연결 호출(AccountLinkApi · DI 등록 없이 여기서 만든다) *@
@inject ILogger<AccountLinkApi> LinkLog
@using HitPan.Web.Components.Users

<PageTitle>사용자 추가·관리</PageTitle>

@* 20261005작5 §5-4 — 내 단계를 먼저 읽는다. 못 읽었거나 0 이면 화면을 열지 않는다(열어 주고 막는 것보다 처음부터 안 연다). *@
@if (!_levelLoaded)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_level < 1)
{
    <MudPaper Elevation="0" Class="pa-8 text-center" Style="border:0.5px dashed var(--mud-palette-lines-default);border-radius:12px">
        <MudIcon Icon="@Icons.Material.Outlined.Lock" Size="Size.Large" Style="color:var(--mud-palette-text-secondary);font-size:64px" />
        <MudText Typo="Typo.h6" Class="mt-3">이 화면을 볼 권한이 없습니다</MudText>
        <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary)">
            대표님께 「직원 계정 관리」 권한을 요청하세요.
        </MudText>
    </MudPaper>
}
else
{
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
    <div>
        <MudText Typo="Typo.h6">사용자 추가·관리</MudText>
        <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)">
            로그인 계정 관리 · 사원 정보는 [사원관리] 메뉴
        </MudText>
    </div>
    <div class="d-flex gap-2">
        @* 20261005작5 §5-4 — 버튼은 단계표대로. 권한 설정·엑셀 일괄은 대표·관리자만(서버도 TenantAdminOnly). *@
        @if (_isAdmin)
        {
        <MudButton Variant="Variant.Outlined" Size="Size.Small"
            StartIcon="@Icons.Material.Filled.Lock"
            OnClick="@(() => Nav.NavigateTo("/users/permissions"))">권한 설정</MudButton>
        @* ⬛ OnClick="@(() => _showBulk = true)" — 20261005작3: 누르기 전 한도 확인(차 있으면 안내 창) *@
        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Success"
            StartIcon="@Icons.Material.Filled.UploadFile"
            OnClick="OpenBulkDialog">엑셀 일괄등록</MudButton>
        }
        @* 20261005작3 D-15 — [구독계정추가] 상시 표시(한도가 안 찼어도 보인다)
           20261005작5 — 3단계(구독계정추가)만. ⬛ OnClick="@(() => OpenSeatNotice(false))" → 3단계 서버 주소로 숫자를 읽고 연다 *@
        @if (_level >= 3)
        {
        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
            StartIcon="@Icons.Material.Filled.GroupAdd"
            OnClick="OpenSubscribeAsync">구독계정추가</MudButton>
        }
        @if (_level >= 2)
        {
        <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary"
            StartIcon="@Icons.Material.Filled.PersonAdd"
            OnClick="OpenCreateDialog">사용자 추가</MudButton>
        }
    </div>
</div>

@* 20261005작3 D-11 — 계정 카드 3개(DeviceManagePage 모양 그대로 · 공용 KpiCard) *@
@if (_seats is not null)
{
    <MudGrid Spacing="3" Class="mb-3">
        <MudItem xs="12" sm="4" md="4">
            <KpiCard Color="@(_seats.Active > _seats.Limit ? KpiCard.KpiColor.Error : KpiCard.KpiColor.Primary)"
                     Label="계정사용한도"
                     Value="@($"{_seats.Active} / {_seats.Limit}")"
                     Sub="@SeatSub"
                     EmphasizeValue="true" />
        </MudItem>
        <MudItem xs="12" sm="4" md="4">
            <KpiCard Color="KpiCard.KpiColor.Warning"
                     Label="추가구매계정"
                     Value="@($"{_seats.Extra}")"
                     Sub="@($"기본 {_seats.BaseLimit}개 + 추가 {_seats.Extra}개")"
                     EmphasizeValue="true" />
        </MudItem>
        <MudItem xs="12" sm="4" md="4">
            <KpiCard Color="KpiCard.KpiColor.Purple"
                     Label="구독티어"
                     Value="@(_seats.Tier.ToUpperInvariant())"
                     Sub="현재 가입 상품"
                     EmphasizeValue="true" />
        </MudItem>
    </MudGrid>
}

@* 20261005작5 A · P-5 — CanSubscribe: 3단계면 [구독계정추가] 버튼, 아니면 「대표님께 계정 추가를 요청하세요」 *@
<AccountSeatNoticeDialog @bind-Visible="_showSeatNotice" Blocked="_seatNoticeBlocked"
                         Active="@(_seats?.Active ?? 0)" Limit="@(_seats?.Limit ?? 0)"
                         CanSubscribe="@(_level >= 3)" OnSubscribe="OpenSubscribeAsync" />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_loadFailed)
{
    @* 🔴 못 불러온 것 — "0명" 과 다른 사실이다. 없다고 단정하지 않는다. *@
    <LoadFailedState Title="사용자 목록을 불러오지 못했습니다"
                     Subtitle="계정이 삭제된 것이 아닙니다. 연결이 회복되면 다시 보입니다."
                     Retrying="@_loading"
                     OnRetry="LoadAsync" />
}
else if (_users.Count == 0)
{
    @* 빈 상태 — 진짜로 0명일 때만 온다 *@
    <MudPaper Elevation="0" Class="pa-8 text-center" Style="border:0.5px dashed var(--mud-palette-lines-default);border-radius:12px">
        <MudIcon Icon="@Icons.Material.Outlined.PeopleAlt" Size="Size.Large" Style="color:var(--mud-palette-text-secondary);font-size:64px" />
        <MudText Typo="Typo.h6" Class="mt-3">아직 등록된 사용자가 없습니다</MudText>
        @* ⬛ 「첫 사용자를 추가해보세요. (옛 낱말)·임시비밀번호만 있으면 1분이면 됩니다.」 — 20261005작5 §6 계정은 「아이디」 *@
        <MudText Typo="Typo.body2" Class="mb-3" Style="color:var(--mud-palette-text-secondary)">
            첫 사용자를 추가해보세요. 아이디·임시비밀번호만 있으면 1분이면 됩니다.
        </MudText>
        @if (_level >= 2)
        {
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
            StartIcon="@Icons.Material.Filled.PersonAdd"
            OnClick="OpenCreateDialog">첫 사용자 추가</MudButton>
        }
    </MudPaper>
}
else
{
    @* 헌법 #35 (사장님 결재 2026-06-04) — 계정 계층 안내.
       용어 정정 (사장님 오더 2026-08-10, 20260810작4): "부모계정, 자식계정 이라고 하는 개발용어는
       숨기고 대표계정, 직원계정 이라고 바꾸자." → 화면에 보이는 글자만 바꾼다.
       DB 컬럼(is_parent)·C# 속성(IsParent)·내부 판정 로직은 그대로다(헌법 #38·#40 구조 불변). *@
    @* ⬛ 「대표계정만 직원계정을 만들 수 있으며」 — 20261005작5 §5: 「직원 계정 관리」 계정설정 권한을 받은 직원도 만든다 *@
    <MudAlert Severity="Severity.Info" Class="mb-3" Dense="true" Icon="@Icons.Material.Filled.AccountTree">
        여기서 추가하는 계정은 <b>직원계정</b>입니다. 대표계정과 대표님이 권한을 준 직원만 직원계정을 만들 수 있으며, 본사에는 노출되지 않습니다.
        대표계정은 가입 시점에 자동 생성되며 삭제할 수 없습니다.
        <br />계정 한도는 <b>사용 중인 계정</b>만 셉니다(대표 포함).
    </MudAlert>

    <MudPaper Elevation="0" Class="pa-2 hitpan-card">
        <MudTable Items="_users" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                @* ⬛ 옛 머리 글자(계정 = 메일 주소) — 20261005작5 §6 사장님 캡처: 계정은 「아이디」(DB 칸 users.email 은 그대로) *@
                <MudTh>아이디</MudTh>
                <MudTh>이름</MudTh>
                <MudTh>부서·직책</MudTh>
                @* "계층" 도 개발용어다 — 고객은 대표/직원 구분으로 읽는다 (20260810작4) *@
                <MudTh Style="text-align:center">계정 구분</MudTh>
                <MudTh Style="text-align:center">역할</MudTh>
                <MudTh Style="text-align:center">사원 연결</MudTh>
                <MudTh Style="text-align:center">상태</MudTh>
                <MudTh Style="width:220px;text-align:center">처리</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd Style="font-weight:500">@context.Email</MudTd>
                <MudTd>@context.UserName</MudTd>
                <MudTd Style="font-size:12px;color:var(--mud-palette-text-secondary)">
                    @($"{context.Department} · {context.Position}".Trim(' ', '·'))
                </MudTd>
                <MudTd Style="text-align:center">
                    @* 용어 정정 (20260810작4) — 화면 표기만. IsParent 판정은 그대로 쓴다. *@
                    @if (context.IsParent)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                 Icon="@Icons.Material.Filled.Stars">대표계정</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">직원계정</MudChip>
                    }
                </MudTd>
                <MudTd Style="text-align:center">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                        Color="@(context.AccountType == "tenant_admin" ? Color.Primary : Color.Default)">
                        @(context.AccountType == "tenant_admin" ? "관리자" : "일반")
                    </MudChip>
                </MudTd>
                <MudTd Style="text-align:center">
                    @if (!string.IsNullOrEmpty(context.EmpName))
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Success">@context.EmpName</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Warning">⚠ 미연결</MudChip>
                    }
                </MudTd>
                <MudTd Style="text-align:center">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                        Color="@(context.IsActive ? Color.Success : Color.Default)">
                        @* ⬛ @(context.IsActive ? "활성" : "비활성") — 20261005작3 고객 노출 어휘 *@
                        @(context.IsActive ? "사용 중" : "사용 안 함")
                    </MudChip>
                </MudTd>
                <MudTd Style="text-align:center">
                    @* 20261005작5 §5-4 — 수정·비밀번호 초기화·계정폐기는 대표·관리자만(서버 TenantAdminOnly) ·
                       사용 안 함·다시 사용은 2단계 이상(서버 RequireUsersLevel(2) + 대상 울타리) *@
                    @if (_isAdmin)
                    {
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Default"
                        OnClick="@(() => OpenEditDialog(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.LockReset" Size="Size.Small" Color="Color.Info"
                        OnClick="@(() => OpenResetPwDialog(context))" />
                    }
                    @* ⬛ 옛 [비활성화] 아이콘 한 개(PersonOff → OpenDeactivateDialog) — 20261005작3 §5:
                       사용 중 행 = [사용 안 함]·[계정폐기] · 사용 안 함 행 = [다시 사용]·[계정폐기] *@
                    @if (!context.IsParent)
                    {
                        @if (_level >= 2)
                        {
                        @if (context.IsActive)
                        {
                            <MudTooltip Text="사용 안 함">
                                <MudIconButton Icon="@Icons.Material.Filled.PauseCircle" Size="Size.Small" Color="Color.Warning"
                                    OnClick="@(() => OpenSuspendDialog(context))" />
                            </MudTooltip>
                        }
                        else
                        {
                            <MudTooltip Text="다시 사용">
                                <MudIconButton Icon="@Icons.Material.Filled.PlayCircle" Size="Size.Small" Color="Color.Success"
                                    OnClick="@(() => ResumeAsync(context))" />
                            </MudTooltip>
                        }
                        }
                        @if (_isAdmin)
                        {
                        <MudTooltip Text="계정폐기">
                            <MudIconButton Icon="@Icons.Material.Filled.PersonOff" Size="Size.Small" Color="Color.Error"
                                OnClick="@(() => OpenDeactivateDialog(context))" />
                        </MudTooltip>
                        }
                    }
                    else if (context.IsParent)
                    {
                        <MudTooltip Text="대표계정은 삭제할 수 없습니다">
                            <MudIconButton Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Color="Color.Default" Disabled="true" />
                        </MudTooltip>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}
}
@* ↑ 20261005작5 — 단계 1 이상 화면 끝(위 `else` 블록) *@

@* 사용자 추가 다이얼로그 *@
<MudDialog @bind-Visible="_showCreate" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent><MudText Typo="Typo.h6">사용자 추가</MudText></TitleContent>
    <DialogContent>
        @* 20261005작5 §4 (D) — 맨 위에서 두 갈래. 기본 = 「기존 사원에서 고르기」(쌍둥이 사원 차단).
           「새 사원과 함께 만들기」는 대표·관리자만(V5-06 ① · 서버도 TenantAdminOnly) — 직원에게는 갈래 선택 자체가 안 보인다. *@
        @if (_isAdmin)
        {
            <MudRadioGroup T="bool" Value="_createFromEmployee" ValueChanged="OnCreateModeChanged" Class="mb-2">
                <MudRadio T="bool" Value="true" Color="Color.Primary">기존 사원에서 고르기</MudRadio>
                <MudRadio T="bool" Value="false" Color="Color.Primary">새 사원과 함께 만들기</MudRadio>
            </MudRadioGroup>
        }
        @if (_createFromEmployee)
        {
            @if (_linkableLoading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" />
            }
            else if (_linkable is null)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
                    사원 목록을 불러오지 못했습니다. 창을 닫았다가 다시 열어 주세요.
                </MudAlert>
            }
            else if (_linkable.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                    계정을 만들 수 있는 사원이 없습니다. 재직 중이고 아직 계정이 없는 사원만 여기에 나옵니다.
                    @if (_isAdmin)
                    {
                        <br />
                        <span>새로 온 사람이면 위에서 「새 사원과 함께 만들기」를 고르세요.</span>
                    }
                    else
                    {
                        <br />
                        <span>사원 등록은 대표님이나 인사 담당자에게 요청하세요.</span>
                    }
                </MudAlert>
            }
            else
            {
                <MudSelect T="string" Value="_linkModel.EmployeeId" ValueChanged="OnLinkEmployeeChanged"
                           Label="사원 선택 *" Variant="Variant.Outlined" Class="mb-2"
                           HelperText="재직 중이고 아직 계정이 없는 사원입니다">
                    @foreach (var emp in _linkable)
                    {
                        <MudSelectItem T="string" Value="@emp.EmployeeId">@LinkableLine(emp)</MudSelectItem>
                    }
                </MudSelect>
                @if (_linkPicked is not null)
                {
                    @* R-3 — 역할은 고르지 않는다. 그 사원의 직무가 그대로 쓰인다(바꾸려면 사원관리에서). *@
                    <MudPaper Elevation="0" Class="pa-3 mb-2" Style="background:var(--mud-palette-background-grey);border-radius:8px">
                        <MudText Typo="Typo.body2"><b>@_linkPicked.EmpName</b> (@_linkPicked.EmpNo)</MudText>
                        <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)">
                            부서 @(string.IsNullOrWhiteSpace(_linkPicked.DeptName) ? "-" : _linkPicked.DeptName)
                            · 직급 @(string.IsNullOrWhiteSpace(_linkPicked.Position) ? "-" : _linkPicked.Position)
                            · 직무 @AccountLinkLabels.RoleLabel(_linkPicked.Role)
                        </MudText>
                        <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)">
                            이름·부서·직급·직무는 사원 정보 그대로 씁니다. 바꾸려면 [사원관리]에서 고치세요.
                        </MudText>
                    </MudPaper>
                }
                <MudTextField T="string" @bind-Value="_linkModel.LoginId" Label="아이디 *" Variant="Variant.Outlined" Class="mb-2"
                              HelperText="로그인할 때 쓰는 아이디입니다 (공백 없이 4자 이상)" />
                <div class="d-flex gap-2 mb-2 align-center">
                    <MudTextField T="string" @bind-Value="_linkModel.Password" Label="임시 비밀번호 *" Variant="Variant.Outlined"
                        InputType="@(_showCreatePassword ? InputType.Text : InputType.Password)"
                        Adornment="Adornment.End"
                        AdornmentIcon="@(_showCreatePassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                        OnAdornmentClick="@(() => _showCreatePassword = !_showCreatePassword)"
                        AdornmentAriaLabel="비밀번호 표시 전환"
                        HelperText="@PasswordHint(_linkModel.Password)" Class="flex-grow-1" />
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="GenerateLinkTempPassword">랜덤생성</MudButton>
                </div>
            }
        }
        else
        {
        @* ⬛ Label="(옛 낱말) *" — 20261005작5 §6 계정은 「아이디」 *@
        <MudTextField T="string" @bind-Value="_createModel.Email" Label="아이디 *" Variant="Variant.Outlined" Class="mb-2"
                      HelperText="로그인할 때 쓰는 아이디입니다 (공백 없이 4자 이상)" />
        <MudTextField T="string" @bind-Value="_createModel.UserName" Label="이름 *" Variant="Variant.Outlined" Class="mb-2" />
        <div class="d-flex gap-2 mb-2 align-center">
            <MudTextField T="string" @bind-Value="_createModel.Password" Label="임시 비밀번호 *" Variant="Variant.Outlined"
                InputType="@(_showCreatePassword ? InputType.Text : InputType.Password)"
                Adornment="Adornment.End"
                AdornmentIcon="@(_showCreatePassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                OnAdornmentClick="@(() => _showCreatePassword = !_showCreatePassword)"
                AdornmentAriaLabel="비밀번호 표시 전환"
                HelperText="@PasswordHint(_createModel.Password)" Class="flex-grow-1" />
            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="GenerateTempPassword">랜덤생성</MudButton>
        </div>
        @* 부서 봉합 (사장님 오더 2026-08-10, 20260810작4)
           ─ 진범: 여기가 자유 텍스트라 "영업부"라고 쳐도 사원관리(부서 마스터 dept_id)와 글자가
             안 맞아, 사원관리·HR직원현황에서 부서가 계속 "-" 로 나왔다(사장님 Sandbox 실측).
           ─ 봉합: 부서 마스터에서 골라 넣는다. 저장되는 값은 종전과 같은 **부서명 문자열**이라
             API·DTO·SQL 은 한 줄도 안 바뀐다(users.department 는 문자열 컬럼).
           ─ 미선택 허용: 부서 마스터가 빈 회사에서도 계정은 만들어져야 한다. 필수 아님. *@
        <MudSelect T="string" @bind-Value="_createModel.Department" Label="부서" Variant="Variant.Outlined"
                   Class="mb-2" Clearable="true"
                   HelperText="@(_departments.Count == 0 ? "등록된 부서가 없습니다 — 비워두고 나중에 지정해도 됩니다" : null)">
            @foreach (var d in _departments)
            {
                <MudSelectItem T="string" Value="@d.DeptName">@d.DeptName</MudSelectItem>
            }
        </MudSelect>
        <MudTextField T="string" @bind-Value="_createModel.Position" Label="직책" Variant="Variant.Outlined" Class="mb-2" />
        <MudTextField T="string" @bind-Value="_createModel.Phone" Label="전화번호" Variant="Variant.Outlined" Class="mb-2" />
        <MudDatePicker @bind-Date="_createModel.HireDate" Label="입사일" Variant="Variant.Outlined" Class="mb-2" Editable="true" DateFormat="yyyy-MM-dd" />
        @* role 드롭다운 — tenant_user만 (관리자 증식 방지) *@
        <MudSelect T="string" @bind-Value="_createModel.Role" Label="역할" Variant="Variant.Outlined" Class="mb-2">
            <MudSelectItem Value="@("User")">일반 사용자</MudSelectItem>
            <MudSelectItem Value="@("Manager")">매니저</MudSelectItem>
        </MudSelect>
        <MudAlert Severity="Severity.Success" Class="mt-2" Dense="true">
            추가 시 사원 정보도 자동 등록됩니다. (사원관리에서 추가 정보 입력 가능)
        </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showCreate = false)" Disabled="_busy">취소</MudButton>
        @* ⬛ Disabled="_busy || !CanSubmitCreate" OnClick="SubmitCreate" — 20261005작5: 갈래에 따라 *@
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@(_busy || (_createFromEmployee ? !CanSubmitLink : !CanSubmitCreate))"
                   OnClick="SubmitCreateAnyAsync">
            @(_busy ? "저장 중..." : "추가")
        </MudButton>
    </DialogActions>
</MudDialog>

@* 20261005작5 V5-06 ② — 「새 사원과 함께」인데 같은 이름의 재직·미등록 사원이 이미 있다(쌍둥이 사원 의심).
   [연결] = 그 사원에 계정을 붙인다(사원을 새로 안 만든다) · [다른 사람입니다] = 동명이인 — 확인 표시를 붙여 다시 보낸다. *@
<MudDialog @bind-Visible="_showSameName" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent><MudText Typo="Typo.h6">같은 이름의 사원이 있습니다</MudText></TitleContent>
    <DialogContent>
        @foreach (var c in _sameNameCandidates)
        {
            <MudPaper Elevation="0" Class="pa-3 mb-2 d-flex align-center justify-space-between gap-2"
                      Style="border:0.5px solid var(--mud-palette-lines-default);border-radius:8px">
                <div>
                    <MudText Typo="Typo.body2">같은 이름의 사원 <b>@c.EmpName</b>(@c.EmpNo)이 있습니다. 이 사원에 연결할까요?</MudText>
                    <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)">
                        부서 @(string.IsNullOrWhiteSpace(c.DeptName) ? "-" : c.DeptName)
                        · 직급 @(string.IsNullOrWhiteSpace(c.Position) ? "-" : c.Position)
                        · 직무 @AccountLinkLabels.RoleLabel(c.Role)
                    </MudText>
                </div>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="_busy"
                           OnClick="@(() => LinkSameNameAsync(c))">연결</MudButton>
            </MudPaper>
        }
        <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)">
            [연결]을 누르면 그 사원에 계정이 붙고, 사원이 새로 생기지 않습니다. 이름만 같은 다른 사람이면 [다른 사람입니다]를 누르세요.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showSameName = false)" Disabled="_busy">취소</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="_busy" OnClick="CreateAsDifferentPersonAsync">다른 사람입니다</MudButton>
    </DialogActions>
</MudDialog>

@* 계정 생성 후 다음 걸음 안내 (사장님 오더 2026-08-10, 20260810작4)
   ─ 왜 필요한가: 계정만 만들면 그 직원은 로그인은 되는데 아무 메뉴도 못 본다.
     "처음 보는 사람이 혼자 쓸 수 있냐"(히트판 최종 통과 기준)를 지키려면
     다음에 뭘 해야 하는지 화면이 말해줘야 한다.
   ─ 흐름: 계정생성 → [권한설정] → 사원관리 → HR직원현황 *@
<MudDialog @bind-Visible="_showNextStep" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="mr-1" />
            @_createdUserName 님 계정이 만들어졌습니다
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">
            아직 이 직원은 <b>볼 수 있는 메뉴가 없습니다.</b> 권한을 정해주셔야 히트판을 쓸 수 있습니다.
        </MudText>
        <MudPaper Elevation="0" Class="pa-3" Style="background:var(--mud-palette-background-grey);border-radius:8px">
            <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)">다음 순서</MudText>
            <MudText Typo="Typo.body2" Class="mt-1">
                계정 만들기 ✓ → <b>권한 설정</b> → 사원 정보 → 직원 현황
            </MudText>
        </MudPaper>
        @* 20261005작5 — 권한 설정 화면은 대표·관리자만 연다. 직원이 만들었으면 누구에게 말할지 알려 준다. *@
        @if (!_isAdmin)
        {
            <MudText Typo="Typo.body2" Class="mt-3">
                권한은 대표님이 [권한 설정]에서 정합니다. 대표님께 이 직원의 권한을 요청하세요.
            </MudText>
        }
    </DialogContent>
    <DialogActions>
        @if (_isAdmin)
        {
        <MudButton OnClick="@(() => _showNextStep = false)">나중에</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Lock"
                   OnClick="@(() => Nav.NavigateTo("/users/permissions"))">
            권한 설정하러 가기
        </MudButton>
        }
        else
        {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => _showNextStep = false)">확인</MudButton>
        }
    </DialogActions>
</MudDialog>

@* 사용자 수정 다이얼로그 *@
<MudDialog @bind-Visible="_showEdit" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent><MudText Typo="Typo.h6">사용자 수정 — @_editTarget?.Email</MudText></TitleContent>
    <DialogContent>
        <MudTextField T="string" @bind-Value="_editModel.UserName" Label="이름 *" Variant="Variant.Outlined" Class="mb-2" />
        @* 수정 쪽도 같이 드롭다운으로 (20260810작4). 추가만 고치면 수정할 때 다시 어긋난다.
           🔴 [3-V] 병렬검증 적발 (2026-08-10): 기존 계정은 부서가 **자유 텍스트**로 저장돼 있다
              (test1-1 "영업부" 등, 사장님 Sandbox 실측분). 그 이름이 부서 마스터에 없으면
              드롭다운이 값을 못 찾아 빈 칸으로 보이고, 이름만 고쳐 저장하면 **부서가 조용히 지워진다.**
              → 마스터에 없는 기존 값도 선택지에 얹어 살려 둔다(_editDeptOptions). *@
        <MudSelect T="string" @bind-Value="_editModel.Department" Label="부서" Variant="Variant.Outlined"
                   Class="mb-2" Clearable="true">
            @foreach (var name in _editDeptOptions)
            {
                <MudSelectItem T="string" Value="@name">@name</MudSelectItem>
            }
        </MudSelect>
        <MudTextField T="string" @bind-Value="_editModel.Position" Label="직책" Variant="Variant.Outlined" Class="mb-2" />
        <MudTextField T="string" @bind-Value="_editModel.Phone" Label="전화번호" Variant="Variant.Outlined" Class="mb-2" />
        <MudSelect T="string" @bind-Value="_editModel.Role" Label="역할" Variant="Variant.Outlined" Class="mb-2">
            <MudSelectItem Value="@("User")">일반 사용자</MudSelectItem>
            <MudSelectItem Value="@("Manager")">매니저</MudSelectItem>
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showEdit = false)" Disabled="_busy">취소</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="SubmitEdit">
            @(_busy ? "저장 중..." : "저장")
        </MudButton>
    </DialogActions>
</MudDialog>

@* 비활성화 확인 다이얼로그 *@
<MudDialog @bind-Visible="_showDeactivate" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="color:var(--mud-palette-warning)">
            @* ⬛ 사용자 비활성화 — 20261005작3: 이 창은 「계정폐기」 확인 창이다(DELETE 의 뜻이 바뀜) *@
            <MudIcon Icon="@Icons.Material.Filled.Warning" /> 계정폐기
        </MudText>
    </TitleContent>
    <DialogContent>
        @* ⬛ 「계정을 비활성화합니다 · 해당 사용자는 더 이상 로그인할 수 없습니다」 *@
        <MudAlert Severity="Severity.Warning" Class="mb-3">
            <strong>@_deactivateTarget?.Email</strong> 계정을 폐기합니다. 아이디가 비워져 같은 아이디로 새 계정을 만들 수 있습니다.<br />
            폐기한 계정은 되살릴 수 없습니다. 직원(사원) 정보는 그대로 남습니다.
        </MudAlert>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showDeactivate = false)" Disabled="_busy">취소</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="_busy" OnClick="SubmitDeactivate">
            @(_busy ? "처리 중..." : "계정폐기")
        </MudButton>
    </DialogActions>
</MudDialog>

@* 20261005작3 §5 — 「사용 안 함」 확인 창 *@
<MudDialog @bind-Visible="_showSuspend" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent><MudText Typo="Typo.h6">사용 안 함</MudText></TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Info" Class="mb-3">
            <strong>@_suspendTarget?.Email</strong> 계정을 사용 안 함으로 바꿉니다. 이 계정으로는 로그인할 수 없고, 계정 한도에서 빠집니다.<br />
            나중에 [다시 사용]으로 되살릴 수 있습니다.
        </MudAlert>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showSuspend = false)" Disabled="_busy">취소</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Warning" Disabled="_busy" OnClick="SubmitSuspend">
            @(_busy ? "처리 중..." : "사용 안 함")
        </MudButton>
    </DialogActions>
</MudDialog>

@* 엑셀 일괄 업로드 다이얼로그 *@
<MudDialog @bind-Visible="_showBulk" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent><MudText Typo="Typo.h6">엑셀 일괄 사용자 등록</MudText></TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Info" Class="mb-3">
            ① 템플릿 다운로드 → ② 엑셀 작성 → ③ 업로드<br />
            첫 행은 헤더이며 변경하지 마세요. 한 행이 실패해도 나머지 행은 계속 처리됩니다.
        </MudAlert>

        <div class="d-flex gap-2 mb-3">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                StartIcon="@Icons.Material.Filled.Download"
                OnClick="DownloadTemplate" Disabled="_busy">
                템플릿 다운로드
            </MudButton>
            <MudFileUpload T="IBrowserFile" FilesChanged="OnFileSelected" Accept=".xlsx">
                <ActivatorContent>
                    <MudButton Variant="Variant.Filled" Color="Color.Success"
                        StartIcon="@Icons.Material.Filled.UploadFile"
                        Disabled="_busy">
                        @(_busy ? "업로드 중..." : "엑셀 선택 + 업로드")
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
        </div>

        @if (_bulkResult != null)
        {
            <MudPaper Elevation="0" Class="pa-3" Style="border:1px solid var(--mud-palette-lines-default);border-radius:8px">
                <MudText Typo="Typo.subtitle1" Style="font-weight:600">업로드 결과</MudText>
                <div class="d-flex gap-3 mt-2">
                    <MudChip T="string" Color="Color.Info" Variant="Variant.Filled">총 @(_bulkResult.TotalRows)행</MudChip>
                    <MudChip T="string" Color="Color.Success" Variant="Variant.Filled">성공 @(_bulkResult.SuccessCount)건</MudChip>
                    <MudChip T="string" Color="Color.Error" Variant="Variant.Filled">실패 @(_bulkResult.FailedCount)건</MudChip>
                </div>
                @if (_bulkResult.Errors.Any())
                {
                    <MudText Typo="Typo.body2" Class="mt-3" Style="font-weight:600">실패한 행:</MudText>
                    <MudSimpleTable Dense="true" Class="mt-1" Style="font-size:12px">
                        <thead>
                            @* ⬛ 옛 머리 「행 · (옛 낱말) · 실패 사유」 — 20261005작5 §6 「아이디」 *@
                            <tr><th>행</th><th>아이디</th><th>실패 사유</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var e in _bulkResult.Errors)
                            {
                                <tr><td>@e.Row</td><td>@e.Email</td><td style="color:var(--mud-palette-error)">@e.Reason</td></tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
                @* 20261005작5 V5-06 ③ — 같은 이름의 사원이 이미 있던 행. 막지 않았다(동명이인일 수 있다) — 쌍둥이인지 사람이 본다. *@
                @if (_bulkResult.SameNameWarnings.Any())
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">
                        같은 이름의 사원이 이미 있던 행이 @(_bulkResult.SameNameWarnings.Count)건 있습니다.
                        같은 사람이면 사원이 둘이 됐을 수 있으니 [사원관리]에서 확인하세요.
                    </MudAlert>
                    <MudSimpleTable Dense="true" Class="mt-1" Style="font-size:12px">
                        <thead>
                            <tr><th>행</th><th>이름</th><th>이미 있던 사원</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var w in _bulkResult.SameNameWarnings)
                            {
                                <tr>
                                    <td>@w.Row</td>
                                    <td>@w.Name</td>
                                    <td>@string.Join(", ", w.Candidates.Select(c => $"{c.EmpName}({c.EmpNo})"))</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            </MudPaper>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseBulkDialog">닫기</MudButton>
    </DialogActions>
</MudDialog>

@* 임시 비밀번호 발급 결과 다이얼로그 *@
<MudDialog @bind-Visible="_showResetResult" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent><MudText Typo="Typo.h6">임시 비밀번호 발급됨</MudText></TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Info" Class="mb-3">
            <strong>@_resetTarget?.Email</strong> 계정의 임시 비밀번호를 아래에서 복사해 사용자에게 전달하세요.
        </MudAlert>
        <MudPaper Elevation="0" Class="pa-3 d-flex align-center gap-2" Style="background:var(--mud-palette-background-grey);border-radius:8px">
            <MudText Typo="Typo.h6" Style="font-family:monospace;word-break:break-all;flex:1">
                @(_showResetPassword ? _tempPassword : new string('●', _tempPassword?.Length ?? 0))
            </MudText>
            <MudIconButton Size="Size.Small"
                Icon="@(_showResetPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                OnClick="@(() => _showResetPassword = !_showResetPassword)"
                aria-label="비밀번호 표시 전환" />
            <MudIconButton Size="Size.Small"
                Icon="@Icons.Material.Filled.ContentCopy"
                OnClick="CopyTempPasswordAsync"
                aria-label="비밀번호 복사" />
        </MudPaper>
        <MudText Typo="Typo.caption" Class="mt-3" Style="color:var(--mud-palette-text-secondary)">
            이 비밀번호는 다시 볼 수 없습니다. 사용자에게 전달 후 본인 비밀번호로 변경하도록 안내해주세요.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => _showResetResult = false)">확인</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<UserListModel> _users = new();
    private bool _loading = true;
    private bool _busy = false;

    // 다이얼로그 상태
    private bool _showCreate, _showEdit, _showDeactivate, _showResetResult, _showBulk;
    // 계정 생성 후 "다음 걸음" 안내 (20260810작4 흐름 연결)
    private bool _showNextStep;
    private string _createdUserName = "";

    // 부서 선택지 (20260810작4). 사원관리와 같은 부서 마스터를 본다 — 그래야 글자가 맞는다.
    private List<DepartmentModel> _departments = new();

    /// <summary>
    /// 수정 다이얼로그의 부서 선택지 ([3-V] 병렬검증 적발 봉합, 2026-08-10).
    ///
    /// 부서 마스터 + <b>지금 이 계정에 저장돼 있는 값</b>. 마스터에 없는 옛 자유 텍스트라도
    /// 선택지에 있어야 드롭다운이 그 값을 표시하고, 이름만 고쳐 저장할 때 부서가 안 지워진다.
    /// </summary>
    private List<string> _editDeptOptions = new();
    private CreateUserModel _createModel = new();
    private UpdateUserModel _editModel = new();
    private UserListModel? _editTarget, _deactivateTarget, _resetTarget;
    private string _tempPassword = "";
    // WO-4 보안: 비밀번호 마스킹 토글 (사장님 검증 발견 #1, 안랩·법무팀장 권고)
    private bool _showCreatePassword = false;
    private bool _showResetPassword = false;
    private BulkCreateResult? _bulkResult;

    protected override async Task OnInitializedAsync()
    {
        _seatApi = new AccountSeatApi(Http, SeatLog);
        // 20261005작5 §5-4 — 단계를 먼저. 0 이면 목록을 부르지 않는다(서버가 어차피 403 — 「못 불러왔다」로 보이면 거짓말이 된다).
        _linkApi = new AccountLinkApi(Http, LinkLog);
        var me = await _linkApi.GetMyLevelAsync();
        _level = me?.Level ?? 0;
        _isAdmin = me?.IsAdmin ?? false;
        _levelLoaded = true;
        if (_level < 1) { _loading = false; return; }
        await LoadAsync();
        await LoadDepartmentsAsync();
    }

    // ── 20261005작5 사원 ↔ 계정 연결 (설계 §4·§5-4) — 단계는 버튼을 숨기는 편의 · 판정은 서버가 정본 ──
    private AccountLinkApi _linkApi = null!;
    private bool _levelLoaded;
    /// <summary>「직원 계정 관리」 단계 0~3 (대표·관리자 = 3).</summary>
    private int _level;
    /// <summary>대표·관리자인가 — 수정·비번 초기화·계정폐기·엑셀·권한 설정·「새 사원과 함께」.</summary>
    private bool _isAdmin;

    private bool _createFromEmployee = true;
    private bool _linkableLoading;
    private List<LinkableEmployeeModel>? _linkable = new();
    private CreateForEmployeeModel _linkModel = new();
    private LinkableEmployeeModel? _linkPicked;

    private bool _showSameName;
    private List<LinkableEmployeeModel> _sameNameCandidates = new();

    private static string LinkableLine(LinkableEmployeeModel e)
    {
        var dept = string.IsNullOrWhiteSpace(e.DeptName) ? "" : $" · {e.DeptName}";
        var pos = string.IsNullOrWhiteSpace(e.Position) ? "" : $" · {e.Position}";
        return $"{e.EmpNo} {e.EmpName}{dept}{pos} · 직무 {AccountLinkLabels.RoleLabel(e.Role)}";
    }

    private bool CanSubmitLink =>
        _linkPicked is not null
        && !string.IsNullOrWhiteSpace(_linkModel.LoginId)
        && _linkModel.Password.Length >= 8;

    private async Task LoadLinkableAsync()
    {
        _linkableLoading = true;
        _linkable = await _linkApi.GetLinkableEmployeesAsync();
        _linkableLoading = false;
    }

    private async Task OnCreateModeChanged(bool fromEmployee)
    {
        _createFromEmployee = fromEmployee;
        if (fromEmployee && (_linkable is null || _linkable.Count == 0)) await LoadLinkableAsync();
    }

    private void OnLinkEmployeeChanged(string employeeId)
    {
        _linkModel.EmployeeId = employeeId;
        _linkPicked = _linkable?.FirstOrDefault(e => e.EmployeeId == employeeId);
    }

    private void GenerateLinkTempPassword() => _linkModel.Password = NewTempPassword();

    /// <summary>[추가] — 갈래에 따라 기존 사원 연결 또는 새 사원과 함께.</summary>
    private async Task SubmitCreateAnyAsync()
    {
        if (_createFromEmployee) await SubmitLinkAsync();
        else await SubmitCreate();
    }

    private async Task SubmitLinkAsync()
    {
        if (_linkPicked is null) return;
        _busy = true;
        var r = await _linkApi.CreateForEmployeeAsync(new CreateForEmployeeModel
        {
            EmployeeId = _linkPicked.EmployeeId,
            LoginId = _linkModel.LoginId.Trim(),
            Password = _linkModel.Password
        });
        _busy = false;
        await AfterLinkAsync(r, _linkPicked.EmpName);
    }

    /// <summary>연결 결과 공통 처리 — 성공·한도·그 밖(서버 문구 그대로).</summary>
    private async Task AfterLinkAsync(AccountLinkCallResult r, string name)
    {
        if (r.Ok)
        {
            _showCreate = false;
            _showSameName = false;
            await LoadAsync();
            _createdUserName = name;
            _showNextStep = true;
        }
        else if (r.SeatFull)
        {
            _showCreate = false;
            _showSameName = false;
            await LoadSeatsAsync();
            OpenSeatNotice(true);
        }
        else Snackbar.Add(r.Error ?? "처리하지 못했습니다.", Severity.Error);
    }

    /// <summary>같은 이름 확인 창 [연결] — 입력한 아이디·비밀번호로 그 사원에 계정을 붙인다(사원 새로 안 만듦).</summary>
    private async Task LinkSameNameAsync(LinkableEmployeeModel c)
    {
        _busy = true;
        var r = await _linkApi.CreateForEmployeeAsync(new CreateForEmployeeModel
        {
            EmployeeId = c.EmployeeId,
            LoginId = _createModel.Email.Trim(),
            Password = _createModel.Password
        });
        _busy = false;
        await AfterLinkAsync(r, c.EmpName);
    }

    /// <summary>같은 이름 확인 창 [다른 사람입니다] — 확인 표시를 붙여 같은 요청을 다시 보낸다.</summary>
    private async Task CreateAsDifferentPersonAsync()
    {
        _createModel.ConfirmDifferentPerson = true;
        _showSameName = false;
        await SubmitCreate();
    }

    /// <summary>[구독계정추가] — 3단계 서버 주소로 숫자를 다시 읽고 안내 창을 연다(USERS_SEAT 서버 강제 · P-2).</summary>
    private async Task OpenSubscribeAsync()
    {
        var sub = await _linkApi.GetSeatSubscriptionAsync();
        if (sub is null)
        {
            Snackbar.Add("구독 정보를 불러오지 못했습니다. 잠시 후 다시 해 주세요.", Severity.Warning);
            return;
        }
        _seats = new AccountSeatsModel { Active = sub.Active, BaseLimit = sub.BaseLimit, Extra = sub.Extra, Limit = sub.Limit, Tier = sub.Tier };
        OpenSeatNotice(false);
    }

    // ── 20261005작3 계정 과금 (설계 §5) — 판정은 서버가 정본 · 화면 검사는 편의 ──
    private AccountSeatApi _seatApi = null!;
    private AccountSeatsModel? _seats;
    private bool _showSeatNotice, _seatNoticeBlocked, _showSuspend;
    private UserListModel? _suspendTarget;

    // §10④ — 한도보다 많으면 음수 「남은 계정 -2개」 대신 넘친 수를 알린다
    private string SeatSub => _seats is null ? ""
        : _seats.Active > _seats.Limit
            ? $"한도보다 {_seats.Active - _seats.Limit}개 많습니다 — 새 계정·다시 사용이 막힙니다"
            : $"남은 계정 {_seats.Limit - _seats.Active}개";

    private async Task LoadSeatsAsync() => _seats = await _seatApi.GetSeatsAsync();

    private bool SeatsFull => _seats is not null && _seats.Active >= _seats.Limit;

    private void OpenSeatNotice(bool blocked)
    {
        _seatNoticeBlocked = blocked;
        _showSeatNotice = true;
    }

    private async Task OpenBulkDialog()
    {
        await LoadSeatsAsync();
        if (SeatsFull) { OpenSeatNotice(true); return; }
        _showBulk = true;
    }

    private async Task OpenSuspendDialog(UserListModel user)
    {
        var stepUp = await StepUpDialog.RequestAsync(DialogService, $"{user.Email} 사용 안 함");
        if (!stepUp) return;
        _suspendTarget = user;
        _showSuspend = true;
    }

    private async Task SubmitSuspend()
    {
        if (_suspendTarget == null) return;
        _busy = true;
        var r = await _seatApi.SuspendAsync(_suspendTarget.UserId);
        _busy = false;
        if (r.Ok)
        {
            Snackbar.Add($"{_suspendTarget.Email} 사용 안 함으로 바꿨습니다", Severity.Success);
            _showSuspend = false;
            await LoadAsync();
        }
        else Snackbar.Add($"처리하지 못했습니다: {r.Error}", Severity.Error);
    }

    private async Task ResumeAsync(UserListModel user)
    {
        _busy = true;
        var r = await _seatApi.ResumeAsync(user.UserId);
        _busy = false;
        if (r.Ok)
        {
            Snackbar.Add($"{user.Email} 다시 사용합니다", Severity.Success);
            await LoadAsync();
        }
        else if (r.SeatFull)
        {
            await LoadSeatsAsync();
            OpenSeatNotice(true);
        }
        else Snackbar.Add($"처리하지 못했습니다: {r.Error}", Severity.Error);
    }

    /// <summary>
    /// 부서 선택지를 사원관리와 같은 마스터에서 읽는다 (20260810작4).
    /// 실패해도 화면을 막지 않는다 — 부서는 선택 항목이고, 계정 생성 자체는 되어야 한다(헌법 #20).
    /// </summary>
    private async Task LoadDepartmentsAsync()
    {
        try
        {
            _departments = await EmpSvc.GetDepartmentsAsync();
        }
        catch (Exception ex)
        {
            // 헌법 #15 빈 catch 금지 — 흔적은 남기되 계정 관리는 계속 쓸 수 있어야 한다.
            Console.Error.WriteLine($"[HP15][Users/Departments] {ex.GetType().Name}: {ex.Message}");
            _departments = new();
        }
    }

    // 목록을 못 불러왔는지 여부. 🔴 "0명" 과 반드시 구분한다(20260809작4 ②번 봉합).
    //   종전에는 실패를 빈 리스트로 뭉개 "아직 등록된 사용자가 없습니다" 가 떴고,
    //   직원 12명이 있는 회사에서 사장님이 계정이 다 날아간 줄 아셨다.
    private bool _loadFailed;

    private async Task LoadAsync()
    {
        _loading = true;
        _loadFailed = false;
        try
        {
            var list = await UserSvc.GetAllAsync();
            if (list is null)
            {
                // null = 실패. 빈 리스트(정상 0건) 와 다른 사실이다.
                _loadFailed = true;
                _users = new();
            }
            else
            {
                _users = list;
            }
            // 20261005작3 — 목록과 카드 숫자를 같이 새로 읽는다
            if (_seatApi is not null) await LoadSeatsAsync();
        }
        finally
        {
            // 예외가 나도 진행바가 영원히 돌지 않게 한다.
            _loading = false;
        }
    }

    // ── 추가 ──
    // ⬛ private void OpenCreateDialog() — 20261005작3: 누르기 전 한도 확인(차 있으면 입력창 대신 안내 창)
    private async Task OpenCreateDialog()
    {
        await LoadSeatsAsync();
        if (SeatsFull) { OpenSeatNotice(true); return; }
        _createModel = new() { Role = "User" };
        _showCreatePassword = false; // 항상 마스킹 상태로 시작
        // 20261005작5 §4 — 기본은 「기존 사원에서 고르기」. 목록은 열 때마다 새로 읽는다(다른 창에서 막 연결됐을 수 있다).
        _createFromEmployee = true;
        _linkModel = new();
        _linkPicked = null;
        _showCreate = true;
        await LoadLinkableAsync();
    }

    private bool CanSubmitCreate =>
        !string.IsNullOrWhiteSpace(_createModel.Email)
        && !string.IsNullOrWhiteSpace(_createModel.UserName)
        && _createModel.Password.Length >= 8;

    private async Task SubmitCreate()
    {
        _busy = true;
        // ⬛ var (ok, error) = await UserSvc.CreateAsync(_createModel);
        // ⬛ var created = await _seatApi.CreateAsync(_createModel);  ← 20261005작5: 같은 이름 사원 응답(후보)까지 읽는 호출로
        var created = await _linkApi.CreateWithNewEmployeeAsync(_createModel);
        var (ok, error) = (created.Ok, created.Error);
        _busy = false;
        if (!ok && created.SameNameEmployee && created.Candidates.Count > 0)
        {
            // 20261005작5 V5-06 ② — 같은 이름의 재직·미등록 사원이 있다 ⇒ 연결할지 묻는다(막지는 않는다 — 동명이인)
            _sameNameCandidates = created.Candidates.ToList();
            _showSameName = true;
            return;
        }
        if (!ok && created.SeatFull)
        {
            // 서버가 막았다(경쟁·화면 낡음) — 같은 안내 창
            _showCreate = false;
            await LoadSeatsAsync();
            OpenSeatNotice(true);
            return;
        }
        if (ok)
        {
            _showCreate = false;
            await LoadAsync();

            // 흐름 연결 (사장님 오더 2026-08-10, 20260810작4):
            //   직원계정 → 계정생성 → **권한설정** → 사원관리 → HR직원현황
            // 종전에는 여기서 스낵바 한 줄 뜨고 길이 끊겼다. 계정만 만들어 두면 그 사람은
            // 로그인은 되는데 아무것도 못 하는 상태로 남는다 — 다음 걸음을 화면이 알려줘야 한다.
            _createdUserName = _createModel.UserName;
            _showNextStep = true;
        }
        else
        {
            Snackbar.Add($"추가 실패: {error}", Severity.Error);
        }
    }

    // ── 수정 ──
    private async Task OpenEditDialog(UserListModel user)
    {
        // WO-20260430-9 Step-up: 사용자 정보 수정 = 민감 작업
        var stepUp = await StepUpDialog.RequestAsync(DialogService,
            $"{user.Email} 정보 수정");
        if (!stepUp) return;

        _editTarget = user;

        // [3-V] 봉합 (20260810작4): 마스터 부서 + 이 계정에 이미 저장된 부서를 합친다.
        //   마스터에 없는 옛 값(자유 텍스트)이 선택지에서 빠지면 드롭다운이 빈 칸으로 보이고,
        //   그대로 저장하면 부서가 조용히 지워진다.
        _editDeptOptions = _departments.Select(d => d.DeptName).ToList();
        if (!string.IsNullOrWhiteSpace(user.Department) && !_editDeptOptions.Contains(user.Department))
        {
            _editDeptOptions.Insert(0, user.Department);
        }

        _editModel = new()
        {
            UserName = user.UserName,
            EmpName = user.EmpName,
            Department = user.Department,
            Position = user.Position,
            Phone = user.Phone,
            Role = user.Role,
            IsActive = user.IsActive,
            HireDate = user.HireDate
        };
        _showEdit = true;
    }

    private async Task SubmitEdit()
    {
        if (_editTarget == null) return;
        _busy = true;
        // ⬛ var ok = await UserSvc.UpdateAsync(_editTarget.UserId, _editModel);
        var updated = await _seatApi.UpdateAsync(_editTarget.UserId, _editModel);
        _busy = false;
        if (updated.Ok)
        {
            Snackbar.Add("수정되었습니다.", Severity.Success);
            _showEdit = false;
            await LoadAsync();
        }
        else if (updated.SeatFull)
        {
            _showEdit = false;
            await LoadSeatsAsync();
            OpenSeatNotice(true);
        }
        else Snackbar.Add($"수정 실패: {updated.Error}", Severity.Error);
    }

    // ── 비활성화 ──
    private async Task OpenDeactivateDialog(UserListModel user)
    {
        // WO-20260430-9 Step-up: 비활성화 = 민감 작업
        var stepUp = await StepUpDialog.RequestAsync(DialogService,
            $"{user.Email} 계정 비활성화");
