            _showResetResult = true;
        }
        else Snackbar.Add("비밀번호 초기화 실패", Severity.Error);
    }

    // 임시 비밀번호 클립보드 복사
    private async Task CopyTempPasswordAsync()
    {
        if (string.IsNullOrEmpty(_tempPassword)) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _tempPassword);
            Snackbar.Add("비밀번호가 클립보드에 복사되었습니다", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"복사 실패: {ex.Message}", Severity.Error);
        }
    }

    // ── 엑셀 일괄 ──
    private async Task DownloadTemplate()
    {
        _busy = true;
        var bytes = await UserSvc.GetBulkTemplateAsync();
        _busy = false;
        if (bytes == null) { Snackbar.Add("템플릿 다운로드 실패", Severity.Error); return; }

        // JS interop으로 브라우저 다운로드 트리거
        await JS.InvokeVoidAsync("downloadFileFromBytes",
            "히트판_사용자_일괄등록_템플릿.xlsx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            Convert.ToBase64String(bytes));
    }

    private async Task OnFileSelected(IBrowserFile file)
    {
        if (file == null) return;
        _busy = true;
        _bulkResult = null;
        using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // 10MB
        // ⬛ _bulkResult = await UserSvc.BulkUploadAsync(stream, file.Name);
        var bulk = await _seatApi.BulkUploadAsync(stream, file.Name);
        _bulkResult = bulk;
        _busy = false;
        if (bulk is { SeatFull: true })
        {
            // F-5 — 한도 때문에 한 줄도 안 넣었다 · 같은 안내 창
            await LoadSeatsAsync();
            OpenSeatNotice(true);
            return;
        }
        if (_bulkResult != null && _bulkResult.SuccessCount > 0)
        {
            Snackbar.Add($"{_bulkResult.SuccessCount}건 등록 성공", Severity.Success);
            await LoadAsync();
        }
        if (_bulkResult?.FailedCount > 0)
            Snackbar.Add($"{_bulkResult.FailedCount}건 실패 — 다이얼로그에서 확인", Severity.Warning);
    }

    private void CloseBulkDialog()
    {
        _showBulk = false;
        _bulkResult = null;
    }

    // ── 유틸 ──
    private void GenerateTempPassword()
    {
        // ⬛ 본문(문자표·Random·12자)은 NewTempPassword 로 옮겼다 — 20261005작5: 「기존 사원에서 고르기」 칸도 같은 규칙
        _createModel.Password = NewTempPassword();
    }

    // ⬛ 종전 본문: 문자표 + new Random() + 12자 — 작5 §8-8(CodeQL insecure-randomness): 사원관리와 같은 함수 하나(AccountTempPassword)로
    private static string NewTempPassword() => AccountTempPassword.New();

    private static string PasswordHint(string pw)
    {
        if (string.IsNullOrEmpty(pw)) return "8자 이상, 숫자·대소문자·특수기호 포함 권장";
        if (pw.Length < 8) return "❌ 8자 이상 필요";
        var hasDigit = pw.Any(char.IsDigit);
        var hasUpper = pw.Any(char.IsUpper);
        var hasLower = pw.Any(char.IsLower);
        var hasSpec = pw.Any(c => "!@#$%^&*()_+".Contains(c));
        var score = (hasDigit ? 1 : 0) + (hasUpper ? 1 : 0) + (hasLower ? 1 : 0) + (hasSpec ? 1 : 0);
        return score switch
        {
            4 => "🟢 매우 강함",
            3 => "🟡 강함",
            2 => "🟠 보통",
            _ => "🔴 약함 — 숫자·대소문자·특수기호 섞으세요"
        };
    }
}
