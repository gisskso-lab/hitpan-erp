@page "/tax/certificate"
@namespace HitPan.Web.Pages.TaxUi
@attribute [Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime Js

<PageTitle>범용인증서 관리 — 히트판 ERP</PageTitle>

<PageHeader Title="범용인증서 관리"
            Subtitle="PFX/P12 인증서 등록 · 관리 · 기본 인증서 지정">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.CloudUpload"
                   OnClick="OpenUploadDialog">
            인증서 등록
        </MudButton>
    </Actions>
</PageHeader>

<MudAlert Severity="Severity.Info" Class="mb-3" Dense="true" Elevation="0">
    <MudText Typo="Typo.body2">
        <b>보안 이중 보호:</b> PFX 파일은 <b>AES-256</b>, 비밀번호는 <b>DPAPI</b>로 암호화되어 저장됩니다.
    </MudText>
</MudAlert>

@* ── KPI 카드 4개 (전체 / 활성 / 만료 임박 / 만료·폐기) — 공용 KpiCard 사용 ── *@
<MudGrid Spacing="2" Class="mb-3">
    <MudItem xs="12" sm="6" md="3">
        <KpiCard Color="KpiCard.KpiColor.Primary"
                 Label="전체 인증서"
                 Value="@($"{_list.Count} 건")" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <KpiCard Color="KpiCard.KpiColor.Info"
                 Label="활성"
                 Value="@($"{_list.Count(c => c.Status == "active")} 건")"
                 EmphasizeValue="true" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <KpiCard Color="KpiCard.KpiColor.Warning"
                 Label="만료 임박 (30일)"
                 Value="@($"{_list.Count(c => c.Status == "active" && c.DaysUntilExpiry <= 30 && c.DaysUntilExpiry >= 0)} 건")"
                 EmphasizeValue="true" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <KpiCard Color="KpiCard.KpiColor.Error"
                 Label="만료/폐기"
                 Value="@($"{_list.Count(c => c.Status != "active")} 건")"
                 EmphasizeValue="true" />
    </MudItem>
</MudGrid>

<MudPaper Elevation="0" Class="pa-0 hitpan-card" Style="overflow:hidden">
    <MudTable Items="_list" Dense="true" Hover="true" Striped="true" Elevation="0"
              Loading="_loading" LoadingProgressColor="Color.Primary">
        <HeaderContent>
            <MudTh Style="width:40px">기본</MudTh>
            <MudTh>유형</MudTh>
            <MudTh>주체명 (사업자)</MudTh>
            <MudTh>발급기관</MudTh>
            <MudTh>유효기간</MudTh>
            <MudTh Style="text-align:center">상태</MudTh>
            <MudTh Style="text-align:center">잔여일</MudTh>
            <MudTh Style="text-align:center;width:140px">작업</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                @if (context.IsPrimary)
                {
                    <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Style="color:var(--hitpan-star)" />
                }
            </MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                         Color="@GetTypeColor(context.CertType)">
                    @GetTypeLabel(context.CertType)
                </MudChip>
            </MudTd>
            <MudTd Style="font-weight:500">@context.SubjectName</MudTd>
            <MudTd>@(context.IssuerName ?? "-")</MudTd>
            <MudTd>
                <span style="font-size:12px">
                    @context.ValidFrom.ToString("yyyy-MM-dd") ~ @context.ValidUntil.ToString("yyyy-MM-dd")
                </span>
            </MudTd>
            <MudTd Style="text-align:center">
                <MudChip T="string" Size="Size.Small"
                         Color="@GetStatusColor(context.Status)"
                         Variant="Variant.Filled">
                    @GetStatusLabel(context.Status)
                </MudChip>
            </MudTd>
            <MudTd Style="@($"text-align:center;font-weight:600;color:{GetDaysColor(context.DaysUntilExpiry)}")">
                @if (context.DaysUntilExpiry < 0) { <span>만료됨</span> }
                else { <span>@context.DaysUntilExpiry 일</span> }
            </MudTd>
            <MudTd Style="text-align:center">
                @if (context.Status == "active" && !context.IsPrimary)
                {
                    <MudTooltip Text="기본 인증서로 설정">
                        <MudIconButton Icon="@Icons.Material.Filled.Star" Size="Size.Small"
                                       OnClick="@(() => SetPrimaryAsync(context.CertId))" />
                    </MudTooltip>
                }
                @if (context.Status == "active")
                {
                    <MudTooltip Text="폐기">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => DeleteAsync(context.CertId, context.SubjectName))" />
                    </MudTooltip>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="pa-6 text-center" Style="color:var(--hitpan-text-faint)">
                등록된 인증서가 없습니다. 상단 <b>"인증서 등록"</b> 버튼을 눌러 PFX/P12 파일을 업로드하세요.
            </MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    private List<CertificateItem> _list = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var result = await Http.GetFromJsonAsync<List<CertificateItem>>("api/certificates");
            _list = result ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"인증서 목록 로드 실패: {ex.Message}", Severity.Error);
        }
        finally { _loading = false; }
    }

    private async Task OpenUploadDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dlg = await DialogService.ShowAsync<CertificateUploadDialog>("인증서 등록", new DialogParameters(), options);
        var result = await dlg.Result;
        if (result is not null && !result.Canceled) await LoadAsync();
    }

    private async Task SetPrimaryAsync(string certId)
    {
        if (!await Js.InvokeAsync<bool>("confirm", "이 인증서를 기본으로 설정하시겠습니까?\n기존 기본 인증서는 해제됩니다.")) return;
        try
        {
            var resp = await Http.PutAsync($"api/certificates/{certId}/primary", null);
            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add("기본 인증서로 설정되었습니다.", Severity.Success);
                await LoadAsync();
            }
            else
            {
                var err = await resp.Content.ReadAsStringAsync();
                Snackbar.Add($"실패: {err}", Severity.Error);
            }
        }
        catch (Exception ex) { Snackbar.Add($"오류: {ex.Message}", Severity.Error); }
    }

    private async Task DeleteAsync(string certId, string subjectName)
    {
        if (!await Js.InvokeAsync<bool>("confirm", $"'{subjectName}' 인증서를 폐기하시겠습니까?\n폐기 후 복구할 수 없습니다.")) return;
        try
        {
            var resp = await Http.DeleteAsync($"api/certificates/{certId}");
            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add("인증서가 폐기되었습니다.", Severity.Success);
                await LoadAsync();
            }
            else { Snackbar.Add("폐기 실패", Severity.Error); }
        }
        catch (Exception ex) { Snackbar.Add($"오류: {ex.Message}", Severity.Error); }
    }

    private static string GetTypeLabel(string type) => type switch
    {
        "general" => "범용", "financial" => "금융", "tax" => "세무", _ => type
    };

    private static Color GetTypeColor(string type) => type switch
    {
        "general" => Color.Primary, "financial" => Color.Info, "tax" => Color.Success, _ => Color.Default
    };

    private static string GetStatusLabel(string status) => status switch
    {
        "active" => "활성", "expired" => "만료", "revoked" => "폐기", _ => status
    };

    private static Color GetStatusColor(string status) => status switch
    {
        "active" => Color.Success, "expired" => Color.Warning, "revoked" => Color.Error, _ => Color.Default
    };

    private static string GetDaysColor(int days)
    {
        if (days < 0) return "#D32F2F";
        if (days <= 7) return "#D32F2F";
        if (days <= 30) return "#F57C00";
        return "#374151";
    }

    public class CertificateItem
    {
        public string CertId { get; set; } = "";
        public string CertType { get; set; } = "general";
        public string SubjectName { get; set; } = "";
        public string? IssuerName { get; set; }
        public string? SerialNo { get; set; }
        public DateTime ValidFrom { get; set; }
        public DateTime ValidUntil { get; set; }
        public bool IsPrimary { get; set; }
        public DateTime? LastUsedAt { get; set; }
        public string Status { get; set; } = "active";
        public int DaysUntilExpiry { get; set; }
    }
}
