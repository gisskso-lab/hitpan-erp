@namespace HitPan.Web.Pages.TaxUi
@using System.Net.Http.Headers
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Color="Color.Primary" />
            <MudText Typo="Typo.h6">범용인증서 등록</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            @* 파일 선택 *@
            <div>
                <MudText Typo="Typo.caption" Class="mb-1" Style="color:#666">PFX/P12 파일 선택</MudText>
                <MudFileUpload T="IBrowserFile" FilesChanged="OnFileChanged" Accept=".pfx,.p12">
                    <ActivatorContent>
                        <MudButton HtmlTag="label" Variant="Variant.Outlined" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.AttachFile" FullWidth="true">
                            @(_file?.Name ?? "파일 선택 (.pfx, .p12)")
                        </MudButton>
                    </ActivatorContent>
                </MudFileUpload>
                @if (_file != null)
                {
                    <MudText Typo="Typo.caption" Class="mt-1" Style="color:#0F6E56">
                        ✓ @_file.Name (@FormatSize(_file.Size))
                    </MudText>
                }
            </div>

            @* 인증서 유형 *@
            <MudSelect T="string" @bind-Value="_request.CertType" Label="인증서 유형"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                <MudSelectItem Value="@("general")">범용</MudSelectItem>
                <MudSelectItem Value="@("financial")">금융</MudSelectItem>
                <MudSelectItem Value="@("tax")">세무 (전자세금계산서용)</MudSelectItem>
            </MudSelect>

            @* 주체명 *@
            <MudTextField T="string" @bind-Value="_request.SubjectName"
                          Label="주체명 (사업자명) *" Required="true"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Placeholder="예: (주)히트판" />

            @* 발급기관 *@
            <MudTextField T="string" @bind-Value="_request.IssuerName"
                          Label="발급기관"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Placeholder="예: 한국정보인증" />

            @* 시리얼번호 *@
            <MudTextField T="string" @bind-Value="_request.SerialNo"
                          Label="시리얼번호"
                          Variant="Variant.Outlined" Margin="Margin.Dense" />

            @* 유효기간 *@
            <MudStack Row="true" Spacing="2">
                <MudDatePicker @bind-Date="_validFrom" Label="유효 시작일 *"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               DateFormat="yyyy-MM-dd" Style="flex:1" />
                <MudDatePicker @bind-Date="_validUntil" Label="유효 종료일 *"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               DateFormat="yyyy-MM-dd" Style="flex:1" />
            </MudStack>

            @* 비밀번호 *@
            <MudTextField T="string" @bind-Value="_request.Password"
                          Label="인증서 비밀번호 *" Required="true"
                          InputType="InputType.Password"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Lock"
                          HelperText="DPAPI로 암호화되어 저장됩니다 (서버 외부 유출 불가)" />

            @* 기본 인증서 설정 *@
            <MudCheckBox T="bool" @bind-Value="_request.IsPrimary" Color="Color.Primary">
                <MudText Typo="Typo.body2">기본 인증서로 설정 (기존 기본 인증서는 해제됨)</MudText>
            </MudCheckBox>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">취소</MudButton>
        <MudButton OnClick="Upload" Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.CloudUpload"
                   Disabled="_uploading">
            @(_uploading ? "업로드 중..." : "등록")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private IBrowserFile? _file;
    private UploadRequest _request = new();
    private DateTime? _validFrom = DateTime.Today;
    private DateTime? _validUntil = DateTime.Today.AddYears(1);
    private bool _uploading;

    private void OnFileChanged(IBrowserFile file)
    {
        // 파일 크기 검증 (5MB 이하)
        if (file.Size > 5 * 1024 * 1024)
        {
            Snackbar.Add("파일 크기는 5MB 이하만 가능합니다.", Severity.Error);
            return;
        }
        // 확장자 검증
        var ext = Path.GetExtension(file.Name).ToLowerInvariant();
        if (ext != ".pfx" && ext != ".p12")
        {
            Snackbar.Add("PFX 또는 P12 파일만 등록할 수 있습니다.", Severity.Error);
            return;
        }
        _file = file;
        StateHasChanged();
    }

    private async Task Upload()
    {
        // 필수값 검증
        if (_file is null) { Snackbar.Add("인증서 파일을 선택해주세요.", Severity.Warning); return; }
        if (string.IsNullOrWhiteSpace(_request.SubjectName)) { Snackbar.Add("주체명(사업자명)은 필수입니다.", Severity.Warning); return; }
        if (string.IsNullOrWhiteSpace(_request.Password)) { Snackbar.Add("비밀번호는 필수입니다.", Severity.Warning); return; }
        if (_validFrom is null || _validUntil is null) { Snackbar.Add("유효기간을 입력해주세요.", Severity.Warning); return; }
        if (_validUntil <= DateTime.Today) { Snackbar.Add("이미 만료된 인증서는 등록할 수 없습니다.", Severity.Warning); return; }

        _request.ValidFrom = _validFrom.Value;
        _request.ValidUntil = _validUntil.Value;

        _uploading = true;
        try
        {
            using var content = new MultipartFormDataContent();

            // 파일 스트림 첨부 (최대 5MB)
            var stream = _file.OpenReadStream(5 * 1024 * 1024);
            var fileContent = new StreamContent(stream);
            fileContent.Headers.ContentType = new MediaTypeHeaderValue("application/x-pkcs12");
            content.Add(fileContent, "file", _file.Name);

            // 폼 필드 추가 (UploadCertificateRequest 매핑)
            content.Add(new StringContent(_request.CertType), nameof(_request.CertType));
            content.Add(new StringContent(_request.SubjectName), nameof(_request.SubjectName));
            if (!string.IsNullOrWhiteSpace(_request.IssuerName))
                content.Add(new StringContent(_request.IssuerName!), nameof(_request.IssuerName));
            if (!string.IsNullOrWhiteSpace(_request.SerialNo))
                content.Add(new StringContent(_request.SerialNo!), nameof(_request.SerialNo));
            content.Add(new StringContent(_request.ValidFrom.ToString("yyyy-MM-dd")), nameof(_request.ValidFrom));
            content.Add(new StringContent(_request.ValidUntil.ToString("yyyy-MM-dd")), nameof(_request.ValidUntil));
            content.Add(new StringContent(_request.Password), nameof(_request.Password));
            content.Add(new StringContent(_request.IsPrimary.ToString().ToLower()), nameof(_request.IsPrimary));

            var resp = await Http.PostAsync("api/certificates/upload", content);
            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add("인증서가 등록되었습니다.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                var err = await resp.Content.ReadAsStringAsync();
                Snackbar.Add($"등록 실패: {err}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"오류: {ex.Message}", Severity.Error);
        }
        finally
        {
            _uploading = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    // 파일 크기 표시 (KB/MB)
    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / 1024.0 / 1024.0:F1} MB";
    }

    // 업로드 요청 모델 (API DTO와 매핑)
    private class UploadRequest
    {
        public string CertType { get; set; } = "general";
        public string SubjectName { get; set; } = "";
        public string? IssuerName { get; set; }
        public string? SerialNo { get; set; }
        public DateTime ValidFrom { get; set; }
        public DateTime ValidUntil { get; set; }
        public string Password { get; set; } = "";
        public bool IsPrimary { get; set; }
    }
}
