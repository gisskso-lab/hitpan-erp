@page "/settings/user-info"
@page "/company"
@namespace HitPan.Web.Pages.SettingsUi
@attribute [Authorize]
@using HitPan.Web.Models

<PageTitle>사용자정보설정</PageTitle>

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
    <MudText Typo="Typo.h6">사용자정보설정</MudText>
    @* 고객 노출 문구에 개발용어 금지 — "테넌트" 를 우리 회사 말로 바꾼다 *@
    <MudText Style="font-size:12px;color:var(--mud-palette-text-secondary)">회사 기본정보 및 출력 이미지 관리</MudText>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    @if (_model.IsLockedFromLanding)
    {
        @* 헌법 #35 (사장님 결재 2026-06-04) — 랜딩 자동 반영 잠금 안내 *@
        <MudAlert Severity="Severity.Warning" Class="mb-3" Dense="true" Icon="@Icons.Material.Filled.Lock">
            이 회사 정보는 가입 시 사업자등록증으로 자동 반영된 정보입니다.
            <b>회사명·사업자번호·대표자명</b>은 변경할 수 없습니다.
            변경이 필요하면 본사 고객지원으로 사업자등록증 재등록을 요청해주세요.
        </MudAlert>
    }
    <MudGrid Spacing="3">
        <MudItem xs="12" md="8">
            <MudPaper Elevation="0" Class="pa-4" Style="border:0.5px solid var(--mud-palette-lines-default);border-radius:12px">
                <MudText Typo="Typo.subtitle2" Class="mb-3">기본 사업장 정보</MudText>
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" Label="사용업체명" @bind-Value="_model.CompanyName" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="@_model.IsLockedFromLanding" HelperText="@(_model.IsLockedFromLanding ? "🔒 랜딩 자동 반영 (변경 불가)" : null)" />
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField T="string" Label="우편번호" @bind-Value="_model.ZipCode" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudButton Variant="Variant.Outlined" OnClick="OpenZipcodeSearch" Style="height:40px;margin-top:4px">우편번호 찾기</MudButton>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudTextField T="string" Label="전화" @bind-Value="_model.Phone" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" md="5">
                        <MudTextField T="string" Label="주소" @bind-Value="_model.Address" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" md="5">
                        <MudTextField T="string" Label="상세주소" @bind-Value="_model.AddressDetail" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="상세주소 직접 입력" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField T="string" Label="사업자번호" @bind-Value="_model.BusinessNo" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="@_model.IsLockedFromLanding" HelperText="@(_model.IsLockedFromLanding ? "🔒 랜딩 자동 반영 (변경 불가)" : null)" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField T="string" Label="종사업장번호" @bind-Value="_model.BranchNo" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField T="string" Label="법인등록번호" @bind-Value="_model.CorporateNo" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField T="string" Label="업태" @bind-Value="_model.BusinessType" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField T="string" Label="업종" @bind-Value="_model.BusinessCategory" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField T="string" Label="대표자" @bind-Value="_model.CeoName" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="@_model.IsLockedFromLanding" HelperText="@(_model.IsLockedFromLanding ? "🔒 랜딩 자동 반영 (변경 불가)" : null)" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField T="string" Label="팩스" @bind-Value="_model.Fax" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField T="string" Label="홈페이지" @bind-Value="_model.Homepage" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudTextField T="string" Label="이메일" @bind-Value="_model.Email" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField T="string" Label="비고" @bind-Value="_model.Note" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" />
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudPaper Elevation="0" Class="pa-4 mb-3" Style="border:0.5px solid var(--mud-palette-lines-default);border-radius:12px">
                <MudText Typo="Typo.subtitle2" Class="mb-2">출력 이미지 등록</MudText>
                @*
                    종전에는 InputFile 을 display:none 으로 숨기고 옆의 버튼이 열어주길 기대했으나,
                    그 버튼은 파일선택창을 여는 코드가 없어 무엇을 눌러도 아무 일이 없었다(사장님 지적).
                    → 숨기지 않고 label 로 감싼다. label 을 누르면 브라우저가 표준 동작으로
                      안쪽 파일선택창을 연다. 자바스크립트 없이 동작해 가장 튼튼하다.
                *@
                <MudStack Spacing="2">
                    <label class="hitpan-file-pick">
                        <span>로고 등록</span>
                        <InputFile OnChange="OnLogoChanged" accept=".png,.jpg,.jpeg,.svg" />
                    </label>
                    @if (!string.IsNullOrWhiteSpace(_model.LogoPreviewUrl))
                    {
                        <MudPaper Elevation="0" Class="pa-2" Style="border:0.5px dashed var(--mud-palette-lines-default)">
                            <MudText Style="font-size:11px;color:var(--mud-palette-text-secondary)">로고 미리보기</MudText>
                            <img src="@_model.LogoPreviewUrl" alt="로고 미리보기" style="max-width:100%;max-height:80px;object-fit:contain" />
                        </MudPaper>
                    }

                    <label class="hitpan-file-pick">
                        <span>인장 등록</span>
                        <InputFile OnChange="OnSealChanged" accept=".png,.jpg,.jpeg" />
                    </label>
                    @if (!string.IsNullOrWhiteSpace(_model.SealPreviewUrl))
                    {
                        <MudPaper Elevation="0" Class="pa-2" Style="border:0.5px dashed var(--mud-palette-lines-default)">
                            <MudText Style="font-size:11px;color:var(--mud-palette-text-secondary)">인장 미리보기</MudText>
                            <img src="@_model.SealPreviewUrl" alt="인장 미리보기" style="max-width:100%;max-height:80px;object-fit:contain" />
                        </MudPaper>
                    }

                    <label class="hitpan-file-pick">
                        <span>헤더 등록</span>
                        <InputFile OnChange="OnHeaderChanged" accept=".png,.jpg,.jpeg" />
                    </label>
                    @if (!string.IsNullOrWhiteSpace(_model.HeaderPreviewUrl))
                    {
                        <MudPaper Elevation="0" Class="pa-2" Style="border:0.5px dashed var(--mud-palette-lines-default)">
                            <MudText Style="font-size:11px;color:var(--mud-palette-text-secondary)">헤더 미리보기</MudText>
                            <img src="@_model.HeaderPreviewUrl" alt="헤더 미리보기" style="max-width:100%;max-height:80px;object-fit:contain" />
                        </MudPaper>
                    }

                    @* 아직 이미지 파일을 서버에 보관하는 경로가 없다. 화면에서 고른 그림은
                       미리보기로만 보이고, 적용을 눌러도 다음에 열면 남아있지 않는다.
                       고객이 "저장됐겠지" 하고 오해하지 않도록 화면에 그대로 알린다. *@
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-1" Style="font-size:11px">
                        지금은 고른 그림을 화면에서 미리 보는 것까지만 됩니다.
                        인쇄 서식에 넣는 기능은 준비 중입니다.
                    </MudAlert>
                </MudStack>
            </MudPaper>

            @*
                사용자추가·관리 카드 제거 (사장님 지적 2026-08-09 — "기능중복으로 사실상 필요없음").
                직원 추가·수정은 사원관리 화면이 전담한다. 이 카드의 버튼은 안내 문구만 띄우고
                실제로 아무 화면도 열지 못했다.

                시리얼 인증 입력란 제거 (사장님 지적 2026-08-09 — "설치시 진행하기에 사실상 필요 없음").
                시리얼 확인은 설치마법사가 맡는다. 다만 아래 기기 등록은 지우지 않고 그대로 둔다
                (헌법 #1) — 자세한 사정은 .razor.cs 의 기기 등록 주석 참고.
            *@
            <MudPaper Elevation="0" Class="pa-4 mb-3" Style="border:0.5px solid var(--mud-palette-lines-default);border-radius:12px">
                <MudText Typo="Typo.subtitle2" Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.DevicesOther" Size="Size.Small" /> <span>이 컴퓨터 등록</span>
                </MudText>

                @*
                    기기 등록 흐름 (사장님 결재 2026-06-08 - 네이버·넷플릭스 방식).
                    시리얼 입력이 이 화면에서 빠지면서 등록에 필요한 키를 여기서 얻을 수 없게 됐다.
                    그래서 "등록" 을 눌러도 실제 등록까지 가지 않고 지금 사정을 안내한다
                    (없는 기능을 된 것처럼 보이지 않게 하려는 것이다).
                    등록 자리가 정해지면 이 버튼이 그대로 다시 살아난다.
                *@
                @if (!_deviceRegistered && !_deviceDialogShown)
                {
                    <MudText Style="font-size:12px;color:var(--mud-palette-text-secondary)" Class="mb-2">
                        등록된 기기에서만 로그인할 수 있습니다. 구독하신 요금제의 사용 기기 수 안에서만 등록됩니다.
                    </MudText>
                    <div style="display:flex;gap:8px;">
                        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                   OnClick="RegisterDeviceAsync" Disabled="_deviceSubmitting"
                                   StartIcon="@Icons.Material.Filled.DevicesOther">
                            @(_deviceSubmitting ? "등록 중..." : "이 컴퓨터 등록")
                        </MudButton>
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   OnClick="@(() => _deviceDialogShown = true)">
                            나중에
                        </MudButton>
                    </div>
                }
                else if (_deviceRegistered)
                {
                    <MudPaper Elevation="0" Class="pa-2 mt-3" Style="background:#ECFDF5;border:1px solid #10B981;border-radius:8px;">
                        <MudText Typo="Typo.body2" Style="font-weight:600;color:#065F46;">
                            <MudIcon Icon="@Icons.Material.Filled.Verified" Color="Color.Success" Size="Size.Small" />
                            이 컴퓨터 등록 완료
                        </MudText>
                        <MudText Style="font-size:11px;color:#065F46;">
                            기기 확인 정보가 안전하게 저장되었습니다.
                        </MudText>
                        @if (_deviceCount > 0 && _deviceLimit > 0)
                        {
                            <MudText Style="font-size:11px;color:#065F46;">
                                등록 기기: @_deviceCount / @_deviceLimit 대
                            </MudText>
                        }
                    </MudPaper>
                }

                @if (!string.IsNullOrEmpty(_deviceMessage))
                {
                    <MudAlert Severity="@(_deviceSuccess ? Severity.Success : Severity.Warning)" Dense="true" Class="mt-2">
                        @_deviceMessage
                    </MudAlert>
                }
            </MudPaper>

            <MudPaper Elevation="0" Class="pa-4" Style="border:0.5px solid var(--mud-palette-lines-default);border-radius:12px">
                <MudText Typo="Typo.subtitle2" Class="mb-2">구독정보 (읽기 전용)</MudText>
                @*
                    종전에는 여기에 "Business / 7·10 / 오늘+1개월" 이 코드에 적힌 채로 떠서,
                    구독을 어떻게 하고 있든 모든 회사에 똑같은 거짓 정보가 보였다(사장님 지적 2026-08-09).
                    → 실제 구독 정보를 불러왔을 때만 숫자를 보여주고, 못 불러오면 없는 대로 알린다.
                *@
                @if (_subscription is not null)
                {
                    <MudGrid Spacing="1">
                        <MudItem xs="5"><MudText Style="font-size:12px;color:var(--mud-palette-text-secondary)">현재 요금제</MudText></MudItem>
                        <MudItem xs="7"><MudText Style="font-size:12px">@_subscription.PlanName</MudText></MudItem>
                        <MudItem xs="5"><MudText Style="font-size:12px;color:var(--mud-palette-text-secondary)">구독 만료일</MudText></MudItem>
                        <MudItem xs="7">
                            <MudText Style="font-size:12px">
                                @(_subscription.ExpiresAt.HasValue ? _subscription.ExpiresAt.Value.ToString("yyyy-MM-dd") : "-")
                            </MudText>
                        </MudItem>
                        <MudItem xs="5"><MudText Style="font-size:12px;color:var(--mud-palette-text-secondary)">사용 가능 인원</MudText></MudItem>
                        <MudItem xs="7"><MudText Style="font-size:12px">@_subscription.LicenseCount 명</MudText></MudItem>
                    </MudGrid>
                }
                else
                {
                    <MudText Style="font-size:12px;color:var(--mud-palette-text-secondary)">
                        구독정보를 확인할 수 없습니다. 아래 구독결제 관리에서 확인해주세요.
                    </MudText>
                }
                @* 사장님 결재 2026-04-29: 구독결제 관리 진입 버튼 *@
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Payment"
                           OnClick="@(() => Navigation.NavigateTo("/settings/subscription-billing"))"
                           Class="mt-3">
                    구독결제 관리
                </MudButton>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:20px">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyAsync" Disabled="_saving">@(_saving ? "적용 중..." : "적용")</MudButton>
        <MudButton Variant="Variant.Outlined" OnClick="Close">닫기</MudButton>
    </div>
}

@*
    파일 고르기 label. 안쪽 InputFile 을 label 로 감싸 두면 label 어디를 눌러도
    브라우저가 파일선택창을 연다(자바스크립트 불필요). 주변 버튼과 비슷하게 보이도록만 꾸민다.
*@
<style>
    .hitpan-file-pick {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 12px;
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 6px;
        cursor: pointer;
    }

    .hitpan-file-pick:hover {
        background: var(--mud-palette-action-default-hover);
    }

    .hitpan-file-pick > span {
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
    }

    .hitpan-file-pick input[type="file"] {
        min-width: 0;
        flex: 1 1 auto;
        font-size: 11px;
        cursor: pointer;
    }
</style>
