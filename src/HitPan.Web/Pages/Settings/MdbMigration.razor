        public int Rows { get; set; }
        public long ElapsedMs { get; set; }
        public string? ErrorMessage { get; set; }
        // 진범 #69 봉합 (2026-05-20, 사장님 결재 옵션 B'): UI staging 사기 차단.
        // 후보(BulkCopy staging) vs INSERT 적재 vs 중복 차단 3중 투명 표시 (hover 상세).
        // Rows = 후보(staging) — 카드 본문에 표시 (기존 호환).
        // InsertedRows = 실 INSERT 적재 (DB 실측 일치) — hover 툴팁에 표시.
        // SkippedRows = 중복 IGNORE — hover 툴팁에 표시.
        public int InsertedRows { get; set; }
        public int SkippedRows { get; set; }
        public TableCard(string key, string label) { Key = key; Label = label; }
    }

