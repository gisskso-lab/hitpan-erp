                            }
                            else
                            {
                                <MudTable Items="recon.PartnerDiffs" Dense="true" Hover="true" Elevation="0">
                                    <HeaderContent>
                                        <MudTh>거래처</MudTh>
                                        <MudTh Style="text-align:right">레거시</MudTh>
                                        <MudTh Style="text-align:right">히트판</MudTh>
                                        <MudTh Style="text-align:right">차이</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="거래처">@context.Name</MudTd>
