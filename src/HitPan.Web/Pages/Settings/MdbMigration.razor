    // 작22 (2026-09-09) A3: "skipped" 는 이어서 가져오기에서 **이미 끝난 표**다. 아래 넷이 이 상태를 모르면
    //   카드가 「대기」로 보여 아직 안 한 것처럼 읽힌다 — 완료와 같은 모양으로 두되 아이콘만 달리해 구분한다.
    private static string GetStatusIcon(string status) => status switch
    {
        "completed" => Icons.Material.Filled.CheckCircle,
