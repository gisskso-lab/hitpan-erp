                            {
                                <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary)">품목별 차이가 없습니다.</MudText>
                            }
                            else
                            {
                                <MudTable Items="recon.ItemDiffs" Dense="true" Hover="true" Elevation="0">
                                    <HeaderContent>
                                        <MudTh>품목 (품명|규격)</MudTh>
                                        <MudTh Style="text-align:right">레거시</MudTh>
                                        <MudTh Style="text-align:right">히트판</MudTh>
                                        <MudTh Style="text-align:right">차이</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="품목">@context.Name</MudTd>
                                        <MudTd DataLabel="레거시" Style="text-align:right">@FormatNumber(context.Legacy)</MudTd>
                                        <MudTd DataLabel="히트판" Style="text-align:right">@FormatNumber(context.Erp)</MudTd>
                                        <MudTd DataLabel="차이" Style="text-align:right;color:var(--mud-palette-error);font-weight:500">@FormatNumber(context.Diff)</MudTd>
                                    </RowTemplate>
                                </MudTable>
                            }
                        </MudExpansionPanel>
                    </MudExpansionPanels>

                    <MudText Typo="Typo.caption" Class="mt-2" Style="color:var(--mud-palette-text-secondary)">
                        @($"기준 시각 {recon.GeneratedAt:yyyy-MM-dd HH:mm:ss}")
                    </MudText>
                }
            }
            else
            {
                @* C2: 미리보기 성공 — 가져올 자료 요약 (레거시 열만 · 히트판 열은 "이관 전") *@
                <MudText Typo="Typo.subtitle2" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.ListAlt" Size="Size.Small" Class="mr-1" />
                    가져올 자료 요약
                </MudText>

                @if (_reconLoading)
                {
                    <div style="display:flex;align-items:center;gap:8px">
                        <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
                        <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary)">가져올 자료를 세는 중...</MudText>
                    </div>
                }
                else if (_reconError != null)
                {
                    <MudText Typo="Typo.body2" Color="Color.Error">가져올 자료 요약을 불러오지 못했습니다: @_reconError</MudText>
                }
                else if (_recon is { } recon)
                {
                    <MudTable Items="recon.Items" Dense="true" Hover="true" Elevation="0"
                              Style="border:0.5px solid var(--mud-palette-lines-default);border-radius:8px">
                        <HeaderContent>
                            <MudTh>구분</MudTh>
                            <MudTh>항목</MudTh>
                            <MudTh Style="text-align:right">레거시</MudTh>
                            <MudTh Style="text-align:right">히트판</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="구분">@context.Category</MudTd>
                            <MudTd DataLabel="항목">
                                <div>@context.Label</div>
                                @if (!string.IsNullOrEmpty(context.Detail))
                                {
                                    <div style="font-size:11px;color:var(--mud-palette-text-secondary)">@context.Detail</div>
                                }
                            </MudTd>
                            <MudTd DataLabel="레거시" Style="text-align:right">@FormatNumber(context.Legacy)</MudTd>
                            <MudTd DataLabel="히트판" Style="text-align:right;color:var(--mud-palette-text-secondary)">이관 전</MudTd>
                        </RowTemplate>
                    </MudTable>

                    <MudText Typo="Typo.caption" Class="mt-2" Style="color:var(--mud-palette-text-secondary)">
                        이관을 시작하면 히트판 열에 실제 가져온 숫자가 채워지고, 레거시와 맞는지 자동으로 확인합니다.
                    </MudText>
                }
            }
        </MudPaper>
    }
}

