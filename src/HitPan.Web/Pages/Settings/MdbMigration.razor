        _           => Icons.Material.Outlined.RadioButtonUnchecked,
    };

    private static Color GetStatusColor(string status) => status switch
    {
        "completed" => Color.Success,
        "skipped"   => Color.Success,
        "running"   => Color.Primary,
        "failed"    => Color.Error,
        _           => Color.Default,
    };

    private static string GetCardBorder(string status) => status switch
    {
        "completed" => "var(--mud-palette-success)",
        "skipped"   => "var(--mud-palette-success)",
        "running"   => "var(--mud-palette-primary)",
        "failed"    => "var(--mud-palette-error)",
        _           => "var(--mud-palette-lines-default)",
    };

    private static string GetCardBg(string status) => status switch
    {
        "completed" => "rgba(76,175,80,0.06)",
        "skipped"   => "rgba(76,175,80,0.06)",
        "running"   => "rgba(33,150,243,0.08)",
        "failed"    => "rgba(244,67,54,0.06)",
        _           => "transparent",
    };

    /* ── 작22 (2026-09-09) A3 · B2: 화면 진입 시 재접속 + 찾아보기 ── */

    /// <summary>1단계까지만 끝나 멈춰 있는 가져오기 작업(있으면). 「이어서 가져오기」 버튼이 이 값으로 뜬다.</summary>
    private string? _pausedJobId;

    /// <summary>
    /// 작22 (2026-09-09) A3 · 별지 §1-3: 화면에 들어오면 <b>서버에 물어 다시 붙는다.</b>
    /// 선행검증 §2-5 — 종전엔 진행 중이던 작업에 재접속하는 길이 0 이라, 새로고침 한 번이면 진행 화면이 사라졌다
    /// (작업은 서버에서 계속 돌고 있는데 사용자는 그것을 볼 방법이 없었다).
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        // 🔴 20260910작1 A1: 지우는 방식을 고를 수 있는 자리인지 먼저 묻는다.
        //   초기화·백업 화면(MainPcOnly.razor)이 쓰는 **같은 주소**다 — 규칙을 여기 다시 적지 않는다.
        try
        {
            var mainPc = await Http.GetFromJsonAsync<MainPcResult>("api/devices/is-main-pc");
            _isMainPc = mainPc?.IsMainPc ?? false;
        }
        catch (Exception ex)
        {
            // 못 물어봤으면 잠근 채로 둔다(헌법 #15 — 삼키지 않는다).
            Console.Error.WriteLine($"[MdbMigration] 자료보관 컴퓨터 여부 확인 실패: {ex.GetType().Name}: {ex.Message}");
            _isMainPc = false;
        }

        try
        {
            var resp = await Http.GetAsync("api/migration/legacy-mdb/current");
            if (!resp.IsSuccessStatusCode) { return; }

            var body = await resp.Content.ReadFromJsonAsync<CurrentJobResponse>();
            var job = body?.Job;
            if (job is null || string.IsNullOrEmpty(job.JobId)) { return; }

            // 그때 쓴 폴더 경로를 되살린다 — 이어서 가져오기·맞춰보기가 같은 자료를 봐야 한다.
            if (!string.IsNullOrWhiteSpace(job.SourceFolder)) { _folderPath = job.SourceFolder; }

            if (job.Status == "paused")
            {
                _pausedJobId = job.JobId;
                RestoreCards(body!.Tables);
                return;
            }

            if (job.Status == "running")
            {
                // 아직 도는 중 — 진행 화면을 다시 세우고 남은 과정을 이어서 지켜본다.
                RestoreCards(body!.Tables);
                _ = RunJobFlowAsync(job.JobId, freshStart: false);
            }
        }
        catch (Exception ex)
        {
            // 헌법 #15: 삼키지 않는다. 다만 이 조회가 실패해도 화면은 평소처럼 쓸 수 있어야 하므로 막지 않는다.
            Console.Error.WriteLine($"[MdbMigration] 진행 중 작업 조회 실패: {ex.Message}");
        }
    }

    /// <summary>서버에 적힌 표별 진행 상태로 카드를 되살린다(재접속·이어서 가져오기 화면).</summary>
    private void RestoreCards(List<CurrentTableRow>? tables)
    {
        if (tables is null) { return; }
        foreach (var t in tables)
        {
            var card = _tableCards.FirstOrDefault(c => c.Key == t.TableName);
            if (card is null) { continue; }
            card.Status = t.Status switch
            {
                "done" => "completed",
                "skipped" => "skipped",
                "running" => "running",
                "failed" => "failed",
                _ => "pending",
            };
            card.Rows = (int)Math.Clamp(t.Rows, 0, int.MaxValue);
            card.ErrorMessage = t.ErrorMessage;
        }
        _completedTables = _tableCards.Count(c => c.Status is "completed" or "failed" or "skipped");
    }

    /// <summary>
    /// 작22 (2026-09-09) B2: 「찾아보기」 — 서버가 만든 폴더 목록에서 고른다. 고르면 곧바로 미리보기까지 돌려
    /// "이 폴더가 맞나" 를 그 자리에서 보여준다(처음 쓰는 사람이 물어보지 않고 확인할 수 있게).
    /// </summary>
    private async Task OpenBrowseAsync()
    {
        var parameters = new DialogParameters
        {
            ["StartPath"] = string.IsNullOrWhiteSpace(_folderPath) ? null : _folderPath,
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<MdbFolderBrowseDialog>("폴더 찾아보기", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not string chosen || string.IsNullOrWhiteSpace(chosen))
        {
            return;
        }

        _folderPath = chosen;
        StateHasChanged();
        await PreviewAsync();
    }

    /* ── 미리보기 ── */
    private async Task PreviewAsync()
    {
        try
        {
            _loading = true;
            _statusMessage = "기존 데이터를 분석하는 중...";
            _migrationResult = null;
            _migrationRows.Clear();
            // 작21 (2026-09-04): 이전 맞춰보기·요약 잔재 제거.
            _recon = null;
            _reconError = null;
            StateHasChanged();

            // 핫픽스 2026-05-13: 비번 전달.
            // 작22 (2026-09-09) A4 · 병렬이슈 11: 주소줄(GET) → 본문(POST). 비번이 주소·서버 기록에 남지 않게 옮겼다.
            var previewResp = await Http.PostAsJsonAsync("api/migration/legacy-mdb/preview", BuildReadOnlyMdbRequest());
            if (!previewResp.IsSuccessStatusCode)
            {
                var err = await previewResp.Content.ReadAsStringAsync();
                if (err.Length > 200) { err = err.Substring(0, 200) + "…"; }
                Snackbar.Add($"미리보기 실패 ({(int)previewResp.StatusCode}): {err}", Severity.Error);
                _previewResult = null;
                return;
            }
            _previewResult = await previewResp.Content.ReadFromJsonAsync<Dictionary<string, int>>();

            if (_previewResult == null || _previewResult.Count == 0)
            {
                Snackbar.Add("기존 히트판 데이터를 찾을 수 없습니다.", Severity.Warning);
            }
            else
            {
                Snackbar.Add($"총 {_previewResult.Values.Sum():N0}건 발견", Severity.Success);

                // 작21 C2 (2026-09-04): 미리보기 성공 직후 「가져올 자료 요약」(레거시 열만).
                // 요약이 실패해도 미리보기 자체는 성공으로 둔다 — LoadReconAsync 는 예외를 밖으로 내지 않는다.
                _statusMessage = "가져올 자료를 세는 중...";
                await LoadReconAsync(afterMigration: false);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"미리보기 실패: {ex.Message}", Severity.Error);
            _previewResult = null;
        }
        finally
        {
            _loading = false;
            _statusMessage = "";
        }
    }

    /* ── SignalR HubConnection (정공법 CODE-01, 2026-05-14) ── */
    private HubConnection? _hub;
    private string? _currentJobId;
    private System.Threading.CancellationTokenSource? _elapsedCts;

    /* ── 가져오기 시작 — 정공법 CODE-01 (2026-05-14): SignalR push (폴링 폐기) ──
       작22 (2026-09-09) A3 · 5/16 사장님 UX: /start 는 **1단계(기초자료)만** 돌린다.
       끝나면 서버가 1단계 완료 신호를 보내고, 아래 흐름이 사장님 문안 그대로 물어본다. */
    private async Task StartMigrationAsync()
    {
        _pausedJobId = null;

        // 🔴 20260910작1 A1: 지우는 방식은 마지막으로 한 번 더 여쭙는다 (칸을 채웠다고 바로 지우지 않는다).
        if (_mode == "overwrite")
        {
            if (string.IsNullOrEmpty(_ownerPassword))
            {
                Snackbar.Add("대표 계정 비밀번호를 입력해 주세요.", Severity.Warning);
                return;
            }
            if (_overwriteConfirm?.Trim() != "덮어쓰기")
            {
                Snackbar.Add("확인을 위해 「덮어쓰기」 라고 입력해 주세요.", Severity.Warning);
                return;
            }

            var countText = _overwriteImpactTotal is int n && n > 0
                ? $" 히트판에서 직접 입력하신 거래 {n:N0}건이 없어집니다."
                : "";
            var ok = await DialogService.ShowMessageBoxAsync(
                "기존 자료를 모두 지우고 새로 가져옵니다",
                $"지우기 전에 자동으로 백업합니다.{countText} 계속하시겠습니까?",
                yesText: "지우고 가져오기", cancelText: "취소");
            if (ok != true) { return; }
        }

        // 🔴 [3-V] 2026-09-10 P0: **여기서부터 화면을 잠근다.**
        //   「없는 것만 보태기」는 이 호출이 1초 안에 돌아오지만, 「모두 지우고 새로 가져오기」는
        //   이 한 번의 호출 안에서 **전체 백업 + 전 자료 삭제 + 회사 기본자료 다시 깔기**를 끝내고 돌아온다.
        //   그동안 아무 표시가 없으면 사장님은 안 눌린 줄 알고 한 번 더 누르신다 —
        //   그러면 **첫 이관이 자료를 넣고 있는 중에 두 번째 지우기가 돈다.**
        _loading = true;
        _statusMessage = _mode == "overwrite"
            ? "기존 자료를 백업하고 정리하는 중입니다. 시간이 걸릴 수 있으니 이 화면을 닫지 마세요..."
            : "이관 시작 중...";
        StateHasChanged();

        string? jobId;
        try
        {
            var startResp = await Http.PostAsJsonAsync("api/migration/legacy-mdb/start", BuildMdbRequest());
            if (!startResp.IsSuccessStatusCode)
            {
                var err = await startResp.Content.ReadAsStringAsync();
                if (err.Length > 200) { err = err.Substring(0, 200) + "…"; }
                Snackbar.Add($"시작 실패 ({(int)startResp.StatusCode}): {err}", Severity.Error);
                _loading = false;
                return;
            }
            var startBody = await startResp.Content.ReadFromJsonAsync<StartResponse>();
            jobId = startBody?.JobId;
        }
        catch (Exception ex)
        {
            // 🔴 응답을 못 받았다고 서버가 멈춘 것이 아니다 — 지우기·가져오기는 계속 돌고 있을 수 있다.
            //   그러니 "다시 누르세요" 라고 하지 않는다. 화면을 새로 열어 상태를 다시 붙으라고 안내한다.
            Console.Error.WriteLine($"[MdbMigration.StartMigrationAsync] {ex.GetType().Name}: {ex.Message}");
            Snackbar.Add("응답을 받지 못했습니다. 작업은 계속 진행 중일 수 있으니, 이 화면을 다시 열어 진행 상태를 확인해 주세요. 다시 누르지 마세요.", Severity.Error);
            _loading = false;
            return;
        }

        if (string.IsNullOrEmpty(jobId))
        {
            Snackbar.Add("가져오기 작업 번호를 받지 못했습니다.", Severity.Error);
            _loading = false;
            return;
        }

        await RunJobFlowAsync(jobId, freshStart: true);
    }

    /// <summary>
    /// 작22 (2026-09-09) A3: 「이어서 가져오기」 — 1단계에서 멈춘 작업을 2단계(거래 자료)로 잇는다.
    /// 비번은 아무도 저장하지 않으므로 화면 비번 칸 값을 다시 보낸다.
    /// </summary>
    private async Task ContinueMigrationAsync()
    {
        var jobId = _pausedJobId;
        if (string.IsNullOrEmpty(jobId)) { return; }
        if (!await SendContinueAsync(jobId)) { return; }

        _pausedJobId = null;
        await RunJobFlowAsync(jobId, freshStart: false);
    }

    /// <summary>2단계 이어가기 요청. 실패하면 사유를 알리고 false — 작업은 멈춘 채로 남는다.</summary>
    private async Task<bool> SendContinueAsync(string jobId)
    {
        var resp = await Http.PostAsJsonAsync($"api/migration/legacy-mdb/{jobId}/continue", BuildReadOnlyMdbRequest());
        if (resp.IsSuccessStatusCode) { return true; }

        var err = await resp.Content.ReadAsStringAsync();
        if (err.Length > 200) { err = err.Substring(0, 200) + "…"; }
        Snackbar.Add($"이어서 가져오지 못했습니다 ({(int)resp.StatusCode}): {err}", Severity.Error);
        return false;
    }

    /// <summary>
    /// 서버로 보내는 요청 본문 — 폴더·비번·가져오기 방식.
    /// 작22 A2 · 🔴 20260910작1 A1: 방식은 <b>보태기</b>가 기본이고, 지우는 쪽은 사장님이 골라야 간다.
    /// 대표 비번·확인 문구는 <b>지우는 방식일 때만</b> 싣는다 — 보태기 요청에 비번을 실어 보내지 않는다.
    /// </summary>
    private object BuildMdbRequest() => new
    {
        folderPath = _folderPath,
        mdbPassword = string.IsNullOrEmpty(_mdbPassword) ? null : _mdbPassword,
        mode = _mode,
        password = _mode == "overwrite" && !string.IsNullOrEmpty(_ownerPassword) ? _ownerPassword : null,
        confirmText = _mode == "overwrite" ? _overwriteConfirm : null,
    };

    /// <summary>
    /// 🔴 [3-V] 2026-09-10: 읽기만 하는 호출(미리보기·맞춰보기·이어서 가져오기)에 쓰는 요청.
    /// <para>
    /// 이 셋은 <b>아무것도 지우지 않는다</b>. 그런데 위 요청을 그대로 쓰면 지우는 방식을 골라 둔 동안
    /// <b>대표 계정 비밀번호가 이 세 곳에도 실려 나간다</b> — 필요 없는 곳에 비밀번호를 보내지 않는다.
    /// 방식도 <c>merge</c> 로 고정한다: 「이어서 가져오기」는 이미 들어온 자료를 잇는 것이라 지우면 안 된다.
    /// </para>
    /// </summary>
    private object BuildReadOnlyMdbRequest() => new
    {
        folderPath = _folderPath,
        mdbPassword = string.IsNullOrEmpty(_mdbPassword) ? null : _mdbPassword,
        mode = "merge",
    };

    /// <summary>
    /// 🔴 20260910작1 A1 §3-5 — 지우는 방식을 고르는 순간 <b>무엇이 없어지는지 숫자로</b> 보여준다.
    /// 세지 못해도 방식 선택을 막지는 않는다(경고문만 건수 없이 뜬다).
    /// </summary>
    private async Task OnModeChangedAsync(string mode)
    {
        _mode = mode;
        if (mode != "overwrite")
        {
            _ownerPassword = "";
            _overwriteConfirm = "";
            _overwriteImpactTotal = null;
            _overwriteImpactDetail = "";
            return;
        }

        try
        {
            var impact = await Http.GetFromJsonAsync<OverwriteImpact>("api/migration/legacy-mdb/overwrite-impact");
            _overwriteImpactTotal = impact?.Total;
            _overwriteImpactDetail = impact?.Details is { Count: > 0 } d
                ? string.Join(" · ", d.Select(x => $"{x.Label} {x.Cnt:N0}건"))
                : "";
        }
        catch (Exception ex)
        {
            // 헌법 #15 — 삼키지 않는다. 다만 이 실패가 사장님 작업을 막지는 않는다.
            Console.Error.WriteLine($"[MdbMigration.OnModeChangedAsync] {ex.GetType().Name}: {ex.Message}");
            _overwriteImpactTotal = null;
            _overwriteImpactDetail = "";
        }
    }

    /// <summary>덮어쓰기로 없어질 「사람이 직접 입력한 거래」 건수.</summary>
    private sealed class OverwriteImpact
    {
        public int? Total { get; set; }
        public List<OverwriteImpactDetail> Details { get; set; } = new();
    }

    private sealed class OverwriteImpactDetail
    {
        public string Label { get; set; } = "";
        public int Cnt { get; set; }
    }

    /// <summary>자료보관 컴퓨터 여부 응답 — <c>MainPcOnly.razor</c> 와 같은 모양.</summary>
    private sealed class MainPcResult
    {
        public bool IsMainPc { get; set; }
    }

    /// <summary>
    /// 작22 (2026-09-09) A3: 진행 화면 + 서버 신호 대기 — 처음 시작·이어서 가져오기·화면 재접속이 <b>같은 코드</b>를 탄다.
    /// </summary>
    private async Task RunJobFlowAsync(string jobId, bool freshStart)
    {
        try
        {
            _loading = true;
            _statusMessage = freshStart ? "이관 시작 중..." : "진행 상태를 다시 불러오는 중..."; // 작21 C4: 화면 문구 개발용어 0
            if (freshStart)
            {
                // P0 #6 (2026-05-14): 카드 초기화 (이전 잡 상태 잔재 제거).
                _tableCards = BuildInitialCards();
                _completedTables = 0;
                _elapsedSeconds = 0;
            }
            StateHasChanged();

            _currentJobId = jobId;

            // 2) SignalR Hub 연결 — 폴링 폐기, 서버 push로 즉시 갱신.
            var tokenResult = await Storage.GetAsync<string>(AuthStorageKeys.AccessToken);
            var token = tokenResult.Success ? tokenResult.Value : null;
            // BaseAddress 절대 URL — Http.BaseAddress는 Program.cs에서 apiUri 끝 슬래시 포함.
            var hubUrl = new Uri(Http.BaseAddress!, "hubs/migration").ToString();

            _hub = new HubConnectionBuilder()
                .WithUrl(hubUrl, options =>
                {
                    options.AccessTokenProvider = () => Task.FromResult<string?>(token);
                })
                .WithAutomaticReconnect()
                .Build();

            // 테이블별 진행률 수신.
            _hub.On<ProgressPayload>("ProgressUpdate", payload =>
            {
                var card = _tableCards.FirstOrDefault(c => c.Key == payload.TableName);
                if (card is not null)
                {
                    card.Status = payload.Status;
                    card.Rows = payload.Rows;
                    card.ElapsedMs = payload.ElapsedMs;
                    card.ErrorMessage = payload.ErrorMessage;
                }
                // 작22 (2026-09-09) A3: 이어서 가져오기에서 이미 끝난 표는 "skipped" 로 온다 — 완료와 같이 센다(안 그러면 진행률이 영영 안 찬다).
                _completedTables = _tableCards.Count(c => c.Status is "completed" or "failed" or "skipped");
                _statusMessage = payload.Status == "running"
                    ? $"진행 중: {payload.TableName}"
                    : $"{payload.TableName} {payload.Status}";
                InvokeAsync(StateHasChanged);
            });

            // 작22 (2026-09-09) A3: 1단계 완료 신호 — 잡이 끝난 게 아니라 **멈춘** 것이다. 아래 대기 흐름이 사람에게 묻는다.
            _phaseSignal = new TaskCompletionSource<int>();
            _hub.On<PhaseCompletedPayload>("PhaseCompleted", phasePayload =>
            {
                _phaseSignal?.TrySetResult(phasePayload.Phase);
            });

            // 잡 종료 수신 — 최종 result는 별도 GET 1회로 가져옴 (Hub payload 크기 최소화).
            var completionTcs = new TaskCompletionSource<JobStatus?>();
            _hub.On<JobCompletedPayload>("JobCompleted", async payload =>
            {
                try
                {
                    if (payload.Status == "completed")
                    {
                        // 진범 #22 봉합 (2026-05-18): 장시간 마이그 도중 JWT 만료 → status GET 401.
                        // 1차 시도 → 401이면 RefreshAsync 후 재시도 1회.
                        var statusResp = await Http.GetAsync($"api/migration/legacy-mdb/status/{jobId}");
                        if (statusResp.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                        {
                            var refreshed = await Auth.RefreshAsync();
                            if (refreshed)
                            {
                                statusResp = await Http.GetAsync($"api/migration/legacy-mdb/status/{jobId}");
                            }
                        }
                        if (statusResp.IsSuccessStatusCode)
                        {
                            var status = await statusResp.Content.ReadFromJsonAsync<JobStatus>();
                            completionTcs.TrySetResult(status);
                            return;
                        }
                    }
                    completionTcs.TrySetResult(new JobStatus { JobId = jobId, Status = payload.Status, ErrorMessage = payload.ErrorMessage });
                }
                catch (Exception ex)
                {
                    completionTcs.TrySetException(ex);
                }
            });

            await _hub.StartAsync();
            await _hub.InvokeAsync("SubscribeJob", jobId);

            // 경과 초 카운터 (UI용, 1초 tick).
            _elapsedCts = new System.Threading.CancellationTokenSource();
            _ = TickElapsedAsync(_elapsedCts.Token);

            // 잡 종료 대기 (최대 60분 — Hub disconnect 대비 안전망).
            // 작22 (2026-09-09) A3: 종료보다 **1단계 완료 신호**가 먼저 올 수 있다. 그때는 5/16 사장님 문안 그대로 묻고,
            //   [예] 면 같은 연결에서 2단계를 이어 본다. [아니오] 면 멈춘 채로 남기고 나중에 「이어서 가져오기」로 잇는다.
            var timeout = Task.Delay(TimeSpan.FromMinutes(60));
            var phaseTask = _phaseSignal!.Task;
            while (true)
            {
                var finished = await Task.WhenAny(completionTcs.Task, phaseTask, timeout);
                if (finished == timeout)
                {
                    // 작22 (2026-09-09) A3: 60분은 **화면이 기다리는 한도**일 뿐 작업은 서버에서 계속 돈다.
                    //   이제 화면을 다시 열면 진행 중인 작업에 다시 붙으므로(재접속) 그렇게 안내한다.
                    Snackbar.Add("가져오기가 60분을 넘겨 화면 대기를 멈춥니다. 작업은 계속 진행 중일 수 있으니 잠시 뒤 이 화면을 다시 열어 확인해 주세요.", Severity.Warning);
                    return;
                }
                if (finished == completionTcs.Task) { break; }

                _statusMessage = "1단계(기초자료) 이관 완료";
                StateHasChanged();

                // 사장님 문안 그대로 (5/16 결재안 §5) — 한 글자도 바꾸지 않는다.
                var go = await DialogService.ShowMessageBoxAsync(
                    "1단계 이관 완료",
                    "1단계자료 이관완료. 2단계 자료 이관 계속 하시겠습니까?",
                    yesText: "예", cancelText: "아니오");

                // 이미 받은 신호가 다시 잡히지 않게 자리를 새로 만든다(2단계는 종료 신호로 끝난다).
                _phaseSignal = new TaskCompletionSource<int>();
                phaseTask = _phaseSignal.Task;

                if (go == true && await SendContinueAsync(jobId))
                {
                    _statusMessage = "2단계 자료를 가져오는 중...";
                    StateHasChanged();
                    continue;
                }

                // [아니오] 또는 이어가기 실패 — 작업은 살아 있고 언제든 이어받을 수 있다(헌법 #20: 흐름을 끊지 않는다).
                _pausedJobId = jobId;
                Snackbar.Add("1단계 자료까지 가져왔습니다. 거래 자료는 [이어서 가져오기]로 계속할 수 있습니다.", Severity.Success);
                return;
            }

            var finalStatus = await completionTcs.Task;
            if (finalStatus is null)
            {
                Snackbar.Add("이관 결과를 받지 못했습니다.", Severity.Warning);
                return;
            }

            if (finalStatus.Status == "completed" && finalStatus.Result is not null)
            {
                _migrationResult = new MigrationResult
                {
                    Partners = finalStatus.Result.Partners, Items = finalStatus.Result.Items, BomHeaders = finalStatus.Result.BomHeaders,
                    Employees = finalStatus.Result.Employees, PurchaseOrders = finalStatus.Result.PurchaseOrders, SalesOrders = finalStatus.Result.SalesOrders,
                    StockLedger = finalStatus.Result.StockLedger, Collections = finalStatus.Result.Collections, Cashbook = finalStatus.Result.Cashbook,
                    Payments = finalStatus.Result.Payments, // 작21: 지급 잡 신설 (갈래 A9)
                    DailyReports = finalStatus.Result.DailyReports, // 작22 D: 일일보고서(레거시 메모) 잡 신설
                    Expenses = finalStatus.Result.Expenses, PurchaseOrdersFromIU = finalStatus.Result.PurchaseOrdersFromIU,
                    SalesOrdersFromIO = finalStatus.Result.SalesOrdersFromIO, TaxInvoices = finalStatus.Result.TaxInvoices,
                    Bills = finalStatus.Result.Bills, CardPayments = finalStatus.Result.CardPayments, BankTransactions = finalStatus.Result.BankTransactions
                };
                _migrationRows = new List<MigrationRow>
                {
                    new("업체(거래처)", _migrationResult.Partners),
                    new("상품(품목)", _migrationResult.Items),
                    new("BOM(자재명세서)", _migrationResult.BomHeaders),
                    new("사원", _migrationResult.Employees),
                    new("거래명세 매입(K2)", _migrationResult.PurchaseOrders),
                    new("거래명세 매출(K2)", _migrationResult.SalesOrders),
                    new("매입발주(IU)", _migrationResult.PurchaseOrdersFromIU),
                    new("매출주문(IO)", _migrationResult.SalesOrdersFromIO),
                    new("세금계산서(TX)", _migrationResult.TaxInvoices),
                    new("재고원장(입출고)", _migrationResult.StockLedger),
                    new("수금", _migrationResult.Collections),
                    new("지급", _migrationResult.Payments), // 작21
                    new("경비(현금출납)", _migrationResult.Cashbook),
                    new("전표(비용처리)", _migrationResult.Expenses),
                    new("어음(EU+EQ)", _migrationResult.Bills),
                    new("카드결제(CD)", _migrationResult.CardPayments),
                    new("은행거래(BANKF)", _migrationResult.BankTransactions),
                    new("일일보고서(레거시 메모)", _migrationResult.DailyReports), // 작22 D
                };
                var total = _migrationRows.Sum(r => r.Count);
                Snackbar.Add($"이관 완료! 총 {total:N0}건 (경과 {_elapsedSeconds}초)", Severity.Success);
            }
            else if (finalStatus.Status == "failed")
            {
                Snackbar.Add($"이관 실패: {finalStatus.ErrorMessage}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"이관 오류: {ex.Message}", Severity.Error);
        }
        finally
        {
            _elapsedCts?.Cancel();
            _elapsedCts?.Dispose();
            _elapsedCts = null;
            if (_hub is not null)
            {
                try { await _hub.DisposeAsync(); }
                catch (Exception ex)
                {
                    // 헌법 #15 빈 catch 금지 — dispose 실패는 사용자에게 무영향, 디버그 로그만.
                    Console.Error.WriteLine($"[MdbMigration] Hub dispose 실패: {ex.Message}");
                }
                _hub = null;
            }
            _loading = false;
            _statusMessage = "";
            // 작22 (2026-09-09) A3: 화면 진입 시 재접속은 버튼이 아니라 코드가 부른다 — 그 경로는 자동 갱신이 없어
            //   여기서 직접 그려 주지 않으면 진행 헤더가 내려가지 않고 「이어서 가져오기」 버튼도 안 나타난다.
            await InvokeAsync(StateHasChanged);
        }

        // 작21 C1 (2026-09-04): 이관 완료(_migrationResult 세팅) 직후 레거시와 숫자 맞춰보기.
        // 진행 헤더(_loading)를 내린 뒤에 부른다 — 이관 자체는 이미 끝났고, 맞춰보기 카드가 자체 진행 표시를 가진다.
        // 위 try 안의 return 경로(시작 실패·타임아웃·결과 없음)는 여기 오지 않는다.
        if (_migrationResult is not null)
        {
            await LoadReconAsync(afterMigration: true);
        }
    }

    /* ── 작21 (2026-09-04): 레거시와 숫자 맞춰보기 — 갈래 B API `GET legacy-mdb/reconcile` ── */
    private ReconReport? _recon;
    private string? _reconError;
    private bool _reconLoading;

    /// <summary>
    /// 작22 (2026-09-09) A4 · 병렬이슈 11: 대사 호출도 주소줄(GET) → 본문(POST). 비번이 주소에 실리지 않는다.
    /// </summary>
    private Task<HttpResponseMessage> PostReconAsync()
        => Http.PostAsJsonAsync("api/migration/legacy-mdb/reconcile", BuildReadOnlyMdbRequest());

    /// <summary>
    /// 작21 C1·C2: 레거시 MDB 숫자와 히트판 숫자를 받아 _recon 에 담는다.
    /// 실패는 Snackbar 경고 + 카드 사유 한 줄(_reconError)로 알리고 예외를 밖으로 내지 않는다 —
    /// 미리보기·이관 자체의 성공 상태를 지키기 위해(헌법 #15 빈 catch 금지 · 사유는 반드시 남긴다).
    /// </summary>
    private async Task LoadReconAsync(bool afterMigration)
    {
        var what = afterMigration ? "레거시와 숫자 맞춰보기" : "가져올 자료 요약";
        _recon = null;
        _reconError = null;
        _reconLoading = true;
        StateHasChanged();
        try
        {
            // 진범 #22 와 같은 자리: 장시간 이관 뒤 JWT 만료 → 401 이면 RefreshAsync 후 1회 재시도.
            var resp = await PostReconAsync();
            if (resp.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                var refreshed = await Auth.RefreshAsync();
                if (refreshed)
                {
                    resp = await PostReconAsync();
                }
            }
            if (!resp.IsSuccessStatusCode)
            {
                var err = await resp.Content.ReadAsStringAsync();
                if (err.Length > 200) { err = err.Substring(0, 200) + "…"; }
                _reconError = $"({(int)resp.StatusCode}) {err}";
                Snackbar.Add($"{what} 실패 ({(int)resp.StatusCode})", Severity.Warning);
                return;
            }
            var report = await resp.Content.ReadFromJsonAsync<ReconReport>();
            if (report is null)
            {
                _reconError = "응답이 비어 있습니다.";
                Snackbar.Add($"{what} 실패: 응답이 비어 있습니다.", Severity.Warning);
                return;
            }
            _recon = report;
        }
        catch (Exception ex)
        {
            _reconError = ex.Message;
            Snackbar.Add($"{what} 실패: {ex.Message}", Severity.Warning);
        }
        finally
        {
            _reconLoading = false;
            StateHasChanged();
        }
    }

    /// <summary>「다시 맞춰보기」 버튼 — 같은 API 재호출.</summary>
    private Task ReloadReconAsync() => LoadReconAsync(afterMigration: true);

    /// <summary>숫자 표시 — 정수면 N0, 소수가 있으면 N2, 없으면 "—".</summary>
    private static string FormatNumber(decimal? value)
    {
        if (value is null) { return "—"; }
        var v = value.Value;
        return v == decimal.Truncate(v) ? v.ToString("N0") : v.ToString("N2");
    }

