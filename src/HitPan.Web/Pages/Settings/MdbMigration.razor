@page "/settings/mdb-migration"
@namespace HitPan.Web.Pages.SettingsUi
@attribute [Authorize]
@using Microsoft.AspNetCore.SignalR.Client
@using HitPan.Web.Models
@using HitPan.Web.Providers
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject HitPanProtectedLocalStorage Storage
@inject HitPan.Web.Services.IAuthService Auth
@implements IAsyncDisposable

<PageTitle>데이터 이관</PageTitle>

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
    <MudText Typo="Typo.h6">기존 히트판 데이터 이관</MudText>
    <MudText Style="font-size:12px;color:var(--mud-palette-text-secondary)">
        기존 히트판의 데이터를 새 히트판으로 간편하게 가져옵니다
    </MudText>
</div>

@* 경고 알림 *@
<MudAlert Severity="Severity.Warning" Class="mb-4" Dense="true" Icon="@Icons.Material.Filled.Warning">
    이관 전 반드시 기존 데이터를 백업하세요. 중복 데이터가 생길 수 있습니다.
</MudAlert>

@* MDB 폴더 경로 입력 + 버튼 *@
<MudPaper Elevation="0" Class="pa-4 mb-4" Style="border:0.5px solid var(--mud-palette-lines-default);border-radius:12px">
    <MudText Typo="Typo.subtitle2" Class="mb-3">기존 히트판 설치 폴더</MudText>
    <MudGrid Spacing="2">
        <MudItem xs="12" md="4">
            <MudTextField T="string" Label="MDB 폴더 경로" @bind-Value="_folderPath"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Placeholder="예: C:\HITWIN"
                          HelperText="경로를 붙여넣거나 [찾아보기]로 고르세요 (보통 C:\HITWIN)" />
        </MudItem>
        <MudItem xs="12" md="2">
            @* 작22 (2026-09-09) B2: 9/4 사장님 오더 7 — 경로를 직접 찾을 수 있게. *@
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.FolderOpen"
                       OnClick="OpenBrowseAsync"
                       Disabled="@(_loading || _reconLoading)"
                       Style="height:40px;margin-top:4px;width:100%">
                찾아보기
            </MudButton>
        </MudItem>
        <MudItem xs="12" md="2">
            @* 핫픽스 2026-05-13: 레거시 MDB 비번 입력 칸 (예: 7618968) *@
            <MudTextField T="string" Label="MDB 비밀번호" @bind-Value="_mdbPassword"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          InputType="InputType.Password"
                          HelperText="MDB에 비번이 걸려있으면 입력 (없으면 비워두세요)" />
        </MudItem>
        <MudItem xs="12" md="2">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Search"
                       OnClick="PreviewAsync"
                       Disabled="@(_loading || _reconLoading || string.IsNullOrWhiteSpace(_folderPath))"
                       Style="height:40px;margin-top:4px;width:100%">
                미리보기
            </MudButton>
        </MudItem>
        <MudItem xs="12" md="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.PlayArrow"
                       OnClick="StartMigrationAsync"
                       Disabled="@(_loading || _reconLoading || _previewResult == null)"
                       Style="height:40px;margin-top:4px;width:100%">
                이관 시작
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@* 🔴 20260910작1 A1 — 가져오기 방식 (사장님 결재 2026-09-10 "넣어").
   9/4 사장님 오더 6: "마이그레이션 옵션이 두개가 되어야 함. 1덮어쓰기, 2병합".
   화면 문구에 개발용어 0 — "병합"·"덮어쓰기"·"초기화" 대신 하는 일을 그대로 적는다. *@
@if (!_loading)
{
<MudPaper Elevation="0" Class="pa-4 mb-4" Style="border:0.5px solid var(--mud-palette-lines-default);border-radius:12px">
    <MudText Typo="Typo.subtitle2" Class="mb-3">가져오는 방식</MudText>
    <MudRadioGroup T="string" Value="@_mode" ValueChanged="OnModeChangedAsync">
        <MudRadio T="string" Value="@("merge")" Color="Color.Primary" Dense="true">
            기존 자료는 두고 <b>없는 것만 보태기</b>
            <MudText Typo="Typo.caption" Class="d-block mud-text-secondary">
                히트판에 이미 있는 자료는 그대로 두고, 예전 히트판에만 있는 자료를 채웁니다. 여러 번 해도 안전합니다.
            </MudText>
        </MudRadio>
        <MudRadio T="string" Value="@("overwrite")" Color="Color.Error" Dense="true" Disabled="@(!_isMainPc)">
            기존 자료를 <b>모두 지우고 새로 가져오기</b>
            <MudText Typo="Typo.caption" Class="d-block mud-text-secondary">
                @if (_isMainPc)
                {
                    <text>히트판의 업무 자료를 모두 지운 뒤 예전 히트판을 처음부터 다시 읽습니다. 지우기 전에 자동으로 백업합니다.</text>
                }
                else
                {
                    @* 서버도 같은 규칙으로 막는다 — 화면을 잠그는 것만으로는 막은 게 아니다(2026-08-11 사장님 지시). *@
                    <text>이 방식은 <b>회사 자료가 들어 있는 컴퓨터</b>에서만 고를 수 있습니다. 히트판이 설치된 그 컴퓨터에서 열어 주세요.</text>
                }
            </MudText>
        </MudRadio>
    </MudRadioGroup>

    @if (_mode == "overwrite")
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3 mb-3">
            <b>히트판에서 직접 입력하신 자료는 되돌아오지 않습니다.</b>
            @if (_overwriteImpactTotal is int n && n > 0)
            {
                <span> 지금 지워지는 거래가 <b>@n.ToString("N0")건</b> 있습니다@(string.IsNullOrEmpty(_overwriteImpactDetail) ? "" : $" ({_overwriteImpactDetail})").</span>
            }
            else if (_overwriteImpactTotal == 0)
            {
                <span> 명세서·매입·수금·지급·계산서·경비·현금출납·은행거래에는 직접 입력하신 것이 없습니다.</span>
            }
            @* 🔴 [3-V] 2026-09-10: 이 숫자가 전부라고 말하지 않는다 — 견적·수주·발주·반품은
               가져온 것과 직접 친 것을 가릴 수 없어 세지 못한다. "없다"고 말하는 것이 안 세는 것보다 나쁘다. *@
            <span> 견적·수주·발주·반품 등 나머지 업무 자료도 함께 지워집니다.</span>
            <span> 로그인 정보와 회사 정보는 그대로 남습니다.</span>
        </MudAlert>
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6">
                <MudTextField T="string" Label="대표 계정 비밀번호" @bind-Value="_ownerPassword"
                              Variant="Variant.Outlined" Margin="Margin.Dense" InputType="InputType.Password"
                              HelperText="본인 확인을 위해 로그인 비밀번호를 한 번 더 입력하세요" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField T="string" Label="확인 문구" @bind-Value="_overwriteConfirm"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              HelperText="확인을 위해 「덮어쓰기」 라고 입력하세요" />
            </MudItem>
        </MudGrid>
    }
</MudPaper>
}

@* 작22 (2026-09-09) A3 · 5/16 사장님 UX: 1단계만 끝나 멈춰 있는 가져오기가 있으면 여기서 이어받는다.
   화면에 다시 들어와도(새로고침·다음 날) 이 자리에 남아 있다 — 진행 상태는 서버에 적혀 있다. *@
@if (_pausedJobId is not null && !_loading)
{
    <MudAlert Severity="Severity.Info" Class="mb-4" Dense="true">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap">
            <span>1단계(마스터) 이관이 끝났습니다. 히트판을 바로 쓰실 수 있고, 거래 자료는 이어서 가져올 수 있습니다.</span>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.PlayArrow"
                       OnClick="ContinueMigrationAsync">
                이어서 가져오기
            </MudButton>
        </div>
    </MudAlert>
}

@* P0 #6 (2026-05-14): Sticky 헤더 — 마이그 진행 중 항상 상단 고정 가시화 *@
@if (_loading)
{
    <div style="position:sticky;top:0;z-index:50;background:var(--mud-palette-background);padding:12px 0;border-bottom:1px solid var(--mud-palette-lines-default);margin-bottom:16px">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
            <MudText Typo="Typo.subtitle2">
                <MudIcon Icon="@Icons.Material.Filled.Sync" Size="Size.Small" Class="mr-1" Style="animation:spin 2s linear infinite" />
                @* 작21 C4 (2026-09-04): 화면 문구 개발용어 0 — "마이그레이션" → "이관" *@
                이관 진행 중
            </MudText>
            <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary)">
                @_completedTables / @_totalTables 완료 · 경과 @(_elapsedSeconds)초
            </MudText>
        </div>
        <MudProgressLinear Color="Color.Primary" Value="@_progressPercent" Class="mb-2" Style="height:8px" />
        <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)">
            @_statusMessage
        </MudText>
        @if (_cancelRequested)
        {
            <MudText Typo="Typo.caption" Color="Color.Warning" Class="mt-1">
                중단 요청됨 — 안전 종료까지 잠시 기다려 주세요.
            </MudText>
        }
    </div>

    @* 테이블별 카드 그리드 — 17개 테이블 진행 상태 (작21: 지급 카드 추가로 16→17) *@
    <MudGrid Spacing="2" Class="mb-4">
        @foreach (var t in _tableCards)
        {
            <MudItem xs="6" sm="4" md="3" lg="2">
                <MudPaper Elevation="0" Class="pa-2"
                          Style="@($"border:1px solid {GetCardBorder(t.Status)};border-radius:8px;background:{GetCardBg(t.Status)};min-height:78px")">
                    <div style="display:flex;align-items:center;gap:4px;margin-bottom:4px">
                        <MudIcon Icon="@GetStatusIcon(t.Status)" Size="Size.Small" Color="@GetStatusColor(t.Status)" />
                        <MudText Typo="Typo.body2" Style="font-weight:500;font-size:12px">@t.Label</MudText>
                    </div>
                    <MudText Typo="Typo.body2" Style="font-size:11px;color:var(--mud-palette-text-secondary)">
                        @if (t.Status == "completed")
                        {
                            @* 진범 #69 봉합 (2026-05-20, 옵션 B'): hover 시 INSERT/중복 상세 표시. *@
                            <MudTooltip Arrow="true" Placement="Placement.Top">
                                <ChildContent>
                                    @($"{t.Rows:N0}행 · {t.ElapsedMs / 1000.0:F1}s")
                                    @if (t.SkippedRows > 0)
                                    {
                                        <span style="color:var(--mud-palette-warning);font-weight:500">&nbsp;⚠</span>
                                    }
                                </ChildContent>
                                <TooltipContent>
                                    <div style="text-align:left">
                                        <div>후보 (staging) : @t.Rows.ToString("N0")행</div>
                                        <div>INSERT 적재 : @((t.InsertedRows > 0 ? t.InsertedRows : t.Rows).ToString("N0"))행</div>
                                        @if (t.SkippedRows > 0)
                                        {
                                            <div style="color:#ffb74d">중복 차단 : @t.SkippedRows.ToString("N0")건</div>
                                        }
                                    </div>
                                </TooltipContent>
                            </MudTooltip>
                        }
                        else if (t.Status == "running")
                        {
                            <span>진행 중...</span>
                        }
                        else if (t.Status == "skipped")
                        {
                            @* 작22 (2026-09-09) A3: 이어서 가져올 때 이미 끝난 표는 다시 돌리지 않는다 — 빠뜨린 게 아니라 이미 들어와 있다. *@
                            <span>@($"이미 가져옴 · {t.Rows:N0}행")</span>
                        }
                        else if (t.Status == "failed")
                        {
                            <span style="color:var(--mud-palette-error)">@(t.ErrorMessage ?? "실패")</span>
                        }
                        else
                        {
                            <span>대기</span>
                        }
                    </MudText>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    <style>
        @@keyframes spin { from { transform:rotate(0deg) } to { transform:rotate(360deg) } }
    </style>
}

@* 미리보기 / 결과 2단 레이아웃 *@
@if (_previewResult != null || _migrationResult != null)
{
    <MudGrid Spacing="3">
        @* 좌측: 원본(MDB) 테이블 현황 *@
        <MudItem xs="12" md="6">
            <MudPaper Elevation="0" Class="pa-4" Style="border:0.5px solid var(--mud-palette-lines-default);border-radius:12px">
                <MudText Typo="Typo.subtitle2" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.Storage" Size="Size.Small" Class="mr-1" />
                    기존 히트판 데이터
                </MudText>

                @if (_previewResult != null)
                {
                    <MudTable Items="_previewResult" Dense="true" Hover="true" Elevation="0"
                              Style="border:0.5px solid var(--mud-palette-lines-default);border-radius:8px">
                        <HeaderContent>
                            <MudTh>테이블명</MudTh>
                            <MudTh Style="text-align:right">레코드 수</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="테이블명">@context.Key</MudTd>
                            <MudTd DataLabel="레코드 수" Style="text-align:right">
                                @context.Value.ToString("N0")
                            </MudTd>
                        </RowTemplate>
                    </MudTable>

                    <MudText Typo="Typo.body2" Class="mt-2" Style="color:var(--mud-palette-text-secondary)">
                        총 @_previewResult.Values.Sum().ToString("N0") 건
                    </MudText>
                }
            </MudPaper>
        </MudItem>

        @* 우측: 마이그레이션 결과 (새 히트판) *@
        <MudItem xs="12" md="6">
            <MudPaper Elevation="0" Class="pa-4" Style="border:0.5px solid var(--mud-palette-lines-default);border-radius:12px">
                <MudText Typo="Typo.subtitle2" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Small" Class="mr-1" />
                    이관 결과 (새 히트판)
                </MudText>

                @if (_migrationResult != null)
                {
                    <MudTable Items="_migrationRows" Dense="true" Hover="true" Elevation="0"
                              Style="border:0.5px solid var(--mud-palette-lines-default);border-radius:8px">
                        <HeaderContent>
                            <MudTh>대상 테이블</MudTh>
                            <MudTh Style="text-align:right">가져온 건수</MudTh>
                            <MudTh Style="text-align:center;width:48px">상태</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="대상 테이블">@context.Name</MudTd>
                            <MudTd DataLabel="가져온 건수" Style="text-align:right">
                                @context.Count.ToString("N0")
                            </MudTd>
                            <MudTd DataLabel="상태" Style="text-align:center">
                                @if (context.Count > 0)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Remove" Color="Color.Default" Size="Size.Small" />
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>

                    <MudText Typo="Typo.body2" Class="mt-2" Style="color:var(--mud-palette-text-secondary)">
                        총 @_migrationRows.Sum(r => r.Count).ToString("N0") 건 가져옴
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary)">
                        미리보기 확인 후 "이관 시작" 버튼을 눌러주세요.
                    </MudText>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>

    @* 작21 (2026-09-04): 결과 카드 아래 전폭 — 이관 완료 후 「레거시와 숫자 맞춰보기」 / 미리보기 후 「가져올 자료 요약」 *@
    @if (_migrationResult != null || _reconLoading || _recon != null || _reconError != null)
    {
        <MudPaper Elevation="0" Class="pa-4 mt-4" Style="border:0.5px solid var(--mud-palette-lines-default);border-radius:12px">
            @if (_migrationResult != null)
            {
                @* C1: 이관 완료 — 레거시 ↔ 히트판 숫자 맞춰보기 *@
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
                    <MudText Typo="Typo.subtitle2">
                        <MudIcon Icon="@Icons.Material.Filled.FactCheck" Size="Size.Small" Class="mr-1" />
                        레거시와 숫자 맞춰보기
                    </MudText>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="ReloadReconAsync"
                               Disabled="@(_reconLoading || _loading)">
                        다시 맞춰보기
                    </MudButton>
                </div>

                @if (_reconLoading)
                {
                    <div style="display:flex;align-items:center;gap:8px">
                        <MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" />
                        <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary)">레거시 숫자를 읽어 맞춰보는 중...</MudText>
                    </div>
                }
                else if (_reconError != null)
                {
                    <MudText Typo="Typo.body2" Color="Color.Error">숫자를 맞춰보지 못했습니다: @_reconError</MudText>
                }
                else if (_recon is { } recon)
                {
                    @if (recon.DiffCount == 0)
                    {
                        <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">
                            @($"{recon.OkCount}/{recon.Items.Count} 항목 일치")
                        </MudAlert>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                            @($"차이 {recon.DiffCount}건 — 아래 목록을 확인하세요 ({recon.OkCount}/{recon.Items.Count} 항목 일치)")
                        </MudAlert>
                    }

                    <MudTable Items="recon.Items" Dense="true" Hover="true" Elevation="0"
                              Style="border:0.5px solid var(--mud-palette-lines-default);border-radius:8px">
                        <HeaderContent>
                            <MudTh>구분</MudTh>
                            <MudTh>항목</MudTh>
                            <MudTh Style="text-align:right">레거시</MudTh>
                            <MudTh Style="text-align:right">히트판</MudTh>
                            <MudTh Style="text-align:right">차이</MudTh>
                            <MudTh Style="text-align:center;width:72px">판정</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="구분">@context.Category</MudTd>
                            <MudTd DataLabel="항목">
                                <div>@context.Label</div>
                                @if (!string.IsNullOrEmpty(context.Detail))
                                {
                                    <div style="font-size:11px;color:var(--mud-palette-text-secondary)">@context.Detail</div>
                                }
                            </MudTd>
                            <MudTd DataLabel="레거시" Style="text-align:right">@FormatNumber(context.Legacy)</MudTd>
