@page "/users/permissions"
@namespace HitPan.Web.Pages.SettingsUi
@* 권한 관리 = 대표·시스템 관리자만 (헌법 #7·#11 정합) *@
@attribute [Authorize(Roles = "system_admin,tenant_admin,TenantAdmin")]
@using HitPan.Web.Models
@using HitPan.Web.Services
@using HitPan.Web.Components.Common
@inject PermissionService PermSvc
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>권한설정</PageTitle>

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
    <div>
        <MudText Typo="Typo.h6">권한설정</MudText>
        <MudText Style="font-size:12px;color:var(--mud-palette-text-secondary)">
            직원에게 메뉴별 권한 부여 · 계정은 [직원 계정 관리] 메뉴
        </MudText>
    </div>
    @* 흐름 손잡이 (사장님 오더 2026-08-10, 20260810작4):
       직원계정 → 계정생성 → 권한설정(여기) → **사원관리** → HR직원현황.
       종전에는 권한을 다 주고 나서 다음에 뭘 하는지 화면에 아무 안내가 없었다. *@
    <div class="d-flex gap-2">
        <MudButton Variant="Variant.Text" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   Href="/users">직원 계정 관리</MudButton>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                   EndIcon="@Icons.Material.Filled.ArrowForward"
                   Href="/employees">다음: 사원 정보</MudButton>
    </div>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_loadFailed)
{
    @* 🔴 못 불러온 것 — "직원 0명" 과 다른 사실이다.
       종전에는 여기서 빈 직원목록 + "좌측에서 직원을 선택하세요" 로 교착돼,
       선택할 것이 없는데 선택하라고만 하는 화면이 됐다. *@
    <LoadFailedState Title="권한 정보를 불러오지 못했습니다"
                     Subtitle="직원이나 권한이 삭제된 것이 아닙니다. 연결이 회복되면 다시 보입니다."
                     Retrying="@_loading"
                     OnRetry="LoadAsync" />
}
else if (_users.Count == 0)
{
    @* 빈 상태 — 진짜로 직원이 0명일 때만 온다 *@
    <MudPaper Elevation="0" Class="pa-8" Style="border:0.5px dashed var(--mud-palette-lines-default);border-radius:12px;text-align:center">
        <MudIcon Icon="@Icons.Material.Outlined.Lock" Size="Size.Large" Style="color:var(--mud-palette-text-secondary);font-size:64px" />
        <MudText Typo="Typo.h6" Class="mt-3">권한을 부여할 직원이 없습니다</MudText>
        <MudText Typo="Typo.body2" Class="mb-3" Style="color:var(--mud-palette-text-secondary)">
            직원계정을 먼저 만들면 여기에서 메뉴별 권한을 줄 수 있습니다.
        </MudText>
        @* 글자로만 "거기서 하세요" 하면 고객은 그 메뉴를 찾아 헤맨다 — 버튼으로 바로 보낸다 (20260810작4) *@
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.PersonAdd"
                   Href="/users">직원계정 만들러 가기</MudButton>
    </MudPaper>
}
else
{
    <MudGrid Spacing="3">
        <!-- 좌측: 직원 목록 -->
        <MudItem xs="12" md="4">
            <MudPaper Elevation="0" Class="pa-3" Style="border:0.5px solid var(--mud-palette-lines-default);border-radius:12px">
                <MudText Typo="Typo.subtitle2" Class="mb-2">직원 목록</MudText>
                <MudList T="string" Dense="true" @bind-SelectedValue="_selectedUserId">
                    @foreach (var user in _users)
                    {
                        <MudListItem T="string"
                                     Value="@user.UserId"
                                     OnClick="@(() => SelectEmployee(user.UserId))"
                                     Style="@(user.UserId == _selectedUserId ? "background:var(--mud-palette-primary-lighten);font-weight:500" : "")">
                            <div style="display:flex;align-items:center;gap:8px">
                                <!-- 이니셜 아바타 -->
                                <div style="width:32px;height:32px;border-radius:50%;background:#E6F1FB;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:500;color:#185FA5">
                                    @GetInitial(user.EmpName, user.UserName)
                                </div>
                                <div>
                                    <div style="font-size:13px;font-weight:500">@(user.EmpName ?? user.UserName)</div>
                                    <div style="font-size:11px;color:var(--mud-palette-text-secondary)">@GetRoleLabel(user.Role)</div>
                                </div>
                            </div>
                        </MudListItem>
                    }
                </MudList>
            </MudPaper>
        </MudItem>

        <!-- 우측: 선택된 직원의 권한 체크박스 -->
        <MudItem xs="12" md="8">
            @if (_selectedUser is not null)
            {
                <MudPaper Elevation="0" Class="pa-3" Style="border:0.5px solid var(--mud-palette-lines-default);border-radius:12px">
                    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
                        <MudText Typo="Typo.subtitle2">@(_selectedUser.EmpName ?? _selectedUser.UserName) 권한</MudText>
                        <div style="display:flex;gap:8px">
                            <!-- 전체허용 버튼 -->
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => ToggleAll(true))">전체허용</MudButton>
                            <!-- 전체해제 버튼 -->
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => ToggleAll(false))">전체해제</MudButton>
                            <!-- 저장 버튼 -->
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">저장</MudButton>
                        </div>
                    </div>
                    <MudPaper Elevation="0" Style="border:0.5px solid var(--mud-palette-lines-default);border-radius:8px;overflow:hidden">
                        <table style="width:100%;border-collapse:collapse;font-size:12px">
                            <thead>
                                <tr style="background:var(--mud-palette-background-grey)">
                                    <th style="padding:8px 12px;text-align:left;font-weight:500;width:140px">메뉴</th>
                                    <th style="padding:8px;text-align:center;width:60px">조회</th>
                                    <th style="padding:8px;text-align:center;width:60px">등록</th>
                                    <th style="padding:8px;text-align:center;width:60px">수정</th>
                                    <th style="padding:8px;text-align:center;width:60px">삭제</th>
                                    <th style="padding:8px;text-align:center;width:60px">출력</th>
                                </tr>
                            </thead>
                            <tbody>
                                @* ⬛ @foreach (var perm in _selectedUser.Permissions) — 20261005작5 §5-4: 「직원 계정 관리」 세 코드는 아래 한 줄로 *@
                                @foreach (var perm in _selectedUser.Permissions.Where(p => !IsUsersLevelCode(p.MenuCode)))
                                {
                                    <tr style="border-bottom:0.5px solid var(--mud-palette-lines-default)">
                                        <td style="padding:6px 12px;font-weight:500">@perm.MenuName</td>
                                        <td style="text-align:center;padding:6px"><MudCheckBox T="bool" @bind-Value="perm.CanView" Color="Color.Primary" Dense="true" /></td>
                                        <td style="text-align:center;padding:6px"><MudCheckBox T="bool" @bind-Value="perm.CanCreate" Color="Color.Primary" Dense="true" /></td>
                                        <td style="text-align:center;padding:6px"><MudCheckBox T="bool" @bind-Value="perm.CanUpdate" Color="Color.Primary" Dense="true" /></td>
                                        <td style="text-align:center;padding:6px"><MudCheckBox T="bool" @bind-Value="perm.CanDelete" Color="Color.Primary" Dense="true" /></td>
                                        <td style="text-align:center;padding:6px"><MudCheckBox T="bool" @bind-Value="perm.CanExport" Color="Color.Primary" Dense="true" /></td>
                                    </tr>
                                }
                                @* 20261005작5 §5-1·§5-4 — 「직원 계정 관리」 한 줄 4선택(없음·조회·계정설정·구독계정추가).
                                   위 단계는 아래 단계를 품는다. 저장 때 USERS·USERS_ACCOUNT·USERS_SEAT 세 줄을 늘 함께 보낸다(V5-05).
                                   템플릿이 아니다 — 대표님이 사람마다 직접 고른다(#11). *@
                                <tr style="border-bottom:0.5px solid var(--mud-palette-lines-default)">
                                    <td style="padding:6px 12px;font-weight:500">직원 계정 관리</td>
                                    <td colspan="5" style="padding:6px">
                                        <MudSelect T="int" Value="UsersLevelOf(_selectedUser)" ValueChanged="@(v => SetUsersLevel(_selectedUser, v))"
                                                   Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:360px">
                                            <MudSelectItem T="int" Value="0">없음</MudSelectItem>
                                            <MudSelectItem T="int" Value="1">1 조회 — 직원 계정 목록 보기</MudSelectItem>
                                            <MudSelectItem T="int" Value="2">2 계정설정 — 사원에게 계정 만들기 · 사용 안 함 · 다시 사용</MudSelectItem>
                                            <MudSelectItem T="int" Value="3">3 구독계정추가 — 계정 추가 구독까지</MudSelectItem>
                                        </MudSelect>
                                        @* 작5 §8-8 사장님 P2-14 결재 — 2단계(계정설정)부터는 계정을 만들 때 임시 비밀번호를 이 직원이 정한다.
                                           3단계는 2단계를 품으므로 같은 경고. 첫 로그인 비밀번호 변경 강제는 별건 트랙. *@
                                        @if (UsersLevelOf(_selectedUser) >= 2)
                                        {
                                            <MudText Typo="Typo.caption" Class="mt-1" Style="color:var(--mud-palette-warning-darken);display:flex;align-items:center;gap:4px">
                                                <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Size="Size.Small" Color="Color.Warning" />
                                                이 직원은 다른 직원의 비밀번호를 정할 수 있습니다
                                            </MudText>
                                        }
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </MudPaper>
                </MudPaper>
            }
            else
            {
                <MudPaper Elevation="0" Class="pa-4" Style="border:0.5px solid var(--mud-palette-lines-default);border-radius:12px;text-align:center">
                    <MudText Style="color:var(--mud-palette-text-secondary)">좌측에서 직원을 선택하세요</MudText>
                </MudPaper>
            }
        </MudItem>
    </MudGrid>
}
