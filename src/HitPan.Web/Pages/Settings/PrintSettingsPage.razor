    /// <summary>
    /// 그림을 서버로 보낸다 — 🔴 <b>성공한 뒤에만</b> 등록되었다고 말한다.
    /// </summary>
    /// <remarks>
    /// 🔴 서버가 거절하면 그 까닭을 <b>그대로</b> 보여 준다(상한 초과·그림 아님·열 수 없음).
    ///   「실패했습니다」만 띄우면 고객은 무엇을 고쳐야 할지 모른다.
    /// </remarks>
    private async Task UploadImageAsync(string kind, IBrowserFile? file)
    {
        if (file is null) return;

        // 🔴🔴 [2026-10-26 [3-V] P1-3 봉합] **상한을 먼저 본다.**
        //   종전에는 아래 `OpenReadStream(상한)` 이 터지면서 Blazor 의 **영어 IOException**
        //   (*"Supplied file with size … exceeds the maximum of …"*) 이 catch 로 떨어져
        //   고객 화면에 그대로 떴다. 서버가 준비해 둔 참말(「2MB 이하로 올려 주십시오」)은
        //   왕복을 안 하므로 **영영 안 보였다.** 고객은 같은 파일을 다시 올린다.
        if (file.Size > CompanyImageLimits.MaxBytes)
        {
            Snackbar.Add(
                $"그림이 너무 큽니다. {CompanyImageLimits.MaxBytesLabel} 이하로 올려 주십시오.",
                Severity.Warning);
            return;
        }

        var busy = kind == "seal";
        if (busy) _sealBusy = true; else _logoBusy = true;
        try
        {
            using var content = new MultipartFormDataContent();
            // 🔴 상한을 화면에서도 한 번 본다 — 큰 파일을 올렸다가 서버에서 거절당하는
            //   왕복을 줄인다. 🔴 그래도 **서버가 다시 본다**(화면 검사는 편의일 뿐이다).
            var stream = file.OpenReadStream(CompanyImageLimits.MaxBytes);
            var fileContent = new StreamContent(stream);
            content.Add(fileContent, "file", file.Name);
            content.Add(new StringContent(kind), "kind");

            var resp = await Http.PostAsync("api/settings/company-image", content);
            if (resp.IsSuccessStatusCode)
            {
                await LoadCompanyImagesAsync();
                if (kind == "seal") _sealFile = null; else _logoFile = null;
                Snackbar.Add(kind == "seal" ? "직인이 등록되었습니다." : "로고가 등록되었습니다.",
                    Severity.Success);
            }
            else
            {
                var why = await ReadMessageAsync(resp);
                Snackbar.Add(why, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            // 🔴 [P1-3] 예외 원문을 **고객에게 보여 주지 않는다** — 로그로만 남긴다(#23 계열).
            Console.Error.WriteLine($"[PrintSettings] 그림 올리기 실패({kind}): {ex.Message}");
            Snackbar.Add("그림을 올리지 못했습니다. 잠시 뒤 다시 시도해 주십시오.", Severity.Error);
        }
        finally
        {
            if (busy) _sealBusy = false; else _logoBusy = false;
        }
    }

    /// <summary>그림을 지운다 — 🔴 <b>파일과 칸을 같이</b> 비운다.</summary>
    private async Task DeleteImageAsync(string kind, string? storedPath)
    {
        if (string.IsNullOrWhiteSpace(storedPath)) return;

        var busy = kind == "seal";
        if (busy) _sealBusy = true; else _logoBusy = true;
        try
        {
            var req = new HttpRequestMessage(HttpMethod.Delete, "api/settings/company-image")
            {
                Content = JsonContent.Create(new { StoredPath = storedPath, Kind = kind })
            };
            var resp = await Http.SendAsync(req);
            if (resp.IsSuccessStatusCode)
            {
                await LoadCompanyImagesAsync();
                Snackbar.Add(kind == "seal" ? "직인을 지웠습니다." : "로고를 지웠습니다.", Severity.Success);
            }
            else
            {
                Snackbar.Add(await ReadMessageAsync(resp), Severity.Error);
            }
        }
        catch (Exception ex)
        {
            // 🔴 [P1-3] 예외 원문을 고객 화면에 쏟지 않는다 — 로그로만 남긴다.
            Console.Error.WriteLine($"[PrintSettings] 그림 지우기 실패({kind}): {ex.Message}");
            Snackbar.Add("그림을 지우지 못했습니다. 잠시 뒤 다시 시도해 주십시오.", Severity.Error);
        }
        finally
        {
            if (busy) _sealBusy = false; else _logoBusy = false;
        }
    }

    /// <summary>서버가 돌려준 까닭을 사람 말로 꺼낸다.</summary>
    private static async Task<string> ReadMessageAsync(HttpResponseMessage resp)
    {
        try
        {
            var body = await resp.Content.ReadAsStringAsync();
            if (string.IsNullOrWhiteSpace(body)) return "그림을 처리하지 못했습니다.";
            using var doc = System.Text.Json.JsonDocument.Parse(body);
            if (doc.RootElement.TryGetProperty("message", out var m))
            {
                var text = m.GetString();
                if (!string.IsNullOrWhiteSpace(text)) return text!;
            }
            return "그림을 처리하지 못했습니다.";
        }
        catch (Exception ex)
        {
            // 🔴 까닭을 못 읽어도 고객에게는 사람 말로 돌려준다(#15).
            Console.Error.WriteLine($"[PrintSettings] 응답을 읽지 못했다: {ex.Message}");
            return "그림을 처리하지 못했습니다.";
        }
    }

    /// <summary>
