    // ── 🔴 [§D-2] 로고 워터마크 공통 설정 (DB-148 · 결-I) ──

    private PrintCommonModel _common = new();
    private bool _commonBusy;

    /// <summary>
    /// 인쇄 공통 설정을 읽는다 — 🔴 행이 없으면 서버가 <b>제안값</b>을 돌려준다.
    /// </summary>
    private async Task LoadPrintCommonAsync()
    {
        try
        {
            var dto = await Http.GetFromJsonAsync<PrintCommonModel>("api/settings/print-common");
            if (dto is not null) _common = dto;
        }
        catch (Exception ex)
        {
            // 🔴 빈 catch 금지(#15). 못 읽어도 화면은 제안값으로 열린다.
            Console.Error.WriteLine($"[PrintSettings] 공통 설정을 못 읽었다: {ex.Message}");
            Snackbar.Add("워터마크 설정을 불러오지 못했습니다. 화면을 다시 열어 주십시오.", Severity.Warning);
        }
    }

    /// <summary>
    /// 공통 설정을 저장한다 — 🔴 <b>성공한 뒤에만</b> 저장되었다고 말한다.
    /// </summary>
    /// <remarks>
    /// 🔴 이 화면의 다른 묶음(여백·하단 문구)은 아직 저장되지 않는다. 그래서 **같이 묶지 않고**
    ///   이 묶음만의 저장 단추를 둔다 — 하나를 눌러 둘 다 저장된 것처럼 보이면 거짓이 된다.
    /// </remarks>
    private async Task SavePrintCommonAsync()
    {
        _commonBusy = true;
        try
        {
            var resp = await Http.PutAsJsonAsync("api/settings/print-common", _common);
            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add("워터마크 설정을 저장했습니다.", Severity.Success);
            }
            else
            {
                Snackbar.Add(await ReadMessageAsync(resp), Severity.Error);
            }
        }
        catch (Exception ex)
        {
            // 🔴🔴 [2026-10-26 재검증 V-5 봉합] 이 줄도 **고객 화면에 .NET 예외 원문**을 쏟았다.
            //   같은 차수에서 위 두 자리(올리기·지우기)만 고치고 **이 자리를 놓쳤다** —
            //   이 줄을 넣은 것도 이 차수였다. 「세 자리 중 두 자리」는 봉합이 아니다.
            Console.Error.WriteLine($"[PrintSettings] 공통 설정 저장 실패: {ex.Message}");
            Snackbar.Add("워터마크 설정을 저장하지 못했습니다. 잠시 뒤 다시 시도해 주십시오.", Severity.Error);
        }
        finally
        {
            _commonBusy = false;
        }
    }

    /// <summary>
    /// 공통 설정 그릇 — ⚠️ 서버 DTO(<c>PrintCommonSettingsDto</c>)와 <b>이름이 같아야</b>
    /// JSON 이 매핑된다. 다르면 값이 조용히 기본값으로 떨어진다.
    /// </summary>
    private sealed class PrintCommonModel
    {
        public bool WatermarkEnabled { get; set; }
        public decimal WatermarkOpacity { get; set; } = WatermarkDefaults.Opacity;
        public decimal WatermarkSaturate { get; set; } = WatermarkDefaults.Saturate;
        public int WatermarkScalePct { get; set; } = WatermarkDefaults.ScalePct;

        // 🔴 [2026-10-26 [3-V] P1-4 봉합] `PrintBackgroundDefault` 를 **뺐다.**
        //   화면이 이 칸을 묶지 않은 채 보내고 있었고, 서버는 저장마다 0 으로 덮었다(#1).
        //   서버 DTO 에서도 같이 빠졌다 — 쓰는 차수에 화면·서버를 함께 배선한다.
    }

