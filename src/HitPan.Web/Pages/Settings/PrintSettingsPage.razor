@page "/print-settings"
@namespace HitPan.Web.Pages.SettingsUi
@* 🔴 2026-08-11 (사장님 지시): 설정관리는 **부모계정(대표)만**.
     메뉴에서 감추는 것만으로는 주소를 직접 치면 그대로 들어온다 — 화면에서도 막는다. *@
@attribute [Authorize(Roles = "system_admin,tenant_admin,TenantAdmin")]
@using System.Net.Http.Json
@using HitPan.Contracts.Forms
@inject ISnackbar Snackbar
@inject HttpClient Http

<PageTitle>양식(인쇄)정보 설정</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-4">
    <MudText Typo="Typo.h5" Class="mb-4">양식(인쇄)정보 설정</MudText>

    @* ── 회사 직인 업로드 영역 ── *@
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.subtitle1" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.Approval" Size="Size.Small" Class="mr-1" />
            회사 직인
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
            직인 이미지 업로드 (현재: @(_sealFileName ?? "미등록"))
        </MudText>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudFileUpload T="IBrowserFile" Accept=".png,.jpg,.jpeg,.gif"
                           FilesChanged="OnSealFileChanged">
                <ActivatorContent>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.UploadFile">
                        파일 선택
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
            @* 🔴 [20261026작1 §B-4] 올리는 중에는 다시 못 누르게 한다 —
                 두 번 누르면 같은 그림이 두 장 쌓이고 칸은 뒤에 끝난 쪽을 가리킨다. *@
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.CloudUpload"
                       Disabled="@(_sealFile is null || _sealBusy)"
                       OnClick="UploadSeal">@(_sealBusy ? "올리는 중…" : "업로드")</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Delete"
                       Disabled="@(string.IsNullOrWhiteSpace(_sealPath) || _sealBusy)"
                       OnClick="DeleteSeal">삭제</MudButton>
        </MudStack>
    </MudPaper>

    @* ── 회사 로고 업로드 영역 ── *@
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.subtitle1" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Small" Class="mr-1" />
            회사 로고
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
            로고 이미지 업로드 (현재: @(_logoFileName ?? "미등록"))
        </MudText>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudFileUpload T="IBrowserFile" Accept=".png,.jpg,.jpeg,.gif"
                           FilesChanged="OnLogoFileChanged">
                <ActivatorContent>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.UploadFile">
                        파일 선택
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.CloudUpload"
                       Disabled="@(_logoFile is null || _logoBusy)"
                       OnClick="UploadLogo">@(_logoBusy ? "올리는 중…" : "업로드")</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Delete"
                       Disabled="@(string.IsNullOrWhiteSpace(_logoPath) || _logoBusy)"
                       OnClick="DeleteLogo">삭제</MudButton>
        </MudStack>
    </MudPaper>

    @* ══════════════════════════════════════════════════════════════════
       🔴 [20261026작1 §D-2] 로고 워터마크 공통 설정 (DB-148 · 결-I)
         사장님 결재 2026-10-25: "공통 + 양식마다 — 단 고객 선택 옵션"
         ⇒ 여기 값이 **모든 양식의 기본**이고, 양식마다 따로 정할 수도 있다.
       🔴 수치는 **제안값**이다 — 개발팀이 정한 값이 아니다. 고객이 바꾼다.
       ══════════════════════════════════════════════════════════════════ *@
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.subtitle1" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.Opacity" Size="Size.Small" Class="mr-1" />
            로고 워터마크 (모든 양식 공통)
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
            졸업증명서처럼 회사 로고를 종이 가운데에 연하게 깔아 인쇄합니다.
            양식마다 따로 끄거나 숫자를 바꿀 수 있습니다.
        </MudText>

        @if (string.IsNullOrWhiteSpace(_logoPath))
        {
            @* 🔴 로고가 없으면 워터마크는 켜도 아무 일이 안 일어난다 —
                 「켰는데 안 보인다」를 겪게 하지 않고 **미리 말해 준다.** *@
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                위 「회사 로고」를 먼저 올려 주셔야 종이에 나옵니다.
            </MudAlert>
        }

        <MudCheckBox T="bool" @bind-Value="_common.WatermarkEnabled"
                     Label="로고 워터마크 쓰기" Dense="true" />

        @if (_common.WatermarkEnabled)
        {
            <MudGrid Class="mt-1">
                <MudItem xs="12" md="4">
                    <MudNumericField T="decimal" @bind-Value="_common.WatermarkOpacity"
                                     Label="진하기" Margin="Margin.Dense"
                                     Min="0" Max="1" Step="0.01M" />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        0 에 가까울수록 연합니다. 글씨가 읽히는 자리는 0.12 쯤입니다.
                    </MudText>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudNumericField T="decimal" @bind-Value="_common.WatermarkSaturate"
                                     Label="색감" Margin="Margin.Dense"
                                     Min="0" Max="1" Step="0.01M" />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        0 이면 흑백에 가깝습니다. 본문과 덜 다투게 0.15 쯤을 권합니다.
                    </MudText>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudNumericField T="int" @bind-Value="_common.WatermarkScalePct"
                                     Label="크기 (종이 너비의 %)" Margin="Margin.Dense"
                                     Min="10" Max="100" />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        60 이면 종이 너비의 절반을 조금 넘는 크기입니다.
                    </MudText>
                </MudItem>
            </MudGrid>
        }

        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
            🔴 세금계산서는 법으로 모양이 정해져 있어 워터마크를 넣지 않습니다.
        </MudText>

        <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       Disabled="_commonBusy"
                       OnClick="SavePrintCommonAsync">
                @(_commonBusy ? "저장 중…" : "워터마크 설정 저장")
            </MudButton>
        </MudStack>
        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">
            설정한 모양은 양식정보설정의 각 양식에서 「미리보기」로 바로 확인하실 수 있습니다.
        </MudText>
    </MudPaper>

    @* ── 문서별 설정 테이블 ── *@
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.subtitle1" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Class="mr-1" />
            문서별 설정
        </MudText>
        <MudSimpleTable Dense="true" Hover="true" Bordered="true" Style="overflow-x:auto">
            <thead>
                <tr>
                    <th style="min-width:120px">문서 종류</th>
                    <th style="min-width:250px">하단 문구</th>
                    <th style="min-width:100px;text-align:center">비고 표시</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var doc in _documentSettings)
                {
                    <tr>
                        <td>@doc.DocumentType</td>
                        <td>
                            <MudTextField T="string" @bind-Value="doc.FooterText"
                                          Variant="Variant.Outlined" Margin="Margin.Dense"
                                          Style="min-width:200px" />
                        </td>
                        <td style="text-align:center">
                            <MudSwitch T="bool" @bind-Value="doc.ShowRemarks"
                                       Color="Color.Primary" />
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </MudPaper>

    @* ── 기본 설정 (용지, 여백, 빈 행) ── *@
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.subtitle1" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Small" Class="mr-1" />
            기본 설정
        </MudText>

        @* 용지 — A4 고정 *@
        <MudGrid Class="mb-2">
            <MudItem xs="12" sm="3">
                <MudTextField T="string" Label="용지" Value="@("A4")" ReadOnly="true"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
        </MudGrid>

        @* 여백 설정 (mm) *@
        <MudText Typo="Typo.body2" Class="mb-2">여백 (mm)</MudText>
        <MudGrid Class="mb-3">
            <MudItem xs="6" sm="3">
                <MudNumericField T="int" Label="상" @bind-Value="_marginTop"
                                 Variant="Variant.Outlined" Margin="Margin.Dense"
                                 Min="0" Max="50" />
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudNumericField T="int" Label="하" @bind-Value="_marginBottom"
                                 Variant="Variant.Outlined" Margin="Margin.Dense"
                                 Min="0" Max="50" />
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudNumericField T="int" Label="좌" @bind-Value="_marginLeft"
                                 Variant="Variant.Outlined" Margin="Margin.Dense"
                                 Min="0" Max="50" />
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudNumericField T="int" Label="우" @bind-Value="_marginRight"
                                 Variant="Variant.Outlined" Margin="Margin.Dense"
                                 Min="0" Max="50" />
            </MudItem>
        </MudGrid>

        @* 빈 행 표시 토글 *@
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.body2">빈 행 표시 (품목 아래 빈 행 표시 여부)</MudText>
            <MudSwitch T="bool" @bind-Value="_showEmptyRows" Color="Color.Primary" />
        </MudStack>
    </MudPaper>

    @* ── 저장 버튼 ── *@
    <MudStack Row="true" Justify="Justify.FlexEnd">
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="SaveSettings"
                   Size="Size.Large">저장</MudButton>
    </MudStack>
</MudContainer>

@code {
    // ── 직인/로고 파일 상태 ──
    private IBrowserFile? _sealFile;
    private string? _sealFileName;
    private IBrowserFile? _logoFile;
    private string? _logoFileName;

    // ── 문서별 설정 모델 ──
    private List<DocumentPrintSetting> _documentSettings = new();

    // ── 여백 기본값 (mm) ──
    private int _marginTop = 15;
    private int _marginBottom = 15;
    private int _marginLeft = 15;
    private int _marginRight = 15;

    // ── 빈 행 표시 여부 ──
    private bool _showEmptyRows = true;

    /// <summary>
    /// 초기화 시 문서별 기본 하단 문구를 세팅한다.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        // 🔴 [20261026작1 §B-4] 지금 등록된 직인·로고를 먼저 읽는다 —
        //   그러지 않으면 올려 둔 고객에게도 「미등록」으로 보인다.
        await LoadCompanyImagesAsync();
        // 🔴 [§D-2] 인쇄 공통 설정도 같이 읽는다 — 제안값이 칸에 들어가 있어야
        //   고객이 무엇을 적어야 할지 안다(히트판 정신 — 쉬움으로 이겼다).
        await LoadPrintCommonAsync();

        _documentSettings = new List<DocumentPrintSetting>
        {
            new() { DocumentType = "견적서",    FooterText = "위 금액을 견적합니다",    ShowRemarks = true },
            new() { DocumentType = "거래명세서", FooterText = "위 금액을 청구합니다",    ShowRemarks = true },
            new() { DocumentType = "세금계산서", FooterText = "이 금액을 청구함",       ShowRemarks = true },
            new() { DocumentType = "수주서",    FooterText = "위 금액을 수주합니다",    ShowRemarks = true },
            new() { DocumentType = "발주서",    FooterText = "위 금액을 발주합니다",    ShowRemarks = true },
            new() { DocumentType = "매입명세서", FooterText = "위 금액을 입고합니다",    ShowRemarks = true },
        };
    }

    // ══════════════════════════════════════════════════════════════════
    // 🔴🔴 [20261026작1 §B-4] 직인·로고를 **실제로 올린다** (결-H)
    //
    // 🔴 종전에는 단추를 누르면 **파일 이름만 화면에 적고** 끝났다:
    //      "직인 이미지 'x.png'가 선택되었습니다. (서버 업로드는 Phase 2)"
    //    「삭제」도 화면 변수만 비웠다 — 서버에는 처음부터 아무것도 없었으니
    //    「삭제되었습니다」는 **빈 말**이었다.
    // 🔴 사장님 지시 2026-08-11: *"거짓문구는 모두 삭제"* — 그 지시가 이 자리에도 적용된다.
    //    이제 서버로 보내고, **회사 정보 칸까지 적힌 뒤에** 등록되었다고 말한다.
    // 🔴 그리고 **로고는 워터마크의 재료**다 — 이 통로가 없으면 워터마크는
    //    켜도 아무 일이 안 일어나는 칸이 된다(사장님 오더 10/25 ④).
    // ══════════════════════════════════════════════════════════════════

    private bool _sealBusy;
    private bool _logoBusy;
    private string? _sealPath;
    private string? _logoPath;

    /// <summary>
    /// 지금 등록돼 있는 직인·로고를 읽어 온다 — 🔴 <b>화면이 사실을 말하게</b> 한다.
    /// </summary>
    /// <remarks>
    /// 🔴 이것이 없으면 화면을 다시 열 때마다 「미등록」으로 보인다. 올려 둔 고객이
    ///   또 올리고, 「삭제」를 눌러도 아무 일이 안 일어난다.
    /// </remarks>
    private async Task LoadCompanyImagesAsync()
    {
        try
        {
            var company = await Http.GetFromJsonAsync<CompanyImageState>("api/settings/company");
            _sealPath = company?.SealUrl;
            _logoPath = company?.LogoUrl;
            _sealFileName = string.IsNullOrWhiteSpace(_sealPath) ? null : System.IO.Path.GetFileName(_sealPath);
            _logoFileName = string.IsNullOrWhiteSpace(_logoPath) ? null : System.IO.Path.GetFileName(_logoPath);
        }
        catch (Exception ex)
        {
            // 🔴 빈 catch 금지(#15). 못 읽어도 화면은 열린다 — 다만 사실을 모른다고 말한다.
            Console.Error.WriteLine($"[PrintSettings] 회사 그림 상태를 못 읽었다: {ex.Message}");
            Snackbar.Add("지금 등록된 직인·로고를 불러오지 못했습니다. 화면을 다시 열어 주십시오.", Severity.Warning);
        }
    }

    /// <summary>회사 정보에서 그림 경로만 받아 보는 그릇.</summary>
    private sealed class CompanyImageState
    {
        public string? LogoUrl { get; set; }
        public string? SealUrl { get; set; }
    }

    // ── 🔴 [§D-2] 로고 워터마크 공통 설정 (DB-148 · 결-I) ──

    private PrintCommonModel _common = new();
    private bool _commonBusy;

    /// <summary>
    /// 인쇄 공통 설정을 읽는다 — 🔴 행이 없으면 서버가 <b>제안값</b>을 돌려준다.
    /// </summary>
    private async Task LoadPrintCommonAsync()
    {
        try
        {
            var dto = await Http.GetFromJsonAsync<PrintCommonModel>("api/settings/print-common");
            if (dto is not null) _common = dto;
        }
        catch (Exception ex)
        {
            // 🔴 빈 catch 금지(#15). 못 읽어도 화면은 제안값으로 열린다.
            Console.Error.WriteLine($"[PrintSettings] 공통 설정을 못 읽었다: {ex.Message}");
            Snackbar.Add("워터마크 설정을 불러오지 못했습니다. 화면을 다시 열어 주십시오.", Severity.Warning);
        }
    }

    /// <summary>
    /// 공통 설정을 저장한다 — 🔴 <b>성공한 뒤에만</b> 저장되었다고 말한다.
    /// </summary>
    /// <remarks>
    /// 🔴 이 화면의 다른 묶음(여백·하단 문구)은 아직 저장되지 않는다. 그래서 **같이 묶지 않고**
    ///   이 묶음만의 저장 단추를 둔다 — 하나를 눌러 둘 다 저장된 것처럼 보이면 거짓이 된다.
    /// </remarks>
    private async Task SavePrintCommonAsync()
    {
        _commonBusy = true;
        try
        {
            var resp = await Http.PutAsJsonAsync("api/settings/print-common", _common);
            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add("워터마크 설정을 저장했습니다.", Severity.Success);
            }
            else
            {
                Snackbar.Add(await ReadMessageAsync(resp), Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"워터마크 설정을 저장하지 못했습니다: {ex.Message}", Severity.Error);
        }
        finally
        {
            _commonBusy = false;
        }
    }

    /// <summary>
    /// 공통 설정 그릇 — ⚠️ 서버 DTO(<c>PrintCommonSettingsDto</c>)와 <b>이름이 같아야</b>
    /// JSON 이 매핑된다. 다르면 값이 조용히 기본값으로 떨어진다.
    /// </summary>
    private sealed class PrintCommonModel
    {
        public bool WatermarkEnabled { get; set; }
        public decimal WatermarkOpacity { get; set; } = WatermarkDefaults.Opacity;
        public decimal WatermarkSaturate { get; set; } = WatermarkDefaults.Saturate;
        public int WatermarkScalePct { get; set; } = WatermarkDefaults.ScalePct;
        public bool PrintBackgroundDefault { get; set; }
    }

    // ── 직인 파일 선택 ──
    private void OnSealFileChanged(IBrowserFile file)
    {
        _sealFile = file;
    }

    // ── 직인 업로드 ──
    private async Task UploadSeal() => await UploadImageAsync("seal", _sealFile);

    // ── 직인 삭제 ──
    private async Task DeleteSeal() => await DeleteImageAsync("seal", _sealPath);

    // ── 로고 파일 선택 ──
    private void OnLogoFileChanged(IBrowserFile file)
    {
        _logoFile = file;
    }

    // ── 로고 업로드 ──
    private async Task UploadLogo() => await UploadImageAsync("logo", _logoFile);

    // ── 로고 삭제 ──
    private async Task DeleteLogo() => await DeleteImageAsync("logo", _logoPath);

    /// <summary>
    /// 그림을 서버로 보낸다 — 🔴 <b>성공한 뒤에만</b> 등록되었다고 말한다.
    /// </summary>
    /// <remarks>
    /// 🔴 서버가 거절하면 그 까닭을 <b>그대로</b> 보여 준다(상한 초과·그림 아님·열 수 없음).
    ///   「실패했습니다」만 띄우면 고객은 무엇을 고쳐야 할지 모른다.
    /// </remarks>
    private async Task UploadImageAsync(string kind, IBrowserFile? file)
    {
        if (file is null) return;

        var busy = kind == "seal";
        if (busy) _sealBusy = true; else _logoBusy = true;
        try
        {
            using var content = new MultipartFormDataContent();
            // 🔴 상한을 화면에서도 한 번 본다 — 큰 파일을 올렸다가 서버에서 거절당하는
            //   왕복을 줄인다. 🔴 그래도 **서버가 다시 본다**(화면 검사는 편의일 뿐이다).
            var stream = file.OpenReadStream(CompanyImageLimits.MaxBytes);
            var fileContent = new StreamContent(stream);
            content.Add(fileContent, "file", file.Name);
            content.Add(new StringContent(kind), "kind");

            var resp = await Http.PostAsync("api/settings/company-image", content);
            if (resp.IsSuccessStatusCode)
            {
                await LoadCompanyImagesAsync();
                if (kind == "seal") _sealFile = null; else _logoFile = null;
                Snackbar.Add(kind == "seal" ? "직인이 등록되었습니다." : "로고가 등록되었습니다.",
                    Severity.Success);
            }
            else
            {
                var why = await ReadMessageAsync(resp);
                Snackbar.Add(why, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"그림을 올리지 못했습니다: {ex.Message}", Severity.Error);
        }
        finally
        {
            if (busy) _sealBusy = false; else _logoBusy = false;
        }
    }

    /// <summary>그림을 지운다 — 🔴 <b>파일과 칸을 같이</b> 비운다.</summary>
    private async Task DeleteImageAsync(string kind, string? storedPath)
    {
        if (string.IsNullOrWhiteSpace(storedPath)) return;

        var busy = kind == "seal";
        if (busy) _sealBusy = true; else _logoBusy = true;
        try
        {
            var req = new HttpRequestMessage(HttpMethod.Delete, "api/settings/company-image")
            {
                Content = JsonContent.Create(new { StoredPath = storedPath, Kind = kind })
            };
            var resp = await Http.SendAsync(req);
            if (resp.IsSuccessStatusCode)
            {
                await LoadCompanyImagesAsync();
                Snackbar.Add(kind == "seal" ? "직인을 지웠습니다." : "로고를 지웠습니다.", Severity.Success);
            }
            else
            {
                Snackbar.Add(await ReadMessageAsync(resp), Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"그림을 지우지 못했습니다: {ex.Message}", Severity.Error);
        }
        finally
        {
            if (busy) _sealBusy = false; else _logoBusy = false;
        }
    }

    /// <summary>서버가 돌려준 까닭을 사람 말로 꺼낸다.</summary>
    private static async Task<string> ReadMessageAsync(HttpResponseMessage resp)
    {
        try
        {
            var body = await resp.Content.ReadAsStringAsync();
            if (string.IsNullOrWhiteSpace(body)) return "그림을 처리하지 못했습니다.";
            using var doc = System.Text.Json.JsonDocument.Parse(body);
            if (doc.RootElement.TryGetProperty("message", out var m))
            {
                var text = m.GetString();
                if (!string.IsNullOrWhiteSpace(text)) return text!;
            }
            return "그림을 처리하지 못했습니다.";
        }
        catch (Exception ex)
        {
            // 🔴 까닭을 못 읽어도 고객에게는 사람 말로 돌려준다(#15).
            Console.Error.WriteLine($"[PrintSettings] 응답을 읽지 못했다: {ex.Message}");
            return "그림을 처리하지 못했습니다.";
        }
    }

    /// <summary>
    /// 설정 저장 — 🔴 아직 저장되지 않는다 (2026-08-11, 사장님 지시 "거짓문구는 모두 삭제").
    ///
    ///   종전에는 아무것도 저장하지 않고 "설정이 저장되었습니다." 라고 알렸다.
    ///   고객은 저장된 줄 알고 화면을 닫았고, 다시 들어오면 값이 처음으로 돌아가 있었다.
