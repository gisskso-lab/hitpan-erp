@page "/settings/tax-invoice-cert"
@namespace HitPan.Web.Pages.SettingsUi
@attribute [Authorize]
@using HitPan.Web.Services
@inject TaxInvoiceCertClientService CertApi
@inject ISnackbar Snackbar
@inject IDialogService Dialog

<PageTitle>전자세금계산서 인증서 등록</PageTitle>

<PageHeader Title="전자세금계산서 인증서 등록" Subtitle="고객사 범용 공인인증서 등록 → ERP가 직접 홈택스에 발행 (외주 0)">
    <Actions>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Help"
                   OnClick="ShowGuide">발급 가이드</MudButton>
    </Actions>
</PageHeader>

<MudAlert Severity="Severity.Info" Class="mb-3" Dense="true" Icon="@Icons.Material.Filled.Security">
    <strong>3중 보안 적용</strong>: 사용자 PIN + ERP 마스터 키 + TPM 2.0 봉인. 인증서는 사장님 PC에만 저장되며 본사는 보지 않습니다.
</MudAlert>

@if (_certInfo is null)
{
    <SectionCard Title="공인인증서 신규 등록">
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudAlert Severity="Severity.Warning" Dense="true">
                    범용 공인인증서(.pfx) 파일을 등록하세요. 전자세금계산서 발급 전용으로 사용됩니다.
                </MudAlert>
            </MudItem>
            <MudItem xs="12">
                <MudFileUpload T="IBrowserFile" FilesChanged="OnFileSelected" Accept=".pfx,.p12">
                    <ActivatorContent>
                        <MudButton HtmlTag="label" Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.CloudUpload">
                            .pfx 파일 선택
                        </MudButton>
                    </ActivatorContent>
                </MudFileUpload>
                @if (_selectedFile is not null)
                {
                    <MudText Class="mt-2" Typo="Typo.body2">선택: @_selectedFile.Name (@(_selectedFile.Size / 1024) KB)</MudText>
                }
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField T="string" Label="인증서 비밀번호 (PIN)" @bind-Value="_pin"
                              Variant="Variant.Outlined" Margin="Margin.Dense"
                              InputType="InputType.Password"
                              HelperText="인증서 발급 시 설정한 비밀번호" />
            </MudItem>
            <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Success"
                           StartIcon="@Icons.Material.Filled.Save"
                           OnClick="RegisterAsync" Disabled="@(_selectedFile is null || string.IsNullOrEmpty(_pin) || _busy)">
                    @(_busy ? "등록 중..." : "인증서 등록")
                </MudButton>
            </MudItem>
        </MudGrid>
    </SectionCard>
}
else
{
    <SectionCard Title="등록된 인증서 정보">
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.body2"><strong>발급자:</strong> @_certInfo.Issuer</MudText>
                <MudText Typo="Typo.body2"><strong>주체:</strong> @_certInfo.Subject</MudText>
                <MudText Typo="Typo.body2"><strong>일련번호:</strong> @_certInfo.SerialNumber</MudText>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.body2">
                    <strong>유효기간:</strong> @_certInfo.NotBefore.ToString("yyyy-MM-dd") ~ @_certInfo.NotAfter.ToString("yyyy-MM-dd")
                </MudText>
                <MudText Typo="Typo.body2" Color="@(GetExpiryColor())">
                    <strong>만료까지:</strong> @_certInfo.DaysToExpiry 일
                </MudText>
                <MudText Typo="Typo.body2"><strong>등록일:</strong> @_certInfo.RegisteredAt.ToString("yyyy-MM-dd HH:mm")</MudText>
            </MudItem>
        </MudGrid>

        @if (_certInfo.DaysToExpiry <= 30)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-3" Dense="true">
                <strong>인증서 만료 임박!</strong> 갱신 후 재등록해 주세요. (D-@_certInfo.DaysToExpiry)
            </MudAlert>
        }

        <MudDivider Class="my-3" />

        <MudGrid Spacing="2">
            <MudItem xs="12" md="6">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="ReRegisterAsync" FullWidth="true">
                    인증서 재등록 (갱신)
                </MudButton>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudButton Variant="Variant.Outlined" Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Delete"
                           OnClick="RemoveAsync" FullWidth="true">
                    인증서 삭제
                </MudButton>
            </MudItem>
        </MudGrid>
    </SectionCard>

    <SectionCard Title="보안 상태" Class="mt-3" Variant="SectionCard.SectionVariant.Flat">
        <MudList T="string" Dense="true">
            <MudListItem T="string" Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success">
                사용자 PIN 암호화 (1차)
            </MudListItem>
            <MudListItem T="string" Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success">
                ERP 마스터 키 암호화 (2차)
            </MudListItem>
            <MudListItem T="string" Icon="@(_securityStatus.TpmSealed ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Warning)"
                         IconColor="@(_securityStatus.TpmSealed ? Color.Success : Color.Warning)">
                TPM 2.0 봉인 @(_securityStatus.TpmSealed ? "(적용됨)" : "(미지원 PC)")
            </MudListItem>
            <MudListItem T="string" Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success">
                저장 위치 격리 (%LOCALAPPDATA%\HitPan\Secure\)
            </MudListItem>
            <MudListItem T="string" Icon="@(_securityStatus.RemoteControlDetected ? Icons.Material.Filled.Warning : Icons.Material.Filled.CheckCircle)"
                         IconColor="@(_securityStatus.RemoteControlDetected ? Color.Error : Color.Success)">
                @if (_securityStatus.RemoteControlDetected)
                {
                    <text>🚨 원격제어 감지: @_securityStatus.DetectedRemoteTool</text>
                }
                else
                {
                    <text>원격제어 차단 (TeamViewer·AnyDesk·RustDesk 등 15종 감지)</text>
                }
            </MudListItem>
            <MudListItem T="string" Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success">
                가상 키패드 활성 (Red Team 권고: PIN 키로깅 차단)
            </MudListItem>
        </MudList>
    </SectionCard>

    @* 워치독 무결성 보고서 — WS-23 (TPM) + WS-24 (클라우드) + WS-25 (만료) *@
    @if (_watchdog is not null && _watchdog.Warnings.Count > 0)
    {
        <SectionCard Title="⚠️ 워치독 무결성 경고" Class="mt-3">
            @foreach (var warning in _watchdog.Warnings)
            {
                <MudAlert Severity="@GetWarningSeverity(warning)" Dense="true" Class="mb-2">
                    @warning
                </MudAlert>
            }
        </SectionCard>
    }
}

@code {
    private CertInfoDto? _certInfo;
    private SecurityStatusDto _securityStatus = new();
    private WatchdogReportDto? _watchdog;
    private IBrowserFile? _selectedFile;
    private string _pin = string.Empty;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _certInfo = await CertApi.GetCertInfoAsync();
        _securityStatus = await CertApi.GetSecurityStatusAsync();
        if (_certInfo is not null)
        {
            _watchdog = await CertApi.GetWatchdogReportAsync();
        }
    }

    private Severity GetWarningSeverity(string warning)
    {
        if (warning.Contains("🚨")) return Severity.Error;
        if (warning.Contains("⚠️")) return Severity.Warning;
        return Severity.Info;
    }

    private void OnFileSelected(IBrowserFile file)
    {
        _selectedFile = file;
        if (file.Size > 100 * 1024)
        {
            Snackbar.Add("인증서 파일 크기 초과 (100KB 제한)", Severity.Error);
            _selectedFile = null;
        }
    }

    private async Task RegisterAsync()
    {
        if (_selectedFile is null || string.IsNullOrEmpty(_pin)) return;
        _busy = true;
        try
        {
            using var stream = _selectedFile.OpenReadStream(100 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var pfxBytes = ms.ToArray();

            var result = await CertApi.RegisterCertAsync(pfxBytes, _pin);
            if (result.Success)
            {
                Snackbar.Add("인증서 등록 완료. 3중 보안 적용됨.", Severity.Success);
                _pin = string.Empty;
                _selectedFile = null;
                await LoadAsync();
            }
            else
            {
                Snackbar.Add($"등록 실패: {result.ErrorMessage}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"오류: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
            _pin = string.Empty;
        }
    }

    private async Task ReRegisterAsync()
    {
        _certInfo = null;
        await Task.CompletedTask;
    }

    private async Task RemoveAsync()
    {
        // MudBlazor 8.x: ShowMessageBox 대신 단순 확인 - JS interop은 향후 W3에서 dialog 컴포넌트로 교체
        // 현재는 즉시 삭제 (UI 보강 영역)
        await Task.CompletedTask;

        var result = await CertApi.RemoveCertAsync();
        if (result.Success)
        {
            Snackbar.Add("인증서 삭제 완료", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add($"삭제 실패: {result.ErrorMessage}", Severity.Error);
        }
    }

    private Color GetExpiryColor()
    {
        if (_certInfo is null) return Color.Default;
        if (_certInfo.DaysToExpiry <= 7) return Color.Error;
        if (_certInfo.DaysToExpiry <= 30) return Color.Warning;
        return Color.Success;
    }

    private void ShowGuide()
    {
        Snackbar.Add("발급 가이드 — 카카오/토스/금융인증/PASS 4종 발급처 안내 (Phase 2 통합 예정)", Severity.Info);
    }

    public record CertInfoDto(
        string Issuer,
        string Subject,
        string SerialNumber,
        DateTime NotBefore,
        DateTime NotAfter,
        int DaysToExpiry,
        DateTime RegisteredAt);

    public record SecurityStatusDto
    {
        public bool TpmSealed { get; init; }
        public bool RemoteControlDetected { get; init; }
        public string? DetectedRemoteTool { get; init; }
        public List<string> ActiveRemoteTools { get; init; } = new();
        public bool VirtualKeypadEnabled { get; init; } = true;
        public string? StorageRoot { get; init; }
    }

    public record WatchdogReportDto(
        bool TpmSealedValid,
        bool CloudSyncRisk,
        string? CloudSyncDetectedPath,
        int? DaysToExpiry,
        string ExpiryLevel,
        List<string> Warnings);
}
