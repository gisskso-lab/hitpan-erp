@page "/settings/approval"
@namespace HitPan.Web.Pages.SettingsUi
@attribute [Authorize]
@using HitPan.Web.Models
@using HitPan.Web.Services
@inject ApprovalService ApprovalSvc
@inject EmployeeService EmployeeSvc
@inject ISnackbar Snackbar

<PageTitle>결재 설정</PageTitle>

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
    <MudText Typo="Typo.h6">결재 설정</MudText>
    <MudText Style="font-size:12px;color:var(--mud-palette-text-secondary)">
        문서유형별 결재 ON/OFF · 기준금액 · 결재라인 · 위임결재
    </MudText>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_loadFailed)
{
    @* 🔴 못 불러온 것 — "설정이 없다" 와 다른 사실이다. 빈 표로 보이면
       결재 설정이 지워진 줄 알고 처음부터 다시 입력하게 된다. *@
    <LoadFailedState Title="결재 설정을 불러오지 못했습니다"
                     Subtitle="설정이 지워진 것이 아닙니다. 연결이 회복되면 다시 보입니다."
                     Retrying="@_loading"
                     OnRetry="LoadAsync" />
}
else
{
    @* ── 1. 문서유형별 결재 ON/OFF 설정 ── *@
    <MudPaper Elevation="0" Class="pa-4 mb-4" Style="border:0.5px solid var(--mud-palette-lines-default);border-radius:12px">
        <MudText Typo="Typo.subtitle2" Class="mb-3">문서유형별 결재 사용</MudText>

        @* 진짜로 0건일 때만 온다 — 위에서 실패는 이미 걸러냈다. *@
        @if (_settings.Count == 0)
        {
            <MudAlert Severity="Severity.Normal" Dense="true" Icon="@Icons.Material.Filled.RuleFolder">
                아직 결재를 사용할 문서유형이 없습니다.
            </MudAlert>
        }

        <MudTable Items="_settings" Dense="true" Hover="true">
            <HeaderContent>
                <MudTh>문서유형</MudTh>
                <MudTh Style="width:80px;text-align:center">사용</MudTh>
                <MudTh Style="width:160px">기준금액</MudTh>
                <MudTh Style="width:100px;text-align:center">미만 자동승인</MudTh>
                <MudTh Style="width:80px">최대라인</MudTh>
                <MudTh Style="width:120px">결재라인</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.DocTypeLabel</MudTd>
                <MudTd Style="text-align:center">
                    <MudSwitch T="bool" Value="context.IsEnabled" ValueChanged="@(v => OnToggle(context, v))" Color="Color.Primary" />
                </MudTd>
                <MudTd>
                    <MudNumericField T="decimal" Value="context.ThresholdAmount"
                        ValueChanged="@(v => OnThresholdChange(context, v))"
                        Variant="Variant.Outlined" Margin="Margin.Dense" Format="N0"
                        Disabled="@(!context.IsEnabled)" />
                </MudTd>
                <MudTd Style="text-align:center">
                    <MudCheckBox T="bool" Value="context.AutoApproveBelow"
                        ValueChanged="@(v => OnAutoApproveChange(context, v))"
                        Disabled="@(!context.IsEnabled || context.ThresholdAmount <= 0)" />
                </MudTd>
                <MudTd>
                    <MudNumericField T="int" Value="context.MaxLines"
                        ValueChanged="@(v => OnMaxLinesChange(context, v))"
                        Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="5"
                        Disabled="@(!context.IsEnabled)" />
                </MudTd>
                <MudTd>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                        StartIcon="@Icons.Material.Filled.Settings"
                        OnClick="@(() => OpenLineEditor(context.DocType, context.DocTypeLabel))"
                        Disabled="@(!context.IsEnabled)">설정</MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>

    @* ── 2. 결재라인 편집 영역 ── *@
    @if (_editingDocType is not null)
    {
        <MudPaper Elevation="0" Class="pa-4 mb-4" Style="border:0.5px solid var(--mud-palette-lines-default);border-radius:12px">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
                <MudText Typo="Typo.subtitle2">@_editingDocTypeLabel 결재라인</MudText>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="AddLine">추가</MudButton>
            </div>

            @* ── 작20260822작1 G1-[B] 후보 0명 ── *@
            @* 결재선을 짤 수 없는 상태다. "다시 시도" 가 아니라 갈 곳을 알려준다.  *@
            @if (_noApproverCandidates)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">
                    결재할 수 있는 직원이 없습니다. 결재 권한을 가진 직원이 있어야 결재선을 만들 수 있습니다.
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Inherit"
                        Href="/users/permissions">권한설정으로 이동</MudButton>
                </MudAlert>
            }

            @* ── 작20260822작1 G1-[A] 마지막 결재자가 대표가 아니면 경고 ── *@
            @* 🔴 사장님 결재(Q1): **경고만 한다. 자동으로 넣지 않는다.**                *@
            @*    사람이 짠 결재선을 시스템이 덮어쓰면 반자동 원칙에 어긋난다.          *@
            @if (FinalApproverWarning is not null)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">@FinalApproverWarning</MudAlert>
            }

            @* ── 작20260822작1 G1-[C] 권한 잃은 결재자가 결재선에 남아 있다 ── *@
            @* 🔴 막지 않고 알린다(작업지시서 §7) — 갑자기 막으면 지금 도는 결재가 선다. *@
            @if (_permissionLostNames.Count > 0)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                    @(string.Join(", ", _permissionLostNames)) 님은 결재 권한이 없어 결재함을 열 수 없습니다.
                    이대로 두면 이 결재선의 문서가 그 단계에서 멈춥니다. 변경하시겠습니까?
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Inherit"
                        Href="/users/permissions">권한설정으로 이동</MudButton>
                </MudAlert>
            }

            <MudTable Items="_lines" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh Style="width:50px">순서</MudTh>
                    <MudTh>결재자</MudTh>
                    <MudTh Style="width:100px">직책라벨</MudTh>
                    <MudTh>위임결재자</MudTh>
                    <MudTh Style="width:130px">위임시작일</MudTh>
                    <MudTh Style="width:130px">위임종료일</MudTh>
                    <MudTh Style="width:60px"></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.SeqNo</MudTd>
                    <MudTd>
                        <MudAutocomplete T="EmployeeListItemModel" Label="결재자"
                            Value="_employeeLookup.GetValueOrDefault(context.ApproverId)"
                            ValueChanged="@(e => OnApproverChanged(context, e))"
                            SearchFunc="SearchEmployee" ToStringFunc="@(e => e?.EmpName ?? "")"
                            Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" />
                    </MudTd>
                    <MudTd>
                        <MudTextField T="string" @bind-Value="context.RoleLabel" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="팀장, 부장 등" />
                    </MudTd>
                    <MudTd>
                        <MudAutocomplete T="EmployeeListItemModel" Label="위임자"
                            Value="GetEmployee(context.DelegateId)"
                            ValueChanged="@(e => OnDelegateChanged(context, e))"
                            SearchFunc="SearchEmployee" ToStringFunc="@(e => e?.EmpName ?? "")"
                            Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" />
                    </MudTd>
                    <MudTd>
                        <MudDatePicker Date="context.DelegateStart" DateChanged="@(d => context.DelegateStart = d)"
                            Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="시작일" Style="min-width:130px" />
                    </MudTd>
                    <MudTd>
                        <MudDatePicker Date="context.DelegateEnd" DateChanged="@(d => context.DelegateEnd = d)"
                            Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="종료일" Style="min-width:130px" />
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => RemoveLine(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>

            <MudToolBar Dense="true" Class="pa-1 gap-1 mt-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveLinesAsync">라인 저장</MudButton>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Close" OnClick="CloseLineEditor">닫기</MudButton>
            </MudToolBar>
        </MudPaper>
    }
}

@code {
    // 결재 설정 목록
    private List<ApprovalSettingModel> _settings = new();
    // 결재 라인 편집
    private string? _editingDocType;
    private string? _editingDocTypeLabel;
    private List<ApprovalLineItemModel> _lines = new();
    // 🔴 작20260822작1 G1-[B] — 목록이 둘이다. 하나로 합치면 반드시 사고가 난다.
    //
    //   _employees      = **고를 수 있는 사람** (부모계정 + APPROVAL 권한자만)
    //   _employeeLookup = **이름을 찾아볼 사람** (전 직원)
    //
    //   왜 갈랐나. 이미 저장된 결재선에 권한을 잃은 사람이 남아 있을 수 있다.
    //   후보 목록만 들고 있으면 그 사람 이름을 못 찾아 **결재자 칸이 빈칸으로 보인다.**
    //   빈칸은 "결재자가 없다" 로 읽혀서, 담당자가 멀쩡한 결재선을 지우게 만든다.
    //   ⇒ 고르는 것은 막고, 보이는 것은 살린다(작업지시서 §7 "막지 말고 알린다").
    private List<EmployeeListItemModel> _employees = new();
    private Dictionary<string, EmployeeListItemModel> _employeeLookup = new();

    // 결재자 후보가 0명인가. 🔴 "못 불러왔다"(_loadFailed) 와 다른 사실이다.
    //   0명이면 결재선을 아예 짤 수 없다 — 권한을 준 사람이 없다는 뜻이므로
    //   "다시 시도" 가 아니라 **권한설정으로 가라**고 안내해야 한다.
    private bool _noApproverCandidates;
    private bool _loading = true;

    // 설정을 못 불러왔는지 여부. 🔴 "설정이 하나도 없다" 와 반드시 구분한다.
    //   종전에는 실패해도 헤더만 있는 빈 표가 떠서, 결재 설정이 지워진 것인지
    //   잠깐 못 불러온 것인지 화면만 봐서는 알 수 없었다.
    private bool _loadFailed;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadFailed = false;
        try
        {
            var settings = await ApprovalSvc.GetSettingsOrNullAsync();

            // 🔴 작20260822작1 G1-[B] — 두 목록을 따로 받는다.
            //   candidates = 고를 수 있는 사람(서버가 부모계정 + APPROVAL 권한자만 걸러 준다)
            //   allEmps    = 이름을 찾아볼 사람(전 직원 — 이미 저장된 결재자 표시용)
            var candidates = await EmployeeSvc.GetApproverCandidatesOrNullAsync();
            var allEmps = await EmployeeSvc.GetListOrNullAsync();

            // null = 실패. 빈 목록(정상 0건) 과 다른 사실이다.
            // 결재자를 못 고르는 화면은 반쪽이므로 사원 목록 실패도 실패로 본다.
            if (settings is null || candidates is null || allEmps is null)
            {
                _loadFailed = true;
                _settings = new();
                _employees = new();
                _employeeLookup = new();
                _noApproverCandidates = false;
                return;
            }

            _settings = settings;
            _employees = candidates;

            // 🔴 이름 찾기는 **전 직원**으로 만든다. 후보로 만들면 권한 잃은 기존
            //    결재자의 이름이 사라져 빈칸으로 보인다(위 필드 주석 참조).
            _employeeLookup = allEmps.ToDictionary(e => e.EmployeeId, e => e);

            // 후보 0명 = 권한 가진 사람이 아무도 없다. 결재선을 짤 수 없는 상태다.
            _noApproverCandidates = candidates.Count == 0;
        }
        finally
        {
            // 예외가 나도 진행바가 영원히 돌지 않게 한다.
            _loading = false;
        }
    }

    // ── 설정 토글/변경 → 즉시 저장 ──
    //
    // 🔴 즉시 저장 방식이라 저장이 실패하면 화면 값을 반드시 되돌려야 한다.
    //    되돌리지 않으면 스위치는 켜져 있는데 실제 결재는 꺼져 있는 상태가 되어,
    //    결재 없이 문서가 나가는 사고로 이어진다. 아래 각 핸들러가 이전 값을 들고 있다가
    //    저장 실패 시 원래대로 복구한다.

    private async Task OnToggle(ApprovalSettingModel s, bool v)
    {
        var before = s.IsEnabled;
        s.IsEnabled = v;
        if (!await SaveSettingAsync(s)) s.IsEnabled = before;
    }

    private async Task OnThresholdChange(ApprovalSettingModel s, decimal v)
    {
        var before = s.ThresholdAmount;
        s.ThresholdAmount = v;
        if (!await SaveSettingAsync(s)) s.ThresholdAmount = before;
    }

    private async Task OnAutoApproveChange(ApprovalSettingModel s, bool v)
    {
        var before = s.AutoApproveBelow;
        s.AutoApproveBelow = v;
        if (!await SaveSettingAsync(s)) s.AutoApproveBelow = before;
    }

    private async Task OnMaxLinesChange(ApprovalSettingModel s, int v)
    {
        var before = s.MaxLines;
        s.MaxLines = v;
        if (!await SaveSettingAsync(s)) s.MaxLines = before;
    }

    /// <summary>설정을 저장한다. 저장에 실패하면 false — 호출부가 화면 값을 되돌린다.</summary>
    private async Task<bool> SaveSettingAsync(ApprovalSettingModel s)
    {
        var ok = await ApprovalSvc.SaveSettingAsync(new SaveApprovalSettingModel
        {
            DocType = s.DocType,
            IsEnabled = s.IsEnabled,
            ThresholdAmount = s.ThresholdAmount,
            AutoApproveBelow = s.AutoApproveBelow,
            MaxLines = s.MaxLines
        });
        if (ok)
        {
            Snackbar.Add($"{s.DocTypeLabel} 설정 저장됨", Severity.Success);
        }
        else
        {
            // 저장 안 됐다는 사실과 화면을 되돌렸다는 사실을 함께 알린다.
            Snackbar.Add($"{s.DocTypeLabel} 설정을 저장하지 못했습니다. 이전 설정으로 되돌렸습니다.", Severity.Error);
        }
        return ok;
    }

    // ── 결재라인 편집 ──

    private async Task OpenLineEditor(string docType, string label)
    {
        _editingDocType = docType;
        _editingDocTypeLabel = label;
        var existing = await ApprovalSvc.GetLinesAsync(docType);
        _lines = existing.Select(l => new ApprovalLineItemModel
        {
            SeqNo = l.SeqNo,
            ApproverId = l.ApproverId,
            ApproverName = l.ApproverName,
            RoleLabel = l.RoleLabel,
            DelegateId = l.DelegateId,
            DelegateName = l.DelegateName,
            DelegateStart = l.DelegateStart,
            DelegateEnd = l.DelegateEnd
        }).ToList();

        // 🔴 작20260822작1 G1-[C] — 불러온 결재선에 권한 잃은 사람이 있는지 즉시 본다.
        //    화면을 열자마자 알려야 한다. 저장할 때 알리면 이미 늦다.
        RecomputePermissionLost();
        StateHasChanged();
    }

    private void CloseLineEditor()
    {
        _editingDocType = null;
        _lines.Clear();
    }

    private void AddLine()
    {
        _lines.Add(new ApprovalLineItemModel { SeqNo = _lines.Count + 1 });
    }

    private void RemoveLine(ApprovalLineItemModel line)
    {
        _lines.Remove(line);
        for (var i = 0; i < _lines.Count; i++)
            _lines[i].SeqNo = i + 1;
        RecomputePermissionLost();
    }

    private void OnApproverChanged(ApprovalLineItemModel line, EmployeeListItemModel? emp)
    {
        if (emp is null) return;
        line.ApproverId = emp.EmployeeId;
        line.ApproverName = emp.EmpName;
        RecomputePermissionLost();
    }

    private void OnDelegateChanged(ApprovalLineItemModel line, EmployeeListItemModel? emp)
    {
        if (emp is null) { line.DelegateId = null; line.DelegateName = null; return; }
        line.DelegateId = emp.EmployeeId;
        line.DelegateName = emp.EmpName;
    }

    private async Task SaveLinesAsync()
    {
        if (_editingDocType is null) return;
        var ok = await ApprovalSvc.SaveLinesAsync(new SaveApprovalLinesModel
        {
            DocType = _editingDocType,
            Lines = _lines
        });
        if (ok) Snackbar.Add("결재라인 저장됨", Severity.Success);
        else Snackbar.Add("저장 실패", Severity.Error);
    }

    private EmployeeListItemModel? GetEmployee(string? id)
    {
        if (string.IsNullOrEmpty(id)) return null;
        return _employeeLookup.GetValueOrDefault(id);
    }

    // ── 작20260822작1 G1-[A] 마지막 결재자 = 대표이사 ──
    //
    // 사장님 오더: "대표이사 마지막 결재 외는 권한가진자가 하는걸로."
    // 사장님 결재(Q1): **경고만.** 자동으로 대표를 넣지 않는다 — 반자동 원칙.
    //
    // 🔴 대표 판정은 IsParentAccount(= users.is_parent) 로만 한다.
    //    Position 문자열로 판정하면 안 된다 — T-004 실측에서 대표인데도 null 이었다(G1-5).
    //
    // 🔴 후보 목록(_employees)이 아니라 _employeeLookup 에서 찾는다.
    //    이미 저장된 결재자가 후보에서 빠져 있을 수 있고, 그때 "모른다" 를
    //    "대표가 아니다" 로 단정하면 없는 경고가 뜬다.
    private string? FinalApproverWarning
    {
        get
        {
            if (_lines.Count == 0) return null;

            var last = _lines[_lines.Count - 1];
            if (string.IsNullOrEmpty(last.ApproverId))
                return "마지막 결재자가 비어 있습니다. 최종 결재는 대표이사여야 합니다.";

            var emp = _employeeLookup.GetValueOrDefault(last.ApproverId);

            // 누군지 모르면 경고하지 않는다. 모르는 것과 틀린 것은 다르다.
            if (emp is null) return null;

            if (emp.CanBeFinalApprover) return null;

            return $"마지막 결재자가 대표이사가 아닙니다(현재: {emp.EmpName}). 최종 결재는 대표이사여야 합니다.";
        }
    }

    // ── 작20260822작1 G1-[C] 권한 잃은 결재자 ──
    //
    // 결재선에 있는데 APPROVAL 권한이 없는 사람을 찾아 이름을 모은다.
    // 🔴 막지 않는다(작업지시서 §7). 갑자기 막으면 지금 도는 결재가 선다.
    //
    // 판정: **후보 목록에 없으면** 권한이 없는 것이다.
    //   후보 목록은 서버가 "부모계정 OR APPROVAL 권한자" 로 만든 것이므로,
    //   거기 없다는 것은 그 사람이 결재함에 못 들어간다는 뜻이다.
    //   ⚠️ 화면이 권한을 직접 판정하지 않는다 — user_permissions 를 볼 수 없고,
    //      부모계정은 그 표를 거치지도 않기 때문이다.
    private List<string> _permissionLostNames = new();

    private void RecomputePermissionLost()
    {
        var candidateIds = _employees.Select(e => e.EmployeeId).ToHashSet();
        var names = new List<string>();

        foreach (var line in _lines)
        {
            if (string.IsNullOrEmpty(line.ApproverId)) continue;
            if (candidateIds.Contains(line.ApproverId)) continue;

            // 후보에 없다 = 결재 못 한다. 이름은 전 직원 목록에서 찾는다.
            var emp = _employeeLookup.GetValueOrDefault(line.ApproverId);
            names.Add(emp?.EmpName ?? line.ApproverName ?? "(이름 미상)");
        }

        _permissionLostNames = names.Distinct().ToList();
    }

    private Task<IEnumerable<EmployeeListItemModel>> SearchEmployee(string? value, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(_employees.AsEnumerable());
        return Task.FromResult(_employees.Where(e =>
            e.EmpName.Contains(value, StringComparison.OrdinalIgnoreCase) ||
            e.EmpNo.Contains(value, StringComparison.OrdinalIgnoreCase)));
    }
}
