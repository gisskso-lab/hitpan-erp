@page "/settings/devices"
@namespace HitPan.Web.Pages.SettingsUi
@* ══════════════════════════════════════════════════════════════════════
   🔴 2026-10-05 작4 B-3 — 「등록 기기 관리」 → 「접속기기 확인」 (설계 20261005_설계_접속기기확인_슬롯폐기 §4 · 9/28 §6)
   사장님 오더(10/5): *"슬롯제한 기능을 폐기 … "접속기기 확인" 으로 메뉴정정 … 접속된 기기, 로그인상태,
     로그인충돌시 이슈기록 … 조회 기능만"*
   · 화면에 **쓰기 버튼 0** — 걷은 것: [모바일기기 등록](QR) · 승인 대기 구역 · [승인]·[거부]·[인증키 재발급] · 인증키 1회 창 ·
     행 [기기 폐기] · 슬롯 구매 안내 · KPI 카드 4장(→ 직원계정관리 · 작3) · 머리말 「디바이스 개수 과금」 · 기기 목록 표.
   · 남긴 것: [새로고침](읽기) · 「회사 서버(메인 PC)」 칸(`GET api/devices` 의 IsMainPc · 표시만) ·
     [메인PC 연결] **안내 창만**(사장님 E-6 · 서버 쓰기 0 — 실제 연결은 새 컴퓨터 로그인 때 MainPcGate 가 한다).
   · 옛 본문(862줄)은 git `c6f0ade1:src/HitPan.Web/Pages/Settings/DeviceManagePage.razor` 에 그대로 있다 — B-3 은 결재된 재구성이다.
   · 주소 `/settings/devices` 그대로(즐겨찾기·알림 링크).
   · 🔴 8/11 지시(설정관리는 대표만) — 서버가 대표만 답한다(AccessStatusController 403). 직원이 들어오면 한 줄 안내만 본다.
══════════════════════════════════════════════════════════════════════ *@
@attribute [Authorize]
@using System.Net
@using System.Net.Http.Json
@using HitPan.Web.Components.Common
@inject HttpClient Http
@inject NavigationManager Nav
@inject ILogger<DeviceManagePage> _logger

<PageTitle>접속기기 확인 — 히트판 ERP</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-4">
    <PageHeader Title="접속기기 확인"
                Subtitle="한 아이디는 컴퓨터 1대에서만 쓸 수 있습니다. 휴대폰은 몇 대든 함께 쓸 수 있습니다.">
        <Actions>
            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                           Color="Color.Primary"
                           Size="Size.Medium"
                           OnClick="LoadAsync"
                           title="새로고침" />
        </Actions>
    </PageHeader>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    else if (_adminOnly)
    {
        <MudAlert Severity="Severity.Info" Class="mb-3">이 화면은 대표 계정에서만 볼 수 있습니다.</MudAlert>
    }
    else if (_loadFailed)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3">접속 현황을 불러오지 못했습니다. [새로고침]을 눌러 주세요.</MudAlert>
    }
    else
    {
        @* 요약 한 줄 — 막힌 로그인이 있으면 빨간색 *@
        <MudPaper Elevation="0" Outlined="true" Class="pa-3 mb-3">
            <MudText Typo="Typo.body1">
                지금 컴퓨터 사용 <b>@(_status?.PcUsersNow ?? 0)명</b> · 휴대폰 사용 <b>@(_status?.MobileSessionsNow ?? 0)대</b> ·
                <span style="@(_alerts.Count > 0 ? "color:var(--mud-palette-error);font-weight:700;" : "")">막힌 로그인 @(_alerts.Count)건</span>(최근 30일)
            </MudText>
        </MudPaper>

        @* 막힌 로그인 기록 — 「누가 · 언제」만(어느 컴퓨터에서는 재료가 없어 보여 주지 않는다 · 설계 §3-2) *@
        <MudPaper Elevation="0" Outlined="true" Class="pa-3 mb-3">
            <MudText Typo="Typo.subtitle1" Class="mb-2"><b>막힌 로그인 기록</b></MudText>
            @if (_alerts.Count == 0)
            {
                <MudText Typo="Typo.body2">최근 30일 동안 막힌 로그인이 없습니다.</MudText>
            }
            else
            {
                <div style="max-height:180px;overflow-y:auto;">
                    @foreach (var a in _alerts)
                    {
                        <MudText Typo="Typo.body2" Class="mb-1">
                            <span style="color:var(--mud-palette-error);">@a.AtKst.ToString("M/d HH:mm")</span>&nbsp; @a.Message
                        </MudText>
                    }
                </div>
                <MudText Typo="Typo.caption" Class="mt-2">
                    본인이 아니라면 비밀번호를 바꾸거나, 직원 계정 관리에서 그 계정을 [사용 안 함]으로 바꾸세요.
                </MudText>
            }
        </MudPaper>

        @* 지금 접속 중 — 접속 없는 사람은 흐리게 · 맨 아래 · 표 안에서만 스크롤 *@
        <MudPaper Elevation="0" Outlined="true" Class="pa-3 mb-3">
            <MudText Typo="Typo.subtitle1" Class="mb-2"><b>지금 접속 중</b></MudText>
            <MudTable Items="@(_status?.People ?? new List<AccessPersonDto>())" Dense="true" Hover="true"
                      FixedHeader="true" Height="320px" Elevation="0">
                <HeaderContent>
                    <MudTh>이름(아이디)</MudTh>
                    <MudTh>컴퓨터</MudTh>
                    <MudTh>휴대폰</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="이름(아이디)" Style="@(context.LastUsedAtKst is null ? "opacity:0.5;" : "")">
                        @context.UserName@(string.IsNullOrWhiteSpace(context.LoginId) ? "" : "(" + context.LoginId + ")")
                    </MudTd>
                    <MudTd DataLabel="컴퓨터" Style="@(context.LastUsedAtKst is null ? "opacity:0.5;" : "")">
                        @if (context.Pc is null)
                        {
                            <span>사용 안 함</span>
                        }
                        else
                        {
                            <span>@context.Pc.Browser · @Ago(context.Pc.LastActiveAtKst) 사용</span>
                        }
                    </MudTd>
                    <MudTd DataLabel="휴대폰" Style="@(context.LastUsedAtKst is null ? "opacity:0.5;" : "")">
                        @if (context.Mobiles.Count == 0)
                        {
                            <span>사용 안 함</span>
                        }
                        else
                        {
                            <span title="@string.Join(" / ", context.Mobiles.Select(m => m.Browser + " · " + Ago(m.LastActiveAtKst)))">
                                @(context.Mobiles.Count)대 · @Ago(context.Mobiles.Max(m => m.LastActiveAtKst)) 사용
                            </span>
                        }
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2">계정이 없습니다.</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>

        @* 회사 서버(메인 PC) — 표시만 · [메인PC 연결] 은 안내 창만(사장님 E-6) *@
        <MudPaper Elevation="0" Outlined="true" Class="pa-3 mb-3 d-flex align-center" Style="gap:12px;flex-wrap:wrap;">
            <MudIcon Icon="@Icons.Material.Filled.Dns" Color="Color.Primary" />
            <MudText Typo="Typo.body1">
                회사 서버(메인 PC) — <b>@(_mainPcRegistered ? "등록됨" : "확인 중")</b>
                @if (!string.IsNullOrWhiteSpace(_mainPcName))
                {
                    <span> · @_mainPcName</span>
                }
            </MudText>
            <MudSpacer />
            @* 🔵 메인PC 연결 (20260922작2 절F · 사장님 전결 2026-09-22) — 사장님: *"되돌리는 기능도 있어야됨.
                 고객사가 컴퓨터를 새로 구입해서 메인PC를 변경할수도 있으니까"* · 10/5 E-6 「안내 버튼 남김」 *@
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.SwapHoriz"
                       OnClick="@(() => _connectStep = ConnectStep.Ask)">
                메인PC 연결
            </MudButton>
        </MudPaper>
    }
</MudContainer>

@* 🔵 메인PC 연결 안내 창 — 20260922작2 절F 그대로 옮김(서버 쓰기 0). 실제 연결은 새 컴퓨터 로그인 때 MainPcGate 가 한다. *@
@if (_connectStep != ConnectStep.None)
{
    <MudOverlay Visible="true" DarkBackground="true" ZIndex="9000" />
    <div style="position:fixed;inset:0;z-index:9001;display:flex;align-items:center;justify-content:center;padding:16px;">
        <MudPaper Elevation="8" Class="pa-6" Style="max-width:560px;margin:0 auto;">
            <div class="d-flex align-center mb-3">
                <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Color="Color.Primary" Style="font-size:32px;" Class="mr-3" />
                <MudText Typo="Typo.h6">메인PC 연결</MudText>
            </div>

            @if (_connectStep == ConnectStep.Ask)
            {
                <MudText Typo="Typo.body1" Class="mb-4">
                    연결하실 컴퓨터에 <b>히트판이 설치되어 있습니까?</b>
                </MudText>
                <div class="d-flex justify-end" style="gap:8px;">
                    <MudButton Variant="Variant.Text" OnClick="@(() => _connectStep = ConnectStep.None)">닫기</MudButton>
                    <MudButton Variant="Variant.Outlined" OnClick="@(() => _connectStep = ConnectStep.NeedInstall)">아니요</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="@(() => _connectStep = ConnectStep.AlreadyInstalled)">예</MudButton>
                </div>
            }
            else if (_connectStep == ConnectStep.AlreadyInstalled)
            {
                <MudText Typo="Typo.body1" Class="mb-2">
                    <b>그 컴퓨터에서 히트판에 접속해 로그인</b>해 주세요.
                </MudText>
                <MudText Typo="Typo.body2" Class="mb-4">
                    접속하시면 <b>"회사 자료 컴퓨터를 이 컴퓨터로 바꿀까요?"</b> 안내가 뜹니다.
                    <b>[이 컴퓨터로 바꾸기]</b> 를 누르시면 연결이 끝납니다.
                </MudText>
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
                    지금 쓰시던 컴퓨터는 꺼져 있어도 괜찮습니다.
                </MudAlert>
                <div class="d-flex justify-end">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="@(() => _connectStep = ConnectStep.None)">알겠습니다</MudButton>
                </div>
            }
            else
            {
                <MudText Typo="Typo.body1" Class="mb-2">
                    먼저 그 컴퓨터에 <b>히트판을 설치</b>해 주세요.
                </MudText>
                <MudText Typo="Typo.body2" Class="mb-3">
                    아래에서 설치 파일을 받으신 뒤, <b>받은 파일을 한 번 눌러</b> 설치해 주세요.
                    설치가 끝나고 그 컴퓨터에서 로그인하시면 연결 안내가 뜹니다.
                </MudText>
                <MudText Typo="Typo.body2" Class="mb-4">
                    회사 자료는 새 컴퓨터에서 <b>[자료관리 → 자료복구]</b> 로 가져오시면 됩니다.
                </MudText>
                <div class="d-flex justify-end" style="gap:8px;">
                    <MudButton Variant="Variant.Text" OnClick="@(() => _connectStep = ConnectStep.None)">닫기</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Download"
                               OnClick="GoDownloadPage">설치 파일 받으러 가기</MudButton>
                </div>
            }
        </MudPaper>
    </div>
}

@code {
    private enum ConnectStep { None, Ask, AlreadyInstalled, NeedInstall }

    private ConnectStep _connectStep = ConnectStep.None;
    private bool _loading = true;
    private bool _loadFailed;
    private bool _adminOnly;
    private AccessStatusDto? _status;
    private List<LoginConflictAlertDto> _alerts = new();
    private bool _mainPcRegistered;
    private string? _mainPcName;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    /// <summary>읽기만 — 세 길(접속 중 · 막힌 로그인 · 회사 서버 칸). 차례로 부른다(화면 한 번 그리는 데 세 번 · 가벼운 조회).</summary>
    private async Task LoadAsync()
    {
        _loading = true;
        _loadFailed = false;
        _adminOnly = false;
        try
        {
            using var cur = await Http.GetAsync("api/access-status/current");
            if (cur.StatusCode == HttpStatusCode.Forbidden)
            {
                _adminOnly = true;
                return;
            }
            cur.EnsureSuccessStatusCode();
            _status = await cur.Content.ReadFromJsonAsync<AccessStatusDto>();

            _alerts = await Http.GetFromJsonAsync<List<LoginConflictAlertDto>>("api/access-status/alerts") ?? new();

            await LoadMainPcAsync();
        }
        catch (Exception ex)
        {
            // #15 — 빈 catch 금지. 고객에게는 「불러오지 못했습니다」 한 줄.
            _logger.LogWarning(ex, "[접속기기 확인] 접속 현황을 불러오지 못했다.");
            _loadFailed = true;
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>회사 서버 칸 — 기존 <c>GET api/devices</c> 의 IsMainPc 줄(무접촉 · 표시만). 실패해도 위 두 목록은 그대로 보인다.</summary>
    private async Task LoadMainPcAsync()
    {
        try
        {
            var all = await Http.GetFromJsonAsync<List<DeviceRowDto>>("api/devices") ?? new();
            var main = all.FirstOrDefault(d => d.IsMainPc);
            _mainPcRegistered = main is not null;
            _mainPcName = main?.DeviceName;
        }
        catch (Exception ex)
        {
            _logger.LogWarning(ex, "[접속기기 확인] 회사 서버 칸을 읽지 못했다 — 나머지는 그대로 보인다.");
        }
    }

    private static string Ago(DateTime kst)
    {
        var now = DateTime.UtcNow.AddHours(9);
        var d = now - kst;
        if (d.TotalMinutes < 1) return "방금";
        if (d.TotalMinutes < 60) return $"{(int)d.TotalMinutes}분 전";
        if (d.TotalHours < 24) return $"{(int)d.TotalHours}시간 전";
        return kst.ToString("M/d HH:mm");
    }

    /// <summary>설치 파일을 받으러 보낸다 — 랜딩페이지가 배포한다(3시스템 분리 · 20260922작2 절F 그대로).</summary>
    private void GoDownloadPage()
    {
        _connectStep = ConnectStep.None;
        Nav.NavigateTo("https://landing.hitpan.kr", forceLoad: true);
    }

    // ── DTO (서버 응답 매핑용 · HitPan.Application.DTOs.Device.AccessStatusDtos 와 이름·모양을 맞춘다) ──
    private sealed class AccessStatusDto
    {
        public int PcUsersNow { get; set; }
        public int MobileSessionsNow { get; set; }
        public List<AccessPersonDto> People { get; set; } = new();
    }

    private sealed class AccessPersonDto
    {
        public string UserId { get; set; } = "";
        public string UserName { get; set; } = "";
        public string LoginId { get; set; } = "";
        public AccessSessionDto? Pc { get; set; }
        public List<AccessSessionDto> Mobiles { get; set; } = new();
        public DateTime? LastUsedAtKst { get; set; }
    }

    private sealed class AccessSessionDto
    {
        public DateTime LoginAtKst { get; set; }
        public DateTime LastActiveAtKst { get; set; }
        public string Browser { get; set; } = "알 수 없음";
    }

    private sealed class LoginConflictAlertDto
    {
        public DateTime AtKst { get; set; }
        public string UserName { get; set; } = "";
        public string LoginId { get; set; } = "";
        public string Kind { get; set; } = "";
        public string Message { get; set; } = "";
    }

    private sealed class DeviceRowDto
    {
        public string? DeviceName { get; set; }
        public bool IsMainPc { get; set; }
    }
}
