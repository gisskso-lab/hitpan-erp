@page "/settings/ai-assistant"
@namespace HitPan.Web.Pages.SettingsUi
@* 🔴 2026-08-11 (사장님 지시): 설정관리는 **부모계정(대표)만**.
     메뉴에서 감추는 것만으로는 주소를 직접 치면 그대로 들어온다 — 화면에서도 막는다. *@
@attribute [Authorize(Roles = "system_admin,tenant_admin,TenantAdmin")]
@using HitPan.Web.Models
@using HitPan.Web.Services
@inject ChatbotService AiApi
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>AI 도우미 연동</PageTitle>

<PageHeader Title="AI 도우미 연동" Subtitle="연동하면 도우미 기능이 켜집니다 — 회사 보유 키를 안전하게 보관합니다">
</PageHeader>

<MudAlert Severity="Severity.Info" Class="mb-3" Dense="true" Icon="@Icons.Material.Filled.Info">
    @* 🔴 2026-08-11 문구 정정 (사장님 지시 "거짓문구는 모두 삭제").
         종전 문구: "외부로 전송되지 않습니다."
         그런데 키는 도우미를 쓸 때마다 **그 키를 발급한 회사로 전송된다**(그래야 답이 온다).
         원래 뜻은 "**본사(히트판)** 서버로는 안 보낸다" 였고 그것은 사실이다.
         "외부로" 라고 적으니 어디에도 안 간다는 말이 되어 버렸다. 경계를 정확히 적는다. *@
    연동하면 도우미 기능이 켜집니다. 연동 안 하셔도 히트판은 그대로 사용 가능합니다.
    입력하신 키는 이 PC 안에서 암호화되어 보관되며, <b>히트판 본사 서버로는 보내지 않습니다.</b>
    도우미를 쓰실 때 키를 발급한 곳으로만 직접 연결됩니다.
</MudAlert>

@* ── 지금 사용 중인 곳 (2026-08-12 3사 확장) ─────────────────────────────
     사장님 결재 설계: 3사 키를 각각 넣어 두고, 지금 쓸 곳 하나를 고른다.
     한 곳이 장애·한도 초과일 때 키를 다시 넣지 않고 갈아탈 수 있다. *@
<SectionCard Title="지금 사용 중인 곳">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    else if (_loadFailed)
    {
        <LoadFailedState Title="연동 상태를 불러오지 못했습니다"
                         Subtitle="저장된 키가 지워진 것이 아닙니다. 상태를 확인하기 전에는 키를 다시 입력하지 마세요."
                         MinHeight="140px"
                         Retrying="@_busy"
                         OnRetry="ReloadAsync" />
    }
    else
    {
        <MudText Typo="Typo.body2" Class="mb-2" Style="color:var(--mud-palette-text-secondary)">
            도우미가 답할 때 사용할 곳을 하나 고릅니다. 아래 칸에서 각각의 키를 넣어 두시면 언제든 바꿔 쓰실 수 있습니다.
        </MudText>

        <MudRadioGroup T="string" Value="@_activeProvider" ValueChanged="OnActiveProviderChangedAsync">
            @foreach (var p in _settings.Providers)
            {
                <MudRadio T="string" Value="@p.ProviderId" Color="Color.Primary" Disabled="@_busy">
                    @p.DisplayName
                    @if (p.KeyConfigured)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">연동됨</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">미연동</MudChip>
                    }
                </MudRadio>
            }
        </MudRadioGroup>

        @if (_activeStatus is not null && !_activeStatus.KeyConfigured)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-2" Dense="true">
                지금 고르신 @_activeStatus.DisplayName 에 연동 키가 없습니다. 아래에서 키를 넣어 주세요.
            </MudAlert>
        }
    }
</SectionCard>

@* ── 공급자별 연동 키 ───────────────────────────────────────────────── *@
<SectionCard Title="연동 키" Class="mt-3">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
    }
    else if (_loadFailed)
    {
        @* 🔴 못 불러온 것 — "미연결" 과 다른 사실이다.
           미연결이라 단정하면, 키가 멀쩡히 저장돼 있는데도 고객이 키를 다시 붙여넣는다. *@
        <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary)">
            상태를 확인하지 못해 키 입력을 잠시 막았습니다. 위에서 [다시 시도] 를 눌러 주세요.
        </MudText>
    }
    else
    {
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-4">
            @foreach (var p in _settings.Providers)
            {
                <MudTabPanel Text="@p.DisplayName">
                    @if (p.KeyConfigured)
                    {
                        <MudAlert Severity="Severity.Success" Class="mb-3" Dense="true" Icon="@Icons.Material.Filled.CheckCircle">
                            연결됨 (@Masked(p.KeyLast4))
                            @if (p.KeySavedAt is not null)
                            {
                                <span> · 저장: @p.KeySavedAt?.ToString("yyyy-MM-dd HH:mm")</span>
                            }
                            @* 🔴 "저장됨" 과 "실제로 연결해 봤음" 은 다른 사실이다. 구분해서 적는다. *@
                            @if (p.KeyVerifiedAt is not null)
                            {
                                <span> · 연결 확인: @p.KeyVerifiedAt?.ToString("yyyy-MM-dd HH:mm")</span>
                            }
                            else
                            {
                                <span> · <b>아직 연결을 확인하지 않았습니다</b></span>
                            }
                        </MudAlert>
                    }
                    else if (string.Equals(p.KeyStatus, "invalid", StringComparison.OrdinalIgnoreCase))
                    {
                        <MudAlert Severity="Severity.Error" Class="mb-3" Dense="true">
                            연결에 실패한 키입니다. @p.DisplayName 키가 맞는지 확인 후 다시 저장해 주세요.
                        </MudAlert>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Normal" Class="mb-3" Dense="true" Icon="@Icons.Material.Filled.LinkOff">
                            미연결 — 키를 입력하고 저장하면 @p.DisplayName 을(를) 쓸 수 있습니다.
                        </MudAlert>
                    }

                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="8">
                            <MudTextField T="string"
                                          Label="@(p.KeyConfigured ? $"{p.DisplayName} 키 (저장됨 — 변경 시에만 입력)" : $"{p.DisplayName} 키")"
                                          Value="@GetInput(p.ProviderId)"
                                          ValueChanged="@(v => SetInput(p.ProviderId, v))"
                                          Variant="Variant.Outlined" Margin="Margin.Dense"
                                          InputType="InputType.Password"
                                          HelperText="@(p.KeyConfigured ? "비워두면 기존 키 유지" : $"{p.DisplayName} 에서 발급받은 키를 붙여넣으세요")" />
                        </MudItem>
                    </MudGrid>

                    <div class="mt-3">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                                   OnClick="@(() => SaveAsync(p.ProviderId))" Disabled="@_busy">저장</MudButton>
                        <MudButton Class="ml-2" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.NetworkCheck"
                                   OnClick="@(() => CheckAsync(p.ProviderId))" Disabled="@(_busy || !p.KeyConfigured)">연결 확인</MudButton>
                        <MudButton Class="ml-2" Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                                   OnClick="@(() => DeleteAsync(p.ProviderId, p.DisplayName))" Disabled="@(_busy || !p.KeyConfigured)">삭제</MudButton>
                    </div>
                </MudTabPanel>
            }
        </MudTabs>
    }
</SectionCard>

<SectionCard Title="이번 달 사용량" Class="mt-3">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_usage is null)
    {
        @* 사용량을 못 불러온 것 — "사용량 0" 이 아니다. 0으로 보이면 한도가 남은 줄 오해한다. *@
        <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary)">
            사용량을 불러오지 못했습니다. 사용량이 0이라는 뜻은 아닙니다.
        </MudText>
    }
    else
    {
        <MudText Typo="Typo.body2" Class="mb-2">
            @_usage.Ym — 총 @_usage.TotalTokens.ToString("N0") 토큰 사용
            (입력 @_usage.InputTokens.ToString("N0") / 출력 @_usage.OutputTokens.ToString("N0"))
        </MudText>

        @if (_usage.MonthlyLimit > 0)
        {
            <MudProgressLinear Color="@UsageColor()" Value="@UsagePercent()" Class="my-2" Size="Size.Large" Rounded="true" />
            <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)">
                한도 @_usage.MonthlyLimit.ToString("N0") · 잔여 @_usage.Remaining.ToString("N0") 토큰
            </MudText>

            @if (_usage.Remaining <= 0)
            {
                <MudAlert Severity="Severity.Warning" Class="mt-2" Dense="true">이번 달 한도에 도달했습니다.</MudAlert>
            }
            else if (UsagePercent() >= 90)
            {
                <MudAlert Severity="Severity.Warning" Class="mt-2" Dense="true">이번 달 한도에 거의 도달했습니다.</MudAlert>
            }
        }
        else
        {
            <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)">한도 정보가 설정되어 있지 않습니다.</MudText>
        }
    }
</SectionCard>

@code {
    private AiSettingsModel _settings = new();
    private AiUsageModel? _usage;
    private bool _busy;

    // 공급자별 입력칸 — 한 탭에서 친 키가 다른 탭으로 새면 안 된다.
    private readonly Dictionary<string, string?> _keyInputs = new();

    // 지금 고른 공급자(라디오 바인딩용). 서버 값과 분리해 두어야 실패 시 되돌릴 수 있다.
    private string _activeProvider = "anthropic";

    // 연동 설정을 못 불러왔는지 여부. 🔴 "미연결" 과 반드시 구분한다.
    //   종전에는 조회 실패도 새 설정(= 미연결)으로 뭉개서,
    //   키가 멀쩡히 저장돼 있는데도 고객이 키를 다시 붙여넣게 됐다.
    private bool _loadFailed;
    // 첫 조회가 끝나기 전에는 연결/미연결을 단정하지 않는다.
    private bool _loading = true;

    private AiProviderStatusModel? _activeStatus
        => _settings.Providers.FirstOrDefault(p => p.ProviderId == _activeProvider);

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _loadFailed = false;
        try
        {
            var settings = await AiApi.GetAiSettingsAsync();
            if (settings is null)
            {
                // null = 실패. 미연결이 아니다 — 기존 키 상태를 알 수 없으므로 단정하지 않는다.
                _loadFailed = true;
                _settings = new();
            }
            else
            {
                _settings = settings;
                _activeProvider = string.IsNullOrWhiteSpace(settings.AiProvider)
                    ? "anthropic" : settings.AiProvider;
            }

            // 사용량은 부가 정보라 실패해도 화면 전체를 막지 않는다(아래에서 따로 안내).
            _usage = await AiApi.GetUsageAsync();
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private string? GetInput(string providerId)
        => _keyInputs.TryGetValue(providerId, out var v) ? v : null;

    private void SetInput(string providerId, string? value)
        => _keyInputs[providerId] = value;

    // 마스킹 표시 — 끝 4자리만 노출(평문 절대 표시 금지)
    private static string Masked(string? last4)
        => string.IsNullOrEmpty(last4) ? "****" : $"****{last4}";

    private double UsagePercent()
    {
        if (_usage is null || _usage.MonthlyLimit <= 0) return 0;
        var pct = (double)_usage.TotalTokens / _usage.MonthlyLimit * 100.0;
        return Math.Min(100, Math.Max(0, pct));
    }

    private Color UsageColor()
    {
        var p = UsagePercent();
        if (p >= 90) return Color.Error;
        if (p >= 70) return Color.Warning;
        return Color.Primary;
    }

    private async Task OnActiveProviderChangedAsync(string providerId)
    {
        if (string.IsNullOrWhiteSpace(providerId) || providerId == _activeProvider) return;

        var previous = _activeProvider;
        _activeProvider = providerId;   // 먼저 반영해 화면이 즉시 따라오게 한다

        _busy = true;
        try
        {
            var ok = await AiApi.SetActiveProviderAsync(providerId);
            if (ok)
            {
                var name = _settings.Providers.FirstOrDefault(p => p.ProviderId == providerId)?.DisplayName ?? providerId;
                Snackbar.Add($"{name} 을(를) 사용하도록 변경했습니다.", Severity.Success);
                await ReloadAsync();
            }
            else
            {
                // 🔴 저장 실패했는데 화면만 바뀌어 있으면 고객은 바뀐 줄 안다. 되돌린다.
                _activeProvider = previous;
                Snackbar.Add("사용할 곳을 변경하지 못했습니다.", Severity.Error);
            }
        }
        finally { _busy = false; }
    }

    private async Task SaveAsync(string providerId)
    {
        var input = GetInput(providerId);
        if (string.IsNullOrWhiteSpace(input))
        {
            Snackbar.Add("연동 키를 입력하세요.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            // 🔴 저장 실패 사유를 그대로 전달한다. "저장에 실패했습니다" 한 줄만 보여주면
            //    무엇을 고쳐야 할지 알 수 없어 고객이 같은 키를 반복해서 붙여넣게 된다.
            var (ok, error) = await AiApi.SaveApiKeyAsync(providerId, input.Trim());
            if (ok)
            {
                Snackbar.Add("연동 키가 저장되었습니다. [연결 확인] 을 눌러 실제로 연결되는지 확인해 보세요.", Severity.Success);
                _keyInputs[providerId] = null; // 저장 후 입력칸 비움 — 다음엔 변경 시에만 입력
                await ReloadAsync();
            }
            else
            {
                Snackbar.Add(string.IsNullOrWhiteSpace(error) ? "저장하지 못했습니다." : error, Severity.Error);
            }
        }
        finally { _busy = false; }
    }

    // 🔴 실제로 연결해 본다 (2026-08-12 봉합, 20260812작1 §2-3).
    //    종전에는 DB 를 다시 읽어 "설정되어 있습니다" 라고만 답해서 틀린 키도 통과했다.
    private async Task CheckAsync(string providerId)
    {
        _busy = true;
        try
        {
            var result = await AiApi.CheckConnectionAsync(providerId);
            if (result is null)
            {
                // 통신 자체가 안 된 것 — "키가 틀렸다" 와 구분해서 안내한다.
                Snackbar.Add("연결을 확인하지 못했습니다. 잠시 후 다시 시도해주세요.", Severity.Warning);
                return;
            }

            Snackbar.Add(result.Message, result.Succeeded ? Severity.Success : Severity.Error);
            await ReloadAsync();
        }
        finally { _busy = false; }
    }

    private async Task DeleteAsync(string providerId, string displayName)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "연동 해제",
            $"{displayName} 연동 키를 삭제합니다. 다른 곳의 키는 그대로 남습니다. 계속할까요?",
            yesText: "삭제", cancelText: "취소");
        if (confirm != true) return;

        _busy = true;
        try
        {
            var ok = await AiApi.DeleteApiKeyAsync(providerId);
            Snackbar.Add(ok ? "연동 키가 삭제되었습니다." : "삭제에 실패했습니다.", ok ? Severity.Success : Severity.Error);
            if (ok) await ReloadAsync();
        }
        finally { _busy = false; }
    }
}
