@page "/settings/ai-assistant"
@namespace HitPan.Web.Pages.SettingsUi
@attribute [Authorize]
@using HitPan.Web.Models
@using HitPan.Web.Services
@inject ChatbotService AiApi
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>AI 도우미 연동</PageTitle>

<PageHeader Title="AI 도우미 연동" Subtitle="연동하면 도우미 기능이 켜집니다 — 회사 보유 키를 안전하게 보관합니다">
</PageHeader>

<MudAlert Severity="Severity.Info" Class="mb-3" Dense="true" Icon="@Icons.Material.Filled.Info">
    연동하면 도우미 기능이 켜집니다. 연동 안 하셔도 히트판은 그대로 사용 가능합니다.
    입력하신 키는 이 PC 안에서 암호화되어 보관되며, 외부로 전송되지 않습니다.
</MudAlert>

<SectionCard Title="연동 키">
    @if (_settings.KeyConfigured)
    {
        <MudAlert Severity="Severity.Success" Class="mb-3" Dense="true" Icon="@Icons.Material.Filled.CheckCircle">
            연결됨 (@MaskedKey())
            @if (_settings.KeySavedAt is not null)
            {
                <span> · 저장: @_settings.KeySavedAt?.ToString("yyyy-MM-dd HH:mm")</span>
            }
        </MudAlert>
    }
    else
    {
        <MudAlert Severity="Severity.Normal" Class="mb-3" Dense="true" Icon="@Icons.Material.Filled.LinkOff">
            미연결 — 키를 입력하고 저장하면 도우미 기능이 켜집니다.
        </MudAlert>
    }

    <MudGrid Spacing="2">
        <MudItem xs="12" md="8">
            <MudTextField T="string" Label="@(_settings.KeyConfigured ? "연동 키 (저장됨 — 변경 시에만 입력)" : "연동 키")"
                          @bind-Value="_keyInput" Variant="Variant.Outlined" Margin="Margin.Dense"
                          InputType="InputType.Password"
                          HelperText="@(_settings.KeyConfigured ? "비워두면 기존 키 유지" : "회사 보유 키를 붙여넣으세요")" />
        </MudItem>
    </MudGrid>

    <div class="mt-3">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                   OnClick="SaveAsync" Disabled="@_busy">저장</MudButton>
        <MudButton Class="ml-2" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.NetworkCheck"
                   OnClick="CheckAsync" Disabled="@(_busy || !_settings.KeyConfigured)">연결 확인</MudButton>
        <MudButton Class="ml-2" Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                   OnClick="DeleteAsync" Disabled="@(_busy || !_settings.KeyConfigured)">삭제</MudButton>
    </div>
</SectionCard>

<SectionCard Title="이번 달 사용량" Class="mt-3">
    @if (_usage is null)
    {
        <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary)">사용량 정보를 불러올 수 없습니다.</MudText>
    }
    else
    {
        <MudText Typo="Typo.body2" Class="mb-2">
            @_usage.Ym — 총 @_usage.TotalTokens.ToString("N0") 토큰 사용
            (입력 @_usage.InputTokens.ToString("N0") / 출력 @_usage.OutputTokens.ToString("N0"))
        </MudText>

        @if (_usage.MonthlyLimit > 0)
        {
            <MudProgressLinear Color="@UsageColor()" Value="@UsagePercent()" Class="my-2" Size="Size.Large" Rounded="true" />
            <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)">
                한도 @_usage.MonthlyLimit.ToString("N0") · 잔여 @_usage.Remaining.ToString("N0") 토큰
            </MudText>

            @if (_usage.Remaining <= 0)
            {
                <MudAlert Severity="Severity.Warning" Class="mt-2" Dense="true">이번 달 한도에 도달했습니다.</MudAlert>
            }
            else if (UsagePercent() >= 90)
            {
                <MudAlert Severity="Severity.Warning" Class="mt-2" Dense="true">이번 달 한도에 거의 도달했습니다.</MudAlert>
            }
        }
        else
        {
            <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)">한도 정보가 설정되어 있지 않습니다.</MudText>
        }
    }
</SectionCard>

@code {
    private AiSettingsModel _settings = new();
    private AiUsageModel? _usage;
    private string? _keyInput;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _settings = await AiApi.GetAiSettingsAsync() ?? new();
        _usage = await AiApi.GetUsageAsync();
        StateHasChanged();
    }

    // 마스킹 표시 — 끝 4자리만 노출(평문 절대 표시 금지)
    private string MaskedKey()
        => string.IsNullOrEmpty(_settings.KeyLast4) ? "****" : $"****{_settings.KeyLast4}";

    private double UsagePercent()
    {
        if (_usage is null || _usage.MonthlyLimit <= 0) return 0;
        var pct = (double)_usage.TotalTokens / _usage.MonthlyLimit * 100.0;
        return Math.Min(100, Math.Max(0, pct));
    }

    private Color UsageColor()
    {
        var p = UsagePercent();
        if (p >= 90) return Color.Error;
        if (p >= 70) return Color.Warning;
        return Color.Primary;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_keyInput))
        {
            Snackbar.Add("연동 키를 입력하세요.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var ok = await AiApi.SaveApiKeyAsync(_keyInput.Trim());
            Snackbar.Add(ok ? "연동 키가 저장되었습니다." : "저장에 실패했습니다.", ok ? Severity.Success : Severity.Error);
            if (ok)
            {
                _keyInput = null; // 저장 후 입력칸 비움 — 다음엔 변경 시에만 입력
                await ReloadAsync();
            }
        }
        finally { _busy = false; }
    }

    private async Task CheckAsync()
    {
        _busy = true;
        try
        {
            // 현재 상태 재조회로 연결 여부 확인 (실제 외부 호출 검증은 Phase B)
            await ReloadAsync();
            Snackbar.Add(_settings.KeyConfigured ? "연동 키가 설정되어 있습니다." : "연동 키가 설정되어 있지 않습니다.",
                _settings.KeyConfigured ? Severity.Success : Severity.Warning);
        }
        finally { _busy = false; }
    }

    private async Task DeleteAsync()
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "연동 해제",
            "연동 키를 삭제하면 도우미 기능이 꺼집니다. 계속할까요?",
            yesText: "삭제", cancelText: "취소");
        if (confirm != true) return;

        _busy = true;
        try
        {
            var ok = await AiApi.DeleteApiKeyAsync();
            Snackbar.Add(ok ? "연동 키가 삭제되었습니다." : "삭제에 실패했습니다.", ok ? Severity.Success : Severity.Error);
            if (ok) await ReloadAsync();
        }
        finally { _busy = false; }
    }
}
