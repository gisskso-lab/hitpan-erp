@page "/settings/approval-lines"
@namespace HitPan.Web.Pages.SettingsUi
@attribute [Authorize]
@using HitPan.Web.Models
@using HitPan.Web.Services
@* 보기 전용이 되면서 직급·사원 목록과 알림창이 필요 없어져 주입을 걷어냈다.
   직급·사원은 결재 단계를 고를 때만 쓰던 것이고, 이제 고르는 화면이 없다. *@
@inject ApprovalLineService LineSvc
@inject NavigationManager Nav

@* 사장님 결재(2026-08-09) "통일": 이 화면은 더 이상 쓰지 않는다.
   여기서 저장하던 결재라인은 실제 결재 흐름이 읽지 않는 별도 표에 들어가, 아무리 채워 넣어도
   결재가 걸리지 않았다. 결재라인은 [결재 설정] 한 곳에서만 관리한다.
   화면과 주소를 지우지 않고 남긴 이유 — 즐겨찾기·주소 직접 입력으로 들어오는 사람에게
   갑자기 없는 화면이 뜨면 더 혼란스럽다. 대신 위에 안내를 띄우고 보기 전용으로 둔다.
   기존에 넣어둔 내용을 눈으로 확인해 [결재 설정]에 옮겨 적을 수 있어야 하므로 목록은 그대로 보여준다. *@

<PageTitle>결재라인 설정(사용하지 않음)</PageTitle>

<MudAlert Severity="Severity.Warning" Class="mb-4" Icon="@Icons.Material.Filled.Info">
    <MudText Typo="Typo.subtitle2" Style="font-weight:700">이 화면은 더 이상 사용하지 않습니다.</MudText>
    <MudText Style="font-size:13px;margin-top:4px">
        여기에 넣은 결재라인은 실제 결재에 적용되지 않습니다.
        결재라인은 [결재 설정] 화면에서 문서 종류별로 지정해 주세요.
        아래 목록은 예전에 넣어둔 내용을 확인하시라고 보기 전용으로 남겨 둔 것입니다.
    </MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="mt-3"
               StartIcon="@Icons.Material.Filled.Rule" OnClick="GoToApprovalSettings">
        결재 설정으로 이동
    </MudButton>
</MudAlert>

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
    <MudText Typo="Typo.h6">결재라인 설정(사용하지 않음)</MudText>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    @if (_lines.Count == 0)
    {
        <MudPaper Elevation="0" Class="pa-6" Style="border:0.5px dashed var(--mud-palette-lines-default);border-radius:12px;text-align:center;color:var(--mud-palette-text-secondary)">
            여기에 남아 있는 내용이 없습니다. 결재라인은 [결재 설정] 화면에서 지정해 주세요.
        </MudPaper>
    }
    else
    {
        @foreach (var line in _lines)
        {
            <MudPaper Elevation="0" Class="pa-4 mb-3" Style="border:0.5px solid var(--mud-palette-lines-default);border-radius:12px">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
                    <div style="display:flex;gap:12px;align-items:baseline">
                        <MudText Typo="Typo.subtitle1" Style="font-weight:700">@line.Name</MudText>
                        <MudText Style="font-size:12px;color:var(--mud-palette-text-secondary)">
                            단계 @(line.StepCount)개 @(line.IsActive ? "" : " · 비활성")
                        </MudText>
                    </div>
                    @* 보기 전용 — 편집·삭제 단추를 없앴다. 이 표를 고쳐 봐야 결재에 반영되지 않아
                       "고쳤는데 왜 안 되나" 로 이어진다. 대신 내용을 눈으로 확인할 수 있게
                       예전엔 편집 창에서만 보이던 단계 목록을 아래에 펼쳐 둔다. *@
                </div>

                @* 단계 내용 — [결재 설정]에 옮겨 적을 때 보고 쓰시라고 펼쳐서 보여준다. *@
                @if (_steps.TryGetValue(line.ApprovalLineId, out var steps) && steps.Count > 0)
                {
                    <MudTable Items="steps" Dense="true" Hover="false" Bordered="false" Elevation="0">
                        <HeaderContent>
                            <MudTh Style="width:60px">순번</MudTh>
                            <MudTh Style="width:200px">직급</MudTh>
                            <MudTh>담당자</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.StepOrder</MudTd>
                            <MudTd>@(string.IsNullOrWhiteSpace(context.PositionName) ? "-" : context.PositionName)</MudTd>
                            <MudTd>@(string.IsNullOrWhiteSpace(context.EmployeeName) ? "-" : context.EmployeeName)</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
                else
                {
                    <MudText Style="font-size:12px;color:var(--mud-palette-text-secondary)">단계 내용이 없습니다.</MudText>
                }
            </MudPaper>
        }
    }
}


@code {
    // 보기 전용 화면이다. 이 화면이 쓰던 표는 실제 결재 흐름이 읽지 않으므로
    // 추가·편집·삭제 기능을 모두 걷어냈다(사장님 결재 2026-08-09 "통일").
    // 남은 것은 예전에 넣어둔 내용을 확인하기 위한 조회뿐이다.
    private List<ApprovalLineListItemModel> _lines = new();

    // 결재라인별 단계 내용. 예전엔 편집 창을 열어야만 보였는데, 편집 창을 없앴으므로
    // 목록에 펼쳐 보여주려고 미리 읽어 둔다.
    private Dictionary<string, List<ApprovalLineStepModel>> _steps = new();

    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _lines = await LineSvc.GetListAsync();

        // 단계 내용은 결재라인 하나씩 읽어 온다. 이 화면은 더 이상 쓰지 않는 화면이라
        // 건수가 늘어날 일이 없고, 목록도 회사당 몇 건 수준이다.
        var steps = new Dictionary<string, List<ApprovalLineStepModel>>();
        foreach (var line in _lines)
        {
            var detail = await LineSvc.GetAsync(line.ApprovalLineId);
            if (detail is not null)
            {
                steps[line.ApprovalLineId] = detail.Steps.OrderBy(s => s.StepOrder).ToList();
            }
        }
        _steps = steps;

        _loading = false;
    }

    private void GoToApprovalSettings()
    {
        Nav.NavigateTo("/settings/approval");
    }
}
