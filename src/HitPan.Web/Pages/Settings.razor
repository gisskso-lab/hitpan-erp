@page "/settings"
@* 🔴 2026-08-11 (사장님 지시): 설정관리는 **부모계정(대표)만**.
     메뉴에서 감추는 것만으로는 주소를 직접 치면 그대로 들어온다 — 화면에서도 막는다. *@
@attribute [Authorize(Roles = "system_admin,tenant_admin,TenantAdmin")]
@using HitPan.Web.Components.Common
@inject SettingsService SettingsSvc
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>사용환경 설정</PageTitle>

<MudText Typo="Typo.h6"
    Class="mb-4">사용환경 설정</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true"
        Color="Color.Primary" />
}
else if (_loadFailed)
{
    @* 🔴 조회 실패 시 화면을 아예 안 그린다 (병렬이슈 08 봉합 · 사장님 결재 작4 ③번).
       종전에는 실패해도 하드코딩 기본값을 진짜 설정처럼 보여줬다.
       거기서 저장을 누르면 27개 컬럼이 ON DUPLICATE KEY UPDATE 로 전부 덮어써져
       단가 배율·여신 한도·마이너스 재고 정책이 조용히 초기화됐다. 되돌릴 수 없다.
       ⇒ 못 불러왔으면 보여주지도, 저장하지도 않는다. *@
    <LoadFailedState Title="설정을 불러오지 못했습니다"
                     Subtitle="지금 저장하면 기존 설정이 잘못 덮어써질 수 있어, 설정 화면을 열지 않았습니다. 연결이 회복된 뒤 다시 시도해주세요."
                     Retrying="@_loading"
                     OnRetry="LoadAsync" />
}
else
{
<MudGrid Spacing="3">

  @* 재고 설정 카드 *@
  <MudItem xs="12" md="4">
  <MudPaper Elevation="0" Class="pa-4"
    Style="border:0.5px solid var(
      --mud-palette-lines-default);
      border-radius:12px">
    <div style="display:flex;
      align-items:center;gap:8px;
      margin-bottom:16px">
      <div style="width:8px;height:8px;
        border-radius:50%;
        background:var(--hitpan-dot-green)"></div>
      <MudText Typo="Typo.subtitle2">
        재고 설정</MudText>
      <MudChip T="string" Size="Size.Small"
        Color="Color.Success"
        Variant="Variant.Text">핵심</MudChip>
    </div>

    <MudText Typo="Typo.caption"
      Style="color:var(--mud-palette-text-secondary)"
      Class="mb-2">재고 평가방법</MudText>
    <MudRadioGroup T="string"
      Value="@_s.StockEvalMethod"
      ValueChanged="OnStockEvalMethodChanged"
      Class="mb-3">
      <MudRadio Value="@("moving_avg")"
        Color="Color.Primary"
        Dense="true">이동평균법</MudRadio>
      @* 🔴 2026-08-11 병행 표기 (사장님 지시):
           이 화면은 레거시 히트판 것을 그대로 가져왔다. 전환 고객은 "표준단가" 라는 말로
           10년 넘게 일해 왔으므로 **앞에 그대로 둔다.**
           다만 회계에서 "표준단가" 는 원가 용어라, 처음 쓰는 사람이나 세무사와 이야기할 때는
           "총평균법" 이 통한다(ERP 매니저 판정). ⇒ 괄호로 함께 적는다. *@
      <MudRadio Value="@("standard")"
        Color="Color.Primary"
        Dense="true">표준단가 (총평균법)</MudRadio>
      <MudRadio Value="@("last_purchase")"
        Color="Color.Primary"
        Dense="true">최종매입가</MudRadio>
    </MudRadioGroup>

    @if (_stockMethodChanged)
    {
      @* 🔴 2026-08-11 문구 정정 (사장님 지시 "거짓문구는 모두 삭제"):
           "변경시 전체 재고가 재계산됩니다" 라고 적혀 있었으나 재계산하는 코드가 없다.
           그렇다고 안내를 통째로 지우면 고객이 아무것도 모른 채 바꾸게 된다.
           ⇒ 지금 실제로 일어나는 일을 그대로 적는다. *@
      <MudAlert Severity="Severity.Warning"
        Dense="true" Class="mb-3"
        Style="font-size:12px">
        바꾸면 앞으로 들어오는 자료부터 이 방법으로 계산됩니다. 이미 쌓인 자료는 그대로입니다.
      </MudAlert>
    }

    <MudDivider Class="mb-3" />

    <SettingToggleRow
      Label="다중창고 사용"
      Sub="창고별 재고 분리 관리"
      @bind-Value="_s.UseMultiWarehouse" />
    @* 🔴 2026-08-11 삭제 — "재고부족 경고" 스위치 (사장님 판단):
         *"굳이 필요 없을 것 같기도 해. **상품마스터에 이미 기능이 있고, 더 나아가서
           자동발주까지 됨**"*
         실측으로 확인했다 — 부족 알림은 상품마스터의 **안전재고**와 **자동발주 사용**을 보고
         뜬다(SalesService.GetAutoOrderCandidatesAsync). 품목마다 다르게 정할 수 있고
         부족하면 발주까지 이어진다. 이 화면의 켬/끔 하나가 그것을 덮는 것은 맞지 않다.
         ⇒ 품목별로 정하는 쪽이 맞다. 여기서는 뺀다.
         ⚠️ 값(StockShortageAlert)은 지우지 않고 남긴다 — 되살릴 일이 생기면 그때 다시 쓴다. *@
    <SettingToggleRow
      Label="마이너스 재고 허용"
      Sub="재고 없어도 출고 가능"
      @bind-Value="_s.AllowMinusStock" />
  </MudPaper>
  </MudItem>

  @* 단가·부가세 카드 *@
  <MudItem xs="12" md="4">
  <MudPaper Elevation="0" Class="pa-4"
    Style="border:0.5px solid var(
      --mud-palette-lines-default);
      border-radius:12px">
    <div style="display:flex;
      align-items:center;gap:8px;
      margin-bottom:16px">
      <div style="width:8px;height:8px;
        border-radius:50%;
        background:var(--hitpan-dot-blue)"></div>
      <MudText Typo="Typo.subtitle2">
        단가·부가세 설정</MudText>
      <MudChip T="string" Size="Size.Small"
        Color="Color.Info"
        Variant="Variant.Text">핵심</MudChip>
    </div>

    <MudText Typo="Typo.caption"
      Style="color:var(--mud-palette-text-secondary)"
      Class="mb-2">부가세 처리방식</MudText>
    <MudRadioGroup T="string"
      @bind-Value="_s.PriceInputType"
      Class="mb-3">
      @* 🔴 2026-08-11 병행 표기 (사장님 지시).
           레거시 히트판 용어 "순단가 / 포함단가" 를 **그대로 앞에 둔다** — 전환 고객이
           쓰던 말이다. 다만 이 항목은 잘못 고르면 **청구 금액이 10% 틀어지는** 자리인데
           (10만원 팔고 11만원 청구하거나 9만 909원만 청구),
           현장에서는 "별도예요? 포함이에요?" 라고 말한다(ERP 매니저 판정).
           ⇒ 괄호로 실제로 무엇을 넣는 것인지 함께 적는다. *@
      <MudRadio Value="@("net")"
        Color="Color.Primary"
        Dense="true">순단가 입력 (부가세 별도 · 공급가액으로 입력)</MudRadio>
      <MudRadio Value="@("inclusive")"
        Color="Color.Primary"
        Dense="true">포함단가 입력 (부가세 포함 · 받을 금액으로 입력)</MudRadio>
    </MudRadioGroup>

    <MudDivider Class="mb-3" />

    @* 🔴 2026-08-11 설명 보강 (사장님 지시 — 레거시 이름은 그대로 둔다).
         "부가세 자동조정 안함" 은 **켜면 안 하게 되는** 이름이라, 처음 보는 사람은
         켠 쪽이 자동인지 수동인지 3초 안에 판단하지 못한다(ERP 매니저 판정).
         전환 고객이 쓰던 이름이라 바꾸지 않고, **켰을 때 무슨 일이 생기는지**를 설명에 적는다. *@
    <SettingToggleRow
      Label="부가세 자동조정 안함"
      Sub="켜면 — 부가세를 손으로 넣습니다 (자동 계산 안 함)"
      @bind-Value="_autoVatOff" />
    @* 끝전은 껐을 때 무엇이 되는지가 화면에 없었다. 켬/끔 양쪽을 다 적는다. *@
    <SettingToggleRow
      Label="끝전 반올림"
      Sub="켜면 반올림 · 끄면 버림 (부가세 원 단위)"
      @bind-Value="_vatRound" />

    <MudDivider Class="mb-3" />

    <MudText Typo="Typo.caption"
      Style="color:var(--mud-palette-text-secondary)"
      Class="mb-2">단가 등급 배율</MudText>
    @foreach (var grade in _priceGrades)
    {
      <div style="display:flex;
        align-items:center;gap:8px;
        margin-bottom:6px">
        <MudText Style="font-size:12px;
          width:40px;color:var(
          --mud-palette-text-secondary)">
          @grade.Label</MudText>
        @* 🔴 2026-08-11 안전장치 (ERP 매니저 지적):
             종전에는 아무 숫자나 넣을 수 있는 칸이었다. `1.1` 을 넣으려다 `11` 을 넣으면
             **10배짜리 청구서**가 나간다. 실제로 동종 프로그램에서 퍼센트로 착각해 `115` 를
             넣어 그날 견적서가 전부 115배로 나간 일이 있었다.
             거래처 전화를 받고서야 알게 되는 종류의 사고다.
             ⇒ 0.1 ~ 10 배 밖은 아예 못 넣게 한다. 그 밖의 배율은 현실에 없다. *@
        <MudNumericField
          T="decimal"
          @bind-Value="grade.Rate"
          Min="0.1m" Max="10m" Step="0.05m"
          Variant="Variant.Outlined"
          Margin="Margin.Dense"
          Style="font-size:12px"
          AdornmentText="배"
          Adornment="Adornment.End" />
      </div>
    }
  </MudPaper>
  </MudItem>

  @* 판매·미수금 카드 *@
  <MudItem xs="12" md="4">
  <MudPaper Elevation="0" Class="pa-4"
    Style="border:0.5px solid var(
      --mud-palette-lines-default);
      border-radius:12px">
    <div style="display:flex;
      align-items:center;gap:8px;
      margin-bottom:16px">
      <div style="width:8px;height:8px;
        border-radius:50%;
        background:var(--hitpan-dot-amber)"></div>
      <MudText Typo="Typo.subtitle2">
        판매·미수금 설정</MudText>
    </div>

    <SettingToggleRow
      Label="미수금 출고정지"
      Sub="미수금 초과시 출고 차단"
      @bind-Value="_s.UseCreditLimit" />

    @if (_s.UseCreditLimit)
    {
      <MudNumericField
        T="decimal"
        @bind-Value="_s.CreditLimitAmount"
        Label="기준 금액 (원)"
        Variant="Variant.Outlined"
        Margin="Margin.Dense"
        Class="mb-3"
        Format="N0" />
    }

    <MudDivider Class="mb-3" />

    <SettingToggleRow
      Label="매입가 표시"
      Sub="상품조회창에 매입가 노출"
      @bind-Value="_s.ShowPurchasePrice" />
    <SettingToggleRow
      Label="담당자별 매출관리"
      Sub="사원별 실적 집계"
      @bind-Value="_s.UseSalesByEmployee" />
  </MudPaper>
  </MudItem>

  @* 강제 수동 설정 카드 *@
  <MudItem xs="12" md="6">
  <MudPaper Elevation="0" Class="pa-4"
    Style="border:0.5px solid var(
      --mud-palette-lines-default);
      border-radius:12px">
    <div style="display:flex;
      align-items:center;gap:8px;
      margin-bottom:4px">
      <div style="width:8px;height:8px;
        border-radius:50%;
        background:var(--hitpan-dot-red)"></div>
      <MudText Typo="Typo.subtitle2">
        강제 수동 설정</MudText>
      <MudChip T="string" Size="Size.Small"
        Color="Color.Error"
        Variant="Variant.Text">관리자 전용</MudChip>
    </div>
    @* 🔴 2026-08-11 삭제 (사장님 지시 "거짓문구는 모두 삭제"):
         여기 "모든 강제 수정은 이력이 기록됩니다" 라고 적혀 있었다.
         그런데 기록하는 함수(LogForceEditAsync)를 부르는 곳이 한 군데도 없어서
         실제로는 아무것도 안 쌓인다. 고객이 그 문장을 믿고 일하는 것이 더 위험하다.
         기록이 실제로 되기 시작하면 그때 다시 적는다. *@

    <SettingToggleRow
      Label="단가 직접 입력 허용"
      Sub="자동계산 무시하고 직접 입력"
      @bind-Value="_s.AllowForcePriceInput" />
    <SettingToggleRow
      Label="부가세 직접 입력 허용"
      Sub="부가세 강제 수동 입력"
      @bind-Value="_s.AllowForceVatInput" />
    <SettingToggleRow
      Label="0원 단가 허용"
      Sub="무상제공·샘플 출고시"
      @bind-Value="_s.AllowZeroPrice" />
    <SettingToggleRow
      Label="이전자료 수정 허용"
      Sub="마감 이후 자료 수정 가능"
      @bind-Value="_s.AllowPastEdit" />
    <SettingToggleRow
      Label="재고 강제 조정 허용"
      Sub="재고실사 후 수량 강제 변경"
      @bind-Value="_s.AllowForceStockAdjust" />
    <SettingToggleRow
      Label="미수금 출고정지 임시해제"
      Sub="관리자가 건별 임시 해제"
      @bind-Value="_s.AllowCreditOverride" />

    <MudDivider Class="mb-3 mt-2" />

    <SettingToggleRow
      Label="강제수정 시 암호 확인"
      Sub="강제 수정 전 관리자 암호 재확인"
      @bind-Value="_s.ForceEditRequirePassword" />

    <div style="display:flex;
      align-items:center;gap:8px;
      margin-top:8px">
      <MudText Style="font-size:12px;
        color:var(--mud-palette-text-secondary)">
        단가 허용 편차</MudText>
      <MudNumericField
        T="int"
        @bind-Value="_s.PriceDeviationLimit"
        Variant="Variant.Outlined"
        Margin="Margin.Dense"
        Style="width:80px;font-size:12px"
        AdornmentText="%"
        Adornment="Adornment.End" />
      <MudText Style="font-size:11px;
        color:var(--mud-palette-text-secondary)">
        초과시 경고</MudText>
    </div>
  </MudPaper>
  </MudItem>

  @* 보안 설정 카드 *@
  <MudItem xs="12" md="6">
  <MudPaper Elevation="0" Class="pa-4"
    Style="border:0.5px solid var(
      --mud-palette-lines-default);
      border-radius:12px">
    <div style="display:flex;
      align-items:center;gap:8px;
      margin-bottom:16px">
      <div style="width:8px;height:8px;
        border-radius:50%;
        background:var(--hitpan-dot-purple)"></div>
      <MudText Typo="Typo.subtitle2">
        보안 설정</MudText>
    </div>

    <SettingToggleRow
      Label="개인정보 보호"
      Sub="민감정보 마스킹 처리"
      @bind-Value="_s.UsePersonalInfoProtect" />

  </MudPaper>
  </MudItem>

</MudGrid>

@* 저장 버튼 *@
<div style="display:flex;
  justify-content:flex-end;
  gap:8px;margin-top:20px">
  <MudButton Variant="Variant.Outlined"
    OnClick="Reset">초기화</MudButton>
  <MudButton Variant="Variant.Filled"
    Color="Color.Primary"
    OnClick="Save"
    Disabled="_saving">
    @(_saving ? "저장 중..." : "저장")
  </MudButton>
</div>
}

@code {
    private TenantSettingsModel _s = new();
    private bool _loading = true;
    private bool _saving = false;
    private bool _stockMethodChanged = false;
    private string _originalStockMethod = "";
    private bool _autoVatOff = false;
    private bool _vatRound = true;

    private List<PriceGradeModel> _priceGrades = new();

    // 🔴 설정을 못 불러왔는지 여부 (병렬이슈 08 · 사장님 결재 작4 ③번).
    //   이 값이 true 면 화면을 그리지 않는다 — 저장 경로 자체를 막기 위해서다.
    //   종전에는 실패해도 하드코딩 기본값(new TenantSettingsModel())이 진짜 설정처럼 보였고,
    //   저장 시 서버가 ON DUPLICATE KEY UPDATE 로 27개 컬럼을 통째로 덮어썼다.
    private bool _loadFailed;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync().ConfigureAwait(false);
    }

    /// <summary>
    /// 설정을 조회한다. "다시 시도" 버튼도 이 메서드를 그대로 부른다.
    /// </summary>
    private async Task LoadAsync()
    {
        _loading = true;
        _loadFailed = false;
        try
        {
            var result = await SettingsSvc.GetAsync().ConfigureAwait(false);
            if (result is null)
            {
                // null = 실패. 기본값으로 화면을 그리면 그 값이 저장되어 실제 설정을 덮어쓴다.
                _loadFailed = true;
                return;
            }

            _s = result;
            _originalStockMethod = _s.StockEvalMethod;
            _autoVatOff = !_s.AutoVatAdjust;
            _vatRound = _s.VatRoundType == "round";

            _priceGrades = new List<PriceGradeModel>
            {
                new("A단가", _s.PriceARate),
                new("B단가", _s.PriceBRate),
                new("C단가", _s.PriceCRate),
                new("D단가", _s.PriceDRate),
                new("E단가", _s.PriceERate),
            };
        }
        catch (Exception ex)
        {
            _loadFailed = true;
            Snackbar.Add($"설정을 불러오지 못했습니다: {ex.Message}", Severity.Error);
        }
        finally
        {
            // 예외가 나도 진행바가 영원히 돌지 않게 한다.
            _loading = false;
        }
    }

    private Task OnStockEvalMethodChanged(string v)
    {
        _s.StockEvalMethod = v;
        _stockMethodChanged = _s.StockEvalMethod != _originalStockMethod;
        return Task.CompletedTask;
    }

    private async Task Save()
    {
        if (_stockMethodChanged)
        {
            var confirm = await DialogService
                .ShowMessageBoxAsync(
                    "재고 평가방법 변경",
                    // 🔴 2026-08-11 문구 정정 (사장님 지시 "거짓문구는 모두 삭제").
                    //   "변경시 전체 재고가 재계산됩니다" 라고 물었으나 재계산하는 코드가 없다.
                    //   위 알림(:80)만 고치고 **이 확인창을 빠뜨렸다** — 고객이 반드시 보는 자리는
                    //   알림이 아니라 여기다. 지금 실제로 일어나는 일을 그대로 묻는다.
                    "앞으로 들어오는 자료부터 이 방법으로 계산됩니다. " +
                    "이미 쌓인 자료는 그대로입니다. 계속하시겠습니까?",
                    yesText: "확인",
                    cancelText: "취소");
            if (confirm != true)
            {
                return;
            }
        }

        _s.AutoVatAdjust = !_autoVatOff;
        _s.VatRoundType = _vatRound ? "round" : "truncate";
        _s.PriceARate = _priceGrades[0].Rate;
        _s.PriceBRate = _priceGrades[1].Rate;
        _s.PriceCRate = _priceGrades[2].Rate;
        _s.PriceDRate = _priceGrades[3].Rate;
        _s.PriceERate = _priceGrades[4].Rate;

        _saving = true;
        var ok = await SettingsSvc.SaveAsync(_s).ConfigureAwait(false);
        _saving = false;

        if (ok)
        {
            _originalStockMethod = _s.StockEvalMethod;
            _stockMethodChanged = false;
            Snackbar.Add(
                "설정이 저장됐습니다.",
                Severity.Success);
        }
        else
        {
            // 🔴 저장에 실패했으면 화면도 서버 상태로 되돌린다 (작4 ③번).
            //   종전에는 실패 토스트만 띄우고 바뀐 값을 화면에 그대로 뒀다.
            //   토스트는 3초 뒤 사라지므로, 직원은 저장된 줄 알고 나간다.
            //   다시 들어오면 예전 값이라 "설정이 자꾸 풀린다" 는 민원이 된다.
            Snackbar.Add(
                "저장하지 못했습니다. 화면을 서버 상태로 되돌립니다.",
                Severity.Error);
            await LoadAsync().ConfigureAwait(false);
        }
    }

    /// <summary>
    /// 모든 설정을 기본값으로 되돌리고 <b>서버에 저장까지</b> 한다.
    /// </summary>
    /// <remarks>
    /// 🔴 작4 ③번 봉합 — 종전에는 로컬 필드만 바꾸고 "기본값으로 초기화됐습니다" 라는
    /// <b>완료형 문구</b>를 띄웠다. 서버 호출이 없어 DB는 그대로였고,
    /// 직원은 끝난 줄 알고 화면을 떠났다. 별도로 [저장]을 눌러야 한다는 안내도 없었다.
    /// 버튼 이름이 약속한 일을 실제로 하도록 고쳤다.
    /// </remarks>
    private async Task Reset()
    {
        var confirm = await DialogService
            .ShowMessageBoxAsync(
                "초기화",
                "모든 설정을 기본값으로 되돌린 뒤 바로 저장합니다. 계속하시겠습니까?",
                yesText: "초기화하고 저장",
                cancelText: "취소");
        if (confirm != true)
        {
            return;
        }

        var restore = _s;   // 실패 시 되돌릴 현재 값

        // 🔴 2026-08-11 봉합 — 업종은 이 화면 것이 아니다.
        //   업종은 **회사 정보** 화면에서 고른다. 이 화면에는 입력칸조차 없다.
        //   그런데 초기화가 기본값 덩어리를 통째로 저장해서, 회사 정보에서 고른 업종이
        //   `소매업` 으로 덮어써졌다. 고객은 여기서 업종을 건드린 적이 없다.
        //   ⇒ 지금 값을 그대로 들고 간다.
        var keepIndustryType = _s.IndustryType;

        _s = new TenantSettingsModel();
        _s.IndustryType = keepIndustryType;
        _autoVatOff = !_s.AutoVatAdjust;
        _vatRound = _s.VatRoundType == "round";
        _priceGrades = new List<PriceGradeModel>
        {
            new("A단가", _s.PriceARate),
            new("B단가", _s.PriceBRate),
            new("C단가", _s.PriceCRate),
            new("D단가", _s.PriceDRate),
            new("E단가", _s.PriceERate),
        };

        _saving = true;
        var ok = await SettingsSvc.SaveAsync(_s).ConfigureAwait(false);
        _saving = false;

        if (ok)
        {
            _originalStockMethod = _s.StockEvalMethod;
            _stockMethodChanged = false;
            Snackbar.Add(
                "기본값으로 초기화하고 저장했습니다.",
                Severity.Success);
        }
        else
        {
            // 저장이 안 됐으면 화면도 되돌린다 — 초기화된 것처럼 보이면 안 된다.
            _s = restore;
            _autoVatOff = !_s.AutoVatAdjust;
            _vatRound = _s.VatRoundType == "round";
            _priceGrades = new List<PriceGradeModel>
            {
                new("A단가", _s.PriceARate),
                new("B단가", _s.PriceBRate),
                new("C단가", _s.PriceCRate),
                new("D단가", _s.PriceDRate),
                new("E단가", _s.PriceERate),
            };
            Snackbar.Add(
                "초기화하지 못했습니다. 설정은 그대로입니다.",
                Severity.Error);
        }
    }

    private sealed class PriceGradeModel
    {
        public string Label { get; }
        public decimal Rate { get; set; }

        public PriceGradeModel(string label, decimal rate)
        {
            Label = label;
            Rate = rate;
        }
    }
}
