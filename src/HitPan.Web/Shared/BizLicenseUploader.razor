@*
  BizLicenseUploader — 사업자등록증 업로드 컴포넌트 (WS-20260601-12, 2026-06-01 박제)
  - 드래그앤드롭 점선 그린(#0F6E56), 호버 오렌지(#FF6B35)
  - JPG/PNG/PDF, 5MB 제한
  - OCR 진행 3단계 칩 (업로드 → OCR → 검증)
  - 미리보기 썸네일
  실제 OCR·검증 API 연결은 P1 후속 작지에서 박제. 본 컴포넌트는 UI + 클라이언트 유효성까지.
*@

<div class="biz-uploader">
    <InputFile id="@_inputId" OnChange="HandleFile"
               accept=".jpg,.jpeg,.png,.pdf"
               class="biz-input-hidden" />
    <label for="@_inputId" class="dropzone @(_hovered ? "is-hover" : "") @(_hasFile ? "is-loaded" : "")"
           @ondragover:preventDefault @ondragenter="() => _hovered = true" @ondragleave="() => _hovered = false">
        @if (!_hasFile)
        {
            <div class="dz-icon">📄</div>
            <div class="dz-title">사업자등록증 업로드</div>
            <div class="dz-sub">JPG · PNG · PDF · 5MB 이하<br />클릭 또는 파일 끌어다 놓기</div>
        }
        else
        {
            <div class="thumb-wrap">
                @if (_previewUrl is not null)
                {
                    <img src="@_previewUrl" alt="업로드 미리보기" class="thumb-img" />
                }
                else
                {
                    <div class="thumb-pdf">PDF</div>
                }
                <div class="thumb-meta">
                    <div class="thumb-name">@_fileName</div>
                    <div class="thumb-size">@FormatBytes(_fileSize)</div>
                </div>
            </div>
        }
    </label>

    <div class="ocr-steps" role="status" aria-live="polite">
        <div class="step @StepClass(1)">
            <span class="step-num">1</span> 업로드
        </div>
        <div class="step-line"></div>
        <div class="step @StepClass(2)">
            <span class="step-num">2</span> OCR
        </div>
        <div class="step-line"></div>
        <div class="step @StepClass(3)">
            <span class="step-num">3</span> 검증
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="dz-error">@_error</div>
    }
</div>

@code {
    [Parameter] public EventCallback<UploadResult> OnUploaded { get; set; }

    private readonly string _inputId = $"biz-up-{Guid.NewGuid():N}";
    private bool _hovered;
    private bool _hasFile;
    private string? _previewUrl;
    private string? _fileName;
    private long _fileSize;
    private string? _error;
    private int _stage; // 0=대기, 1=업로드, 2=OCR, 3=검증완료

    private const long MaxBytes = 5 * 1024 * 1024;

    private string StepClass(int n)
    {
        if (_stage >= n && n < 3) return "done";
        if (_stage == n) return "active";
        if (_stage > n) return "done";
        return "";
    }

    private async Task HandleFile(InputFileChangeEventArgs e)
    {
        _error = null;
        _hovered = false;
        var file = e.File;
        if (file is null) return;

        if (file.Size > MaxBytes)
        {
            _error = "파일 크기가 5MB를 초과합니다.";
            return;
        }

        var ext = System.IO.Path.GetExtension(file.Name).ToLowerInvariant();
        if (ext is not (".jpg" or ".jpeg" or ".png" or ".pdf"))
        {
            _error = "JPG, PNG, PDF 파일만 업로드 가능합니다.";
            return;
        }

        _fileName = file.Name;
        _fileSize = file.Size;
        _hasFile = true;
        _stage = 1;

        if (ext != ".pdf")
        {
            try
            {
                using var stream = file.OpenReadStream(MaxBytes);
                using var ms = new System.IO.MemoryStream();
                await stream.CopyToAsync(ms);
                var b64 = Convert.ToBase64String(ms.ToArray());
                _previewUrl = $"data:{file.ContentType};base64,{b64}";
            }
            catch (Exception ex)
            {
                _error = $"미리보기 생성 실패: {ex.Message}";
            }
        }
        else
        {
            _previewUrl = null;
        }

        StateHasChanged();

        // OCR 단계 시뮬레이션 (실제 호출은 후속 작지에서)
        await Task.Delay(600);
        _stage = 2;
        StateHasChanged();
        await Task.Delay(800);
        _stage = 3;
        StateHasChanged();

        if (OnUploaded.HasDelegate)
        {
            await OnUploaded.InvokeAsync(new UploadResult(file.Name, file.Size, file.ContentType));
        }
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / 1024.0 / 1024.0:F2} MB";
    }

    public record UploadResult(string FileName, long Size, string ContentType);
}

<style>
.biz-uploader { display: flex; flex-direction: column; gap: 16px; }
.biz-input-hidden { display: none; }
.dropzone {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 32px 24px;
    border: 2px dashed #0F6E56;
    border-radius: 12px;
    background: #F0F9F5;
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease;
    min-height: 160px;
    text-align: center;
}
.dropzone.is-hover { border-color: #FF6B35; background: #FFF0EB; }
.dropzone.is-loaded { background: #FFFFFF; border-style: solid; border-color: #0F6E56; }
.dz-icon { font-size: 32px; margin-bottom: 8px; }
.dz-title { font-weight: 700; color: #0F1419; font-size: 16px; margin-bottom: 8px; }
.dz-sub { font-size: 13px; color: #6B7280; line-height: 1.5; }
.dz-error { background: #FEE2E2; color: #B91C1C; padding: 12px; border-radius: 8px; font-size: 13px; }

.thumb-wrap { display: flex; align-items: center; gap: 16px; width: 100%; }
.thumb-img { width: 80px; height: 80px; object-fit: cover; border-radius: 8px; border: 1px solid #E5E7EB; }
.thumb-pdf { width: 80px; height: 80px; border-radius: 8px; background: #FFF0EB; color: #B7390B; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 14px; border: 1px solid #FFD1BC; }
.thumb-meta { flex: 1; text-align: left; }
.thumb-name { font-weight: 600; color: #0F1419; font-size: 14px; word-break: break-all; }
.thumb-size { font-size: 12px; color: #6B7280; margin-top: 4px; }

.ocr-steps { display: flex; align-items: center; gap: 8px; }
.step {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 999px;
    background: #F3F4F6;
    color: #6B7280;
    font-size: 13px;
    font-weight: 600;
    transition: background 0.15s ease, color 0.15s ease;
}
.step .step-num {
    width: 18px; height: 18px; border-radius: 50%;
    background: #D1D5DB; color: #fff;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 11px; font-weight: 800;
}
.step.active { background: #FFF0EB; color: #B7390B; }
.step.active .step-num { background: #FF6B35; }
.step.done { background: #E6F4F0; color: #0A5240; }
.step.done .step-num { background: #0F6E56; }
.step-line { flex: 1; height: 2px; background: #E5E7EB; max-width: 32px; }
</style>
