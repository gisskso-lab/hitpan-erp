@using HitPan.Web.Models
@namespace HitPan.Web.Components.Purchase

<!-- 매입명세 목록: 필터·선택·합계(데이터는 GET API 추가 전까지 빈 목록). -->
<div class="purchase-receipt-list">
    <MudPaper Class="pa-3 mb-2">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudDatePicker Label="시작일" Date="_startDate" DateChanged="OnStartDateChangedAsync" />
            <MudDatePicker Label="종료일" Date="_endDate" DateChanged="OnEndDateChangedAsync" />

            <MudAutocomplete T="PartnerSearchResult"
                             Label="업체"
                             Value="_partner"
                             ValueChanged="OnPartnerChangedAsync"
                             SearchFunc="SearchPartnersAsync"
                             ToStringFunc="@(x => x is null ? string.Empty : x.PartnerName)"
                             Dense="true"
                             Clearable="true" />

            @* Razor 에서 Value="draft" 는 식별자로 파싱되므로 문자열 리터럴로 넘긴다. *@
            <MudSelect T="string" Label="상태" Value="_status" ValueChanged="OnStatusChangedAsync" Dense="true" Style="min-width:180px">
                <MudSelectItem T="string" Value="@("")">전체</MudSelectItem>
                <MudSelectItem T="string" Value="@("draft")">임시저장</MudSelectItem>
                <MudSelectItem T="string" Value="@("confirmed")">확정</MudSelectItem>
                <MudSelectItem T="string" Value="@("cancelled")">취소</MudSelectItem>
            </MudSelect>

            @* LoadAsync 가 CancellationToken 을 받으면 메서드 그룹을 OnClick 에 직접 넘길 수 없다. *@
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => LoadAsync())">조회</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Success" OnClick="BulkConfirmAsync" Disabled="@(!_selectedRows.Any())">
                선택 일괄 확정
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.SwapHoriz" OnClick="BulkConvertToReturnAsync" Disabled="@(!_selectedRows.Any())">
                반품으로 전환
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="BulkDeleteAsync" Disabled="@(!_selectedRows.Any())">
                선택 삭제
            </MudButton>
            <MudSpacer />
            <MudText Typo="Typo.caption" Style="color:#888">행을 <b>더블클릭</b>하면 작성창에 불러옵니다</MudText>
        </MudStack>
    </MudPaper>

    <MudPaper Class="pa-2 mb-2">
        <MudStack Row="true" Spacing="3">
            <MudText Typo="Typo.body2">선택 공급가액: @_selectedSupply.ToString("N0")</MudText>
            <MudText Typo="Typo.body2">선택 부가세: @_selectedVat.ToString("N0")</MudText>
            <MudText Typo="Typo.body2">선택 합계: @_selectedTotal.ToString("N0")</MudText>
        </MudStack>
    </MudPaper>

    <MudTable T="PurchaseReceiptListItem" Items="_rows" Dense="true" Hover="true" Striped="true" FixedHeader="true" Height="calc(100vh - 430px)"
              RowStyleFunc="@RowStyleFunc">
        <HeaderContent>
            <MudTh Style="width:48px">
                <MudCheckBox T="bool" Value="_allSelected" ValueChanged="ToggleAllAsync" />
            </MudTh>
            <MudTh>일자</MudTh>
            <MudTh>전표번호</MudTh>
            <MudTh>업체</MudTh>
            @* 20260825작16 — 사장님 지시: 판매관리 전표 목록과 마찬가지로 작성자를 보인다 *@
            <MudTh>작성자</MudTh>
            <MudTh>상태</MudTh>
            <MudTh Class="text-right">합계</MudTh>
            <MudTh Style="width:56px"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                <div @onclick:stopPropagation="true">
                    <MudCheckBox T="bool"
                                 Value="context.IsChecked"
                                 ValueChanged="@(v => ToggleOneAsync(context, v))"
                                 />
                </div>
            </MudTd>
            <MudTd @ondblclick="@(() => SelectRowAsync(context))" style="cursor:pointer">@context.ReceiptDate.ToString("yyyy-MM-dd")</MudTd>
            <MudTd @ondblclick="@(() => SelectRowAsync(context))" style="cursor:pointer">
                <MudText Class="@GetSelectedClass(context)">@context.ReceiptNo</MudText>
            </MudTd>
            <MudTd @ondblclick="@(() => SelectRowAsync(context))" style="cursor:pointer">@context.PartnerName</MudTd>
            <MudTd @ondblclick="@(() => SelectRowAsync(context))" style="cursor:pointer">@(context.CreatedByName ?? "")</MudTd>
            <MudTd @ondblclick="@(() => SelectRowAsync(context))" style="cursor:pointer">
                @* 🔴 20260826작5 — 사장님 지시: "반품처리된 전표는 상태처리를 「반품」이라고 표기할것.
                     전표에 전부 매입확정이라고만 나옴" ·
                     "반품 했다고 매입이 지워지는게 아니라, **전표 상태가 변경되면 됨. 이 방법이 가장 쉬움**"

                     🔴 "매입확정이던 임시저장상태이던, **최종 상태는 반품**이잖아.
                        그럼 반품으로 상태변경이 맞지." (사장님)
                     ⇒ 반품이 있으면 **직전 상태가 무엇이든 「반품」**이다. 반품이 최종 상태다.

                     ⇒ 상태 칸은 **하나**다. 칩을 나란히 두지 않는다 — 화면이 복잡해지면
                       현장에서 한눈에 안 읽힌다(히트판은 쉬움으로 이겼다).

                     ⚠️ 바뀌는 것은 **보이는 상태뿐**이다. DB 의 status 는 그대로 둔다 —
                       매입확정 사실이 지워지면 원장·부가세가 어긋난다. *@
                @if (context.ReturnStatus == "confirmed")
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">반품</MudChip>
                }
                else if (IsConfirmed(context))
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">매입확정</MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">@HitPan.Web.Helpers.StatusLabel.PurchaseReceipt(context.Status)</MudChip>
                }
            </MudTd>
            <MudTd Class="text-right" @ondblclick="@(() => SelectRowAsync(context))" style="cursor:pointer">@context.TotalAmount.ToString("N0")</MudTd>
            <MudTd>
                <div @onclick:stopPropagation="true">
                    @* 🔴 20260825작16 — 단건 「매입확정」. 사장님 지시:
                         "선택일괄확정버튼 옆에 매입확정 버튼 만들기".
                       종전엔 목록에서 확정하려면 전표를 열거나 일괄확정을 써야 했다.
                       한 건만 확정하는 게 현장에선 더 흔하다.
                       ⚠️ 권한은 서버(403)에 맡긴다 — 이 목록은 다이얼로그로도 열리는데
                         MudDialogProvider 가 CascadingAuthenticationState 밖이라
                         AuthorizeView 를 쓰면 목록이 통째로 죽는다(작11 에서 겪었다). *@
                    <MudIconButton Icon="@Icons.Material.Filled.CheckCircle"
                                   Color="Color.Success"
                                   Size="Size.Small"
                                   Title="매입확정"
                                   Disabled="@(!string.Equals(context.Status, "draft", StringComparison.OrdinalIgnoreCase) || _confirmingId == context.ReceiptId)"
                                   OnClick="@(() => ConfirmOneAsync(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   Disabled="@(!string.Equals(context.Status, "draft", StringComparison.OrdinalIgnoreCase))"
                                   OnClick="@(() => DeleteOneAsync(context))" />
                </div>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2" Class="pa-4">조회된 매입명세서가 없습니다.</MudText>
        </NoRecordsContent>
    </MudTable>
</div>
