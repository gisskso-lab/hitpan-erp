@using HitPan.Web.Models
@namespace HitPan.Web.Components.Purchase

<div class="purchase-return-list">
    <MudPaper Class="pa-3 mb-2">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudDatePicker Label="시작일" Date="_startDate" DateChanged="OnStartDateChangedAsync" />
            <MudDatePicker Label="종료일" Date="_endDate" DateChanged="OnEndDateChangedAsync" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => LoadAsync())">조회</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="BulkDeleteAsync" Disabled="@(!_selectedRows.Any())">
                선택 삭제
            </MudButton>
            <MudSpacer />
            <MudText Typo="Typo.caption" Style="color:#888">행을 <b>더블클릭</b>하면 작성창에 불러옵니다</MudText>
        </MudStack>
    </MudPaper>

    <MudTable T="PurchaseReturnListItem" Items="_rows" Dense="true" Hover="true" Striped="true" FixedHeader="true" Height="calc(100vh - 360px)">
        <HeaderContent>
            <MudTh Style="width:48px">
                <MudCheckBox T="bool" Value="_allSelected" ValueChanged="ToggleAllAsync" />
            </MudTh>
            <MudTh>일자</MudTh>
            <MudTh>전표번호</MudTh>
            <MudTh>업체</MudTh>
            <MudTh>상태</MudTh>
            <MudTh Class="text-right">합계</MudTh>
            <MudTh Style="width:56px"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                <div @onclick:stopPropagation="true">
                    <MudCheckBox T="bool"
                                 Value="context.IsChecked"
                                 ValueChanged="@(v => ToggleOneAsync(context, v))" />
                </div>
            </MudTd>
            <MudTd @ondblclick="@(() => SelectRowAsync(context))" style="cursor:pointer">@context.ReturnDate.ToString("yyyy-MM-dd")</MudTd>
            <MudTd @ondblclick="@(() => SelectRowAsync(context))" style="cursor:pointer">@context.ReturnNo</MudTd>
            <MudTd @ondblclick="@(() => SelectRowAsync(context))" style="cursor:pointer">@context.PartnerName</MudTd>
            <MudTd @ondblclick="@(() => SelectRowAsync(context))" style="cursor:pointer">@HitPan.Web.Helpers.StatusLabel.Document(context.Status)</MudTd>
            <MudTd Class="text-right" @ondblclick="@(() => SelectRowAsync(context))" style="cursor:pointer">@((context.TotalAmount + context.VatAmount).ToString("N0"))</MudTd>
            <MudTd>
                <div @onclick:stopPropagation="true">
                    @* 20260825작10 — 사장님 실측 반려 1번: "목록에는 없고, 전표작성에만 반품확정버튼 있음".
                       작9 에서 전표 화면에만 넣고 목록을 빠뜨렸다(PM 누락).
                       🔴 매출반품일 때만 보인다 — 이 목록은 매입반품과 공용이고,
                          매입 확정은 경로도 권한도 다르다(섞으면 잘못된 확정이 나간다).
                       권한은 전표 화면과 같다(작9) — 화면이 서버 정책보다 관대해도, 인색해도 안 된다. *@
                    @if (IsSalesReturn && string.Equals(context.Status, "draft", StringComparison.OrdinalIgnoreCase))
                    {
                        @* Context="auth" — MudTable RowTemplate 의 context 와 이름이 겹치면 컴파일이 막힌다. *@
                        <AuthorizeView Roles="system_admin,tenant_admin,sales_manager" Context="auth">
                            <Authorized>
                                <MudIconButton Icon="@Icons.Material.Filled.CheckCircle"
                                               Color="Color.Success"
                                               Size="Size.Small"
                                               Title="반품확정"
                                               OnClick="@(() => ConfirmOneAsync(context))" />
                            </Authorized>
                        </AuthorizeView>
                    }
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   Disabled="@(!string.Equals(context.Status, "draft", StringComparison.OrdinalIgnoreCase))"
                                   OnClick="@(() => DeleteOneAsync(context))" />
                </div>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2" Class="pa-4">조회된 @(IsSalesReturn ? "매출반품" : "매입반품")이 없습니다.</MudText>
        </NoRecordsContent>
    </MudTable>
</div>
