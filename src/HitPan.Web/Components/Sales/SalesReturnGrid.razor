@using HitPan.Web.Models
@using HitPan.Web.Components.Common
@using HitPan.Web.Services
@namespace HitPan.Web.Components.Sales
@inject PriceHintService HintService
@inject HttpClient Http
@using System.Net.Http.Json

@* 매출반품(반품확인서) 전용 그리드 (20260825작6)
   사장님 정의: "매출에 있는 반품 = 사용자의 고객사가 반품처리한 품목관리"
   매입반품 그리드와 다른 점 두 가지 —
     ① 반품사유가 콤보가 아니라 **자율 입력**이다. 한 번 쓴 말이 다음부터 선택지가 된다.
        (사장님: "로스판정 기준은 고객사가 정하는거지, 너가 왜 정해")
     ② 품목줄마다 **로스** 체크가 있다. 파손이면 재고에 안 넣는다.
        한 반품에 정상품과 파손품이 섞여 오기 때문에 줄 단위다. *@

<MudPaper Class="pa-2 mb-2" Elevation="0">
    <MudGrid>
        <MudItem xs="12" md="4">
            @* 자율 입력 — 우리가 사유 코드를 정하지 않는다. 쓴 말이 곧 목록이 된다. *@
            <MudAutocomplete T="string" Value="@ReturnReason" ValueChanged="OnReasonChangedAsync"
                             SearchFunc="SearchReasonAsync" Label="반품 사유" Margin="Margin.Dense"
                             Variant="Variant.Outlined" CoerceValue="true" CoerceText="false"
                             Clearable="true" ResetValueOnEmptyText="false" MaxItems="50"
                             Placeholder="직접 입력하거나 이전에 쓴 사유 선택" />
        </MudItem>
        <MudItem xs="12" md="8">
            <MudTextField T="string" @bind-Value="ReturnReasonMemo" Label="반품 사유 상세 (자유 입력)" Margin="Margin.Dense" Variant="Variant.Outlined" MaxLength="500" />
        </MudItem>
    </MudGrid>
</MudPaper>

<MudTable T="DeliveryLineModel" Items="Lines" Dense="true" Hover="true" Striped="true" FixedHeader="true" Height="calc(100vh - 420px)">
    <HeaderContent>
        <MudTh Style="width:48px"><MudCheckBox T="bool" Value="_allSelected" ValueChanged="ToggleAllAsync" /></MudTh>
        <MudTh Style="width:60px">No</MudTh>
        <MudTh>품명</MudTh>
        <MudTh>규격</MudTh>
        <MudTh Style="width:90px">단위</MudTh>
        <MudTh Class="text-right">반품수량</MudTh>
        <MudTh Class="text-right">단가</MudTh>
        <MudTh Class="text-right">금액</MudTh>
        <MudTh Class="text-right">부가세액</MudTh>
        <MudTh Style="width:80px" Class="text-center">로스</MudTh>
        <MudTh>품목별 사유</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd><MudCheckBox T="bool" Value="context.IsSelected" ValueChanged="@(v => { context.IsSelected = v; _allSelected = Lines.Where(x => !x.IsPlaceholder).All(x => x.IsSelected); })" /></MudTd>
        <MudTd>@context.No</MudTd>
        <MudTd><MudAutocomplete T="string" Value="context.ItemName" SearchFunc="SearchItemAsync"
            ValueChanged="@(async v => { context.ItemName = v; context.IsPlaceholder = false; await AutoFillItemAsync(context, v); NotifyChanged(); })"
            Margin="Margin.Dense" Dense="true" Placeholder="품명 검색" /></MudTd>
        <MudTd>
            <ItemSpecAutocomplete ItemId="@context.ItemId" Value="@context.Spec"
                                   ValueChanged="@(v => { context.Spec = v; NotifyChanged(); })" />
        </MudTd>
        <MudTd><MudTextField T="string" Value="context.Unit" ValueChanged="@(v => { context.Unit = v; NotifyChanged(); })" Margin="Margin.Dense" /></MudTd>
        <MudTd><MudNumericField T="decimal" Value="context.Qty" ValueChanged="@(v => { context.Qty = v; RecalcLine(context); })" Margin="Margin.Dense" /></MudTd>
        <MudTd><PriceHintCell Value="context.UnitPrice" ValueChanged="@(v => { context.UnitPrice = v; RecalcLine(context); })" ItemId="@context.ItemId" PartnerId="@PartnerId" IsPurchase="false" /></MudTd>
        <MudTd Class="text-right">@context.Amount.ToString("N0")</MudTd>
        <MudTd Class="text-right">@context.VatAmount.ToString("N0")</MudTd>
        @* 로스 = 파손이라 못 파는 물건. 체크하면 확정해도 재고에 안 들어간다. *@
        <MudTd Class="text-center">
            <MudCheckBox T="bool" Value="context.IsLoss"
                         ValueChanged="@(v => { context.IsLoss = v; NotifyChanged(); })" />
        </MudTd>
        <MudTd><MudTextField T="string" Value="context.Note" ValueChanged="@(v => { context.Note = v; NotifyChanged(); })" Margin="Margin.Dense" Placeholder="품목별 반품 사유" /></MudTd>
    </RowTemplate>
    <NoRecordsContent><MudText Typo="Typo.body2" Class="pa-4">반품 품목이 없습니다.</MudText></NoRecordsContent>
</MudTable>

@code {
    private bool _allSelected;

    [Parameter, EditorRequired] public List<DeliveryLineModel> Lines { get; set; } = default!;
    [Parameter] public DeliveryGridDensity Density { get; set; }
    [Parameter] public DeliverySummaryModel Summary { get; set; } = new();
    [Parameter] public string Status { get; set; } = "draft";
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback<DeliveryLineModel?> SelectedLineChanged { get; set; }
    [Parameter] public List<ItemListModel>? ItemCache { get; set; }

    [Parameter] public string? ReturnReason { get; set; }
    [Parameter] public EventCallback<string?> ReturnReasonChanged { get; set; }
    [Parameter] public string? ReturnReasonMemo { get; set; }
    [Parameter] public EventCallback<string?> ReturnReasonMemoChanged { get; set; }


    // ─── 반품사유 자율 입력 (20260825작6) ───
    //   사장님 지시: "사유도 콤보박스로 두지 말고 텍스트박스로 자율적 기입하도록 하고,
    //                자율적으로 기입한걸 텍스트박스로 선택하도록 해"
    //   우리가 코드를 미리 정하지 않는다 — 고객사가 쓴 말이 곧 목록이 된다.
    private List<string>? _reasonCache;

    private async Task<IEnumerable<string>> SearchReasonAsync(string value, CancellationToken ct)
    {
        // 이전에 쓴 사유를 모아온다. 실패해도 화면은 살아 있어야 한다 —
        // 목록이 안 와도 직접 입력은 되어야 하기 때문이다(CoerceValue=true).
        if (_reasonCache is null)
        {
            try
            {
                _reasonCache = await Http.GetFromJsonAsync<List<string>>("api/sales/returns/reasons", ct) ?? new();
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"[SalesReturnGrid] 반품사유 목록 조회 실패: {ex.Message}");
                _reasonCache = new();
            }
        }

        if (string.IsNullOrWhiteSpace(value)) return _reasonCache;
        return _reasonCache.Where(r => r.Contains(value, StringComparison.OrdinalIgnoreCase));
    }

    private async Task OnReasonChangedAsync(string? value)
    {
        ReturnReason = value;
        await ReturnReasonChanged.InvokeAsync(value);

        // 새로 쓴 말이 다음 조회에 바로 뜨도록 캐시에 얹는다.
        if (!string.IsNullOrWhiteSpace(value) && _reasonCache is not null && !_reasonCache.Contains(value))
        {
            _reasonCache.Add(value);
        }
    }
    private Task<IEnumerable<string>> SearchItemAsync(string value, CancellationToken ct)
    {
        if (ItemCache is null) return Task.FromResult(Enumerable.Empty<string>());
        if (string.IsNullOrWhiteSpace(value)) return Task.FromResult(ItemCache.Select(i => i.ItemName).Distinct());
        return Task.FromResult(ItemCache.Where(i => i.ItemName.Contains(value, StringComparison.OrdinalIgnoreCase)).Select(i => i.ItemName).Distinct());
    }

    /// <summary>
    /// 품목을 고르면 규격·단위·단가를 채운다.
    /// </summary>
    /// <remarks>
    /// 🔴 <b>업체특별단가가 있으면 그 값이 이긴다</b> (20260820작4 · 설계2 C안 · 사장님 확정).
    ///   없으면 종전대로 매입단가로 채운다 — <b>기존 동작을 없애지 않는다</b>(헌법 #1).
    /// ⚠️ 자동 적용에 끼는 축은 <b>업체특별단가 하나뿐</b>이다(설계2 §4-4).
    /// ⚠️ 채운 값을 <b>잠그지 않는다.</b> 사람이 지우고 다시 칠 수 있다(게이트 G-4b).
    /// </remarks>
    private async Task AutoFillItemAsync(DeliveryLineModel line, string itemName)
    {
        if (ItemCache is null) return;
        var item = ItemCache.FirstOrDefault(i => i.ItemName == itemName);
        if (item is null) return;
        line.ItemId = item.ItemId;
        line.Spec = item.Spec ?? "";
        line.Unit = item.Unit;
        line.UnitPrice = item.PurchasePrice;

        var hint = await HintService.GetAsync(PartnerId, item.ItemId, isPurchase: true);
        if (hint?.PartnerSpecialPrice is { } sp)
        {
            line.UnitPrice = sp;
        }
    }

    /// <summary>이 문서의 업체 — 참고값·자동 채움에 쓴다 (20260820작4 · 설계2 C안).</summary>
    [Parameter] public string? PartnerId { get; set; }

    private async Task ToggleAllAsync(bool value)
    {
        _allSelected = value;
        foreach (var l in Lines.Where(x => !x.IsPlaceholder)) l.IsSelected = value;
    }

    private void RecalcLine(DeliveryLineModel line)
    {
        Summary.SupplyAmount = Lines.Where(x => !x.IsPlaceholder).Sum(x => x.Amount);
        Summary.VatAmount = Lines.Where(x => !x.IsPlaceholder).Sum(x => x.VatAmount);
        Summary.TotalAmount = Summary.SupplyAmount + Summary.VatAmount;
        OnChanged.InvokeAsync();
        StateHasChanged();
    }

    private void NotifyChanged() => OnChanged.InvokeAsync();
}
