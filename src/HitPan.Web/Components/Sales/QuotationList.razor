@using HitPan.Web.Models
@namespace HitPan.Web.Components.Sales

<MudDialog Style="min-width:960px;max-width:1160px">
    <TitleContent>
        <MudText Typo="Typo.h6">견적서 목록</MudText>
    </TitleContent>
    <DialogContent>
        <MudPaper Class="pa-3 mb-2">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                <MudDatePicker Label="시작일" Date="_startDate" DateChanged="OnStartDateChangedAsync" />
                <MudDatePicker Label="종료일" Date="_endDate" DateChanged="OnEndDateChangedAsync" />
                <MudTextField T="string" Label="거래처명" Value="_partnerName" ValueChanged="OnPartnerNameChangedAsync" Margin="Margin.Dense" />
                <MudSelect T="string" Label="상태" Value="_status" ValueChanged="OnStatusChangedAsync" Dense="true" Style="min-width:180px">
                    <MudSelectItem T="string" Value="@("draft")">Draft</MudSelectItem>
                    <MudSelectItem T="string" Value="@("submitted")">Submitted</MudSelectItem>
                    <MudSelectItem T="string" Value="@("accepted")">Accepted</MudSelectItem>
                    <MudSelectItem T="string" Value="@("rejected")">Rejected</MudSelectItem>
                    <MudSelectItem T="string" Value="@("expired")">Expired</MudSelectItem>
                    <MudSelectItem T="string" Value="@("converted")">Converted</MudSelectItem>
                </MudSelect>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => LoadAsync())">조회</MudButton>
            </MudStack>
        </MudPaper>

        <MudTable T="QuotationListItem" Items="_rows" Dense="true" Hover="true" Striped="true" FixedHeader="true" Height="420px">
            <HeaderContent>
                <MudTh Style="width:48px">
                    <MudCheckBox T="bool" Value="_allSelected" ValueChanged="ToggleAllAsync" />
                </MudTh>
                <MudTh>견적번호</MudTh>
                <MudTh>거래처</MudTh>
                <MudTh>견적일</MudTh>
                <MudTh>유효기한</MudTh>
                <MudTh>상태</MudTh>
                <MudTh Class="text-right">공급가액</MudTh>
                <MudTh Class="text-right">부가세</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudCheckBox T="bool"
                                 Value="context.IsChecked"
                                 ValueChanged="@(v => ToggleOneAsync(context, v))"
                                 OnClick:stopPropagation="true" />
                </MudTd>
                <MudTd @ondblclick="@(() => SelectAsync(context))">@context.QuoteNo</MudTd>
                <MudTd @ondblclick="@(() => SelectAsync(context))">@context.PartnerName</MudTd>
                <MudTd @ondblclick="@(() => SelectAsync(context))">@context.QuoteDate.ToString("yyyy-MM-dd")</MudTd>
                <MudTd @ondblclick="@(() => SelectAsync(context))">@context.ValidUntil?.ToString("yyyy-MM-dd")</MudTd>
                <MudTd @ondblclick="@(() => SelectAsync(context))">@context.Status</MudTd>
                <MudTd Class="text-right" @ondblclick="@(() => SelectAsync(context))">@context.TotalAmount.ToString("N0")</MudTd>
                <MudTd Class="text-right" @ondblclick="@(() => SelectAsync(context))">@context.VatAmount.ToString("N0")</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Class="pa-4">조회된 견적서가 없습니다.</MudText>
            </NoRecordsContent>
        </MudTable>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.SwapHoriz" OnClick="BulkConvertToOrderAsync" Disabled="@(!_selectedRows.Any())">
            수주로 전환
        </MudButton>
        <MudSpacer />
        <MudButton Variant="Variant.Outlined" OnClick="Close">닫기</MudButton>
    </DialogActions>
</MudDialog>
