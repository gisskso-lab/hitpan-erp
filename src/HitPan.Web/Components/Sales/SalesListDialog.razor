@using HitPan.Web.Models
@using HitPan.Web.Services
@using MudBlazor
@inject IDialogService DialogService
@inject DeliveryService DeliveryService

<MudDialog Style="min-width:900px;max-width:1100px">
    <TitleContent>
        <MudText Typo="Typo.h6">판매 목록 조회</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="2" Class="pa-2">
            <MudItem xs="12" sm="3">
                <MudDatePicker @bind-Date="FilterFrom"
                               Label="시작일"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               DateFormat="yyyy-MM-dd" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudDatePicker @bind-Date="FilterTo"
                               Label="종료일"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               DateFormat="yyyy-MM-dd" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="FilterPartner"
                              Label="업체명"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Style="font-size:13px"
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.Search" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Style="font-size:13px"
                           OnClick="Search">찾기실행</MudButton>
            </MudItem>
        </MudGrid>

        <MudDataGrid T="SalesListItem"
                     Items="Items"
                     Dense="true"
                     Hover="true"
                     Striped="true"
                     FixedHeader="true"
                     Height="400px"
                     Style="font-size:13px"
                     RowStyleFunc="RowStyle"
                     RowClick="OnRowClick">
            <Columns>
                <TemplateColumn CellStyle="width:50px;text-align:center"
                                HeaderStyle="width:50px;text-align:center">
                    <HeaderTemplate>
                        <MudCheckBox T="bool"
                                     Value="AllChecked"
                                     ValueChanged="ToggleAll"
                                     Size="Size.Small" />
                    </HeaderTemplate>
                    <CellTemplate>
                        <MudCheckBox T="bool"
                                     Value="context.Item.IsChecked"
                                     ValueChanged="v => OnCheck(context.Item, v)"
                                     Disabled="context.Item.IsProcessed"
                                     Size="Size.Small" />
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.OrderDate"
                                Title="일자"
                                CellStyle="width:90px"
                                Format="yyyy-MM-dd" />
                <PropertyColumn Property="x => x.OrderNo"
                                Title="순위"
                                CellStyle="width:60px;text-align:center" />
                <PropertyColumn Property="x => x.PartnerName"
                                Title="업체명"
                                CellStyle="font-size:13px" />
                <PropertyColumn Property="x => x.TotalAmount"
                                Title="금액"
                                CellStyle="width:110px;text-align:right"
                                Format="N0" />
                <PropertyColumn Property="x => x.VatAmount"
                                Title="부가세"
                                CellStyle="width:100px;text-align:right"
                                Format="N0" />
                <TemplateColumn Title="상태"
                                CellStyle="width:80px;text-align:center">
                    <CellTemplate>
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="@GetStatusColor(context.Item.Status)"
                                 Style="font-size:11px">
                            @GetStatusLabel(context.Item.Status)
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>

        <MudText Typo="Typo.caption"
                 Class="pa-1"
                 Style="color:#6B7280">
            선택: @Items.Count(x => x.IsChecked)건 / 전체: @Items.Count 건
        </MudText>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="ChangeToSales"
                   Variant="Variant.Outlined"
                   Size="Size.Small"
                   Style="font-size:12px"
                   Disabled="!HasChecked">판매로 변경</MudButton>
        <MudButton OnClick="IssueElectronic"
                   Variant="Variant.Outlined"
                   Size="Size.Small"
                   Style="font-size:12px"
                   Disabled="!HasChecked">전자발행</MudButton>
        <MudSpacer />
        <MudButton OnClick="Close"
                   Variant="Variant.Outlined"
                   Size="Size.Small"
                   Style="font-size:12px">종료(E)</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public string ListType { get; set; } = "sales";
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private DateTime? FilterFrom = DateTime.Today.AddDays(-30);
    private DateTime? FilterTo = DateTime.Today;
    private string FilterPartner = string.Empty;
    private List<SalesListItem> Items = new();
    private bool AllChecked;
    private bool HasChecked => Items.Any(x => x.IsChecked);

    protected override async Task OnInitializedAsync()
    {
        await Search();
    }

    private async Task Search()
    {
        Items = await DeliveryService.GetListAsync(ListType, FilterFrom, FilterTo, FilterPartner);
        AllChecked = false;
    }

    private void ToggleAll(bool val)
    {
        AllChecked = val;
        foreach (var item in Items.Where(x => !x.IsProcessed))
        {
            item.IsChecked = val;
        }
    }

    private void OnCheck(SalesListItem item, bool val)
    {
        item.IsChecked = val;
        AllChecked = Items.Where(x => !x.IsProcessed).All(x => x.IsChecked);
    }

    private void OnRowClick(DataGridRowClickEventArgs<SalesListItem> args)
    {
        if (args.MouseEventArgs.Detail == 2)
        {
            MudDialog.Close(DialogResult.Ok(args.Item));
        }
    }

    private async Task ChangeToSales()
    {
        var checkedItems = Items.Where(x => x.IsChecked).ToList();
        var result = await DialogService.ShowMessageBoxAsync(
            "판매로 변경",
            $"선택한 {checkedItems.Count}건을 판매로 변경하시겠습니까?",
            yesText: "변경",
            cancelText: "취소");
        if (result != true)
        {
            return;
        }

        await DeliveryService.BulkConfirmAsync(checkedItems.Select(x => x.OrderId).ToList());
        await Search();
    }

    private async Task IssueElectronic()
    {
        var checkedItems = Items.Where(x => x.IsChecked).ToList();
        var result = await DialogService.ShowMessageBoxAsync(
            "전자발행",
            $"선택한 {checkedItems.Count}건을 전자발행 처리하시겠습니까?",
            yesText: "발행",
            cancelText: "취소");
        if (result != true)
        {
            return;
        }

        await Search();
    }

    private void Close()
    {
        MudDialog.Close(DialogResult.Cancel());
    }

    private Color GetStatusColor(string status) => status switch
    {
        "confirmed" => Color.Success,
        "invoiced" => Color.Primary,
        "draft" => Color.Default,
        "quotation" => Color.Warning,
        "order" => Color.Info,
        "cancelled" => Color.Error,
        _ => Color.Default
    };

    private string GetStatusLabel(string status) => status switch
    {
        "confirmed" => "판매확정",
        "invoiced" => "계산서발행",
        "draft" => "임시",
        "quotation" => "견적",
        "order" => "수주",
        "cancelled" => "취소",
        _ => status
    };

    private string RowStyle(SalesListItem item, int index)
        => "height:36px;font-size:13px;" + (item.IsProcessed ? "color:#9CA3AF;" : string.Empty);
}
