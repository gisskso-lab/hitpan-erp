@using HitPan.Web.Models
@using HitPan.Web.Services
@using MudBlazor
@inject IDialogService DialogService
@inject DeliveryService DeliveryService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<MudDialog Style="min-width:900px;max-width:1100px">
    <TitleContent>
        <MudText Typo="Typo.h6">판매 목록 조회</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="2" Class="pa-2">
            <MudItem xs="12" sm="3">
                <MudDatePicker @bind-Date="FilterFrom"
                               Label="시작일"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               DateFormat="yyyy-MM-dd" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudDatePicker @bind-Date="FilterTo"
                               Label="종료일"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               DateFormat="yyyy-MM-dd" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField @bind-Value="FilterPartner"
                              Label="업체명"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Style="font-size:13px"
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.Search" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Style="font-size:13px"
                           OnClick="Search">찾기실행</MudButton>
            </MudItem>
        </MudGrid>

        <MudTable T="SalesListItem" Items="Items" Dense="true" Hover="true" Striped="true" FixedHeader="true" Height="400px">
            <HeaderContent>
                <MudTh Style="width:48px"><MudCheckBox T="bool" Value="AllChecked" ValueChanged="ToggleAll" Size="Size.Small" /></MudTh>
                <MudTh>일자</MudTh>
                <MudTh>전표번호</MudTh>
                <MudTh>업체</MudTh>
                <MudTh>작성자</MudTh>
                <MudTh>상태</MudTh>
                <MudTh Style="text-align:right">금액</MudTh>
                <MudTh Style="text-align:right">부가세</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><MudCheckBox T="bool" Value="context.IsChecked" ValueChanged="@(v => OnCheck(context, v))" Disabled="context.IsProcessed" Size="Size.Small" /></MudTd>
                <MudTd @ondblclick="@(() => SelectRow(context))">@context.OrderDate.ToString("yyyy-MM-dd")</MudTd>
                @* 🔴 20260903작16 — 사슬을 눈으로 읽히게 붙인다 (사장님 결재).
                   반품 줄은 ①들여쓰고 ②└ 로 원전표에 매달고 ③번호 옆에 원전표 번호를 적고
                   ④금액을 (−) 빨강으로 낸다. 별도 메뉴 없이 이 목록이 곧 대사 화면이 된다. *@
                <MudTd @ondblclick="@(() => SelectRow(context))">
                    @if (context.IsReturn)
                    {
                        <span style="display:inline-flex;align-items:center;gap:6px;padding-left:18px">
                            <span style="color:#9CA3AF">└</span>
                            <MudText Style="font-weight:600;color:#B91C1C">@context.OrderNo</MudText>
                            @if (!string.IsNullOrWhiteSpace(context.SourceDeliveryNo))
                            {
                                <MudText Typo="Typo.caption" Style="color:#6B7280">
                                    @context.SourceDeliveryNo 의 반품
                                </MudText>
                            }
                        </span>
                    }
                    else
                    {
                        <MudText Style="font-weight:500">@context.OrderNo</MudText>
                    }
                </MudTd>
                <MudTd @ondblclick="@(() => SelectRow(context))">@context.PartnerName</MudTd>
                <MudTd @ondblclick="@(() => SelectRow(context))">@(context.CreatedByName ?? "")</MudTd>
                <MudTd><MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)" Variant="Variant.Text">@GetRowStatusLabel(context)</MudChip></MudTd>
                <MudTd Style="@AmountStyle(context)">@context.TotalAmount.ToString("N0")</MudTd>
                <MudTd Style="@AmountStyle(context)">@context.VatAmount.ToString("N0")</MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Class="pa-4" Style="color:#9CA3AF">조회된 거래명세서가 없습니다.</MudText></NoRecordsContent>
        </MudTable>

        <MudText Typo="Typo.caption"
                 Class="pa-1"
                 Style="color:#6B7280">
            선택: @Items.Count(x => x.IsChecked)건 / 전체: @Items.Count 건
        </MudText>
    </DialogContent>

    <DialogActions>
        @* 20260825작8 — 사장님 실측 반려 2번: "판매불러오기 클릭시 판매 못불러옴".
           행을 고르는 수단이 더블클릭 하나뿐이라, 체크만 하고 「종료」를 누르면
           DialogResult.Cancel() 로 닫혀 호출부가 아무것도 못 받았다.
           🔴 로직(FillFromDeliveryAsync)은 정상이었다 — 끊긴 건 "고른 행을 돌려주는 자리"다.
           더블클릭 경로는 그대로 둔다(헌법 #1 — 추가만 한다). *@
        <MudButton OnClick="SelectChecked"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Small"
                   Style="font-size:12px"
                   StartIcon="@Icons.Material.Filled.Check"
                   Disabled="!CanSelectOne">선택</MudButton>
        @* 🔴 20260831 (사장님 실측 반려 1) — 버튼 이름을 「하는 일」이 아니라
           「누르면 되는 상태」로 맞춘다. 결재 7 사슬과 같은 어휘를 쓴다.

             판매완료 → [판매확정] → 판매확정 → [계산서 발행] → 계산서발행 → 전자발행

           🔴 종전 이름이 실제 동작과 달랐다 — 「계산서 발행」 버튼이 부르는 것은
              BulkConfirmAsync(판매확정)이지 계산서 발행이 아니었다.
              담당자는 계산서가 나가는 줄 알고 눌렀을 것이다. 이름이 거짓말을 하고 있었다. *@
        <MudButton OnClick="IssueInvoiceAsync"
                   Variant="Variant.Outlined"
                   Size="Size.Small"
                   Style="font-size:12px"
                   Disabled="!HasDraftChecked">판매확정</MudButton>
        <MudButton OnClick="IssueElectronic"
                   Variant="Variant.Outlined"
                   Size="Size.Small"
                   Style="font-size:12px"
                   Disabled="!HasConfirmedChecked">계산서 발행</MudButton>
        @* 전자발행 — 계산서발행(invoiced) 건만. 국세청에 나가면 되돌릴 수 없다. *@
        <MudButton OnClick="IssueElectronicTaxAsync"
                   Variant="Variant.Outlined"
                   Size="Size.Small"
                   Style="font-size:12px"
                   Disabled="!HasInvoicedChecked">전자발행</MudButton>
        @* AuthorizeView 는 MudDialog 캐스케이드 밖에서 Task<AuthenticationState>를 못 받아
           "Authorization requires a cascading parameter" 오류 발생.
           권한 검증은 백엔드 [Authorize(Policy = "SalesManager")] 가 강제하고
           UI 는 항상 노출 → 권한 없으면 서버가 403 반환, 사용자에게 안내. *@
        <MudButton OnClick="BulkDeleteAsync"
                   Variant="Variant.Outlined"
                   Color="Color.Error"
                   Size="Size.Small"
                   Style="font-size:12px"
                   StartIcon="@Icons.Material.Filled.Delete"
                   Disabled="!HasDeletableChecked">선택 삭제</MudButton>
        <MudSpacer />
        <MudButton OnClick="Close"
                   Variant="Variant.Outlined"
                   Size="Size.Small"
                   Style="font-size:12px">종료(E)</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public string ListType { get; set; } = "sales";
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private DateTime? FilterFrom = DateTime.Today.AddDays(-30);
    private DateTime? FilterTo = DateTime.Today;
    private string FilterPartner = string.Empty;
    private List<SalesListItem> Items = new();
    private bool AllChecked;
    private bool HasChecked => Items.Any(x => x.IsChecked);
    private bool HasDraftChecked => Items.Any(x => x.IsChecked && !x.IsReturn && x.Status == "draft");

    /// <summary>
    /// 🔴 20260831 (사장님 실측 반려 1) — 계산서 발행 대상 = <b>판매확정(confirmed)</b> 건.
    /// 결재 7 사슬: 판매완료 → <b>판매확정</b> → 계산서발행 → 전자발행.
    /// 확정되지 않은 건에는 계산서를 끊을 수 없다(원장이 아직 안 움직였다).
    /// </summary>
    private bool HasConfirmedChecked => Items.Any(x => x.IsChecked && !x.IsReturn && x.Status == "confirmed");

    /// <summary>전자발행 대상 = 계산서발행(invoiced) 건. 국세청에 나가면 되돌릴 수 없다.</summary>
    private bool HasInvoicedChecked => Items.Any(x => x.IsChecked && !x.IsReturn && x.Status == "invoiced");
    /// <summary>삭제 가능 = 선택됨 AND 계산서 발행 전(invoiced 아님). 권한은 AuthorizeView에서.</summary>
    private bool HasDeletableChecked => Items.Any(x => x.IsChecked && !x.IsReturn && x.Status != "invoiced");

    // 🔴 20260825작15 — CanCreateReturn 제거 (사장님 결재: 반품확인 메뉴 전부 제거).
    //   판매목록에서 반품으로 전환하는 경로 자체를 없앤다.
    //   대체: 거래명세서 확정취소(재고·회계 역행 원장 자동 발행) 또는 마이너스 전표.

    protected override async Task OnInitializedAsync()
    {
        await Search();
    }

    private async Task Search()
    {
        var fromStr = FilterFrom?.ToString("yyyy-MM-dd") ?? "";
        var toStr = FilterTo?.ToString("yyyy-MM-dd") ?? "";
        var list = await DeliveryService.GetListAsync(fromStr, toStr, FilterPartner, "", CancellationToken.None);
        var sales = list.Select(d => new SalesListItem
        {
            OrderId = d.DeliveryId,
            OrderDate = d.OrderDate,
            OrderNo = d.DeliveryNo,
            PartnerId = d.PartnerId,
            PartnerName = d.PartnerName,
            TotalAmount = d.TotalAmount,
            VatAmount = d.VatAmount,
            Status = d.Status,

            // 20260825작5: 작성자를 목록까지 실어 보낸다 — 여기서 빠뜨리면 그리드가 항상 공란이다.
            CreatedByName = d.CreatedByName
        }).ToList();

        // ─────────────────────────────────────────────────────────────────
        // 🔴 20260903작16 — 마이너스 전표(반품)를 원전표 아래에 붙인다.
        //
        //   사장님: *"매출반품 메뉴를 없애고, 마이너스 전표(반품)과 그 마이너스 전표와
        //            연결되는 원 전표의 사슬을 **가독성 있게 붙여 놓으라**고 했잖아."*
        //
        //   🔴 작15 는 **저장만 고치고 목록을 안 고쳤다.** 반품이 sales_returns 에
        //      정상 저장됐는데 이 목록은 sales_deliveries 만 읽어서 **아무 데도 안 보였다.**
        //      매출반품 화면은 8/25 결재로 @page 가 주석 처리돼 있어 열 문이 하나도 없었다.
        //      ⇒ 「고쳤나」만 보고 「보이나」를 안 본 자리(fixed≠delivered 9차).
        //
        //   설계 근거: 20260828 설계서 §3-4 — 원전표 바로 아래 배치가 그대로
        //             **경리의 대사 화면**이 된다.
        // ─────────────────────────────────────────────────────────────────
        var returns = await DeliveryService.GetSalesReturnListAsync(FilterFrom, FilterTo, CancellationToken.None);

        // 거래처 필터는 판매쪽과 같은 기준으로 건다(서버가 반품에는 거래처 필터를 안 받는다).
        if (!string.IsNullOrWhiteSpace(FilterPartner))
        {
            returns = returns
                .Where(r => (r.PartnerName ?? "").Contains(FilterPartner, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }

        var noByDeliveryId = sales.ToDictionary(x => x.OrderId, x => x.OrderNo);

        var returnRows = returns.Select(r => new SalesListItem
        {
            OrderId = r.ReturnId,
            OrderDate = r.ReturnDate,
            OrderNo = r.ReturnNo,
            PartnerId = r.PartnerId,
            PartnerName = r.PartnerName,
            // 🔴 화면에는 (−)로 보인다. 저장은 양수다(원장이 음수를 안 받는다) —
            //   부호를 여기 표시 계층에서 붙이는 것이 20260831 아키텍처 판정이다.
            TotalAmount = -Math.Abs(r.TotalAmount),
            VatAmount = -Math.Abs(r.VatAmount),
            Status = r.Status,
            CreatedByName = r.CreatedByName,
            IsReturn = true,
            SourceDeliveryId = r.DeliveryId,
            SourceDeliveryNo = !string.IsNullOrWhiteSpace(r.DeliveryId)
                               && noByDeliveryId.TryGetValue(r.DeliveryId!, out var srcNo)
                               ? srcNo
                               : null
        }).ToList();

        // 사슬 배치 — 원전표 바로 다음 줄에 그 반품들을 끼워 넣는다.
        var bySource = returnRows
            .Where(r => !string.IsNullOrWhiteSpace(r.SourceDeliveryId))
            .GroupBy(r => r.SourceDeliveryId!)
            .ToDictionary(g => g.Key, g => g.OrderBy(x => x.OrderNo).ToList());

        var merged = new List<SalesListItem>();
        foreach (var s in sales)
        {
            merged.Add(s);
            if (bySource.TryGetValue(s.OrderId, out var children))
            {
                merged.AddRange(children);   // ← 원전표 바로 아래
            }
        }

        // 원전표를 못 찾은 반품(기간 밖·직접작성)은 사라지면 안 된다 — 제 날짜 자리에 둔다.
        var orphans = returnRows
            .Where(r => string.IsNullOrWhiteSpace(r.SourceDeliveryId)
                        || !bySource.ContainsKey(r.SourceDeliveryId!)
                        || !noByDeliveryId.ContainsKey(r.SourceDeliveryId!))
            .ToList();
        if (orphans.Count > 0)
        {
            merged.AddRange(orphans);
            merged = merged.OrderByDescending(x => x.OrderDate).ToList();

            // 날짜 정렬 후에도 사슬은 유지한다 — 다시 붙인다.
            var rebuilt = new List<SalesListItem>();
            foreach (var row in merged.Where(x => !x.IsReturn))
            {
                rebuilt.Add(row);
                if (bySource.TryGetValue(row.OrderId, out var kids))
                {
                    rebuilt.AddRange(kids);
                }
            }
            rebuilt.AddRange(orphans.Where(o => !rebuilt.Contains(o)));
            merged = rebuilt;
        }

        Items = merged;
        AllChecked = false;
    }

    private void ToggleAll(bool val)
    {
        AllChecked = val;
        foreach (var item in Items.Where(x => !x.IsProcessed))
        {
            item.IsChecked = val;
        }
    }

    private void OnCheck(SalesListItem item, bool val)
    {
        item.IsChecked = val;
        AllChecked = Items.Where(x => !x.IsProcessed).All(x => x.IsChecked);
    }

    /// <summary>행 더블클릭 시 해당 문서를 선택하여 닫는다.</summary>
    private void SelectRow(SalesListItem item)
    {
        MudDialog.Close(DialogResult.Ok(item));
    }

    /// <summary>
    /// 체크한 1건을 호출부로 돌려준다 (20260825작8).
    /// </summary>
    /// <remarks>
    /// <para>
    /// 사장님 실측 반려: <i>"반품확인서 → 판매불러오기 클릭시 판매 못불러옴"</i>.
    /// </para>
    /// <para>
    /// 🔴 <b>더블클릭을 아는 사람만 쓸 수 있는 화면은 못 쓰는 화면이다.</b>
    /// <i>"처음 보는 사람이 혼자 쓸 수 있냐"</i> 가 통과 기준이다.
    /// 체크박스가 보이는데 그 체크가 아무 일도 안 하면, 사용자는 고장 났다고 판단한다.
    /// </para>
    /// <para>
    /// 더블클릭 경로(<see cref="SelectRow"/>)와 <b>같은 값</b>을 돌려준다 —
    /// 두 벌로 갈라지면 한쪽만 고쳐지는 날이 온다(작7 교훈).
    /// </para>
    /// </remarks>
    private void SelectChecked()
    {
        var picked = Items.FirstOrDefault(x => x.IsChecked);
        if (picked is null) return;
        MudDialog.Close(DialogResult.Ok(picked));
    }

    /// <summary>
    /// 「선택」 가능 = 정확히 1건만 체크됨 (20260825작8).
    /// </summary>
    /// <remarks>
    /// 여러 건을 고르면 어느 거래를 불러올지 알 수 없다.
    /// 반품확인서는 <c>sales_returns.delivery_id</c> 가 단일 FK 라 어차피 1건만 붙는다.
    /// </remarks>
    private bool CanSelectOne => Items.Count(x => x.IsChecked) == 1;

    private async Task IssueInvoiceAsync()
    {
        var checkedItems = Items.Where(x => x.IsChecked && !x.IsReturn && x.Status == "draft").ToList();
        if (checkedItems.Count == 0) return;

        // 🔴 20260831 — 제목이 「계산서 발행」이었는데 실제 동작은 BulkConfirmAsync(판매확정)였다.
        //   이름이 거짓말을 하고 있었다(사장님 실측 반려 1). 하는 일 그대로 부른다.
        var result = await DialogService.ShowMessageBoxAsync(
            "판매확정",
            $"선택한 {checkedItems.Count}건을 판매확정 처리하시겠습니까?\n"
            + "확정하면 재고가 나가고 미수금이 잡힙니다.",
            yesText: "판매확정",
            cancelText: "취소");
        if (result != true) return;

        try
        {
            var ids = checkedItems.Select(x => x.OrderId).ToList();
            var resp = await DeliveryService.BulkConfirmAsync(ids);
            var successSet = resp.Success.ToHashSet(StringComparer.OrdinalIgnoreCase);

            // 성공한 것만 UI 상태 업데이트. 실패는 상태 유지 + 사유 노출.
            foreach (var item in checkedItems)
            {
                if (successSet.Contains(item.OrderId))
                {
                    item.Status = "confirmed";
                    item.IsChecked = false;
                }
            }

            AllChecked = false;

            if (successSet.Count > 0)
            {
                Snackbar.Add($"{successSet.Count}건 확정 완료", Severity.Success);
            }

            if (resp.Failed.Count > 0)
            {
                var first = resp.Failed[0];
                Snackbar.Add($"{resp.Failed.Count}건 확정 실패 — {first.Reason ?? "알 수 없는 오류"}", Severity.Error);

                // 사장님 지시 (2026-04-26): 재고 부족으로 확정 실패한 건이 있으면
                // 자동발주 후보를 모아 한 번에 다이얼로그로 묻고 OK 시 발주서 생성.
                var stockShortageIds = resp.Failed
                    .Where(f => (f.Reason ?? string.Empty).Contains("재고")
                                && (f.Reason ?? string.Empty).Contains("부족"))
                    .Select(f => f.Id)
                    .Where(id => !string.IsNullOrWhiteSpace(id))
                    .Select(id => id!)
                    .ToList();
                if (stockShortageIds.Count > 0)
                {
                    await PromptAutoOrderForFailedAsync(stockShortageIds);
                }
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"확정 처리 중 오류: {ex.Message}", Severity.Error);
        }
    }

    /// <summary>
    /// 선택 삭제 — 사장님 지시 (2026-04-26): 판매확정 되더라도 전자계산서 발행 전엔
    /// 삭제 가능. 권한은 AuthorizeView 로 tenant_admin / sales_manager 등에 제한.
    /// 서버 DELETE /api/sales/deliveries/{id} 가 자체적으로:
    ///   - tax_invoices 발행 레코드 있으면 거부
    ///   - draft → cancelled 표시
    ///   - confirmed → Reverse 원장 발행 후 cancelled
    /// </summary>
    private async Task BulkDeleteAsync()
    {
        var targets = Items.Where(x => x.IsChecked && !x.IsReturn && x.Status != "invoiced").ToList();
        if (targets.Count == 0) return;

        // 사장님 지시 (2026-04-26): "취소가 곧 삭제고, 삭제가 곧 취소".
        // 현장 직원 친화 문구로 통일 — 재고/회계 reverse 같은 기술 용어 제외.
        var ok = await DialogService.ShowMessageBoxAsync(
            "거래명세서 삭제",
            $"선택한 {targets.Count}건을 삭제하시겠습니까?\n\n" +
            "해당 목록을 삭제하시면, 해당 거래목록도 취소로 반영됩니다.\n" +
            "(계산서 발행된 거래는 자동으로 제외됩니다.)",
            yesText: "삭제", cancelText: "취소");
        if (ok != true) return;

        var success = 0;
        var failed = new List<(string No, string Reason)>();
        foreach (var t in targets)
        {
            var r = await DeliveryService.DeleteAsync(t.OrderId);
            if (r) success++;
            else failed.Add((t.OrderNo, "서버 거부"));
        }

        if (success > 0) Snackbar.Add($"{success}건 삭제 완료.", Severity.Success);
        if (failed.Count > 0)
        {
            Snackbar.Add($"{failed.Count}건 삭제 실패: {failed[0].No} ({failed[0].Reason})", Severity.Warning);
        }

        await Search();
    }

    /// <summary>
    /// 일괄 확정 실패한 거래명세서들의 자동발주 후보를 합쳐 다이얼로그로 묻고,
    /// OK 시 발주서를 한 번에 생성한다 (§20 워크플로우 끊김 금지).
    /// </summary>
    private async Task PromptAutoOrderForFailedAsync(List<string> deliveryIds)
    {
        var allCandidates = new List<HitPan.Web.Models.AutoOrderCandidateModel>();
        foreach (var id in deliveryIds)
        {
            var list = await DeliveryService.GetAutoOrderCandidatesAsync(id);
            foreach (var c in list)
            {
                if (!allCandidates.Any(x => x.ItemId == c.ItemId))
                {
                    allCandidates.Add(c);
                }
            }
        }
        if (allCandidates.Count == 0) return;

        var outOfStock = allCandidates.Count(c => c.Reason == "out_of_stock");
        var belowSafety = allCandidates.Count - outOfStock;

        var msg = new System.Text.StringBuilder();
        msg.AppendLine($"재고 부족으로 확정 실패한 거래명세서 {deliveryIds.Count}건이 있습니다.");
        msg.AppendLine();
        if (outOfStock > 0) msg.AppendLine($"재고가 없는 품목: {outOfStock}건");
        if (belowSafety > 0) msg.AppendLine($"안전재고 이하 품목: {belowSafety}건");
        msg.AppendLine();
        foreach (var c in allCandidates.Take(5))
        {
            msg.AppendLine($"• {c.ItemName}: 현재고 {c.CurrentQty:N0} / 안전재고 {c.SafetyQty:N0}"
                + (string.IsNullOrWhiteSpace(c.PartnerName) ? " (공급처 미설정)" : $" → {c.PartnerName}"));
        }
        if (allCandidates.Count > 5) msg.AppendLine($"... 외 {allCandidates.Count - 5}건");
        msg.AppendLine();
        msg.AppendLine("[자동발주+매입처리] 발주서 생성 후 매입확정까지 진행 (재고 즉시 +반영)");
        msg.AppendLine("[발주서만] 발주서만 생성, 매입은 수동");

        var choice = await DialogService.ShowMessageBoxAsync(
            "⚠ 재고부족 자동발주",
            msg.ToString(),
            yesText: "자동발주+매입처리",
            noText: "발주서만",
            cancelText: "취소");
        if (choice is null) return;

        var autoReceive = choice == true;
        var results = await DeliveryService.CreateAutoOrdersAsync(allCandidates, autoReceive);
        var success = results.Where(r => r.Success).ToList();
        var failed = results.Where(r => !r.Success).ToList();

        if (success.Count > 0)
        {
            var noList = string.Join(", ", success.Select(r => r.PoNo));
            Snackbar.Add($"자동발주서 {success.Count}건 생성 완료: {noList}", Severity.Success);
        }
        if (failed.Count > 0)
        {
            var firstReason = failed[0].Reason ?? "사유 미상";
            Snackbar.Add($"{failed.Count}건 자동발주 실패: {firstReason[..Math.Min(150, firstReason.Length)]}", Severity.Warning);
        }
    }

    /// <summary>
    /// 🔴 20260831 (사장님 실측 반려 1) — <b>계산서 발행</b>.
    /// 판매확정(confirmed) 건을 골라 세금계산서 화면으로 넘긴다.
    ///
    /// <para>
    /// ⚠️ 여기서 계산서를 <b>끊지 않는다</b> — 발행은 세금계산서 화면의 일이다.
    /// 이 버튼은 <b>그 화면으로 데려다주는 것</b>까지만 한다. 할 수 있는 것만 한다고 말한다.
    /// </para>
    /// </summary>
    private async Task IssueElectronic()
    {
        var checkedItems = Items.Where(x => x.IsChecked && !x.IsReturn && x.Status == "confirmed").ToList();
        if (checkedItems.Count == 0)
        {
            Snackbar.Add("판매확정된 건만 계산서를 발행할 수 있습니다.", Severity.Warning);
            return;
        }

        var result = await DialogService.ShowMessageBoxAsync(
            "계산서 발행",
            $"선택한 {checkedItems.Count}건을 세금계산서 화면에서 발행합니다. 이동하시겠습니까?",
            yesText: "이동",
            cancelText: "취소");
        if (result != true) return;

        // 거래처·기간을 프리셋해 담당자가 다시 찾지 않게 한다.
        var partner = Uri.EscapeDataString(checkedItems[0].PartnerName ?? string.Empty);
        var from = checkedItems.Min(x => x.OrderDate).ToString("yyyy-MM-dd");
        var to = checkedItems.Max(x => x.OrderDate).ToString("yyyy-MM-dd");

        MudDialog.Close(DialogResult.Ok(true));
        Nav.NavigateTo($"/tax-invoice?partner={partner}&from={from}&to={to}");
    }

    /// <summary>
    /// 🔴 20260831 — <b>전자발행</b> (국세청 전송).
    ///
    /// <para>
    /// 🔴 <b>아직 배선이 없다.</b> 5축 전수조사 실측 — <c>etax_status</c> 를 움직이는 코드가 0건이다.
    /// 종전 버튼은 <i>"전자발행 처리하시겠습니까"</i> 라고 묻고 <b>[예] 를 눌러도 아무 일도 하지 않았다</b>
    /// (목록만 새로고침). 담당자는 국세청에 나간 줄 안다 — 그게 더 위험하다.
    /// </para>
    ///
    /// <para>
    /// ⇒ <b>안 되는 것을 안 된다고 말한다.</b> 되는 척하지 않는다.
    /// 국세청 전송 배선은 계산서 파트(다음 차례)에서 한다.
    /// </para>
    /// </summary>
    private Task IssueElectronicTaxAsync()
    {
        Snackbar.Add("전자발행(국세청 전송)은 아직 준비 중입니다. 계산서 발행까지 진행해 주세요.",
                     Severity.Info);
        return Task.CompletedTask;
    }


    private void Close()
    {
        MudDialog.Close(DialogResult.Cancel());
    }

    private Color GetStatusColor(string status) => status switch
    {
        "confirmed" => Color.Success,
        "invoiced" => Color.Primary,
        "draft" => Color.Default,
        "quotation" => Color.Warning,
        "order" => Color.Info,
        "cancelled" => Color.Error,
        _ => Color.Default
    };

    // 🔴 20260828작14 W4 (사장님 결재 7) — 판매라인 어휘 통일.
    //   수주완료 → 판매완료 → 판매확정 → 계산서발행 → 전자발행
    //   draft 는 "임시" 가 아니라 "판매완료" 다 — 거래명세서를 작성·저장한 상태이고
    //   원장에는 아직 아무것도 안 갔다. 그 차이가 곧 되돌리기 방법의 차이(삭제 / 취소)다.
    //   ⚠️ 이 화면은 목록 전용 코드값(quotation·order)을 함께 쓰므로 공용 헬퍼로 통째 위임하지 않고
    //      여기서 가른다. DB enum 은 한 글자도 안 바꾼다(마이그 0).
    private string GetStatusLabel(string status) => status switch
    {
        "confirmed" => "판매확정",
        "invoiced"  => "계산서발행",
        "etax"      => "전자발행",
        "draft"     => "판매완료",
        "quotation" => "견적",
        "order"     => "수주완료",
        "cancelled" => "취소",
        _ => status
    };

    /// <summary>
    /// 🔴 20260903작16 — <b>반품 줄은 어휘가 다르다.</b>
    /// </summary>
    /// <remarks>
    /// 같은 <c>draft</c>·<c>confirmed</c> 라도 판매에서는 「판매완료·판매확정」이지만
    /// 반품에서는 <b>「반품완료·반품확정」</b>이다. 한 사전으로 처리하면
    /// 반품 줄에 <i>"판매완료"</i> 가 떠서 <b>정반대로 읽힌다.</b>
    /// ⚠️ 철자 주의 — <c>sales_returns</c> 는 취소를 <c>canceled</c>(l 하나)로 쓰고
    /// <c>sales_deliveries</c> 는 <c>cancelled</c>(l 둘)라 둘 다 받는다.
    /// </remarks>
    private string GetRowStatusLabel(SalesListItem item)
        => item.IsReturn
            ? item.Status switch
            {
                "draft"                   => "반품완료",
                "confirmed"               => "반품확정",
                "canceled" or "cancelled" => "반품취소",
                _ => GetStatusLabel(item.Status)
            }
            : GetStatusLabel(item.Status);

    /// <summary>금액 칸 — 마이너스 전표는 (−) 빨강으로 낸다. 눈으로 즉시 갈린다.</summary>
    private static string AmountStyle(SalesListItem item)
        => "text-align:right;" + (item.IsReturn ? "color:#B91C1C;font-weight:600;" : string.Empty);

    private string RowStyle(SalesListItem item, int index)
        => "height:36px;font-size:13px;" + (item.IsProcessed ? "color:#9CA3AF;" : string.Empty);
