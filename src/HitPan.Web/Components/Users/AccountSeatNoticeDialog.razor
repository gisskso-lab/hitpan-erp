@namespace HitPan.Web.Components.Users
@using HitPan.Web.Services
@* 20261005작3 §5 — 「계정 추가 구독 안내」 창. 구매 연결·링크 0(D-5) · 가격 한 줄(D-16 · AccountPricing 한 곳).
   차서 막혔을 때와 [구독계정추가] 버튼으로 열 때 **같은 창** — 첫 줄만 다르다. 개발 용어 노출 0. *@
<MudDialog @bind-Visible="VisibleProxy" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.GroupAdd" Color="Color.Primary" Class="mr-1" /> 계정 추가 구독 안내
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body1" Class="mb-2" Style="font-weight:600">@FirstLine</MudText>
        <MudText Typo="Typo.body2" Class="mb-3">
            지금 @(Active)개 / 한도 @(Limit)개를 쓰고 있습니다. 계정을 더 쓰려면 계정 추가 구독이 필요합니다.
            계정 추가 구독 신청은 곧 이 창에서 바로 할 수 있도록 준비 중입니다.
        </MudText>
        <MudPaper Elevation="0" Class="pa-3" Style="background:var(--mud-palette-background-grey);border-radius:8px">
            <MudText Typo="Typo.body2" Style="font-weight:600">@AccountPricing.ExtraAccountLine</MudText>
        </MudPaper>
        <MudText Typo="Typo.caption" Class="mt-3" Style="color:var(--mud-palette-text-secondary)">
            「사용 안 함」이나 「계정폐기」로 바꾼 계정은 한도에서 빠집니다.
        </MudText>
        @* 20261005작5 A · P-5 — 막혀 열렸을 때 다음 걸음. 구독계정추가 권한(3단계)이 있으면 버튼, 없으면 누구에게 말할지.
           CanSubscribe 를 안 준 곳(작3 화면)은 종전 그대로다. *@
        @if (Blocked && CanSubscribe is not null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">
                계정을 추가 구매하세요.
                @if (CanSubscribe == false)
                {
                    <br />
                    <span>대표님께 계정 추가를 요청하세요.</span>
                }
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        @* ⬛ [작5 §8-8 V5-16 전] Blocked && CanSubscribe == true 이면 [구독계정추가] 버튼(OnClick=SubscribeAsync) —
           눌러도 같은 「계정 추가 구독 안내」 창이 첫 줄만 바뀌어 다시 떴다(같은 창 반복).
           구독 신청이 열리기 전까지는 버튼 대신 한 줄 안내. OnSubscribe 매개변수는 부모 화면 호환을 위해 둔다. *@
        @if (Blocked && CanSubscribe == true)
        {
            <MudText Typo="Typo.body2" Class="mr-auto ml-2" Style="color:var(--mud-palette-text-secondary)">
                구독 계정 추가는 준비 중입니다. 본사 안내 후 열립니다.
            </MudText>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CloseAsync">닫기</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    /// <summary>true = 한도가 차서 막혀 열림 · false = [구독계정추가] 버튼으로 열림</summary>
    [Parameter] public bool Blocked { get; set; }
    [Parameter] public int Active { get; set; }
    [Parameter] public int Limit { get; set; }

    /// <summary>20261005작5 — null = 종전(작3) 그대로 · true = [구독계정추가] 버튼 · false = 「대표님께 계정 추가를 요청하세요」.</summary>
    [Parameter] public bool? CanSubscribe { get; set; }

    /// <summary>[구독계정추가]를 눌렀을 때 — 부모 화면이 숫자를 다시 읽고 이 창을 「안내」 모양으로 바꾼다.</summary>
    [Parameter] public EventCallback OnSubscribe { get; set; }

    // ⬛ 작5 §8-8 V5-16 — 지금은 이 창에서 부르지 않는다(구독 신청이 열리면 버튼과 함께 다시 잇는다).
    private async Task SubscribeAsync() => await OnSubscribe.InvokeAsync();

    private string FirstLine => Blocked
        ? $"계정 사용 한도({Limit}개)가 찼습니다."
        : $"지금 {Active}개 / 한도 {Limit}개를 쓰고 있습니다.";

    private bool VisibleProxy
    {
        get => Visible;
        set
        {
            if (value == Visible) return;
            Visible = value;
            _ = VisibleChanged.InvokeAsync(value);
        }
    }

    private async Task CloseAsync()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
    }
}
