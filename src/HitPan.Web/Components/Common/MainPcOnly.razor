@* 메인PC(자료보관 컴퓨터)에서 열었을 때만 안쪽 내용을 보여준다.

   🔴 2026-08-11 (사장님 지시): *"자료관리는 **부모계정 + 메인PC 환경에서만** 돌도록"*

   [왜 필요한가] 백업·복구·자료이관·모든데이터 초기화는 **자료가 실제로 들어 있는
     그 컴퓨터**에서 해야 하는 일이다. 다른 자리에서 원격으로 남의 회사 자료를
     지우거나 되돌릴 수 있으면 안 된다.

   [판정은 서버가 한다] 브라우저에게 "너 메인PC냐" 고 묻지 않는다 —
     그건 얼마든지 그렇다고 답할 수 있다. 서버가 접속해 들어온 자리를 직접 본다.

   ⚠️ 이것만으로 막았다고 하지 않는다. 화면을 감추는 것은 **차단이 아니다.**
     자료를 실제로 건드리는 일은 서버에서도 같은 판정으로 막아야 한다.
*@
@inject HttpClient Http
@inject ILogger<MainPcOnly> _logger

@if (_checking)
{
    <div class="d-flex justify-center pa-6">
        <MudProgressCircular Indeterminate="true" Size="Size.Medium" />
    </div>
}
else if (_isMainPc)
{
    @ChildContent
}
else
{
    <MudPaper Elevation="0" Class="pa-6" Style="text-align:center;">
        <MudIcon Icon="@Icons.Material.Filled.Computer" Color="Color.Warning"
                 Style="font-size:48px;" Class="mb-3" />
        <MudText Typo="Typo.h6" Class="mb-2">자료보관 컴퓨터에서만 사용할 수 있습니다</MudText>
        <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary)">
            이 기능은 회사 자료가 들어 있는 컴퓨터에서만 열 수 있습니다.<br />
            히트판이 설치된 그 컴퓨터에서 다시 열어 주세요.
        </MudText>
    </MudPaper>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// 🔴 <b>통과한 뒤에야 부른다</b> — 20260924작1 절D.
    /// </summary>
    /// <remarks>
    /// 종전에는 화면이 <c>OnInitializedAsync</c> 에서 곧바로 조회를 쐈다. 그 조회는
    /// 자료보관 컴퓨터에서만 열리는 문이라, 클라이언트 PC 에서는 <b>매번 403 이 쌓였고</b>
    /// 메인PC 에서도 왕복이 끝나기 전에 쏘면 한 번 튕겼다.
    /// ⚠️ 이것은 <b>차단이 아니라 소음·깜빡임 제거</b>다. 서버 판정은 그대로 둔다.
    /// </remarks>
    [Parameter] public EventCallback OnAllowed { get; set; }

    // 🔴 판정·호출 규칙은 MainPcAccessState 한 곳에 있다 — 게이트 G-27 이 그것을 직접 세어 본다.
    private readonly MainPcAccessState _access = new();

    private bool _checking => _access.Checking;
    private bool _isMainPc => _access.IsMainPc;

    protected override async Task OnInitializedAsync()
    {
        await _access.ResolveAsync(
            async () =>
            {
                var r = await Http.GetFromJsonAsync<MainPcResult>("api/devices/is-main-pc");
                return r?.IsMainPc ?? false;
            },
            OnAllowed.HasDelegate ? () => OnAllowed.InvokeAsync() : null,
            // 못 물어봤으면 **안 보여준다.** 확인이 안 된 상태에서 열어주면
            // 막은 적이 없는 것과 같다. (#15 — 조용히 넘어가지 않는다)
            ex => _logger.LogWarning(ex, "자료보관 컴퓨터 여부를 확인하지 못했습니다 — 잠근 채로 둡니다."));
    }

    private sealed class MainPcResult
    {
        public bool IsMainPc { get; set; }
    }
}
