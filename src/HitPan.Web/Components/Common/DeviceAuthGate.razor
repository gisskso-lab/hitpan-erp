@* 기기 인증 게이트 — 인증되지 않은 기기의 화면을 덮는다 (20260811작3 (A))

   사장님 원문 (2026-08-11):
     "인증키가 없어 인증할 수 없는 슬롯은
        로그인만 되고 화면은 비활성화 그리고
        비활성화된 화면에 '인증된 기기가 아닙니다. 히트판 관리자에게 문의하세요.' 안내"
     "메인PC에서 인증키가 생성되면, 요청한 클라이언트PC에서 입력하는 방식.
      그 메인PC에서 키를 주는 방식은 대표 마음이지."

   🔴 로그인은 막지 않는다. 화면만 덮는다.
      로그인부터 막으면 직원은 뭐가 잘못됐는지 모르고 전화한다.
*@
@using HitPan.Web.Services
@using Microsoft.AspNetCore.Components.Web
@implements IDisposable
@inject HttpClient Http
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject ILogger<DeviceAuthGate> _logger

@if (_awaitingApproval)
{
    @* ── 🔴 승인 대기 관문 (20260816작2 · 사장님 전결) ──────────────────────
       사장님 설계: 로그인 → [디바이스 인증] → 히트판 ERP.
         "등록되지 않은 기기입니다. 등록을 하시겠습니까?"
           → 메인PC 에 "0000기기가 등록을 요청합니다" → 대표 Y/N

       이 기기는 이미 로그인은 통과했고 `pending` 으로 들어와 있다(= 신청은 끝났다).
       여기서는 **대표가 누를 때까지 기다린다.** 슬롯은 아직 안 먹는다.
    *@
    <div class="hp-device-gate">
        <MudPaper Elevation="8" Class="pa-6" Style="max-width:460px;width:100%;">
            <div class="d-flex align-center mb-4">
                <MudIcon Icon="@Icons.Material.Filled.HourglassTop" Color="Color.Primary"
                         Style="font-size:32px;" Class="mr-2" />
                <MudText Typo="Typo.h6">기기 등록을 요청했습니다</MudText>
            </div>

            <MudText Typo="Typo.body1" Class="mb-2">
                대표님 컴퓨터에서 <b>등록을 허락</b>하면 바로 시작됩니다.
            </MudText>

            @if (!string.IsNullOrEmpty(_confirmCode))
            {
                @* 🔴 대표 화면에도 같은 번호가 뜬다 — 대표가 눈으로 대조한다(사장님 결재).
                     같은 기종이 여러 대여도 이 번호로 어느 것인지 갈린다. *@
                <MudPaper Outlined="true" Class="pa-4 my-4 d-flex flex-column align-center">
                    <MudText Typo="Typo.body2" Class="mb-1">확인 번호</MudText>
                    <MudText Typo="Typo.h3" Color="Color.Primary"
                             Style="letter-spacing:.35rem;font-weight:700;">@_confirmCode</MudText>
                    <MudText Typo="Typo.caption" Class="mt-2" Align="Align.Center">
                        대표님 화면에 같은 번호가 보이면 그것이 이 기기입니다.
                    </MudText>
                </MudPaper>
            }

            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                이 화면을 열어 두시면 허락되는 즉시 넘어갑니다.
            </MudAlert>

            <MudButton Variant="Variant.Text" Color="Color.Default" FullWidth="true"
                       Disabled="_checking" OnClick="CheckGateAsync">
                @if (_checking)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>확인하는 중…</span>
                }
                else
                {
                    <span>지금 확인</span>
                }
            </MudButton>
        </MudPaper>
    </div>
}
else if (_blocked)
{
    <div class="hp-device-gate">
        <MudPaper Elevation="8" Class="pa-6" Style="max-width:460px;width:100%;">
            <div class="d-flex align-center mb-4">
                <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Warning"
                         Style="font-size:32px;" Class="mr-2" />
                <MudText Typo="Typo.h6">인증된 기기가 아닙니다</MudText>
            </div>

            <MudText Typo="Typo.body1" Class="mb-4">
                히트판 관리자에게 문의하세요.
            </MudText>

            <MudDivider Class="my-4" />

            @* 관리자에게 번호를 받았으면 여기서 넣는다 *@
            <MudText Typo="Typo.body2" Class="mb-2">
                관리자에게 <b>인증 번호</b>를 받으셨나요? 아래에 넣어 주세요.
            </MudText>

            <MudTextField @bind-Value="_inputKey"
                          Label="인증 번호"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Disabled="_verifying"
                          OnKeyDown="OnKeyDown"
                          Class="mb-3" />

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3">@_error</MudAlert>
            }

            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       Disabled="_verifying || string.IsNullOrWhiteSpace(_inputKey)"
                       OnClick="VerifyAsync">
                @if (_verifying)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>확인하는 중…</span>
                }
                else
                {
                    <span>확인</span>
                }
            </MudButton>
        </MudPaper>
    </div>
}

@code {
    /// 🔴 20260818작1 (증상③) — **관문이 켜져 있음을 부모(MainLayout)에게 알린다.**
    ///
    ///   [왜 필요한가] 종전엔 이 관문이 `<main>` 과 **형제**였다. 관문이 떠도
    ///     그 아래 본문은 **무조건 렌더**돼서, 화면은 덮이는데 **뒤에서 업무 API 가 계속 돌았다.**
    ///     ⇒ CSS 로 가린 것이지 막은 것이 아니었다.
    ///
    ///   [고침] 이 값이 true 가 되면 MainLayout 이 **본문을 아예 그리지 않는다.**
    ///     안 그리면 그 페이지의 초기화가 안 돌고 **API 호출도 일어나지 않는다.**
    ///
    ///   ⚠️ 승인된 기기에서는 이 값이 **항상 false** 라 종전과 똑같은 화면이 나온다.
    [Parameter] public bool GateActive { get; set; }
    [Parameter] public EventCallback<bool> GateActiveChanged { get; set; }

    private bool _blocked;
    private bool _verifying;
    private string _inputKey = "";
    private string? _error;

    /// 관문 상태가 바뀌면 부모에게 알린다 — 알리지 않으면 본문이 계속 렌더된다.
    private async Task SyncGateActiveAsync()
    {
        var active = _awaitingApproval || _blocked;
        if (active == GateActive) return;

        GateActive = active;
        await GateActiveChanged.InvokeAsync(active);
    }

    // ── 🔴 승인 대기 관문 (20260816작2) ──
    private bool _awaitingApproval;
    private bool _checking;
    private string? _confirmCode;
    private System.Threading.Timer? _poll;

    protected override async Task OnInitializedAsync()
    {
        _blocked = DeviceAuthState.IsBlocked;
        _awaitingApproval = DeviceAuthState.IsAwaitingApproval;
        DeviceAuthState.Changed += OnStateChanged;

        // 🔴 2026-08-18 20260816작2 P0 봉합 — **메모리 표시만 믿으면 관문이 안 뜬다** (사장님 실측 반려).
        //
        //   [무엇이 났나] Login.razor 가 MarkAwaitingApproval() 로 표시를 켠 **바로 다음 줄**에서
        //     `NavigateTo("/", forceLoad: true)` 를 부른다. forceLoad 는 **브라우저를 통째로 다시 읽는다.**
        //     그 순간 앱이 새로 시작되고 DeviceAuthState 는 **정적 메모리 변수**라 **초기화된다.**
        //     ⇒ 켠 표시가 한 줄 뒤에 증발한다. 관문이 뜰 수가 없었다.
        //
        //   [왜 게이트가 못 잡았나] G-28 은 *"로그인 화면이 MarkAwaitingApproval 을 부르는가"* 만 봤다.
        //     **부르는 것과 그 값이 살아남는 것은 다른 일이다.** 글자는 있는데 동작이 없었다.
        //
        //   [고침] 화면이 뜰 때 **서버에 직접 묻는다.** 메모리가 날아가도 서버는 안 잊는다.
        //     ⚠️ 이 한 번의 물음이 관문의 진실원이다 — 메모리는 거들 뿐이다.
        if (!_awaitingApproval && !_blocked)
            await CheckGateAsync(initialProbe: true);

        if (_awaitingApproval) StartPolling();

        // 🔴 관문 상태를 부모에게 알린다 — 안 알리면 본문이 계속 렌더된다(증상③).
        await SyncGateActiveAsync();
    }

    private void OnStateChanged() => InvokeAsync(async () =>
    {
        _blocked = DeviceAuthState.IsBlocked;

        var wasAwaiting = _awaitingApproval;
        _awaitingApproval = DeviceAuthState.IsAwaitingApproval;

        if (_awaitingApproval && !wasAwaiting) StartPolling();
        else if (!_awaitingApproval && wasAwaiting) StopPolling();

        await SyncGateActiveAsync();
        StateHasChanged();
    });

    /// 대표가 [예] 를 누르는 순간 넘어가야 한다 — 직원이 새로고침을 반복하게 두지 않는다.
    ///   ⚠️ 간격을 너무 좁히면 대기 중인 기기가 서버를 계속 두드린다. 3초면 사람이 기다릴 만하다.
    private void StartPolling()
    {
        StopPolling();
        _poll = new System.Threading.Timer(
            async _ => await InvokeAsync(CheckGateAsync),
            null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
    }

    private void StopPolling()
    {
        _poll?.Dispose();
        _poll = null;
    }

    /// 이 기기 지금 쓸 수 있나 — 서버에 묻는다.
    private Task CheckGateAsync() => CheckGateAsync(false);

    private async Task CheckGateAsync(bool initialProbe)
    {
        if (_checking) return;
        _checking = true;

        try
        {
            var deviceId = await JS.InvokeAsync<string?>("hitpanDevice.getDeviceId");
            var url = string.IsNullOrWhiteSpace(deviceId)
                ? "api/devices/gate-status"
                : $"api/devices/gate-status?deviceId={Uri.EscapeDataString(deviceId)}";

            var body = await Http.GetFromJsonAsync<GateStatus>(url);
            if (body is null) return;

            _confirmCode = body.ConfirmCode;

            if (!body.Approved && initialProbe)
            {
                // 🔴 서버가 "아직 아니다" 라고 답했다 — 관문을 켠다.
                //   메모리 표시가 forceLoad 로 날아갔어도 이 물음이 되살린다.
                //   ⚠️ 여기서 안 켜면 미승인 기기가 그대로 ERP 로 들어간다(사장님 실측 반려 자리).
                DeviceAuthState.MarkAwaitingApproval();
                _awaitingApproval = true;
                StartPolling();
                // 🔴 본문 렌더를 여기서 끊는다 — 알리지 않으면 미승인 기기 뒤에서 업무 API 가 돈다.
                await SyncGateActiveAsync();
                return;
            }

            if (body.Approved)
            {
                // ══════════════════════════════════════════════════════════════
                // 🔴 2026-08-18 P0 — **화면이 처음 뜰 때의 물음에는 새로고침하지 않는다.**
                //   (사장님 1.2.84 실측: 로그인 → 로딩 → 메인 → 인증화면 **무한 반복**)
                //
                //   [무엇이 났나] 아래 `location.reload` 에 조건이 없었다. 그래서 **이미 승인된 기기**도
                //     화면이 뜰 때마다 새로고침을 당했고, 새로고침은 앱을 다시 시작시킨다.
                //
                //       앱 시작 → 정적 상태 초기화 → 처음 물음 → "승인됨" → reload
                //         → 앱 시작 → 정적 상태 초기화 → 처음 물음 → "승인됨" → reload → …
                //
                //     ⇒ **끝나지 않는다.** 메인PC 처럼 진작 승인된 기기가 가장 먼저 걸린다.
                //
                //   [왜 새로고침이 필요했나] 관문에 **막혀 있는 동안** 화면 뒤의 자료 요청이 막힌다.
                //     대표가 [예] 를 누른 그 순간, 못 받은 자료를 받아 오려고 한 번 새로 읽는 것이다.
                //     ⇒ 🔴 **그것은 "기다리다 풀린" 경우에만 필요하다.** 처음부터 승인돼 있었다면
                //       막힌 적이 없으므로 받아 올 것도 없다.
                //
                //   [고침] 폴링으로 풀린 경우(`initialProbe == false`)에만 새로 읽는다.
                //     처음 물음(`initialProbe == true`)은 **상태만 표시하고 조용히 지나간다.**
                //
                //   ⚠️ 게이트는 이것을 못 잡는다 — `location.reload` 는 **브라우저 동작**이라
                //     xUnit 에 재현할 수단이 없다. Playwright 시나리오로 지킨다(§5).
                // ══════════════════════════════════════════════════════════════
                StopPolling();
                DeviceAuthState.MarkAllowed();

                if (!initialProbe)
                {
                    // 기다리다 풀렸다 — 대표가 방금 허락했다. 슬롯은 이 순간 1개 늘었다.
                    Snackbar.Add("기기 등록이 허락되었습니다.", Severity.Success);

                    // 막혀서 못 받은 자료를 이제 받아야 한다.
                    await JS.InvokeVoidAsync("location.reload");
                }
            }
        }
        catch (Exception ex)
        {
            // 통신이 잠시 끊겨도 관문을 풀지 않는다 — 다음 차례에 다시 묻는다.
            _logger.LogWarning(ex, "기기 관문 상태 확인 실패");
        }
        finally
        {
            _checking = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        StopPolling();
        DeviceAuthState.Changed -= OnStateChanged;
    }

    private sealed class GateStatus
    {
        public bool Approved { get; set; }
        public string? ConfirmCode { get; set; }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_verifying && !string.IsNullOrWhiteSpace(_inputKey))
            await VerifyAsync();
    }

    private async Task VerifyAsync()
    {
        if (string.IsNullOrWhiteSpace(_inputKey)) return;

        _verifying = true;
        _error = null;

        try
        {
            // 🔴 20260818작1 (1-1) — **이 세션의 장비넘버를 함께 보낸다.**
            //   서버는 이 번호로 **어느 줄을 대조할지** 정한다. 키가 줄을 고르지 않는다.
            //   ⚠️ 번호가 없으면 서버가 열 줄을 특정할 수 없어 거절한다 — 그것이 옳다.
            //     (종전엔 키만 보내면 서버가 그 키를 가진 **남의 줄**을 찾아 열어줬다)
            var sessionDeviceId = await JS.InvokeAsync<string?>("hitpanDevice.getDeviceId");

            var resp = await Http.PostAsJsonAsync("api/devices/verify-key",
                new { authKey = _inputKey.Trim(), deviceId = sessionDeviceId });

            if (resp.IsSuccessStatusCode)
            {
                var body = await resp.Content.ReadFromJsonAsync<VerifyResult>();

                // 번호가 맞았다 — 이 브라우저에 보관한다. 다음부터는 다시 넣지 않는다.
                await JS.InvokeVoidAsync("hitpanDevice.setAuthKey", _inputKey.Trim());
                if (!string.IsNullOrWhiteSpace(body?.DeviceId))
                    await JS.InvokeVoidAsync("hitpanDevice.setDeviceId", body.DeviceId);

                DeviceAuthState.MarkAllowed();
                Snackbar.Add("기기 인증이 완료되었습니다.", Severity.Success);

                // 화면을 다시 불러온다 — 막혀서 못 불러온 자료를 이제 받아야 한다.
                await JS.InvokeVoidAsync("location.reload");
                return;
            }

            var err = await resp.Content.ReadFromJsonAsync<ApiMessage>();
            _error = err?.Message ?? "인증 번호가 올바르지 않습니다.";
        }
        catch (Exception ex)
        {
            _logger.LogWarning(ex, "기기 인증 번호 확인 실패");
            _error = "지금은 확인할 수 없습니다. 잠시 후 다시 시도해 주세요.";
        }
        finally
        {
            _verifying = false;
        }
    }

    private sealed class VerifyResult
    {
        public string? Message { get; set; }
        public string? DeviceId { get; set; }
    }

    private sealed class ApiMessage
    {
        public string? Message { get; set; }
    }
}
