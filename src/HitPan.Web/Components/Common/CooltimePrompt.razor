@* 🆕 20260928작4 쿨타임 §5-2 — 「설정 시각 자동 로그아웃」 60초 팝업 (갈래 ② · 새 파일).

   사장님 오더: 정한 시각에 PC 로 접속해 있는 직원에게 계속 일할지 묻고, 60초 안에 답이 없으면 로그아웃.
   🔴 판정은 서버가 한다(시각 작업 · 15초) — 이 화면의 숫자는 안내일 뿐이다. 화면이 꺼져 있거나 덮개가 닫혀도
      서버가 끝낸다. 그래서 이 팝업은 「묻고 · 답을 보내고 · 끝났으면 로그인 화면으로」 만 한다.
   🔴 바깥을 눌러도 · Esc 를 눌러도 닫히지 않는다(답을 해야 닫힌다).
   🔴 §E-5 — 팝업 중 받은 401 · 409 · ended:false 는 「끝남」 과 같게 처리한다(로그인 화면 · 서버 문구는 안 보여 줌).
   🆕 11/27 고침 차례(§273 V1 · §275 E-5) — 윗줄을 바꿨다: 401 만 끝남. 409 · ended:false 는 출입증을 지우지 않고
      GET state 로 다시 묻는다(행 없음 · 물음 만료 = 끝남 / 안 물음 = 팝업만 닫음). 다른 탭의 [계속] 은 서버 「계속됨」 푸시로 받는다.
   🔴 끝낼 때 손 로그아웃(`AuthService.LogoutAsync` → api/auth/logout)을 부르지 않는다 — 그 길은 「그 순간 = 퇴근」 을
      적는다. 퇴근은 서버의 자동 로그아웃이 정시 퇴근으로 이미 적었다(설계 §6). 여기서는 이 PC 의 저장소만 비운다. *@
@using Microsoft.JSInterop
@using Microsoft.Extensions.Logging
@using MudBlazor
@using HitPan.Web.Services
@inject NotificationClient Notify
@inject HttpClient Http
@inject HitPanProtectedLocalStorage Storage
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject ILogger<CooltimePrompt> Logger
@implements IDisposable

@if (_open)
{
    <div role="dialog" aria-modal="true" aria-label="@CooltimeScreenRules.PromptTitle"
         style="position:fixed;inset:0;z-index:2000;background:rgba(0,0,0,0.45);display:flex;align-items:center;justify-content:center;padding:16px;">
        <MudPaper Elevation="8" Class="pa-6" Style="max-width:440px;width:100%;border-radius:16px;">
            <MudText Typo="Typo.h6" Style="font-weight:700">@CooltimeScreenRules.PromptTitle</MudText>
            <MudText Class="mt-3">@CooltimeScreenRules.PromptBody</MudText>
            <MudText Class="mt-2" Style="color:var(--mud-palette-error)">@CooltimeScreenRules.PromptWarning</MudText>
            <MudText Class="mt-4" Typo="Typo.subtitle1" Style="font-weight:700">@CooltimeScreenRules.CountdownLine(_secondsLeft)</MudText>
            @if (!string.IsNullOrEmpty(_message))
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">@_message</MudAlert>
            }
            <div style="display:flex;gap:8px;justify-content:flex-end;flex-wrap:wrap;margin-top:20px">
                <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="@_busy" OnClick="LogoutNowAsync">
                    @CooltimeScreenRules.LogoutButton
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_busy" OnClick="ContinueAsync">
                    @CooltimeScreenRules.ContinueButton
                </MudButton>
            </div>
        </MudPaper>
    </div>
}

@code {
    private bool _open;
    private bool _busy;
    private bool _ending;
    private DateTime? _deadlineUtc;
    private int _secondsLeft = CooltimeScreenRules.PromptSeconds;
    private string? _message;
    private CancellationTokenSource? _tick;

    protected override void OnInitialized()
    {
        Notify.OnCooltimePrompt += OnPrompt;
        Notify.OnCooltimeEnded += OnEnded;
        Notify.OnCooltimeContinued += OnContinued;   // 🆕 11/27 고침 차례(§273 V1)

        // 팝업이 붙기 전에 이미 온 것(종이 먼저 연결해 상태를 물었을 때 등)을 놓치지 않는다.
        if (Notify.PendingCooltimeEnded is not null)
        {
            _ = InvokeAsync(EndLocallyAsync);
            return;
        }
        if (Notify.PendingCooltimePrompt is { } pending)
        {
            var elapsed = (int)Math.Floor((DateTime.UtcNow - pending.ReceivedUtc).TotalSeconds);
            Show(Math.Max(0, pending.SecondsLeft - elapsed));
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // 종(NotificationBell)도 부르지만, 모바일 머리글처럼 종이 없는 화면에서도 물음을 받게 한 번 더 부른다(두 번 불러도 안전).
            await Notify.StartAsync();
        }
    }

    private void OnPrompt(int secondsLeft) => _ = InvokeAsync(() => Show(secondsLeft));

    private void OnEnded(string cause) => _ = InvokeAsync(EndLocallyAsync);

    /// <summary>
    /// 🆕 11/27 고침 차례(§273 V1) — 같은 출입증의 다른 탭이 [계속] 했다(서버 「계속됨」 푸시). 이 탭의 팝업도 닫는다.
    /// [계속] 을 누른 그 탭은 이미 닫혀 있어 아무 일도 안 한다.
    /// </summary>
    private void OnContinued() => _ = InvokeAsync(() =>
    {
        if (!_open || _ending) return;
        ClosePopup(CooltimeScreenRules.RecheckClosedNotice);
    });

    /// <summary>🆕 11/27 — 팝업만 닫고 그대로 일한다(출입증은 건드리지 않는다).</summary>
    private void ClosePopup(string notice)
    {
        StopCountdown();
        _open = false;
        _message = null;
        Notify.ClearPendingCooltimePrompt();
        Snackbar.Add(notice, Severity.Success);
        StateHasChanged();
    }

    /// <summary>
    /// 🆕 11/27 고침 차례(§273 V1 · §275 E-5) — 서버가 「안 끝냈다」(<c>ended:false</c> · [계속] 409)고 답했을 때
    /// 출입증을 지우지 않고 <c>GET state</c> 로 다시 묻는다. 끝남이면 로그인 화면 · 아니면 팝업만 닫는다(또는 다시 센다).
    /// </summary>
    private async Task RecheckAsync()
    {
        if (_ending) return;
        StopCountdown();   // 0초에서 멈춘 카운트다운을 치운다(다시 셀 때 새로 시작하게)

        int? status = null;
        string? body = null;
        try
        {
            using var r = await Http.GetAsync(CooltimeScreenRules.StatePath);
            status = (int)r.StatusCode;
            body = await r.Content.ReadAsStringAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "자동 로그아웃 — 상태 다시 확인이 서버에 닿지 못했다(팝업만 닫고 서버 판정에 맡긴다)");
        }

        var s = CooltimeScreenRules.ParseState(body);
        switch (CooltimeScreenRules.AfterRecheck(status, s.Active, s.Asked, s.SecondsLeft))
        {
            case CooltimeScreenRules.RecheckDecision.EndLocally:
                await EndLocallyAsync();
                break;
            case CooltimeScreenRules.RecheckDecision.ShowAgain:
                Show(s.SecondsLeft ?? 0);
                break;
            default:
                ClosePopup(CooltimeScreenRules.RecheckClosedNotice);
                break;
        }
    }

    private void Show(int secondsLeft)
    {
        if (_ending) return;

        var now = DateTime.UtcNow;
        // 이미 떠 있으면 더 이른 마감을 쓴다(서버 판정보다 늦게 끝나지 않게).
        _deadlineUtc = _open
            ? CooltimeScreenRules.MergeDeadline(_deadlineUtc, now, secondsLeft)
            : CooltimeScreenRules.MergeDeadline(null, now, secondsLeft);
        _secondsLeft = CooltimeScreenRules.SecondsLeft(_deadlineUtc.Value, now);
        _open = true;
        _message = null;
        Notify.ClearPendingCooltimePrompt();

        if (_tick is null)
        {
            _tick = new CancellationTokenSource();
            _ = RunCountdownAsync(_tick.Token);
        }
        StateHasChanged();
    }

    private async Task RunCountdownAsync(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested && _deadlineUtc is not null)
            {
                _secondsLeft = CooltimeScreenRules.SecondsLeft(_deadlineUtc.Value, DateTime.UtcNow);
                await InvokeAsync(StateHasChanged);
                if (_secondsLeft <= 0)
                {
                    // 0초 — 서버에 알리고(실패해도) 로그인 화면으로. 서버는 어차피 ① 무응답으로 끝낸다.
                    await InvokeAsync(() => FinishWithLogoutAsync("countdown"));
                    return;
                }
                await Task.Delay(250, ct);
            }
        }
        catch (OperationCanceledException)
        {
            Logger.LogInformation("자동 로그아웃 카운트다운을 멈췄다([계속] 또는 끝남)");
        }
    }

    private void StopCountdown()
    {
        _tick?.Cancel();
        _tick?.Dispose();
        _tick = null;
        _deadlineUtc = null;
    }

    private async Task ContinueAsync()
    {
        if (_busy || _ending) return;
        _busy = true;
        _message = null;
        try
        {
            int? status = null;
            try
            {
                // 본문 없음(서버 약속) — 회사 · 로그인은 서버가 출입증에서 읽는다(#2).
                using var r = await Http.PostAsync(CooltimeScreenRules.ContinuePath, null);
                status = (int)r.StatusCode;
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "자동 로그아웃 [계속] 요청이 서버에 닿지 못했다");
            }

            switch (CooltimeScreenRules.ContinueOutcome(status))
            {
                case CooltimeScreenRules.CallOutcome.Continued:
                    StopCountdown();
                    _open = false;
                    Snackbar.Add(CooltimeScreenRules.ContinuedNotice, Severity.Success);
                    break;
                case CooltimeScreenRules.CallOutcome.Ended:
                    // §E-5 — 401 · 409 = 서버가 이미 끝냈다.
                    // 🆕 11/27 고침 차례 — 이제 여기 오는 것은 401 뿐(409 는 아래 다시 확인).
                    await EndLocallyAsync();
                    break;
                case CooltimeScreenRules.CallOutcome.Recheck:
                    // 🆕 11/27 고침 차례(§273 V1) — 409 = 물음 칸이 비었다(다른 탭이 먼저 [계속] · 팝업 중 끔 · 만료) → 출입증을 지우지 않고 다시 묻는다.
                    await RecheckAsync();
                    break;
                default:
                    _message = CooltimeScreenRules.ContinueFailedNotice;
                    break;
            }
        }
        finally
        {
            _busy = false;
            if (!_ending) StateHasChanged();
        }
    }

    private async Task LogoutNowAsync()
    {
        if (_busy || _ending) return;
        _busy = true;
        await FinishWithLogoutAsync("button");
    }

    /// <summary>[아니요] · 0초 — 서버에 끝내 달라고 하고(실패해도) 이 PC 를 로그아웃한다.</summary>
    private async Task FinishWithLogoutAsync(string trigger)
    {
        if (_ending) return;
        try
        {
            var (status, ended) = await PostLogoutAsync(trigger);
            if (CooltimeScreenRules.ShouldRetryLogout(status))
            {
                await Task.Delay(1000);
                (status, ended) = await PostLogoutAsync(trigger);
            }
            var outcome = CooltimeScreenRules.LogoutOutcome(status, ended);
            if (outcome == CooltimeScreenRules.CallOutcome.Recheck)
            {
                // 🆕 11/27 고침 차례(§273 V1 · §275 E-5) — ended:false = 서버가 이 로그인을 안 끝냈다
                //   (다른 탭이 [계속] · 팝업 중 끔 · 물음 만료 = 서버 작업 몫). 출입증을 지우지 않고 다시 묻는다.
                //   ⬛ [낡은 동작 · 11/27 이전] 2xx 면 ended 와 무관하게 아래 EndLocallyAsync 로 갔다(공유 저장소 출입증 삭제 → 두 탭 다 로그인 화면).
                await RecheckAsync();
                return;
            }
            if (outcome == CooltimeScreenRules.CallOutcome.Failed)
            {
                // 서버가 못 끝냈어도 화면은 끝낸다 — 서버 시각 작업이 응답 없음(①)으로 끝내고 퇴근도 그때 적는다.
                Logger.LogWarning("자동 로그아웃 요청이 끝나지 않았다({Status}) — 이 PC 는 로그아웃하고 서버 작업에 맡긴다", status);
            }
            await EndLocallyAsync();
        }
        finally
        {
            // 🆕 11/27 — 다시 확인 뒤 팝업만 닫힌 경우 버튼을 다시 살린다(끝남이면 화면을 떠나므로 상관없음).
            _busy = false;
        }
    }

    // ⬛ [낡은 머리 · 11/27 고침 차례 이전] private async Task<int?> PostLogoutAsync(string trigger) — 응답 코드만 돌려줬다.
    // 🆕 11/27 고침 차례(§273 V1) — 본문의 ended 도 읽는다(2xx 라도 ended:false 면 끝난 게 아니다).
    private async Task<(int? Status, bool? Ended)> PostLogoutAsync(string trigger)
    {
        try
        {
            using var r = await Http.PostAsJsonAsync(CooltimeScreenRules.LogoutPath, new { trigger });
            var status = (int)r.StatusCode;
            string? body = null;
            try
            {
                body = await r.Content.ReadAsStringAsync();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "자동 로그아웃 응답 본문을 읽지 못했다(다시 확인으로 넘긴다)");
            }
            return (status, CooltimeScreenRules.ParseEnded(body));
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "자동 로그아웃 요청이 서버에 닿지 못했다");
            return (null, null);
        }
    }

    /// <summary>
    /// 끝남 — 이 PC 의 로그인 저장소를 비우고 로그인 화면으로(안내 한 줄은 로그인 화면이 띄운다).
    /// </summary>
    private async Task EndLocallyAsync()
    {
        if (_ending) return;
        _ending = true;
        StopCountdown();

        await Notify.StopAsync();

        foreach (var key in new[] { AuthStorageKeys.AccessToken, AuthStorageKeys.RefreshToken, AuthStorageKeys.UserDisplayName })
        {
            try
            {
                await Storage.DeleteAsync(key);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "자동 로그아웃 — 저장소 한 칸을 비우지 못했다");
            }
        }

        try
        {
            // 같은 탭에서 다시 로그인해도 업데이트 안내가 다시 뜨게(손 로그아웃과 같은 정리 · 20260929작3 절F4).
            await JS.InvokeVoidAsync("sessionStorage.removeItem", UpdatePromptPlan.SessionKey);
            await JS.InvokeVoidAsync("localStorage.setItem", CooltimeScreenRules.EndedNoticeKey, "1");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "자동 로그아웃 — 로그인 화면 안내 표를 남기지 못했다");
        }

        Nav.NavigateTo("/login", forceLoad: true);
    }

    public void Dispose()
    {
        Notify.OnCooltimePrompt -= OnPrompt;
        Notify.OnCooltimeEnded -= OnEnded;
        Notify.OnCooltimeContinued -= OnContinued;
        _tick?.Cancel();
        _tick?.Dispose();
        _tick = null;
    }
}
