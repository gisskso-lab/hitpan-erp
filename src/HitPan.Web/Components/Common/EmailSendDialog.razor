@* 이메일 발송 다이얼로그 — 재사용 가능한 공통 컴포넌트 *@
@* FAX 발송 기능은 향후 이 다이얼로그에 "FAX" 탭으로 추가 예정 (Phase 3) *@
@namespace HitPan.Web.Components.Common

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Email" Color="Color.Primary" />
            <MudText Typo="Typo.h6">이메일 발송</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            @* 받는 사람 이메일 입력 *@
            <MudTextField T="string"
                          Label="받는 사람"
                          @bind-Value="_recipientEmail"
                          Placeholder="이메일 주소를 입력하세요"
                          InputType="InputType.Email"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Person"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense" />

            @* 제목 — 문서종류 + 문서번호로 자동 생성 *@
            <MudTextField T="string"
                          Label="제목"
                          @bind-Value="_subject"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Subject" />

            @* 본문 내용 — 기본 문구 제공, 사용자 편집 가능 *@
            <MudTextField T="string"
                          Label="내용"
                          @bind-Value="_body"
                          Variant="Variant.Outlined"
                          Lines="5"
                          Margin="Margin.Dense" />

            @* 첨부 파일 표시 (PDF 자동 첨부) *@
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.AttachFile" Size="Size.Small" Color="Color.Secondary" />
                <MudCheckBox T="bool" @bind-Value="_attachPdf" Label="@_attachmentName" Dense="true" Color="Color.Primary" />
            </MudStack>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">취소</MudButton>
        <MudButton OnClick="Send" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send">발송</MudButton>
    </DialogActions>
</MudDialog>

@code {
    // MudDialog 인스턴스 — 닫기 처리에 사용한다.
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    // 스낵바 서비스 — 안내 메시지 표시용.
    [Inject]
    private ISnackbar Snackbar { get; set; } = default!;

    /// <summary>
    /// 문서 종류 (견적서, 수주서, 거래명세서, 발주서, 매입명세서, 반품처리서).
    /// </summary>
    [Parameter]
    public string DocumentType { get; set; } = string.Empty;

    /// <summary>
    /// 문서 번호 (예: QT-20260418-001).
    /// </summary>
    [Parameter]
    public string DocumentNo { get; set; } = string.Empty;

    /// <summary>
    /// 거래처 이메일 — 값이 있으면 받는 사람에 자동 채움한다.
    /// </summary>
    [Parameter]
    public string? PartnerEmail { get; set; }

    // 받는 사람 이메일
    private string _recipientEmail = string.Empty;

    // 이메일 제목
    private string _subject = string.Empty;

    // 이메일 본문
    private string _body = string.Empty;

    // PDF 첨부 여부
    private bool _attachPdf = true;

    // 첨부 파일명 표시
    private string _attachmentName = string.Empty;

    /// <summary>
    /// 다이얼로그 열릴 때 기본값을 채운다.
    /// </summary>
    protected override void OnParametersSet()
    {
        // 받는 사람 — 거래처 이메일이 있으면 미리 채운다.
        if (!string.IsNullOrWhiteSpace(PartnerEmail))
        {
            _recipientEmail = PartnerEmail;
        }

        // 제목 — "[문서종류] 문서번호 송부의 건"
        _subject = $"[{DocumentType}] {DocumentNo} 송부의 건";

        // 본문 — 기본 안내 문구
        _body = $"안녕하세요.\n\n{DocumentType} {DocumentNo}을(를) 송부드립니다.\n확인 부탁드립니다.\n\n감사합니다.";

        // 첨부 파일명
        _attachmentName = $"{DocumentType}_{DocumentNo}.pdf";
    }

    /// <summary>
    /// 발송 버튼 클릭 — SMTP 미연동 상태이므로 안내 메시지만 표시한다.
    /// </summary>
    private void Send()
    {
        // Phase 2 에서 SMTP 설정 후 실제 발송 로직으로 교체한다.
        Snackbar.Add("이메일 발송 기능은 SMTP 설정 후 사용 가능합니다. (Phase 2)", Severity.Info);
        MudDialog.Close(DialogResult.Ok(true));
    }

    /// <summary>
    /// 취소 버튼 클릭.
    /// </summary>
    private void Cancel()
    {
        MudDialog.Cancel();
    }
}
