@* 작14 B-1 N-8 — 「안 읽은 답 N」 전역 표시 (설계: "안 보이면 쪽지는 안 만든 것보다 나쁘다" R-7).
   MainLayout 상단 배너 자리(TermsConsentBanner 선례) — 모든 화면에서 보인다.
   0건이면 아무것도 그리지 않는다 · 5분마다 다시 센다(답 Pull 주기와 같은 호흡). *@
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Nav
@implements IDisposable

@if (_unread > 0 && !_onCsPage)
{
    <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Dense="true" Class="ma-2"
              ContentAlignment="HorizontalAlignment.Left">
        <div style="display:flex; align-items:center; justify-content:space-between; gap:12px;">
            <span><strong>CS 답변 @(_unread)건</strong>이 도착했습니다.</span>
            <MudButton Color="Color.Inherit" Variant="Variant.Outlined" Size="Size.Small"
                       OnClick="@(() => Nav.NavigateTo("/support/cs"))">
                답 보러 가기
            </MudButton>
        </div>
    </MudAlert>
}

@code {
    private int _unread;
    private bool _onCsPage;
    private Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        _onCsPage = Nav.Uri.Contains("/support/cs");
        await RefreshAsync();
        // 5분 주기 — 워커의 답 Pull 과 같은 호흡. 화면을 막지 않는다.
        _timer = new Timer(async _ => await InvokeAsync(async () =>
        {
            await RefreshAsync();
            StateHasChanged();
        }), null, TimeSpan.FromMinutes(5), TimeSpan.FromMinutes(5));
    }

    private void OnLocationChanged(object? s, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        var on = e.Location.Contains("/support/cs");
        if (on != _onCsPage)
        {
            _onCsPage = on;
            // CS 화면에서 읽고 나오면 숫자를 다시 센다 — 읽은 답이 계속 떠 있으면 거짓 알림이다.
            _ = InvokeAsync(async () => { await RefreshAsync(); StateHasChanged(); });
        }
    }

    private async Task RefreshAsync()
    {
        try
        {
            var res = await Http.GetFromJsonAsync<CountResponse>("api/cs/replies/unread-count");
            _unread = res?.Count ?? 0;
        }
        catch (Exception)
        {
            // 표시용 숫자다 — 실패해도 화면을 막지 않고 다음 주기에 다시 센다(#15 흔적만).
            Console.Error.WriteLine("[CS] 안 읽은 답 수 조회 실패");
        }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        _timer?.Dispose();
    }

    private sealed class CountResponse { public bool Success { get; set; } public int Count { get; set; } }
}
