@*
    CommsRecoveryBanner — WS-12 1클릭 통신 봉합 UI (P1 저장)
    1분 주기 /health 폴링 → 끊김 감지 → 상단 배너 + 1클릭 봉합
    헌법 #27 (통신 무결성) + #28 (자동 봉합)
*@
@using System.Net.Http
@using System.Threading
@inject HttpClient Http
@inject NavigationManager Nav
@implements IDisposable

@if (_state == CommsState.Down)
{
    <div class="hp-comms-banner hp-comms-banner-down" role="alert">
        <div class="hp-comms-banner-icon">⚠️</div>
        <div class="hp-comms-banner-message">
            <strong>서버 통신이 불안정합니다.</strong>
            <span class="hp-comms-banner-sub">@_lastError</span>
        </div>
        <button class="hp-comms-banner-action" @onclick="OnRecoverClick" disabled="@_busy">
            @(_busy ? "봉합 중..." : "🔧 1클릭 봉합")
        </button>
    </div>
}
else if (_state == CommsState.Recovering)
{
    <div class="hp-comms-banner hp-comms-banner-recover" role="status">
        <div class="hp-comms-banner-icon">🔄</div>
        <div class="hp-comms-banner-message">
            <strong>자동 봉합 진행 중...</strong>
            <span class="hp-comms-banner-sub">최대 5분 이내 복구 시도. 잠시만 기다려주세요.</span>
        </div>
    </div>
}

<style>
    .hp-comms-banner {
        position: sticky; top: 0; z-index: 9999;
        display: flex; align-items: center; gap: 14px;
        padding: 10px 18px; border-bottom: 1px solid rgba(0,0,0,0.08);
        font-size: 14px; box-shadow: 0 2px 6px rgba(0,0,0,0.06);
        animation: hp-comms-fade-in .25s ease-out;
    }
    .hp-comms-banner-down { background: #FEF2F2; color: #991B1B; }
    .hp-comms-banner-recover { background: #FFFBEB; color: #92400E; }
    .hp-comms-banner-icon { font-size: 22px; }
    .hp-comms-banner-message { flex: 1; display: flex; flex-direction: column; }
    .hp-comms-banner-sub { font-size: 12px; opacity: .78; margin-top: 2px; }
    .hp-comms-banner-action {
        background: #DC2626; color: white; border: none;
        border-radius: 8px; padding: 8px 16px; font-size: 13px;
        font-weight: 600; cursor: pointer; transition: background .15s;
    }
    .hp-comms-banner-action:hover { background: #B91C1C; }
    .hp-comms-banner-action:disabled { background: #9CA3AF; cursor: not-allowed; }
    @@keyframes hp-comms-fade-in {
        from { opacity: 0; transform: translateY(-8px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

@code {
    private enum CommsState { Healthy, Down, Recovering }

    private CommsState _state = CommsState.Healthy;
    private string _lastError = string.Empty;
    private bool _busy;
    private CancellationTokenSource? _cts;
    private Timer? _timer;
    private int _consecutiveFailures;

    // 폴링 주기 (헌법 #27 정합: 통신 무결성 = 1분 저장)
    private const int PollIntervalMs = 60_000;

    // 끊김 판정 임계치 (3회 연속 실패 = Down)
    private const int FailureThreshold = 3;

    protected override void OnInitialized()
    {
        _cts = new CancellationTokenSource();
        // 초기 폴링 5초 후 시작 (페이지 로드 직후 부담 줄이기)
        //
        // 🔴 작(2026-08-14) — 타이머 콜백을 통째로 감싼다. 검증팀 P0 적발.
        //   종전엔 `async _ => await PollHealthAsync()` 였다. 이 람다는 async void 와 같아
        //   여기서 새는 예외를 **아무도 못 잡고** 화면 아래 흰 띠가 뜬다.
        //   PollHealthAsync 안에 try 가 있지만 InvokeAsync(StateHasChanged) 두 곳이
        //   **catch 바깥**이라 거기서 터지면 그대로 샌다(화면이 이미 걷힌 뒤 등).
        //
        //   🔴 이 배너는 **모든 화면에 상주**하고 **60초마다** 돈다 —
        //     눌러야 나는 사고와 달리 **가만히 있어도 1분마다** 재발한다.
        //     통신이 끊긴 상황을 알리려고 둔 것이 되레 화면을 죽이면 안 된다.
        _timer = new Timer(_ =>
        {
            _ = Task.Run(async () =>
            {
                try
                {
                    await PollHealthAsync();
                }
                catch (Exception ex)
                {
                    // 헌법 #15 — 빈 catch 금지. 다음 주기에 다시 재본다.
                    Console.Error.WriteLine($"[CommsRecoveryBanner] 통신 점검 실패: {ex.GetType().Name}: {ex.Message}");
                }
            });
        }, null, 5_000, PollIntervalMs);
    }

    private async Task PollHealthAsync()
    {
        if (_cts?.IsCancellationRequested == true) return;
        try
        {
            using var req = new HttpRequestMessage(HttpMethod.Get, "health");
            using var cts = CancellationTokenSource.CreateLinkedTokenSource(_cts!.Token);
            cts.CancelAfter(TimeSpan.FromSeconds(8));
            var resp = await Http.SendAsync(req, cts.Token);
            if (resp.IsSuccessStatusCode)
            {
                _consecutiveFailures = 0;
                if (_state != CommsState.Healthy)
                {
                    _state = CommsState.Healthy;
                    await InvokeAsync(StateHasChanged);
                }
            }
            else
            {
                _consecutiveFailures++;
                await HandleFailureAsync($"HTTP {(int)resp.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            _consecutiveFailures++;
            await HandleFailureAsync(ex.Message);
        }
    }

    private async Task HandleFailureAsync(string detail)
    {
        if (_consecutiveFailures >= FailureThreshold && _state == CommsState.Healthy)
        {
            _state = CommsState.Down;
            _lastError = $"마지막 응답: {detail}";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnRecoverClick()
    {
        if (_busy) return;
        _busy = true;
        _state = CommsState.Recovering;
        StateHasChanged();

        // 1. 즉시 헬스 재폴링 (워치독이 백그라운드에서 봉합 중일 가능성)
        try
        {
            await PollHealthAsync();
            if (_state == CommsState.Healthy)
            {
                _busy = false;
                return;
            }

            // 2. 10초 대기 + 재시도 (워치독 WS-28-C TunnelSecret 재발급 등 평균 3분 이내)
            await Task.Delay(10_000);
            _consecutiveFailures = 0;
            await PollHealthAsync();
        }
        finally
        {
            _busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _timer?.Dispose();
        _cts?.Dispose();
    }
}
