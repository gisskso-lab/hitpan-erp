@* 고리2(A안) 업데이트 동의 팝업 게이트 — MainLayout(ERP 메인)에서 1회 노출.
   ─ 왜 로그인 페이지가 아니라 여기인가 (2026-07-22 작1 진범 봉합):
     로그인 성공 시 AuthService 가 인증 상태를 방송 → 라우터가 /login 컴포넌트를 즉시 폐기 →
     그 위에 뜬 팝업이 딸려 사라졌다(0.5초, "누를 경황도 없이"). ERP 메인은 안 사라지므로 팝업이 유지된다.
   ─ 모듈화(사장님 원칙 2026-07-21): 업데이트 팝업 책임을 이 독립 컴포넌트로 분리.
     조회·팝업 실패해도 ERP 사용은 절대 막지 않는다(TermsConsentBanner 와 동일 방어).
   ─ CTO B-1: MainLayout 은 모든 화면 껍데기라 페이지 이동마다 재조회될 수 있다 → 세션 1회 가드. *@
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using MudBlazor
@using HitPan.Web.Services
@using HitPan.Web.Components.Common
@inject IAuthService AuthService
@inject HttpClient Http
@inject AuthenticationStateProvider AuthProvider
@inject IDialogService DialogService
@inject IJSRuntime JS
@* [예] 클릭 후 "곧 꺼진다"를 알리기 위해(20260806작1 P1). MudBlazor 표준 주입. *@
@inject ISnackbar Snackbar

@* 업데이트 중 안내화면 (20260806작7). 평소엔 아무것도 그리지 않고, [예] 직후에만 화면을 덮는다.
   ★ 여기 두는 이유: 이 컴포넌트는 MainLayout 소속이라 페이지가 바뀌어도 살아 있다.
     업데이트가 끝날 때까지 계속 떠 있어야 하므로 사라지는 자리에 두면 안 된다. *@
<UpdateProgressOverlay @ref="_progress" />

@code {
    // [예] 직후 안내화면을 띄우기 위한 참조(20260806작7).
    private UpdateProgressOverlay? _progress;

    // CTO B-1: 페이지 이동마다 MainLayout 이 재생성돼도 같은 버전을 반복해서 띄우지 않는다.
    //   ★ 20260804작2 정정: 저장하는 값이 "1"(고정) 에서 **안내한 버전 문자열**로 바뀌었다.
    //     같은 버전 → 재노출 안 함(종전 의도 유지) / 새 버전 → 다시 안내(오더 ② 재배포 사이클).
    //     [나중에]·[예] 어느 쪽을 눌러도 그 버전은 기록된다. 다음 로그인·새 버전이면 재안내.
    private const string SessionKey = "hitpan_update_prompt_shown";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 레이아웃 생명주기 1회만 시도. JS(sessionStorage)는 렌더 후에만 안전하므로 OnAfterRender 사용.
        //   Nav.LocationChanged 를 구독하지 않는다(CTO B-1: 팝업 재노출 방지) — 페이지 이동으로는 재트리거 안 됨.
        if (!firstRender) return;

        try
        {
            // 미인증이면 조용히 스킵(로그인 전 첫 화면 등). TermsConsentBanner 와 동일 가드.
            var auth = await AuthProvider.GetAuthenticationStateAsync();
            if (auth.User?.Identity?.IsAuthenticated != true) return;

            // 세션 1회 가드 — 이미 노출했으면 종료(CTO B-1).
            // ★ 봉합 20260804작2 ([3-V] 병렬검증 적발) — 가드를 "세션"이 아니라 "버전"에 건다.
            //   ■ 무엇이 문제였나
            //     종전 키는 값이 "1" 고정이라, 한 번 노출하면 그 탭에서는 **어떤 새 버전이 와도** 다시 안 떴다.
            //     sessionStorage 는 F5 로도 안 풀리고 탭을 닫아야 풀린다 → 사장님이 수정본을 재게시해도
            //     같은 탭에서는 안내가 영원히 안 뜬다. 오더 ②(재배포→재확인)를 막는 요소다.
            //   ■ 봉합: 노출한 **버전 문자열**을 저장하고, 새 버전이면 다시 띄운다.
            //     같은 버전 반복 노출 방지(CTO B-1 의 원래 의도)는 그대로 유지된다.
            var shown = await JS.InvokeAsync<string?>("sessionStorage.getItem", SessionKey);

            // 업데이트 상태 조회(로그인과 동일 로직의 전용 GET). 실패·미인증 401 → 조용히 스킵.
            var status = await Http.GetFromJsonAsync<UpdateStatusResponse>("api/auth/update-status");
            if (status?.UpdateAvailable != true || string.IsNullOrWhiteSpace(status.LatestVersion))
                return;

            // 이 버전을 이미 안내했으면 종료(같은 버전 반복 노출 방지 — CTO B-1 원래 의도).
            if (string.Equals(shown, status.LatestVersion, StringComparison.Ordinal)) return;

            // 여기까지 왔으면 팝업을 띄운다. 이후 결과와 무관하게 '이 버전은 안내했다' 를 기록한다.
            //   새 버전이 올라오면 값이 달라져 다시 뜬다(오더 ② 재배포 사이클).
            await JS.InvokeVoidAsync("sessionStorage.setItem", SessionKey, status.LatestVersion!);

            var notice = string.IsNullOrWhiteSpace(status.ConsentMessage)
                // ★ 20260806작1 P0-1 ([3-V] 병렬검증 적발): 종전 "다음 재시작 때 적용됩니다"는
                //   즉시 적용 봉합 이후 **거짓**이다. 게다가 [예] 를 누르면 taskkill /F 로 히트판이
                //   강제 종료된다(UpdateProcessGate.cs:104) — 그 사실을 한 글자도 안 알렸다(헌법 #24).
                // ★ 재정정 20260806 ([4] 검증팀 적발): 1차 봉합 문구는 "먼저 저장해 주세요" 였는데
                //   **이 팝업은 모달이다**(ConfirmDialog BackdropClick=false) — 떠 있는 동안 뒤 화면에
                //   손댈 수 없어 **저장이 물리적으로 불가능**하다. 실행할 수 없는 지시를 준 셈이다.
                //   ⇒ 저장 경로([나중에])를 명시한다. 문구가 시키는 일을 실제로 할 수 있어야 한다(헌법 #24·#25).
                ? "[예] 를 누르면 자료를 자동으로 백업한 뒤 업데이트가 진행되며, 그 사이 히트판이 잠시 꺼졌다가 다시 켜집니다. 저장하지 않은 입력이 있으면 [나중에] 를 눌러 저장을 마친 뒤 다시 진행해 주세요."
                : status.ConsentMessage!;
            // 헌법 #14: Razor 에 raw string 금지 — $"...\n..." 로 조립.
            var message = $"새 버전 {status.LatestVersion} 이(가) 나왔습니다. 업데이트하시겠습니까?\n\n{notice}";

            var agree = await ConfirmDialog.ShowAsync(
                DialogService,
                title: "업데이트 안내",
                message: message,
                confirmText: "예",
                cancelText: "나중에",
                severity: Severity.Info);

            // 예=approve / 나중에=reject — 양쪽 모두 기록(거부 이력도 재안내 정책에 활용).
            var action = agree ? "approve" : "reject";
            var saved = await AuthService.SubmitUpdateConsentAsync(status.LatestVersion!, action);

            // ★ 봉합 20260806작1 P1 ([3-V] 병렬검증 적발): 종전엔 [예] 를 눌러도 화면에 아무것도 안 나왔다.
            //   실측(2026-08-06): 사장님이 [예] 를 누르고 "아무반응이 없네" 라고 하셨다.
            //   동의는 저장됐지만 화면이 침묵하니 고객은 눌린 건지 고장인지 알 수 없다(헌법 #24·#25).
            //   ⚠️ 진행률 표시는 별건이다. 다만 "곧 꺼진다"는 예고는 별건이 아니다 —
            //     몇 초 뒤 실제로 히트판이 종료되기 때문이다(UpdateProcessGate taskkill).
            if (agree)
            {
                if (saved)
                {
                    // ★ 20260806작7 (사장님 결재 "a안으로 결재") — 502 를 고장으로 읽는 문제 차단.
                    //   실측(2026-08-06): 업데이트 중 히트판이 꺼지자 **502 오류 페이지**가 떴고,
                    //   사장님이 직접 "502 에러 떴다"며 고장으로 인식하셨다. 고객은 100% 전화한다.
                    //
                    //   502 를 내는 건 히트판이 아니라 터널이다(iss:1134 — ingress origin=5257 직결).
                    //   히트판이 꺼진 뒤에는 그 안의 코드가 한 줄도 안 돈다.
                    //   ⇒ **꺼지기 전인 지금** 화면을 덮는다. Blazor WASM 은 이미 브라우저에서 도므로
                    //     히트판이 꺼져도 이 화면은 살아남아 5초마다 두드리다 자동으로 복귀시킨다.
                    //
                    //   ⚠️ await 하지 않는다 — Start 는 폴링을 백그라운드로 던지고 즉시 반환한다.
                    //     여기서 붙잡으면 화면이 안 그려진 채 히트판이 꺼져 502 가 그대로 보인다.
                    _progress?.Start(status.LatestVersion!, status.CurrentVersion);
                }
                else
                {
                    // 요청 전달 실패 — 업데이트가 시작되지 않으므로 안내화면을 띄우면 안 된다(거짓 안내).
                    Snackbar.Add(
                        "업데이트 요청을 전달하지 못했습니다. 잠시 후 다시 안내해 드리겠습니다.",
                        Severity.Warning);
                }
            }
        }
        catch (Exception _hp15Ex)
        {
            // 조회·팝업·기록 실패는 ERP 사용을 막지 않는다(헌법 #20). 다음 세션에 재안내.
            // ★ 봉합 20260804작2 P0-3 ([3-V] 병렬검증 적발): 종전엔 주석만 있고 로그가 0줄이었다(헌법 #15 위반).
            //   그래서 "업데이트 안내가 왜 안 뜨나" 를 추적할 수단이 아예 없었다 — 팝업 미노출 조사 시
            //   조회 실패인지·미인증인지·세션가드인지 구분이 불가능하다. 흔적은 남기되 화면은 막지 않는다.
            Console.Error.WriteLine("[HP15][UpdateConsentGate] " + _hp15Ex.GetType().Name + ": " + _hp15Ex.Message);
        }
    }

    private sealed class UpdateStatusResponse
    {
        public string? CurrentVersion { get; set; }
        public bool UpdateAvailable { get; set; }
        public string? LatestVersion { get; set; }
        public string? UpdateChannel { get; set; }
        public string? ConsentMessage { get; set; }
    }
}
