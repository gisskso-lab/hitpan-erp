    /// <summary>
    /// 🔴 [20261025작3 절 가-1] 「빈 A4 용지」에서 <b>양식용지로 바꿔 주는 한 단추</b>.
    /// </summary>
    /// <remarks>
    /// 🔴 <b>저장하지 않는다</b> — 화면의 고른 값만 바꾼다. 양식 행에 적히는 건 「저장」 단추를 누를 때다.
    ///   (올려 두고 창을 닫으면 양식은 그대로다 — 작2 의 업로드와 같은 규율이다.)
    /// 🔴 <b>몰래 바꾸지 않는다</b> — 고객이 이 단추를 눌러야 바뀌고, 바뀐 뒤 무엇이 달라졌는지 알려 준다.
    ///   사장님 결재(결-1)가 *"칸을 보여 주고 양식용지로 바꾸라고 안내"* 였다.
    /// 🔴 <b>되돌릴 수 있다</b> — 위 「어떤 종이에 인쇄하나요?」에서 다시 「빈 A4」로 고르면 된다.
    /// 🔴 <b>적어 둔 좌표를 건드리지 않는다</b> — <c>_coords</c> 를 다시 읽지 않으므로
    ///   표에 적던 값이 사라지지 않는다([4] 검증 항목 5).
    /// </remarks>
    private void SwitchToPreprint()
    {
        if (_form.PaperMode == "preprint") return;
        _form.PaperMode = "preprint";
        Snackbar.Add("「미리 인쇄된 양식용지」로 바꿨습니다. 이제 그림을 올리실 수 있습니다. "
                   + "아직 저장되지 않았습니다 — 「저장」을 누르셔야 양식에 남습니다.", Severity.Info);
    }

    /// <summary>
    /// 🔴 파일을 고르면 <b>그 자리에서 올리고 미리보기를 다시 그린다</b> — 이것이 「즉시 반영」이다.
    /// </summary>
    /// <remarks>
    /// 🔴 단추를 두 번 누르게 하지 않는다. 사장님 오더가 *"즉시 반영"* 이고,
    ///   고르기 → 올리기 → 미리보기를 각각 누르게 만들면 현장에서 아무도 안 쓴다.
    /// 🔴 <b>저장하지 않는다</b> — 양식 행에 적히는 건 「저장」 단추를 누를 때다.
    ///   올리고 창을 닫으면 양식은 그대로다(그림 파일만 보관소에 남는다).
    /// 🔴 「저장했습니다」라고 말하지 않는다 — 인쇄설정 화면에서 저장도 안 하고
    ///   저장했다고 알려 고객이 값을 잃은 사고가 있었다(2026-08-11 사장님 지시).
    /// </remarks>
    private async Task OnBackgroundFileChangedAsync(IBrowserFile? file)
    {
        if (file is null) return;

        _bgBusy = true;
        try
        {
            using var content = new MultipartFormDataContent();
            // 🔴 상한은 서버와 같은 값으로 읽는다 — 브라우저에서 먼저 걸러도 서버가 다시 본다.
            var stream = file.OpenReadStream(MaxBackgroundBytes);
            var part = new StreamContent(stream);
            part.Headers.ContentType =
                new System.Net.Http.Headers.MediaTypeHeaderValue("application/octet-stream");
            content.Add(part, "file", file.Name);

            var resp = await Http.PostAsync("api/settings/form-templates/background", content);
            if (!resp.IsSuccessStatusCode)
            {
                // 🔴 조용히 실패하지 않는다 — 서버가 적어 준 까닭을 그대로 보여 준다.
                var why = await ReadServerMessageAsync(resp);
                Snackbar.Add(why ?? $"그림을 올리지 못했습니다. ({(int)resp.StatusCode})", Severity.Error);
                return;
            }

            var saved = await resp.Content.ReadFromJsonAsync<UploadedBackground>();
            if (string.IsNullOrWhiteSpace(saved?.StoredPath))
            {
                Snackbar.Add("그림을 올렸지만 보관 위치를 받지 못했습니다.", Severity.Error);
                return;
            }

            _form.BackgroundImageUrl = saved.StoredPath;
            _bgFileName = file.Name;
            Snackbar.Add("양식용지 그림을 올렸습니다. 아래 미리보기로 확인하십시오.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add("그림을 올리는 중 오류가 났습니다.", Severity.Error);
            Console.Error.WriteLine($"[FormBackground] {ex.Message}");
            return;
        }
        finally
        {
            _bgBusy = false;
        }

        // 🔴 여기가 「즉시」다 — 올린 그림이 깔린 종이를 바로 그려 보여 준다.
        await PreviewAsync();
    }

    /// <summary>올린 그림을 뺀다 — 파일도 지우고 칸도 비우고 미리보기를 다시 그린다.</summary>
    /// <remarks>🔴 파일 지우기가 실패해도 칸은 비운다 — 고객이 「그림 없이」로 갈 길을 막지 않는다.</remarks>
    private async Task RemoveBackgroundAsync()
    {
        var path = _form.BackgroundImageUrl;
        _bgBusy = true;
        try
        {
            if (!string.IsNullOrWhiteSpace(path))
            {
                var req = new HttpRequestMessage(HttpMethod.Delete, "api/settings/form-templates/background")
                {
                    Content = JsonContent.Create(new { StoredPath = path })
                };
                var resp = await Http.SendAsync(req);
                if (!resp.IsSuccessStatusCode)
                {
                    var why = await ReadServerMessageAsync(resp);
                    // 🔴 알리되 멈추지 않는다 — 칸을 비우는 것이 고객의 뜻이다.
                    Snackbar.Add(why ?? "그림 파일을 지우지 못했습니다. 칸만 비웁니다.", Severity.Warning);
                }
            }

            _form.BackgroundImageUrl = null;
            _bgFileName = null;
        }
        catch (Exception ex)
        {
            _form.BackgroundImageUrl = null;
            _bgFileName = null;
            Console.Error.WriteLine($"[FormBackground] {ex.Message}");
        }
        finally
        {
            _bgBusy = false;
        }

        await PreviewAsync();
    }

    /// <summary>서버가 돌려준 까닭 한 줄을 꺼낸다. 🔴 못 꺼내면 null — 억지로 만들지 않는다.</summary>
    private static async Task<string?> ReadServerMessageAsync(HttpResponseMessage resp)
    {
        try
        {
            var body = await resp.Content.ReadFromJsonAsync<ServerMessage>();
            return string.IsNullOrWhiteSpace(body?.Message) ? null : body!.Message;
        }
        catch (Exception ex)
        {
            // 🔴 빈 catch 금지 — 까닭을 적고 null 로 떨어진다(#15).
            Console.Error.WriteLine($"[FormBackground] 응답을 읽지 못했다: {ex.Message}");
            return null;
        }
    }

    /// <summary>
    /// 양식지 그림 상한. 🔴 [2026-10-25 [4] 반려 R-1 봉합] 종전에는 여기에
    /// <c>20L * 1024 * 1024</c> 를 <b>다시 적어 두고</b> 「서버와 같은 값이어야 한다」는
    /// 주석만 달았다 — 그건 바람이고 보장이 아니다. 서버 값이 바뀌면 여기는 안 바뀌고,
    /// 게이트는 서버 두 자리만 대조해 **어긋나도 초록**이었다. 이제 같은 자리를 읽는다.
    /// </summary>
    private const long MaxBackgroundBytes = FormBackgroundLimits.MaxBytes;

    private sealed class UploadedBackground
    {
        public string? StoredPath { get; set; }
    }

    private sealed class ServerMessage
    {
        public string? Message { get; set; }
    }

    /// <summary>
    /// 🔴 화면에서 만진 워터마크 수치를 <c>_form</c> 에 담는다 — <b>저장과 미리보기가 같이 쓴다</b>.
    /// </summary>
    /// <remarks>
    /// 🔴 <b>「따로 정하기」를 끈 채라면 <c>null</c> 을 넣는다.</b> null 이 「공통을 따르겠다」다.
    ///   0 을 넣으면 「완전히 투명하게」가 되어 고객은 <b>「켰는데 안 보인다」</b>를 본다
    ///   — 두 뜻이 한 칸에서 섞이면 안 된다(DB-148 머리글).
    /// 🔴 <b>세금계산서는 켜지 않는다</b>(결-K) — 화면에 칸이 없으니 값도 보내지 않는다.
    ///   서버가 같은 판정을 한 번 더 한다. 화면만 믿지 않는다.
    /// </remarks>
    private void ApplyWatermarkToForm()
    {
        if (_isTaxInvoiceForm)
        {
            // 🔴 세금계산서는 **정하지 않은 채로 둔다**(null) — 「이 양식만 끔」으로 적어 두면
            //   법무 답이 와서 공통으로 켜는 날 그 양식만 까닭 없이 빠진 채 남는다.
            //   지금 안 깔리는 것은 서버가 결-K 로 **한 번 더 막기** 때문이다(화면만 믿지 않는다).
            _form.ShowWatermark = null;
            _form.WatermarkOpacity = null;
            _form.WatermarkSaturate = null;
            _form.WatermarkScalePct = null;
            return;
        }

        // 🔴 [R-2 봉합] 세 값을 그대로 적는다 — null 이 「공통을 따른다」다.
        _form.ShowWatermark = _wmMode switch
        {
            WmModeOn => true,
            WmModeOff => false,
            _ => null
        };

        if (_wmMode != WmModeOff && _watermarkCustom)
        {
            _form.WatermarkOpacity = _wmOpacity;
            _form.WatermarkSaturate = _wmSaturate;
            _form.WatermarkScalePct = _wmScalePct;
        }
        else
        {
            _form.WatermarkOpacity = null;
            _form.WatermarkSaturate = null;
            _form.WatermarkScalePct = null;
        }
    }

    private async Task PreviewAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.FormType))
        {
            Snackbar.Add("양식 유형을 먼저 고르십시오.", Severity.Warning);
            return;
        }

        // 화면 표에 적은 좌표도 그려야 한다 — 안 담으면 양식용지 위치가 미리보기에 안 먹는다.
        _form.FieldCoordsJson = BuildCoordsJson();

        _previewBusy = true;
        try
        {
            await ClosePreviewAsync();   // 앞서 띄운 주소를 먼저 거둔다(메모리 누적 방지)

            // 🔴🔴 [20261026작1 §D-1 · 결-J] **이 한 줄이 없으면 결-J 가 거짓이 된다.**
            //   사장님: *"응 당연히 미리보기에서 미리 보기반영되도록"*
            //   [무슨 일이 나나] 화면에서 만지는 수치는 `_wmOpacity` 같은 **따로 둔 변수**다
            //     (「공통값 따름」을 null 로 지키려고 그렇게 뒀다). 그 값을 `_form` 에 담는 일을
            //     저장 때만 했으면, 미리보기는 **옛 값으로 그려진다** — 칸은 있고 숫자를 고쳐도
            //     종이가 안 바뀐다. 고객은 보지 않고 숫자를 골라야 한다.
            //   🔴 그래서 **저장과 미리보기가 같은 한 벌**(ApplyWatermarkToForm)을 쓴다.
            //     두 벌이 되면 언젠가 어긋나고, 어긋난 쪽은 늘 미리보기다.
            ApplyWatermarkToForm();
            var body = new { Template = _form, LineCount = _previewLines };
            var resp = await Http.PostAsJsonAsync("api/settings/form-templates/preview-pdf", body);
            if (!resp.IsSuccessStatusCode)
            {
                // 🔴 조용히 실패하지 않는다 — 고객이 "눌렀는데 아무 일도 안 난다" 를 겪으면
                //    무엇이 틀렸는지 알 길이 없다.
                Snackbar.Add($"미리보기를 그리지 못했습니다. ({(int)resp.StatusCode})", Severity.Error);
                return;
            }

            var bytes = await resp.Content.ReadAsByteArrayAsync();
            var url = await JS.InvokeAsync<string>("hitpanMakeBlobUrl",
                "application/pdf", Convert.ToBase64String(bytes));
            if (string.IsNullOrEmpty(url))
            {
                Snackbar.Add("미리보기를 띄우지 못했습니다.", Severity.Error);
                return;
            }
            _previewUrl = url;
        }
        catch (Exception ex)
        {
            Snackbar.Add("미리보기 중 오류가 났습니다.", Severity.Error);
            Console.Error.WriteLine($"[FormPreview] {ex.Message}");
        }
        finally
        {
            _previewBusy = false;
        }
    }

    /// <summary>blob 주소를 거둔다 — 안 거두면 미리보기를 누를수록 쌓인다.</summary>
    private async Task ClosePreviewAsync()
    {
        if (_previewUrl is null) return;
        var old = _previewUrl;
        _previewUrl = null;
        try { await JS.InvokeVoidAsync("hitpanRevokeBlobUrl", old); }
        catch (Exception ex) { Console.Error.WriteLine($"[FormPreview] 주소 거두기 실패: {ex.Message}"); }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.FormType) || string.IsNullOrWhiteSpace(_form.TemplateName))
        {
            Snackbar.Add("양식 유형과 이름은 필수입니다.", Severity.Warning);
            return;
        }

        // 표에 적은 위치를 서버가 읽는 형태로 바꿔 담는다 (사장님 지시 2026-08-12).
        _form.FieldCoordsJson = BuildCoordsJson();

        // 🔴 [20261026작1 §D-1] 워터마크 수치를 담는다 — **미리보기와 같은 한 벌**을 쓴다.
        ApplyWatermarkToForm();

        _busy = true;
        try
        {
            HttpResponseMessage resp;
            if (string.IsNullOrEmpty(_form.TemplateId))
            {
                resp = await Http.PostAsJsonAsync("api/settings/form-templates", _form);
            }
            else
            {
                resp = await Http.PutAsJsonAsync($"api/settings/form-templates/{_form.TemplateId}", _form);
            }

            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add("저장되었습니다.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                var body = await resp.Content.ReadAsStringAsync();
                Snackbar.Add($"저장 실패 ({(int)resp.StatusCode}): {body}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"저장 실패: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
