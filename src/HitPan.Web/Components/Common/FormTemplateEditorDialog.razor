                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                               Title="미리보기 닫기" OnClick="ClosePreviewAsync" />
            </div>
            <iframe src="@_previewUrl" style="width:100%;height:560px;border:1px solid #ddd;"
                    title="양식 미리보기"></iframe>
        }
    </DialogContent>
    <DialogActions>
        @* 품목 줄 수 — 🔴 "몇 줄부터 두 쪽이 되나" 를 눈으로 보는 것이 이 화면의 목적이다. *@
        <MudNumericField T="int" @bind-Value="_previewLines" Label="예시 품목 줄" Min="1" Max="200"
                         Margin="Margin.Dense" Style="max-width:120px;" />
