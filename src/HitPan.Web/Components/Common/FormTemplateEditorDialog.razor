                            <MudButton Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.UploadFile"
                                       Disabled="_bgBusy">
                                @(_bgBusy ? "올리는 중…" : "양식용지 그림 올리기")
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>
                    @if (!string.IsNullOrWhiteSpace(_form.BackgroundImageUrl))
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Error"
                                   StartIcon="@Icons.Material.Filled.Delete"
                                   Disabled="_bgBusy"
                                   OnClick="RemoveBackgroundAsync">그림 지우기</MudButton>
