    /// <summary>
    /// 🔴 저장하지 않은 지금 화면 값으로 종이를 그린다.
    /// 사장님: <i>"실제 출력물 양식을 편집하는 대로 보여주는 게 중요함"</i>
    /// </summary>
    /// <remarks>
    /// 🔴 <b>저장하지 않는다.</b> 미리보기가 값을 저장하면 고객이 「확인만 해보려다」
    ///    양식을 바꿔 버린다. 그려 보고 마음에 안 들면 취소할 수 있어야 한다.
    /// 🔴 서버는 <b>정본 인쇄 통로</b>를 그대로 탄다 — 미리보기 전용 작성기는 없다.
    ///    두 벌이 되면 미리보기와 실제 인쇄물이 조용히 어긋난다.
    /// 🔴 전표 id 를 안 보낸다 — 예시 자료로만 그린다(남의 전표가 나갈 길이 없다).
    /// </remarks>
    /// <summary>
    /// 🔴 지금 고른 용지·방향이 <b>종이에 안 먹는</b> 경우라면 그 까닭. 먹으면 <c>null</c>.
    /// </summary>
    /// <remarks>
    /// 🔴 [2026-10-25 재검증 S-4 봉합] 서버가 막는 두 경우를 **화면 말로** 옮긴 것이다.
    ///   서버가 진실원이고 이 글은 안내다 — 판단을 둘로 나누지 않으려고 조건을 똑같이 적었다.
    /// 🔴 조건이 서버와 어긋나면 고객이 거짓 안내를 받는다. 그래서 게이트가 **양쪽을 대조**한다.
    /// </remarks>
    private string? PaperChoiceIgnored
    {
        get
        {
            var isA4Portrait =
                string.Equals(_form.PaperSize?.Trim(), "A4", StringComparison.OrdinalIgnoreCase)
                && !string.Equals(_form.Orientation?.Trim(), "landscape", StringComparison.OrdinalIgnoreCase);

            if (isA4Portrait) return null;   // 바꾼 게 없으면 할 말도 없다

            // ① 법정 서식 — 세금계산서·면세계산서·입금표
            if (LegalFormTypes.Contains(_form.FormType ?? string.Empty))
            {
                return "이 서식은 법으로 모양이 정해져 있어 용지와 방향은 A4 세로로 인쇄됩니다. "
                     + "고르신 값은 저장되지만 종이에는 적용되지 않습니다.";
            }

            // ② 좌표를 맞춰 둔 양식용지 — 종이가 바뀌면 맞춰 둔 위치가 어긋난다
            // 🔴🔴 [2026-10-25 3차 재검증 T-5ⓑ 봉합] 종전에는 **칸 이름만** 봤다.
            //   서버는 이름이 있어도 **위치가 종이 밖이면 그 줄을 버린다.** 그래서
            //   「이름만 적고 위치는 안 맞춘」 양식에서 화면은 「A4 로 인쇄됩니다」라고
            //   말하는데 서버는 A5 를 냈다 ⇒ 🔴 **고객이 거짓 안내를 받았다.**
            //   ⇒ 서버가 받아 주는 줄이 하나라도 있는지로 센다(판정 규칙을 같게).
            if (_form.PaperMode == "preprint" && _coords.Any(IsCoordUsableByServer))
            {
                return "위치를 맞춰 두셨기 때문에 용지와 방향은 A4 세로로 인쇄됩니다. "
                     + "위치는 종이 크기를 기준으로 재어 둔 값이라, 용지를 바꾸면 다시 맞추셔야 합니다.";
            }

            return null;
        }
    }

    /// <summary>
    /// 🔴 이 좌표 줄을 <b>서버가 실제로 받아 주나</b> — 서버 <c>ParseFieldCoords</c> 와 같은 규칙.
    /// </summary>
    /// <remarks>
    /// 🔴 [2026-10-25 3차 재검증 T-5ⓑ] 규칙이 둘로 갈리면 고객이 거짓 안내를 받는다.
    ///   서버는 ⒜ 칸 이름이 있고 ⒝ 위치가 <b>종이 안</b>일 때만 그 줄을 쓴다.
    /// 🔴 숫자(420·594)는 서버가 쓰는 값이다. 바꾸려면 <b>양쪽을 같이</b> 바꿔야 하고,
    ///   게이트가 두 자리를 대조한다.
    /// </remarks>
    private static bool IsCoordUsableByServer(CoordRow c)
        => !string.IsNullOrWhiteSpace(c.Key)
        && c.XMm >= 0 && c.YMm >= 0
        && c.XMm <= 420 && c.YMm <= 594;

    /// <summary>
    /// 🔴 용지·방향을 바꿀 수 없는 <b>법으로 정해진 서식</b>. 서버 <c>LegalFormDocTypes</c> 와 짝이다.
    /// 🔴 법정성 판정은 법무팀장 몫이고, 그 전까지는 <b>막는 쪽</b>에 둔다(재검증 S-3).
    /// </summary>
    private static readonly string[] LegalFormTypes =
        { "tax_invoice", "invoice_exempt", "payment_receipt" };

    /// <summary>
    /// 🔴 [2026-10-25 [4] 반려 R-1 봉합] 「빈 A4」인데 <b>법정 전용 작성기</b>로 가는 경우 —
    /// 올려 둔 그림이 <b>미리보기에도 안 깔린다</b>.
    /// </summary>
    /// <remarks>
    /// 🔴 <c>LegalFormTypes</c> 와 <b>같지 않다</b>. 서버가 전용 작성기로 가르는 조건은
    ///   <c>PdfRenderService.cs:117</c> 의 <c>documentType == TaxInvoiceDocType &amp;&amp; !isPreprint</c>
    ///   하나뿐이라 <b>세금계산서만</b>이다. 면세계산서·입금표는 공용 흐름을 타므로
    ///   「빈 A4」에서도 미리보기에는 깔린다.
    /// 🔴 두 목록을 한데 묶으면 다시 거짓이 된다 — 그래서 일부러 갈라 둔다.
    ///   (용지·방향을 묶는 쪽은 <c>LegalFormTypes</c> 3종이고, 그림을 아예 안 쓰는 쪽은 이 1종이다.)
    /// </remarks>
    private bool IsLegalOnlyComposer
        => _form.PaperMode != "preprint"
        && string.Equals(_form.FormType, "tax_invoice", StringComparison.Ordinal);

