@* 양식 템플릿 신규/수정 다이얼로그 (사장님 작업지시 작지②·③) *@
@using System.Net.Http.Json
@using HitPan.Web.Pages.SettingsUi
@inject HttpClient Http
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="_form.FormType" Label="양식 유형" Required="true" Margin="Margin.Dense">
                    @foreach (var ft in FormTypes)
                    {
                        <MudSelectItem T="string" Value="@ft.Key">@ft.Value</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField T="string" @bind-Value="_form.TemplateName" Label="양식 이름" Required="true" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="6">
                @* 개발용어 정리 (헌법 — 고객 노출 영역): "필드값·좌표대로" 를 현장 말로 바꿨다. *@
                <MudSelect T="string" @bind-Value="_form.PaperMode" Label="어떤 종이에 인쇄하나요?" Margin="Margin.Dense">
                    <MudSelectItem Value="@("plain")">빈 A4 용지 (테두리까지 전부 인쇄)</MudSelectItem>
                    <MudSelectItem Value="@("preprint")">미리 인쇄된 양식용지 (내용만 채워 인쇄)</MudSelectItem>
                </MudSelect>
            </MudItem>

            @* 🔴 인쇄 매수 (사장님 지시 2026-08-11):
                 *"공급받는자만 (혹은 공급자만) / 공급받는자 / 공급자 인쇄"*
                 *"둘 다 찍을지, 혹은 거래처 명세서만 찍을지"*

                 세금계산서·계산서는 **법정 2매**다(부가가치세법 시행규칙 — 공급자보관용·
                 공급받는자보관용 2매 작성, 1매 교부, 5년 보관). 그래서 이 칸이 없으면
                 법을 지킬 수 없었다. 거래명세서도 관행상 2장이다. *@
            <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="_form.PrintCopyMode" Label="한 번에 몇 장 인쇄하나요?" Margin="Margin.Dense">
                    <MudSelectItem Value="@("recipient")">거래처 것만 (1장)</MudSelectItem>
                    <MudSelectItem Value="@("both")">거래처 것 + 우리 보관용 (2장)</MudSelectItem>
                    <MudSelectItem Value="@("supplier")">우리 보관용만 (1장)</MudSelectItem>
                </MudSelect>
                @if (_form.FormType is "tax_invoice" or "invoice_exempt")
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        세금계산서·계산서는 법으로 2장을 만들어 1장을 거래처에 주도록 정해져 있습니다.
                    </MudText>
                }
            </MudItem>
            <MudItem xs="6" md="3">
                <MudSelect T="string" @bind-Value="_form.PaperSize" Label="용지 크기" Margin="Margin.Dense">
                    <MudSelectItem Value="@("A4")">A4</MudSelectItem>
                    <MudSelectItem Value="@("A5")">A5</MudSelectItem>
                    <MudSelectItem Value="@("Letter")">Letter</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="6" md="3">
                <MudSelect T="string" @bind-Value="_form.Orientation" Label="방향" Margin="Margin.Dense">
                    <MudSelectItem Value="@("portrait")">세로</MudSelectItem>
                    <MudSelectItem Value="@("landscape")">가로</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="6" md="3">
                <MudNumericField T="decimal" @bind-Value="_form.MarginTopMm" Label="여백 상(mm)" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="6" md="3">
                <MudNumericField T="decimal" @bind-Value="_form.MarginLeftMm" Label="여백 좌(mm)" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="6" md="3">
                <MudNumericField T="decimal" @bind-Value="_form.MarginRightMm" Label="여백 우(mm)" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="6" md="3">
                <MudNumericField T="decimal" @bind-Value="_form.MarginBottomMm" Label="여백 하(mm)" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudCheckBox T="bool" @bind-Value="_form.ShowCompanyLogo" Label="회사 로고 표시" Dense="true" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudCheckBox T="bool" @bind-Value="_form.ShowCompanySeal" Label="회사 도장 표시" Dense="true" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudCheckBox T="bool" @bind-Value="_form.ShowBorder" Label="테두리 표시" Dense="true" />
            </MudItem>
            <MudItem xs="12">
                <MudCheckBox T="bool" @bind-Value="_form.IsDefault" Label="기본 양식으로 설정 (1 form_type 당 1개)" Dense="true" />
            </MudItem>
            @if (_form.PaperMode == "preprint")
            {
                <MudItem xs="12">
                    <MudTextField T="string" @bind-Value="_form.BackgroundImageUrl" Label="배경 이미지 URL (양식용지 미리보기 참조)" Margin="Margin.Dense" />
                </MudItem>
                @* 🔴 종전에는 이 자리가 JSON 입력칸이었다 (사장님 지시 2026-08-12 정리).
                     현장 직원이 대괄호·따옴표를 손으로 적어야 했고, 한 글자만 틀려도
                     좌표가 통째로 무시됐다 — 그런데 오류도 안 났다.
                     "처음 보는 사람이 혼자 쓸 수 있냐" 를 통과 못 하는 화면이었다.
                     ⇒ 자로 잰 값을 칸에 적어 넣는 표로 바꾼다. JSON 은 저장할 때 우리가 만든다. *@
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="mt-2">양식용지 위치 맞추기</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        양식용지 <b>왼쪽 위 모서리</b>에서 자로 재어 적으세요. 단위는 mm 입니다.
                        비워 두면 히트판 기본 배치로 인쇄합니다.
                    </MudText>
                </MudItem>

                @foreach (var c in _coords)
                {
                    <MudItem xs="12">
                        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
                            <MudSelect T="string" @bind-Value="c.Key" Label="어느 칸" Margin="Margin.Dense"
                                       Variant="Variant.Outlined" Style="min-width:170px">
                                @foreach (var g in CoordFields)
                                {
                                    <MudSelectItem Value="@g.Key">@g.Value</MudSelectItem>
                                }
                            </MudSelect>
                            <MudNumericField T="decimal" @bind-Value="c.XMm" Label="왼쪽에서(mm)" Margin="Margin.Dense"
                                             Variant="Variant.Outlined" Min="0" Max="420" Style="width:130px" />
                            <MudNumericField T="decimal" @bind-Value="c.YMm" Label="위에서(mm)" Margin="Margin.Dense"
                                             Variant="Variant.Outlined" Min="0" Max="594" Style="width:130px" />
                            <MudNumericField T="decimal" @bind-Value="c.FontPt" Label="글자크기" Margin="Margin.Dense"
                                             Variant="Variant.Outlined" Min="5" Max="30" Style="width:110px" />
                            <MudSelect T="string" @bind-Value="c.Align" Label="정렬" Margin="Margin.Dense"
                                       Variant="Variant.Outlined" Style="width:120px">
                                <MudSelectItem Value="@("left")">왼쪽</MudSelectItem>
                                <MudSelectItem Value="@("right")">오른쪽</MudSelectItem>
                                <MudSelectItem Value="@("center")">가운데</MudSelectItem>
                            </MudSelect>
                            @* 오른쪽·가운데 정렬은 칸 너비를 알아야 어디에 붙일지 정해진다. *@
                            @if (c.Align != "left")
                            {
                                <MudNumericField T="decimal" @bind-Value="c.WidthMm" Label="칸 너비(mm)" Margin="Margin.Dense"
                                                 Variant="Variant.Outlined" Min="0" Max="200" Style="width:130px" />
                            }
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                           OnClick="@(() => _coords.Remove(c))" Title="이 칸 지우기" />
                        </div>
                    </MudItem>
                }

                <MudItem xs="12">
                    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
                        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Add" OnClick="AddCoord">칸 추가</MudButton>
                        @* 품목 줄은 첫 줄만 잡으면 아래로 같은 간격으로 반복된다 —
                             줄마다 좌표를 적게 하면 아무도 못 쓴다. *@
                        <MudNumericField T="decimal" @bind-Value="_rowPitchMm" Label="품목 줄 간격(mm)" Margin="Margin.Dense"
                                         Variant="Variant.Outlined" Min="0" Max="50" Style="width:160px" />
                        <MudNumericField T="int" @bind-Value="_maxRows" Label="한 장에 넣을 줄 수" Margin="Margin.Dense"
                                         Variant="Variant.Outlined" Min="0" Max="99" Style="width:170px" />
                    </div>
                </MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">취소</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_busy" OnClick="SaveAsync">@(_busy ? "저장 중…" : "저장")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private static readonly Dictionary<string, string> FormTypes = new()
    {
        ["estimate"] = "견적서",
        ["sales_order"] = "수주서",
        ["delivery"] = "거래명세서",
        ["purchase_order"] = "발주서",
        ["receipt"] = "매입명세서",
        ["purchase_return"] = "매입반품",
        ["sales_return"] = "판매반품",
        ["tax_invoice"] = "세금계산서",
        // 사장님 결재 2026-08-11 — 10종 확장.
        ["invoice_exempt"] = "계산서",
        ["payment_receipt"] = "입금표"
    };
    // ⚠️ 이 목록은 지금 **3곳**에 있다 — 여기 · FormTemplatesPage.razor · 서버 FormTemplateService.
    //   양식을 늘릴 때 셋을 같이 고쳐야 한다. 한 곳만 고치면 화면에 코드값(invoice_exempt)이
    //   그대로 보이거나, 만들어졌는데 목록에 안 뜨는 어긋남이 난다.
    //   ⬜ 정리 대상: 서버가 목록을 내려주고 화면은 받아 쓰는 구조가 맞다(별건).

    /// <summary>양식용지에서 위치를 잡을 수 있는 칸들. 서버 렌더가 아는 이름과 짝이다.</summary>
    /// <remarks>
    /// ⚠️ 여기 이름(왼쪽 값)은 <b>PdfRenderService.HeaderValue / LineValue</b> 가 받는 이름이어야 한다.
    ///   화면에서 고를 수 있는데 서버가 모르는 이름이면 <b>그 칸만 조용히 안 찍힌다.</b>
    /// </remarks>
    private static readonly Dictionary<string, string> CoordFields = new()
    {
        ["거래처"] = "거래처 이름",
        ["사업자번호"] = "거래처 사업자번호",
        ["주소"] = "거래처 주소",
        ["연락처"] = "거래처 연락처",
        ["문서번호"] = "문서번호",
        ["일자"] = "일자 (2026-08-12)",
        ["년"] = "일자 — 년",
        ["월"] = "일자 — 월",
        ["일"] = "일자 — 일",
        ["line.번호"] = "품목 줄 — 번호",
        ["line.품목"] = "품목 줄 — 품목명",
        ["line.규격"] = "품목 줄 — 규격",
        ["line.수량"] = "품목 줄 — 수량",
        ["line.단가"] = "품목 줄 — 단가",
        ["line.공급가액"] = "품목 줄 — 공급가액",
        ["line.세액"] = "품목 줄 — 세액",
        ["line.금액"] = "품목 줄 — 금액",
        ["공급가액"] = "합계 — 공급가액",
        ["세액"] = "합계 — 세액",
        ["합계"] = "합계 — 총액",
        ["비고"] = "비고"
    };

    /// <summary>화면에서 다루는 좌표 한 줄. 저장할 때 JSON 으로 바꾼다.</summary>
    private sealed class CoordRow
    {
        public string Key { get; set; } = "거래처";
        public decimal XMm { get; set; }
        public decimal YMm { get; set; }
        public decimal FontPt { get; set; } = 10m;
        public string Align { get; set; } = "left";
        public decimal WidthMm { get; set; }
    }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public FormTemplatesPage.FormTemplateDto? Template { get; set; }

    private FormTemplatesPage.FormTemplateDto _form = new();
    private bool _busy;

    private List<CoordRow> _coords = new();
    private decimal _rowPitchMm = 6m;
    private int _maxRows;

    private void AddCoord() => _coords.Add(new CoordRow());

    protected override void OnInitialized()
    {
        if (Template != null)
        {
            _form = new FormTemplatesPage.FormTemplateDto
            {
                TemplateId = Template.TemplateId,
                FormType = Template.FormType,
                TemplateName = Template.TemplateName,
                PaperMode = Template.PaperMode,
                PaperSize = Template.PaperSize,
                Orientation = Template.Orientation,
                MarginTopMm = Template.MarginTopMm,
                MarginLeftMm = Template.MarginLeftMm,
                MarginRightMm = Template.MarginRightMm,
                MarginBottomMm = Template.MarginBottomMm,
                FieldCoordsJson = Template.FieldCoordsJson,
                BackgroundImageUrl = Template.BackgroundImageUrl,
                ShowCompanyLogo = Template.ShowCompanyLogo,
                ShowCompanySeal = Template.ShowCompanySeal,
                ShowBorder = Template.ShowBorder,
                IsDefault = Template.IsDefault,
                IsActive = Template.IsActive
            };
            LoadCoords(Template.FieldCoordsJson);
        }
        else
        {
            _form.FormType = "estimate";
            _form.TemplateName = "신규 양식";
        }
    }

    /// <summary>저장돼 있던 좌표를 표로 되돌린다.</summary>
    /// <remarks>
    /// 예전에 JSON 칸으로 직접 적어 둔 고객이 있을 수 있다 — 그 값도 그대로 읽혀야 한다.
    /// 읽다가 실패하면 화면이 안 뜨는 것보다 빈 표로 여는 편이 낫다.
    /// </remarks>
    private void LoadCoords(string? json)
    {
        _coords = new List<CoordRow>();
        if (string.IsNullOrWhiteSpace(json)) return;

        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            if (doc.RootElement.ValueKind != System.Text.Json.JsonValueKind.Array) return;

            foreach (var el in doc.RootElement.EnumerateArray())
            {
                if (el.ValueKind != System.Text.Json.JsonValueKind.Object) continue;
                var key = Str(el, "key") ?? Str(el, "name");
                if (string.IsNullOrWhiteSpace(key)) continue;

                var x = (decimal)(Num(el, "x_mm", "xMm", "x") ?? 0d);
                var y = (decimal)(Num(el, "y_mm", "yMm", "y") ?? 0d);

                // 줄 간격·줄 수는 좌표가 아니라 설정값이라 별도 칸으로 뺀다.
                if (key.Equals("row_pitch", StringComparison.OrdinalIgnoreCase)) { _rowPitchMm = y; continue; }
                if (key.Equals("max_rows", StringComparison.OrdinalIgnoreCase)) { _maxRows = (int)x; continue; }

                _coords.Add(new CoordRow
                {
                    Key = key,
                    XMm = x,
                    YMm = y,
                    FontPt = (decimal)(Num(el, "font_pt", "fontPt", "font") ?? 10d),
                    Align = (Str(el, "align") ?? "left").ToLowerInvariant(),
                    WidthMm = (decimal)(Num(el, "width_mm", "widthMm", "width") ?? 0d)
                });
            }
        }
        catch
        {
            // 못 읽으면 빈 표로 연다 — 고장난 값 때문에 설정 화면 자체가 막히면 안 된다.
            _coords = new List<CoordRow>();
        }

        static string? Str(System.Text.Json.JsonElement el, string n) =>
            el.TryGetProperty(n, out var p) && p.ValueKind == System.Text.Json.JsonValueKind.String ? p.GetString() : null;

        static double? Num(System.Text.Json.JsonElement el, params string[] names)
        {
            foreach (var n in names)
            {
                if (!el.TryGetProperty(n, out var p)) continue;
                if (p.ValueKind == System.Text.Json.JsonValueKind.Number && p.TryGetDouble(out var d)) return d;
                if (p.ValueKind == System.Text.Json.JsonValueKind.String
                    && double.TryParse(p.GetString(), System.Globalization.NumberStyles.Float,
                                       System.Globalization.CultureInfo.InvariantCulture, out var s)) return s;
            }
            return null;
        }
    }

    /// <summary>표를 서버가 읽는 JSON 으로 바꾼다.</summary>
    private string? BuildCoordsJson()
    {
        // 양식용지가 아니면 좌표는 의미가 없다 — 남겨 두면 나중에 모드만 바꿨을 때 엉뚱하게 살아난다.
        if (_form.PaperMode != "preprint") return null;

        var rows = _coords
            .Where(c => !string.IsNullOrWhiteSpace(c.Key))
            .Select(c => new Dictionary<string, object>
            {
                ["key"] = c.Key,
                ["x_mm"] = c.XMm,
                ["y_mm"] = c.YMm,
                ["font_pt"] = c.FontPt,
                ["align"] = c.Align,
                ["width_mm"] = c.WidthMm
            })
            .ToList();

        if (rows.Count == 0) return null;   // 빈 목록이면 기본 배치로 인쇄된다

        // 줄 간격·줄 수는 같은 목록에 설정값으로 얹는다(서버가 이 이름으로 꺼내 쓴다).
        if (_rowPitchMm > 0)
            rows.Add(new Dictionary<string, object> { ["key"] = "row_pitch", ["x_mm"] = 0m, ["y_mm"] = _rowPitchMm });
        if (_maxRows > 0)
            rows.Add(new Dictionary<string, object> { ["key"] = "max_rows", ["x_mm"] = (decimal)_maxRows, ["y_mm"] = 0m });

        return System.Text.Json.JsonSerializer.Serialize(rows);
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.FormType) || string.IsNullOrWhiteSpace(_form.TemplateName))
        {
            Snackbar.Add("양식 유형과 이름은 필수입니다.", Severity.Warning);
            return;
        }

        // 표에 적은 위치를 서버가 읽는 형태로 바꿔 담는다 (사장님 지시 2026-08-12).
        _form.FieldCoordsJson = BuildCoordsJson();

        _busy = true;
        try
        {
            HttpResponseMessage resp;
            if (string.IsNullOrEmpty(_form.TemplateId))
            {
                resp = await Http.PostAsJsonAsync("api/settings/form-templates", _form);
            }
            else
            {
                resp = await Http.PutAsJsonAsync($"api/settings/form-templates/{_form.TemplateId}", _form);
            }

            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add("저장되었습니다.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                var body = await resp.Content.ReadAsStringAsync();
                Snackbar.Add($"저장 실패 ({(int)resp.StatusCode}): {body}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"저장 실패: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
