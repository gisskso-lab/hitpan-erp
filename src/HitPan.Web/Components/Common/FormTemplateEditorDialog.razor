                @if (!string.IsNullOrWhiteSpace(_form.BackgroundImageUrl))
                {
                    @* 🔴🔴 [2026-10-25 [4] 반려 R-1 봉합을 **유지**] 판정을 갈라 각각 참을 말한다.
                         부사를 다듬어 받지 않는다. 이제 축이 하나 늘었다(종이에 찍나). *@
                    @if (IsLegalOnlyComposer)
