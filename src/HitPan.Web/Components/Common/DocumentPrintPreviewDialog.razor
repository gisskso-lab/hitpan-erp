@* 🔴 전표 인쇄 미리보기 — 7종 공통 한 벌 (사장님 결재 2026-10-24 결-2)
     사장님 워크플로우:
       인쇄 클릭 → 미리보기로 넘어가 어떤 양식이 적용되는지 보여준다
       → 옵션 선택 → 최종 인쇄는 미리보기 화면과 동일

     🔴 종별로 갈라 만들지 않는다. 갈라 만들면 일곱 벌이 되고
        양식 칸이 늘 때마다 일곱 군데를 고쳐야 한다. *@
@using System.Net.Http.Json
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject ILogger<DocumentPrintPreviewDialog> Logger

<MudDialog>
    <DialogContent>
        @* 옵션 줄 — 🔴 7종이 같은 모양을 쓴다. 그 종에 안 쓰이는 칸은
             **흐리게 두고 숨기지 않는다**. 고객이 "왜 나는 그 칸이 없지" 를 겪지 않게. *@
        <div class="d-flex align-center flex-wrap mb-3" style="gap:12px;">
            <MudSelect T="string" Value="_copyMode" ValueChanged="OnCopyModeChangedAsync" Label="인쇄 매수" Dense="true"
                       Margin="Margin.Dense" Style="min-width:200px;"
                       Disabled="@(!SupportsCopyMode)"
                       HelperText="@(SupportsCopyMode ? null : "이 문서는 한 벌만 인쇄합니다")">
                <MudSelectItem Value="@("both")">공급자 + 공급받는자</MudSelectItem>
                <MudSelectItem Value="@("recipient")">공급받는자만</MudSelectItem>
                <MudSelectItem Value="@("supplier")">공급자만</MudSelectItem>
            </MudSelect>

            <MudCheckBox T="bool" Value="_tearLine" ValueChanged="OnTearLineChangedAsync" Dense="true"
                         Disabled="@(!SupportsTearLine)"
                         Label="한 장에 두 벌 + 가운데 자르는 선" />

            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh"
                       Disabled="_busy" OnClick="LoadAsync">@(_busy ? "그리는 중…" : "다시 그리기")</MudButton>
        </div>

        @if (!SupportsTearLine)
        {
            <MudText Typo="Typo.caption" Class="mb-2">
                「한 장에 두 벌」은 두 벌을 찍는 문서에만 쓰입니다.
            </MudText>
        }

        @* 🔴 [2026-11-20 W-G1-51 갈래 §59 · 대표 §59 「그림만 + 안내」 · PM 결재 ③ ④]
             빈 A4 + 양식 그림 + 칸 0 양식이면 종이에 그림만 나간다 → 「인쇄」 를 누르기 전 반드시 보는 이 자리에 고정 안내 1개.
             🔴 접힘 · 닫기 · 사라짐 0(스낵바는 몇 초 뒤 사라진다) · 인쇄 단추를 막지 않는다(#20) · 고장이 아니라 안내(파란 꼴).
             🔴 판정은 서버 문 하나(렌더와 같은 함수)가 한다 — 이 화면은 셈하지 않는다. 글자 = PM 결재 ④ 정정 글자 그대로.
             🔴 종이에는 안 찍는다 — 안내는 이 창에만. *@
        @if (_noCoordsNotice)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">아직 칸을 안 맞췄습니다. 이 양식으로 인쇄하면 올린 양식 그림만 나오고 전표 내용은 찍히지 않습니다. 칸을 맞추려면 「양식 템플릿」 메뉴의 양식용지 양식에서 칸을 맞추고 그림을 올려 저장한 뒤 「예」를 눌러 주십시오(양식이 하나 더 생깁니다 · 관리자).</MudAlert>
        }

        @if (_previewUrl is not null)
        {
            @* 🔴 이 틀에 보이는 것이 곧 인쇄물이다. 인쇄할 때 다시 그리지 않는다. *@
            <iframe @ref="_frame" src="@_previewUrl" style="width:100%;height:600px;border:1px solid #ddd;"
                    title="인쇄 미리보기"></iframe>
        }
        else if (!_busy)
        {
            <MudAlert Severity="Severity.Warning" Dense="true">미리보기를 불러오지 못했습니다.</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseAsync">닫기</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Print"
                   Disabled="@(_previewUrl is null || _busy)" OnClick="PrintAsync">인쇄</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>화면이 쓰는 문서 종류(하이픈 꼴) — 서버가 작성기 이름으로 바꾼다.</summary>
    [Parameter] public string DocType { get; set; } = "";
    [Parameter] public string DocId { get; set; } = "";

    private string? _previewUrl;
    private bool _busy;
    private string _copyMode = "both";
    private bool _tearLine;
    private ElementReference _frame;

    /// <summary>
    /// 🔴 [W-G1-51 갈래 §59] 이 양식으로 인쇄하면 그림만 나오나 — 서버 안내 문이 정한다. 기본 = 안 띄움.
    /// </summary>
    private bool _noCoordsNotice;

    /// <summary>
    /// 🔴 인쇄 매수·절취선은 <b>두 벌을 찍는 문서</b>의 축이다(DB-90·DB-147).
    /// 나머지 종에서는 <b>흐리게</b> 둔다 — 숨기지 않는다(결-2).
    /// </summary>
    private bool SupportsCopyMode =>
        DocType is "tax-invoice" or "tax_invoice" or "invoice-exempt" or "invoice_exempt";

    private bool SupportsTearLine => SupportsCopyMode && _copyMode == "both";

    // ⬛ 종전: protected override async Task OnInitializedAsync() => await LoadAsync();
    // 🔴 [2026-11-20 W-G1-51 갈래 §59] 창이 열릴 때 인쇄 전 안내를 **한 번** 묻는다 — 미리보기 그리기와 함께 띄우고 기다리지 않는다.
    //   안내가 늦거나 실패해도 미리보기 · 인쇄는 안 기다린다(#20). 옵션을 바꿔 다시 그릴 때는 다시 묻지 않는다(양식은 그대로).
    protected override async Task OnInitializedAsync()
    {
        _ = LoadNoticeAsync();
        await LoadAsync();
    }

    /// <summary>
    /// 🔴 [2026-11-20 W-G1-51 갈래 §59 · PM 결재 ②] 서버 안내 문(<c>GET api/documents/{type}/print-notice</c>)에 묻는다.
    /// </summary>
    /// <remarks>
    /// 🔴 실패하면 안내 없이 둔다 + 화면 콘솔 한 줄(#15) — 스낵바 0(고객에게 뜻 없는 오류를 안 띄운다 · 미리보기 · 인쇄는 그대로).
    /// 🔴 판정을 화면에서 다시 셈하지 않는다 — 참/거짓만 받는다.
    /// </remarks>
    private async Task LoadNoticeAsync()
    {
        if (string.IsNullOrWhiteSpace(DocType)) return;
        try
        {
            var said = await Http.GetFromJsonAsync<PrintNoticeSaid>($"api/documents/{DocType}/print-notice");
            _noCoordsNotice = said?.NoCoordsImageOnly == true;
        }
        catch (Exception ex)
        {
            _noCoordsNotice = false;
            // ⬛ [낡은 줄 · 화면오류기록띠] Console.Error.WriteLine($"[DocPreview.Notice] 인쇄 전 안내를 묻지 못했습니다 — 안내 없이 둡니다: {ex.Message}");
            Logger.LogWarning(ex, "[DocPreview.Notice] 인쇄 전 안내를 묻지 못했습니다 — 안내 없이 둡니다");
        }
        if (_noCoordsNotice) StateHasChanged();
    }

    private sealed class PrintNoticeSaid
    {
        public bool NoCoordsImageOnly { get; set; }
    }

    /// <summary>
    /// 지금 고른 옵션으로 <b>정본 통로</b>에 그려 달라고 한다.
    /// 🔴 옵션은 이번 한 장에만 쓰인다 — <b>저장하지 않는다</b>.
    /// </summary>
    private async Task LoadAsync()
    {
        if (string.IsNullOrWhiteSpace(DocType) || string.IsNullOrWhiteSpace(DocId))
        {
            Snackbar.Add("인쇄할 전표를 먼저 고르십시오.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            await RevokeAsync();

            var body = new
            {
                Options = new
                {
                    PrintCopyMode = SupportsCopyMode ? _copyMode : null,
                    ShowTearLine = SupportsTearLine ? (bool?)_tearLine : null
                }
            };

            var resp = await Http.PostAsJsonAsync($"api/documents/{DocType}/{DocId}/preview-pdf", body);
            if (!resp.IsSuccessStatusCode)
            {
                // 🔴 조용히 실패하지 않는다 — "눌렀는데 아무 일도 안 난다" 를 겪으면
                //    고객은 무엇이 틀렸는지 알 길이 없다.
                // 🔴 3차검증 R-11 — 서버가 **사람 말**을 보내면 그 말을 그대로 보여준다.
                //    「(404)」는 고객에게 뜻이 없다. 「저장된 전표가 아닙니다」가 뜻이다.
                var said = await ReadServerMessageAsync(resp);
                Snackbar.Add(said ?? $"미리보기를 그리지 못했습니다. ({(int)resp.StatusCode})",
                    Severity.Error);
                return;
            }

            var bytes = await resp.Content.ReadAsByteArrayAsync();
            _previewUrl = await JS.InvokeAsync<string>("hitpanMakeBlobUrl",
                "application/pdf", Convert.ToBase64String(bytes));
        }
        catch (Exception ex)
        {
            Snackbar.Add("미리보기 중 오류가 났습니다.", Severity.Error);
            // ⬛ [낡은 줄 · 화면오류기록띠] Console.Error.WriteLine($"[DocPreview] {ex.Message}");
            Logger.LogWarning(ex, "[DocPreview] 미리보기 중 오류");
        }
        finally
        {
            _busy = false;
        }
    }


    /// <summary>
    /// 🔴 20261024작 R-9 봉합 — 옵션을 바꾸면 <b>그 자리에서 다시 그린다.</b>
    /// </summary>
    /// <remarks>
    /// 🔴 종전에는 <c>@bind-Value</c> 라 값만 바뀌고 종이는 <b>옛 blob</b> 이었다.
    ///   고객이 「공급받는자만」으로 바꾸고 바로 「인쇄」를 누르면 <b>두 벌이 찍혀 나갔다</b>.
    ///   사장님 합격선 ⑤ <i>"미리보기 화면하고 동일하게 인쇄"</i> 는 참이었지만
    ///   <b>④ 고른 옵션이 그 종이에 들어간다</b> 가 거짓이었다(검증팀 2차 재검증 R-9).
    /// 🔴 「다시 그리기」 단추는 남겨 둔다 — 서버가 한 번 삐끗했을 때 사람이 다시 누를 길이다.
    /// </remarks>
    private async Task OnCopyModeChangedAsync(string value)
    {
        _copyMode = value;
        await LoadAsync();
    }

    /// <summary>절취선도 같다 — 바꾸면 바로 다시 그린다(R-9).</summary>
    private async Task OnTearLineChangedAsync(bool value)
    {
        _tearLine = value;
        await LoadAsync();
    }

    /// <summary>
    /// 🔴 <b>인쇄 모듈 경로</b> — 꼬리표를 올리면 브라우저가 새로 받는다.
    /// </summary>
    /// <remarks>
    /// 🔴 <b>왜 index.html 이 아니라 여기 적나.</b> index.html 의 <c>&lt;script src="...?v="&gt;</c> 는
    ///   <b>index.html 자체가 캐시되면 옛 꼬리표로 굳는다</b> — 1.3.62·1.3.63 이 그렇게 샜다.
    ///   이 경로는 <b>DLL 안</b>에 있고 DLL 은 다른 길로 갱신되므로, index.html 이 묵어도 새 판이 온다.
    ///   🔴 <c>doc-print.js</c> 를 고치면 <b>이 꼬리표도 같이 올린다</b>(게이트가 쌍으로 잰다).
    /// </remarks>
    private const string PrintModulePath = "./js/doc-print.js?v=20261024a";

    private IJSObjectReference? _printModule;

    /// <summary>
    /// 🔴 <b>보고 있는 그 종이를 인쇄한다</b> — 다시 그리지 않는다(합격선 ④·⑤).
    /// 사장님 결재 결-3: 브라우저 인쇄창을 띄워 기본 프린터로 보낸다.
    /// </summary>
    /// <remarks>
    /// 🔴 20261024작2 — <b>모듈을 C# 이 경로로 불러온다.</b> 종전에는 <c>index.html</c> 이 실어준
    ///   전역 함수(<c>hitpanPrintPreviewFrame</c>)를 불렀는데, <b>index.html 이 캐시되면 그 함수가
    ///   브라우저에 아예 없었다</b> ⇒ 호출이 예외로 죽고 「띄우지 못했습니다」만 떴다.
    /// 🔴 <b>돌려받는 것은 bool 이 아니라 「까닭」</b>이다. 종전 true/false 로는
    ///   <b>어느 칸에서 막혔는지 영영 알 수 없었다</b>. 브라우저는 내가 못 재는 곳이므로
    ///   다음 실측이 <b>칸 이름을 말해주게</b> 만든다.
    /// 🔴 모듈을 못 불러오면 <b>옛 전역 함수로 떨어진다</b>(묵은 index.html 에서도 한 번은 더 해본다).
    /// </remarks>
    private async Task PrintAsync()
    {
        string reason;
        try
        {
            _printModule ??= await JS.InvokeAsync<IJSObjectReference>("import", PrintModulePath);
            reason = await _printModule.InvokeAsync<string>("printPreviewFrame", _frame);
        }
        catch (Exception ex)
        {
            // ⬛ [낡은 줄 · 화면오류기록띠] Console.Error.WriteLine($"[DocPreview.Print] 모듈 경로 실패 — 옛 전역으로 떨어진다: {ex.Message}");
            Logger.LogWarning(ex, "[DocPreview.Print] 모듈 경로 실패 — 옛 전역으로 떨어진다");
            try
            {
                // 🔴 묵은 index.html 에서도 한 번은 더 해본다(옛 전역 함수는 bool 을 돌려준다).
                var ok = await JS.InvokeAsync<bool>("hitpanPrintPreviewFrame", _frame);
                reason = ok ? "ok-frame" : "blocked-popup";
            }
            catch (Exception ex2)
            {
                // ⬛ [낡은 줄 · 화면오류기록띠] Console.Error.WriteLine($"[DocPreview.Print] 전역도 없다: {ex2.Message}");
                Logger.LogWarning(ex2, "[DocPreview.Print] 전역도 없다");
                reason = "no-script";
            }
        }

        switch (reason)
        {
            case "ok-frame":
            case "ok-hidden":
            case "ok-window":
                break; // 인쇄창이 떴다 — 안내 없음
            case "blocked-popup":
                Snackbar.Add("브라우저가 인쇄창을 막았습니다. 미리보기 안의 인쇄 아이콘을 눌러 주십시오.",
                    Severity.Warning);
                break;
            case "no-frame":
                Snackbar.Add("미리보기가 아직 안 떴습니다. 잠시 뒤 다시 눌러 주십시오.", Severity.Warning);
                break;
            case "no-script":
                // 🔴 이 자리가 1.3.62·1.3.63 에서 사장님이 본 그 문구다. 까닭을 말로 적는다.
                Snackbar.Add("인쇄 기능이 아직 안 올라왔습니다. 브라우저를 새로고침(Ctrl+Shift+R) 한 뒤 다시 눌러 주십시오.",
                    Severity.Warning);
                break;
            default:
                Snackbar.Add("인쇄창을 띄우지 못했습니다. 미리보기 안의 인쇄 아이콘을 눌러 주십시오.",
                    Severity.Warning);
                break;
        }
    }


    /// <summary>
    /// 🔴 서버가 보낸 <c>message</c> 를 꺼낸다 — 없으면 <c>null</c>(3차검증 R-11).
    /// </summary>
    /// <remarks>
    /// 🔴 못 읽어도 <b>터지지 않는다</b> — 읽기에 실패하면 숫자 안내로 떨어진다.
    ///   안내문을 꺼내다가 예외가 나면 「미리보기가 안 된다」가 「화면이 죽는다」가 된다.
    /// </remarks>
    private async Task<string?> ReadServerMessageAsync(HttpResponseMessage resp)
    {
        try
        {
            var doc = await resp.Content.ReadFromJsonAsync<ServerSaid>();
            return string.IsNullOrWhiteSpace(doc?.Message) ? null : doc!.Message;
        }
        catch (Exception ex)
        {
            // ⬛ [낡은 줄 · 화면오류기록띠] Console.Error.WriteLine($"[DocPreview] 서버 안내문을 읽지 못했습니다: {ex.Message}");
            Logger.LogWarning(ex, "[DocPreview] 서버 안내문을 읽지 못했습니다");
            return null;
        }
    }

    private sealed class ServerSaid
    {
        public string? Message { get; set; }
    }
    private async Task CloseAsync()
    {
        await RevokeAsync();
        MudDialog.Close();
    }

    /// <summary>blob 주소를 거둔다 — 안 거두면 누를수록 쌓인다.</summary>
    private async Task RevokeAsync()
    {
        if (_previewUrl is null) return;
        var old = _previewUrl;
        _previewUrl = null;
        try { await JS.InvokeVoidAsync("hitpanRevokeBlobUrl", old); }
        // ⬛ [낡은 줄 · 화면오류기록띠] catch (Exception ex) { Console.Error.WriteLine($"[DocPreview] 주소 거두기 실패: {ex.Message}"); }
        catch (Exception ex) { Logger.LogWarning(ex, "[DocPreview] 주소 거두기 실패"); }
    }
}
