@namespace HitPan.Web.Components.Common

@* ══════════════════════════════════════════════════════════════
   PageHeader — 페이지 상단 제목·부제·액션 버튼 표준 레이아웃
   사용 예:
     <PageHeader Title="재고 현황"
                 Subtitle="전체 창고의 현재 재고 및 가용 수량">
       <Actions>
         <MudButton Variant="Variant.Filled" Color="Color.Primary">신규</MudButton>
         <MudButton Variant="Variant.Outlined">엑셀</MudButton>
       </Actions>
     </PageHeader>
   ══════════════════════════════════════════════════════════════ *@

<div class="hitpan-page-header no-print">
    <div>
        <h1 class="hitpan-page-title">@Title</h1>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <div class="hitpan-page-subtitle">@Subtitle</div>
        }
        @if (HeaderExtra is not null)
        {
            <div style="margin-top:4px">@HeaderExtra</div>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="hitpan-page-actions">
            @Actions
        </div>
    }
</div>

@code {
    /// <summary>페이지 메인 타이틀 (h1)</summary>
    [Parameter] public string Title { get; set; } = "";

    /// <summary>부제 (선택)</summary>
    [Parameter] public string? Subtitle { get; set; }

    /// <summary>제목 아래 추가 요소 (배지·진행률 등)</summary>
    [Parameter] public RenderFragment? HeaderExtra { get; set; }

    /// <summary>우측 액션 영역 (버튼 그룹)</summary>
    [Parameter] public RenderFragment? Actions { get; set; }
}
