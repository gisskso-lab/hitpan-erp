@namespace HitPan.Web.Components.Common

@* ══════════════════════════════════════════════════════════════
   LoadFailedState — 불러오기 실패 공용 컴포넌트

   🔴 왜 EmptyState 와 따로 있나 (20260809작4 ②번 · 사장님 결재)

   종전에는 목록 조회가 실패해도 화면이 "데이터 0건" 으로 보였다.
   직원 12명이 등록된 회사에서 API 가 잠깐 죽으면
   "아직 등록된 사용자가 없습니다" 가 떠서, 사장님이 계정이 다 날아간 줄 알았다.

   "없다" 와 "못 불러왔다" 는 전혀 다른 사실이다. 화면이 둘을 구분해야 한다.
   - 없다   → EmptyState      (회색 · 다음 할 일을 안내)
   - 못 불러왔다 → LoadFailedState (경고색 · 다시 시도 버튼)

   사용 예:
     <LoadFailedState Message="@_loadError" OnRetry="LoadAsync" />
   ══════════════════════════════════════════════════════════════ *@

<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:48px 24px;text-align:center;min-height:@MinHeight">

    <MudIcon Icon="@Icons.Material.Outlined.CloudOff"
             Style="font-size:56px;color:var(--mud-palette-warning);margin-bottom:16px" />

    <MudText Typo="Typo.subtitle1" Style="font-weight:600;margin-bottom:4px">
        @Title
    </MudText>

    <MudText Typo="Typo.body2" Style="color:var(--mud-palette-text-secondary);max-width:420px;margin-bottom:8px">
        @Subtitle
    </MudText>

    @* 실제 사유 — 있으면 보여준다. 원인을 숨기면 고객도 CS 도 진단할 수 없다. *@
    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <MudText Typo="Typo.caption"
                 Style="color:var(--mud-palette-text-disabled);max-width:420px;margin-bottom:16px;word-break:break-all">
            (@Message)
        </MudText>
    }

    @if (OnRetry.HasDelegate)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   Disabled="@Retrying"
                   OnClick="@(() => OnRetry.InvokeAsync())">
            @(Retrying ? "불러오는 중…" : "다시 시도")
        </MudButton>
    }

    @if (ChildContent is not null)
    {
        <div style="margin-top:16px">
            @ChildContent
        </div>
    }
</div>

@code {
    /// <summary>메인 문구.</summary>
    [Parameter] public string Title { get; set; } = "정보를 불러오지 못했습니다";

    /// <summary>안내 문구. 개발 용어를 쓰지 않는다(헌법 — 고객 노출 영역).</summary>
    [Parameter] public string Subtitle { get; set; }
        = "화면에 보이는 내용이 실제와 다를 수 있습니다. 잠시 후 다시 시도해주세요.";

    /// <summary>실패 사유 원문(선택). 진단용으로 작게 표시한다.</summary>
    [Parameter] public string? Message { get; set; }

    /// <summary>다시 시도 동작. 지정하면 버튼이 나온다.</summary>
    [Parameter] public EventCallback OnRetry { get; set; }

    /// <summary>재시도 진행 중이면 버튼을 잠근다.</summary>
    [Parameter] public bool Retrying { get; set; }

    /// <summary>영역 최소 높이.</summary>
    [Parameter] public string MinHeight { get; set; } = "200px";

    /// <summary>추가 콘텐츠.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
