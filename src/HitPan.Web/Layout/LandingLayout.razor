@inherits LayoutComponentBase

<div class="landing-shell">
    <header class="landing-header">
        <div class="landing-container">
            <a href="/landing" class="landing-logo">히트판 ERP</a>
            <nav class="landing-nav">
                <a href="/landing/pricing">요금제</a>
                <a href="/landing/signup" class="cta">무료 체험</a>
            </nav>
        </div>
    </header>

    <main>
        @Body
    </main>

    <footer class="landing-footer">
        <div class="landing-container">
            <div>© 2026 히트판 ERP · 처음 쓰는 사람도 그냥 되는 ERP</div>
            <div>
                <a href="/legal/service.html">이용약관</a> ·
                <a href="/legal/privacy.html">개인정보처리방침</a> ·
                <a href="/legal/data-ownership.html">데이터 소유권</a>
            </div>
        </div>
    </footer>
</div>

<style>
.landing-shell { min-height: 100vh; display: flex; flex-direction: column; font-family: 'Pretendard', 'Malgun Gothic', sans-serif; color: #0F1419; }
.landing-container { max-width: 1100px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; justify-content: space-between; }
.landing-header { background: #fff; border-bottom: 1px solid #E5E7EB; padding: 16px 0; position: sticky; top: 0; z-index: 100; }
.landing-logo { font-weight: 800; font-size: 20px; color: #0F6E56; text-decoration: none; }
.landing-nav a { margin-left: 24px; color: #0F1419; text-decoration: none; font-weight: 500; }
.landing-nav a.cta { background: #0F6E56; color: #fff; padding: 8px 18px; border-radius: 8px; }
.landing-nav a.cta:hover { background: #0A5240; }
main { flex: 1; }
.landing-footer { background: #F9FAFB; border-top: 1px solid #E5E7EB; padding: 32px 0; color: #6B7280; font-size: 14px; }
.landing-footer .landing-container { flex-direction: column; gap: 8px; text-align: center; }
.landing-footer a { color: #6B7280; }
@@media (max-width: 640px) { .landing-nav a { margin-left: 12px; font-size: 14px; } }
</style>
