@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState

@*
    백오피스 v2 사이드바 (사장님 결재 2026-06-01)
    - 헌법 #1 정합: 기존 메뉴 구조 보존, 섹션 그루핑·시각 갱신만
    - 6 섹션: 대시보드 / 고객사 / 대리점 / 결제 / 운영 / 시스템(Owner)
*@

<div class="bo-sidebar bo2-sidebar-inner">
    <div class="bo2-brand">
        <div class="bo2-brand-logo">HP</div>
        <div class="bo2-brand-text">
            <div class="bo2-brand-title">@_brandTitle</div>
            <div class="bo2-brand-sub">@_brandSub</div>
        </div>
    </div>

    <nav class="bo2-nav">
        @if (_isPlatformAdmin || _isPlatformOwner)
        {
            <!-- 섹션 1: 대시보드 -->
            <div class="bo2-nav-section">
                <div class="bo2-nav-section-label">대시보드</div>
                <NavLinkItem Href="/admin/dashboard" Icon="dashboard" Label="대시보드" Match="@NavLinkMatch.All" />
            </div>

            <!-- 섹션 2: 고객사 -->
            <div class="bo2-nav-section">
                <div class="bo2-nav-section-label">고객사</div>
                <NavLinkItem Href="/admin/tenants" Icon="business" Label="고객사 목록" Count="@_countTenants" />
                <NavLinkItem Href="/admin/tenants/issue" Icon="add_business" Label="시리얼 발급" />
            </div>

            <!-- 섹션 3: 대리점 -->
            <div class="bo2-nav-section">
                <div class="bo2-nav-section-label">대리점</div>
                <NavLinkItem Href="/admin/resellers" Icon="store" Label="대리점 목록" Count="@_countResellers" />
                <NavLinkItem Href="/admin/resellers/issue" Icon="add_business" Label="대리점 발급" />
            </div>

            <!-- 섹션 4: 결제 -->
            <div class="bo2-nav-section">
                <div class="bo2-nav-section-label">결제</div>
                <NavLinkItem Href="/admin/billing" Icon="receipt_long" Label="결제 목록" />
                <NavLinkItem Href="/admin/billing/refunds" Icon="undo" Label="환불 관리" />
                <NavLinkItem Href="/admin/settlements" Icon="account_balance" Label="수수료 정산" />
            </div>

            <!-- 섹션 5: 운영 -->
            <div class="bo2-nav-section">
                <div class="bo2-nav-section-label">운영</div>
                <NavLinkItem Href="/admin/cs" Icon="support_agent" Label="고객 지원" Count="@_countCs" />
                <NavLinkItem Href="/admin/watchdog" Icon="monitor_heart" Label="Watchdog" />
                <NavLinkItem Href="/admin/stats" Icon="bar_chart" Label="통계" />
            </div>

            @if (_isPlatformOwner)
            {
                <!-- 섹션 6: 시스템 (Owner Only) -->
                <div class="bo2-nav-section bo2-nav-section-owner">
                    <div class="bo2-nav-section-label">시스템 <span class="bo2-owner-tag">OWNER</span></div>
                    <NavLinkItem Href="/owner/system-config" Icon="settings" Label="System Config" />
                    <NavLinkItem Href="/owner/platform-users" Icon="admin_panel_settings" Label="Platform Users" />
                </div>
            }
        }
        else
        {
            <!-- 대리점 사이드바 -->
            <div class="bo2-nav-section">
                <div class="bo2-nav-section-label">대시보드</div>
                <NavLinkItem Href="/partner/dashboard" Icon="dashboard" Label="대시보드" Match="@NavLinkMatch.All" />
            </div>
            <div class="bo2-nav-section">
                <div class="bo2-nav-section-label">고객사</div>
                <NavLinkItem Href="/partner/tenants" Icon="business" Label="내 고객사" />
            </div>
            <div class="bo2-nav-section">
                <div class="bo2-nav-section-label">정산</div>
                <NavLinkItem Href="/partner/commission" Icon="payments" Label="수수료 내역" />
            </div>
        }
    </nav>

    <div class="bo2-sidebar-footer">
        <div class="bo2-sidebar-env">
            <span class="bo2-env-dot"></span>
            <span>운영 환경</span>
        </div>
    </div>
</div>

@code {
    private bool _isPlatformAdmin;
    private bool _isPlatformOwner;
    private string _brandTitle = "히트판 백오피스";
    private string _brandSub = "본사 관리";

    // 카운트 뱃지 — 시드 0건 시 null로 숨김 처리
    private int? _countTenants = null;
    private int? _countResellers = null;
    private int? _countCs = null;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var accountType = state.User.FindFirst("account_type")?.Value;
        _isPlatformAdmin = accountType == "platform_admin" || accountType == "platform_owner";
        _isPlatformOwner = accountType == "platform_owner";

        if (_isPlatformAdmin)
        {
            _brandTitle = "히트판 백오피스";
            _brandSub = _isPlatformOwner ? "Owner Console" : "본사 관리";
        }
        else
        {
            var resellerName = state.User.FindFirst("name")?.Value ?? string.Empty;
            _brandTitle = "히트판 파트너";
            _brandSub = resellerName;
        }
    }
}
