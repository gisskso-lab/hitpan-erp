@inherits LayoutComponentBase
@attribute [Authorize]
@using HitPan.Web.Components
@using HitPan.Web.Components.Common
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inject NavigationManager Nav

<CascadingAuthenticationState>
    <AuthorizeView>
        <Authorized>
            <div class="hitpan-shell">

                @* PC 전용 사이드바 — 모바일에서 CSS로 숨김 *@
                <aside class="hitpan-sidebar-aside" aria-label="메인 메뉴">
                    <Sidebar />
                </aside>

                <div class="hitpan-main">

                    @* PC 전용 상단 헤더 — 모바일에서 CSS로 숨김 *@
                    <div class="hp-pc-header">
                        <TopHeader />
                    </div>

                    @* 모바일 전용 iOS 스타일 상단바 *@
                    <div class="hp-mobile-header">
                        <div class="hp-mobile-header-inner">
                            <div class="hp-mobile-brand" @onclick="@(() => Nav.NavigateTo("/dashboard"))">
                                <div class="hp-mobile-brand-mark">H</div>
                                <span class="hp-mobile-brand-text">히트판 ERP</span>
                            </div>
                            <div class="hp-mobile-header-actions">
                                <MobileHeaderActions />
                            </div>
                        </div>
                    </div>

                    @* WS-12 1클릭 통신 봉합 배너 (헌법 #27 정합) *@
                    <CommsRecoveryBanner />

                    @* 헌법 #24 약관 v2.0.0 미동의 안내 배너 *@
                    <TermsConsentBanner />

                    @* 고리2(A안) 업데이트 동의 팝업 게이트 — 로그인 페이지가 아닌 여기서 1회 노출
                       (2026-07-22 작1: /login 폐기로 팝업이 사라지던 진범 봉합). 약관 미동의 시엔 게이트가 스킵. *@
                    <UpdateConsentGate />

                    @* 기기 인증 게이트 (20260811작3 (A), 사장님 오더 2026-08-11)
                       "인증키가 없어 인증할 수 없는 슬롯은 로그인만 되고 화면은 비활성화"
                       인증 안 된 기기면 화면을 덮고 안내 + 인증 번호 입력칸을 보여준다.

                       🔴 2026-08-18 20260818작1 (증상③) — **관문을 본문(Body) 의 부모로 올렸다.**

                         [무엇이 문제였나] <DeviceAuthGate /> 가 <main> 과 **형제**였다.
                           관문이 떠도 그 아래 본문(Body) 은 **무조건 렌더**됐다 —
                           화면은 덮이는데 **뒤에서 업무 API 가 계속 돌았다.**
                           ⇒ CSS 로 가린 것이지 막은 것이 아니었다. 관문의 뜻이 없다.

                         [고침] 관문이 켜져 있으면 **본문(Body) 을 아예 그리지 않는다.**
                           안 그리면 그 페이지의 OnInitializedAsync 가 안 돌고,
                           API 호출도 **일어나지 않는다.** 가림이 아니라 **구조적 차단**이다.

                         🔴 **승인된 기기는 아무것도 안 바뀐다** — GateActive 가 false 면
                           종전과 **똑같은 트리**를 그린다. 정상 고객이 화면을 하나 더 보면
                           사장님 설계 취지가 깨진다(작업지시서 §2). *@
                    <DeviceAuthGate @bind-GateActive="_gateActive" />

                    <main class="hitpan-content mud-px-4 mud-py-4">
                        @if (!_gateActive)
                        {
                            <ErrorBoundary>
                                <ChildContent>@Body</ChildContent>
                                <ErrorContent Context="ex">
                                    <div class="hp-error-boundary">
                                        <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Style="font-size:40px;color:#e53935;" />
                                        <p class="hp-error-msg">페이지 로드 중 오류가 발생했습니다.</p>
                                        <MudButton Variant="Variant.Outlined" OnClick="@(() => Nav.NavigateTo("/dashboard"))">홈으로</MudButton>
                                    </div>
                                </ErrorContent>
                            </ErrorBoundary>
                        }
                    </main>

                    <MobileBottomNav />
                </div>
            </div>
        </Authorized>
        <Authorizing>
            <div style="display:flex;justify-content:center;align-items:center;height:100vh">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        </Authorizing>
        <NotAuthorized>
            <RedirectToLogin />
        </NotAuthorized>
    </AuthorizeView>
</CascadingAuthenticationState>

@code {
    /// 🔴 20260818작1 (증상③) — 관문이 켜져 있나.
    ///
    ///   이 값이 true 면 위에서 <b>본문(Body) 을 아예 그리지 않는다.</b>
    ///   화면을 덮는 것이 아니라 **업무 화면 자체를 만들지 않는 것**이라
    ///   그 페이지의 초기화·API 호출이 **일어나지 않는다.**
    ///
    ///   ⚠️ 기본값은 false 다 — 관문이 답하기 전까지는 종전과 똑같이 그린다.
    ///     승인된 기기는 여기서 아무 일도 겪지 않는다.
    private bool _gateActive;
}
