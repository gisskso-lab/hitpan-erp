@* ══════════════════════════════════════════════════════════════
   AccountBadge — 상단 우측 고정 계정 정보 + 로그아웃 아이콘
   ══════════════════════════════════════════════════════════════ *@
@using System.Security.Claims
@using HitPan.Web.Services
@* 🔴 작(2026-08-14): 선언이 빠져 있었다 — 검증팀 P1 적발.
   아래에 Dispose() 를 만들어 놓고 이 한 줄이 없어 **Blazor 가 부르지 않았다.**
   그래서 화면을 옮길 때마다 AuthenticationStateChanged 핸들러가 쌓였다
   (같은 자리인 MultiTabBar·CommsRecoveryBanner 는 선언이 있다). *@
@implements IDisposable
@inject AuthenticationStateProvider AuthStateProvider
@inject TenantProfileService TenantProfile
@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="hitpan-account-badge">
    @* 계정 정보 (회사명 · 사용자명) *@
    <div class="hitpan-account-info">
        <MudIcon Icon="@Icons.Material.Filled.AccountCircle"
                 Size="Size.Small"
                 Style="color:var(--hitpan-primary)" />
        <span class="hitpan-account-text">
            @FormatCompanyAndUser()
        </span>
    </div>

    @* 로그아웃 버튼 *@
    <MudTooltip Text="로그아웃">
        <MudIconButton Icon="@Icons.Material.Filled.Logout"
                       aria-label="로그아웃"
                       Size="Size.Small"
                       OnClick="LogoutAsync" />
    </MudTooltip>
</div>

@code {
    private string? _userName;

    protected override async Task OnInitializedAsync()
    {
        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await LoadLabelsFromJwtAsync();
    }

    /// <summary>
    /// 로그인 상태가 바뀌면 이름표를 다시 읽는다.
    /// </summary>
    /// <remarks>
    /// 🔴 <c>async void</c> 를 쓰지 않는다 — 작(2026-08-14, 검증팀 P1 적발).
    /// 거기서 난 예외는 <b>아무도 못 잡아</b> 화면 아래 흰 띠가 뜬다
    /// (사장님이 1.2.75 에서 지적한 그 증상).
    /// 이 컴포넌트는 <b>상단바</b>라 어느 화면에서든 뜬다 — 토큰 갱신·로그아웃 때
    /// 통신이 끊기거나 JWT 파싱이 실패하면 실제로 난다.
    /// 이름표를 못 읽는 것은 일을 막지 않는다. 그것 때문에 화면 전체를 죽이지 않는다.
    /// </remarks>
    private void OnAuthenticationStateChanged(Task _)
    {
        _ = InvokeAsync(async () =>
        {
            try
            {
                await LoadLabelsFromJwtAsync();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                // 헌법 #15 — 빈 catch 금지. 종전 이름표를 그대로 둔다.
                Console.Error.WriteLine($"[AccountBadge] 계정 표시 갱신 실패: {ex.GetType().Name}: {ex.Message}");
            }
        });
    }

    private async Task LoadLabelsFromJwtAsync()
    {
        try
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = state.User;
            if (user.Identity?.IsAuthenticated != true)
            {
                _userName = null;
                TenantProfile.Clear();
                return;
            }

            _userName = user.FindFirst("name")?.Value
                        ?? user.FindFirst(ClaimTypes.Name)?.Value
                        ?? user.Identity?.Name;

            await TenantProfile.LoadAsync();
        }
        catch (Exception _hp15Ex)
        {
            Console.Error.WriteLine($"[HP15] " + _hp15Ex.GetType().Name + ": " + _hp15Ex.Message);
            _userName = null;
            TenantProfile.Clear();
        }
    }

    private string FormatCompanyAndUser()
    {
        var company = string.IsNullOrWhiteSpace(TenantProfile.CompanyName) ? "—" : TenantProfile.CompanyName!;
        var user = string.IsNullOrWhiteSpace(_userName) ? "—" : _userName!;
        return $"{company} · {user}";
    }

    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}
