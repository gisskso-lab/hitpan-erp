@code {
    private string AccountType { get; set; } = string.Empty;
    private int _approvalPendingCount;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        AccountType = AccountTypeHelper.GetAccountType(state.User);

        // 결재 대기 건수 로딩
        try { var pending = await ApprovalSvc.GetPendingAsync(); _approvalPendingCount = pending.Count; }
        catch { _approvalPendingCount = 0; }
    }

    private bool IsPlatformAdmin =>
        AccountType == "platform_admin";

    private bool IsReseller =>
        AccountType == "reseller" ||
        AccountType == "reseller_admin";
}
