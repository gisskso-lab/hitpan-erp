@using HitPan.Web.Helpers
@using HitPan.Web.Models
@using HitPan.Web.Services
@using System.Net.Http.Json
@inject AuthenticationStateProvider AuthStateProvider
@inject WorkTabService TabService
@inject ApprovalService ApprovalSvc
@inject NavigationManager Nav
@* 버전 표기용(사장님 오더 2026-08-04). UpdateConsentGate.razor 와 동일하게 기본 HttpClient 사용. *@
@inject HttpClient Http

@*
    히트판 ERP 사이드바 — 11그룹 + 로고 (사장님 결재 2026-04-29)
    토스 감성 디자인 (preview-design-toss.html 기반)
    SaaS 권한 (본사·대리점) 완전 배제 — 백오피스 분리
    홈 메뉴 제거 → 로고 클릭 = 대시보드 (홈 역할)

    헌법 #35 정합 (2026-06-04): /admin/*·/reseller/*·/owner/* 페이지·레이아웃 일체 HitPan.Backoffice로 분리 완료.
    HitPan.Web은 고객사 ERP 전용. 본사·대리점 코드 0건.
*@

@* 로고 — 사이드바 상단 복귀 (사장님 결재 2026-04-29 재변경). 클릭 시 대시보드. *@
<div class="hp-brand" @onclick="@(() => Nav.NavigateTo("/dashboard"))" role="button" tabindex="0" title="대시보드로 이동">
    <div class="hp-brand-mark">H</div>
    <div class="hp-brand-text">히트판 ERP</div>
</div>

<MudNavMenu Class="hp-sidebar">

    @* 2. 설정관리 (사장님 오더 2026-08-11: "대메뉴 계정관리→설정관리로 메뉴명 변경")
       ─ 왜 이름을 바꾸나: 여기 담긴 것이 계정만이 아니다. 회사정보·기기·사용환경·양식·메일까지
         히트판을 **쓰기 전에 맞춰 두는 것들**이 모여 있다. "계정관리" 라는 이름이 실제 내용보다 좁았다. *@
    @* 🔴 2026-08-11 (사장님 지시): 설정관리는 **부모계정(대표)만** 본다.
         여기에는 회사 정보·직원 계정·권한·기기·사용환경이 들어 있다. 회사를 어떻게 굴릴지
         정하는 자리이고, 직원이 만질 자리가 아니다. *@
    @if (_isTenantAdmin)
    {
    <MudNavGroup Title="설정관리" Icon="@Icons.Material.Filled.Tune" Expanded="false">
        <MudNavLink Href="/company" Icon="@Icons.Material.Filled.Business">회사 정보</MudNavLink>
        <MudNavLink Href="/users" Icon="@Icons.Material.Filled.PersonAdd">직원 계정 관리</MudNavLink>
        @* 권한 설정은 여기 남는다 (사장님 결재 2026-08-10):
           "권한설정은 히트판의 권한을 설정하는 과목이니 계정관리가 맞아."
           계정을 만드는 한 호흡(직원계정 생성 → 권한 부여)이 여기서 끝나고,
           그 다음 사람·조직 축(직급·결재·사원·HR)이 그룹웨어로 넘어간다. *@
        <MudNavLink Href="/users/permissions" Icon="@Icons.Material.Filled.Lock">권한 설정</MudNavLink>
        @* 직급 관리·결재 설정 → 그룹웨어로 이동 (사장님 결재 2026-08-10): "그룹웨어에 필요한 기능이니".
           둘 다 계정 축이 아니라 사람·조직 축이다. 결재라인이 직급·부서를 읽고,
           그 결재가 그룹웨어에서 돈다. 사원관리·HR직원현황과 한 묶음이어야 흐름이 안 끊긴다. *@
        <MudNavLink Href="/settings/devices" Icon="@Icons.Material.Filled.Devices">등록 기기 관리</MudNavLink>
        <MudNavLink Href="/settings" Icon="@Icons.Material.Filled.Tune">사용환경 설정</MudNavLink>
        @* 자료관리 → 설정관리 이동분 (사장님 오더 2026-08-11 ②):
           양식·메일은 "자료" 가 아니라 **쓰기 전에 맞춰 두는 설정**이다. 한 번 정하면 계속 쓴다. *@
        <MudNavLink Href="/print-settings" Icon="@Icons.Material.Filled.Print">양식(인쇄)정보 설정</MudNavLink>
        <MudNavLink Href="/settings/form-templates" Icon="@Icons.Material.Filled.Description">양식 템플릿 (순백지·양식용지)</MudNavLink>
        <MudNavLink Href="/settings/email" Icon="@Icons.Material.Filled.Email">이메일(SMTP) 설정</MudNavLink>
        @* AI 도우미 연동 — 자료관리에 있던 같은 항목을 여기로 병합 (사장님 오더 2026-08-11 ③).
           두 대메뉴에 같은 주소가 두 번 걸려 있었다. 같은 화면이 두 곳에 보이면 고객은
           "다른 기능인가" 하고 헷갈린다. 설정 축인 여기 하나만 남긴다. *@
        <MudNavLink Href="/settings/ai-assistant" Icon="@Icons.Material.Filled.SmartToy">AI 도우미 연동</MudNavLink>
    </MudNavGroup>
    }

    @* 3. 그룹웨어 — 결재함·인사·근태·사원관리 통합 *@
    <MudNavGroup Title="그룹웨어" Icon="@Icons.Material.Filled.Groups" Expanded="false">
        <MudNavLink Href="/approval/pending" Icon="@Icons.Material.Filled.HourglassTop">
            결재 대기
            @if (_approvalPendingCount > 0)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled" Class="ml-2">@_approvalPendingCount</MudChip>
            }
        </MudNavLink>
        <MudNavLink Href="/approval/sent" Icon="@Icons.Material.Filled.Send">내가 보낸 결재</MudNavLink>
        <MudNavLink Href="/approval/completed" Icon="@Icons.Material.Filled.CheckCircle">완료된 결재</MudNavLink>
        @* 계정관리 → 그룹웨어 이동분 (사장님 결재 2026-08-10). 결재 3형제 바로 뒤에 둔다 —
           [결재 설정]에서 세운 결재라인이 위 결재함에서 실제로 도는 순서이기 때문이다.
           사장님 결재(2026-08-09) "통일": [결재라인 설정](/settings/approval-lines)은 메뉴에서 내린 상태다.
           그 화면이 저장하던 표는 실제 결재 흐름이 읽지 않아, 거기서 결재라인을 다 넣어도 결재가 걸리지
           않았다. 결재라인은 [결재 설정] 한 곳에서만 관리한다. 화면과 주소는 남겨 뒀다 — 즐겨찾기나
           주소를 직접 입력해 들어오는 사람에게 갑자기 화면이 없어지면 더 혼란스럽기 때문이며,
           그 화면 상단에서 [결재 설정]으로 안내한다. *@
        <MudNavLink Href="/settings/approval" Icon="@Icons.Material.Filled.Rule">결재 설정</MudNavLink>
        @* 🔴 봉합 (2026-08-13, 단계4 검증 P1-2): 관리자만 쓸 수 있는 화면은 관리자에게만 보인다.
           종전엔 일반 직원에게도 [직급 관리]·[부서 관리]가 보였고, 눌러서 화면까지 열린 뒤
           API 에서 403 이 나 "불러오지 못했습니다" 만 떴다. 못 쓸 메뉴를 보여주는 것 자체가
           "처음 보는 사람이 혼자 쓸 수 있냐" 기준에 걸린다(히트판 정신). *@
        @if (_isTenantAdmin)
        {
            <MudNavLink Href="/settings/positions" Icon="@Icons.Material.Filled.Badge">직급 관리</MudNavLink>
        }
        <MudNavLink Href="/employees" Icon="@Icons.Material.Filled.People">사원관리</MudNavLink>
        <MudNavLink Href="/hr/employees" Icon="@Icons.Material.Filled.Badge">HR 직원현황</MudNavLink>
        @* 작(2026-08-12) 그룹웨어 단계1: 만들어 놓고 메뉴에 없던 화면 6개를 올린다.
           전수조사 실측 — 그룹웨어는 13화면이 아니라 20화면이었고, 그중 7개가 메뉴에 없어
           고객이 찾을 수 없는 상태였다(주소를 직접 쳐야만 들어갈 수 있었다).
           직급 관리(/hr/positions)는 위 [직급 관리](/settings/positions)와 같은 서비스·같은
           데이터를 쓰는 중복 화면이라 올리지 않는다. 화면과 주소는 남겨 둔다(헌법 #1). *@
        @* 작(2026-08-13) 단계3: 업무보고서 4종(일일·주간·월간·경위서) — 사장님 지시 2026-08-12.
           한 화면에서 종류를 탭으로 가른다. 네 메뉴로 늘리면 사이드바만 길어지고
           같은 화면을 네 번 배워야 한다. *@
        <MudNavLink Href="/hr/reports" Icon="@Icons.Material.Filled.Description">업무보고서</MudNavLink>
        @if (_isTenantAdmin)
        {
            <MudNavLink Href="/hr/departments" Icon="@Icons.Material.Filled.AccountTree">부서 관리</MudNavLink>
        }
        <MudNavLink Href="/hr/attendance" Icon="@Icons.Material.Filled.AccessTime">근태 관리</MudNavLink>
        <MudNavLink Href="/hr/attendance-calendar" Icon="@Icons.Material.Filled.CalendarMonth">근태 달력</MudNavLink>
        <MudNavLink Href="/hr/overtime" Icon="@Icons.Material.Filled.MoreTime">초과근무</MudNavLink>
        <MudNavLink Href="/hr/leave" Icon="@Icons.Material.Filled.EventAvailable">휴가·연차</MudNavLink>
        <MudNavLink Href="/hr/leave-request" Icon="@Icons.Material.Filled.EditCalendar">연차 신청</MudNavLink>
        @* 작(2026-08-13) 단계6 — 휴직. 위의 '휴가·연차'(하루~며칠, 연차에서 깎임)와 다르다.
           달·년 단위로 쉬는 것이라 표가 따로 있고, 연차 잔여를 건드리지 않는다.
           직원이 신청하는 화면이라 관리자 게이트를 두지 않는다(본인 것만 보이는 건 서버가 정한다). *@
        <MudNavLink Href="/hr/absence" Icon="@Icons.Material.Filled.EventBusy">휴직 관리</MudNavLink>
        @* 작(2026-08-13) 단계8 — 급여. 🔴 메뉴를 관리자로 감추지 않는다.
           급여 담당자는 부모계정이 아닐 수 있고(경리 직원), 권한은 서버가 menu_code='PAYROLL'
           로 판정한다. 권한 없이 열면 목록 자리에 "볼 권한이 없습니다" 가 뜬다 —
           메뉴를 숨기는 것은 차단이 아니므로 서버가 진짜 관문이다. *@
        <MudNavLink Href="/hr/payroll" Icon="@Icons.Material.Filled.Payments">급여 관리</MudNavLink>
        @* 작(2026-08-13) 단계9 — 사내 메신저. 1:1·부서·단체 3종.
           🔴 권한으로 감추지 않는다. 급여와 다른 이유다 — 메신저는 전 직원이 쓰는 물건이고,
           막으면 직원이 자기 대화도 못 본다. 열람은 '방에 낀 사람인가'로 서버가 판정한다
           (부모계정도 남의 1:1 은 못 본다 — 사장님 결재 "본인 대화만 열람").
           계정이 없는 사원은 열어도 안내 문구가 뜬다("계정 있는 사원에게만", 사장님 8/12). *@
        <MudNavLink Href="/chat" Icon="@Icons.Material.Filled.Chat">메신저</MudNavLink>
        @* 작(2026-08-13) 단계5 — 연차를 '주는' 화면. 위의 '연차 신청'(직원이 쓰는 것)과 다르다.
           반자동 3단: 자동 계산이 제안 → 관리자가 확인·수정 → 확정해야 잔여에 반영. *@
        @if (_isTenantAdmin)
        {
            <MudNavLink Href="/hr/annual-leave" Icon="@Icons.Material.Filled.Rule">연차 부여</MudNavLink>
        }
        <MudNavLink Href="/hr/leave-calendar" Icon="@Icons.Material.Filled.EditCalendar">휴가 달력</MudNavLink>
        <MudNavLink Href="/hr/leave-status" Icon="@Icons.Material.Filled.Assessment">휴가 현황</MudNavLink>
        <MudNavLink Href="/hr/expense-request" Icon="@Icons.Material.Filled.ReceiptLong">경비 신청</MudNavLink>
        <MudNavLink Href="/hr/expense-status" Icon="@Icons.Material.Filled.Assessment">경비 현황</MudNavLink>
        <MudNavLink Href="/hr/labor-contracts" Icon="@Icons.Material.Filled.Description">전자근로계약서</MudNavLink>
        <MudNavLink Href="/hr/esign-history" Icon="@Icons.Material.Filled.History">전자서명 이력</MudNavLink>
    </MudNavGroup>

    @* 4. 업체관리 *@
    <MudNavGroup Title="업체관리" Icon="@Icons.Material.Filled.Business" Expanded="false">
        <MudNavLink Href="/partners" Icon="@Icons.Material.Filled.People">업체 마스터</MudNavLink>
        <MudNavLink Href="/partners/special-prices" Icon="@Icons.Material.Filled.LocalOffer">업체 특별단가</MudNavLink>
        <MudNavLink Href="/partners/ledger" Icon="@Icons.Material.Filled.Book">업체별 원장</MudNavLink>
    </MudNavGroup>

    @* 5. 상품관리 *@
    <MudNavGroup Title="상품관리" Icon="@Icons.Material.Filled.Inventory" Expanded="false">
        <MudNavLink Href="/items" Icon="@Icons.Material.Filled.Category">상품 마스터</MudNavLink>
        <MudNavLink Href="/bom" Icon="@Icons.Material.Filled.AccountTree">BOM 자재명세서</MudNavLink>
        <MudNavLink Href="/items/special-prices" Icon="@Icons.Material.Filled.LocalOffer">상품 특별단가</MudNavLink>
        <MudNavLink Href="/items/ledger" Icon="@Icons.Material.Filled.Book">상품별 원장</MudNavLink>
    </MudNavGroup>

    @* 6. 판매관리 — 거래명세서 유지 (계산서관리로 옮기지 X) *@
    <MudNavGroup Title="판매관리" Icon="@Icons.Material.Filled.PointOfSale" Expanded="false">
        <MudNavLink Icon="@Icons.Material.Filled.RequestQuote" OnClick="@(() => TabService.TryAddTab(WorkDocumentKind.Quotation))">견적서</MudNavLink>
        <MudNavLink Href="/quotation-status" Icon="@Icons.Material.Filled.ListAlt">견적현황</MudNavLink>
        <MudNavLink Icon="@Icons.Material.Filled.Assignment" OnClick="@(() => TabService.TryAddTab(WorkDocumentKind.SalesOrder))">수주서</MudNavLink>
        <MudNavLink Href="/sales-order-status" Icon="@Icons.Material.Filled.ListAlt">수주현황</MudNavLink>
        <MudNavLink Icon="@Icons.Material.Filled.Receipt" OnClick="@(() => TabService.TryAddTab(WorkDocumentKind.SalesDelivery))">거래명세서</MudNavLink>
        <MudNavLink Href="/sales/summary" Icon="@Icons.Material.Filled.BarChart">판매현황</MudNavLink>
        <MudNavLink Href="/sales/ranking" Icon="@Icons.Material.Filled.EmojiEvents">판매순위표</MudNavLink>
        <MudNavLink Href="/sales/profitability" Icon="@Icons.Material.Filled.TrendingUp">판매수익성분석</MudNavLink>
        <MudNavLink Href="/sales/statistics" Icon="@Icons.Material.Filled.Analytics">판매통계</MudNavLink>
    </MudNavGroup>

    @* 7. 매입관리 *@
    <MudNavGroup Title="매입관리" Icon="@Icons.Material.Filled.ShoppingCart" Expanded="false">
        <MudNavLink Icon="@Icons.Material.Filled.AddShoppingCart" OnClick="@(() => TabService.TryAddTab(WorkDocumentKind.PurchaseOrder))">발주서</MudNavLink>
        <MudNavLink Href="/purchase-order-status" Icon="@Icons.Material.Filled.ListAlt">발주현황</MudNavLink>
        <MudNavLink Icon="@Icons.Material.Filled.MoveToInbox" OnClick="@(() => TabService.TryAddTab(WorkDocumentKind.PurchaseReceipt))">매입 처리</MudNavLink>
        <MudNavLink Href="/purchase-status" Icon="@Icons.Material.Filled.ListAlt">매입현황</MudNavLink>
        <MudNavLink Icon="@Icons.Material.Filled.AssignmentReturn" OnClick="@(() => TabService.TryAddTab(WorkDocumentKind.Return))">반품 처리</MudNavLink>
        <MudNavLink Href="/return-status" Icon="@Icons.Material.Filled.ListAlt">반품현황</MudNavLink>
        <MudNavLink Href="/purchase/ranking" Icon="@Icons.Material.Filled.EmojiEvents">매입순위표</MudNavLink>
        <MudNavLink Href="/purchase/statistics" Icon="@Icons.Material.Filled.Analytics">매입통계</MudNavLink>
    </MudNavGroup>

    @* 8. 계산서관리 — 전자세금계산서 발행 전용 + 통계 *@
    <MudNavGroup Title="계산서관리" Icon="@Icons.Material.Filled.Description" Expanded="false">
        <MudNavLink Href="/tax-invoice" Icon="@Icons.Material.Filled.ReceiptLong">전자세금계산서 발행</MudNavLink>
        <MudNavLink Icon="@Icons.Material.Filled.FactCheck" Disabled="true">
            전자세금계산서 관리
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default" Class="ml-2">준비 중</MudChip>
        </MudNavLink>
        <MudNavLink Icon="@Icons.Material.Filled.CloudSync" Disabled="true">
            홈택스 연동 설정
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default" Class="ml-2">준비 중</MudChip>
        </MudNavLink>
        <MudNavLink Href="/tax/certificate" Icon="@Icons.Material.Filled.VpnKey">범용인증서 관리</MudNavLink>
        @* 자료관리 → 계산서관리 이동분 (사장님 오더 2026-08-11 ④).
           세금계산서를 발행하려면 인증서가 있어야 하고, 발행하고 나면 이력을 본다.
           그 둘이 다른 대메뉴에 있으면 발행하다 말고 자료관리로 건너가야 했다. *@
        <MudNavLink Href="/settings/tax-invoice-cert" Icon="@Icons.Material.Filled.VerifiedUser">전자세금계산서 인증서</MudNavLink>
        <MudNavLink Href="/sales/tax-invoice-history" Icon="@Icons.Material.Filled.History">세금계산서 발행이력</MudNavLink>
        <MudNavLink Href="/tax-invoice-stats" Icon="@Icons.Material.Filled.BarChart">세금계산서 통계</MudNavLink>
    </MudNavGroup>

