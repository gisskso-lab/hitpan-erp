@implements IDisposable
@using System.Security.Claims
@using HitPan.Web.Helpers
@using HitPan.Web.Models
@using HitPan.Web.Services
@inject NavigationManager Navigation
@inject WorkTabService TabService
@inject AuthenticationStateProvider AuthStateProvider

<div class="hitpan-sidebar mud-elevation-1">
    <div class="hitpan-sidebar-logo" title="히트판">HP</div>
    <nav class="hitpan-sidebar-nav" aria-label="주 메뉴">
        @foreach (var item in _visibleItems)
        {
            var active = IsActive(item.Href);
            <button type="button"
                    class="hitpan-sidebar-item @(active ? "hitpan-sidebar-item--active" : null)"
                    title="@item.Title"
                    @onclick="@(() => OnMenuClick(item))">
                <MudIcon Icon="@item.Icon" Class="hitpan-sidebar-icon" />
                <span class="hitpan-sidebar-label">@item.Title</span>
            </button>
        }
    </nav>
</div>

@code {
    private List<SidebarMenuEntry> _visibleItems = new();

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        await RefreshMenuAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _ = InvokeAsync(async () =>
        {
            await RefreshMenuAsync();
            StateHasChanged();
        });
    }

    private async Task RefreshMenuAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        _visibleItems = SidebarMenu.All.Where(i => i.IsVisibleTo(state.User)).ToList();
    }

    private void OnMenuClick(SidebarMenuEntry item)
    {
        if (item.OpenTabKind is { } kind)
        {
            TabService.TryAddTab(kind);
        }

        Navigation.NavigateTo(item.Href);
    }

    private bool IsActive(string href)
    {
        var path = new Uri(Navigation.Uri).AbsolutePath;
        return string.Equals(path.TrimEnd('/'), href.TrimEnd('/'), StringComparison.OrdinalIgnoreCase)
               || (path == "/" && href == "/");
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private sealed record SidebarMenuEntry(
        string Title,
        string Icon,
        string Href,
        string[]? AllowedRoles,
        WorkDocumentKind? OpenTabKind)
    {
        public bool IsVisibleTo(ClaimsPrincipal user)
        {
            if (user.Identity?.IsAuthenticated != true)
            {
                return false;
            }

            if (AllowedRoles is null || AllowedRoles.Length == 0)
            {
                var at = AccountTypeHelper.GetAccountType(user);
                return at == AccountTypeHelper.TenantAdmin
                    || at == AccountTypeHelper.TenantUser
                    || string.Equals(at, "TenantAdmin", StringComparison.OrdinalIgnoreCase);
            }

            return AllowedRoles.Any(r => MatchesRequirement(user, r));
        }

        private static bool MatchesRequirement(ClaimsPrincipal user, string requirement)
        {
            if (string.Equals(requirement, AccountTypeHelper.PlatformAdmin, StringComparison.Ordinal))
            {
                return AccountTypeHelper.IsPlatformAdmin(user);
            }

            if (string.Equals(requirement, AccountTypeHelper.ResellerAdmin, StringComparison.Ordinal))
            {
                return AccountTypeHelper.IsResellerAdmin(user);
            }

            return HitPanRoleHelper.IsInHitPanRole(user, requirement);
        }
    }

    private static class SidebarMenu
    {
        public static readonly SidebarMenuEntry[] All =
        {
            new("대시보드", Icons.Material.Filled.Dashboard, "/platform/dashboard",
                new[] { AccountTypeHelper.PlatformAdmin }, null),
            new("대리점 관리", Icons.Material.Filled.Store, "/platform/resellers",
                new[] { AccountTypeHelper.PlatformAdmin }, null),
            new("고객사 관리", Icons.Material.Filled.Business, "/platform/tenants",
                new[] { AccountTypeHelper.PlatformAdmin }, null),
            new("수수료 정책", Icons.Material.Filled.Percent, "/platform/commission",
                new[] { AccountTypeHelper.PlatformAdmin }, null),
            new("프로모션", Icons.Material.Filled.Campaign, "/platform/promotions",
                new[] { AccountTypeHelper.PlatformAdmin }, null),
            new("매출 현황", Icons.Material.Filled.BarChart, "/platform/revenue",
                new[] { AccountTypeHelper.PlatformAdmin }, null),

            new("대시보드", Icons.Material.Filled.Dashboard, "/reseller/dashboard",
                new[] { AccountTypeHelper.ResellerAdmin }, null),
            new("내 고객사", Icons.Material.Filled.Business, "/reseller/customers",
                new[] { AccountTypeHelper.ResellerAdmin }, null),
            new("수수료 현황", Icons.Material.Filled.AttachMoney, "/reseller/revenue",
                new[] { AccountTypeHelper.ResellerAdmin }, null),
            new("정산 내역", Icons.Material.Filled.AccountBalance, "/reseller/payout",
                new[] { AccountTypeHelper.ResellerAdmin }, null),

            new("설정", Icons.Material.Filled.Settings, "/settings",
                new[] { "TenantAdmin", AccountTypeHelper.PlatformAdmin }, null),
            new("견적", Icons.Material.Filled.RequestQuote, "/quotes",
                new[] { "TenantAdmin", "Manager", "User", AccountTypeHelper.PlatformAdmin },
                WorkDocumentKind.SalesOrder),
            new("매입", Icons.Material.Filled.LocalShipping, "/purchase",
                new[] { "TenantAdmin", "Manager", AccountTypeHelper.PlatformAdmin },
                WorkDocumentKind.PurchaseReceipt),
            new("판매", Icons.Material.Filled.PointOfSale, "/sales",
                new[] { "TenantAdmin", "Manager", "User", AccountTypeHelper.PlatformAdmin },
                WorkDocumentKind.SalesDelivery),
            new("엑셀 역수입", Icons.Material.Filled.FileUpload, "/sales/import",
                new[] { "TenantAdmin", "Manager", "User", AccountTypeHelper.PlatformAdmin }, null),
            new("업체특별단가", Icons.Material.Filled.PriceChange, "/partners/special-prices",
                new[] { "TenantAdmin", "Manager", "User", AccountTypeHelper.PlatformAdmin }, null),
            new("재고", Icons.Material.Filled.Inventory, "/stock",
                new[] { "TenantAdmin", "Manager", "User", AccountTypeHelper.PlatformAdmin }, null),
            new("회계", Icons.Material.Filled.AccountBalance, "/accounting",
                new[] { "TenantAdmin", AccountTypeHelper.PlatformAdmin }, null)
        };
    }
}
