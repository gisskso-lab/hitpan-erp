@code {
    /// <summary>
    /// 메뉴에서도 메신저를 <b>팝업창</b>으로 연다. 작(2026-08-14).
    /// </summary>
    /// <remarks>
    /// 사장님 지적(1.2.75 실사용): <i>"사이드 메신저 대메뉴로 들어갈시 히트판 화면에서 메신저 동작"</i>
    /// <para>
    /// 종전엔 <c>Href="/chat"</c> 이라 ERP 화면 안에서 열려 <b>쓰던 화면이 날아갔다.</b>
    /// 견적서를 쓰다 물어보려고 눌렀는데 견적서가 사라지는 자리다.
    /// </para>
    /// <para>
    /// 🔴 상단바(<c>TopHeader</c>)와 <b>같은 JS 를 부른다</b> — <c>hitpanChat.open</c> 은
    /// <c>window.open(url, 'hitpanChat', ...)</c> 으로 <b>창 이름을 고정</b>해 쓰므로,
    /// 상단바로 열든 메뉴로 열든 <b>창은 하나로 재사용된다.</b>
    /// 여기서 JS 를 따로 짜 넣으면 창이 둘로 갈라진다 — 들어온 길이 달라도 결과는 같아야 한다.
    /// </para>
    /// <para>
    /// 🔴 팝업이 막히면 <c>/chat</c> 으로 보낸다 — 상단바는 막혔을 때
    /// <i>"메뉴 → 메신저 로도 열 수 있습니다"</i> 라고 안내한다.
    /// 메뉴까지 팝업으로만 열면 <b>그 안내가 거짓말이 되고 갈 곳이 없어진다.</b>
    /// 화면 안에서 열리더라도 <b>못 여는 것보다는 낫다.</b>
    /// </para>
    /// </remarks>
    private async Task OpenChatWindowAsync()
    {
        try
        {
            var opened = await JS.InvokeAsync<bool>("hitpanChat.open", "/chat-window");
            if (opened) return;

            // 팝업 차단 — 조용히 넘기면 "눌렀는데 아무 일도 안 난다" 만 겪는다.
            Snackbar.Add("브라우저가 팝업을 막아 화면 안에서 엽니다. "
                + "따로 창으로 쓰시려면 주소창 오른쪽의 팝업 차단 아이콘에서 허용해 주세요.",
                Severity.Info);
        }
        catch (Exception ex)
        {
            // 헌법 #15 — 빈 catch 금지. 여기서 터져도 메신저는 열어 준다.
            // (JS 가 아직 안 올라온 순간에 누르면 날 수 있다 — 일을 막을 이유가 아니다.)
            Console.Error.WriteLine($"[Sidebar] 메신저 창 열기 실패: {ex.GetType().Name}: {ex.Message}");
        }

        Nav.NavigateTo("/chat");
    }

    // 헌법 #35 (2026-06-04) — 본사·대리점·Owner 영역 일체 HitPan.Backoffice 신규 프로젝트로 분리 완료.
    // HitPan.Web은 고객사 ERP 전용. /admin/* /reseller/* /owner/* 페이지 0건.
    private int _approvalPendingCount;

    // ★ 사장님 오더 2026-08-04 — 사이드바 최하단 현재 버전 표기.
    //   빈 문자열이면 화면에 아무것도 안 그린다(미인증·조회 실패 시 조용히 생략).
    private string? _appVersion;

    // 🔴 2026-08-11 (사장님 지시): 설정관리·자료관리 대메뉴는 **부모계정만** 본다.
    //   *"실제 계층에 의한 접근권한은 분명히 나눠야됨. 부모계정에게만 주는 걸로."*
    //
    //   ⚠️ 메뉴를 감추는 것은 **차단이 아니다.** 주소를 직접 치면 그대로 들어간다.
    //     그래서 세 겹으로 막는다: ①여기(메뉴에서 감춤) ②각 화면(들어와도 막음)
    //     ③서버(요청 자체를 거부). 셋 중 하나라도 빠지면 막았다고 말할 수 없다.
    private bool _isTenantAdmin;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            _isTenantAdmin = AccountTypeHelper.IsTenantAdmin(auth.User);
        }
        catch (Exception ex)
        {
            // 판정에 실패하면 **안 보여준다.** 못 읽었는데 열어주면 막은 적이 없는 것과 같다.
            Console.Error.WriteLine($"[Sidebar] 계정 유형 판정 실패: {ex.GetType().Name}: {ex.Message}");
            _isTenantAdmin = false;
        }

        await LoadAppVersionAsync();

        // 결재 대기 건수 로딩
        try
        {
            var pending = await ApprovalSvc.GetPendingAsync();
            _approvalPendingCount = pending.Count;
        }
        catch (Exception _hp15Ex)
        {
            Console.Error.WriteLine($"[HP15] " + _hp15Ex.GetType().Name + ": " + _hp15Ex.Message);
            // §원칙 #15 빈 catch 금지 적용 대상 — 사이드바 카운트는 베타 단계 silent OK.
            // 본 진단 로그는 ApprovalService 내부에서 처리하므로 여기선 안전 대체값.
            _approvalPendingCount = 0;
        }
    }

    /// <summary>
    /// 현재 실행 중인 히트판 버전을 읽어 사이드바 하단에 표기한다(사장님 오더 2026-08-04).
    ///
    /// ■ 왜 기존 update-status 를 재사용하나
    ///   AuthController.ComputeUpdateStatusAsync 가 이미 CurrentVersion(=VersionInfo.Current,
    ///   실행 중 어셈블리에서 직접 읽음)을 돌려준다. 새 API 를 만들면 진실원이 둘이 되고,
    ///   업데이트 후 한쪽만 안 바뀌는 사고가 난다(과거 버전 하드코딩 8곳 사고 계통).
    ///
    /// ■ 실패는 전부 조용히 삼킨다 — 이유
    ///   사이드바는 **로그인 전에도 렌더**될 수 있고 이 API 는 인증이 필요하다(401).
    ///   버전 한 줄 때문에 사이드바나 ERP 가 막히면 본말전도다(헌법 #20).
    ///   못 읽으면 표기를 생략할 뿐, 기능에는 아무 영향이 없다.
    /// </summary>
    private async Task LoadAppVersionAsync()
    {
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            if (auth.User?.Identity?.IsAuthenticated != true) return; // 미인증 → 표기 생략

            var status = await Http.GetFromJsonAsync<AppVersionResponse>("api/auth/update-status");
            var v = status?.CurrentVersion;

            // "0.0.0" 은 VersionInfo 가 어셈블리 버전을 못 읽었을 때의 값이다(VersionInfo.cs:41).
            //   그걸 고객에게 보여주면 오히려 혼란이므로 표기하지 않는다.
            if (!string.IsNullOrWhiteSpace(v) && v != "0.0.0")
                _appVersion = v;
        }
        catch (Exception _hp15Ex)
        {
            // §원칙 #15 빈 catch 금지 — 흔적은 남기되 화면은 막지 않는다.
            Console.Error.WriteLine("[HP15][Sidebar/Version] " + _hp15Ex.GetType().Name + ": " + _hp15Ex.Message);
        }
    }

    private sealed class AppVersionResponse
    {
        public string? CurrentVersion { get; set; }
    }
}
