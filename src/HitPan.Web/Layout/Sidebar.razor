@using HitPan.Web.Helpers
@inject AuthenticationStateProvider AuthStateProvider

<MudNavMenu>
    <MudNavLink Href="/dashboard" Icon="@Icons.Material.Filled.Dashboard">
        대시보드
    </MudNavLink>

    <MudNavGroup Title="설정" Icon="@Icons.Material.Filled.Settings" Expanded="false">
        <MudNavLink Href="/company" Icon="@Icons.Material.Filled.Business">사용자정보 설정</MudNavLink>
        <MudNavLink Href="/users/permissions" Icon="@Icons.Material.Filled.Lock">권한 설정</MudNavLink>
        <MudNavLink Href="/employees" Icon="@Icons.Material.Filled.People">사원관리</MudNavLink>
        <MudNavLink Href="/settings" Icon="@Icons.Material.Filled.Tune">사용환경 설정</MudNavLink>
        <MudNavLink Href="/print-settings" Icon="@Icons.Material.Filled.Print">양식(인쇄)정보 설정</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="업체 관리" Icon="@Icons.Material.Filled.Business" Expanded="false">
        <MudNavLink Href="/partners" Icon="@Icons.Material.Filled.People">업체 마스터</MudNavLink>
        <MudNavLink Href="/partners/special-prices" Icon="@Icons.Material.Filled.LocalOffer">업체 특별단가</MudNavLink>
        <MudNavLink Href="/partners/ledger" Icon="@Icons.Material.Filled.Book">업체별 원장</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="상품 관리" Icon="@Icons.Material.Filled.Inventory" Expanded="false">
        <MudNavLink Href="/items" Icon="@Icons.Material.Filled.Category">상품 마스터</MudNavLink>
        <MudNavLink Href="/bom" Icon="@Icons.Material.Filled.AccountTree">BOM 자재명세서</MudNavLink>
        <MudNavLink Href="/items/special-prices" Icon="@Icons.Material.Filled.LocalOffer">상품 특별단가</MudNavLink>
        <MudNavLink Href="/items/ledger" Icon="@Icons.Material.Filled.Book">상품별 원장</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="판매" Icon="@Icons.Material.Filled.PointOfSale" Expanded="false">
        <MudNavLink Href="/quotations" Icon="@Icons.Material.Filled.RequestQuote">견적서</MudNavLink>
        <MudNavLink Href="/sales-orders" Icon="@Icons.Material.Filled.Assignment">수주서</MudNavLink>
        <MudNavLink Href="/deliveries" Icon="@Icons.Material.Filled.Receipt">거래명세서</MudNavLink>
        <MudNavLink Href="/sales/summary" Icon="@Icons.Material.Filled.BarChart">판매 현황</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="매입" Icon="@Icons.Material.Filled.ShoppingCart" Expanded="false">
        <MudNavLink Href="/purchase-orders" Icon="@Icons.Material.Filled.AddShoppingCart">발주서</MudNavLink>
        <MudNavLink Href="/purchases" Icon="@Icons.Material.Filled.MoveToInbox">매입 처리</MudNavLink>
        <MudNavLink Href="/returns" Icon="@Icons.Material.Filled.AssignmentReturn">반품 처리</MudNavLink>
        <MudNavLink Href="/purchases/summary" Icon="@Icons.Material.Filled.BarChart">매입 현황</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="재고" Icon="@Icons.Material.Filled.Warehouse" Expanded="false">
        <MudNavLink Href="/stock" Icon="@Icons.Material.Filled.Inventory2">재고 현황</MudNavLink>
        <MudNavLink Href="/stock/ledger" Icon="@Icons.Material.Filled.ListAlt">각종 수불부</MudNavLink>
        <MudNavLink Href="/stock/adjust" Icon="@Icons.Material.Filled.Tune">재고 실사·조정</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="수금·지급" Icon="@Icons.Material.Filled.AccountBalance" Expanded="false">
        <MudNavLink Href="/collections" Icon="@Icons.Material.Filled.AttachMoney">수금</MudNavLink>
        <MudNavLink Href="/payments" Icon="@Icons.Material.Filled.Money">지급</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="회계" Icon="@Icons.Material.Filled.Calculate" Expanded="false">
        <MudNavLink Href="/accounting/accounts" Icon="@Icons.Material.Filled.AccountTree">계정과목</MudNavLink>
        <MudNavLink Href="/accounting/expenses" Icon="@Icons.Material.Filled.Receipt">경비 처리</MudNavLink>
        <MudNavLink Href="/accounting/profit" Icon="@Icons.Material.Filled.TrendingUp">손익 현황</MudNavLink>
    </MudNavGroup>

    @if (IsPlatformAdmin)
    {
        <MudNavGroup Title="본사 관리" Icon="@Icons.Material.Filled.CorporateFare" Expanded="true">
            <MudNavLink Href="/admin/dashboard" Icon="@Icons.Material.Filled.Dashboard">본사 대시보드</MudNavLink>
            <MudNavLink Href="/admin/resellers" Icon="@Icons.Material.Filled.Store">대리점 관리</MudNavLink>
            <MudNavLink Href="/admin/tenants" Icon="@Icons.Material.Filled.Business">고객사 관리</MudNavLink>
            <MudNavLink Href="/admin/commission" Icon="@Icons.Material.Filled.Percent">수수료 정책</MudNavLink>
        </MudNavGroup>
    }

    @if (IsReseller)
    {
        <MudNavGroup Title="대리점 관리" Icon="@Icons.Material.Filled.Store" Expanded="true">
            <MudNavLink Href="/reseller/dashboard" Icon="@Icons.Material.Filled.Dashboard">대리점 대시보드</MudNavLink>
            <MudNavLink Href="/reseller/tenants" Icon="@Icons.Material.Filled.Business">고객사 관리</MudNavLink>
            <MudNavLink Href="/reseller/commission" Icon="@Icons.Material.Filled.Percent">수수료 현황</MudNavLink>
            <MudNavLink Href="/reseller/settlement" Icon="@Icons.Material.Filled.AccountBalance">정산 내역</MudNavLink>
        </MudNavGroup>
    }
</MudNavMenu>

@code {
    private string AccountType { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        AccountType = AccountTypeHelper.GetAccountType(state.User);
    }

    private bool IsPlatformAdmin =>
        AccountType == "platform_admin";

    private bool IsReseller =>
        AccountType == "reseller" ||
        AccountType == "reseller_admin";
}
