@using HitPan.Web.Services
@implements IDisposable
@inject ChatService Chat
@inject NotificationClient Notify

@* ═══════════════════════════════════════════════════════════════
   상단바 메신저 버튼 + 안 읽은 수 배지. 작(2026-08-13).

   🔴 사장님 지시 (2026-08-13):
     "메신저 알림아이콘 옆 메신저 버튼 생성.
      메뉴에 기능이 있어야 하는건 맞지만, **메뉴에서만 찾는건 비효율적**."

   ⇒ 알림 종(🔔) 바로 옆에 둔다. 누르면 오른쪽 아래 채팅창이 뜬다.

   🔴 아이콘을 셋으로 가른다 — 헷갈리면 사고가 난다:
     · 왼쪽 로봇   = AI 챗봇   → 대화가 **외부**(클로드·챗GPT)로 나간다
     · 오른쪽 종   = 알림      → 회사 안. 읽으면 사라진다
     · 오른쪽 말풍선 = 메신저   → 회사 안. **기록으로 남는다**
   ═══════════════════════════════════════════════════════════════ *@

<MudBadge Content="@_unread" Color="Color.Error" Overlap="true"
          Visible="@(_unread > 0)" Bordered="true">
    <MudTooltip Text="메신저 (새 창)">
        <MudIconButton Icon="@Icons.Material.Outlined.ChatBubbleOutline"
                       Color="Color.Default" Size="Size.Medium"
                       OnClick="RequestOpen" aria-label="메신저" />
    </MudTooltip>
</MudBadge>

@code {
    /// <summary>
    /// 버튼을 누르면 알린다. 작(2026-08-14) — 창을 <b>누가</b> 띄울지는 상단바가 정한다.
    /// </summary>
    /// <remarks>
    /// 종전엔 <c>Open</c> 참/거짓으로 화면 안 채팅창을 켜고 껐다. 이제 진짜 브라우저 창이라
    /// 여기서는 <b>"눌렸다"만</b> 알리고, 창을 띄우는 일(JS)은 상단바가 맡는다.
    /// </remarks>
    [Parameter] public EventCallback OnOpenRequested { get; set; }

    private int _unread;
    private bool _subscribed;

    protected override async Task OnInitializedAsync()
    {
        // 🔴 새 메시지가 오면 배지를 다시 센다 — 기존 알림 배관을 그대로 쓴다(새 Hub 없음).
        Notify.OnNotification += OnNotified;
        _subscribed = true;

        await RefreshAsync();
    }

    /// <summary>
    /// 새 알림이 오면 배지를 다시 센다.
    /// </summary>
    /// <remarks>
    /// 🔴 <b><c>async void</c> 를 쓰지 않는다</b> — 작(2026-08-14, 1.2.75 실사용 P0).
    /// <para>
    /// 사장님 지적: <i>"메신저 팝업 띄우면 브라우져화면아래 흰줄 새로고침 오류뜸"</i>
    /// </para>
    /// <para>
    /// 종전엔 <c>async void</c> 였다. 거기서 난 예외는 <b>아무도 못 잡는다</b> —
    /// Blazor 가 마지막에 받아 <c>index.html</c> 의 <c>blazor-error-ui</c>(화면 아래 흰 띠)를
    /// 띄운다. 여기서 부르는 <see cref="RefreshAsync"/> 는 서버에 안 읽은 수를 물어보므로
    /// 통신이 끊기거나 서버가 막으면(403) 예외가 난다 — <b>흔한 일이지 드문 일이 아니다.</b>
    /// </para>
    /// <para>
    /// ⚠️ 같은 사고를 <c>ChatPage.razor</c> 에서 이미 한 번 겪고 고쳤는데
    /// <b>여기는 같이 안 고쳤다.</b> 한 군데만 고치면 남은 자리에서 그대로 재발한다.
    /// </para>
    /// <para>
    /// 배지를 못 세는 것은 <b>일을 막지 않는다</b> — 숫자가 잠깐 안 맞을 뿐이다.
    /// 그것 때문에 화면 전체에 오류 띠를 띄우지 않는다.
    /// </para>
    /// </remarks>
    private void OnNotified(Models.AppNotificationModel notification)
    {
        if (notification.Type is not ("chat_message" or "chat_approval")) return;

        _ = InvokeAsync(async () =>
        {
            try
            {
                await RefreshAsync();
            }
            catch (Exception ex)
            {
                // 헌법 #15 — 빈 catch 금지. 배지만 못 세고 화면은 살려 둔다.
                Console.Error.WriteLine($"[ChatButton] 안 읽은 수 갱신 실패: {ex.GetType().Name}: {ex.Message}");
            }
        });
    }

    /// <summary>
    /// 안 읽은 수를 다시 센다. 팝업이 읽음 처리를 하면 이걸 불러 배지를 줄인다.
    /// </summary>
    public async Task RefreshAsync()
    {
        try
        {
            _unread = await Chat.GetUnreadCountAsync();
        }
        catch (Exception ex)
        {
            // 🔴 작(2026-08-14): 여기서 터지면 부르는 쪽(상단바)까지 함께 죽어 흰 띠가 뜬다.
            //   못 세면 종전 숫자를 그대로 둔다 — 0 으로 되돌리면 "읽었다"는 거짓말이 된다.
            Console.Error.WriteLine($"[ChatButton] 안 읽은 수 조회 실패: {ex.GetType().Name}: {ex.Message}");
        }

        StateHasChanged();
    }

    private async Task RequestOpen() => await OnOpenRequested.InvokeAsync();

    public void Dispose()
    {
        if (_subscribed) Notify.OnNotification -= OnNotified;
    }
}
