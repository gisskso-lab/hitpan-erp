@inherits LayoutComponentBase

@*
    백오피스 v2 워크스페이스 셸 (사장님 결재 2026-06-01)
    - 좌측 사이드바 240px + 상단 헤더 56px + 본문 max-width 1440px
    - 헌법 #1 정합: 기존 BackofficeSidebar 보존, 골격만 갱신
    - CSS: wwwroot/css/backoffice-v2.css 강제 로드
*@

<link rel="stylesheet" href="css/backoffice-v2.css?v=20260601" />

<div class="bo2-shell">
    <aside class="bo2-sidebar @(_sidebarOpen ? "open" : "")">
        <BackofficeSidebar />
    </aside>

    @if (_sidebarOpen)
    {
        <div class="bo2-scrim" @onclick="CloseSidebar"></div>
    }

    <div class="bo2-main">
        <PlatformTopBar OnToggleSidebar="ToggleSidebar" />
        <main class="bo2-content">
            <div class="bo2-content-inner">
                @Body
            </div>
        </main>
    </div>
</div>

@code {
    private bool _sidebarOpen = false;

    private void ToggleSidebar() => _sidebarOpen = !_sidebarOpen;
    private void CloseSidebar() => _sidebarOpen = false;
}
