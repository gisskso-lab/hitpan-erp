@inherits LayoutComponentBase
@using HitPan.Web.Services
@inject NavigationManager Nav
@inject IAuthService AuthService

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Dark" Style="background:#1E3A5F">
        <MudText Typo="Typo.h6" Style="color:white;font-size:15px">
            히트판 본사 관리
        </MudText>
        <MudSpacer />
        <MudText Style="color:#9CA3AF;font-size:12px">
            platform_admin
        </MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Logout"
                       Color="Color.Inherit"
                       OnClick="Logout" />
    </MudAppBar>
    <MudDrawer Open="true" Elevation="1" Variant="DrawerVariant.Persistent">
        <MudNavMenu>
            <MudText Typo="Typo.caption" Class="px-4 py-2" Style="color:#6B7280">본사 관리</MudText>
            <MudNavLink Href="/platform/dashboard" Icon="@Icons.Material.Filled.Dashboard">
                대시보드
            </MudNavLink>
            <MudNavLink Href="/platform/resellers" Icon="@Icons.Material.Filled.Store">
                대리점 관리
            </MudNavLink>
            <MudNavLink Href="/platform/tenants" Icon="@Icons.Material.Filled.Business">
                고객사 관리
            </MudNavLink>
            <MudNavLink Href="/platform/commission" Icon="@Icons.Material.Filled.Percent">
                수수료 정책
            </MudNavLink>
            <MudNavLink Href="/platform/promotions" Icon="@Icons.Material.Filled.Campaign">
                프로모션 관리
            </MudNavLink>
            <MudNavLink Href="/platform/revenue" Icon="@Icons.Material.Filled.BarChart">
                매출 현황
            </MudNavLink>

            <MudDivider Class="my-3" />
            <MudText Typo="Typo.caption" Class="px-4 py-2" Style="color:#6B7280">
                ERP 업무
            </MudText>
            <MudNavLink Href="/settings" Icon="@Icons.Material.Filled.Settings" Match="NavLinkMatch.Prefix">
                설정
            </MudNavLink>
            <MudNavLink Href="/quotes" Icon="@Icons.Material.Filled.RequestQuote" Match="NavLinkMatch.Prefix">
                견적
            </MudNavLink>
            <MudNavLink Href="/purchase" Icon="@Icons.Material.Filled.LocalShipping" Match="NavLinkMatch.Prefix">
                매입
            </MudNavLink>
            <MudNavLink Href="/sales" Icon="@Icons.Material.Filled.PointOfSale" Match="NavLinkMatch.Prefix">
                판매
            </MudNavLink>
            <MudNavLink Href="/sales/import" Icon="@Icons.Material.Filled.FileUpload" Match="NavLinkMatch.All">
                엑셀 역수입
            </MudNavLink>
            <MudNavLink Href="/partners/special-prices" Icon="@Icons.Material.Filled.PriceChange" Match="NavLinkMatch.Prefix">
                업체특별단가
            </MudNavLink>
            <MudNavLink Href="/stock" Icon="@Icons.Material.Filled.Inventory" Match="NavLinkMatch.Prefix">
                재고
            </MudNavLink>
            <MudNavLink Href="/accounting" Icon="@Icons.Material.Filled.AccountBalance" Match="NavLinkMatch.Prefix">
                회계
            </MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/login");
    }
}
