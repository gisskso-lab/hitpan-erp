@page "/recover"
@page "/landing/recovery"
@rendermode InteractiveServer
@layout LandingLayout
@inject NavigationManager Nav
@using HitPan.Landing.Components.Pages.Landing.Components

@*
  RecoveryPage — 계정 분실/문의 복구 (WS-20260601-12, 2026-06-01 박제)
  - 이메일 또는 휴대폰 입력 + 사업자등록증 재업로드 (BizLicenseUploader)
  - 신규 이메일·휴대폰 (변경 시) 옵션
  실제 복구 API는 후속 작지에서. 본 페이지는 UI + 클라이언트 유효성까지.
*@

<PageTitle>계정 분실 · 문의 — 히트판 ERP</PageTitle>

<section class="recover-section">
    <div class="recover-card">
        <h1>계정 분실 · 문의</h1>
        <p class="lead">
            이메일·휴대폰을 잊으셨나요? 사업자등록증으로 안전하게 복구해 드립니다.
            본사는 사장님 업무 데이터를 보지 않습니다(헌법 #22).
        </p>

        @if (_submitted)
        {
            <div class="recover-done">
                <div class="recover-done-icon">✓</div>
                <h2>복구 요청이 접수되었습니다</h2>
                <p>본사가 사업자등록증을 대조하여 24시간 이내 안내드립니다.</p>
                <p class="recover-done-hint">긴급한 경우 partners@hitpan.kr 로 문의해주세요.</p>
                <a href="/landing" class="recover-done-back">랜딩으로 돌아가기</a>
            </div>
        }
        else
        {
        <EditForm Model="_form" OnValidSubmit="HandleSubmit">
            <div class="field-group">
                <h2 class="group-title">1. 현재 계정 정보</h2>
                <div class="field">
                    <label>가입 시 이메일 또는 휴대폰 (둘 중 하나)</label>
                    <input type="text" @bind="_form.IdentifierCurrent"
                           placeholder="example@company.com 또는 010-0000-0000" />
                </div>
                <div class="field">
                    <label>회사명 또는 사업자등록번호</label>
                    <input type="text" @bind="_form.CompanyHint"
                           placeholder="(주)히트판 또는 123-45-67890" />
                </div>
            </div>

            <div class="field-group">
                <h2 class="group-title">2. 사업자등록증 재업로드</h2>
                <p class="hint">본인 확인용. 가입 시 제출본과 자동 대조됩니다.</p>
                <BizLicenseUploader OnUploaded="OnBizUploaded" />
            </div>

            <div class="field-group">
                <h2 class="group-title">3. 변경 정보 (선택)</h2>
                <p class="hint">이메일·휴대폰을 새 것으로 바꾸시려면 입력하세요. 비워두면 기존 계정 그대로 안내드립니다.</p>
                <div class="field">
                    <label>새 이메일 (선택)</label>
                    <input type="email" @bind="_form.NewEmail" placeholder="new@company.com" />
                </div>
                <div class="field">
                    <label>새 휴대폰 (선택)</label>
                    <input type="tel" @bind="_form.NewPhone" placeholder="010-0000-0000" />
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="error">@_error</div>
            }

            <button type="submit" class="btn-submit" disabled="@_submitting">
                @(_submitting ? "처리 중..." : "복구 요청 보내기")
            </button>
        </EditForm>

        <p class="back-link">계정이 기억나셨나요? <a href="/login">로그인</a> · <a href="/landing">랜딩으로</a></p>
        }
    </div>
</section>

@code {
    private RecoveryForm _form = new();
    private bool _submitting;
    private bool _submitted;
    private string? _error;
    private bool _bizUploaded;

    private void OnBizUploaded(BizLicenseUploader.UploadResult result)
    {
        _bizUploaded = true;
    }

    private async Task HandleSubmit()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_form.IdentifierCurrent))
        {
            _error = "가입 시 이메일 또는 휴대폰을 입력해주세요.";
            return;
        }
        if (!_bizUploaded)
        {
            _error = "사업자등록증을 업로드해주세요.";
            return;
        }

        _submitting = true;
        // 헌법 #20 (사장님 결재 2026-06-04) — /recover/submitted 라우트 미박제 = 404 폭발 진범
        // 봉합: 같은 페이지 안에서 _submitted 상태 토글로 안내 화면 전환
        await Task.Delay(800); // 실제 API 호출은 후속 작지에서 박제
        _submitted = true;
        _submitting = false;
    }

    private class RecoveryForm
    {
        public string IdentifierCurrent { get; set; } = "";
        public string CompanyHint { get; set; } = "";
        public string NewEmail { get; set; } = "";
        public string NewPhone { get; set; } = "";
    }
}

<style>
.recover-section { padding: 48px 0; background: #F9FAFB; min-height: calc(100vh - 200px); }
.recover-card { max-width: 560px; margin: 0 auto; background: #fff; padding: 40px; border-radius: 16px; box-shadow: 0 4px 16px rgba(0,0,0,0.06); }
.recover-card h1 { font-size: 28px; margin-bottom: 8px; color: #0F1419; }
.lead { color: #6B7280; margin-bottom: 24px; font-size: 14px; line-height: 1.6; }
.field-group { margin-bottom: 24px; padding-bottom: 16px; border-bottom: 1px solid #F3F4F6; }
.field-group:last-of-type { border-bottom: none; }
.group-title { font-size: 16px; font-weight: 700; color: #0F1419; margin: 0 0 8px; }
.hint { font-size: 13px; color: #6B7280; margin: 0 0 12px; line-height: 1.5; }
.field { margin-bottom: 12px; }
.field label { display: block; font-weight: 600; margin-bottom: 6px; font-size: 13px; color: #4B5563; }
.field input { width: 100%; padding: 12px; border: 1px solid #D1D5DB; border-radius: 8px; font-size: 14px; box-sizing: border-box; }
.field input:focus { outline: none; border-color: #0F6E56; }
.error { background: #FEE2E2; color: #B91C1C; padding: 12px; border-radius: 8px; margin-bottom: 12px; font-size: 14px; }
.btn-submit { width: 100%; padding: 14px; background: #FF6B35; color: #fff; border: none; border-radius: 8px; font-size: 16px; font-weight: 700; cursor: pointer; }
.btn-submit:hover:not(:disabled) { background: #E55A2A; }
.btn-submit:disabled { opacity: 0.6; cursor: not-allowed; }
.back-link { text-align: center; margin-top: 16px; font-size: 14px; color: #6B7280; }
.back-link a { color: #0F6E56; font-weight: 600; text-decoration: none; }
.recover-done { text-align: center; padding: 24px 0; }
.recover-done-icon { font-size: 48px; color: #0F6E56; margin-bottom: 12px; }
.recover-done h2 { font-size: 22px; color: #0F1419; margin: 0 0 12px; }
.recover-done p { color: #4B5563; font-size: 14px; margin: 8px 0; }
.recover-done-hint { color: #6B7280; font-size: 13px; }
.recover-done-back { display: inline-block; margin-top: 20px; padding: 10px 20px; background: #0F6E56; color: #fff; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 14px; }
</style>
