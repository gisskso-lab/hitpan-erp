@*
    PricingSection — 3티어 (Basic 29k / Pro 59k / Enterprise 100k)
    project_pricing.md 박제 가격 (사장님 결재)
*@

<section class="lv2-section lv2-pricing" id="pricing">
    <div class="lv2-container">
        <div class="lv2-section-head">
            <span class="lv2-eyebrow">PRICING</span>
            <h2 class="lv2-section-title">사업 규모에 딱 맞는 요금제</h2>
            <p class="lv2-section-sub">
                3가지 티어 중 선택. 베타 기간 동안 전 티어 무료 체험.
            </p>
        </div>

        <div class="lv2-pricing-addon">
            <span class="lv2-pricing-addon-label">옵션</span>
            <span class="lv2-pricing-addon-text">기기 추가 — <b>PC + 모바일 1+1 세트 월 10,000원</b> (전 티어 공통)</span>
        </div>

        <div class="lv2-pricing-grid">
            <PricingCard Name="BASIC"
                         Price="₩29,000"
                         Desc="5인 이하 중소기업 사업장의 시작용"
                         Features="@_basic"
                         CtaText="Basic 시작하기"
                         Href="/signup?plan=basic" />

            <PricingCard Name="PRO"
                         Price="₩49,000"
                         Desc="성장하는 중소기업의 표준"
                         Featured="true"
                         Features="@_pro"
                         CtaText="Pro 시작하기"
                         Href="/signup?plan=pro" />

            <PricingCard Name="ENTERPRISE"
                         Price="₩100,000"
                         PriceNote="+ 서버 구축비용 (상담)"
                         Desc="다지점 통합운영·대량 데이터"
                         Features="@_enterprise"
                         CtaText="상담 신청"
                         Href="/signup?plan=enterprise" />
        </div>
    </div>
</section>

@code {
    private readonly string[] _basic = new[]
    {
        "사용자 5명",
        "기기 5대 (모바일 포함)",
        "매입·판매·재고 기본",
        "전자세금계산서 발행 월 50건",
        "BOM 생산관리",
        "전자세금계산서 연동",
        "AI CS 챗봇"
    };

    private readonly string[] _pro = new[]
    {
        "사용자 10명",
        "기기 15대 (모바일 포함)",
        "매입·판매·재고 기본",
        "전자세금계산서 발행 월 50건",
        "BOM 생산관리",
        "전자세금계산서 연동",
        "AI CS 챗봇",
        "전화 CS·원격지원 응대"
    };

    private readonly string[] _enterprise = new[]
    {
        "사용자 무제한",
        "기기 무제한",
        "매입·판매·재고 기본",
        "전자세금계산서 발행 월 50건",
        "BOM 생산관리",
        "전자세금계산서 연동",
