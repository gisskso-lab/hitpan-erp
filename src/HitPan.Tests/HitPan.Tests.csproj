<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HitPan.Application\HitPan.Application.csproj" />
    <ProjectReference Include="..\HitPan.Infrastructure\HitPan.Infrastructure.csproj" />
    <!-- 🔴 20260816작1 (G-19~G-22) — 회사 생성 시드를 **실제로 불러** 검사하기 위해 참조한다.
         R-1 은 "글자는 맞는데 신규 고객에게 안 간다" 는 결함이었고, 게이트 13/13 이
         전부 통과하고도 살아남았다. 소스 글자를 읽는 시험으로는 절대 못 잡는다.
         ⇒ 시험이 CompanyBootstrapProvisioner 를 직접 불러 **표에 행이 생기는지 눈으로 본다.** -->
    <ProjectReference Include="..\HitPan.API\HitPan.API.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 🔴 20260827작8 G4 — ApiErrorText 를 **실제로 불러** 판정하기 위해 링크한다.
         HitPan.Web 은 BlazorWebAssembly SDK 라 시험 프로젝트가 통째로 참조하면
         WASM 자산까지 딸려 온다. 이 파일은 Blazor 의존이 없는 순수 C# 이므로
         소스만 링크한다.
         ⚠️ 이렇게 하는 이유: 1.3.28 반려는 "글자는 맞는데 화면에 안 갔다" 였다.
            글자검사만으로는 또 놓친다 — **불러서 결과를 본다.** -->
    <Compile Include="..\HitPan.Web\Services\ApiErrorText.cs" Link="Linked\ApiErrorText.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
