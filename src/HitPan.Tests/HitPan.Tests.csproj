<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HitPan.Application\HitPan.Application.csproj" />
    <ProjectReference Include="..\HitPan.Infrastructure\HitPan.Infrastructure.csproj" />
    <!-- 🔴 20260816작1 (G-19~G-22) — 회사 생성 시드를 **실제로 불러** 검사하기 위해 참조한다.
         R-1 은 "글자는 맞는데 신규 고객에게 안 간다" 는 결함이었고, 게이트 13/13 이
         전부 통과하고도 살아남았다. 소스 글자를 읽는 시험으로는 절대 못 잡는다.
         ⇒ 시험이 CompanyBootstrapProvisioner 를 직접 불러 **표에 행이 생기는지 눈으로 본다.** -->
    <ProjectReference Include="..\HitPan.API\HitPan.API.csproj" />
    <!-- 🔴 20261006작8 갈래 가 (Z2) — BoSignupTenantKeyGate 가 백오피스 실물
         (SchemaMigrator·SignupsAdminController·InstallerBootstrapController)을 직접 불러
         동명 회사 격리·backfill 검산을 동작으로 잰다. SQL 복사본 판정 금지(작14 F-2 재발 방지). -->
    <ProjectReference Include="..\HitPan.Backoffice.API\HitPan.Backoffice.API.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 🔴 20260827작8 G4 — ApiErrorText 를 **실제로 불러** 판정하기 위해 링크한다.
         HitPan.Web 은 BlazorWebAssembly SDK 라 시험 프로젝트가 통째로 참조하면
         WASM 자산까지 딸려 온다. 이 파일은 Blazor 의존이 없는 순수 C# 이므로
         소스만 링크한다.
         ⚠️ 이렇게 하는 이유: 1.3.28 반려는 "글자는 맞는데 화면에 안 갔다" 였다.
            글자검사만으로는 또 놓친다 — **불러서 결과를 본다.** -->
    <Compile Include="..\HitPan.Web\Services\ApiErrorText.cs" Link="Linked\ApiErrorText.cs" />

    <!-- 🔴 20260924작1 절E (G-26 · G-27 · G-32) — 같은 이유로 **소스를 링크**한다.
         두 파일은 일부러 Blazor 를 안 쓴다(그 파일 머리에 적어 뒀다) — 게이트가
         **진짜 요청·헤더·횟수**를 세어 보게 하려는 것이다. 글자검사가 아니다. -->
    <Compile Include="..\HitPan.Web\Services\MainPcRetryCoordinator.cs"
             Link="Linked\MainPcRetryCoordinator.cs" />
    <Compile Include="..\HitPan.Web\Services\MainPcAccessState.cs"
             Link="Linked\MainPcAccessState.cs" />

    <!-- 🔴 20260928작2 절O (W-1) — 갱신 판정표 RefreshGate.Decide 를 **실제로 불러** 잰다.
         Blazor 의존 없는 순수 C# 이다(그 파일 머리에 적어 뒀다). 글자검사가 아니다. -->
    <Compile Include="..\HitPan.Web\Services\RefreshGate.cs"
             Link="Linked\RefreshGate.cs" />

    <!-- 🔴 20260928작2 절V (W-4) — 로그아웃 완료 판정 LogoutGate.IsServerLogoutDone 을 실제로 불러 잰다(순수 C#). -->
    <Compile Include="..\HitPan.Web\Services\LogoutGate.cs"
             Link="Linked\LogoutGate.cs" />

    <!-- 🔴 20260929작3 갈래 F (G-F1 · G-F3) — 업데이트 안내 판정표·방아쇠·메인PC 왕복 단일 비행을 **실제로 불러** 잰다.
         UpdatePromptPlan·UpdatePromptBus 는 Blazor 비의존 순수 C#. MainPcProofRunner 는 HttpClient·IJSRuntime 만 쓴다
         (IJSRuntime 은 API 가 끌어오는 공유 프레임워크에 있다) — 대역 두 개로 실제 요청 수를 센다. 글자검사가 아니다. -->
    <Compile Include="..\HitPan.Web\Services\UpdatePromptPlan.cs"
             Link="Linked\UpdatePromptPlan.cs" />
    <Compile Include="..\HitPan.Web\Services\UpdatePromptBus.cs"
             Link="Linked\UpdatePromptBus.cs" />
    <Compile Include="..\HitPan.Web\Services\MainPcProofRunner.cs"
             Link="Linked\MainPcProofRunner.cs" />

    <!-- 🔴 20260930작1 갈래 F — 수동 업데이트·되돌리기 화면의 사유 코드 → 고객 문구 표와 두 클라이언트를 **실제로 불러** 잰다.
         셋 다 Blazor 비의존 순수 C#(HttpClient·ILogger 만). 대역 핸들러로 실제 요청 주소·횟수를 센다. -->
    <Compile Include="..\HitPan.Web\Services\LocalSwapUiText.cs"
             Link="Linked\LocalSwapUiText.cs" />
    <Compile Include="..\HitPan.Web\Services\LocalRollbackClient.cs"
             Link="Linked\LocalRollbackClient.cs" />
    <Compile Include="..\HitPan.Web\Services\ManualUpdateClient.cs"
             Link="Linked\ManualUpdateClient.cs" />
    <!-- 🔴 20261005작2 — 되돌리기 [예] 뒤 감시 판정·루프(순수 C#) — 가짜 시계·응답으로 실제 루프를 돌린다(G-W1~W9). -->
    <Compile Include="..\HitPan.Web\Services\RollbackWatch.cs"
             Link="Linked\RollbackWatch.cs" />

    <!-- 🔴 20261006작8 갈래 다(Z5) G-3 — 웹훅 송신 payload 에 ExtraAccounts 가 **실제로 실리는지** 재려고
         백오피스 송신 서비스와 스키마 적용기를 소스로 링크한다(같은 이유 — 글자검사가 아니라 불러서 본다).
         둘 다 Blazor·ASP.NET 파이프라인 비의존(Dapper·MySqlConnector·IConfiguration·ILogger 만).
         HitPan.Backoffice.API 는 Web SDK 라 통째 참조하지 않는다(ApiErrorText 선례).
         ⚠️ 두 파일은 Web SDK 암시 using 에 기대므로 아래 Using 2줄이 필요하다. -->
    <Compile Include="..\HitPan.Backoffice.API\Services\WebhookOutboundService.cs"
             Link="Linked\WebhookOutboundService.cs" />
    <Compile Include="..\HitPan.Backoffice.API\Services\SchemaMigrator.cs"
             Link="Linked\SchemaMigrator.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- 20261006작8 Z5 — 위 백오피스 소스 링크용(Web SDK 암시 using 대체). 기존 파일의 명시 using 과 중복돼도 경고 없음. -->
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>
