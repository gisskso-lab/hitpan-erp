<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\HitPan.Domain\HitPan.Domain.csproj" />
    <ProjectReference Include="..\HitPan.Contracts\HitPan.Contracts.csproj" />
    <!-- 축 6-4 (2026-05-14): 헌법 #15·#16 자동 검출 Roslyn Analyzer. -->
    <ProjectReference Include="..\HitPan.Analyzers\HitPan.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.1.0" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Dapper" Version="2.1.72" />
    <!-- 🔴 20261030작 MySqlConnector 판올림 (PM 브라운킴 결재 · 2026-10-30) — NU1902 GHSA-473q-m89c-ghf8 봉합.
         종전 줄은 지우지 않는다(#1):
         <PackageReference Include="MySqlConnector" Version="2.5.0" />
         🔴 이 판은 8곳(src 5 · tools 3)이 같아야 한다 — 한 곳만 올리면 판이 갈린다(판 내림 NU1605).
            src: API · Application · Backoffice.API · Infrastructure · IntegrationTests
            tools: MdbMigrationBaselineRun · MigrationIdempotencyCheck · MigrationSmokeTest
         정확한 판 하나로 적는다(범위식 금지). 근거 docs/운영기록/20261030작_MySqlConnector판올림_작업지시서.md -->
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="System.Data.OleDb" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="QuestPDF" Version="2026.2.4" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="[8.0.0,9.0.0)" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="[8.0.0,9.0.0)" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- 🔴 20261014 메모 (사장님 지시 「코드주석·md 에 메모 해둘것」) — NU1903 권고 꾸러미.
         🔴 같은 선언이 `src/HitPan.API/HitPan.API.csproj` 에도 **같은 판으로** 있다 ⇒ 올릴 때 **두 군데를 함께**.
         🔴 이 권고가 CI `Build (errors 0 + warnings 0)` 잡을 **빨강**으로 만든다(`TreatWarningsAsErrors`).
            **간헐적**이고(같은 나무가 통과→실패→통과) **왜 간헐인지는 미측정**이다.
            🔴 게시된 1.3.59 커밋(`main` = `e729217a`)도 이 자리에서 빨강이다 — 특정 갈래의 문제가 아니다.
         🚫 판 올리기는 **작8(꾸러미 보안 갱신) + 사장님 결재**. 상세는 API 쪽 주석과
            docs/운영기록/20261014인계4_작9_결재거리2건_PR550_인수인계서.md §6. -->
    <!-- 🔴 20261018작8 (사장님 결재 18 · 2026-10-18) — NU1903 봉합. 종전 줄은 지우지 않는다(#1):
         <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
         🔴 이 선언은 HitPan.API.csproj 와 HitPan.Application.csproj 두 곳에 있고 같은 판이어야 한다
            (한쪽만 올리면 판이 갈려 조용히 낮은 판이 복원된다 — 종전 주석의 경고 그대로다). -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      §#19 errors 0 + warnings 0 준수.
      MailKit 4.14.0 / MimeKit 4.14.0 의 NU1902 advisories (GHSA-9j88-vvj5-vhgr / GHSA-g7hc-96xr-gvvx)
      는 DKIM canonicalization (수신 검증) 관련. 우리는 SMTP 발송만 사용 → 실질적 영향 없음.
      신규 패치 버전이 publish 되면 즉시 업그레이드.
    -->
    <!-- ⬛ 20261030작 MySqlConnector 판올림 (PM 브라운킴 결재 · 2026-10-30) — 위 NU1902 억제를 거둔다.
         종전 줄은 지우지 않는다(#1):
         <NoWarn>$(NoWarn);NU1902</NoWarn>
         사유(MailKit 4.14 권고) 소멸 — 지금 MailKit 4.16.0 · 취약 조회(vulnerable) 0.
         이 억제가 가리던 것은 MySqlConnector 하나였다(작업지시서 §2-3).
         🔴 다시 켜지 마라 — build-and-test.yml 10/14 주석: 억제(NoWarn·WarningsNotAsErrors) 추가 금지 · 봉합은 꾸러미 갱신 차수 + 결재뿐. -->
  </PropertyGroup>

</Project>
