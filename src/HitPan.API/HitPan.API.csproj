<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.72" />
    <PackageReference Include="DotNetEnv" Version="3.1.1" />
    <!-- 🔴🔴 20261014 메모 (사장님 지시 「코드주석·md 에 메모 해둘것」) — NU1903 취약점 권고가 붙은 꾸러미다.
         ■ 사실
           · `NU1903`(known high severity vulnerability) 권고가 **실재**한다. 로컬 `dotnet restore` 에 강제 재평가 옵션
             (`force-evaluate`)을 주어 직접 확인했다. 🔴 XML 주석이라 그 옵션의 앞 두 글자는 여기 적을 수 없다.
             🔴 그 전에 「빌드 0/0」으로 보였던 것은 **restore 캐시** 때문이었다 — 0/0 을 적을 때 캐시를 의심하라.
           · `TreatWarningsAsErrors` 때문에 CI `Build (errors 0 + warnings 0)` 잡이 **이 권고로 빨강**이 된다.
           · 🔴 **간헐적이다.** 같은 나무가 통과 → 실패 → 통과했다. **왜 간헐인지는 미측정**이다(권고 DB 갱신 타이밍으로 의심하나 안 쟀다).
           · 🔴 **게시된 1.3.59 커밋(`main` = `e729217a`)도 이 자리에서 빨강이다.** 특정 갈래의 문제가 아니다.
         ■ 🚫 판 올리기 금지 — **작8(꾸러미 보안 갱신) 차수 + 사장님 결재**가 있어야 한다.
            `8.0.11` → 상위로 올리면 Blazor WASM 호스팅 축(#21 appsettings·WASM 부트)과 함께 재야 하고,
            그것은 「게시 한 번」이 걸린 일이라 PM 이 임의로 못 한다.
         ■ 🔴 여기서 판 숫자를 고치는 사람은 **작8 작업지시서와 사장님 결재를 먼저 확인하라.**
         ■ 근거 문서: docs/운영기록/20261014인계4_작9_결재거리2건_PR550_인수인계서.md §6
                      docs/운영기록/20261014일보3_작9_결재거리2건_일일작업보고서.md §5
                      일정표 docs/운영기록/20261014_일정표_ERP고객지원센터_트랙_사장님결재5건.md §3 순 8 · §8 -->
    <!-- 🔴 20261018작8 (사장님 결재 18 · 2026-10-18) — NU1903 봉합. 종전 줄은 지우지 않는다(#1):
         <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="8.0.11" />
         🟢 실측 근거: 사장님 손 4번(의존성 경보 Enable) 직후 Dependabot 경보 = high · nuget · 패치판 8.0.32.
         🔴 위 주석의 「판 올리기 금지」는 결재 18 로 해제됐다. 그 글자는 지우지 않았다. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="8.0.32" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.7" />
    <!-- 🔴 20261030작 MySqlConnector 판올림 (PM 브라운킴 결재 · 2026-10-30) — NU1902 GHSA-473q-m89c-ghf8 봉합.
         종전 줄은 지우지 않는다(#1):
         <PackageReference Include="MySqlConnector" Version="2.5.0" />
         🔴 이 판은 8곳(src 5 · tools 3)이 같아야 한다 — 한 곳만 올리면 판이 갈린다(판 내림 NU1605).
            src: API · Application · Backoffice.API · Infrastructure · IntegrationTests
            tools: MdbMigrationBaselineRun · MigrationIdempotencyCheck · MigrationSmokeTest
         정확한 판 하나로 적는다(범위식 금지). 근거 docs/운영기록/20261030작_MySqlConnector판올림_작업지시서.md -->
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="[8.0.0,9.0.0)" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="[8.0.0,9.0.0)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="[8.0.0,9.0.0)">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="QuestPDF" Version="2026.2.4" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.5" />
    <!-- 🔴 20261014 메모 — NU1903 권고 꾸러미(둘째). 위 `Components.WebAssembly.Server` 주석과 **같은 축**이다.
         🔴 이 선언은 `HitPan.Application.csproj` 에도 **같은 판으로** 있다 ⇒ 올릴 때 **두 군데를 함께** 올려야 한다
            (한쪽만 올리면 판이 갈려 조용히 낮은 판이 복원된다). 🚫 작8 + 사장님 결재. -->
    <!-- 🔴 20261018작8 (사장님 결재 18 · 2026-10-18) — NU1903 봉합. 종전 줄은 지우지 않는다(#1):
         <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
         🔴 이 선언은 HitPan.API.csproj 와 HitPan.Application.csproj 두 곳에 있고 같은 판이어야 한다
            (한쪽만 올리면 판이 갈려 조용히 낮은 판이 복원된다 — 종전 주석의 경고 그대로다). -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="[8.0.1,9.0.0)" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="MimeKit" Version="4.16.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HitPan.Application\HitPan.Application.csproj" />
    <ProjectReference Include="..\HitPan.Infrastructure\HitPan.Infrastructure.csproj" />
    <ProjectReference Include="..\HitPan.Contracts\HitPan.Contracts.csproj" />
    <!-- 축 6-4 (2026-05-14): 헌법 #15·#16 자동 검출 Roslyn Analyzer. -->
    <ProjectReference Include="..\HitPan.Analyzers\HitPan.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- 히트판 도우미·AI 직원 정체성/엔진 프롬프트(System Prompt): 실행/배포 출력으로 복사 (앱 시작 1회 로드용). -->
    <!-- 봉합 (2026-06-23, 5차 전수조사 PERM-01 P2): 종전엔 HITPAN_CHATBOT_IDENTITY.md 한 개만 복사 항목에
         등록돼, AI 직원 엔진 프롬프트 HITPAN_AI_AGENT.md(AiAgentSystemPromptProvider 가 로드)가 고객 PC
         출력 폴더에 누락 → 폴백 1줄 지침으로 동작(AI 직원 페르소나·셀링포인트 저하). AI 폴더의 모든 .md 를
         와일드카드로 복사해 향후 프롬프트 추가 시 누락도 원천 차단(헌법 #34 출하 정합). -->
    <None Update="AI\*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- 봉합 (2026-07-16, 작1 W-0 P0 — 설계팀·검증팀 SoD 독립 확증): 업데이트 마이그 SQL 을 출력에 복사한다.
         왜 P0 였나: .sql 은 .NET SDK 기본 Content 가 아니라, 이 지시가 없으면 publish 산출물에 단 한 개도
           안 실린다(소스 55개 → publish 0개, 실측 확인). 그러면 고객 PC 자동 업데이트 zip 에 마이그가 빠져,
           스키마 변경 릴리스가 MigrationRunner.ResolveMigrationsDirectory 에서 폴더를 못 찾아 "0건 no-op" →
           신버전 api 가 구스키마에서 500 → 롤백 → DB 오염 → 복구 불가(헌법 #19·#20 위반).
           최근 배포 EXE 1.2.29~1.2.33 전부 마이그 SQL 미포함이 이 누락의 증상이었다.
         MigrationRunner 는 배포 시 {baseDir}/Migrations/SQL 을 1순위 후보로 찾으므로(상대경로 유지), Link 없이
           Update 로 원래 폴더 구조 그대로 복사한다. 헌법 #36: 신규설치 진실원은 clean DDL, 본 SQL 은 '업데이트 시
           ALTER 적용' 경로 — 둘은 별개. 재발 차단은 CI 스모크(산출물 DB-*.sql 집합 == 소스 집합 + 비어있지 않음). -->
    <None Update="Migrations\SQL\DB-*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- 2026-09-30 작1 갈래 U (설계 §13-2 · PM 결재): 수동 업데이트 모듈이 워치독의 서명검증·다운로드·해시·
         디스크·잠금 판정을 '같은 한 벌'로 쓰도록 워치독 원본을 링크 컴파일한다.
         · 파일 복사 0 · 워치독 파일·워치독 csproj 수정 0 · 공용 라이브러리로 옮기지 않는다(= 워치독을 뜯는 일).
         · 서명 검증을 두 벌로 두지 않는다 — 수동 경로에 서명 우회 입구를 만들지 않기 위해서다(설계 §13-3).
         · API 쪽에서는 Services/ManualUpdate/WatchdogUpdateCoreAdapter.cs 만 이 형식들을 직접 부른다.
         · 동의 판독기(WatchdogConsentReader)·주 루프(Worker)는 링크하지 않는다(G-U3). -->
    <Compile Include="..\HitPan.Watchdog\AutoUpdate\UpdateChannel.cs" Link="Linked\Watchdog\UpdateChannel.cs" />
    <Compile Include="..\HitPan.Watchdog\AutoUpdate\UpdateManifestSigning.cs" Link="Linked\Watchdog\UpdateManifestSigning.cs" />
    <Compile Include="..\HitPan.Watchdog\AutoUpdate\UpdateSignatureVerifier.cs" Link="Linked\Watchdog\UpdateSignatureVerifier.cs" />
    <Compile Include="..\HitPan.Watchdog\AutoUpdate\UpdateClient.cs" Link="Linked\Watchdog\UpdateClient.cs" />
    <Compile Include="..\HitPan.Watchdog\AutoUpdate\UpdateDiskSpaceGuard.cs" Link="Linked\Watchdog\UpdateDiskSpaceGuard.cs" />
    <Compile Include="..\HitPan.Watchdog\AutoUpdate\UpdateLockFile.cs" Link="Linked\Watchdog\UpdateLockFile.cs" />
    <Compile Include="..\HitPan.Watchdog\DbConfReader.cs" Link="Linked\Watchdog\DbConfReader.cs" />
    <!-- DbConfReader.ApplyToOptions 의 매개변수 형식(POCO · 의존 0). 수동 모듈은 부르지 않는다 — 형식만 필요. -->
    <Compile Include="..\HitPan.Watchdog\WatchdogOptions.cs" Link="Linked\Watchdog\WatchdogOptions.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 2026-09-30 작1 I-API (갈래 A 개발명세서 §2): 교체 일꾼 스크립트를 출력·게시 폴더에 복사한다.
         없으면 런처가 script_missing 으로 거부한다(계약 §6) — .ps1 은 SDK 기본 Content 가 아니다(DB-*.sql 과 같은 이유). -->
    <None Update="Rollback\local-swap.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
