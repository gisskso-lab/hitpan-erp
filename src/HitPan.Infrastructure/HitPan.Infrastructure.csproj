<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\HitPan.Domain\HitPan.Domain.csproj" />
    <ProjectReference Include="..\HitPan.Application\HitPan.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 20260815작3 P2 (G-8) — 슬롯 계수·한도 판정을 **동작으로** 시험하기 위해 연다.
         Dapper 확장 메서드는 static 이라 흉내낼 수 없어, 순수 판정부(설정값 → 실제 한도)를
         internal 로 두고 시험이 직접 부른다. "코드에 숫자가 없는지" 만 보는 글자 검사는
         상수를 옮기면 통과하는 가짜다(작지서 §5). -->
    <InternalsVisibleTo Include="HitPan.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.1.0" />
    <PackageReference Include="Hangfire.Core" Version="1.8.23" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="[8.0.0,9.0.0)" />
    <!-- 🔴 20261030작 MySqlConnector 판올림 (PM 브라운킴 결재 · 2026-10-30) — NU1902 GHSA-473q-m89c-ghf8 봉합.
         종전 줄은 지우지 않는다(#1):
         <PackageReference Include="MySqlConnector" Version="2.5.0" />
         🔴 이 판은 8곳(src 5 · tools 3)이 같아야 한다 — 한 곳만 올리면 판이 갈린다(판 내림 NU1605).
            src: API · Application · Backoffice.API · Infrastructure · IntegrationTests
            tools: MdbMigrationBaselineRun · MigrationIdempotencyCheck · MigrationSmokeTest
         정확한 판 하나로 적는다(범위식 금지). 근거 docs/운영기록/20261030작_MySqlConnector판올림_작업지시서.md -->
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="[8.0.0,9.0.0)" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
