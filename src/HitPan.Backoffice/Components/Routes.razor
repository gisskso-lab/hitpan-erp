<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
        @* ⬛ 옛 줄(20261107작 F6 2회차) — 회로 첫 렌더 직후 초점을 h1 으로 끌어가 먼저 누른 입력칸 글자 유실: <FocusOnNavigate RouteData="routeData" Selector="h1" /> *@
        <FocusOnNavigateAfterFirst RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(Layout.MainLayout)">
            <p role="alert">페이지를 찾을 수 없습니다.</p>
        </LayoutView>
    </NotFound>
</Router>
