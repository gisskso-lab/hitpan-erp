@*
    WS-20260601-18 본사 백오피스 사이드바 (8명제 #7 본사 전권한)
    작성일: 2026-06-01 / 작성팀: 프론트 매니저 + 수석 웹디자이너
    절대 원칙:
      - 기존 BackofficeSidebar.razor 덮어쓰기 금지 (헌법 #1) → 신규 분리
      - role=owner는 추가 메뉴 (System Config·Platform Users) 노출
      - 평문 사업자정보 노출 0
*@

@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState

<div class="bo-sidebar">
    <div class="bo-brand">
        <div class="bo-brand-logo">HP</div>
        <div>
            <div class="bo-brand-title">히트판 백오피스</div>
            <div class="bo-brand-sub">@_roleLabel</div>
        </div>
    </div>

    @* 헌법 #35 W1+W2+W5 (사장님 결재 2026-06-04): 활성 메뉴만 노출.
        W9 대기 메뉴(시리얼 발급·CS·결제·수수료·통계·워치독)는 백오피스 API 신설 후 복원. *@
    <MudNavMenu Class="bo-nav">
        <MudNavLink Href="/admin/dashboard" Icon="@Icons.Material.Filled.Dashboard" Match="NavLinkMatch.All">
            대시보드
        </MudNavLink>
        <MudNavLink Href="/admin/tenants" Icon="@Icons.Material.Filled.Business">
            고객사 관리
        </MudNavLink>
        <MudNavLink Href="/admin/resellers" Icon="@Icons.Material.Filled.Store">
            협력업체 관리
        </MudNavLink>
        <MudNavLink Href="/admin/reseller-applications" Icon="@Icons.Material.Filled.HowToReg">
            협력업체 신청
        </MudNavLink>

        @* W9 대리점 영역 (사장님 결재 2026-06-05) *@
        <MudDivider Class="my-2" />
        <MudText Typo="Typo.caption" Class="px-4" Style="color:var(--mud-palette-text-secondary);">
            대리점 (W9)
        </MudText>
        <MudNavLink Href="/admin/reseller-settlements" Icon="@Icons.Material.Filled.MonetizationOn">
            대리점 정산
        </MudNavLink>
        <MudNavLink Href="/admin/reseller-serials" Icon="@Icons.Material.Filled.QrCode">
            대리점 시리얼
        </MudNavLink>

        @if (_isOwner)
        {
            <MudDivider Class="my-2" />
            <MudText Typo="Typo.caption" Class="px-4" Style="color:var(--mud-palette-text-secondary);">
                Owner 전용
            </MudText>
            <MudNavLink Href="/owner/system-config" Icon="@Icons.Material.Filled.Settings">
                시스템 설정
            </MudNavLink>
            <MudNavLink Href="/admin/bo-users" Icon="@Icons.Material.Filled.AdminPanelSettings">
                Owner 사용자 관리
            </MudNavLink>
            <MudNavLink Href="/admin/approvals" Icon="@Icons.Material.Filled.HowToReg">
                4-eyes 결재함
            </MudNavLink>
            <MudNavLink Href="/admin/mfa-setup" Icon="@Icons.Material.Filled.Security">
                MFA 등록
            </MudNavLink>
            <MudNavLink Href="/owner/permissions" Icon="@Icons.Material.Filled.VpnKey">
                권한 관리
            </MudNavLink>
            <MudNavLink Href="/owner/credentials-status" Icon="@Icons.Material.Filled.Shield">
                자격증명 상태
            </MudNavLink>
            <MudNavLink Href="/admin/tenant-domains" Icon="@Icons.Material.Filled.Dns">
                도메인 자동 발급
            </MudNavLink>
            <MudNavLink Href="/owner/test-flow" Icon="@Icons.Material.Filled.PlayCircle">
                전체 흐름 테스트
            </MudNavLink>
        }
    </MudNavMenu>

    <div class="bo-sidebar-footer">
        <MudButton Variant="Variant.Text" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Logout"
                   OnClick="Logout"
                   Style="color: var(--mud-palette-text-secondary); font-size:0.8rem;">
            로그아웃
        </MudButton>
    </div>
</div>

@code {
    private bool _isOwner;
    private bool _canBilling;
    private string _roleLabel = "본사 관리";

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var role = state.User.FindFirst("role")?.Value ?? "";
        _isOwner = role == "owner";
        _canBilling = role == "owner" || role == "platform_manager";
        _roleLabel = role switch
        {
            "owner" => "Owner (사장님)",
            "platform_manager" => "본사 Manager",
            "platform_staff" => "본사 Staff",
            _ => "본사 관리"
        };
    }

    private void Logout() => Nav.NavigateTo("/backoffice/login", forceLoad: true);
}
