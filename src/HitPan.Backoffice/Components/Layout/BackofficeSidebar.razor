@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject HitPan.Backoffice.Services.CsCountsService Counts
@implements IDisposable

@*
    백오피스 v2 사이드바 (사장님 결재 2026-06-01 · 작14 메뉴 재구성 2026-10-08)
    - 본사 8대메뉴 틀(작14 §10 M-6): 1 대시보드 · 2 대리점관리 · 3 고객 · 4 CS · 5 결제·구독 · 6 운영현황 · 7 마케팅 · 8 설정
      이 중 화면 실물이 있는 2·3·5·7·8 만 노출 (빈 껍데기 금지)
    - 대리점 로그인: 내 고객사 · 내 정산 2줄
*@

<div class="bo-sidebar bo2-sidebar-inner">
    <div class="bo2-brand">
        <div class="bo2-brand-logo">HP</div>
        <div class="bo2-brand-text">
            <div class="bo2-brand-title">@_brandTitle</div>
            <div class="bo2-brand-sub">@_brandSub</div>
        </div>
    </div>

    <nav class="bo2-nav">
        @* 작14 묶음 A (사장님 결재 2026-10-08): 본사 8대메뉴 틀 재배치.
            화면이 없거나 껍데기인 대메뉴(1 대시보드 · 4 CS · 6 운영현황)는 미노출 — 빈 껍데기 금지.
            각 소메뉴는 후속 사이클에서 화면이 실물로 붙을 때 노출한다. *@
        @if (_isPlatformAdmin || _isPlatformOwner)
        {
            @* 2 대리점 관리 — 본사 전용 *@
            <div class="bo2-nav-section">
                <div class="bo2-nav-section-label">대리점 관리</div>
                <NavLinkItem Href="/admin/resellers" Icon="store" Label="대리점 목록" Count="@_countResellers" />
                <NavLinkItem Href="/admin/reseller-applications" Icon="how_to_reg" Label="대리점 신청" />
                <NavLinkItem Href="/admin/reseller-serials" Icon="qr_code" Label="대리점 시리얼" />
                <NavLinkItem Href="/admin/reseller-settlements" Icon="monetization_on" Label="대리점 정산" />
            </div>

            @* 3 고객 관리 *@
            <div class="bo2-nav-section">
                <div class="bo2-nav-section-label">고객 관리</div>
                <NavLinkItem Href="/admin/tenants" Icon="business" Label="고객 목록" Count="@_countTenants" />
                <NavLinkItem Href="/admin/signups" Icon="person_add" Label="고객 신청" />
            </div>

            @* 4 CS — 작14 B-8 에서 /admin/cs 가 실물이 되어 노출 (A-1 「화면이 실물로 붙을 때 노출」 그대로) *@
            <div class="bo2-nav-section">
                <div class="bo2-nav-section-label">CS</div>
                @* 사장님 지시 2026-10-08: 안 읽은 CS 는 **빨간 숫자**로 — 아래 띠와 같은 값을 쓴다 *@
                <NavLinkItem Href="/admin/cs" Icon="support_agent" Label="CS 창구"
                             Count="@_countCsUnread" CountAccent="danger" />
                @* 작14 C-3: 백과사전 화면이 실물이 된 차수에 노출한다(A-1 「빈 껍데기 금지」 규칙 그대로) *@
                <NavLinkItem Href="/admin/kb" Icon="menu_book" Label="CS 백과사전" />
            </div>

            @* 5 결제·구독 — 본사 전용 *@
            <div class="bo2-nav-section">
                <div class="bo2-nav-section-label">결제·구독</div>
                <NavLinkItem Href="/admin/pricing" Icon="payments" Label="요금제" />
            </div>

            @* 7 마케팅 *@
            <div class="bo2-nav-section">
                <div class="bo2-nav-section-label">마케팅</div>
                <NavLinkItem Href="/admin/promotions" Icon="campaign" Label="프로모션 관리" />
            </div>

            @* 8 설정 — 노출 조건은 platform_owner 다. System Config 는 안내 껍데기라 미노출.
               🔴 그 값은 토큰에 영영 들어가지 않는다 — BoRoles.DeriveAccountType 이 본사 2역할을
                  모두 platform_admin 으로 접는 것이 설계값이다(BoRoles.cs 머리말 PM 결재 2026-10-07).
                  ⇒ 이 묶음은 현재 아무에게도 렌더되지 않는다. 선재 구멍이고 작14 가 만든 것이 아니다.
                  판정·갈래 = docs/검증/선행/20261008_선행검증서_작14_설정OWNER_노출구멍.md
               🔴 「Owner 전용」이라 적지 않는다 — 6줄의 접근 조건이 같지 않다 (PM 검산 2026-10-08):
                  · OwnerOnly 2줄 = /owner/permissions · /owner/credentials-status
                    (단 OwnerOnly 자체도 role="owner" 를 요구해 현행 DB 역할로는 통과 불가)
                  · 인증만([Authorize]) 4줄 = /admin/bo-users · /admin/approvals · /admin/mfa-setup · /admin/tenant-domains
               노출 조건과 접근 조건은 다른 것이다. 잠금 추가는 권한 범위라 사장님 결재 사항(#11). *@
            @if (_isPlatformOwner)
            {
                <div class="bo2-nav-section bo2-nav-section-owner">
                    <div class="bo2-nav-section-label">설정 <span class="bo2-owner-tag">OWNER</span></div>
                    <NavLinkItem Href="/admin/bo-users" Icon="admin_panel_settings" Label="Owner 사용자 관리" />
                    <NavLinkItem Href="/admin/approvals" Icon="how_to_reg" Label="4-eyes 결재함" />
                    <NavLinkItem Href="/admin/mfa-setup" Icon="security" Label="MFA 등록" />
                    <NavLinkItem Href="/owner/permissions" Icon="vpn_key" Label="권한 관리" />
                    <NavLinkItem Href="/owner/credentials-status" Icon="shield" Label="자격증명 상태" />
                    <NavLinkItem Href="/admin/tenant-domains" Icon="dns" Label="도메인 자동 발급" />
                </div>
            }
        }
        else
        {
            @* 대리점 로그인 — 실물 2줄 (작14 A-3 · 사장님 결재 2026-10-08) *@
            <div class="bo2-nav-section">
                <div class="bo2-nav-section-label">고객 관리</div>
                <NavLinkItem Href="/reseller/customers" Icon="business" Label="내 고객사" />
            </div>
            @* 섹션 제목 = 「정산」 · 링크 = 「내 정산」 — 같은 글자 두 번 보이는 것을 피한다(PM 검산 10/8) *@
            <div class="bo2-nav-section">
                <div class="bo2-nav-section-label">정산</div>
                <NavLinkItem Href="/reseller/settlement" Icon="monetization_on" Label="내 정산" />
            </div>
        }
    </nav>

    <div class="bo2-sidebar-footer">
        <div class="bo2-sidebar-env">
            <span class="bo2-env-dot"></span>
            <span>운영 환경</span>
        </div>
    </div>
</div>

@code {
    private bool _isPlatformAdmin;
    private bool _isPlatformOwner;
    private string _brandTitle = "히트판 백오피스";
    private string _brandSub = "본사 관리";

    // 카운트 뱃지 — 시드 0건 시 null로 숨김 처리
    private int? _countTenants = null;
    private int? _countResellers = null;

    // 안 읽은 CS — 화면 아래 띠(CsStatusBar)와 **같은 서비스**에서 읽는다(숫자 어긋남 방지)
    private int? _countCsUnread = null;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        var accountType = state.User.FindFirst("account_type")?.Value;
        _isPlatformAdmin = accountType == "platform_admin" || accountType == "platform_owner";
        _isPlatformOwner = accountType == "platform_owner";

        if (_isPlatformAdmin)
        {
            _brandTitle = "히트판 백오피스";
            _brandSub = _isPlatformOwner ? "Owner Console" : "본사 관리";
        }
        else
        {
            var resellerName = state.User.FindFirst("name")?.Value ?? string.Empty;
            _brandTitle = "히트판 파트너";
            _brandSub = resellerName;
        }

        if (_isPlatformAdmin)
        {
            Counts.Changed += OnCountsChanged;
            OnCountsChanged();                 // 띠가 이미 세어 뒀으면 그 값을 바로 쓴다
            await Counts.RefreshAsync();
        }
    }

    private void OnCountsChanged()
    {
        _countCsUnread = Counts.Loaded && Counts.Unread > 0 ? (int)Counts.Unread : null;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Counts.Changed -= OnCountsChanged;
}
