@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JS

@*
    백오피스 v2 상단 헤더 (사장님 결재 2026-06-01)
    - 56px 화이트 + 그림자 1단
    - 로고 / 검색바 (Cmd+K) / 알림 벨 / 프로필
*@

<header class="bo2-topbar">
    <div class="bo2-topbar-left">
        <button class="bo2-hamburger" @onclick="OnToggle" aria-label="메뉴 열기">
            <span class="material-icons">menu</span>
        </button>
        <div class="bo2-topbar-brand">
            <div class="bo2-topbar-logo">HP</div>
            <span class="bo2-topbar-title">히트판 백오피스</span>
        </div>
    </div>

    <div class="bo2-topbar-center">
        <div class="bo2-search">
            <span class="material-icons bo2-search-icon">search</span>
            <input type="text"
                   class="bo2-search-input"
                   placeholder="시리얼·고객사·대리점 검색"
                   @bind="_searchQuery"
                   @bind:event="oninput"
                   @onkeydown="OnSearchKeyDown" />
            <kbd class="bo2-search-kbd">Ctrl K</kbd>
        </div>
    </div>

    <div class="bo2-topbar-right">
        <button class="bo2-icon-btn" aria-label="알림">
            <span class="material-icons">notifications_none</span>
            @if (_unreadCount > 0)
            {
                <span class="bo2-badge-dot">@(_unreadCount > 9 ? "9+" : _unreadCount.ToString())</span>
            }
        </button>

        <div class="bo2-profile" @onclick="ToggleProfile">
            <div class="bo2-profile-avatar">@_avatarText</div>
            <div class="bo2-profile-info">
                <div class="bo2-profile-name">@_displayName</div>
                <div class="bo2-profile-role">@_displayRole</div>
            </div>
            <span class="material-icons bo2-profile-chevron">expand_more</span>

            @if (_profileOpen)
            {
                <div class="bo2-profile-menu" @onclick:stopPropagation="true">
                    <div class="bo2-profile-menu-header">
                        <div class="bo2-profile-name">@_displayName</div>
                        <div class="bo2-profile-role">@_displayRole</div>
                    </div>
                    <button class="bo2-profile-menu-item" @onclick="LogoutAsync">
                        <span class="material-icons">logout</span>
                        <span>로그아웃</span>
                    </button>
                </div>
            }
        </div>
    </div>
</header>

@code {
    [Parameter] public EventCallback OnToggleSidebar { get; set; }

    private string _searchQuery = string.Empty;
    private bool _profileOpen = false;
    private int _unreadCount = 0;
    private string _displayName = "본사 관리자";
    private string _displayRole = "Platform Admin";
    private string _avatarText = "H";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            var name = state.User.FindFirst("name")?.Value
                       ?? state.User.Identity?.Name
                       ?? "본사 관리자";
            var accountType = state.User.FindFirst("account_type")?.Value;

            _displayName = name;
            _displayRole = accountType switch
            {
                "platform_admin" => "Platform Admin",
                "platform_owner" => "Platform Owner",
                "reseller" => "대리점",
                _ => "백오피스"
            };
            _avatarText = string.IsNullOrWhiteSpace(name) ? "H" : name.Substring(0, 1).ToUpperInvariant();
        }
        catch (Exception)
        {
            // 인증 실패 시 기본값 유지 (헌법 #15: 로그만 생략 가능, 운영에 무해)
        }
    }

    private Task OnToggle() => OnToggleSidebar.InvokeAsync();

    private void ToggleProfile() => _profileOpen = !_profileOpen;

    private void OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_searchQuery))
        {
            Nav.NavigateTo($"/admin/search?q={Uri.EscapeDataString(_searchQuery)}");
        }
        else if (e.Key == "Escape")
        {
            _searchQuery = string.Empty;
        }
    }

    private void LogoutAsync()
    {
        _profileOpen = false;
        Nav.NavigateTo("/backoffice/login", forceLoad: true);
    }
}
