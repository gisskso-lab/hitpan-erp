@page "/backoffice/reseller-apply"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@layout EmptyLayout
@rendermode InteractiveServer
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav

@*
    협력업체 가입 신청 (사장님 결재 2026-06-04)
    헌법 #35 — 백오피스 영역 (본사 클라우드)
    POST /api/backoffice/reseller-applications → PDF 계약서 자동 송부
*@

<PageTitle>협력업체 가입 신청 — 히트판</PageTitle>

<div class="ra-page">
    <div class="ra-card">
        <div class="ra-brand">
            <div class="ra-logo">HP</div>
            <h1>협력업체 가입 신청</h1>
            <p>가입 신청 시 가입계약서 초안 PDF가 이메일로 발송됩니다.</p>
        </div>

        @if (_submitted)
        {
            <div class="ra-done">
                <div class="ra-done-icon">✓</div>
                <h2>신청이 접수되었습니다</h2>
                <p>가입계약서 초안 PDF를 <b>@_form.Email</b> 로 발송했습니다.</p>
                <p>본사 검토 후 정식 계약서가 별도로 발송됩니다.</p>
                @if (!string.IsNullOrEmpty(_applicationId))
                {
                    <div class="ra-id">
                        <div class="ra-id-label">신청 번호</div>
                        <div class="ra-id-value">@_applicationId</div>
                    </div>
                }
                <a href="/backoffice/login" class="ra-back-btn">로그인 화면으로 돌아가기</a>
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="ra-error">@_error</div>
            }

            <EditForm Model="_form" OnValidSubmit="HandleSubmit">
                <div class="ra-section">
                    <h3>회사 정보</h3>
                    <div class="ra-field">
                        <label>회사명 *</label>
                        <input type="text" @bind="_form.CompanyName" required />
                    </div>
                    <div class="ra-field">
                        <label>사업자등록번호 *</label>
                        <input type="text" @bind="_form.BizNo" placeholder="000-00-00000" required />
                    </div>
                    <div class="ra-field">
                        <label>대표자명 *</label>
                        <input type="text" @bind="_form.CeoName" required />
                    </div>
                    <div class="ra-field">
                        <label>회사 주소</label>
                        <input type="text" @bind="_form.CompanyAddress" />
                    </div>
                </div>

                <div class="ra-section">
                    <h3>담당자 정보</h3>
                    <div class="ra-field">
                        <label>담당자명 *</label>
                        <input type="text" @bind="_form.ContactName" required />
                    </div>
                    <div class="ra-field">
                        <label>담당자 직책</label>
                        <input type="text" @bind="_form.ContactTitle" placeholder="예: 영업팀장" />
                    </div>
                    <div class="ra-field">
                        <label>연락처 *</label>
                        <input type="tel" @bind="_form.Phone" placeholder="010-0000-0000" required />
                    </div>
                    <div class="ra-field">
                        <label>이메일 *</label>
                        <input type="email" @bind="_form.Email" required />
                    </div>
                </div>

                <div class="ra-section">
                    <h3>영업 정보</h3>
                    <div class="ra-field">
                        <label>영업 지역</label>
                        <input type="text" @bind="_form.SalesRegion" placeholder="예: 서울/경기" />
                    </div>
                    <div class="ra-field">
                        <label>영업 경력 (년)</label>
                        <input type="number" @bind="_form.SalesYears" min="0" max="60" />
                    </div>
                    <div class="ra-field">
                        <label>신청 사유</label>
                        <textarea @bind="_form.Reason" rows="3" placeholder="히트판 ERP 협력 영업을 신청하시는 사유를 자유롭게 작성해주세요."></textarea>
                    </div>
                </div>

                <div class="ra-terms">
                    <label class="ra-term-row">
                        <input type="checkbox" @bind="_form.AgreeTerms" />
                        <span>[필수] 협력업체 표준약관에 동의합니다.</span>
                    </label>
                    <label class="ra-term-row">
                        <input type="checkbox" @bind="_form.AgreePrivacy" />
                        <span>[필수] 개인정보 수집·이용에 동의합니다.</span>
                    </label>
                </div>

                <button type="submit" class="ra-submit" disabled="@_submitting">
                    @(_submitting ? "신청 처리 중..." : "가입 신청하기")
                </button>

                <a href="/backoffice/login" class="ra-cancel">취소하고 로그인 화면으로</a>
            </EditForm>
        }
    </div>
</div>

@code {
    private ApplyForm _form = new();
    private bool _submitting;
    private bool _submitted;
    private string? _error;
    private string? _applicationId;

    private async Task HandleSubmit()
    {
        _error = null;
        if (!_form.AgreeTerms || !_form.AgreePrivacy)
        {
            _error = "필수 약관 2건에 모두 동의해주세요.";
            return;
        }

        _submitting = true;
        try
        {
            var http = HttpFactory.CreateClient("backoffice-public");
            var res = await http.PostAsJsonAsync("api/backoffice/reseller-applications", _form);
            var payload = await res.Content.ReadFromJsonAsync<ApplyResponse>();
            if (res.IsSuccessStatusCode && payload is not null && payload.Success)
            {
                _applicationId = payload.ApplicationId;
                _submitted = true;
            }
            else
            {
                _error = payload?.Message ?? $"신청 처리 실패 ({(int)res.StatusCode}).";
            }
        }
        catch (Exception ex)
        {
            _error = $"신청 중 오류가 발생했습니다: {ex.Message}";
        }
        finally
        {
            _submitting = false;
        }
    }

    private class ApplyForm
    {
        public string CompanyName { get; set; } = "";
        public string BizNo { get; set; } = "";
        public string CeoName { get; set; } = "";
        public string? CompanyAddress { get; set; }
        public string ContactName { get; set; } = "";
        public string? ContactTitle { get; set; }
        public string Phone { get; set; } = "";
        public string Email { get; set; } = "";
        public string? SalesRegion { get; set; }
        public int? SalesYears { get; set; }
        public string? Reason { get; set; }
        public bool AgreeTerms { get; set; }
        public bool AgreePrivacy { get; set; }
    }

    private class ApplyResponse
    {
        public bool Success { get; set; }
        public string? Message { get; set; }
        public string? ApplicationId { get; set; }
    }
}

<style>
    .ra-page {
        min-height: 100vh;
        display: flex; align-items: center; justify-content: center;
        background: linear-gradient(135deg, #F0F9F5 0%, #E0F2EA 100%);
        font-family: 'Pretendard', 'Malgun Gothic', sans-serif;
        padding: 40px 20px;
    }
    .ra-card {
        width: 100%; max-width: 560px;
        background: #fff; border-radius: 16px;
        padding: 40px 36px;
        box-shadow: 0 8px 32px rgba(15, 110, 86, 0.12);
    }
    .ra-brand { text-align: center; margin-bottom: 24px; }
    .ra-logo {
        width: 56px; height: 56px;
        background: #0F6E56; border-radius: 14px;
        display: inline-flex; align-items: center; justify-content: center;
        font-weight: 800; color: #fff;
        margin-bottom: 16px;
    }
    .ra-brand h1 { font-size: 22px; font-weight: 700; color: #0F1419; margin: 0 0 6px; }
    .ra-brand p { font-size: 13px; color: #6B7280; margin: 0; }
    .ra-section { margin-bottom: 24px; }
    .ra-section h3 {
        font-size: 14px; font-weight: 700; color: #0F6E56;
        margin: 0 0 12px; padding-bottom: 8px;
        border-bottom: 1px solid #E0F2EA;
    }
    .ra-field { margin-bottom: 12px; }
    .ra-field label {
        display: block; font-size: 13px; font-weight: 600;
        color: #4B5563; margin-bottom: 6px;
    }
    .ra-field input,
    .ra-field textarea {
        width: 100%; padding: 11px 13px;
        border: 1px solid #D1D5DB; border-radius: 8px;
        font-size: 14px; box-sizing: border-box; font-family: inherit;
        resize: vertical;
    }
    .ra-field input:focus,
    .ra-field textarea:focus {
        outline: none; border-color: #0F6E56;
        box-shadow: 0 0 0 3px rgba(15, 110, 86, 0.1);
    }
    .ra-terms {
        background: #F9FAFB; border-radius: 10px;
        padding: 14px 16px; margin-bottom: 16px;
        border: 1px solid #EAEDF0;
    }
    .ra-term-row {
        display: flex; align-items: center; gap: 8px;
        padding: 6px 0; font-size: 14px; color: #1A2B4A;
        cursor: pointer;
    }
    .ra-term-row input { width: 18px; height: 18px; cursor: pointer; }
    .ra-submit {
        width: 100%; padding: 14px;
        background: #0F6E56; color: #fff;
        border: none; border-radius: 8px;
        font-size: 15px; font-weight: 700; cursor: pointer;
    }
    .ra-submit:hover:not(:disabled) { background: #0A5240; }
    .ra-submit:disabled { opacity: 0.6; cursor: not-allowed; }
    .ra-cancel {
        display: block; text-align: center; margin-top: 12px;
        font-size: 13px; color: #6B7280; text-decoration: none;
    }
    .ra-cancel:hover { color: #0F6E56; }
    .ra-error {
        background: #FEE2E2; color: #B91C1C;
        padding: 12px; border-radius: 8px;
        font-size: 13px; margin-bottom: 16px;
    }
    .ra-done { text-align: center; padding: 20px 0; }
    .ra-done-icon {
        width: 64px; height: 64px; margin: 0 auto 16px;
        background: #0F6E56; color: #fff;
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 32px; font-weight: 700;
    }
    .ra-done h2 { font-size: 20px; color: #0F1419; margin: 0 0 16px; }
    .ra-done p { font-size: 14px; color: #4B5563; margin: 8px 0; line-height: 1.5; }
    .ra-id {
        background: #F0FAF6; border: 1px solid #C7E9D9;
        border-radius: 10px; padding: 14px; margin: 20px 0;
    }
    .ra-id-label { font-size: 12px; color: #6B7280; margin-bottom: 4px; }
    .ra-id-value {
        font-size: 14px; font-weight: 700; color: #0F6E56;
        font-family: Consolas, Monaco, monospace; word-break: break-all;
    }
    .ra-back-btn {
        display: inline-block; margin-top: 16px;
        padding: 12px 24px;
        background: #0F6E56; color: #fff;
        border-radius: 8px; text-decoration: none;
        font-weight: 700; font-size: 14px;
    }
    .ra-back-btn:hover { background: #0A5240; }
</style>
