@page "/backoffice/login"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@layout EmptyLayout
@inject NavigationManager Nav

@* 백오피스 통합 로그인 (헌법 #35 정합)
   - SSR 폼 POST → /backoffice/auth/signin (HttpContext.SignInAsync로 쿠키 발급)
   - 본사·대리점 같은 입구. 컨트롤러가 admin 먼저 시도 → 실패 시 reseller 시도
   - 성공 시 컨트롤러가 /admin/dashboard로 리다이렉트 *@

<PageTitle>백오피스 로그인 — 히트판</PageTitle>

<div class="bo-login-page">
    <div class="bo-login-card">
        <div class="bo-login-brand">
            <div class="bo-login-logo">HP</div>
            <h1>히트판 백오피스</h1>
            <p>운영·파트너 포털</p>
        </div>

        <p class="bo-login-sub">본사·대리점 통합 로그인 (계정으로 자동 분기)</p>

        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="bo-login-error">@Error</div>
        }

        <form method="post" action="/backoffice/auth/signin">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />

            <label class="bo-login-label">이메일</label>
            <input type="email" name="email" required class="bo-login-input" autocomplete="username" />

            <label class="bo-login-label">비밀번호</label>
            <input type="password" name="password" required class="bo-login-input" autocomplete="current-password" />

            <button type="submit" class="bo-login-button">로그인</button>
        </form>

        <div class="bo-login-partner">
            <div class="bo-login-divider"><span>아직 협력업체가 아니신가요?</span></div>
            <a href="/backoffice/reseller-apply" class="bo-login-partner-btn">
                협력업체 가입 신청
            </a>
            <p class="bo-login-partner-note">신청 시 가입계약서 초안이 이메일로 발송됩니다.</p>
        </div>
    </div>
</div>

<style>
    /* 사장님 결재 2026-06-04: 다크 → 밝은 톤 + 가독성 */
    .bo-login-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #F0F9F5 0%, #E0F2EA 100%);
        font-family: 'Pretendard', 'Malgun Gothic', sans-serif;
    }
    .bo-login-card {
        width: 100%;
        max-width: 420px;
        background: #fff;
        border-radius: 16px;
        padding: 40px 36px;
        box-shadow: 0 8px 32px rgba(15, 110, 86, 0.12);
    }
    .bo-login-brand { text-align: center; margin-bottom: 8px; }
    .bo-login-logo {
        width: 56px; height: 56px;
        background: #0F6E56;
        border-radius: 14px;
        display: inline-flex; align-items: center; justify-content: center;
        font-weight: 800; font-size: 1.2rem; color: #fff;
        margin-bottom: 16px;
        box-shadow: 0 4px 12px rgba(15, 110, 86, 0.25);
    }
    .bo-login-brand h1 { font-size: 22px; font-weight: 700; color: #0F1419; margin: 0 0 4px; }
    .bo-login-brand p { font-size: 13px; color: #6B7280; margin: 0; }
    .bo-login-sub { text-align: center; font-size: 13px; color: #6B7280; margin: 16px 0 24px; }
    .bo-login-label { display: block; font-size: 13px; font-weight: 600; color: #4B5563; margin: 12px 0 6px; }
    .bo-login-input {
        width: 100%; padding: 12px 14px;
        border: 1px solid #D1D5DB; border-radius: 8px;
        font-size: 14px; box-sizing: border-box;
        font-family: inherit;
    }
    .bo-login-input:focus { outline: none; border-color: #0F6E56; box-shadow: 0 0 0 3px rgba(15, 110, 86, 0.1); }
    .bo-login-button {
        width: 100%; margin-top: 20px;
        padding: 14px;
        background: #0F6E56; color: #fff;
        border: none; border-radius: 8px;
        font-size: 15px; font-weight: 700;
        cursor: pointer;
    }
    .bo-login-button:hover { background: #0A5240; }
    .bo-login-error {
        background: #FEE2E2; color: #B91C1C;
        padding: 12px; border-radius: 8px;
        font-size: 13px; margin-bottom: 12px;
    }
    .bo-login-partner { margin-top: 28px; }
    .bo-login-divider {
        display: flex; align-items: center; gap: 12px;
        font-size: 12px; color: #9CA3AF; margin-bottom: 14px;
    }
    .bo-login-divider::before,
    .bo-login-divider::after {
        content: ""; flex: 1; height: 1px; background: #E5E7EB;
    }
    .bo-login-partner-btn {
        display: block; text-align: center; text-decoration: none;
        padding: 12px; border: 1.5px solid #0F6E56; color: #0F6E56;
        background: #fff; border-radius: 8px;
        font-size: 14px; font-weight: 700;
        transition: background 0.15s ease, color 0.15s ease;
    }
    .bo-login-partner-btn:hover { background: #0F6E56; color: #fff; }
    .bo-login-partner-note {
        margin-top: 8px; font-size: 12px; color: #6B7280; text-align: center;
    }
</style>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
}
