@inject IHttpClientFactory HttpFactory
@inject ISnackbar Snackbar

@*
    Owner 사용자 추가 요청 다이얼로그 (W11, 사장님 결재 2026-06-05)
    4-eyes — 본 다이얼로그는 결재 큐 등록만, 실제 생성은 다른 Owner 승인 후
*@

<MudDialog>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudTextField @bind-Value="_email" Label="이메일" Required="true" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_password" Label="비밀번호 (12자 이상)" InputType="InputType.Password" Required="true" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_name" Label="이름" Required="true" />
            </MudItem>
            <MudItem xs="6">
                <MudSelect T="string" @bind-Value="_role" Label="역할" Required="true">
                    <MudSelectItem Value="@("owner")">owner</MudSelectItem>
                    <MudSelectItem Value="@("admin")">admin</MudSelectItem>
                    <MudSelectItem Value="@("reseller")">reseller</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="6">
                <MudTextField @bind-Value="_resellerId" Label="reseller ID (선택)" />
            </MudItem>
            <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Dense="true">
                    4-eyes 결재 큐에 등록됩니다. 다른 Owner 1명 승인 후 실제 생성됩니다.
                </MudAlert>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">취소</MudButton>
        <MudButton OnClick="Submit" Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="@_submitting">
            @(_submitting ? "요청 중..." : "결재 큐에 요청")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private string _email = "";
    private string _password = "";
    private string _name = "";
    private string _role = "admin";
    private string _resellerId = "";
    private bool _submitting = false;

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password)
            || string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_role))
        {
            Snackbar.Add("필수 항목을 입력해주세요.", Severity.Warning);
            return;
        }
        if (_password.Length < 12)
        {
            Snackbar.Add("비밀번호는 12자 이상이어야 합니다.", Severity.Warning);
            return;
        }

        _submitting = true;
        try
        {
            var http = HttpFactory.CreateClient("backoffice-authed");
            var res = await http.PostAsJsonAsync("api/backoffice/owner/bo-users/request-create", new
            {
                Email = _email,
                Password = _password,
                Name = _name,
                Role = _role,
                ResellerId = string.IsNullOrWhiteSpace(_resellerId) ? null : _resellerId
            });
            var payload = await res.Content.ReadFromJsonAsync<ActionResponse>();
            if (res.IsSuccessStatusCode && payload?.Success == true)
            {
                Snackbar.Add(payload.Message ?? "결재 큐에 등록됐습니다.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(payload?.Message ?? "요청 실패", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"요청 중 오류: {ex.Message}", Severity.Error);
        }
        finally
        {
            _submitting = false;
        }
    }

    private class ActionResponse
    {
        public bool Success { get; set; }
        public string? Message { get; set; }
        public long? ApprovalId { get; set; }
    }
}
