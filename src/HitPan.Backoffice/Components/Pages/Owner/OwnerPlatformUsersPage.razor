@*
    Owner 전용 본사 직원 사용자 관리 (사장님 결재 2026-06-04, 헌법 #35)
    W11 백엔드 신설 대기 — bo_users CRUD + 4-eyes 결재 인프라.
*@

@page "/owner/users"
@page "/owner/platform-users"
@layout PlatformLayout
@attribute [Authorize(Policy = "OwnerOnly")]
@inject NavigationManager Nav

<PageTitle>본사 직원 관리 — 히트판 백오피스 (Owner)</PageTitle>

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
    <div>
        <MudText Typo="Typo.h5" Style="font-weight:600;">본사 직원 관리</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Owner 전용 — bo_users CRUD + 4-eyes 결재 인프라 신설 대기 (W11)
        </MudText>
    </div>
</div>

<MudAlert Severity="Severity.Info" Class="mb-4" Dense="true" Icon="@Icons.Material.Filled.Construction">
    이 화면은 W11 차수 백엔드 신설 후 활성화됩니다. 현재는 W5 bo_users DDL만 가도되었고, 직원 CRUD·4-eyes 결재 인프라는 미신설입니다.
</MudAlert>

<MudPaper Class="pa-6" Elevation="1" Style="border-radius:12px;text-align:center;">
    <MudIcon Icon="@Icons.Material.Filled.GroupAdd" Style="font-size:48px;color:#9CA3AF;" Class="mb-3" />
    <MudText Typo="Typo.h6" Class="mb-2">본사 직원 관리 준비 중</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
        W11 신설 항목:
    </MudText>
    <MudList T="string" Dense="true" Class="d-inline-block" Style="text-align:left;">
        <MudListItem T="string" Icon="@Icons.Material.Filled.RadioButtonUnchecked">
            <code>bo_users</code> CRUD API (역할: owner / platform_manager / platform_staff)
        </MudListItem>
        <MudListItem T="string" Icon="@Icons.Material.Filled.RadioButtonUnchecked">
            4-eyes 결재 인프라 (권한 변경·회수 시 2인 승인)
        </MudListItem>
        <MudListItem T="string" Icon="@Icons.Material.Filled.RadioButtonUnchecked">
            감사로그 (모든 권한 변경 박제)
        </MudListItem>
        <MudListItem T="string" Icon="@Icons.Material.Filled.RadioButtonUnchecked">
            MFA 활성/비활성 + 임시 비밀번호 발급·재설정
        </MudListItem>
    </MudList>

    <div Class="mt-4">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.VpnKey"
                   OnClick='() => Nav.NavigateTo("/owner/permissions")'>
            권한 관리 (작동)
        </MudButton>
    </div>
</MudPaper>
