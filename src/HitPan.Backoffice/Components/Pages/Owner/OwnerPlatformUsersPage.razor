@*
    WS-20260601-18 본사 백오피스 — Owner 전용 본사 직원 사용자 관리 (8명제 #2)
    이식: 2026-06-04 (HitPan.Web → HitPan.Backoffice, 헌법 #35 3시스템 분리)
    절대 원칙:
      - OwnerOnly (사장님 본인만, role=owner 클레임 필수)
      - 권한 부여·변경·회수 모두 4-eyes 결재 트리거
      - Razor에 C# raw string 금지 (헌법 #14)
      - 빈 catch 금지 (헌법 #15)
*@

@page "/owner/users"
@layout PlatformLayout
@attribute [Authorize(Policy = "OwnerOnly")]
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@using HitPan.Backoffice.Components.Common

<PageTitle>본사 직원 관리 — 히트판 백오피스 (Owner)</PageTitle>

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
    <div>
        <MudText Typo="Typo.h5" Style="font-weight:600;">본사 직원 관리</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Owner 전용 — Manager·Staff 권한 부여·변경·회수 (4-eyes 결재 트리거)
        </MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="OpenAddAsync">
        직원 추가
    </MudButton>
</div>

<MudAlert Severity="Severity.Warning" Class="mb-3" Dense="true" Icon="@Icons.Material.Filled.Shield">
    🔒 권한 변경은 4-eyes 결재 후 적용됩니다. 모든 변경은 감사로그·이메일 통보로 박제됩니다.
</MudAlert>

<MudPaper Elevation="1" Style="border-radius:12px;overflow:hidden;">
    <MudDataGrid T="PlatformUserRow" Items="_users" Loading="_loading"
                 Hover="true" Dense="true" SortMode="SortMode.Single">
        <Columns>
            <PropertyColumn Property="x => x.LoginId" Title="로그인 ID" />
            <PropertyColumn Property="x => x.DisplayName" Title="표시명" />
            <TemplateColumn Title="역할">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Color="@RoleColor(context.Item.Role)">
                        @RoleLabel(context.Item.Role)
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="MFA">
                <CellTemplate>
                    @if (context.Item.MfaEnabled)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success">활성</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error">비활성</MudChip>
                    }
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.LastLoginAt" Title="최근 로그인" Format="yyyy-MM-dd HH:mm" />
            <TemplateColumn Title="상태">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Color="@(context.Item.Active ? Color.Success : Color.Default)">
                        @(context.Item.Active ? "활성" : "비활성")
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="액션">
                <CellTemplate>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                               OnClick="@(() => OpenChangeRoleAsync(context.Item))">
                        권한 변경
                    </MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                               OnClick="@(() => OpenRevokeAsync(context.Item))" Class="ml-2">
                        권한 회수
                    </MudButton>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            <MudText Align="Align.Center" Class="pa-6" Color="Color.Secondary">
                등록된 본사 직원이 없습니다.
            </MudText>
        </NoRecordsContent>
    </MudDataGrid>
</MudPaper>

@code {
    private List<PlatformUserRow> _users = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            await Task.Yield();
            _users = new List<PlatformUserRow>();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"직원 목록 조회 실패: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenAddAsync()
    {
        var ok = await ConfirmDialog.ShowAsync(Dialog, "직원 추가",
            "새 본사 직원 추가는 4-eyes 결재 절차로 진행됩니다. 계속하시겠습니까?",
            confirmText: "결재 진행", cancelText: "취소", severity: Severity.Info);
        if (ok)
        {
            Snackbar.Add("직원 추가 결재 대기열로 이동", Severity.Info);
        }
    }

    private async Task OpenChangeRoleAsync(PlatformUserRow row)
    {
        var ok = await ConfirmDialog.ShowAsync(Dialog, "권한 변경",
            $"{row.LoginId} 권한 변경은 4-eyes 결재로 진행됩니다.",
            confirmText: "결재 진행", cancelText: "취소", severity: Severity.Warning);
        if (ok)
        {
            Snackbar.Add("권한 변경 결재 대기열로 이동", Severity.Info);
        }
    }

    private async Task OpenRevokeAsync(PlatformUserRow row)
    {
        var ok = await ConfirmDialog.ShowAsync(Dialog, "권한 회수",
            $"{row.LoginId} 권한 회수는 즉시 4-eyes 결재로 진행되며 즉시 로그아웃됩니다.",
            confirmText: "회수 진행", cancelText: "취소", severity: Severity.Error);
        if (ok)
        {
            Snackbar.Add("권한 회수 결재 대기열로 이동", Severity.Warning);
        }
    }

    private string RoleLabel(string r) => r switch
    {
        "owner" => "Owner",
        "platform_manager" => "Manager",
        "platform_staff" => "Staff",
        _ => r
    };

    private Color RoleColor(string r) => r switch
    {
        "owner" => Color.Error,
        "platform_manager" => Color.Warning,
        "platform_staff" => Color.Info,
        _ => Color.Default
    };

    public class PlatformUserRow
    {
        public string LoginId { get; set; } = "";
        public string DisplayName { get; set; } = "";
        public string Role { get; set; } = "platform_staff";
        public bool MfaEnabled { get; set; }
        public DateTime? LastLoginAt { get; set; }
        public bool Active { get; set; } = true;
    }
}
