@page "/owner/credentials-status"
@layout PlatformLayout
@attribute [Authorize(Policy = "OwnerOnly")]
@rendermode InteractiveServer
@inject IHttpClientFactory HttpFactory
@inject ISnackbar Snackbar

@*
    자격증명 박제 상태 + 테스트 메일 (사장님 결재 2026-06-04, 헌법 #29)
    OwnerOnly. 비밀값은 절대 화면에 표시되지 않음 (마스킹 또는 박제됨/미박제 라벨만).
*@

<PageTitle>자격증명 상태 — 히트판 백오피스 (Owner)</PageTitle>

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
    <div>
        <MudText Typo="Typo.h5" Style="font-weight:600;">자격증명 박제 상태</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            사장님 전용 (Owner) — 외부 API·SMTP·암호 Pepper 박제 여부를 점검합니다. 비밀값은 화면에 표시되지 않습니다.
        </MudText>
    </div>
</div>

<MudAlert Severity="Severity.Warning" Class="mb-3" Dense="true" Icon="@Icons.Material.Filled.Shield">
    🔒 자격증명 박제는 환경변수 또는 appsettings.Production.json에서만 (헌법 #29). 코드 박제 금지.
</MudAlert>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    @foreach (var category in _items.GroupBy(x => x.Category))
    {
        <MudPaper Elevation="1" Class="pa-4 mb-3" Style="border-radius:12px;">
            <MudText Typo="Typo.h6" Class="mb-3" Style="color:#0F6E56;">@category.Key</MudText>

            @foreach (var item in category)
            {
                <MudPaper Elevation="0" Class="pa-3 mb-2" Style="border:1px solid #EAEDF0;border-radius:10px;">
                    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;">
                        <div style="flex:1;">
                            <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px;">
                                <MudText Typo="Typo.subtitle2" Style="font-weight:700;">@item.Name</MudText>
                                @if (item.Configured)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success">박제됨</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">미박제</MudChip>
                                }
                            </div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-1">@item.Detail</MudText>
                            <MudText Typo="Typo.body2" Style="color:#6B7280;">@item.Impact</MudText>
                        </div>
                    </div>
                </MudPaper>
            }
        </MudPaper>
    }

    <MudPaper Elevation="1" Class="pa-4 mb-3" Style="border-radius:12px;">
        <MudText Typo="Typo.h6" Class="mb-3" Style="color:#0F6E56;">SMTP 테스트 메일</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            아래 이메일로 테스트 메일을 발송합니다. 도착 여부로 SMTP 박제 작동을 확인하세요.
        </MudText>
        <div style="display:flex;gap:8px;align-items:flex-start;">
            <MudTextField @bind-Value="_testTo" Label="수신 이메일" Variant="Variant.Outlined" Margin="Margin.Dense" Style="flex:1;" />
            <MudButton OnClick="SendTestMailAsync" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Send" Disabled="@_sending" Class="mt-1">
                @(_sending ? "송부 중..." : "테스트 메일 송부")
            </MudButton>
        </div>
    </MudPaper>
}

@code {
    private List<CredentialItem> _items = new();
    private bool _loading = true;
    private bool _sending;
    private string _testTo = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var http = HttpFactory.CreateClient("backoffice-authed");
            var res = await http.GetFromJsonAsync<ListResponse>("api/backoffice/credentials/status");
            _items = res?.Items ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"자격증명 상태 조회 실패: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SendTestMailAsync()
    {
        if (string.IsNullOrWhiteSpace(_testTo))
        {
            Snackbar.Add("수신 이메일을 입력해주세요.", Severity.Warning);
            return;
        }
        _sending = true;
        try
        {
            var http = HttpFactory.CreateClient("backoffice-authed");
            var res = await http.PostAsJsonAsync("api/backoffice/credentials/test-mail", new { To = _testTo });
            var payload = await res.Content.ReadFromJsonAsync<TestResponse>();
            if (payload?.Success == true)
            {
                Snackbar.Add(payload.Message ?? "테스트 메일이 발송되었습니다.", Severity.Success);
            }
            else
            {
                Snackbar.Add(payload?.Message ?? "테스트 메일 송부 실패", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"테스트 메일 오류: {ex.Message}", Severity.Error);
        }
        finally
        {
            _sending = false;
        }
    }

    public class CredentialItem
    {
        public string Key { get; set; } = "";
        public string Name { get; set; } = "";
        public string Category { get; set; } = "";
        public bool Configured { get; set; }
        public string? Detail { get; set; }
        public string? Impact { get; set; }
    }

    private class ListResponse
    {
        public bool Success { get; set; }
        public List<CredentialItem> Items { get; set; } = new();
    }

    private class TestResponse
    {
        public bool Success { get; set; }
        public string? Message { get; set; }
    }
}
