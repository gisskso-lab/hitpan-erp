@*
    WS-20260601-17 대리점 RLS CS 티켓 목록 + 신규 등록 (8명제 #6·#7)
    작성일: 2026-06-01 / 작성팀: 프론트 매니저 + 백엔드 매니저
    절대 원칙:
      - ResellerSelfOnly (JWT role=reseller + reseller_serial 필수)
      - 다른 대리점 고객사 시리얼로 CS 작성 시도 = 서버 403 + reseller_audit_log 박제
      - 평문 사업자번호·상호·대표자 노출 0
      - Razor 에 C# raw string 금지 (헌법 #14)
      - 빈 catch 금지 (헌법 #15)
      - 라우트 충돌 회피: 본 페이지는 /reseller/v2/cs (기존 페이지 없음, 신규)
*@

@page "/reseller/v2/cs"
@layout ResellerLayout
@attribute [Authorize]
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>내 영업 CS 티켓 — 히트판</PageTitle>

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
    <div>
        <MudText Typo="Typo.h5" Style="font-weight:600;">내 영업 CS 티켓</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            자기 영업 고객사 한정 (다른 대리점 0)
        </MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreate">새 티켓</MudButton>
</div>

<MudPaper Class="pa-3 mb-3" Elevation="0" Style="border-radius:12px;background:#f7f8fa;">
    <MudGrid Spacing="2">
        <MudItem xs="6" md="3">
            <MudSelect T="string" @bind-Value="_statusFilter" Label="상태"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="@("all")">전체</MudSelectItem>
                <MudSelectItem Value="@("open")">처리중</MudSelectItem>
                <MudSelectItem Value="@("pending")">대기</MudSelectItem>
                <MudSelectItem Value="@("closed")">완료</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="6" md="2">
            <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync">조회</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Elevation="1" Style="border-radius:12px;overflow:hidden;">
    <MudDataGrid T="TicketRow" Items="_rows" Loading="_loading" Hover="true" Dense="true">
        <Columns>
            <PropertyColumn Property="x => x.TicketNo" Title="티켓번호" />
            <PropertyColumn Property="x => x.TargetSerial" Title="대상 시리얼" />
            <TemplateColumn Title="우선순위">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Color="@PriColor(context.Item.Priority)">
                        @context.Item.Priority.ToUpper()
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.Subject" Title="제목" />
            <TemplateColumn Title="상태">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Item.Status)">
                        @context.Item.Status
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.OpenedAt" Title="접수" Format="yyyy-MM-dd HH:mm" />
        </Columns>
        <PagerContent>
            <MudDataGridPager T="TicketRow" />
        </PagerContent>
        <NoRecordsContent>
            <MudText Align="Align.Center" Class="pa-6" Color="Color.Secondary">
                CS 티켓이 없습니다.
            </MudText>
        </NoRecordsContent>
    </MudDataGrid>
</MudPaper>

<MudDialog @bind-Visible="_dlgOpen" Options="@(new DialogOptions{ MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">새 CS 티켓</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_form.TargetSerial" Label="대상 시리얼 (HP-...)"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" />
        <MudSelect T="string" @bind-Value="_form.Priority" Label="우선순위"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3">
            <MudSelectItem Value="@("p0")">P0 (긴급)</MudSelectItem>
            <MudSelectItem Value="@("p1")">P1 (높음)</MudSelectItem>
            <MudSelectItem Value="@("p2")">P2 (보통)</MudSelectItem>
        </MudSelect>
        <MudTextField @bind-Value="_form.Subject" Label="제목"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3" Required="true" />
        <MudTextField @bind-Value="_form.Body" Label="상세"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3"
                      Lines="5" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _dlgOpen = false)">취소</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync">등록</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<TicketRow> _rows = new();
    private bool _loading = true;
    private string _statusFilter = "all";

    private bool _dlgOpen;
    private CreateForm _form = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private void OpenCreate()
    {
        _form = new CreateForm();
        _dlgOpen = true;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var qs = $"api/reseller/v2/cs/tickets?page=1&size=50";
            if (!string.IsNullOrWhiteSpace(_statusFilter) && _statusFilter != "all")
            {
                qs += $"&status={Uri.EscapeDataString(_statusFilter)}";
            }
            var resp = await Http.GetFromJsonAsync<Envelope<List<TicketRow>>>(qs);
            _rows = resp?.data ?? new List<TicketRow>();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"CS 티켓 조회 실패: {ex.Message}", Severity.Error);
            _rows = new List<TicketRow>();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.TargetSerial) || string.IsNullOrWhiteSpace(_form.Subject))
        {
            Snackbar.Add("대상 시리얼과 제목은 필수입니다", Severity.Warning);
            return;
        }
        try
        {
            var http = await Http.PostAsJsonAsync("api/reseller/v2/cs/tickets", _form);
            if (http.IsSuccessStatusCode)
            {
                Snackbar.Add("CS 티켓이 등록되었습니다", Severity.Success);
                _dlgOpen = false;
                await LoadAsync();
            }
            else if ((int)http.StatusCode == 403)
            {
                Snackbar.Add("권한 없음 — 자기 영업 고객사 시리얼만 가능합니다", Severity.Error);
            }
            else
            {
                Snackbar.Add($"등록 실패 (HTTP {(int)http.StatusCode})", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"등록 실패: {ex.Message}", Severity.Error);
        }
    }

    private Color StatusColor(string s) => s switch
    {
        "open" => Color.Warning,
        "pending" => Color.Info,
        "closed" => Color.Success,
        _ => Color.Default
    };

    private Color PriColor(string p) => p switch
    {
        "p0" => Color.Error,
        "p1" => Color.Warning,
        "p2" => Color.Info,
        _ => Color.Default
    };

    public class Envelope<T>
    {
        public bool success { get; set; }
        public T? data { get; set; }
    }

    public class TicketRow
    {
        public long TicketId { get; set; }
        public string TicketNo { get; set; } = "";
        public string TargetSerial { get; set; } = "";
        public string Priority { get; set; } = "p2";
        public string Subject { get; set; } = "";
        public string Status { get; set; } = "open";
        public DateTime OpenedAt { get; set; }
    }

    public class CreateForm
    {
        public string TargetSerial { get; set; } = "";
        public string Priority { get; set; } = "p2";
        public string Subject { get; set; } = "";
        public string? Body { get; set; }
    }
}
