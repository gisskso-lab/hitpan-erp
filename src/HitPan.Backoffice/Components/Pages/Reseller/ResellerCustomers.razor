@page "/reseller/customers"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IHttpClientFactory HttpFactory
@inject ISnackbar Snackbar

@*
    W18 대리점 본인 고객사 조회 (사장님 결재 2026-06-05)
    백오피스 API /api/reseller-portal/customers (행 수준 권한)
    헌법 #18·#22 평문 0 (사업자번호·CEO명·주소·전화 0건 노출)
*@

<PageTitle>내 고객사 — 히트판 대리점</PageTitle>

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
    <div>
        <MudText Typo="Typo.h5" Style="font-weight:600;">내 고객사</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            본인 고객사만 노출 (행 수준 권한, 평문 사업자번호 0건)
        </MudText>
    </div>
    <MudButton OnClick="LoadAsync" StartIcon="@Icons.Material.Filled.Refresh">새로고침</MudButton>
</div>

<MudButtonGroup Variant="Variant.Outlined" Class="mb-3">
    <MudButton OnClick="@(() => SetStatus("all"))" Color="@(_status == "all" ? Color.Primary : Color.Default)">전체</MudButton>
    <MudButton OnClick="@(() => SetStatus("active"))" Color="@(_status == "active" ? Color.Primary : Color.Default)">활성</MudButton>
    <MudButton OnClick="@(() => SetStatus("pending"))" Color="@(_status == "pending" ? Color.Primary : Color.Default)">대기</MudButton>
    <MudButton OnClick="@(() => SetStatus("trial"))" Color="@(_status == "trial" ? Color.Primary : Color.Default)">체험</MudButton>
</MudButtonGroup>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_items.Count == 0)
{
    <MudPaper Elevation="0" Class="pa-8" Style="border-radius:12px;background:#F9FAFB;text-align:center;">
        <MudText Color="Color.Secondary">조건에 맞는 고객사가 없습니다.</MudText>
    </MudPaper>
}
else
{
    <MudPaper Elevation="1" Style="border-radius:12px;overflow:hidden;">
        <MudDataGrid T="CustomerRow" Items="_items" Hover="true" Dense="true">
            <Columns>
                <PropertyColumn Property="x => x.TenantCode" Title="코드" />
                <PropertyColumn Property="x => x.CompanyName" Title="회사명" />
                <PropertyColumn Property="x => x.SubscriptionTier" Title="플랜" />
                <TemplateColumn Title="상태">
                    <CellTemplate>
                        @{
                            var color = context.Item.Status switch
                            {
                                "active" => Color.Success,
                                "trial" => Color.Info,
                                "pending" => Color.Warning,
                                "suspended" => Color.Error,
                                _ => Color.Default
                            };
                        }
                        <MudChip T="string" Color="color" Size="Size.Small">@context.Item.Status</MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="체험 만료">
                    <CellTemplate>@(context.Item.TrialEndsAt?.ToString("yyyy-MM-dd") ?? "—")</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="가입일">
                    <CellTemplate>@context.Item.CreatedAt.ToString("yyyy-MM-dd")</CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    </MudPaper>
}

@code {
    private bool _loading = true;
    private string _status = "all";
    private List<CustomerRow> _items = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task SetStatus(string s)
    {
        _status = s;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var http = HttpFactory.CreateClient("backoffice-authed");
            var url = "api/reseller-portal/customers" + (_status != "all" ? $"?status={_status}" : "");
            var res = await http.GetFromJsonAsync<ListResponse>(url);
            _items = res?.Items ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"목록 조회 실패: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private class ListResponse
    {
        public bool Success { get; set; }
        public List<CustomerRow> Items { get; set; } = new();
    }

    public class CustomerRow
    {
        public string TenantId { get; set; } = "";
        public string TenantCode { get; set; } = "";
        public string CompanyName { get; set; } = "";
        public string SubscriptionTier { get; set; } = "";
        public string Status { get; set; } = "";
        public DateTime? TrialEndsAt { get; set; }
        public DateTime CreatedAt { get; set; }
    }
}
