@*
    WS-20260601-17 대리점 RLS 대시보드 (8명제 #6·#7)
    작성일: 2026-06-01 / 작성팀: 프론트 매니저 + 백엔드 매니저
    절대 원칙:
      - ResellerSelfOnly (JWT role=reseller + reseller_serial 필수)
      - 평문 사업자번호·상호·대표자 0 — 시리얼·결제 상태·구독 등급·갱신예정일만
      - Razor 에 C# raw string 금지 (헌법 #14)
      - 빈 catch 금지 (헌법 #15)
      - 라우트 충돌 회피: 기존 /reseller/dashboard 보존, 본 페이지는 /reseller/v2/dashboard
*@

@page "/reseller/v2/dashboard"
@layout ResellerLayout
@attribute [Authorize]
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>영업 실적 대시보드 — 히트판</PageTitle>

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
    <div>
        <MudText Typo="Typo.h5" Style="font-weight:600;">영업 실적 대시보드</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            자기 영업 고객사 메타 (평문 사업자정보 0)
        </MudText>
    </div>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh"
               OnClick="LoadAsync">새로고침</MudButton>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else if (_stats is not null)
{
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="1" Style="border-radius:12px;">
                <MudText Typo="Typo.body2" Color="Color.Secondary">담당 고객사</MudText>
                <MudText Typo="Typo.h4" Style="font-weight:700;">@_stats.TenantCount</MudText>
                <MudText Typo="Typo.caption" Color="Color.Success">활성 @_stats.ActiveCount</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="1" Style="border-radius:12px;">
                <MudText Typo="Typo.body2" Color="Color.Secondary">갱신 예정 (30일)</MudText>
                <MudText Typo="Typo.h4" Style="font-weight:700;">@_stats.ExpiringSoonCount</MudText>
                <MudText Typo="Typo.caption" Color="Color.Warning">접촉 필요</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="1" Style="border-radius:12px;">
                <MudText Typo="Typo.body2" Color="Color.Secondary">이상징후</MudText>
                <MudText Typo="Typo.h4" Style="font-weight:700;">@_stats.AnomalyCount</MudText>
                <MudText Typo="Typo.caption" Color="Color.Error">미납·정지</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="1" Style="border-radius:12px;">
                <MudText Typo="Typo.body2" Color="Color.Secondary">월 예상 수수료</MudText>
                <MudText Typo="Typo.h4" Style="font-weight:700;">@_stats.MonthlyCommissionEstimate.ToString("N0")원</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Class="pa-4" Elevation="1" Style="border-radius:12px;">
        <MudText Typo="Typo.h6" Class="mb-3" Style="font-weight:600;">갱신 예정 고객사 (시리얼만)</MudText>
        <MudDataGrid T="ExpiringMeta" Items="_stats.ExpiringTenants" Dense="true" Hover="true">
            <Columns>
                <PropertyColumn Property="x => x.Serial" Title="시리얼" />
                <PropertyColumn Property="x => x.SubscriptionTier" Title="구독" />
                <PropertyColumn Property="x => x.ExpiresAt" Title="만료일" Format="yyyy-MM-dd" />
                <PropertyColumn Property="x => x.DaysLeft" Title="남은 일수" />
            </Columns>
            <NoRecordsContent>
                <MudText Align="Align.Center" Class="pa-4" Color="Color.Secondary">
                    갱신 예정 고객사가 없습니다.
                </MudText>
            </NoRecordsContent>
        </MudDataGrid>
    </MudPaper>
}

@code {
    private bool _loading = true;
    private StatsResponse? _stats;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var resp = await Http.GetFromJsonAsync<Envelope<StatsResponse>>("api/reseller/v2/sales-stats");
            if (resp?.success == true && resp.data is not null)
            {
                _stats = resp.data;
            }
            else
            {
                _stats = new StatsResponse();
                Snackbar.Add("실적 데이터를 불러오지 못했습니다", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            // 빈 catch 금지 (헌법 #15) — Snackbar 저장
            Snackbar.Add($"대시보드 조회 실패: {ex.Message}", Severity.Error);
            _stats = new StatsResponse();
        }
        finally
        {
            _loading = false;
        }
    }

    public class Envelope<T>
    {
        public bool success { get; set; }
        public T? data { get; set; }
    }

    public class StatsResponse
    {
        public int TenantCount { get; set; }
        public int ActiveCount { get; set; }
        public int ExpiringSoonCount { get; set; }
        public int AnomalyCount { get; set; }
        public decimal MonthlyCommissionEstimate { get; set; }
        public List<ExpiringMeta> ExpiringTenants { get; set; } = new();
    }

    public class ExpiringMeta
    {
        public string Serial { get; set; } = "";
        public DateTime? ExpiresAt { get; set; }
        public int DaysLeft { get; set; }
        public string? SubscriptionTier { get; set; }
    }
}
