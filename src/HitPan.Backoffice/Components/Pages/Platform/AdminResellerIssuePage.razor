@*
    WS-20260601-13 본사 백오피스 — 대리점 시리얼 발급 화면 (HR- prefix, 8명제 #6)
    작성일: 2026-06-01 / 작성팀: 프론트 매니저 + 수석 웹디자이너
    절대 원칙:
      - 대리점 발급은 owner 결재 + 운영팀 2인 (3-eyes)
      - 평문 사업자번호 화면 노출 금지 (마스킹)
      - Razor에 C# raw string 금지 (헌법 #14)
*@

@page "/admin/resellers/issue"
@layout PlatformLayout
@attribute [Authorize]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService Dialog

<PageTitle>대리점 발급 — 히트판 백오피스</PageTitle>

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
    <div>
        <MudText Typo="Typo.h5" Style="font-weight:600;">대리점 시리얼 발급 (HR-)</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            8명제 #6 본사 발급 + owner 결재 + 운영팀 2인 (3-eyes)
        </MudText>
    </div>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh"
               OnClick="LoadPendingAsync">새로고침</MudButton>
</div>

<MudAlert Severity="Severity.Warning" Class="mb-3" Dense="true">
    ⚠️ 대리점 발급은 owner 권한 필수 + 운영팀 2인 결재 필수. 평문 사업자번호는 화면에서 마스킹 처리됩니다.
</MudAlert>

<MudPaper Elevation="1" Style="border-radius:12px;overflow:hidden;">
    <MudDataGrid T="PendingResellerRow" Items="_pending" Loading="_loading"
                 Hover="true" Dense="true" SortMode="SortMode.Single">
        <Columns>
            <PropertyColumn Property="x => x.BizNoMasked" Title="사업자번호 (마스킹)" />
            <PropertyColumn Property="x => x.NameMasked" Title="대리점명 (마스킹)" />
            <PropertyColumn Property="x => x.ResellerType" Title="유형" />
            <PropertyColumn Property="x => x.CommissionRate" Title="수수료율 %" Format="F2" />
            <PropertyColumn Property="x => x.RequestedAt" Title="신청일" Format="yyyy-MM-dd HH:mm" />
            <TemplateColumn Title="발급">
                <CellTemplate>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               OnClick="@(() => OpenIssueDialog(context.Item))">
                        3-eyes 발급
                    </MudButton>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            <MudText Align="Align.Center" Class="pa-6" Color="Color.Secondary">
                발급 대기 중인 대리점이 없습니다.
            </MudText>
        </NoRecordsContent>
    </MudDataGrid>
</MudPaper>

@code {
    private List<PendingResellerRow> _pending = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadPendingAsync();
    }

    private async Task LoadPendingAsync()
    {
        _loading = true;
        try
        {
            await Task.Yield();
            _pending = new List<PendingResellerRow>();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"대기 목록 조회 실패: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenIssueDialog(PendingResellerRow row)
    {
        var parameters = new DialogParameters
        {
            ["Row"] = row,
            ["Kind"] = "reseller"
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await Dialog.ShowAsync<IssueFourEyesDialog>("3-eyes 대리점 발급", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            Snackbar.Add("대리점 발급 완료 — 이메일·SMS 2채널 전송됨", Severity.Success);
            await LoadPendingAsync();
        }
    }

    public class PendingResellerRow
    {
        public string BizNoMasked { get; set; } = "";
        public string NameMasked { get; set; } = "";
        public string ResellerType { get; set; } = "individual";
        public decimal CommissionRate { get; set; }
        public DateTime RequestedAt { get; set; }
        public string BizNoHash { get; set; } = "";
        public string EmailHash { get; set; } = "";
        public string ContractId { get; set; } = "";
    }
}
