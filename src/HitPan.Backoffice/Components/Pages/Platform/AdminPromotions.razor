@page "/admin/promotions"
@layout PlatformLayout
@attribute [Authorize]
@rendermode InteractiveServer
@inject IHttpClientFactory HttpFactory
@inject ISnackbar Snackbar
@inject IDialogService Dialog

@*
    W17 프로모션 관리 (사장님 결재 2026-06-05)
    백오피스 API /api/backoffice/promotions
    생성 · 토글 · 사용 이력 조회
*@

<PageTitle>프로모션 관리 — 히트판 백오피스</PageTitle>

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
    <div>
        <MudText Typo="Typo.h5" Style="font-weight:600;">프로모션 관리</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            쿠폰·할인 코드 · 사용 이력 (헌법 #3 INSERT ONLY, 사용 차감 자동)
        </MudText>
    </div>
    <MudButton OnClick="OpenCreateDialog" Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Campaign">프로모션 생성</MudButton>
</div>

<MudButtonGroup Variant="Variant.Outlined" Class="mb-3">
    <MudButton OnClick="@(() => SetStatus("all"))" Color="@(_status == "all" ? Color.Primary : Color.Default)">전체</MudButton>
    <MudButton OnClick="@(() => SetStatus("active"))" Color="@(_status == "active" ? Color.Primary : Color.Default)">활성</MudButton>
    <MudButton OnClick="@(() => SetStatus("inactive"))" Color="@(_status == "inactive" ? Color.Primary : Color.Default)">비활성</MudButton>
    <MudButton OnClick="@(() => SetStatus("expired"))" Color="@(_status == "expired" ? Color.Primary : Color.Default)">만료</MudButton>
</MudButtonGroup>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_items.Count == 0)
{
    <MudPaper Elevation="0" Class="pa-8" Style="border-radius:12px;background:#F9FAFB;text-align:center;">
        <MudText Color="Color.Secondary">조건에 맞는 프로모션이 없습니다.</MudText>
    </MudPaper>
}
else
{
    <MudPaper Elevation="1" Style="border-radius:12px;overflow:hidden;">
        <MudDataGrid T="PromotionRow" Items="_items" Hover="true" Dense="true">
            <Columns>
                <PropertyColumn Property="x => x.PromoCode" Title="코드" />
                <PropertyColumn Property="x => x.Title" Title="제목" />
                <TemplateColumn Title="할인">
                    <CellTemplate>
                        @(context.Item.DiscountType == "percent"
                            ? $"{context.Item.DiscountValue}%"
                            : $"{context.Item.DiscountValue:N0}원")
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="기간">
                    <CellTemplate>
                        @context.Item.StartsAt.ToString("yyyy-MM-dd") ~ @context.Item.EndsAt.ToString("yyyy-MM-dd")
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="사용/한도">
                    <CellTemplate>
                        @context.Item.UseCount / @(context.Item.MaxUses == 0 ? "∞" : context.Item.MaxUses.ToString())
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.TargetPlan" Title="플랜" />
                <TemplateColumn Title="상태">
                    <CellTemplate>
                        @{
                            var color = context.Item.Status switch
                            {
                                "active" => Color.Success,
                                "inactive" => Color.Default,
                                "expired" => Color.Error,
                                _ => Color.Default
                            };
                        }
                        <MudChip T="string" Color="color" Size="Size.Small">@context.Item.Status</MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="액션">
                    <CellTemplate>
                        @if (context.Item.Status == "active")
                        {
                            <MudButton OnClick="@(() => ToggleAsync(context.Item, "inactive"))"
                                       Size="Size.Small" Color="Color.Warning">비활성화</MudButton>
                        }
                        else if (context.Item.Status == "inactive")
                        {
                            <MudButton OnClick="@(() => ToggleAsync(context.Item, "active"))"
                                       Size="Size.Small" Color="Color.Success">활성화</MudButton>
                        }
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    </MudPaper>
}

@code {
    private bool _loading = true;
    private string _status = "all";
    private List<PromotionRow> _items = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task SetStatus(string s)
    {
        _status = s;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var http = HttpFactory.CreateClient("backoffice-authed");
            var url = "api/backoffice/promotions" + (_status != "all" ? $"?status={_status}" : "");
            var res = await http.GetFromJsonAsync<ListResponse>(url);
            _items = res?.Items ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"목록 조회 실패: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenCreateDialog()
    {
        var dialog = await Dialog.ShowAsync<PromotionCreateDialog>("프로모션 생성",
            new DialogParameters(), new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadAsync();
        }
    }

    private async Task ToggleAsync(PromotionRow row, string newStatus)
    {
        var ok = await ConfirmDialog.ShowAsync(Dialog,
            "상태 변경",
            $"{row.PromoCode} 상태를 {newStatus}로 변경하시겠습니까?",
            confirmText: "변경", severity: Severity.Warning);
        if (!ok) return;

        try
        {
            var http = HttpFactory.CreateClient("backoffice-authed");
            var res = await http.PostAsJsonAsync($"api/backoffice/promotions/{row.PromotionId}/toggle",
                new { Status = newStatus });
            var payload = await res.Content.ReadFromJsonAsync<ActionResponse>();
            if (res.IsSuccessStatusCode && payload?.Success == true)
            {
                Snackbar.Add(payload.Message ?? "변경됐습니다.", Severity.Success);
                await LoadAsync();
            }
            else
            {
                Snackbar.Add(payload?.Message ?? "변경 실패", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"처리 중 오류: {ex.Message}", Severity.Error);
        }
    }

    private class ListResponse
    {
        public bool Success { get; set; }
        public List<PromotionRow> Items { get; set; } = new();
    }

    private class ActionResponse
    {
        public bool Success { get; set; }
        public string? Message { get; set; }
    }

    public class PromotionRow
    {
        public long PromotionId { get; set; }
        public string PromoCode { get; set; } = "";
        public string Title { get; set; } = "";
        public string DiscountType { get; set; } = "";
        public decimal DiscountValue { get; set; }
        public DateTime StartsAt { get; set; }
        public DateTime EndsAt { get; set; }
        public int MaxUses { get; set; }
        public int UseCount { get; set; }
        public string? TargetPlan { get; set; }
        public string Status { get; set; } = "";
        public DateTime CreatedAt { get; set; }
    }
}
