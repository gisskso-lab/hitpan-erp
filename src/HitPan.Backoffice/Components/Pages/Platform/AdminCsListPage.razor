@*
    작14 B-8 — CS 창구 결선 (사장님 결재 2026-10-08) · 원형 = WS-20260601-18 껍데기
    - 본사 전권(F-14 2차·전체 조회) · PlatformOnlyV2
    - 한 화면 완결: 목록 + 선택 티켓의 본문·답·상태를 같은 화면에서 (히트판 정신)
    - 답 작성 = 반자동 ②겹의 문: 쓴 사람이 승인자(approved_by NOT NULL) · 발송은 ERP 5분 Pull
    - 상태 전이는 서버 1곳(api/admin/cs/{id}/status) — 화면은 부르기만 한다
    - Razor 에 C# raw string 금지(#14) · 빈 catch 금지(#15)
*@

@page "/admin/cs"
@layout PlatformLayout
@attribute [Authorize(Policy = "PlatformOnlyV2")]
@using System.Net.Http.Json
@inject IHttpClientFactory HttpFactory
@inject ISnackbar Snackbar
@inject HitPan.Backoffice.Services.CsCountsService Counts
@using HitPan.Backoffice.Components.Pages.Platform.Components

<PageTitle>CS 창구 — 히트판 백오피스</PageTitle>

<BoPageHeader Title="CS 창구"
              Subtitle="고객사 ERP 쪽지·전화 접수 — 답은 고객 ERP 화면으로 전달됩니다">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Call"
                   OnClick="@(() => _phoneOpen = !_phoneOpen)">전화 접수</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="LoadAsync">새로고침</MudButton>
    </Actions>
</BoPageHeader>

@* ── C-2 전화 접수 30초 틀 — 통화하면서 채울 수 있게 칸이 4개뿐이다 ── *@
@if (_phoneOpen)
{
    <MudPaper Elevation="0" Class="pa-4 mb-4" Style="border:1px solid var(--mud-palette-lines-default);border-radius:12px">
        <MudText Typo="Typo.h6" Class="mb-1">전화 접수</MudText>
        <MudText Typo="Typo.caption" Style="color:#6B7280" Class="mb-3 d-block">
            통화 중에 채우는 틀입니다 — 고객사·분류·업무 영역·들은 말 네 칸이면 접수됩니다.
            주민번호·카드·계좌 같은 숫자는 적지 마세요(저장이 거부됩니다).
        </MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="3">
                <MudTextField @bind-Value="_phoneTenantCode" Label="고객사 코드" Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudSelect T="string" @bind-Value="_phoneCategory" Label="분류(8종)" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var c in Categories)
                    {
                        <MudSelectItem Value="@c.Key">@c.Value</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudSelect T="string" @bind-Value="_phoneSubTag" Label="업무 영역" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var s in SubTags)
                    {
                        <MudSelectItem Value="@s.Key">@s.Value</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="3" Class="d-flex align-center">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_phoneSaving"
                           OnClick="SavePhoneAsync">@(_phoneSaving ? "접수 중…" : "접수")</MudButton>
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" @bind-Value="_phoneBody" Label="들은 말 그대로" Variant="Variant.Outlined"
                              Lines="3" MaxLength="2000" Counter="2000" />
            </MudItem>
        </MudGrid>
    </MudPaper>
}

<BoFilterBar>
    <MudTextField @bind-Value="_keyword" Label="검색 (회사명·고객사코드)" Variant="Variant.Outlined"
                  Margin="Margin.Dense" Immediate="true" OnKeyUp="OnSearchKey" />
    <MudSelect T="string" @bind-Value="_statusFilter" Label="상태" Variant="Variant.Outlined" Margin="Margin.Dense">
        <MudSelectItem Value="@("all")">전체</MudSelectItem>
        <MudSelectItem Value="@("접수")">접수</MudSelectItem>
        <MudSelectItem Value="@("처리중")">처리중</MudSelectItem>
        <MudSelectItem Value="@("보류")">보류</MudSelectItem>
        <MudSelectItem Value="@("고객답대기")">고객 답 대기</MudSelectItem>
        <MudSelectItem Value="@("완료")">완료</MudSelectItem>
    </MudSelect>
    @* 사장님 지시 2026-10-08 — 진행 4단계 *@
    <MudSelect T="string" @bind-Value="_stageFilter" Label="진행 단계" Variant="Variant.Outlined" Margin="Margin.Dense">
        <MudSelectItem Value="@("all")">전체</MudSelectItem>
        <MudSelectItem Value="@("unread")">① 읽지 않음</MudSelectItem>
        <MudSelectItem Value="@("open")">② 처리되지 않음</MudSelectItem>
        <MudSelectItem Value="@("done")">③ 처리 완료</MudSelectItem>
        <MudSelectItem Value="@("rated")">④ CS평가 완료</MudSelectItem>
    </MudSelect>
    <MudSwitch T="bool" @bind-Value="_mineOnly" Label="내 응대함만" Color="Color.Primary" />
    <div class="bo-filter-bar__action">
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Search" OnClick="LoadAsync">조회</MudButton>
    </div>
</BoFilterBar>

<div class="bo-list-section">
    <div class="bo-list-section__head">
        <span class="bo-list-section__title">CS 창구 목록</span>
        <span class="bo-list-section__count">총 <strong>@_rows.Count.ToString("N0")</strong>건</span>
    </div>

    @if (!_loading && _rows.Count == 0)
    {
        <div style="padding:32px 24px;">
            <BoEmptyStateCard Title="접수된 CS 창구이 없습니다"
                              Description="고객사 ERP 의 「CS 요청」 쪽지나 전화 접수가 이곳에 표시됩니다."
                              IllustrationKind="doc" />
        </div>
    }
    else
    {
        <MudDataGrid T="CsTicketRow" Items="_rows" Loading="_loading"
                     Hover="true" Dense="true" SortMode="SortMode.Single"
                     RowClick="@(e => SelectAsync(e.Item))">
            <Columns>
                <PropertyColumn Property="x => x.CompanyName" Title="고객사" />
                <TemplateColumn Title="분류">
                    <CellTemplate>
                        <span>@CategoryLabel(context.Item.Category)</span>
                        <MudText Typo="Typo.caption" Style="color:#6B7280">@ShapeLabel(context.Item.ShapeTag)</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="접수 경로">
                    <CellTemplate>
                        <span>@(context.Item.Channel == "erp_message" ? "쪽지" : "전화")</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="상태">
                    <CellTemplate>
                        <span class="bo-status-chip @StatusChipClass(context.Item.Status)">@context.Item.Status</span>
                        @if (context.Item.ReadAt is null)
                        {
                            <span class="bo-status-chip bo-status-chip--suspended" style="margin-left:4px">안 읽음</span>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="응대">
                    <CellTemplate>
                        <span>@HandledViaLabel(context.Item.HandledVia)</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="평가">
                    <CellTemplate>
                        <span>@RatingLabel(context.Item.Rating)</span>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.ReceivedAt" Title="접수" Format="MM-dd HH:mm" />
                <PropertyColumn Property="x => x.ReplyCount" Title="답" />
            </Columns>
            <PagerContent>
                <MudDataGridPager T="CsTicketRow" />
            </PagerContent>
        </MudDataGrid>
    }
</div>

@if (_detail is not null)
{
    <MudPaper Elevation="0" Class="pa-4 mt-4" Style="border:1px solid var(--mud-palette-lines-default);border-radius:12px">
        <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-2">
            <MudText Typo="Typo.h6">@_detail.CompanyName — @CategoryLabel(_detail.Category)</MudText>
            <div class="d-flex align-center gap-2">
                <MudSelect T="string" @bind-Value="_newStatus" Label="상태" Dense="true" Variant="Variant.Outlined"
                           Style="min-width:140px">
                    <MudSelectItem Value="@("접수")">접수</MudSelectItem>
                    <MudSelectItem Value="@("처리중")">처리중</MudSelectItem>
                    <MudSelectItem Value="@("보류")">보류</MudSelectItem>
                    <MudSelectItem Value="@("고객답대기")">고객 답 대기</MudSelectItem>
                    <MudSelectItem Value="@("완료")">완료</MudSelectItem>
                </MudSelect>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ChangeStatusAsync">상태 변경</MudButton>
            </div>
        </div>

        @* ── C-1 분류 다시 고르기 · C-2 배정·약속 시계 — 한 줄에 모아 둔다 ── *@
        <div class="d-flex align-center flex-wrap gap-2 mb-3">
            <MudSelect T="string" @bind-Value="_newCategory" Label="분류(8종)" Dense="true"
                       Variant="Variant.Outlined" Style="min-width:150px">
                @foreach (var c in Categories)
                {
                    <MudSelectItem Value="@c.Key">@c.Value</MudSelectItem>
                }
            </MudSelect>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ChangeCategoryAsync">분류 저장</MudButton>

            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.AssignmentInd"
                       OnClick="AssignToMeAsync">내가 맡기</MudButton>
            <MudText Typo="Typo.caption" Style="color:#6B7280">
                담당 @(string.IsNullOrEmpty(_detail.HandlerType) ? "미배정" : _detail.HandlerType)
            </MudText>

            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Schedule"
                       OnClick="SetPromiseAsync">답 약속 (@(PromiseHours)시간)</MudButton>
            <MudText Typo="Typo.caption" Style="color:#6B7280">@PromiseText(_detail.PromisedAt)</MudText>

            @* 사장님 지시 2026-10-08 — 응대 유형 3종. 완료로 넘기려면 이 칸이 채워져 있어야 한다 *@
            <MudSelect T="string" @bind-Value="_newHandledVia" Label="응대 유형" Dense="true"
                       Variant="Variant.Outlined" Style="min-width:150px">
                @foreach (var v in HandledVias)
                {
                    <MudSelectItem Value="@v.Key">@v.Value</MudSelectItem>
                }
            </MudSelect>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="SetHandledViaAsync">응대 저장</MudButton>

            @if (_detail.Status == "완료")
            {
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.MenuBook"
                           OnClick="PromoteDraftAsync">백과사전 초안</MudButton>
            }
        </div>
        <MudText Typo="Typo.caption" Style="color:#6B7280" Class="mb-2 d-block">
            @(_detail.Channel == "erp_message" ? "쪽지" : "전화") · @ShapeLabel(_detail.ShapeTag) · 화면 @(_detail.ScreenCode ?? "-") · 판 @(_detail.ErpVersion ?? "-") · @_detail.ReceivedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
        </MudText>
        <MudPaper Elevation="0" Class="pa-3 mb-3" Style="background:var(--mud-palette-background-gray);border-radius:8px">
            <MudText Typo="Typo.body1" Style="white-space:pre-wrap">@(string.IsNullOrEmpty(_detail.Body) ? "(본문 없음 — 태그만 접수)" : _detail.Body)</MudText>
        </MudPaper>

        @foreach (var r in _replies)
        {
            <MudPaper Elevation="0" Class="pa-3 mb-2" Style="border:1px solid var(--mud-palette-lines-default);border-radius:8px">
                <div class="d-flex align-center justify-space-between mb-1">
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">본사 답</MudChip>
                    <MudText Typo="Typo.caption" Style="color:#6B7280">
                        @r.ApprovedAt.ToLocalTime().ToString("MM-dd HH:mm") · @(r.DeliveredAt is null ? "전달 대기(5분 주기)" : "전달됨")
                    </MudText>
                </div>
                <MudText Typo="Typo.body2" Style="white-space:pre-wrap">@r.Body</MudText>
            </MudPaper>
        }

        <MudTextField T="string" @bind-Value="_replyBody" Label="답 쓰기" Variant="Variant.Outlined"
                      Lines="4" MaxLength="4000" Counter="4000" Class="mt-2"
                      HelperText="저장하는 사람이 승인자입니다 — 저장 즉시 고객 ERP 가 5분 주기로 가져갑니다" />
        <div class="d-flex justify-end mt-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_sendingReply" OnClick="SendReplyAsync">
                @(_sendingReply ? "저장 중…" : "답 저장 (승인)")
            </MudButton>
        </div>

        @* ── C-3·C-4 백과사전 승격 — 초안은 회사·담당자 칸을 애초에 가져오지 않는다 ── *@
        @if (_draft is not null)
        {
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.h6" Class="mb-1">백과사전 초안</MudText>
            <MudText Typo="Typo.caption" Style="color:#6B7280" Class="mb-3 d-block">
                회사 이름·담당자·연락처는 이 초안에 <b>들어오지 않습니다</b>(가져오지 않은 값은 잊을 수도 없습니다).
                제목과 해결 순서를 적고 승인하면 그때 등재됩니다 — 승인 없이는 행이 생기지 않습니다.
                @if (_draftQuoteOmitted)
                {
                    <span style="color:#B45309"> · 본문에 식별정보 모양이 있어 인용을 생략했습니다.</span>
                }
            </MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="4">
                    <MudSelect T="string" @bind-Value="_draftCategory" Label="분류(8종)" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var c in Categories)
                        {
                            <MudSelectItem Value="@c.Key">@c.Value</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="8">
                    <MudTextField @bind-Value="_draftTitle" Label="제목 (증상 한 줄)" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" MaxLength="200" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" @bind-Value="_draft" Label="문제점 / 해결점" Variant="Variant.Outlined"
                                  Lines="14" MaxLength="8000" Counter="8000" />
                </MudItem>
            </MudGrid>
            <div class="d-flex justify-end gap-2 mt-2">
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => SaveDocAsync("초안"))">초안 저장</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           Disabled="_savingDoc" OnClick="@(() => SaveDocAsync("승인"))">
                    @(_savingDoc ? "등재 중…" : "승인 등재")
                </MudButton>
            </div>
        }
    </MudPaper>
}

@code {
    private List<CsTicketRow> _rows = new();
    private bool _loading = true;
    private string _keyword = "";
    private string _statusFilter = "all";

    private CsTicketDetail? _detail;
    private List<ReplyRow> _replies = new();
    private string? _replyBody;
    private string _newStatus = "접수";
    private bool _sendingReply;

    // ── C-1·C-2·C-3 추가분 ──
    private bool _mineOnly;
    private string _newCategory = "etc";

    // ── 사장님 지시 2026-10-08 — 진행 4단계 · 응대 유형 3종 ──
    private string _stageFilter = "all";
    private string _newHandledVia = "message";

    private static readonly List<KeyValuePair<string, string>> HandledVias = new()
    {
        new("message", "쪽지로 응대"), new("phone", "전화로 응대"), new("remote", "원격지원"),
    };

    private static string HandledViaLabel(string? v) => v switch
    {
        "message" => "쪽지", "phone" => "전화", "remote" => "원격지원", _ => "-",
    };

    private static string RatingLabel(int? r) => r switch
    {
        3 => "좋아요", 2 => "보통", 1 => "아쉬워요", _ => "-",
    };

    private bool _phoneOpen;
    private bool _phoneSaving;
    private string _phoneTenantCode = "";
    private string _phoneCategory = "use";
    private string _phoneSubTag = "etc";
    private string? _phoneBody;

    private string? _draft;                 // 백과사전 초안 본문(md) — null = 초안 칸 닫힘
    private string _draftTitle = "";
    private string _draftCategory = "etc";
    private bool _draftQuoteOmitted;
    private bool _savingDoc;

    // 답 약속 기준값 — 🔴 정본은 9.설정 몫. 화면은 같은 숫자를 보여 주기만 한다(서버가 계산한다).
    private const int PromiseHours = 24;

    // 8종 정본(결-9) — 콤보의 단일 출처
    private static readonly List<KeyValuePair<string, string>> Categories = new()
    {
        new("use", "사용"), new("set", "설정"), new("net", "통신"), new("dat", "데이터"),
        new("upd", "업데이트"), new("bug", "기능오류"), new("ins", "설치"), new("etc", "기타"),
    };

    // 업무 영역 — 자유입력 불가(쟁점-3) · 서버 화이트리스트와 같은 목록
    private static readonly List<KeyValuePair<string, string>> SubTags = new()
    {
        new("estimate_sales", "견적·수주·판매"), new("purchase_order", "발주·매입"),
        new("stock", "재고·창고"), new("invoice", "계산서·명세서"),
        new("accounting", "회계·경비"), new("hr_payroll", "사원·급여"),
        new("settings_perm", "설정·권한"), new("etc", "기타"),
    };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var http = HttpFactory.CreateClient("backoffice-authed");
            var res = await http.GetFromJsonAsync<ListResponse>(
                $"api/admin/cs?status={Uri.EscapeDataString(_statusFilter)}&q={Uri.EscapeDataString(_keyword)}&mine={(_mineOnly ? "true" : "false")}&stage={Uri.EscapeDataString(_stageFilter)}");
            _rows = res?.Data ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"CS 창구 조회 실패: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SelectAsync(CsTicketRow row)
    {
        try
        {
            var http = HttpFactory.CreateClient("backoffice-authed");
            var res = await http.GetFromJsonAsync<DetailResponse>($"api/admin/cs/{row.Id}");
            _detail = res?.Ticket;
            _replies = res?.Replies ?? new();
            _newStatus = _detail?.Status ?? "접수";
            _newCategory = string.IsNullOrEmpty(_detail?.Category) ? "etc" : _detail!.Category;
            _newHandledVia = string.IsNullOrEmpty(_detail?.HandledVia) ? "message" : _detail!.HandledVia!;
            _replyBody = null;
            _draft = null;                  // 다른 티켓을 열면 초안 칸은 닫는다(섞이면 사고다)
            // 상세를 여는 순간 서버가 「읽음」을 박는다 ⇒ 아래 띠·사이드바 숫자를 바로 다시 센다
            await Counts.RefreshAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"티켓을 열지 못했습니다: {ex.Message}", Severity.Error);
        }
    }

    private async Task SendReplyAsync()
    {
        if (_detail is null || string.IsNullOrWhiteSpace(_replyBody)) return;
        _sendingReply = true;
        try
        {
            var http = HttpFactory.CreateClient("backoffice-authed");
            var res = await http.PostAsJsonAsync($"api/admin/cs/{_detail.Id}/reply", new { body = _replyBody });
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add("답을 저장했습니다. 고객 ERP 가 5분 주기로 가져갑니다.", Severity.Success);
                await SelectAsync(new CsTicketRow { Id = _detail.Id });
            }
            else
            {
                var err = await res.Content.ReadFromJsonAsync<ApiMessage>();
                Snackbar.Add(err?.Message ?? "답을 저장하지 못했습니다.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"답을 저장하지 못했습니다: {ex.Message}", Severity.Error);
        }
        finally
        {
            _sendingReply = false;
        }
    }

    private async Task ChangeStatusAsync()
