@*
    작14 B-8 — CS 창구 결선 (사장님 결재 2026-10-08) · 원형 = WS-20260601-18 껍데기
    - 본사 전권(F-14 2차·전체 조회) · PlatformOnlyV2
    - 한 화면 완결: 목록 + 선택 티켓의 본문·답·상태를 같은 화면에서 (히트판 정신)
    - 답 작성 = 반자동 ②겹의 문: 쓴 사람이 승인자(approved_by NOT NULL) · 발송은 ERP 5분 Pull
    - 상태 전이는 서버 1곳(api/admin/cs/{id}/status) — 화면은 부르기만 한다
    - Razor 에 C# raw string 금지(#14) · 빈 catch 금지(#15)

    🔴 20261013작1 갈래② — 간판 「고객A/S창구」 + **좌우 2단**으로 재배치 (설계 §3-0·§3-1)
      · 세로로 쌓던 것을 좌우로 나눈다 — 고른 행과 상세가 **같은 눈높이**다(스크롤 왕복 0)
      · 입력은 다이얼로그로(설계 R1) — 상단 토글 패널 2개를 걷어내 **필터·목록이 첫 화면 안**에 들어온다
          ⓐ `＋ A/S 접수` → `CsManualIntakeDialog`   ⓑ 「처리기록 등재」 → `KbDraftDialog`
          ⓒ 🔴 「쪽지 보내기」(선발신·보관기한·폐기 후보·「지금 준비하기」)는 **갈래③ 의 새 화면**
             `/admin/cs/notice` 로 옮겨 간다 — 여기서는 자리만 비운다(기능을 없애는 것이 아니다)
      · 상세는 `Components/CsTicketDetailPanel.razor` 로 분리 · 단추 묶음은 접힌 「처리」 안으로
      · 칼럼 8→6 — 「응대」는 상세 「처리」로, 「평가」는 상태 칸의 ★ 표식으로 **옮겼다**(정보 손실 0)
      · 분류 8종·접수경로 낱말은 `CsVocab` 한 벌(갈래①) — 복제를 걷어냈다
      · 🔴 하단 띠가 보내는 `?stage=` 를 **이 화면이 받는다**(사장님 결재) — 받는 쪽만 고친다
*@

@page "/admin/cs"
@layout PlatformLayout
@attribute [Authorize(Policy = "PlatformOnlyV2")]
@using System.Net.Http.Json
@inject IHttpClientFactory HttpFactory
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@inject HitPan.Backoffice.Services.CsCountsService Counts
@using HitPan.Backoffice.Components.Pages.Platform.Components

<PageTitle>고객A/S창구 — 히트판 백오피스</PageTitle>

<BoPageHeader Title="고객A/S창구"
              Subtitle="고객사에서 온 A/S — 답은 고객사 ERP 화면으로 전달됩니다">
    <Actions>
        @* 🔴 단추 하나로 모았다 — 오프라인으로 받은 A/S(전화·이메일·SNS·기타)를 같은 자리에 적어 넣는다 *@
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenIntakeDialogAsync">＋ A/S 접수</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="LoadAsync">새로고침</MudButton>
    </Actions>
</BoPageHeader>

<BoFilterBar>
    <MudTextField @bind-Value="_keyword" Label="검색 (회사명·고객사코드)" Variant="Variant.Outlined"
                  Margin="Margin.Dense" Immediate="true" OnKeyUp="OnSearchKey" />
    <MudSelect T="string" @bind-Value="_statusFilter" Label="상태" Variant="Variant.Outlined" Margin="Margin.Dense">
        <MudSelectItem Value="@("all")">전체</MudSelectItem>
        <MudSelectItem Value="@("접수")">접수</MudSelectItem>
        <MudSelectItem Value="@("처리중")">처리중</MudSelectItem>
        <MudSelectItem Value="@("보류")">보류</MudSelectItem>
        <MudSelectItem Value="@("고객답대기")">고객 답 대기</MudSelectItem>
        <MudSelectItem Value="@("완료")">완료</MudSelectItem>
    </MudSelect>
    @* 사장님 지시 2026-10-08 — 진행 4단계 · 하단 띠의 숫자를 누르면 그 단계만 보인다 *@
    <MudSelect T="string" @bind-Value="_stageFilter" Label="진행 단계" Variant="Variant.Outlined" Margin="Margin.Dense">
        <MudSelectItem Value="@("all")">전체</MudSelectItem>
        <MudSelectItem Value="@("unread")">① 읽지 않음</MudSelectItem>
        <MudSelectItem Value="@("open")">② 처리되지 않음</MudSelectItem>
        <MudSelectItem Value="@("done")">③ 처리 완료</MudSelectItem>
        <MudSelectItem Value="@("rated")">④ CS평가 완료</MudSelectItem>
    </MudSelect>
    <MudSwitch T="bool" @bind-Value="_mineOnly" Label="내 응대함만" Color="Color.Primary" />
    <div class="bo-filter-bar__action">
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Search" OnClick="LoadAsync">조회</MudButton>
    </div>
</BoFilterBar>

@* ── 좌우 2단(설계 R2) — 넓을 때 목록 7 / 상세 5 · 좁을 때 1단(상세가 목록 아래) ── *@
<MudGrid Spacing="3">
    <MudItem xs="12" md="7">
        <div class="bo-list-section">
            <div class="bo-list-section__head">
                <span class="bo-list-section__title">고객A/S 목록</span>
                @* 🔴 설계 R4 — 서버가 300건으로 끊어 준다. 끊긴 목록을 「총」이라 적으면 거짓말이다 *@
                <span class="bo-list-section__count">@CountLabel <strong>@_rows.Count.ToString("N0")</strong>건</span>
            </div>

            @if (!_loading && _rows.Count == 0)
            {
                <div style="padding:32px 24px;">
                    <BoEmptyStateCard Title="접수된 A/S 가 없습니다"
                                      Description="고객사 ERP 의 「CS 요청」 쪽지와, 직접 적어 넣은 A/S 가 이곳에 모입니다."
                                      IllustrationKind="doc" />
                </div>
            }
            else
            {
                <MudDataGrid T="CsTicketRow" Items="_rows" Loading="_loading"
                             Hover="true" Dense="true" SortMode="SortMode.Single"
                             RowClick="@(e => SelectAsync(e.Item))">
                    <Columns>
                        <PropertyColumn Property="x => x.CompanyName" Title="고객사" />
                        <TemplateColumn Title="분류">
                            <CellTemplate>
                                <span>@CsVocab.CategoryLabel(context.Item.Category)</span>
                                <MudText Typo="Typo.caption" Style="color:#6B7280">@ShapeLabel(context.Item.ShapeTag)</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        @* 🔴 「고객사 ERP 로 안 간다」를 아는 자리 ②/3 — 「고객사 쪽지」와 전화·이메일·SNS·기타가
                           한눈에 갈린다. 오늘까지 이 칸은 `erp_message` 가 아니면 **전부 「전화」**로 찍었다. *@
                        <TemplateColumn Title="접수 경로">
                            <CellTemplate>
                                <span>@CsVocab.ChannelLabel(context.Item.Channel)</span>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="상태">
                            <CellTemplate>
                                <span class="bo-status-chip @StatusChipClass(context.Item.Status)">@context.Item.Status</span>
                                @if (context.Item.ReadAt is null)
                                {
                                    <span class="bo-status-chip bo-status-chip--suspended" style="margin-left:4px">안 읽음</span>
                                }
                                @* 🔴 옛 「평가」 칼럼이 내려온 자리 — 고객이 매긴 뒤에만 값이 생긴다(상시 `-` 칼럼을 없앤다) *@
                                @if (context.Item.Rating is not null)
                                {
                                    <span class="bo-status-chip bo-status-chip--active" style="margin-left:4px">★ @RatingLabel(context.Item.Rating)</span>
                                }
                            </CellTemplate>
                        </TemplateColumn>
                        <PropertyColumn Property="x => x.ReceivedAt" Title="접수" Format="MM-dd HH:mm" />
                        <PropertyColumn Property="x => x.ReplyCount" Title="답" />
                    </Columns>
                    <PagerContent>
                        <MudDataGridPager T="CsTicketRow" />
                    </PagerContent>
                </MudDataGrid>
            }
        </div>
    </MudItem>

    <MudItem xs="12" md="5">
        @if (_detail is not null)
        {
            <CsTicketDetailPanel Detail="_detail" Replies="_replies"
                                 NewStatus="_newStatus" NewStatusChanged="@(v => _newStatus = v)"
                                 NewCategory="_newCategory" NewCategoryChanged="@(v => _newCategory = v)"
                                 NewHandledVia="_newHandledVia" NewHandledViaChanged="@(v => _newHandledVia = v)"
                                 ReplyBody="_replyBody" ReplyBodyChanged="@(v => _replyBody = v)"
                                 SendingReply="_sendingReply"
                                 PurgeArmed="@(_purgeTargetId == _detail.Id)"
                                 PurgeReason="_purgeReason" PurgeReasonChanged="@(v => _purgeReason = v)"
                                 PromiseHours="PromiseHours"
                                 OnClose="CloseDetail"
                                 OnSendReply="SendReplyAsync"
                                 OnChangeStatus="ChangeStatusAsync"
                                 OnChangeCategory="ChangeCategoryAsync"
                                 OnSetHandledVia="SetHandledViaAsync"
                                 OnAssignToMe="AssignToMeAsync"
                                 OnSetPromise="SetPromiseAsync"
                                 OnPromoteDraft="OpenDraftDialogAsync"
                                 OnArmPurge="ArmPurge"
                                 OnCancelPurge="CancelPurge"
                                 OnConfirmPurge="PurgeTicketAsync" />
        }
        else
        {
            <MudPaper Elevation="0" Class="pa-4" Style="border:1px solid var(--mud-palette-lines-default);border-radius:12px">
                <MudText Typo="Typo.subtitle2" Class="mb-1">A/S 하나를 골라 주세요</MudText>
                <MudText Typo="Typo.body2" Style="color:#6B7280">
                    왼쪽 목록에서 줄을 누르면 고객이 보낸 말과 지금까지의 답이 이 자리에 보입니다.
                    답을 쓰고 상태를 바꾸는 것도 이 자리에서 끝납니다.
                </MudText>
            </MudPaper>
        }
    </MudItem>
</MudGrid>

@code {
    private List<CsTicketRow> _rows = new();
    private bool _loading = true;
    private string _keyword = "";
    private string _statusFilter = "all";

    private CsTicketDetail? _detail;
    private List<ReplyRow> _replies = new();
    private string? _replyBody;
    private string _newStatus = "접수";
    private bool _sendingReply;

    // ── C-1·C-2·C-3 추가분 ──
    private bool _mineOnly;
    private string _newCategory = "etc";

    // ── 사장님 지시 2026-10-08 — 진행 4단계 · 응대 유형 3종 ──
    private string _stageFilter = "all";
    private string _newHandledVia = "message";

    private long? _purgeTargetId;
    private string _purgeReason = "";

    // 답 약속 기준값 — 🔴 정본은 9.설정 몫. 화면은 같은 숫자를 보여 주기만 한다(서버가 계산한다).
    private const int PromiseHours = 24;

    /// <summary>서버 `LIMIT 300` 에 닿았으면 「총」이라고 말하지 않는다(설계 R4 · 거짓말 금지).</summary>
    private const int ServerListLimit = 300;

    private string CountLabel => _rows.Count >= ServerListLimit ? "최근" : "총";

    // ══════════════════════════════════════════════════════════════════════
    // 🔴 20261013작1 갈래② — 하단 띠가 보내는 `?stage=` 를 **받는다** (사장님 결재)
    //
    //   사고: `CsStatusBar.razor:57` 이 `/admin/cs?stage=unread` 로 보내는데 이 화면이
    //   쿼리를 **한 번도 안 읽었다**(`SupplyParameterFromQuery` 0건) ⇒ 숫자를 눌러도 전체 목록이었다.
    //   🔴 띠·`CsStatusBar`·counts 서버식은 무접촉이다 — **받는 쪽만** 고친다.
    //   목록 밖 값·빈 값은 지금처럼 전체(`all`)로 떨어뜨린다(모르는 값을 아는 척하지 않는다).
    // ══════════════════════════════════════════════════════════════════════

    [SupplyParameterFromQuery(Name = "stage")]
    public string? StageFromQuery { get; set; }

    /// <summary>마지막으로 반영한 쿼리값 — 사람이 콤보로 고른 단계를 쿼리가 덮어쓰지 않게 한다.</summary>
    private string? _appliedStageQuery;

    private bool _firstLoadDone;

    private static readonly string[] KnownStages = { "unread", "open", "done", "rated" };

    private static string NormalizeStage(string? raw)
    {
        var v = (raw ?? "").Trim();
        return Array.IndexOf(KnownStages, v) >= 0 ? v : "all";
    }

    protected override async Task OnParametersSetAsync()
    {
        var incoming = NormalizeStage(StageFromQuery);
        if (_firstLoadDone && string.Equals(incoming, _appliedStageQuery, StringComparison.Ordinal))
        {
            return;   // 쿼리가 안 바뀌었다 — 사람이 콤보로 고른 값을 그대로 둔다
        }
        _appliedStageQuery = incoming;
        _stageFilter = incoming;
        _firstLoadDone = true;
        await LoadAsync();
    }

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var http = HttpFactory.CreateClient("backoffice-authed");
            var res = await http.GetFromJsonAsync<ListResponse>(
                $"api/admin/cs?status={Uri.EscapeDataString(_statusFilter)}&q={Uri.EscapeDataString(_keyword)}&mine={(_mineOnly ? "true" : "false")}&stage={Uri.EscapeDataString(_stageFilter)}");
            _rows = res?.Data ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"A/S 목록을 불러오지 못했습니다 — 잠시 뒤 「조회」를 다시 눌러 주세요. ({ex.Message})", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    // ══════════════════════════════════════════════════════════════════════
    // 입력은 다이얼로그(설계 R1) — 집안 관례 `AdminPromotions.razor:138` 과 같은 모양
    // ══════════════════════════════════════════════════════════════════════

    private async Task OpenIntakeDialogAsync()
    {
        var dialog = await Dialog.ShowAsync<CsManualIntakeDialog>("A/S 접수 (전화·이메일·SNS 로 받은 것)",
            new DialogParameters(), new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadAsync();
            // 하단 띠·사이드바 숫자가 함께 움직인다(오늘 거동)
            await Counts.RefreshAsync();
            Snackbar.Add("A/S 로 접수했습니다 — 목록 맨 위에 있습니다.", Severity.Success);
        }
    }

    /// <summary>「처리기록 등재」 — 오늘 상세 맨 아래로 쌓이던 초안 블록을 다이얼로그로 옮겼다(기능 그대로).</summary>
    private async Task OpenDraftDialogAsync()
    {
        if (_detail is null) return;
        var dialog = await Dialog.ShowAsync<KbDraftDialog>("처리기록 등재",
            new DialogParameters<KbDraftDialog> { { x => x.TicketId, _detail.Id } },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        await dialog.Result;
    }

    private void CloseDetail()
    {
        _detail = null;
        _replies = new();
        _replyBody = null;
        _purgeTargetId = null;
        _purgeReason = "";
    }

    private void ArmPurge()
    {
        _purgeTargetId = _detail?.Id;
        _purgeReason = "";
    }

    private void CancelPurge() => _purgeTargetId = null;

    private async Task SelectAsync(CsTicketRow row)
    {
        try
        {
            var http = HttpFactory.CreateClient("backoffice-authed");
            var res = await http.GetFromJsonAsync<DetailResponse>($"api/admin/cs/{row.Id}");
            _detail = res?.Ticket;
            _replies = res?.Replies ?? new();
            _newStatus = _detail?.Status ?? "접수";
            _newCategory = string.IsNullOrEmpty(_detail?.Category) ? "etc" : _detail!.Category;
            _newHandledVia = string.IsNullOrEmpty(_detail?.HandledVia) ? "message" : _detail!.HandledVia!;
            _replyBody = null;
            // 상세를 여는 순간 서버가 「읽음」을 박는다 ⇒ 아래 띠·사이드바 숫자를 바로 다시 센다
            await Counts.RefreshAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"A/S 를 열지 못했습니다: {ex.Message}", Severity.Error);
        }
    }

    private async Task SendReplyAsync()
    {
        if (_detail is null || string.IsNullOrWhiteSpace(_replyBody)) return;
        _sendingReply = true;
        try
        {
            var http = HttpFactory.CreateClient("backoffice-authed");
            var res = await http.PostAsJsonAsync($"api/admin/cs/{_detail.Id}/reply", new { body = _replyBody });
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add("답을 저장했습니다. 고객 ERP 가 5분 주기로 가져갑니다.", Severity.Success);
                await SelectAsync(new CsTicketRow { Id = _detail.Id });
            }
            else
            {
                var err = await res.Content.ReadFromJsonAsync<ApiMessage>();
                Snackbar.Add(err?.Message ?? "답을 저장하지 못했습니다 — 적은 글은 그대로 있습니다. 다시 눌러 주세요.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"답을 저장하지 못했습니다 — 적은 글은 그대로 있습니다. 다시 눌러 주세요. ({ex.Message})", Severity.Error);
        }
        finally
        {
            _sendingReply = false;
        }
    }

    private async Task ChangeStatusAsync()
    {
        if (_detail is null) return;
        try
        {
            var http = HttpFactory.CreateClient("backoffice-authed");
            var res = await http.PostAsJsonAsync($"api/admin/cs/{_detail.Id}/status", new { to = _newStatus });
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add("상태를 바꿨습니다.", Severity.Success);
                await LoadAsync();
                await SelectAsync(new CsTicketRow { Id = _detail.Id });
            }
            else
            {
                var err = await res.Content.ReadFromJsonAsync<ApiMessage>();
                Snackbar.Add(err?.Message ?? "상태를 바꾸지 못했습니다.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"상태를 바꾸지 못했습니다: {ex.Message}", Severity.Error);
        }
    }

    // ── C-1 분류 다시 고르기 ──
    private async Task ChangeCategoryAsync()
    {
        if (_detail is null) return;
        await PostAsync($"api/admin/cs/{_detail.Id}/category", new { to = _newCategory }, "분류를 바꿨습니다.");
    }

    // ── 응대 유형 저장 ──
    private async Task SetHandledViaAsync()
    {
        if (_detail is null) return;
        await PostAsync($"api/admin/cs/{_detail.Id}/handled-via", new { via = _newHandledVia }, "응대 유형을 저장했습니다.");
    }

    // ── C-2 배정(내 응대함) ──
    private async Task AssignToMeAsync()
    {
        if (_detail is null) return;
        await PostAsync($"api/admin/cs/{_detail.Id}/assign", new { handlerType = "본사2차" }, "제 응대함으로 가져왔습니다.");
    }

    // ── C-2 답 약속 시계 — 서버가 기준 시간으로 제안값을 넣는다(사람이 다시 눌러 갱신 가능) ──
    private async Task SetPromiseAsync()
    {
        if (_detail is null) return;
        await PostAsync($"api/admin/cs/{_detail.Id}/promise", new { }, "답 약속 시각을 넣었습니다.");
    }

    private async Task PostAsync(string url, object payload, string okMessage)
    {
        try
        {
            var http = HttpFactory.CreateClient("backoffice-authed");
            var res = await http.PostAsJsonAsync(url, payload);
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add(okMessage, Severity.Success);
                var id = _detail!.Id;
                await LoadAsync();
                await SelectAsync(new CsTicketRow { Id = id });
                await Counts.RefreshAsync();   // 단계가 바뀌었으면 아래 띠 숫자도 같이 움직인다
            }
            else
            {
                var err = await res.Content.ReadFromJsonAsync<ApiMessage>();
                Snackbar.Add(err?.Message ?? "바꾸지 못했습니다.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"바꾸지 못했습니다: {ex.Message}", Severity.Error);
        }
    }

    // 🔴 20261011작2 C-13 — 임의 폐기(사장님 오더). 사유를 적어야 눌린다.
    //    내용은 지워지고 「언제 누가 왜 지웠나」는 감사기록에 남는다.
    private async Task PurgeTicketAsync()
    {
        if (_purgeTargetId is null) return;
        if (string.IsNullOrWhiteSpace(_purgeReason))
        {
            Snackbar.Add("폐기 사유를 적어 주세요 — 기록으로 남습니다.", Severity.Info);
            return;
        }
        try
        {
            var http = HttpFactory.CreateClient("backoffice-authed");
            var res = await http.PostAsJsonAsync($"api/admin/cs/{_purgeTargetId}/purge", new { reason = _purgeReason });
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add("폐기했습니다 — 내용은 지워졌고, 지웠다는 기록은 남습니다.", Severity.Success);
                _purgeTargetId = null;
                _purgeReason = "";
                _detail = null;
                await LoadAsync();
            }
            else
            {
                var err = await res.Content.ReadFromJsonAsync<ApiMessage>();
                Snackbar.Add(err?.Message ?? "폐기하지 못했습니다.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"폐기하지 못했습니다: {ex.Message}", Severity.Error);
        }
    }

    // 평가 — 고객이 매긴 뒤에만 값이 생긴다(상태 칸의 ★ 표식)
    private static string RatingLabel(int? r) => r switch
    {
        3 => "좋아요", 2 => "보통", 1 => "아쉬워요", _ => "-",
