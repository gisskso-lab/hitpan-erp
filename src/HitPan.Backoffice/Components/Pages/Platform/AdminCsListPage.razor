    private long? _purgeTargetId;
    private string _purgeReason = "";

    // 용도 — 사장님 오더의 세 가지 + 기타. 서버(AllowedOutboundPurpose)와 **같은 목록**이다.
    private static readonly List<KeyValuePair<string, string>> OutboundPurposes = new()
    {
