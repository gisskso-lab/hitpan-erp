    private async Task PostAsync(string url, object payload, string okMessage)
    {
        try
        {
            var http = HttpFactory.CreateClient("backoffice-authed");
            var res = await http.PostAsJsonAsync(url, payload);
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add(okMessage, Severity.Success);
                var id = _detail!.Id;
                await LoadAsync();
                await SelectAsync(new CsTicketRow { Id = id });
                await Counts.RefreshAsync();   // 단계가 바뀌었으면 아래 띠 숫자도 같이 움직인다
            }
            else
            {
                var err = await res.Content.ReadFromJsonAsync<ApiMessage>();
                Snackbar.Add(err?.Message ?? "바꾸지 못했습니다.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"바꾸지 못했습니다: {ex.Message}", Severity.Error);
        }
    }

    // ── C-2 전화 접수 ──
    private async Task SavePhoneAsync()
    {
        if (string.IsNullOrWhiteSpace(_phoneTenantCode) || string.IsNullOrWhiteSpace(_phoneBody))
        {
            Snackbar.Add("고객사 코드와 들은 말을 채워 주세요.", Severity.Info);
            return;
        }
        _phoneSaving = true;
        try
        {
            var http = HttpFactory.CreateClient("backoffice-authed");
            var res = await http.PostAsJsonAsync("api/admin/cs/phone", new
            {
                tenantCode = _phoneTenantCode.Trim(),
                category = _phoneCategory,
                subTag = _phoneSubTag,
                body = _phoneBody,
            });
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add("전화 접수를 저장했습니다.", Severity.Success);
                _phoneBody = null;
                _phoneOpen = false;
                await LoadAsync();
            }
            else
            {
                var err = await res.Content.ReadFromJsonAsync<ApiMessage>();
                Snackbar.Add(err?.Message ?? "접수하지 못했습니다.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"접수하지 못했습니다: {ex.Message}", Severity.Error);
        }
        finally
        {
            _phoneSaving = false;
        }
    }

    // ── C-3·C-4 백과사전 승격 초안 ──
    private async Task PromoteDraftAsync()
    {
        if (_detail is null) return;
        try
        {
            var http = HttpFactory.CreateClient("backoffice-authed");
            var res = await http.PostAsJsonAsync($"api/admin/kb/promote/{_detail.Id}", new { });
            if (res.IsSuccessStatusCode)
            {
                var body = await res.Content.ReadFromJsonAsync<PromoteResponse>();
                _draft = body?.Draft?.BodyMd ?? "";
                _draftCategory = string.IsNullOrEmpty(body?.Draft?.Category) ? "etc" : body!.Draft!.Category;
                _draftQuoteOmitted = body?.Draft?.QuoteOmitted ?? false;
                _draftTitle = "";
            }
            else
            {
                var err = await res.Content.ReadFromJsonAsync<ApiMessage>();
                Snackbar.Add(err?.Message ?? "초안을 만들지 못했습니다.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"초안을 만들지 못했습니다: {ex.Message}", Severity.Error);
        }
    }

    private async Task SaveDocAsync(string status)
    {
        if (_draft is null || _detail is null) return;
        if (string.IsNullOrWhiteSpace(_draftTitle))
        {
            Snackbar.Add("제목을 적어 주세요 — 증상 한 줄이면 됩니다.", Severity.Info);
            return;
        }
        _savingDoc = true;
        try
        {
            var http = HttpFactory.CreateClient("backoffice-authed");
            var res = await http.PostAsJsonAsync("api/admin/kb/docs", new
            {
                category = _draftCategory,
                title = _draftTitle.Trim(),
                bodyMd = _draft,
                status,
                sourceTicketId = _detail.Id,
            });
            if (res.IsSuccessStatusCode)
            {
                var ok = await res.Content.ReadFromJsonAsync<DocSaveResponse>();
                Snackbar.Add($"백과사전에 {status}으로 등재했습니다 — {ok?.IssueCode}", Severity.Success);
                _draft = null;
            }
            else
            {
                var err = await res.Content.ReadFromJsonAsync<ApiMessage>();
                Snackbar.Add(err?.Message ?? "등재하지 못했습니다.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"등재하지 못했습니다: {ex.Message}", Severity.Error);
        }
        finally
        {
            _savingDoc = false;
        }
    }

    private static string PromiseText(DateTime? at)
    {
        if (at is null) return "약속 없음";
        var local = at.Value.ToLocalTime();
        var left = local - DateTime.Now;
        if (left.TotalMinutes < 0) return $"{local:MM-dd HH:mm} · 지났습니다";
        return $"{local:MM-dd HH:mm} · {(int)left.TotalHours}시간 남음";
    }

