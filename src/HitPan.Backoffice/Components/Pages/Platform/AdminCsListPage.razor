    private string _phoneCategory = "use";
    private string _phoneSubTag = "etc";
    private string? _phoneBody;

    // ══════════════════════════════════════════════════════════════════════
    // 🔴 20261011작2 — 사장님 오더 2026-10-11
    //   A-2 고객사명 자동조회 · C-4 본사 선발신 쪽지 · C-6~C-13 보관기한·폐기
    // ══════════════════════════════════════════════════════════════════════

    public sealed class TenantPick
    {
