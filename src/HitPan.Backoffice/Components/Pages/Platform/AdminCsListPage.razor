    private void OnOutboundTenantPicked(TenantPick? pick)
    {
        _outPick = pick;
        _outTenantCode = pick?.TenantCode ?? "";
    }

    private async Task ToggleOutboundAsync()
    {
        _outboundOpen = !_outboundOpen;
        if (_outboundOpen)
        {
            await LoadOutboundAsync();
            await LoadRetentionAsync();
        }
    }

    // 🔴 작5 — 자료방이 아직 없나. 서버가 `schemaPending` 으로 말해 준다(작4 가 세운 표식).
    private bool _csSchemaPending;
    private bool _csSchemaPreparing;

    /// <summary>작5 — CS 자료방(45번)만 지금 준비한다. 사람이 눌러야 돈다(반자동).</summary>
    private async Task PrepareCsSchemaAsync()
    {
        _csSchemaPreparing = true;
        try
        {
            var http = HttpFactory.CreateClient("backoffice-authed");
            var res = await http.PostAsync("api/admin/cs/schema/prepare", null);
            var body = await res.Content.ReadFromJsonAsync<PrepareResponse>();

            // 🔴 「했다」가 아니라 「생겼다」를 본다 — 서버가 전후 표 개수를 세어 준다.
            if (res.IsSuccessStatusCode && body?.Ready == true)
            {
                Snackbar.Add(body.Message ?? "자료방을 준비했습니다.", Severity.Success);
                _csSchemaPending = false;
                await LoadOutboundAsync();
                await LoadRetentionAsync();
            }
            else
            {
                Snackbar.Add(body?.Message ?? "준비하지 못했습니다.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"준비하지 못했습니다: {ex.Message}", Severity.Error);
        }
        finally
        {
            _csSchemaPreparing = false;
        }
    }

    private async Task LoadOutboundAsync()
    {
        try
        {
            var http = HttpFactory.CreateClient("backoffice-authed");
            var res = await http.GetFromJsonAsync<OutboundListResponse>("api/admin/cs/outbound");
            _outbound = res?.Items ?? new();
            _outboundPending = _outbound.Count(o => o.DeliveredAt is null && o.CanceledAt is null);
            // 자료방이 없으면 서버가 빈 목록 + schemaPending 을 준다(작4 A-1).
            _csSchemaPending = res?.SchemaPending == true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"보낸 쪽지 조회 실패: {ex.Message}", Severity.Warning);
