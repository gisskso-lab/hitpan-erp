@page "/admin/reseller-settlements"
@layout PlatformLayout
@attribute [Authorize]
@rendermode InteractiveServer
@inject IHttpClientFactory HttpFactory
@inject ISnackbar Snackbar
@inject IDialogService Dialog

@*
    대리점 정산 (W9, 사장님 결재 2026-06-05)
    백오피스 API /api/backoffice/reseller-settlements
    월별 산출(draft) → 확정(confirmed) → 송금(paid) 흐름
*@

<PageTitle>대리점 정산 — 히트판 백오피스</PageTitle>

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
    <div>
        <MudText Typo="Typo.h5" Style="font-weight:600;">대리점 정산</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            월별 산출 · 확정 · 송금 (헌법 #3 — confirmed 후 UPDATE 금지)
        </MudText>
    </div>
    <div style="display:flex;gap:8px;">
        <MudTextField @bind-Value="_filterMonth" Placeholder="YYYY-MM" Variant="Variant.Outlined" Margin="Margin.Dense" />
        <MudButton OnClick="LoadAsync" StartIcon="@Icons.Material.Filled.Search">조회</MudButton>
        <MudButton OnClick="OpenCalcDialog" Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Calculate">월별 산출</MudButton>
    </div>
</div>

<MudButtonGroup Variant="Variant.Outlined" Class="mb-3">
    <MudButton OnClick="@(() => SetStatus("all"))" Color="@(_status == "all" ? Color.Primary : Color.Default)">전체</MudButton>
    <MudButton OnClick="@(() => SetStatus("draft"))" Color="@(_status == "draft" ? Color.Primary : Color.Default)">초안</MudButton>
    <MudButton OnClick="@(() => SetStatus("confirmed"))" Color="@(_status == "confirmed" ? Color.Primary : Color.Default)">확정</MudButton>
    <MudButton OnClick="@(() => SetStatus("paid"))" Color="@(_status == "paid" ? Color.Primary : Color.Default)">송금완료</MudButton>
</MudButtonGroup>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_items.Count == 0)
{
    <MudPaper Elevation="0" Class="pa-8" Style="border-radius:12px;background:#F9FAFB;text-align:center;">
        <MudText Color="Color.Secondary">조건에 맞는 정산이 없습니다.</MudText>
    </MudPaper>
}
else
{
    <MudPaper Elevation="1" Style="border-radius:12px;overflow:hidden;">
        <MudDataGrid T="SettlementRow" Items="_items" Hover="true" Dense="true">
            <Columns>
                <PropertyColumn Property="x => x.SettlementMonth" Title="정산월" />
                <PropertyColumn Property="x => x.ResellerName" Title="대리점" />
                <PropertyColumn Property="x => x.TenantCount" Title="고객사" />
                <TemplateColumn Title="매출">
                    <CellTemplate>@context.Item.GrossAmount.ToString("N0")</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="수수료율">
                    <CellTemplate>@(context.Item.CommissionRate * 100)%</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="수수료">
                    <CellTemplate>@context.Item.CommissionAmount.ToString("N0")</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="인센티브">
                    <CellTemplate>@context.Item.IncentiveAmount.ToString("N0")</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="지급액">
                    <CellTemplate>
                        <b>@context.Item.TotalPayable.ToString("N0")</b>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="상태">
                    <CellTemplate>
                        @{
                            var color = context.Item.Status switch
                            {
                                "draft" => Color.Default,
                                "confirmed" => Color.Info,
                                "paid" => Color.Success,
                                _ => Color.Default
                            };
                        }
                        <MudChip T="string" Color="color" Size="Size.Small">@context.Item.Status</MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="액션">
                    <CellTemplate>
                        @if (context.Item.Status == "draft")
                        {
                            <MudButton OnClick="@(() => ConfirmAsync(context.Item))"
                                       Size="Size.Small" Color="Color.Info">확정</MudButton>
                        }
                        else if (context.Item.Status == "confirmed")
                        {
                            <MudButton OnClick="@(() => MarkPaidAsync(context.Item))"
                                       Size="Size.Small" Color="Color.Success">송금 완료</MudButton>
                        }
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    </MudPaper>
}

@code {
    private bool _loading = true;
    private string _status = "all";
    private string _filterMonth = "";
    private List<SettlementRow> _items = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task SetStatus(string s)
    {
        _status = s;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var http = HttpFactory.CreateClient("backoffice-authed");
            var qs = new List<string>();
            if (_status != "all") qs.Add($"status={_status}");
            if (!string.IsNullOrWhiteSpace(_filterMonth)) qs.Add($"month={Uri.EscapeDataString(_filterMonth)}");
            var url = "api/backoffice/reseller-settlements" + (qs.Count > 0 ? "?" + string.Join("&", qs) : "");
            var res = await http.GetFromJsonAsync<ListResponse>(url);
            _items = res?.Items ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"목록 조회 실패: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenCalcDialog()
    {
        var parameters = new DialogParameters();
        var dialog = await Dialog.ShowAsync<SettlementCalcDialog>("월별 산출", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadAsync();
        }
    }

    private async Task ConfirmAsync(SettlementRow row)
    {
        var ok = await ConfirmDialog.ShowAsync(Dialog,
            "확정",
            $"{row.ResellerName} {row.SettlementMonth} 정산을 확정합니다. 확정 후에는 수정할 수 없습니다.",
            confirmText: "확정", severity: Severity.Warning);
        if (!ok) return;

        try
        {
            var http = HttpFactory.CreateClient("backoffice-authed");
            var res = await http.PostAsync($"api/backoffice/reseller-settlements/{row.SettlementId}/confirm", null);
            var payload = await res.Content.ReadFromJsonAsync<ActionResponse>();
            if (res.IsSuccessStatusCode && payload?.Success == true)
            {
                Snackbar.Add(payload.Message ?? "확정되었습니다.", Severity.Success);
                await LoadAsync();
            }
            else
            {
                Snackbar.Add(payload?.Message ?? "확정 실패", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"확정 중 오류: {ex.Message}", Severity.Error);
        }
    }

    private async Task MarkPaidAsync(SettlementRow row)
    {
        var ok = await ConfirmDialog.ShowAsync(Dialog,
            "송금 완료 표시",
            $"{row.ResellerName} {row.SettlementMonth} {row.TotalPayable:N0}원 송금이 완료되었습니까?",
            confirmText: "송금 완료", severity: Severity.Success);
        if (!ok) return;

        try
        {
            var http = HttpFactory.CreateClient("backoffice-authed");
            var res = await http.PostAsync($"api/backoffice/reseller-settlements/{row.SettlementId}/paid", null);
            var payload = await res.Content.ReadFromJsonAsync<ActionResponse>();
            if (res.IsSuccessStatusCode && payload?.Success == true)
            {
                Snackbar.Add(payload.Message ?? "송금 완료 처리되었습니다.", Severity.Success);
                await LoadAsync();
            }
            else
            {
                Snackbar.Add(payload?.Message ?? "처리 실패", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"처리 중 오류: {ex.Message}", Severity.Error);
        }
    }

    private class ListResponse
    {
        public bool Success { get; set; }
        public List<SettlementRow> Items { get; set; } = new();
    }

    private class ActionResponse
    {
        public bool Success { get; set; }
        public string? Message { get; set; }
    }

    public class SettlementRow
    {
        public long SettlementId { get; set; }
        public string ResellerId { get; set; } = "";
        public string? ResellerName { get; set; }
        public string SettlementMonth { get; set; } = "";
        public int TenantCount { get; set; }
        public decimal GrossAmount { get; set; }
        public decimal CommissionRate { get; set; }
        public decimal CommissionAmount { get; set; }
        public decimal IncentiveAmount { get; set; }
        public decimal TotalPayable { get; set; }
        public string Status { get; set; } = "";
        public DateTime? ConfirmedAt { get; set; }
        public DateTime? PaidAt { get; set; }
        public DateTime CreatedAt { get; set; }
    }
}
