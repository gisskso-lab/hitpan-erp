@*
    WS-20260601-13 본사 백오피스 — 고객사 시리얼 발급 4-eyes 화면 (8명제 #2·#4)
    작성일: 2026-06-01 / 작성팀: 프론트 매니저(Harvard·Meta 25년) + 수석 웹디자이너
    절대 원칙:
      - 평문 사업자번호·상호·대표자 화면 노출 금지 → 마스킹 (앞 3자리만)
      - 4-eyes 결재자 2인 + 발급 운영자가 그 중 하나여야 함
      - Razor에 C# raw string 금지 (헌법 #14) → $"..." 사용
      - 빈 catch 금지 (헌법 #15)
*@

@page "/admin/tenants/issue"
@layout PlatformLayout
@attribute [Authorize]
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService Dialog

<PageTitle>시리얼 발급 (4-eyes) — 히트판 백오피스</PageTitle>

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
    <div>
        <MudText Typo="Typo.h5" Style="font-weight:600;">고객사 시리얼 발급</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            8명제 #2·#4 본사 발급 + 4-eyes 결재 + 이메일·SMS 2채널 자동 전송
        </MudText>
    </div>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh"
               OnClick="LoadPendingAsync">새로고침</MudButton>
</div>

<MudAlert Severity="Severity.Info" Class="mb-3" Dense="true">
    🔒 평문 사업자번호·상호·대표자는 본사 백오피스에서 절대 노출되지 않습니다 (앞 3자리 마스킹).
    JIT 복호화는 본사 ERP(물리 분리)에서만 가능합니다 (8명제 #3·#7).
</MudAlert>

<MudPaper Elevation="1" Style="border-radius:12px;overflow:hidden;">
    <MudDataGrid T="PendingTenantRow" Items="_pending" Loading="_loading"
                 Hover="true" Dense="true" SortMode="SortMode.Single">
        <Columns>
            <PropertyColumn Property="x => x.BizNoMasked" Title="사업자번호 (마스킹)" />
            <PropertyColumn Property="x => x.CompanyMasked" Title="상호 (마스킹)" />
            <TemplateColumn Title="사등 검증">
                <CellTemplate>
                    @if (context.Item.NtsVerified)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success">검증완료</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">미검증</MudChip>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="결제 상태">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Color="@PayColor(context.Item.PaymentStatus)">
                        @context.Item.PaymentStatus
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.PlanType" Title="플랜" />
            <PropertyColumn Property="x => x.RequestedAt" Title="신청일" Format="yyyy-MM-dd HH:mm" />
            <TemplateColumn Title="발급">
                <CellTemplate>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               Disabled="@(!context.Item.NtsVerified || context.Item.PaymentStatus != "active")"
                               OnClick="@(() => OpenIssueDialog(context.Item))">
                        4-eyes 발급
                    </MudButton>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            <MudText Align="Align.Center" Class="pa-6" Color="Color.Secondary">
                발급 대기 중인 고객사가 없습니다.
            </MudText>
        </NoRecordsContent>
    </MudDataGrid>
</MudPaper>

@code {
    private List<PendingTenantRow> _pending = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadPendingAsync();
    }

    private async Task LoadPendingAsync()
    {
        _loading = true;
        try
        {
            // 가입 대기 목록 — WS-15 가도 시 GET /api/admin/issue/pending 결합. 현 시점 더미 저장.
            await Task.Yield();
            _pending = new List<PendingTenantRow>();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"대기 목록 조회 실패: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenIssueDialog(PendingTenantRow row)
    {
        var parameters = new DialogParameters
        {
            ["Row"] = row,
            ["Kind"] = "tenant"
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await Dialog.ShowAsync<IssueFourEyesDialog>("4-eyes 시리얼 발급", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            Snackbar.Add("발급 완료 — 이메일·SMS 2채널 전송됨", Severity.Success);
            await LoadPendingAsync();
        }
    }

    private Color PayColor(string status) => status switch
    {
        "active" => Color.Success,
        "pending" => Color.Warning,
        "expired" => Color.Error,
        _ => Color.Default
    };

    public class PendingTenantRow
    {
        public string BizNoMasked { get; set; } = "";
        public string CompanyMasked { get; set; } = "";
        public bool NtsVerified { get; set; }
        public string PaymentStatus { get; set; } = "pending";
        public string PlanType { get; set; } = "basic";
        public DateTime RequestedAt { get; set; }
        public string BizNoHash { get; set; } = "";
        public string EmailHash { get; set; } = "";
        public string PaymentId { get; set; } = "";
    }
}
