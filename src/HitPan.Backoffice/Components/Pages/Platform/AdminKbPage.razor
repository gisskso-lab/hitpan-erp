@*
    작14 C-3·C-4 — CS 백과사전 (사장님 결재 2026-10-08)
    - 정본은 DB(bo_kb_docs) · 이 화면이 쓰고·보여주고·내보낸다(설계 §2-ⓐ)
    - 🔴 고침은 UPDATE 가 아니라 version+1 새 판 — 옛 판이 그대로 남는다(이력 칸에서 보인다)
    - 🔴 승인은 사람만 — 승인 없이는 승인 판 행 자체가 안 생긴다(DB CHECK)
    - 승인 전 본문 재스캔은 서버가 한다 — 화면은 거부 사유를 보여 주기만 한다
    - Razor 에 C# raw string 금지(#14) · 빈 catch 금지(#15)

    🔴 20261013작1 갈래② — 간판 「고객지원처리조회」 + **좌우 2단** (설계 §3-3)
      · 🔴 **기능은 오늘과 한 글자도 다르지 않다** — 이슈코드·8분류·PRD 본문·버전 `v+1`·승인·.MD 미러 그대로.
           간판과 짜임새만 손본다(엔드포인트·응답 모양·쿼리 0줄).
      · 오늘은 목록 → 문서(편집) → .MD 미러 목록이 세로 3단이라 **문서를 고치는 동안 목록이 화면 밖으로 나갔다.**
           좌우로 나누면 「어느 문서를 보고 있나」가 늘 보인다.
      · 판 이력은 접고(기본 접힘) · `.MD 미러` 결과는 `KbExportDialog` 로 띄운다(화면 맨 아래 영구 블록 제거)
      · 🔴 **칼럼 6개는 그대로** — 이슈코드·분류·제목·상태·판·만든 날 여섯 모두 행이 생기는 순간 값이 있다.
           줄일 근거가 없는데 줄이면 정보만 사라진다.
      · 분류 8종 복제를 `CsVocab`(갈래①) 한 벌로 갈아 끼웠다 — 한쪽만 고쳐 어긋나는 일을 없앤다
      · 🔴 323줄이라 **분할하지 않는다**(설계 §7 맨 아랫줄)
*@

@page "/admin/kb"
@layout PlatformLayout
@attribute [Authorize(Policy = "PlatformOnlyV2")]
@using System.Net.Http.Json
@inject IHttpClientFactory HttpFactory
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@using HitPan.Backoffice.Components.Pages.Platform.Components

<PageTitle>고객지원처리조회 — 히트판 백오피스</PageTitle>

<BoPageHeader Title="고객지원처리조회"
              Subtitle="처리한 A/S 가 쌓이는 창고 — 승인된 문서만 다음 답의 재료입니다">
    <Actions>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Download"
                   OnClick="ExportAsync">.MD 미러 내보내기</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="LoadAsync">새로고침</MudButton>
    </Actions>
</BoPageHeader>

<BoFilterBar>
    <MudTextField @bind-Value="_keyword" Label="검색 (제목·이슈코드)" Variant="Variant.Outlined"
                  Margin="Margin.Dense" Immediate="true" OnKeyUp="OnSearchKey" />
    <MudSelect T="string" @bind-Value="_categoryFilter" Label="분류" Variant="Variant.Outlined" Margin="Margin.Dense">
        <MudSelectItem Value="@("all")">전체</MudSelectItem>
        @foreach (var c in CsVocab.Categories)
        {
            <MudSelectItem Value="@c.Key">@c.Value</MudSelectItem>
        }
    </MudSelect>
    <MudSelect T="string" @bind-Value="_statusFilter" Label="상태" Variant="Variant.Outlined" Margin="Margin.Dense">
        <MudSelectItem Value="@("all")">전체</MudSelectItem>
        <MudSelectItem Value="@("초안")">초안</MudSelectItem>
        <MudSelectItem Value="@("승인")">승인</MudSelectItem>
        <MudSelectItem Value="@("폐기")">폐기</MudSelectItem>
    </MudSelect>
    <div class="bo-filter-bar__action">
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Search" OnClick="LoadAsync">조회</MudButton>
    </div>
</BoFilterBar>

@* ── 좌우 2단(설계 R2) — 넓을 때 목록 7 / 문서 5 · 좁을 때 1단(문서가 목록 아래) ── *@
<MudGrid Spacing="3">
<MudItem xs="12" md="7">
<div class="bo-list-section">
    <div class="bo-list-section__head">
        <span class="bo-list-section__title">문서 목록 (이슈코드별 최신 판)</span>
        <span class="bo-list-section__count">총 <strong>@_rows.Count.ToString("N0")</strong>건</span>
    </div>

    @if (!_loading && _rows.Count == 0)
    {
        <div style="padding:32px 24px;">
            @* 🔴 조사 오류 교정 — 「CS 창구을」 (설계 §3-3) · 단추 이름도 새 간판에 맞춘다 *@
            <BoEmptyStateCard Title="아직 등재된 문서가 없습니다"
                              Description="A/S 를 완료로 바꾸고 「처리기록 등재」를 누르면 이곳에 쌓입니다."
                              IllustrationKind="doc" />
        </div>
    }
    else
    {
        <MudDataGrid T="KbDocRow" Items="_rows" Loading="_loading"
                     Hover="true" Dense="true" SortMode="SortMode.Single"
                     RowClick="@(e => OpenAsync(e.Item.IssueCode))">
            <Columns>
                <PropertyColumn Property="x => x.IssueCode" Title="이슈코드" />
                <TemplateColumn Title="분류">
                    <CellTemplate>
                        <span>@CsVocab.CategoryLabel(context.Item.Category)</span>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Title" Title="제목" />
                <TemplateColumn Title="상태">
                    <CellTemplate>
                        <span class="bo-status-chip @StatusChipClass(context.Item.Status)">@context.Item.Status</span>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Version" Title="판" />
                <PropertyColumn Property="x => x.CreatedAt" Title="만든 날" Format="MM-dd HH:mm" />
            </Columns>
            <PagerContent>
                <MudDataGridPager T="KbDocRow" />
            </PagerContent>
        </MudDataGrid>
    }
</div>
</MudItem>

<MudItem xs="12" md="5">
@if (_history.Count > 0)
{
    var head = _history[0];
    <MudPaper Elevation="0" Class="pa-4" Style="border:1px solid var(--mud-palette-lines-default);border-radius:12px">
        <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-2">
            <MudText Typo="Typo.h6">@head.IssueCode — @head.Title</MudText>
            <span class="bo-status-chip @StatusChipClass(head.Status)">@(head.Status) v@(head.Version)</span>
        </div>
        <MudText Typo="Typo.caption" Style="color:#6B7280" Class="mb-3 d-block">
            @CsVocab.CategoryLabel(head.Category)
            @if (!string.IsNullOrEmpty(head.ApprovedBy))
            {
                <span> · 승인 @(head.ApprovedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm"))</span>
            }
            else
            {
                <span> · 아직 승인 안 된 판입니다 — 다음 답의 재료로 나가지 않습니다</span>
            }
        </MudText>

        <MudTextField T="string" @bind-Value="_editTitle" Label="제목" Variant="Variant.Outlined"
                      Margin="Margin.Dense" MaxLength="200" Class="mb-2" />
        <MudTextField T="string" @bind-Value="_editBody" Label="문제점 / 해결점" Variant="Variant.Outlined"
                      Lines="16" MaxLength="8000" Counter="8000"
                      HelperText="저장하면 옛 판은 그대로 남고 새 판(v+1)이 생깁니다 — 덮어쓰지 않습니다" />
        <div class="d-flex justify-end gap-2 mt-2">
            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => ReviseAsync("폐기"))">폐기</MudButton>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => ReviseAsync("초안"))">새 판 저장(초안)</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       Disabled="_saving" OnClick="@(() => ReviseAsync("승인"))">
                @(_saving ? "저장 중…" : "새 판 승인")
            </MudButton>
        </div>

        @* 🔴 판 이력은 접어 둔다(설계 §3-3) — 10번 중 9번은 **지금 판을 읽고 고친다.**
             옛 판이 그대로 남아 있다는 사실은 그대로이고, 보이는 자리만 한 칸 접힌다. *@
        <MudExpansionPanels Dense="true" Elevation="0" Outlined="true" Class="mt-3">
            <MudExpansionPanel Text="@($"판 이력 ({_history.Count}판)")">
                @foreach (var h in _history)
                {
                    <div class="d-flex align-center gap-2" style="padding:4px 0;">
                        <span class="bo-status-chip @StatusChipClass(h.Status)">v@(h.Version) @h.Status</span>
                        <MudText Typo="Typo.caption" Style="color:#6B7280">
                            @h.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm") · @h.Title
                        </MudText>
                    </div>
                }
            </MudExpansionPanel>
        </MudExpansionPanels>
    </MudPaper>
}
else
{
    <MudPaper Elevation="0" Class="pa-4" Style="border:1px solid var(--mud-palette-lines-default);border-radius:12px">
        <MudText Typo="Typo.subtitle2" Class="mb-1">문서 하나를 골라 주세요</MudText>
        <MudText Typo="Typo.body2" Style="color:#6B7280">
            왼쪽 목록에서 줄을 누르면 그 문서의 제목·문제점·해결점이 이 자리에 열립니다.
            고치면 옛 판은 그대로 남고 새 판이 생깁니다.
        </MudText>
    </MudPaper>
}
</MudItem>
</MudGrid>

@code {
    private List<KbDocRow> _rows = new();
    private List<KbDocVersion> _history = new();
    private bool _loading = true;
    private bool _saving;
    private string _keyword = "";
    private string _categoryFilter = "all";
    private string _statusFilter = "all";
    private string _editTitle = "";
    private string _editBody = "";
    private string _openCode = "";

    // 🔴 20261013작1 갈래② — 8종 정본은 `CsVocab.Categories`(갈래①) 한 벌이다.
    //   여기에 있던 복제 목록을 걷어냈다 — 오늘까지 같은 8종이 이 화면과 고객A/S창구에 **두 번** 적혀 있어
    //   한쪽만 고치면 같은 값이 두 이름으로 보였다(설계 §7-9).

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var http = HttpFactory.CreateClient("backoffice-authed");
            var res = await http.GetFromJsonAsync<ListResponse>(
                $"api/admin/kb/docs?category={Uri.EscapeDataString(_categoryFilter)}&status={Uri.EscapeDataString(_statusFilter)}&q={Uri.EscapeDataString(_keyword)}");
            _rows = res?.Data ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"백과사전 조회 실패: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenAsync(string issueCode)
    {
        try
        {
            var http = HttpFactory.CreateClient("backoffice-authed");
            var res = await http.GetFromJsonAsync<HistoryResponse>($"api/admin/kb/docs/{Uri.EscapeDataString(issueCode)}");
            _history = res?.Data ?? new();
            _openCode = issueCode;
            if (_history.Count > 0)
            {
                _editTitle = _history[0].Title;
                _editBody = _history[0].BodyMd;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"문서를 열지 못했습니다: {ex.Message}", Severity.Error);
        }
    }

    private async Task ReviseAsync(string status)
    {
        if (string.IsNullOrEmpty(_openCode)) return;
        if (string.IsNullOrWhiteSpace(_editTitle) || string.IsNullOrWhiteSpace(_editBody))
        {
            Snackbar.Add("제목과 본문을 채워 주세요.", Severity.Info);
            return;
        }
        _saving = true;
        try
        {
            var http = HttpFactory.CreateClient("backoffice-authed");
            var res = await http.PostAsJsonAsync(
                $"api/admin/kb/docs/{Uri.EscapeDataString(_openCode)}/revise",
                new { title = _editTitle.Trim(), bodyMd = _editBody, status });
            if (res.IsSuccessStatusCode)
            {
                Snackbar.Add($"새 판을 {status}으로 저장했습니다 — 옛 판은 그대로 남습니다.", Severity.Success);
                await LoadAsync();
                await OpenAsync(_openCode);
            }
            else
            {
                var err = await res.Content.ReadFromJsonAsync<ApiMessage>();
                Snackbar.Add(err?.Message ?? "저장하지 못했습니다.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"저장하지 못했습니다: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>
    /// `.MD 미러` — 서버를 부르는 것은 오늘과 **같다**(`api/admin/kb/export`).
    /// 🔴 바뀐 것은 결과를 어디에 보이느냐 하나다: 화면 맨 아래 영구 블록 → 한 번 보고 닫는 다이얼로그.
    /// </summary>
    private async Task ExportAsync()
    {
        try
        {
            var http = HttpFactory.CreateClient("backoffice-authed");
            var res = await http.GetFromJsonAsync<ExportResponse>("api/admin/kb/export");
            var files = res?.Files ?? new();
            if (files.Count == 0)
            {
                Snackbar.Add("승인된 문서가 아직 없습니다 — 미러로 나갈 것이 없습니다.", Severity.Info);
                return;
            }
            var paths = files.Select(f => f.Path).ToList();
            await Dialog.ShowAsync<KbExportDialog>($".MD 미러 — {paths.Count}개",
                new DialogParameters<KbExportDialog> { { x => x.Paths, paths } },
                new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        }
        catch (Exception ex)
        {
            Snackbar.Add($"내보내지 못했습니다: {ex.Message}", Severity.Error);
        }
    }

    private static string StatusChipClass(string? s) => s switch
    {
        "승인" => "bo-status-chip--active",
        "초안" => "bo-status-chip--trial",
        "폐기" => "bo-status-chip--suspended",
        _ => "bo-status-chip--neutral",
    };

    public class KbDocRow
    {
        public long DocId { get; set; }
        public string IssueCode { get; set; } = "";
        public string Category { get; set; } = "";
        public string Title { get; set; } = "";
        public string Status { get; set; } = "";
        public int Version { get; set; }
        public string? ApprovedBy { get; set; }
        public DateTime? ApprovedAt { get; set; }
        public long? SourceTicketId { get; set; }
        public DateTime CreatedAt { get; set; }
    }

    public class KbDocVersion : KbDocRow
    {
        public string BodyMd { get; set; } = "";
        public string? CreatedBy { get; set; }
    }

    public class ExportFile
    {
        public string Path { get; set; } = "";
        public string Markdown { get; set; } = "";
    }

    private sealed class ListResponse { public bool Success { get; set; } public List<KbDocRow> Data { get; set; } = new(); }
    private sealed class HistoryResponse { public bool Success { get; set; } public List<KbDocVersion> Data { get; set; } = new(); }
    private sealed class ExportResponse { public bool Success { get; set; } public int Count { get; set; } public List<ExportFile> Files { get; set; } = new(); }
    private sealed class ApiMessage { public string? Message { get; set; } }
}
