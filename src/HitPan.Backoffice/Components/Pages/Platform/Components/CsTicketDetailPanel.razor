@*
    🔴 20261013작1 갈래② — 고객A/S창구 **상세** (설계 §3-1 · §7-2)

    오늘은 상세가 목록 아래로 세로로 붙어 있었다 ⇒ 행을 누르면 눈이 아래로 내려갔다가
    다음 행을 보려고 다시 올라와야 했다. 이제 목록(md=7) 오른쪽(md=5)에 **같은 눈높이**로 선다.

    짜임새 — 읽고 답하는 한 줄기를 위에서 아래로:
      ① 머리(읽기전용) → ② 고객이 보낸 말 → ③ 답 이력 → ④ 답 쓰기 → ▸ 처리(기본 접힘)
    🔴 10번 중 9번은 **읽고 답한다.** 단추 묶음(상태·분류·담당·약속·응대·등재·폐기)은 접어 둔다(설계 R3).
    🔴 버리는 단추는 없다 — 목록에서 내려온 「응대」도 이 안에 있다(정보 손실 0).

    🔴 **상태는 페이지가 갖는다.** 이 컴포넌트는 `[Parameter]` 로 받고 `EventCallback` 으로 올린다 —
       두 곳에서 같은 값을 들면 「고쳤는데 안 바뀐다」가 생긴다(설계 §7).
    Razor 에 C# raw string 금지(#14) · 빈 catch 금지(#15 · 이 컴포넌트는 catch 를 갖지 않는다 — 부르는 쪽이 갖는다)
*@

<MudPaper Elevation="0" Class="pa-4" Style="border:1px solid var(--mud-palette-lines-default);border-radius:12px">

    @* ── ① 머리 — 읽기전용. 「무엇을 보고 있나」만 말한다 ── *@
    <div class="d-flex align-start justify-space-between gap-2 mb-1">
        <MudText Typo="Typo.h6">@Detail.CompanyName — @CsVocab.CategoryLabel(Detail.Category)</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                       title="상세 닫기" OnClick="@(() => OnClose.InvokeAsync())" />
    </div>
    <div class="d-flex align-center flex-wrap gap-2 mb-2">
        <span class="bo-status-chip @StatusChipClass(Detail.Status)">@Detail.Status</span>
        @if (Detail.ReadAt is null)
        {
            <span class="bo-status-chip bo-status-chip--suspended">안 읽음</span>
        }
        @if (Detail.Rating is not null)
        {
            <span class="bo-status-chip bo-status-chip--active">★ @RatingLabel(Detail.Rating)</span>
        }
        @if (Detail.PurgedAt is not null)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Default">폐기됨</MudChip>
        }
    </div>
    <MudText Typo="Typo.caption" Style="color:#6B7280" Class="mb-2 d-block">
        @CsVocab.ChannelLabel(Detail.Channel) · @ShapeLabel(Detail.ShapeTag) · 화면 @(Detail.ScreenCode ?? "-") · 판 @(Detail.ErpVersion ?? "-") · @Detail.ReceivedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
    </MudText>

    @* ── ② 고객이 보낸 말 ── *@
    <MudPaper Elevation="0" Class="pa-3 mb-3" Style="background:var(--mud-palette-background-gray);border-radius:8px">
        <MudText Typo="Typo.body1" Style="white-space:pre-wrap">@(string.IsNullOrEmpty(Detail.Body) ? "(본문 없음 — 태그만 접수)" : Detail.Body)</MudText>
    </MudPaper>

    @* ── ③ 답 이력 ── *@
    @foreach (var r in Replies)
    {
        <MudPaper Elevation="0" Class="pa-3 mb-2" Style="border:1px solid var(--mud-palette-lines-default);border-radius:8px">
            <div class="d-flex align-center justify-space-between mb-1">
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">본사 답</MudChip>
                <MudText Typo="Typo.caption" Style="color:#6B7280">
                    @r.ApprovedAt.ToLocalTime().ToString("MM-dd HH:mm") · @(r.DeliveredAt is null ? "전달 대기(5분 주기)" : "전달됨")
                </MudText>
            </div>
            <MudText Typo="Typo.body2" Style="white-space:pre-wrap">@r.Body</MudText>
        </MudPaper>
    }

    @* ── 🔴 「고객사 ERP 로 안 간다」를 아는 자리 ③/3 (설계 §4) ──
         경로가 고객사 쪽지가 **아닐 때만** 뜬다. 🔴 답 쓰기 칸 자체는 막지 않는다 —
         오늘도 전화 접수 건에 답을 쓸 수 있고, 막으면 거동 변경이다(설계 §10 결-9).
         이 차수는 **거짓말을 지우는 한 줄만** 더한다. *@
    @if (Detail.Channel != "erp_message")
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
            이 건은 본사에 적은 기록입니다 — 적은 답은 고객사 화면으로 가지 않습니다. 전화·이메일로 알려 주세요.
        </MudAlert>
    }

    @* ── ④ 답 쓰기 ── *@
    <MudTextField T="string" Value="@ReplyBody" ValueChanged="@(v => ReplyBodyChanged.InvokeAsync(v))"
                  Label="답 쓰기" Variant="Variant.Outlined"
                  Lines="4" MaxLength="4000" Counter="4000" Class="mt-2"
                  HelperText="저장하는 사람이 승인자입니다 — 저장 즉시 고객 ERP 가 5분 주기로 가져갑니다" />
    <div class="d-flex justify-end mt-2">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="SendingReply"
                   OnClick="@(() => OnSendReply.InvokeAsync())">
            @(SendingReply ? "저장 중…" : "답 저장 (승인)")
        </MudButton>
    </div>

    @* ── ▸ 처리 — 기본 접힘(설계 R3). 자주 쓰는 것만 펼쳐 둔다 ── *@
    <MudExpansionPanels Dense="true" Elevation="0" Outlined="true" Class="mt-3">
        <MudExpansionPanel Text="처리 (상태·분류·담당·약속·응대·등재·폐기)">

            <div class="d-flex align-center flex-wrap gap-2 mb-2">
                <MudSelect T="string" Value="@NewStatus" ValueChanged="@(v => NewStatusChanged.InvokeAsync(v))"
                           Label="상태" Dense="true" Variant="Variant.Outlined" Style="min-width:150px">
                    <MudSelectItem Value="@("접수")">접수</MudSelectItem>
                    <MudSelectItem Value="@("처리중")">처리중</MudSelectItem>
                    <MudSelectItem Value="@("보류")">보류</MudSelectItem>
                    <MudSelectItem Value="@("고객답대기")">고객 답 대기</MudSelectItem>
                    <MudSelectItem Value="@("완료")">완료</MudSelectItem>
                </MudSelect>
                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                           OnClick="@(() => OnChangeStatus.InvokeAsync())">상태 변경</MudButton>
            </div>

            <div class="d-flex align-center flex-wrap gap-2 mb-2">
                <MudSelect T="string" Value="@NewCategory" ValueChanged="@(v => NewCategoryChanged.InvokeAsync(v))"
                           Label="분류" Dense="true" Variant="Variant.Outlined" Style="min-width:150px">
                    @foreach (var c in CsVocab.Categories)
                    {
                        <MudSelectItem Value="@c.Key">@c.Value</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                           OnClick="@(() => OnChangeCategory.InvokeAsync())">분류 저장</MudButton>
            </div>

            @* 🔴 목록 「응대」 칼럼이 내려온 자리 — 완료로 넘기려면 이 칸이 채워져 있어야 한다(버린 게 아니다) *@
            <div class="d-flex align-center flex-wrap gap-2 mb-2">
                <MudSelect T="string" Value="@NewHandledVia" ValueChanged="@(v => NewHandledViaChanged.InvokeAsync(v))"
                           Label="응대 유형" Dense="true" Variant="Variant.Outlined" Style="min-width:150px">
                    @foreach (var v in HandledVias)
                    {
                        <MudSelectItem Value="@v.Key">@v.Value</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                           OnClick="@(() => OnSetHandledVia.InvokeAsync())">응대 저장</MudButton>
                <MudText Typo="Typo.caption" Style="color:#6B7280">
                    지금 @HandledViaLabel(Detail.HandledVia)
                </MudText>
            </div>

            <div class="d-flex align-center flex-wrap gap-2 mb-2">
                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.AssignmentInd"
                           OnClick="@(() => OnAssignToMe.InvokeAsync())">내가 맡기</MudButton>
                <MudText Typo="Typo.caption" Style="color:#6B7280">
                    담당 @(string.IsNullOrEmpty(Detail.HandlerType) ? "미배정" : Detail.HandlerType)
                </MudText>
                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Schedule"
                           OnClick="@(() => OnSetPromise.InvokeAsync())">답 약속 (@(PromiseHours)시간)</MudButton>
                <MudText Typo="Typo.caption" Style="color:#6B7280">@PromiseText(Detail.PromisedAt)</MudText>
            </div>

            <div class="d-flex align-center flex-wrap gap-2">
                @if (Detail.Status == "완료")
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.MenuBook"
                               OnClick="@(() => OnPromoteDraft.InvokeAsync())">처리기록 등재</MudButton>
                }

                @* 🔴 임의 폐기 — 사유를 적어야 눌린다. 내용은 지워지고 「언제 누가 왜」는 감사기록에 남는다. *@
                @if (Detail.PurgedAt is null)
                {
                    <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.DeleteOutline"
                               OnClick="@(() => OnArmPurge.InvokeAsync())">폐기</MudButton>
                }
            </div>

            @if (PurgeArmed)
            {
                <MudPaper Elevation="0" Class="pa-3 mt-3" Style="border:1px solid var(--mud-palette-error);border-radius:8px">
                    <MudText Typo="Typo.subtitle2" Class="mb-1">이 A/S 를 폐기합니다</MudText>
                    <MudText Typo="Typo.caption" Style="color:#6B7280" Class="mb-2 d-block">
                        본문이 지워집니다. 되돌릴 수 없습니다. 접수 기록과 「누가 언제 왜 지웠는지」는 남습니다.
                    </MudText>
                    <div class="d-flex align-center gap-2 flex-wrap">
                        <MudTextField T="string" Value="@PurgeReason" ValueChanged="@(v => PurgeReasonChanged.InvokeAsync(v))"
                                      Label="폐기 사유 (필수)" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" MaxLength="200" Style="min-width:240px" />
                        <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                                   OnClick="@(() => OnConfirmPurge.InvokeAsync())">폐기 확정</MudButton>
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   OnClick="@(() => OnCancelPurge.InvokeAsync())">그만두기</MudButton>
                    </div>
                </MudPaper>
            }
        </MudExpansionPanel>
    </MudExpansionPanels>
</MudPaper>

@code {
    // ── 받는 값 — 전부 페이지가 들고 있는 상태의 사본이다 ──

    [Parameter, EditorRequired] public AdminCsListPage.CsTicketDetail Detail { get; set; } = null!;
    [Parameter] public List<AdminCsListPage.ReplyRow> Replies { get; set; } = new();

    [Parameter] public string NewStatus { get; set; } = "접수";
    [Parameter] public EventCallback<string> NewStatusChanged { get; set; }

    [Parameter] public string NewCategory { get; set; } = "etc";
    [Parameter] public EventCallback<string> NewCategoryChanged { get; set; }

    [Parameter] public string NewHandledVia { get; set; } = "message";
    [Parameter] public EventCallback<string> NewHandledViaChanged { get; set; }

    [Parameter] public string? ReplyBody { get; set; }
    [Parameter] public EventCallback<string?> ReplyBodyChanged { get; set; }

    [Parameter] public bool SendingReply { get; set; }

    [Parameter] public bool PurgeArmed { get; set; }
    [Parameter] public string PurgeReason { get; set; } = "";
    [Parameter] public EventCallback<string> PurgeReasonChanged { get; set; }

    /// <summary>답 약속 기준 시간 — 정본은 설정 몫이다. 화면은 같은 숫자를 보여 주기만 한다.</summary>
    [Parameter] public int PromiseHours { get; set; } = 24;

    // ── 올리는 신호 — 서버를 부르는 것은 전부 페이지다(상태 전이는 서버 1곳) ──

    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSendReply { get; set; }
    [Parameter] public EventCallback OnChangeStatus { get; set; }
    [Parameter] public EventCallback OnChangeCategory { get; set; }
    [Parameter] public EventCallback OnSetHandledVia { get; set; }
    [Parameter] public EventCallback OnAssignToMe { get; set; }
    [Parameter] public EventCallback OnSetPromise { get; set; }
    [Parameter] public EventCallback OnPromoteDraft { get; set; }
    [Parameter] public EventCallback OnArmPurge { get; set; }
    [Parameter] public EventCallback OnCancelPurge { get; set; }
    [Parameter] public EventCallback OnConfirmPurge { get; set; }

    // ── 낱말 — 분류·경로는 CsVocab 한 벌(갈래①). 아래 셋은 이 화면만 쓰는 축이다 ──

    private static readonly List<KeyValuePair<string, string>> HandledVias = new()
    {
        new("message", "쪽지로 응대"), new("phone", "전화로 응대"), new("remote", "원격지원"),
    };

    private static string HandledViaLabel(string? v) => v switch
    {
        "message" => "쪽지", "phone" => "전화", "remote" => "원격지원", _ => "-",
    };

    private static string RatingLabel(int? r) => r switch
    {
        3 => "좋아요", 2 => "보통", 1 => "아쉬워요", _ => "-",
    };

    // 7모양 보조 태그(고객 언어)
    private static string ShapeLabel(string? s) => s switch
    {
        "open_fail" => "안 열려요", "number_mismatch" => "숫자 안 맞아요", "how_to" => "어떻게 해요",
        "print_fail" => "안 찍혀요", "change_request" => "바꿔주세요", "billing" => "요금·결제",
        "feature_request" => "되게 해주세요", _ => s ?? "",
    };

    private static string StatusChipClass(string s) => s switch
    {
        "접수" => "bo-status-chip--suspended",
        "처리중" => "bo-status-chip--trial",
        "보류" or "고객답대기" => "bo-status-chip--neutral",
        "완료" => "bo-status-chip--active",
        _ => "bo-status-chip--neutral"
    };

    private static string PromiseText(DateTime? at)
    {
        if (at is null) return "약속 없음";
        var local = at.Value.ToLocalTime();
        var left = local - DateTime.Now;
        if (left.TotalMinutes < 0) return $"{local:MM-dd HH:mm} · 지났습니다";
        return $"{local:MM-dd HH:mm} · {(int)left.TotalHours}시간 남음";
    }
}
