@*
 * KpiCard — 본사 대시보드 단일 KPI 카드 (수석 웹디자이너 박제 2026-06-01)
 *
 * 원칙:
 *  - 8pt grid + 라운드 12px + 그림자 1단
 *  - 아이콘 32px (상단 좌측), 라벨(상단 우측 또는 아이콘 옆)
 *  - 값 H3 (32px 굵게)
 *  - 트렌드 행 (▲/▼ + N) 또는 보조 캡션
 *  - design-tokens.css 변수만 사용 (하드코딩 색상 금지)
 *
 * 호출 예:
 *  <KpiCard Label="전체 고객사" Value="@TotalCustomers.ToString("N0")"
 *           Icon="@Icons.Material.Filled.Business" Accent="primary"
 *           TrendText="@($"이번 달 +{NewCustomersThisMonth}")" TrendKind="up" />
 *@

<div class="kpi-card kpi-accent-@Accent">
    <div class="kpi-card__head">
        <div class="kpi-card__icon kpi-card__icon--@Accent">
            <MudIcon Icon="@Icon" Style="font-size:32px;" />
        </div>
        <div class="kpi-card__label">@Label</div>
    </div>
    <div class="kpi-card__value">@Value</div>
    @if (!string.IsNullOrEmpty(TrendText))
    {
        <div class="kpi-card__trend kpi-card__trend--@TrendKind">
            @if (TrendKind == "up")
            {
                <span class="kpi-card__trend-icon">▲</span>
            }
            else if (TrendKind == "down")
            {
                <span class="kpi-card__trend-icon">▼</span>
            }
            <span>@TrendText</span>
        </div>
    }
</div>

@code {
    /// <summary>카드 상단 라벨 (예: 전체 고객사)</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    /// <summary>대표 값 (포맷팅된 문자열 전달)</summary>
    [Parameter, EditorRequired] public string Value { get; set; } = "0";

    /// <summary>MudBlazor 아이콘 경로</summary>
    [Parameter, EditorRequired] public string Icon { get; set; } = "";

    /// <summary>강조색: primary(그린) / info(블루) / warning(오렌지) / accent(옐로)</summary>
    [Parameter] public string Accent { get; set; } = "primary";

    /// <summary>트렌드 문구 (예: 이번 달 +3, 미납 2건)</summary>
    [Parameter] public string? TrendText { get; set; }

    /// <summary>트렌드 종류: up(▲ 그린) / down(▼ 레드) / neutral(텍스트만)</summary>
    [Parameter] public string TrendKind { get; set; } = "neutral";
}
