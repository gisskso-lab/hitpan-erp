@*
 * RecentActivityCard — 본사 대시보드 최근 활동 (수석 웹디자이너 저장 2026-06-01)
 *
 * 원칙:
 *  - 가입·결제·환불·CS 등 본사 메타정보만 표시 (헌법 #18·#22: 평문 사업자 정보 노출 0)
 *  - 시리얼·상태·시각 3축
 *  - 데이터 0건 시 EmptyStateCard로 폴백
 *@

<div class="recent-activity">
    @if (Items is not null && Items.Count > 0)
    {
        <div class="recent-activity__list">
            @foreach (var it in Items)
            {
                <div class="recent-activity__row">
                    <div class="recent-activity__row-main">
                        <div class="recent-activity__serial">@it.Serial</div>
                        <div class="recent-activity__meta">@it.Note</div>
                    </div>
                    <div class="recent-activity__side">
                        <span class="recent-activity__status recent-activity__status--@it.StatusKind">@it.Status</span>
                        <span class="recent-activity__time">@it.WhenText</span>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <BoEmptyStateCard Title="@EmptyTitle"
                          Description="@EmptyDesc"
                          IllustrationKind="list" />
    }
</div>

@code {
    [Parameter] public List<Activity>? Items { get; set; }
    [Parameter] public string EmptyTitle { get; set; } = "최근 활동이 없습니다";
    [Parameter] public string EmptyDesc { get; set; } = "가입·결제·환불 이벤트가 발생하면 여기에 표시됩니다.";

    public class Activity
    {
        /// <summary>시리얼 또는 식별자 (평문 사업자 정보 금지 — 헌법 #18·#22)</summary>
        public string Serial { get; set; } = "";

        /// <summary>보조 메모 (예: 베이직 플랜, 환불 사유 등 메타만)</summary>
        public string Note { get; set; } = "";

        /// <summary>상태 라벨 (예: 가입, 결제, 환불, 대기)</summary>
        public string Status { get; set; } = "";

        /// <summary>상태 종류: success(그린) / info(블루) / warning(오렌지) / error(레드) / neutral</summary>
        public string StatusKind { get; set; } = "neutral";

        /// <summary>시간 표시 (예: 방금 전, 3분 전, 2026-06-01 14:22)</summary>
        public string WhenText { get; set; } = "";
    }
}
