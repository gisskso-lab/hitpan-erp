@*
 * EmptyStateCard — 데이터 0건 시 Empty State (수석 웹디자이너 저장 2026-06-01)
 *
 * 원칙:
 *  - 데이터 0건이어도 시각적으로 풍부함 (일러스트 + 가이드 + CTA)
 *  - SVG 인라인 일러스트로 외부 의존 0
 *  - design-tokens.css 변수만 사용
 *
 * 호출 예:
 *  <EmptyStateCard Title="아직 데이터가 없습니다"
 *                  Description="첫 고객사가 가입하면 여기에 추이가 표시됩니다."
 *                  IllustrationKind="chart" />
 *@

<div class="empty-state">
    <div class="empty-state__illustration">
        @if (IllustrationKind == "chart")
        {
            <!-- 차트 일러스트: 막대 3개 (회색조 → 강조색) -->
            <svg width="120" height="80" viewBox="0 0 120 80" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="10" y="50" width="20" height="22" rx="3" fill="var(--hp-surface-active)" />
                <rect x="40" y="35" width="20" height="37" rx="3" fill="var(--hp-brand-200)" />
                <rect x="70" y="20" width="20" height="52" rx="3" fill="var(--hp-brand-500)" />
                <line x1="6" y1="74" x2="114" y2="74" stroke="var(--hp-border-default)" stroke-width="1.5" stroke-linecap="round" />
            </svg>
        }
        else if (IllustrationKind == "list")
        {
            <!-- 리스트 일러스트: 행 3개 + 아바타 -->
            <svg width="120" height="80" viewBox="0 0 120 80" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <circle cx="20" cy="20" r="8" fill="var(--hp-brand-200)" />
                <rect x="34" y="14" width="60" height="5" rx="2.5" fill="var(--hp-surface-active)" />
                <rect x="34" y="22" width="40" height="4" rx="2" fill="var(--hp-surface-sunken)" />
                <circle cx="20" cy="44" r="8" fill="var(--hp-surface-active)" />
                <rect x="34" y="38" width="60" height="5" rx="2.5" fill="var(--hp-surface-active)" />
                <rect x="34" y="46" width="40" height="4" rx="2" fill="var(--hp-surface-sunken)" />
                <circle cx="20" cy="68" r="8" fill="var(--hp-surface-active)" />
                <rect x="34" y="62" width="60" height="5" rx="2.5" fill="var(--hp-surface-active)" />
                <rect x="34" y="70" width="40" height="4" rx="2" fill="var(--hp-surface-sunken)" />
            </svg>
        }
        else
        {
            <!-- 기본 일러스트: 문서 -->
            <svg width="120" height="80" viewBox="0 0 120 80" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect x="36" y="12" width="48" height="60" rx="6" fill="var(--hp-surface-sunken)" stroke="var(--hp-border-default)" stroke-width="1.5" />
                <line x1="46" y1="28" x2="74" y2="28" stroke="var(--hp-brand-300)" stroke-width="2" stroke-linecap="round" />
                <line x1="46" y1="38" x2="74" y2="38" stroke="var(--hp-border-default)" stroke-width="2" stroke-linecap="round" />
                <line x1="46" y1="48" x2="66" y2="48" stroke="var(--hp-border-default)" stroke-width="2" stroke-linecap="round" />
            </svg>
        }
    </div>
    <div class="empty-state__title">@Title</div>
    @if (!string.IsNullOrEmpty(Description))
    {
        <div class="empty-state__desc">@Description</div>
    }
    @if (!string.IsNullOrEmpty(CtaText) && CtaClick.HasDelegate)
    {
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                   OnClick="@(async () => await CtaClick.InvokeAsync())"
                   Class="mt-3">
            @CtaText
        </MudButton>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Description { get; set; }

    /// <summary>일러스트 종류: chart / list / doc</summary>
    [Parameter] public string IllustrationKind { get; set; } = "doc";

    /// <summary>CTA 버튼 라벨 (선택). 비우면 버튼 미표시.</summary>
    [Parameter] public string? CtaText { get; set; }
    [Parameter] public EventCallback CtaClick { get; set; }
}
