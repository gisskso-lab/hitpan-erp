@*
    BoPageHeader — 백오피스 v2 공통 페이지 헤더 (수석 웹디자이너 저장 2026-06-01)

    원칙:
      - 32px H3 + 14px Sub + 우측 Action 슬롯
      - margin-bottom 24px (8pt grid)
      - design-tokens.css 변수만 사용 (하드코딩 금지)
      - 헌법 #15 정합 — 빈 catch 없음 (스타일 컴포넌트)
*@

<div class="bo-page-header">
    <div class="bo-page-header__main">
        <h1 class="bo-page-header__title">@Title</h1>
        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <p class="bo-page-header__subtitle">@Subtitle</p>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="bo-page-header__actions">
            @Actions
        </div>
    }
</div>

@code {
    /// <summary>페이지 메인 타이틀 (32px H3).</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>한 줄 보조 설명 (14px).</summary>
    [Parameter] public string? Subtitle { get; set; }

    /// <summary>우측 액션 슬롯 (등록 버튼 등).</summary>
    [Parameter] public RenderFragment? Actions { get; set; }
}
