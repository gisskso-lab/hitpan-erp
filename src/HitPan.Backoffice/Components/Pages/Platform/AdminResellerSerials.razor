@page "/admin/reseller-serials"
@layout PlatformLayout
@attribute [Authorize]
@rendermode InteractiveServer
@inject IHttpClientFactory HttpFactory
@inject ISnackbar Snackbar
@inject IDialogService Dialog

@*
    대리점 시리얼 발급·회수 (W9, 사장님 결재 2026-06-05)
    백오피스 API /api/backoffice/reseller-serials
    issue (1~100개 일괄, 평문 1회 응답) / revoke (available만)
*@

<PageTitle>대리점 시리얼 — 히트판 백오피스</PageTitle>

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
    <div>
        <MudText Typo="Typo.h5" Style="font-weight:600;">대리점 시리얼</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            시리얼 발급 · 회수 (헌법 #18·#22 — DB는 BCrypt 해시, 평문 응답 1회만)
        </MudText>
    </div>
    <MudButton OnClick="OpenIssueDialog" Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.VpnKey">시리얼 발급</MudButton>
</div>

<MudButtonGroup Variant="Variant.Outlined" Class="mb-3">
    <MudButton OnClick="@(() => SetStatus("all"))" Color="@(_status == "all" ? Color.Primary : Color.Default)">전체</MudButton>
    <MudButton OnClick="@(() => SetStatus("available"))" Color="@(_status == "available" ? Color.Primary : Color.Default)">발급가능</MudButton>
    <MudButton OnClick="@(() => SetStatus("claimed"))" Color="@(_status == "claimed" ? Color.Primary : Color.Default)">사용중</MudButton>
    <MudButton OnClick="@(() => SetStatus("revoked"))" Color="@(_status == "revoked" ? Color.Primary : Color.Default)">회수</MudButton>
</MudButtonGroup>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_items.Count == 0)
{
    <MudPaper Elevation="0" Class="pa-8" Style="border-radius:12px;background:#F9FAFB;text-align:center;">
        <MudText Color="Color.Secondary">조건에 맞는 시리얼이 없습니다.</MudText>
    </MudPaper>
}
else
{
    <MudPaper Elevation="1" Style="border-radius:12px;overflow:hidden;">
        <MudDataGrid T="SerialRow" Items="_items" Hover="true" Dense="true">
            <Columns>
                <PropertyColumn Property="x => x.SerialId" Title="ID" />
                <PropertyColumn Property="x => x.SerialPrefix" Title="시리얼 (앞 8자)" />
                <PropertyColumn Property="x => x.ResellerName" Title="대리점" />
                <PropertyColumn Property="x => x.SubscriptionTier" Title="티어" />
                <PropertyColumn Property="x => x.MaxUsers" Title="최대사용자" />
                <TemplateColumn Title="유효">
                    <CellTemplate>
                        @(context.Item.ValidUntil?.ToString("yyyy-MM-dd") ?? "—")
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="상태">
                    <CellTemplate>
                        @{
                            var color = context.Item.Status switch
                            {
                                "available" => Color.Success,
                                "claimed" => Color.Info,
                                "revoked" => Color.Error,
                                _ => Color.Default
                            };
                        }
                        <MudChip T="string" Color="color" Size="Size.Small">@context.Item.Status</MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="사용 고객사">
                    <CellTemplate>@(context.Item.ClaimedTenantId ?? "—")</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="발급일">
                    <CellTemplate>@context.Item.IssuedAt.ToString("yyyy-MM-dd")</CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="액션">
                    <CellTemplate>
                        @if (context.Item.Status == "available")
                        {
                            <MudButton OnClick="@(() => RevokeAsync(context.Item))"
                                       Size="Size.Small" Color="Color.Error">회수</MudButton>
                        }
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    </MudPaper>
}

@code {
    private bool _loading = true;
    private string _status = "all";
    private List<SerialRow> _items = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task SetStatus(string s)
    {
        _status = s;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var http = HttpFactory.CreateClient("backoffice-authed");
            var url = "api/backoffice/reseller-serials" + (_status != "all" ? $"?status={_status}" : "");
            var res = await http.GetFromJsonAsync<ListResponse>(url);
            _items = res?.Items ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"목록 조회 실패: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenIssueDialog()
    {
        var parameters = new DialogParameters();
        var dialog = await Dialog.ShowAsync<SerialIssueDialog>("시리얼 발급", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadAsync();
        }
    }

    private async Task RevokeAsync(SerialRow row)
    {
        var reason = await Dialog.ShowAsync<ApprovalRejectDialog>("회수 사유",
            new DialogParameters(), new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await reason.Result;
        if (result is null || result.Canceled || result.Data is not string reasonText || string.IsNullOrWhiteSpace(reasonText))
            return;

        try
        {
            var http = HttpFactory.CreateClient("backoffice-authed");
            var res = await http.PostAsJsonAsync($"api/backoffice/reseller-serials/{row.SerialId}/revoke",
                new { Reason = reasonText });
            var payload = await res.Content.ReadFromJsonAsync<ActionResponse>();
            if (res.IsSuccessStatusCode && payload?.Success == true)
            {
                Snackbar.Add(payload.Message ?? "회수되었습니다.", Severity.Warning);
                await LoadAsync();
            }
            else
            {
                Snackbar.Add(payload?.Message ?? "회수 실패", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"회수 중 오류: {ex.Message}", Severity.Error);
        }
    }

    private class ListResponse
    {
        public bool Success { get; set; }
        public List<SerialRow> Items { get; set; } = new();
    }

    private class ActionResponse
    {
        public bool Success { get; set; }
        public string? Message { get; set; }
    }

    public class SerialRow
    {
        public long SerialId { get; set; }
        public string SerialPrefix { get; set; } = "";
        public string ResellerId { get; set; } = "";
        public string? ResellerName { get; set; }
        public string SubscriptionTier { get; set; } = "";
        public int MaxUsers { get; set; }
        public DateTime? ValidUntil { get; set; }
        public string Status { get; set; } = "";
        public string? ClaimedTenantId { get; set; }
        public DateTime? ClaimedAt { get; set; }
        public DateTime? RevokedAt { get; set; }
        public string? RevokedReason { get; set; }
        public DateTime IssuedAt { get; set; }
    }
}
