@inject IHttpClientFactory HttpFactory
@inject ISnackbar Snackbar

@*
    월별 정산 산출 다이얼로그 (W9, 사장님 결재 2026-06-05)
*@

<MudDialog>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudTextField @bind-Value="_month" Label="정산월 (YYYY-MM)" Required="true"
                              Placeholder="@DateTime.Now.AddMonths(-1).ToString("yyyy-MM")" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_resellerId" Label="대리점 ID (전체 산출 시 비워두기)" />
            </MudItem>
            <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Dense="true">
                    산출 결과는 draft 상태로 박힙니다. 확인 후 확정 처리해주세요.
                </MudAlert>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">취소</MudButton>
        <MudButton OnClick="Submit" Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="@_submitting">
            @(_submitting ? "산출 중..." : "산출 실행")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private string _month = "";
    private string _resellerId = "";
    private bool _submitting = false;

    protected override void OnInitialized()
    {
        _month = DateTime.Now.AddMonths(-1).ToString("yyyy-MM");
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_month))
        {
            Snackbar.Add("정산월을 입력해주세요.", Severity.Warning);
            return;
        }
        _submitting = true;
        try
        {
            var http = HttpFactory.CreateClient("backoffice-authed");
            var res = await http.PostAsJsonAsync("api/backoffice/reseller-settlements/calculate", new
            {
                Month = _month,
                ResellerId = string.IsNullOrWhiteSpace(_resellerId) ? null : _resellerId
            });
            var payload = await res.Content.ReadFromJsonAsync<ActionResponse>();
            if (res.IsSuccessStatusCode && payload?.Success == true)
            {
                Snackbar.Add(payload.Message ?? "산출 완료", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(payload?.Message ?? "산출 실패", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"산출 중 오류: {ex.Message}", Severity.Error);
        }
        finally
        {
            _submitting = false;
        }
    }

    private class ActionResponse
    {
        public bool Success { get; set; }
        public string? Message { get; set; }
    }
}
