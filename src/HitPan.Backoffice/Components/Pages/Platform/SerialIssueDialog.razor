@inject IHttpClientFactory HttpFactory
@inject ISnackbar Snackbar

@*
    시리얼 발급 다이얼로그 (W9, 사장님 결재 2026-06-05)
    발급 직후 평문 시리얼 표시 (DB는 BCrypt 해시만, 평문 응답 1회)
*@

<MudDialog>
    <DialogContent>
        @if (_issued.Count == 0)
        {
            <MudGrid>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_resellerId" Label="대리점 ID" Required="true" />
                </MudItem>
                <MudItem xs="6">
                    <MudNumericField @bind-Value="_quantity" Label="발급 수량 (1~100)" Min="1" Max="100" />
                </MudItem>
                <MudItem xs="6">
                    <MudSelect T="string" @bind-Value="_tier" Label="구독 티어">
                        <MudSelectItem Value="@("basic")">basic</MudSelectItem>
                        <MudSelectItem Value="@("pro")">pro</MudSelectItem>
                        <MudSelectItem Value="@("enterprise")">enterprise</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="6">
                    <MudNumericField @bind-Value="_maxUsers" Label="최대 사용자 수" Min="1" Max="100" />
                </MudItem>
                <MudItem xs="6">
                    <MudDatePicker @bind-Date="_validUntil" Label="유효기간 (선택)" />
                </MudItem>
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Warning" Dense="true">
                        평문 시리얼은 발급 직후 1회만 표시됩니다. 본 화면을 닫으면 다시 볼 수 없으니 안전한 곳에 보관하세요.
                    </MudAlert>
                </MudItem>
            </MudGrid>
        }
        else
        {
            <MudAlert Severity="Severity.Success" Class="mb-4">
                @(_issued.Count)개 시리얼이 발급되었습니다. 아래 평문 시리얼을 대리점에 안전하게 전달하세요.
            </MudAlert>
            <MudPaper Elevation="0" Class="pa-4" Style="background:#FFFBEB;border:1px solid #FCD34D;border-radius:8px;max-height:400px;overflow-y:auto;">
                @foreach (var s in _issued)
                {
                    <MudText Typo="Typo.body2" Style="font-family:monospace;letter-spacing:1px;">@s</MudText>
                }
            </MudPaper>
        }
    </DialogContent>
    <DialogActions>
        @if (_issued.Count == 0)
        {
            <MudButton OnClick="Cancel">취소</MudButton>
            <MudButton OnClick="Submit" Color="Color.Primary" Variant="Variant.Filled"
                       Disabled="@_submitting">
                @(_submitting ? "발급 중..." : "발급")
            </MudButton>
        }
        else
        {
            <MudButton OnClick="Close" Color="Color.Primary" Variant="Variant.Filled">닫기 (다시 못 봄)</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private string _resellerId = "";
    private int _quantity = 10;
    private string _tier = "basic";
    private int _maxUsers = 3;
    private DateTime? _validUntil;
    private bool _submitting = false;
    private List<string> _issued = new();

    private void Cancel() => MudDialog.Cancel();
    private void Close() => MudDialog.Close(DialogResult.Ok(true));

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_resellerId))
        {
            Snackbar.Add("대리점 ID를 입력해주세요.", Severity.Warning);
            return;
        }
        if (_quantity < 1 || _quantity > 100)
        {
            Snackbar.Add("수량은 1~100 사이여야 합니다.", Severity.Warning);
            return;
        }

        _submitting = true;
        try
        {
            var http = HttpFactory.CreateClient("backoffice-authed");
            var res = await http.PostAsJsonAsync("api/backoffice/reseller-serials/issue", new
            {
                ResellerId = _resellerId,
                Quantity = _quantity,
                SubscriptionTier = _tier,
                MaxUsers = _maxUsers,
                ValidUntil = _validUntil
            });
            var payload = await res.Content.ReadFromJsonAsync<IssueResponse>();
            if (res.IsSuccessStatusCode && payload?.Success == true)
            {
                _issued = payload.Serials ?? new();
                Snackbar.Add(payload.Message ?? "발급 완료", Severity.Success);
            }
            else
            {
                Snackbar.Add(payload?.Message ?? "발급 실패", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"발급 중 오류: {ex.Message}", Severity.Error);
        }
        finally
        {
            _submitting = false;
        }
    }

    private class IssueResponse
    {
        public bool Success { get; set; }
        public string? Message { get; set; }
        public List<string>? Serials { get; set; }
    }
}
