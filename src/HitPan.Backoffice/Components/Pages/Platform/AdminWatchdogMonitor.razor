@page "/admin/watchdog"
@layout PlatformLayout
@attribute [Authorize]
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>워치독 모니터링 — 히트판 백오피스</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1" Style="font-weight:600;">워치독 모니터링</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-5">
    헌법 #22·#27·#28 — 본사 책임 영역 SLA 99.99% 실측 (업무 데이터 0)
</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else
{
    <MudGrid Spacing="3" Class="mb-5">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="1" Style="border-radius:12px;">
                <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px;">
                    <MudIcon Icon="@Icons.Material.Filled.Verified" Color="Color.Success" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary">healthy 고객사</MudText>
                </div>
                <MudText Typo="Typo.h4" Style="font-weight:700;">@_summary.Healthy</MudText>
                <MudText Typo="Typo.caption" Color="Color.Success">최근 5분 기준</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="1" Style="border-radius:12px;">
                <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px;">
                    <MudIcon Icon="@Icons.Material.Filled.Healing" Color="Color.Warning" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary">recovering 고객사</MudText>
                </div>
                <MudText Typo="Typo.h4" Style="font-weight:700;">@_summary.Recovering</MudText>
                <MudText Typo="Typo.caption" Color="Color.Warning">자가복구 중</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="1" Style="border-radius:12px;">
                <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px;">
                    <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary">down 고객사</MudText>
                </div>
                <MudText Typo="Typo.h4" Style="font-weight:700;">@_summary.Down</MudText>
                <MudText Typo="Typo.caption" Color="Color.Error">CS 즉시 대응</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4" Elevation="1" Style="border-radius:12px;">
                <div style="display:flex;align-items:center;gap:12px;margin-bottom:8px;">
                    <MudIcon Icon="@Icons.Material.Filled.Notifications" Color="Color.Error" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary">미해결 emergency</MudText>
                </div>
                <MudText Typo="Typo.h4" Style="font-weight:700;">@_summary.UnresolvedEmergencies</MudText>
                <MudText Typo="Typo.caption" Color="Color.Error">cool down 초과</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Class="pa-4 mb-4" Elevation="1" Style="border-radius:12px;">
        <MudText Typo="Typo.h6" Class="mb-3">월간 SLA 실측 (본사 책임 영역)</MudText>
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="4">
                <MudText Typo="Typo.body2" Color="Color.Secondary">목표</MudText>
                <MudText Typo="Typo.h5" Style="font-weight:700;">99.99%</MudText>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudText Typo="Typo.body2" Color="Color.Secondary">실측 (@(_summary.SlaMonth))</MudText>
                <MudText Typo="Typo.h5" Style="@($"font-weight:700; color:{SlaColor(_summary.SlaActual)};")">
                    @_summary.SlaActual.ToString("F4")%
                </MudText>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudText Typo="Typo.body2" Color="Color.Secondary">환불 대상</MudText>
                <MudText Typo="Typo.h5" Style="font-weight:700;">@_summary.RefundCount</MudText>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-4" Elevation="1" Style="border-radius:12px;">
        <MudText Typo="Typo.h6" Class="mb-3">최근 emergency 알림</MudText>
        @if (_emergencies.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">최근 24시간 emergency 없음.</MudText>
        }
        else
        {
            <MudTable Items="@_emergencies" Hover="true" Dense="true">
                <HeaderContent>
                    <MudTh>수신 시각</MudTh>
                    <MudTh>tenant_id_hash (앞 12자)</MudTh>
                    <MudTh>reason</MudTh>
                    <MudTh>stage</MudTh>
                    <MudTh>CS 처리</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.received_at.ToString("MM/dd HH:mm:ss")</MudTd>
                    <MudTd><code>@context.tenant_id_hash[..Math.Min(19, context.tenant_id_hash.Length)]…</code></MudTd>
                    <MudTd>@context.reason</MudTd>
                    <MudTd>@(context.stage ?? "-")</MudTd>
                    <MudTd>
                        @if (context.cs_resolved_at is not null)
                        {
                            <MudChip T="string" Color="Color.Success" Size="Size.Small">해결</MudChip>
                        }
                        else if (context.cs_notified_at is not null)
                        {
                            <MudChip T="string" Color="Color.Warning" Size="Size.Small">처리 중</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Error" Size="Size.Small">미대응</MudChip>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>
}

@code {
    private bool _loading = true;
    private MonitorSummary _summary = new();
    private List<EmergencyRow> _emergencies = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var s = await Http.GetFromJsonAsync<MonitorSummary>("api/admin/watchdog/summary");
            if (s is not null) _summary = s;
            var e = await Http.GetFromJsonAsync<List<EmergencyRow>>("api/admin/watchdog/emergencies?hours=24");
            if (e is not null) _emergencies = e;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"모니터링 로드 실패: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private static string SlaColor(double sla) =>
        sla >= 99.99 ? "#22c55e" : sla >= 99.9 ? "#f59e0b" : "#ef4444";

    public class MonitorSummary
    {
        public int Healthy { get; set; }
        public int Recovering { get; set; }
        public int Down { get; set; }
        public int UnresolvedEmergencies { get; set; }
        public string SlaMonth { get; set; } = DateTime.Now.ToString("yyyy-MM");
        public double SlaActual { get; set; } = 99.99;
        public int RefundCount { get; set; }
    }

    public class EmergencyRow
    {
        public DateTime received_at { get; set; }
        public string tenant_id_hash { get; set; } = "";
        public string reason { get; set; } = "";
        public string? stage { get; set; }
        public DateTime? cs_notified_at { get; set; }
        public DateTime? cs_resolved_at { get; set; }
    }
}
