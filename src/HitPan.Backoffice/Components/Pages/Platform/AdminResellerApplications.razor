@page "/admin/reseller-applications"
@layout PlatformLayout
@attribute [Authorize]
@rendermode InteractiveServer
@inject IHttpClientFactory HttpFactory
@inject ISnackbar Snackbar
@inject IDialogService Dialog
@using HitPan.Backoffice.Components.Common

@*
    협력업체 가입 신청 검토·승인 (사장님 결재 2026-06-04)
    헌법 #35 정합 — 본사 백오피스 영역
    권한: bo_permissions DB 저장 (사장님이 /owner/permissions에서 저장한 role만)
*@

<PageTitle>협력업체 신청 — 히트판 백오피스</PageTitle>

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
    <div>
        <MudText Typo="Typo.h5" Style="font-weight:600;">협력업체 가입 신청</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            가입 신청 검토 · 승인 · 반려 (사장님 권한 저장: /owner/permissions)
        </MudText>
    </div>
    <div style="display:flex;gap:8px;align-items:center;">
        <MudTextField @bind-Value="_search" Placeholder="회사명·담당자·이메일"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:240px;" />
        <MudButtonGroup Variant="Variant.Outlined">
            <MudButton OnClick="@(() => SetFilter("all"))" Color="@(_filter == "all" ? Color.Primary : Color.Default)">전체</MudButton>
            <MudButton OnClick="@(() => SetFilter("pending"))" Color="@(_filter == "pending" ? Color.Primary : Color.Default)">검토 대기</MudButton>
            <MudButton OnClick="@(() => SetFilter("approved"))" Color="@(_filter == "approved" ? Color.Primary : Color.Default)">승인</MudButton>
            <MudButton OnClick="@(() => SetFilter("rejected"))" Color="@(_filter == "rejected" ? Color.Primary : Color.Default)">반려</MudButton>
        </MudButtonGroup>
    </div>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (FilteredItems.Count == 0)
{
    <MudPaper Elevation="0" Class="pa-8" Style="border-radius:12px;background:#F9FAFB;text-align:center;">
        <MudText Color="Color.Secondary">조건에 맞는 신청이 없습니다.</MudText>
    </MudPaper>
}
else
{
    <MudPaper Elevation="1" Style="border-radius:12px;overflow:hidden;">
        <MudDataGrid T="ApplicationRow" Items="FilteredItems" Hover="true" Dense="true" SortMode="SortMode.Single">
            <Columns>
                <TemplateColumn Title="회사명">
                    <CellTemplate>
                        <MudLink OnClick="@(() => ShowDetailAsync(context.Item))" Underline="Underline.Hover" Style="cursor:pointer;">
                            @context.Item.CompanyName
                        </MudLink>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.CeoName" Title="대표자" />
                <PropertyColumn Property="x => x.ContactName" Title="담당자" />
                <PropertyColumn Property="x => x.Email" Title="이메일" />
                <PropertyColumn Property="x => x.Phone" Title="연락처" />
                <PropertyColumn Property="x => x.SubmittedAt" Title="신청일" Format="yyyy-MM-dd HH:mm" />
                <TemplateColumn Title="상태">
                    <CellTemplate>
                        <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Item.Status)">
                            @StatusLabel(context.Item.Status)
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="액션">
                    <CellTemplate>
                        @if (context.Item.Status == "pending" || context.Item.Status == "reviewing")
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                                       OnClick="@(() => ApproveAsync(context.Item))">승인</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                                       OnClick="@(() => RejectAsync(context.Item))" Class="ml-2">반려</MudButton>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">처리 완료</MudText>
                        }
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    </MudPaper>
}

@code {
    private List<ApplicationRow> _items = new();
    private bool _loading = true;
    private string _filter = "pending";
    private string _search = "";

    private List<ApplicationRow> FilteredItems => string.IsNullOrWhiteSpace(_search)
        ? _items
        : _items.Where(x =>
            (x.CompanyName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
            || (x.ContactName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
            || (x.Email?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
          ).ToList();

    private async Task ShowDetailAsync(ApplicationRow row)
    {
        var parameters = new DialogParameters { ["ApplicationId"] = row.ApplicationId };
        await Dialog.ShowAsync<ResellerApplicationDetailDialog>("협력업체 신청 상세", parameters);
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private void SetFilter(string filter)
    {
        _filter = filter;
        _ = LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var http = HttpFactory.CreateClient("backoffice-authed");
            var url = _filter == "all"
                ? "api/backoffice/reseller-applications"
                : $"api/backoffice/reseller-applications?status={_filter}";
            var res = await http.GetFromJsonAsync<ListResponse>(url);
            _items = res?.Items ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"목록 조회 실패: {ex.Message}", Severity.Error);
            _items = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ApproveAsync(ApplicationRow row)
    {
        var ok = await ConfirmDialog.ShowAsync(Dialog,
            "협력업체 승인",
            $"{row.CompanyName} 협력업체 가입을 승인하시겠습니까? 대리점 코드(R-XXXX)·임시 비밀번호가 발급되어 신청자 이메일로 자동 발송됩니다.",
            confirmText: "승인", cancelText: "취소", severity: Severity.Success);
        if (!ok) return;

        try
        {
            var http = HttpFactory.CreateClient("backoffice-authed");
            var res = await http.PostAsync($"api/backoffice/reseller-applications/{row.ApplicationId}/approve", null);
            var payload = await res.Content.ReadFromJsonAsync<ActionResponse>();
            if (res.IsSuccessStatusCode && payload?.Success == true)
            {
                Snackbar.Add(payload.Message ?? "승인이 완료되었습니다.", Severity.Success);
                await LoadAsync();
            }
            else
            {
                Snackbar.Add(payload?.Message ?? $"승인 실패 ({(int)res.StatusCode})", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"승인 처리 오류: {ex.Message}", Severity.Error);
        }
    }

    private async Task RejectAsync(ApplicationRow row)
    {
        var parameters = new DialogParameters
        {
            ["Row"] = row
        };
        var dialog = await Dialog.ShowAsync<RejectReasonDialog>("반려 사유 입력", parameters);
        var result = await dialog.Result;
        if (result?.Canceled != false || result.Data is not string text || string.IsNullOrWhiteSpace(text)) return;

        try
        {
            var http = HttpFactory.CreateClient("backoffice-authed");
            var res = await http.PostAsJsonAsync(
                $"api/backoffice/reseller-applications/{row.ApplicationId}/reject",
                new { Reason = text });
            var payload = await res.Content.ReadFromJsonAsync<ActionResponse>();
            if (res.IsSuccessStatusCode && payload?.Success == true)
            {
                Snackbar.Add(payload.Message ?? "반려 처리되었습니다.", Severity.Warning);
                await LoadAsync();
            }
            else
            {
                Snackbar.Add(payload?.Message ?? $"반려 실패 ({(int)res.StatusCode})", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"반려 처리 오류: {ex.Message}", Severity.Error);
        }
    }

    private static string StatusLabel(string s) => s switch
    {
        "pending" => "검토 대기",
        "reviewing" => "검토 중",
        "approved" => "승인",
        "rejected" => "반려",
        _ => s
    };

    private static Color StatusColor(string s) => s switch
    {
        "pending" => Color.Warning,
        "reviewing" => Color.Info,
        "approved" => Color.Success,
        "rejected" => Color.Error,
        _ => Color.Default
    };

    public class ApplicationRow
    {
        public string ApplicationId { get; set; } = "";
        public string CompanyName { get; set; } = "";
        public string CeoName { get; set; } = "";
        public string ContactName { get; set; } = "";
        public string Email { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Status { get; set; } = "";
        public DateTime SubmittedAt { get; set; }
    }

    private class ListResponse
    {
        public bool Success { get; set; }
        public List<ApplicationRow> Items { get; set; } = new();
    }

    private class ActionResponse
    {
        public bool Success { get; set; }
        public string? Message { get; set; }
    }
}
