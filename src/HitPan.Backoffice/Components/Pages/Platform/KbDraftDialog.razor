@inject IHttpClientFactory HttpFactory
@inject ISnackbar Snackbar

@*
    🔴 20261013작1 갈래② — 「처리기록 등재」 초안 (설계 §7-4)

    오늘 `AdminCsListPage.razor:430-463` 에 상세 맨 아래로 쌓이던 블록을 **그대로** 옮겼다.
    기능은 한 글자도 다르지 않다 — 승격 초안을 서버가 만들고(`api/admin/kb/promote/{id}`),
    사람이 제목·분류·본문을 고쳐 초안 또는 승인으로 등재한다(`api/admin/kb/docs`).

    🔴 간판이 「고객지원처리조회」로 바뀌었으니 단추도 「처리기록 등재」다(작업지시서 §2-2 · PM 권고 확정).
       같은 기능을 두 이름으로 부르면 처음 보는 사람이 길을 잃는다.
    🔴 회사 이름·담당자·연락처는 초안에 **애초에 들어오지 않는다**(서버가 안 준다) — 가져오지 않은 값은 잊을 수도 없다.
    Razor 에 C# raw string 금지(#14) · 빈 catch 금지(#15)
*@

<MudDialog>
    <DialogContent>
        @if (_loading)
        {
            <div class="d-flex align-center gap-2 py-4">
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                <MudText Typo="Typo.body2">초안을 만들고 있습니다…</MudText>
            </div>
        }
        else if (_draft is null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true">
                @(_failMessage ?? "초안을 만들지 못했습니다.")
            </MudAlert>
        }
        else
        {
            <MudText Typo="Typo.caption" Style="color:#6B7280" Class="mb-3 d-block">
                회사 이름·담당자·연락처는 이 초안에 <b>들어오지 않습니다</b>(가져오지 않은 값은 잊을 수도 없습니다).
                제목과 해결 순서를 적고 승인하면 그때 등재됩니다 — 승인 없이는 행이 생기지 않습니다.
                @if (_quoteOmitted)
                {
                    <span style="color:#B45309"> · 본문에 식별정보 모양이 있어 인용을 생략했습니다.</span>
                }
            </MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="4">
                    <MudSelect T="string" @bind-Value="_category" Label="분류" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var c in CsVocab.Categories)
                        {
                            <MudSelectItem Value="@c.Key">@c.Value</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="8">
                    <MudTextField @bind-Value="_title" Label="제목 (증상 한 줄)" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" MaxLength="200" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" @bind-Value="_draft" Label="문제점 / 해결점" Variant="Variant.Outlined"
                                  Lines="14" MaxLength="8000" Counter="8000" />
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">닫기</MudButton>
        @if (_draft is not null)
        {
            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                       Disabled="@_saving" OnClick="@(() => SaveAsync("초안"))">초안 저장</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       Disabled="@_saving" OnClick="@(() => SaveAsync("승인"))">
                @(_saving ? "등재 중…" : "승인 등재")
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>어느 A/S 에서 올라온 초안인가 — 서버가 이 번호로 본문을 만들어 준다.</summary>
    [Parameter, EditorRequired] public long TicketId { get; set; }

    private bool _loading = true;
    private bool _saving;
    private string? _draft;
    private string _title = "";
    private string _category = "etc";
    private bool _quoteOmitted;
    private string? _failMessage;

    private void Cancel() => MudDialog.Cancel();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var http = HttpFactory.CreateClient("backoffice-authed");
            var res = await http.PostAsJsonAsync($"api/admin/kb/promote/{TicketId}", new { });
            if (res.IsSuccessStatusCode)
            {
                var body = await res.Content.ReadFromJsonAsync<PromoteResponse>();
                _draft = body?.Draft?.BodyMd ?? "";
                _category = string.IsNullOrEmpty(body?.Draft?.Category) ? "etc" : body!.Draft!.Category;
                _quoteOmitted = body?.Draft?.QuoteOmitted ?? false;
                _title = "";
            }
            else
            {
                var err = await res.Content.ReadFromJsonAsync<ApiMessage>();
                _failMessage = err?.Message ?? "초안을 만들지 못했습니다.";
            }
        }
        catch (Exception ex)
        {
            // #15 — 삼키지 않는다. 다이얼로그 안에서도 사람 말로 보인다.
            _failMessage = $"초안을 만들지 못했습니다: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync(string status)
    {
        if (_draft is null) return;
        if (string.IsNullOrWhiteSpace(_title))
        {
            Snackbar.Add("제목을 적어 주세요 — 증상 한 줄이면 됩니다.", Severity.Info);
            return;
        }
        _saving = true;
        try
        {
            var http = HttpFactory.CreateClient("backoffice-authed");
            var res = await http.PostAsJsonAsync("api/admin/kb/docs", new
            {
                category = _category,
                title = _title.Trim(),
                bodyMd = _draft,
                status,
                sourceTicketId = TicketId,
            });
            if (res.IsSuccessStatusCode)
            {
                var ok = await res.Content.ReadFromJsonAsync<DocSaveResponse>();
                Snackbar.Add($"고객지원처리조회에 {status}으로 등재했습니다 — {ok?.IssueCode}", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                var err = await res.Content.ReadFromJsonAsync<ApiMessage>();
                Snackbar.Add(err?.Message ?? "등재하지 못했습니다.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"등재하지 못했습니다: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private sealed class PromoteResponse { public bool Success { get; set; } public DraftBody? Draft { get; set; } }

    private sealed class DraftBody
    {
        public string Category { get; set; } = "";
        public string? Title { get; set; }
        public string BodyMd { get; set; } = "";
        public long SourceTicketId { get; set; }
        public bool QuoteOmitted { get; set; }
    }

    private sealed class DocSaveResponse
    {
        public bool Success { get; set; }
        public long DocId { get; set; }
        public string? IssueCode { get; set; }
        public int Version { get; set; }
        public string? Status { get; set; }
    }

    private sealed class ApiMessage { public string? Message { get; set; } }
}
